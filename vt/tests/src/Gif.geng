module Gif exposing (suite)

{-| `Vt.Gif` (`docs/images-iterm.md` IT4): small GIFs Pillow made
(`gen-gif.py`, `GifCases`), each first frame held to Pillow's RGBA of it,
exactly: a colour table's lookup leaves nothing to round.
-}

import Bitwise
import Bytes exposing (Bytes)
import Expect
import GifCases
import Support
import Test.Runner.UnitNode as U
import UInt8
import Vt.Base64 as Base64
import Vt.Gif as Gif


{-| The bytes that differ from Pillow's, or -1 for an image not decoded or
of another size. -}
differing : GifCases.Case -> Int
differing c =
    when Base64.decode (Bytes.fromString c.gif) |> Maybe.map (Gif.decode 100000000) is
        Just (Ok img) ->
            if img.width /= c.width || img.height /= c.height then
                -1

            else
                Array.range 0 (c.width * c.height * 4 - 1)
                    |> Array.foldl
                        (\i acc ->
                            if Maybe.map UInt8.toInt (Bytes.get i img.pixels) == Array.get i c.rgba then
                                acc

                            else
                                acc + 1
                        )
                        0

        _ ->
            -1


{-| A GIF of two pixels by one, a 256-colour table of greys (index `i` is
`i, i, i`), 8-bit codes, and LZW data `codes` of nine bits each. -}
twoPixels : Array Int -> Bytes
twoPixels codes =
    let
        -- each code's nine bits, the lowest first, then eight to a byte
        bits =
            Array.flatten (Array.map (\c -> Array.initialize 9 0 (\k -> Bitwise.and 1 (Bitwise.shiftRightBy k c))) codes)

        data =
            Array.initialize ((Array.length bits + 7) // 8)
                0
                (\i -> Array.foldl (\k acc -> Bitwise.or acc (Bitwise.shiftLeftBy k (Maybe.withDefault 0 (Array.get (8 * i + k) bits)))) 0 (Array.range 0 7))
    in
    Array.flatten
        [ [ 0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 2, 0, 1, 0, 0xF7, 0, 0 ]
        , Array.flatten (Array.initialize 256 0 (\i -> [ i, i, i ]))
        , [ 0x2C, 0, 0, 0, 0, 2, 0, 1, 0, 0, 8, Array.length data ]
        , data
        , [ 0, 0x3B ]
        ]
        |> Array.map UInt8.fromInt
        |> Bytes.fromUInt8s


{-| The pixels' RGBA, or nothing for a GIF not decoded. -}
rgba : Bytes -> Maybe (Array Int)
rgba gif =
    when Gif.decode 100000000 gif is
        Ok img ->
            Just (Array.initialize (Bytes.length img.pixels) 0 (\i -> Maybe.withDefault 0 (Maybe.map UInt8.toInt (Bytes.get i img.pixels))))

        Err _ ->
            Nothing


suite : U.Suite
suite =
    Support.run "Gif"
        (Array.map
            (\c ->
                { name = c.name ++ ": as Pillow decodes it"
                , test = \_ -> Expect.equal 0 (differing c)
                }
            )
            GifCases.cases
            ++ [ { name = "indices 7 and 200 by 8-bit codes, a byte each (docs/images.md IM39)"
                 , test = \_ -> Expect.equal (Just [ 7, 7, 7, 255, 200, 200, 200, 255 ]) (rgba (twoPixels [ 256, 7, 200, 257 ]))
                 }
               , { name = "a first code past 255 ends the data, not wrapped to an index (IM39)"
                 , test = \_ -> Expect.equal (Just [ 0, 0, 0, 255, 0, 0, 0, 255 ]) (rgba (twoPixels [ 256, 300, 200, 257 ]))
                 }
               ]
        )
