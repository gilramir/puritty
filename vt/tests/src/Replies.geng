module Replies exposing (suite)

{-| What the embedder takes from a terminal after a read: the replies to
write back, the clipboard requests of OSC 52, and the modes the key and
mouse encoders need.
-}

import Expect
import Support exposing (feed, term)
import Test.Runner.UnitNode as U
import Vt


suite : U.Suite
suite =
    Support.run "Replies"
        [ { name = "DSR 6 reports the cursor, one-based"
          , test =
                \_ ->
                    Expect.equal [ "\u{001B}[2;3R" ]
                        (replies (feed "\u{001B}[2;3H\u{001B}[6n" (term 10 5)))
          }
        , { name = "DSR 5 reports a working terminal"
          , test = \_ -> Expect.equal [ "\u{001B}[0n" ] (replies (feed "\u{001B}[5n" (term 10 5)))
          }
        , { name = "the DEC status reports with one answer are answered, each what is true of the core (VC71)"
          , test =
                \_ ->
                    Expect.equal
                        [ "\u{001B}[?13n", "\u{001B}[?21n", "\u{001B}[?27;1n", "\u{001B}[?50n", "\u{001B}[?57;0n", "\u{001B}[0*{", "\u{001B}P7!~0000\u{001B}\\", "\u{001B}[?70n", "\u{001B}[?83n" ]
                        (replies (feed "\u{001B}[?15n\u{001B}[?25n\u{001B}[?26n\u{001B}[?55n\u{001B}[?56n\u{001B}[?62n\u{001B}[?63;7n\u{001B}[?75n\u{001B}[?85n" (term 10 5)))
          }
        , { name = "a # color's digits are its channels' high bits, an rgb: color's scaled (VC71)"
          , test =
                \_ ->
                    Expect.equal
                        -- one reply, the answers in the order asked
                        [ "\u{001B}]4;1;rgb:f0f0/8080/0000\u{0007}\u{001B}]4;2;rgb:f0f0/f0f0/f0f0\u{0007}\u{001B}]4;3;rgb:ffff/8888/0000\u{0007}" ]
                        (replies (feed "\u{001B}]4;1;#f80;2;#f00f00f00;3;rgb:f/8/0\u{0007}\u{001B}]4;1;?;2;?;3;?\u{0007}" (term 10 5)))
          }
        , { name = "the size reports answer the cell size given after the terminal was made (images IM3)"
          , test =
                \_ ->
                    Expect.equal [ "\u{001B}[6;20;9t", "\u{001B}[4;100;90t" ]
                        (replies (feed "\u{001B}[16t\u{001B}[14t" (Vt.withCellSize { width = 9, height = 20 } (term 10 5))))
          }
        , { name = "with an image limit of 0 the Kitty graphics protocol is off: nothing is answered or kept (images IM16)"
          , test =
                \_ ->
                    let
                        off =
                            feed "\u{001B}_Ga=q,i=31,s=1,v=1,f=24;AAAA\u{001B}\\\u{001B}_Ga=T,f=24,s=1,v=1,i=1;AAAA\u{001B}\\" (Vt.withImageLimit 0 (term 10 5))

                        images =
                            String.contains "image " (Vt.dump off)
                    in
                    Expect.equal { replies = [], images = False } { replies = replies off, images = images }
          }
        , { name = "replies come oldest first and a take empties them"
          , test =
                \_ ->
                    let
                        taken =
                            Vt.takeReplies (feed "\u{001B}[5n\u{001B}[6n" (term 10 5))
                    in
                    Expect.equal
                        { first = [ "\u{001B}[0n", "\u{001B}[1;1R" ], again = [] }
                        { first = Array.map Support.text taken.replies, again = replies taken.term }
          }
        , { name = "OSC 52 asks to set the clipboard with decoded text"
          , test =
                \_ ->
                    let
                        taken =
                            Vt.takeClipboard (feed "\u{001B}]52;c;aGVsbG8=\u{0007}" (term 10 5))
                    in
                    Expect.equal
                        [ { selection = 1, text = Just "hello", letter = 99, bel = True } ]
                        (Array.map
                            (\c -> { selection = c.selection, text = Maybe.map Support.text c.text, letter = c.letter, bel = c.bel })
                            taken.requests
                        )
          }
        , { name = "a clipboard request and a notification before RIS in the same read are kept for the embedder (review VP7)"
          , test =
                \_ ->
                    let
                        input =
                            "\u{001B}]52;c;aGVsbG8=\u{0007}\u{001B}]9;done\u{0007}\u{001B}c"

                        clip =
                            Vt.takeClipboard (feed input (term 10 5))

                        notes =
                            Vt.takeNotices (feed input (term 10 5))
                    in
                    Expect.equal { clip = [ Just "hello" ], notes = [ "done" ] }
                        { clip = Array.map (\c -> Maybe.map Support.text c.text) clip.requests
                        , notes = Array.map .body notes.notices
                        }
          }
        , { name = "OSC 52 with ST, for the primary selection"
          , test =
                \_ ->
                    let
                        taken =
                            Vt.takeClipboard (feed "\u{001B}]52;p;eA==\u{001B}\\" (term 10 5))
                    in
                    Expect.equal
                        [ { selection = 0, text = Just "x", bel = False } ]
                        (Array.map (\c -> { selection = c.selection, text = Maybe.map Support.text c.text, bel = c.bel }) taken.requests)
          }
        , { name = "OSC 52 that is not Base64 asks for nothing to be written"
          , test =
                \_ ->
                    Expect.equal 0
                        (Array.length (Vt.takeClipboard (feed "\u{001B}]52;c;a b\u{0007}" (term 10 5))).requests)
          }
        , { name = "DECCKM and DECBKM reach the key encoder's options"
          , test =
                \_ ->
                    let
                        before =
                            Vt.keyOptions (term 10 5)

                        after =
                            Vt.keyOptions (feed "\u{001B}[?1h\u{001B}[?67h" (term 10 5))
                    in
                    Expect.equal
                        { before = { cursor = False, backarrow = False }, after = { cursor = True, backarrow = True } }
                        { before = { cursor = before.cursorApplication, backarrow = before.backarrow }
                        , after = { cursor = after.cursorApplication, backarrow = after.backarrow }
                        }
          }
        , { name = "the last mouse modes set are the ones reported"
          , test =
                \_ ->
                    Expect.equal
                        { none = { tracking = 0, format = 0 }
                        , set = { tracking = 3, format = 2 }
                        , reset = { tracking = 0, format = 2 }
                        }
                        { none = Vt.mouseModes (term 10 5)
                        , set = Vt.mouseModes (feed "\u{001B}[?1000h\u{001B}[?1002h\u{001B}[?1006h" (term 10 5))
                        , reset = Vt.mouseModes (feed "\u{001B}[?1002h\u{001B}[?1006h\u{001B}[?1002l" (term 10 5))
                        }
          }
        ]


replies : (taken t : Vt.Term) -> Array String
replies t =
    Array.map Support.text (Vt.takeReplies t).replies
