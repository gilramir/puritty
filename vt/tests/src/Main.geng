module Main exposing (main)

{-| The core's unit tests (`docs/vt-core.md` §VC46), with gren-unit-node:

  - `Feed`: printing, the cursor, wrapping, erasing, styles, the
    scrollback and a resize, read through `Vt.dump`.
  - `Resume`: every input fed in two reads split at every byte gives the
    dump of one read.
  - `Select`: selection text, words, lines, the scrollback's rows and the
    prompt jumps.
  - `Replies`: replies, OSC 52's clipboard requests, and the modes the
    encoders read.
  - `Encoders`: keys, the mouse, paste, Base64 and EUC-KR.

The gates under `harness/` hold the core to Ghostty on many cases; these
are the small ones, fast and readable on their own. Run with `./run.sh`.

-}

import Encoders
import Feed
import Node
import Replies
import Resume
import Select
import Settings
import Task exposing (Task)
import Test.Runner.UnitNode as U


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                U.run env
                    { name = "puritty-vt"
                    , version = "0.1.0"
                    , suites = [ Feed.suite, Resume.suite, Select.suite, Replies.suite, Encoders.suite, Settings.suite ]
                    }
            )
