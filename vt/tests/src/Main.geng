module Main exposing (main)

{-| The core's unit tests on node; `VtSuites` says what they are, and
`native/` runs the same suites as a native program. Run with `./run.sh`. -}

import Node
import Task exposing (Task)
import Test.Runner.UnitNode.Program as Program
import VtSuites


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                Program.run env
                    { name = "puritty-vt"
                    , version = "0.1.0"
                    , suites = VtSuites.suites
                    }
            )
