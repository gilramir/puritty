module Sixel exposing (suite)

{-| Sixel (`docs/images-sixel.md` SX2): the image decoded, where it is
placed and where the cursor is left, and the reports. No oracle has
Sixel, so these and the pixel cases hold it; the pixels are checked as
their Adler-32, as the dump prints it, worked out by hand.
-}

import Expect
import Support exposing (feed, term)
import Test.Runner.UnitNode as U
import Vt


{-| A terminal of 10 by 5 cells of 10 by 20 pixels, Sixel on. -}
sixel : {} -> Vt.Term
sixel {} =
    Vt.withExtraImages True (Vt.withCellSize { width = 10, height = 20 } (term 10 5))


{-| The dump's image lines, the image's id (an implicit one) left out. -}
images : Vt.Term -> Array String
images t =
    String.split "\n" (Vt.dump t)
        |> Array.keepIf (\l -> String.startsWith "image " l)
        |> Array.map (\l -> String.split " " l |> Array.dropFirst 2 |> String.join " ")


cursor : Vt.Term -> { x : Int, y : Int }
cursor t =
    let
        c =
            Vt.cursorOf t
    in
    { x = c.x, y = c.y }


replies : (taken t : Vt.Term) -> Array String
replies t =
    Array.map Support.text (Vt.takeReplies t).replies


suite : U.Suite
suite =
    Support.run "Sixel"
        [ { name = "raster attributes set the size, #Pc;2 defines an RGB colour and selects it"
          , test =
                \_ ->
                    Expect.equal [ "2x6 rgba 1241651177 at 0,0 cells 1x1 src 0,0,2,6 off 0,0 z -1" ]
                        (images (feed "\u{001B}Pq\"1;1;2;6#1;2;100;0;0~~\u{001B}\\" (sixel {})))
          }
        , { name = "with no raster, P1 0 makes a bit two pixels tall, in colour 15 before any #"
          , test =
                \_ ->
                    Expect.equal [ "1x12 rgba 3766036645 at 0,0 cells 1x1 src 0,0,1,12 off 0,0 z -1" ]
                        (images (feed "\u{001B}Pq~\u{001B}\\" (sixel {})))
          }
        , { name = "P2 1 leaves the pixels not drawn transparent"
          , test =
                \_ ->
                    Expect.equal [ "2x6 rgba 1404505383 at 0,0 cells 1x1 src 0,0,2,6 off 0,0 z -1" ]
                        (images (feed "\u{001B}P0;1q\"1;1;2;6#1~\u{001B}\\" (sixel {})))
          }
        , { name = "HLS has DEC's hue: 120 red, 240 green, 0 blue"
          , test =
                \_ ->
                    Expect.equal [ "3x6 rgba 193143773 at 0,0 cells 1x1 src 0,0,3,6 off 0,0 z -1" ]
                        (images (feed "\u{001B}Pq\"1;1#1;1;120;50;100~#2;1;240;50;100~#3;1;0;50;100~\u{001B}\\" (sixel {})))
          }
        , { name = "! repeats a sixel"
          , test =
                \_ ->
                    Expect.equal [ "3x6 rgba 493954013 at 0,0 cells 1x1 src 0,0,3,6 off 0,0 z -1" ]
                        (images (feed "\u{001B}Pq\"1;1#1;2;100;0;0!3~\u{001B}\\" (sixel {})))
          }
        , { name = "CAN cuts the string short and what it drew is shown"
          , test =
                \_ ->
                    Expect.equal [ "2x6 rgba 1241651177 at 0,0 cells 1x1 src 0,0,2,6 off 0,0 z -1" ]
                        (images (feed "\u{001B}Pq\"1;1#1;2;100;0;0~~\u{0018}" (sixel {})))
          }
        , { name = "the cursor is left in the start column of the image's bottom row (SX2 9)"
          , test =
                \_ ->
                    Expect.equal { x = 2, y = 3 }
                        (cursor (feed "\u{001B}[2;3H\u{001B}Pq\"1;1;10;50\u{001B}\\" (sixel {})))
          }
        , { name = "with mode 8452 the cursor is left right of the image on its bottom row"
          , test =
                \_ ->
                    Expect.equal { x = 5, y = 3 }
                        (cursor (feed "\u{001B}[?8452h\u{001B}[2;3H\u{001B}Pq\"1;1;21;50\u{001B}\\" (sixel {})))
          }
        , { name = "an image past the bottom scrolls the screen, its top going up with it"
          , test =
                \_ ->
                    let
                        t =
                            feed "\u{001B}[5;1H\u{001B}Pq\"1;1;10;30\u{001B}\\" (sixel {})
                    in
                    Expect.equal { at = [ "10x30 rgba 0 at 0,3 cells 1x2 src 0,0,10,30 off 0,0 z -1" ], cursor = { x = 0, y = 4 } }
                        { at = images t |> Array.map (\l -> String.split " " l |> Array.set 2 "0" |> String.join " "), cursor = cursor t }
          }
        , { name = "with DECSDM set the image is drawn at the top left and the cursor kept"
          , test =
                \_ ->
                    let
                        t =
                            feed "\u{001B}[?80h\u{001B}[3;4H\u{001B}Pq\"1;1;10;30\u{001B}\\" (sixel {})
                    in
                    Expect.equal { at = [ "10x30 rgba 0 at 0,0 cells 1x2 src 0,0,10,30 off 0,0 z -1" ], cursor = { x = 3, y = 2 } }
                        { at = images t |> Array.map (\l -> String.split " " l |> Array.set 2 "0" |> String.join " "), cursor = cursor t }
          }
        , { name = "split across reads, a Sixel string gives the image one read gives"
          , test =
                \_ ->
                    Expect.equal [ "2x6 rgba 1241651177 at 0,0 cells 1x1 src 0,0,2,6 off 0,0 z -1" ]
                        (images (feed "~\u{001B}\\" (feed "\u{001B}Pq\"1;1;2;6#1;2;100;0;0~" (sixel {}))))
          }
        , { name = "with Sixel off (the oracle's terminal) a Sixel string draws nothing"
          , test =
                \_ ->
                    Expect.equal [] (images (feed "\u{001B}Pq\"1;1;2;6~~\u{001B}\\" (Vt.withCellSize { width = 10, height = 20 } (term 10 5))))
          }
        , { name = "with an image limit of 0 a Sixel string draws nothing (IM16)"
          , test =
                \_ ->
                    Expect.equal [] (images (feed "\u{001B}Pq\"1;1;2;6~~\u{001B}\\" (Vt.withImageLimit 0 (sixel {}))))
          }
        , { name = "a Sixel string's size is held to the image limit before its canvas is made (IM5, review VI2)"
          , test =
                \_ ->
                    let
                        small {} =
                            Vt.withImageLimit 960 (sixel {})
                    in
                    -- 30 bytes naming 10,000 by 10,000 pixels: 400 MB, over the
                    -- 10 MB limit, and before the bound it was allocated first
                    Expect.equal
                        { huge = []
                        , fits = [ "20x12 rgba 0 at 0,0 cells 2x1 src 0,0,20,12 off 0,0 z -1" ]
                        , over = []
                        }
                        { huge = images (feed "\u{001B}Pq\"1;1;10000;10000\u{001B}\\" (sixel {}))
                        , fits = images (feed "\u{001B}Pq\"1;1;20;12\u{001B}\\" (small {})) |> Array.map (\l -> String.split " " l |> Array.set 2 "0" |> String.join " ")
                        , over = images (feed "\u{001B}Pq\"1;1;20;13\u{001B}\\" (small {}))
                        }
          }
        , { name = "ED 3 keeps the count of rows pushed, and takes an image in the scrollback with it (review VP3)"
          , test =
                \_ ->
                    let
                        -- an image of one cell at the top, then ten lines,
                        -- which scroll it into the scrollback
                        scrolled {} =
                            feed ("\u{001B}Pq\"1;1;10;20\u{001B}\\" ++ String.repeat 10 "\r\nline") (sixel {})

                        before =
                            Vt.rowsPushed (scrolled {})

                        after =
                            feed "\u{001B}[3J" (scrolled {})
                    in
                    Expect.equal { pushed = before, images = [], scrollback = 0 }
                        { pushed = Vt.rowsPushed after, images = images after, scrollback = Vt.scrollbackRows after }
          }
        , { name = "an opaque image drawn over an older one takes its cells, so animation frames do not pile up; a transparent one leaves it (review VI5)"
          , test =
                \_ ->
                    let
                        -- frames of 20 by 20 pixels, two cells by one, at the top
                        -- left, the cursor sent home between them
                        frames p2 =
                            String.repeat 5 ("\u{001B}[H\u{001B}P0;" ++ p2 ++ "q\"1;1;20;20#1;2;100;0;0~\u{001B}\\")
                    in
                    Expect.equal { opaque = 1, transparent = 5 }
                        { opaque = Array.length (images (feed (frames "0") (sixel {})))
                        , transparent = Array.length (images (feed (frames "1") (sixel {})))
                        }
          }
        , { name = "a Sixel string's painting is held to sixteen times its canvas: 10,000 repeats of !10000~ end (review VI10)"
          , test =
                \_ ->
                    -- 90 KB painting 1,200 million pixels before; a canvas of
                    -- 10,000 by 12, about 2 million writes now
                    Expect.equal [ "10000x12" ]
                        (images (feed ("\u{001B}Pq#1;2;100;0;0" ++ String.repeat 10000 "!10000~$" ++ "\u{001B}\\") (sixel {}))
                            |> Array.map (\l -> String.split " " l |> Array.first |> Maybe.withDefault "")
                        )
          }
        , { name = "XTSMGRAPHICS answers the colour registers and the geometry"
          , test =
                \_ ->
                    Expect.equal [ "\u{001B}[?1;0;1024S", "\u{001B}[?2;0;100;100S", "\u{001B}[?2;0;10000;10000S", "\u{001B}[?1;3;0S", "\u{001B}[?3;1;0S" ]
                        (replies (feed "\u{001B}[?1;1S\u{001B}[?2;1S\u{001B}[?2;4S\u{001B}[?1;3;64S\u{001B}[?3;1S" (sixel {})))
          }
        , { name = "text written over an image takes the cells it is in (IM23)"
          , test =
                \_ ->
                    Expect.equal [ "erased 1,0,2,1" ] (erased (feed "\u{001B}[1;2Hab" (block {})))
          }
        , { name = "a character at a time over an image makes one hole"
          , test =
                \_ ->
                    Expect.equal [ "erased 0,1,3,1" ] (erased (feed "c" (feed "b" (feed "\u{001B}[2;1Ha" (block {})))))
          }
        , { name = "EL and ECH take the cells they erase, past the row's text too"
          , test =
                \_ ->
                    Expect.equal [ "erased 1,1,2,1;0,0,2,1" ] (erased (feed "\u{001B}[1;1H\u{001B}[2X" (feed "\u{001B}[2;2H\u{001B}[K" (block {}))))
          }
        , { name = "ED 0 from the top left, tmux's clear, takes the whole image"
          , test =
                \_ ->
                    Expect.equal [] (images (feed "\u{001B}[H\u{001B}[J" (block {})))
          }
        , { name = "ED 1 takes the rows above the cursor and its row up to it"
          , test =
                \_ ->
                    Expect.equal [ "erased 0,1,2,1;0,0,3,1" ] (erased (feed "\u{001B}[2;2H\u{001B}[1J" (block {})))
          }
        , { name = "every row lost one at a time, the image is gone"
          , test =
                \_ ->
                    Expect.equal [] (images (feed "\u{001B}[2;1H\u{001B}[2K" (feed "\u{001B}[1;1H\u{001B}[2K" (block {}))))
          }
        , { name = "ICH, DCH, IL and DL take the cells they move"
          , test =
                \_ ->
                    Expect.equal [ [ "erased 1,0,2,1" ], [ "erased 2,1,1,1" ], [], [ "erased 0,1,3,1" ] ]
                        [ erased (feed "\u{001B}[1;2H\u{001B}[@" (block {}))
                        , erased (feed "\u{001B}[2;3H\u{001B}[P" (block {}))
                        , images (feed "\u{001B}[1;1H\u{001B}[L" (block {}))
                        , erased (feed "\u{001B}[2;1H\u{001B}[M" (block {}))
                        ]
          }
        , { name = "text beside an image leaves it whole"
          , test =
                \_ ->
                    Expect.equal [ "" ] (erased (feed "\u{001B}[1;5Hab\u{001B}[3;1H\u{001B}[K" (block {})))
          }
        , { name = "a Kitty image is left as Ghostty leaves it"
          , test =
                \_ ->
                    Expect.equal [ "" ] (erased (feed "\u{001B}[1;1Hab" (feed ("\u{001B}_Ga=T,f=24,s=30,v=40,q=2;" ++ String.repeat 1200 "AAAA" ++ "\u{001B}\\") (sixel {}))))
          }
        , { name = "in a tmux pane (kittyErases) text over a Kitty image takes its cells (IM30)"
          , test =
                \_ ->
                    Expect.equal [ "erased 0,0,2,1" ] (erased (feed "\u{001B}[1;1Hab" (kittyBlock {})))
          }
        , { name = "in a tmux pane, ED 0 from the top left, tmux's clear, takes a Kitty image (IM30)"
          , test =
                \_ ->
                    Expect.equal [] (images (feed "\u{001B}[H\u{001B}[J" (kittyBlock {})))
          }
        ]


{-| A Kitty image of 3 by 2 cells (30 by 40 pixels) at the top left, in a
terminal whose Kitty images are drawn into the cells, as tmux's panes'. -}
kittyBlock : {} -> Vt.Term
kittyBlock {} =
    feed ("\u{001B}_Ga=T,f=24,s=30,v=40,q=2;" ++ String.repeat 1200 "AAAA" ++ "\u{001B}\\") (Vt.withKittyErases True (sixel {}))


{-| An image of 3 by 2 cells (30 by 36 pixels) at the top left, the cursor
left on its bottom row. -}
block : {} -> Vt.Term
block {} =
    feed ("\u{001B}Pq\"1;1;30;36#1;2;100;0;0" ++ String.repeat 6 "!30~-" ++ "\u{001B}\\") (sixel {})


{-| Each image's lost cells, as the dump prints them, or "" for none. -}
erased : Vt.Term -> Array String
erased t =
    images t
        |> Array.map
            (\l ->
                when String.firstIndexOf " erased " l is
                    Just at ->
                        String.dropFirst (at + 1) l

                    Nothing ->
                        ""
            )
