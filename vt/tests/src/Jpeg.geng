module Jpeg exposing (suite)

{-| `Vt.Jpeg` (`docs/images-iterm.md` IT4): small JPEGs Pillow made
(`gen-jpeg.py`, `JpegCases`), each decoded and held to the pixels libjpeg
decodes it to. The two differ by their inverse transforms, libjpeg's in
integers: measured, 2 at most, 3 where chroma is subsampled, hence 3.
-}

import Bytes exposing (Bytes)
import Expect
import JpegCases
import Support
import Test.Runner.UnitNode as U
import UInt8
import Vt.Base64 as Base64
import Vt.Jpeg as Jpeg


{-| The largest difference of a channel from libjpeg's, or -1 for an image
not decoded or of another size. -}
difference : JpegCases.Case -> Int
difference c =
    when Base64.decode (Bytes.fromString c.jpeg) |> Maybe.map (Jpeg.decode 100000000) is
        Just (Ok img) ->
            if img.width /= c.width || img.height /= c.height then
                -1

            else
                Array.range 0 (c.width * c.height * 3 - 1)
                    |> Array.foldl
                        (\i acc ->
                            let
                                ours =
                                    Maybe.withDefault -1 (Maybe.map UInt8.toInt (Bytes.get ((i // 3) * 4 + modBy 3 i) img.pixels))

                                theirs =
                                    Maybe.withDefault -1 (Array.get i c.rgb)
                            in
                            max acc (max (ours - theirs) (theirs - ours))
                        )
                        0

        _ ->
            -1


{-| The first pixel's RGB of a JPEG in base64, or nothing. -}
firstPixel : String -> Maybe (Array Int)
firstPixel b64 =
    when Base64.decode (Bytes.fromString b64) |> Maybe.map (Jpeg.decode 100000000) is
        Just (Ok img) ->
            Just (Array.initialize 3 0 (\i -> Maybe.withDefault -1 (Maybe.map UInt8.toInt (Bytes.get i img.pixels))))

        _ ->
            Nothing


{-| Flat grey JPEGs, 8 by 8, 4:4:4, quality 95, of 0, 128 and 200, which
libjpeg decodes to the same grey. -}
greys : Array { grey : Int, jpeg : String }
greys =
    [ { grey = 0, jpeg = "" }
    , { grey = 128, jpeg = "" }
    , { grey = 200, jpeg = "" }
    ]


suite : U.Suite
suite =
    Support.run "Jpeg"
        ([ { name = "a second frame (SOF) is refused, not taken in place of the first (review VI19)"
           , test =
                \_ ->
                    let
                        width b64 =
                            when Base64.decode (Bytes.fromString b64) is
                                Just data ->
                                    Jpeg.decode 100000000 data |> Result.map .width

                                Nothing ->
                                    Err "base64"
                    in
                    Expect.equal { one = Ok 8, two = Err "a second frame" }
                        { one = width ""
                        , two = width ""
                        }
           }
         , { name = "a flat grey is grey, green not one above red and blue (review VI12)"
           , test =
                \_ ->
                    Expect.equal (Array.map (\g -> Just [ g.grey, g.grey, g.grey ]) greys) (Array.map (\g -> firstPixel g.jpeg) greys)
           }
         ]
            ++ Array.map
                (\c ->
                    { name = c.name ++ ": within 3 of libjpeg"
                    , test =
                        \_ ->
                            let
                                d =
                                    difference c
                            in
                            Expect.equal { decoded = True, within = True } { decoded = d >= 0, within = d <= 3 }
                    }
                )
                JpegCases.cases
            ++ [ { name = "a lossless JPEG (SOF3) says it is not decoded"
                 , test =
                    \_ ->
                        Expect.equal (Err "a JPEG process not decoded (lossless, hierarchical or arithmetic)")
                            (Jpeg.decode 100000000 (Bytes.fromUInt8s (Array.map UInt8.fromInt [ 0xFF, 0xD8, 0xFF, 0xC3, 0x00, 0x0B, 0x08, 0x00, 0x01, 0x00, 0x01, 0x01, 0x01, 0x11, 0x00, 0xFF, 0xD9 ])) |> Result.map .width)
                 }
               , { name = "a scan's components are bounded and named once, and a file's scans are bounded (review VI3)"
                 , test =
                    \_ ->
                        let
                            -- SOS naming component 1 alone, for the whole band, with
                            -- no entropy data after it
                            again =
                                [ 0xFF, 0xDA, 0x00, 0x08, 0x01, 0x01, 0x00, 0x00, 0x3F, 0x00 ]

                            -- SOS naming component 1 five times
                            five =
                                [ 0xFF, 0xDA, 0x00, 0x10, 0x05, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x3F, 0x00 ]

                            -- a progressive DC refinement of component 1, with
                            -- no entropy data after it
                            refine =
                                [ 0xFF, 0xDA, 0x00, 0x08, 0x01, 0x01, 0x00, 0x00, 0x00, 0x10 ]

                            withScans name extra =
                                when Array.findFirst (\c -> c.name == name) JpegCases.cases is
                                    Just found ->
                                        when Base64.decode (Bytes.fromString found.value.jpeg) is
                                            Just jpeg ->
                                                Jpeg.decode 100000000
                                                    (Bytes.flatten
                                                        [ Bytes.slice 0 (Bytes.length jpeg - 2) jpeg
                                                        , Bytes.fromUInt8s (Array.map UInt8.fromInt (extra ++ [ 0xFF, 0xD9 ]))
                                                        ]
                                                    )
                                                    |> Result.map .width

                                            Nothing ->
                                                Err "no fixture"

                                    Nothing ->
                                        Err "no fixture"
                        in
                        Expect.equal
                            { again = Err "a component scanned twice"
                            , five = Err "a scan's count of components"
                            , fewRefinements = Ok 24
                            , manyRefinements = Err "too many scans"
                            }
                            { again = withScans "rgb 4:4:4, quality 95" again
                            , five = withScans "rgb 4:4:4, quality 95" five
                            , fewRefinements = withScans "progressive 4:4:4" (Array.flatten (Array.repeat 10 refine))
                            , manyRefinements = withScans "progressive 4:4:4" (Array.flatten (Array.repeat 100 refine))
                            }
                 }
               ]
        )
