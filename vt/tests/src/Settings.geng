module Settings exposing (suite)

{-| What puritty changes in a running terminal when its settings are read
again (puritty `docs/settings.md` ST4): the named colours, over the
defaults, and the scrollback's bound in bytes; and what it paints over the
screen and takes away, its menu (ST26).
-}

import Expect
import Support exposing (feed, term)
import Test.Runner.UnitNode as U
import Vt


{-| What OSC 4 answers for colour `n`. -}
colour : Int -> (taken t : Vt.Term) -> Array String
colour n t =
    Array.map Support.text (Vt.takeReplies (feed ("\u{001B}]4;" ++ String.fromInt n ++ ";?\u{0007}") t)).replies


{-| A terminal 5 wide and 2 high whose scrollback is kept in pages of 16
rows, so that a few dozen lines fill pages, with room for `rows` rows. -}
paged : Int -> Vt.Term
paged rows =
    Vt.new
        { cols = 5
        , rows = 2
        , scrollbackBytes = Vt.scrollbackBytesFor { cols = 5, rows = rows }
        , pageRows = 16
        , checksums = False
        , cellWidth = 0
        , cellHeight = 0
        }


{-| `n` numbered lines, each ended. -}
numbered : Int -> String
numbered n =
    Array.range 1 n |> Array.map (\i -> String.fromInt i ++ "\r\n") |> String.join ""


suite : U.Suite
suite =
    Support.run "Settings"
        [ { name = "setPalette sets the colours it is given"
          , test =
                \_ ->
                    Expect.equal [ "\u{001B}]4;1;rgb:ffff/0000/0000\u{0007}" ]
                        (colour 1 (Vt.setPalette [ 0, 0xFF0000 ] (term 10 2)))
          }
        , { name = "setPalette gives back the defaults of the colours it is no longer given"
          , test =
                \_ ->
                    Expect.equal (colour 3 (term 10 2))
                        (colour 3 (Vt.setPalette [ 0 ] (Vt.withPalette [ 0, 0, 0, 0x123456 ] (term 10 2))))
          }
        , { name = "withPalette keeps the colours it is not given, which setPalette does not"
          , test =
                \_ ->
                    Expect.equal [ "\u{001B}]4;3;rgb:1212/3434/5656\u{0007}" ]
                        (colour 3 (Vt.withPalette [ 0 ] (Vt.withPalette [ 0, 0, 0, 0x123456 ] (term 10 2))))
          }
        , { name = "a smaller scrollback holds what one made with it would"
          , test =
                \_ ->
                    Expect.equal (Vt.dump (feed (numbered 300) (paged 40)))
                        (Vt.dump (Vt.setScrollbackBytes (Vt.scrollbackBytesFor { cols = 5, rows = 40 }) (feed (numbered 300) (paged 1000))))
          }
        , { name = "a scrollback of no bytes holds what one made with none would"
          , test =
                \_ ->
                    Expect.equal (Vt.dump (feed (numbered 300) (paged 0)))
                        (Vt.dump (Vt.setScrollbackBytes 0 (feed (numbered 300) (paged 1000))))
          }
        , { name = "a smaller scrollback holds less"
          , test =
                \_ ->
                    let
                        full =
                            feed (numbered 300) (paged 1000)

                        before =
                            Vt.scrollbackRows full
                    in
                    Expect.lessThan before (Vt.scrollbackRows (Vt.setScrollbackBytes (Vt.scrollbackBytesFor { cols = 5, rows = 40 }) full))
          }
        , { name = "a larger scrollback keeps what there is and lets it grow"
          , test =
                \_ ->
                    let
                        small =
                            feed (numbered 100) (paged 32)

                        before =
                            Vt.scrollbackRows small

                        grown =
                            feed (numbered 100) (Vt.setScrollbackBytes (Vt.scrollbackBytesFor { cols = 5, rows = 1000 }) small)
                    in
                    Expect.equal { kept = True, grew = True }
                        { kept = before > 0 && before < 100, grew = Vt.scrollbackRows grown > before + 90 }
          }
            , { name = "viewPainted paints text over the screen's cells"
          , test =
                \_ ->
                    Expect.equal [ "0 |abXYZfgh|", "1 |ijkl|" ]
                        (painted [ { row = 0, col = 2, text = "XYZ" } ] (feed "abcdefgh\r\nijkl" (term 8 2)))
          }
        , { name = "viewPainted leaves the term as it was"
          , test =
                \_ ->
                    let
                        t =
                            feed "abcdefgh" (term 8 2)

                        v =
                            Vt.viewPainted [ { row = 0, col = 2, text = "XYZ" } ] t
                    in
                    Expect.equal [ "0 |abcdefgh|" ] (Support.lines t |> Array.keepIf (String.startsWith "0 |"))
          }
        , { name = "viewPainted paints past a row's text, and wide characters two cells"
          , test = \_ -> Expect.equal [ "0 |ab  한글|" ] (painted [ { row = 0, col = 4, text = "한글" } ] (feed "ab" (term 10 1)))
          }
        , { name = "viewPainted mends a wide character it cuts at either edge"
          , test = \_ -> Expect.equal [ "0 | xy |" ] (painted [ { row = 0, col = 1, text = "xy" } ] (feed "한글" (term 6 1)))
          }
        ]


{-| The rows of a view's screen, as `Support.lines` reads a term's. -}
painted : Array { row : Int, col : Int, text : String } -> (taken t : Vt.Term) -> Array String
painted paints t =
    Support.lines (Vt.paint paints t)
        |> Array.keepIf (\l -> String.startsWith "0 |" l || String.startsWith "1 |" l)
