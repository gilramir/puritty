module Vt.Recut exposing
    ( recut
    , popLast
    , packArray
    )

{-| Part of `Vt` (docs/vt-core.md §VC23): the scrollback's pages reflowed
at a resize, on their bytes (V20, §VC31).

A line whose cells are all one column wide, ASCII or a code point of width
1, protected or not, with no spacer head and no cell in a background colour
alone, is cut again without a cell made of it: its bytes are copied
from the pages it was on into new pages, a row's header written each time
it fills, its style runs cut where its rows are. Any other line is read back
into rows and reflowed by `reflowed`, the reflow a resize makes of the
ring, and packed again. Either way a page's rows are what `reflowed` makes
of them, which is what V10 and V16 made of a page when it was read.

A line on plain pages (`Page.plain`: no style, a byte a cell) is cut on its
headers alone (§VC33): a row's text ends at its extent, so no byte is
walked. A line's text is copied a range at a time from the page it is on,
which is only lent (`Bytes.Owned.appendTo`), into the builder of the page
being written, which is made owned at its end (§VC39). A page written is
plain when every row put in it was.

The new rows fill pages of `pageRows` rows, as `pageOut` cuts the ring's,
whatever pages they came from: a widening makes fewer pages, and a
narrowing more, which can be more than the scrollback keeps; the resize
drops the oldest then, as a push past the limit does.

-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes.Owned as Owned exposing (Owned)
import Int64
import UInt8
import Vt.Width as Width
import Vt.Cell exposing (..)
import Vt.Style exposing (..)
import Vt.Term exposing (..)
import Vt.Pages exposing (..)


{-| The pages being written: those done, and the one being written, its
text, headers and style runs. `plain`: every row put in the page was
plain. -}
type alias Out =
    { done : Array Page
    , pageRows : Int
    , text : Builder UInt8
    , heads : Builder UInt8
    , runs : Builder UInt8
    , plain : Bool
    }


{-| The row being written: its cells so far, the style run in hand (as
`packCells` keeps it), and the prompt mark a row cut here takes. -}
type alias Pen =
    { n : Int
    , style : Int
    , count : Int
    , wrote : Bool
    , mark : Int
    }


{-| A row of a source page: its page, its header, and where its text and
its style runs begin and end; `fast` when its cells are all one column. -}
type alias Source =
    { pi : Int
    , header : Int
    , ti : Int
    , tEnd : Int
    , r : Int
    , fast : Bool
    }


{-| The first `n` of `pages`, cut at `old` columns and each ending at a
line's end, cut again at `cols`. `reflow` is `Vt.Resize.reflowed`. The pages
are only read, and each one's plainness decided once (`plainPage`), in
`plains`, which the walk reads for whether a page is plain and how many
pages it walks. -}
recut : Int -> (Int -> Int -> Array Row -> Array Row) -> Int -> Int -> Clusters -> Int -> Array Page -> { pages : Array Page, clusters : Clusters }
recut pageRows reflow old cols clusters n pages =
    let
        o =
            lines reflow old cols (plainsOf n pages 0 []) pages 0 0 0 0 clusters (blank pageRows [])
    in
    { pages = finish cols o.out, clusters = o.clusters }


plainsOf : Int -> Array Page -> Int -> Array Bool -> Array Bool
plainsOf n pages i acc =
    if i >= n || i >= Array.length pages || i < 0 then
        acc

    else
        plainsOf n pages (i + 1) (Array.pushLast (plainPage (Array.getProven i pages)) acc)


{-| Whether page `pi` is plain; false for one past the pages `recut`
walks. -}
plainAt : Array Bool -> Int -> Bool
plainAt plains pi =
    Maybe.withDefault False (Array.get pi plains)


{-| A page of `pageRows` rows begun after `done`. -}
blank : Int -> (taken done : Array Page) -> Out
blank pageRows done =
    { done = done
    , pageRows = pageRows
    , text = Builder.empty 256
    , heads = Builder.empty 512
    , runs = Builder.empty 256
    , plain = True
    }


finish : Int -> (taken o : Out) -> Array Page
finish cols o =
    if Builder.length o.heads == 0 then
        o.done

    else
        let
            plain =
                if o.plain then
                    Plain

                else
                    NotPlain
        in
        Array.pushLast
            { text = Owned.fromBuilder o.text
            , heads = Owned.fromBuilder o.heads
            , runs = Owned.fromBuilder o.runs
            , cols = cols
            , plain = plain
            }
            o.done


{-| Bytes `from` to `to` of page `pi`'s text put after the page's text. -}
sliceIn : Array Page -> Int -> Int -> Int -> (taken o : Out) -> Out
sliceIn pages pi from to o =
    when Array.get pi pages is
        Just page ->
            { o | text = Owned.appendTo from to page.text o.text }

        Nothing ->
            o


{-| A row about to start: the page being written kept, and a new one begun
when it holds `pageRows` rows. -}
toPage : Int -> (taken o : Out) -> Out
toPage cols o =
    let
        pageRows =
            o.pageRows
    in
    if Builder.length o.heads < 2 * pageRows then
        o

    else
        blank pageRows (finish cols o)


{-| Every line from page `pi`, its header `h`, text `ti` and runs `r` on. -}
lines : (Int -> Int -> Array Row -> Array Row) -> Int -> Int -> Array Bool -> Array Page -> Int -> Int -> Int -> Int -> Clusters -> (taken o : Out) -> { out : Out, clusters : Clusters }
lines reflow old cols plains pages pi h ti r clusters o =
    when (if pi < Array.length plains then Array.get pi pages else Nothing) is
        Nothing ->
            { out = o, clusters = clusters }

        Just page ->
            if h >= Owned.length page.heads then
                lines reflow old cols plains pages (pi + 1) 0 0 0 clusters o

            else
                when plainSpans old plains pages pi h ti ti [] is
                    Just plain ->
                        lines reflow old cols plains pages plain.pi plain.h plain.ti 0 clusters (plainLine cols pages plain.spans plain.last o)

                    Nothing ->
                        anyLine reflow old cols plains pages pi h ti r clusters o


{-| The line from page `pi`, header `h`, text `ti` and runs `r`, cut on its
bytes, or reflowed as rows, and the lines after it. -}
anyLine : (Int -> Int -> Array Row -> Array Row) -> Int -> Int -> Array Bool -> Array Page -> Int -> Int -> Int -> Int -> Clusters -> (taken o : Out) -> { out : Out, clusters : Clusters }
anyLine reflow old cols plains pages pi h ti r clusters o =
    let
        line =
            gather plains pages pi h ti r []

        rows =
            line.rows
    in
    if Array.all .fast rows then
        lines reflow old cols plains pages line.pi line.h line.ti line.r clusters (fastLine old cols pages rows o)

    else
        let
            slow =
                slowLine reflow old cols pages rows clusters o
        in
        lines reflow old cols plains pages line.pi line.h line.ti line.r slow.clusters slow.out


{-| The source rows of the line that starts at page `pi`, header `h`, up to
the first that does not wrap, and where the next line starts. -}
gather : Array Bool -> Array Page -> Int -> Int -> Int -> Int -> Array Source -> { rows : Array Source, pi : Int, h : Int, ti : Int, r : Int }
gather plains pages pi h ti r acc =
    when (if pi < Array.length plains then Array.get pi pages else Nothing) is
        Nothing ->
            { rows = acc, pi = pi, h = h, ti = ti, r = r }

        Just page ->
            if h >= Owned.length page.heads then
                gather plains pages (pi + 1) 0 0 0 acc

            else
                let
                    header =
                        u16At page.heads h

                    ext =
                        Bitwise.and 0x3FF header

                    scanned =
                        if plainAt plains pi then
                            ti + ext

                        else
                            scan page.text ti ext

                    tEnd =
                        if scanned >= 0 then
                            scanned

                        else
                            (unpackText page.text ti ext []).next

                    rEnd =
                        if Bitwise.and 0x4000 header /= 0 then
                            r

                        else
                            runsEnd page.runs r ext

                    row =
                        { pi = pi, header = header, ti = ti, tEnd = tEnd, r = r, fast = scanned >= 0 }

                    acc2 =
                        Array.pushLast row acc
                in
                if Bitwise.and 0x8000 header /= 0 then
                    gather plains pages pi (h + 2) tEnd rEnd acc2

                else
                    { rows = acc2, pi = pi, h = h + 2, ti = tEnd, r = rEnd }


{-| Where a row's `left` cells from byte `i` end, if every one is a single
column with nothing joined to it but its protection; -1 if one is not. -}
scan : Owned -> Int -> Int -> Int
scan text i left =
    if left <= 0 then
        if ownedAt text i == 0xFD then
            -- the last cell's protection
            scan text (i + 1) 0

        else if startsMark text i then
            -1

        else
            i

    else
        let
            b =
                ownedAt text i
        in
        if b < 0x80 then
            scan text (i + 1) (left - 1)

        else if b == 0xFD then
            -- the cell before is protected: the byte is that cell's
            scan text (i + 1) left

        else if b >= 0xF8 then
            -1

        else
            let
                d =
                    decodeAt text i
            in
            if Width.width d.cp == 1 then
                scan text d.next (left - 1)

            else
                -1


{-| Where a row's style runs for `left` cells end, as `unpackRuns` reads
them. -}
runsEnd : Owned -> Int -> Int -> Int
runsEnd runs r left =
    if left <= 0 then
        r

    else
        let
            v =
                u16At runs r
        in
        if Bitwise.and 0x8000 v /= 0 then
            runsEnd runs (r + 4) (left - u16At runs (r + 2))

        else
            r + 2


{-| The last row of the last page taken off it, as the ring keeps a row:
the start of a line the ring's rows go on with, cut at the new width, to
begin the ring's first line (§VC31). A page left with no row goes. -}
popLast : Clusters -> (taken pages : Array Page) -> { pages : Array Page, prefix : Row, clusters : Clusters }
popLast clusters pages =
    let
        count =
            Array.length pages

        -- the last page read, and its rows but the last copied into a
        -- page of their own, before the array is cut
        last =
            when Array.last pages is
                Nothing ->
                    Nothing

                Just page ->
                    let
                        n =
                            Owned.length page.heads

                        src =
                            lastSource page (count - 1) 0 0 0

                        one =
                            rowAt page src clusters
                    in
                    Just
                        { rest =
                            if n <= 2 then
                                []

                            else
                                [ shortened n src page ]
                        , prefix = one.row
                        , clusters = one.clusters
                        }
    in
    when last is
        Nothing ->
            { pages = pages, prefix = { cells = [], wrapped = False, prompt = 0 }, clusters = clusters }

        Just l ->
            { pages = Array.takeFirst (count - 1) pages ++ l.rest
            , prefix = l.prefix
            , clusters = l.clusters
            }


{-| A page's rows but its last, `src` of `n` header bytes, as a page of
their own: copied, since a page taken out of an array is not one the
in-place marks can show is its own (geng-lang `m4-owned-pages.md` §OP18);
it is one page, once a resize. -}
shortened : Int -> Source -> Page -> Page
shortened n src page =
    { heads = Owned.fromBuilder (Owned.appendTo 0 (n - 2) page.heads (Builder.empty (n - 2)))
    , text = Owned.fromBuilder (Owned.appendTo 0 src.ti page.text (Builder.empty src.ti))
    , runs = Owned.fromBuilder (Owned.appendTo 0 src.r page.runs (Builder.empty src.r))
    , cols = page.cols
    , plain = page.plain
    }


{-| The page's last row as a source row: its rows walked from header `h`,
text `ti` and runs `r`. -}
lastSource : Page -> Int -> Int -> Int -> Int -> Source
lastSource page pi h ti r =
    let
        header =
            u16At page.heads h

        ext =
            Bitwise.and 0x3FF header
    in
    if h + 2 >= Owned.length page.heads then
        { pi = pi, header = header, ti = ti, tEnd = 0, r = r, fast = False }

    else
        let
            scanned =
                if page.plain == Plain then
                    ti + ext

                else
                    scan page.text ti ext

            tEnd =
                if scanned >= 0 then
                    scanned

                else
                    (unpackText page.text ti ext []).next

            rEnd =
                if Bitwise.and 0x4000 header /= 0 then
                    r

                else
                    runsEnd page.runs r ext
        in
        lastSource page pi (h + 2) tEnd rEnd


-- A PLAIN LINE ON ITS HEADERS


{-| The line from page `pi`, header `h`, text `ti` as spans of its pages'
text, one a page, when it is plain (§VC33): on plain pages, with no prompt
mark, and every row that wraps full, so that no empty cells pad it; and
where the next line starts. `from`: where this page's part began. Nothing
when it is not, and the line is cut otherwise. -}
plainSpans : Int -> Array Bool -> Array Page -> Int -> Int -> Int -> Int -> Array Span -> Maybe { spans : Array Span, last : Int, pi : Int, h : Int, ti : Int }
plainSpans old plains pages pi h ti from acc =
    when (if pi < Array.length plains then Array.get pi pages else Nothing) is
        Nothing ->
            -- the pages end inside the line: every row of it wraps, and
            -- none has its empty cells trimmed
            when Array.last acc is
                Nothing ->
                    Nothing

                Just span ->
                    Just { spans = acc, last = span.to, pi = pi, h = h, ti = ti }

        Just page ->
            if not (plainAt plains pi) then
                Nothing

            else if h >= Owned.length page.heads then
                plainSpans old plains pages (pi + 1) 0 0 0 (pushSpan pi from ti acc)

            else
                let
                    header =
                        u16At page.heads h

                    ext =
                        Bitwise.and 0x3FF header

                    wraps =
                        Bitwise.and 0x8000 header /= 0
                in
                if Bitwise.and 0xC00 header /= 0 || (wraps && ext /= old) then
                    Nothing

                else if wraps then
                    plainSpans old plains pages pi (h + 2) (ti + ext) from acc

                else
                    Just { spans = Array.pushLast { pi = pi, from = from, to = ti + ext } acc, last = ti, pi = pi, h = h + 2, ti = ti + ext }


{-| A page's part of a line: page `pi`'s text from `from` to `to`. -}
type alias Span =
    { pi : Int, from : Int, to : Int }


{-| A page's part of a line, when it has bytes. -}
pushSpan : Int -> Int -> Int -> Array Span -> Array Span
pushSpan pi from to acc =
    if to > from || Array.isEmpty acc then
        Array.pushLast { pi = pi, from = from, to = to } acc

    else
        acc


{-| A plain line cut at `cols`, as `fastLine` cuts it: its cells the spans'
text, without the empty cells that end its last row (which begins at byte
`last` of the last span); every row full and wrapped but the last; its text
copied as slices, a page's worth at a time. -}
plainLine : Int -> Array Page -> Array Span -> Int -> (taken o : Out) -> Out
plainLine cols pages spans0 last o =
    let
        spans =
            when Array.last spans0 is
                Just span ->
                    let
                        trailing =
                            when Array.get span.pi pages is
                                Just page ->
                                    zeros page.text (span.to - 1) (max span.from last) 0

                                Nothing ->
                                    0
                    in
                    Array.set (Array.length spans0 - 1) { span | to = span.to - trailing } spans0

                Nothing ->
                    spans0

        total =
            Array.foldl (\sp n -> n + sp.to - sp.from) 0 spans

        count =
            if total == 0 then
                1

            else
                (total + cols - 1) // cols
    in
    plainRows cols pages spans total count 0 0 -1 o


{-| Rows `r` on of a plain line of `count` rows, `left` cells to go, its
text from span `j` byte `at`: as many as the page has room for, then the
rest on a new page. -}
plainRows : Int -> Array Page -> Array Span -> Int -> Int -> Int -> Int -> Int -> (taken o : Out) -> Out
plainRows cols pages spans left count r j at o =
    if r >= count then
        o

    else
        let
            o0 =
                toPage cols o

            b =
                min (o0.pageRows - Builder.length o0.heads // 2) (count - r)

            cells =
                min left (b * cols)

            taken =
                takeSpans pages spans cells j at o0

            out =
                taken.out

            heads =
                plainHeads cols (cells - (b - 1) * cols) (left - cells == 0) b out.heads
        in
        plainRows cols pages spans (left - cells) count (r + b) taken.j taken.at { out | heads = heads }


{-| `b` rows' headers: full and wrapped, all but the last, which has
`lastN` cells and, when it `ends` the line, does not wrap. -}
plainHeads : Int -> Int -> Bool -> Int -> (taken heads : Builder UInt8) -> Builder UInt8
plainHeads cols lastN ends b heads =
    if b <= 0 then
        heads

    else if b == 1 then
        if ends then
            pushU16 (Bitwise.or 0x4000 lastN) heads

        else
            pushU16 (Bitwise.or 0xC000 cols) heads

    else
        plainHeads cols lastN ends (b - 1) (pushU16 (Bitwise.or 0xC000 cols) heads)


{-| `n` bytes of the spans from span `j` byte `at` put after the page's
text; an `at` before the span's `from`, -1 to start a span, is its
`from`. -}
takeSpans : Array Page -> Array Span -> Int -> Int -> Int -> (taken o : Out) -> { out : Out, j : Int, at : Int }
takeSpans pages spans n j at o =
    if n <= 0 then
        { out = o, j = j, at = at }

    else
        when Array.get j spans is
            Nothing ->
                { out = o, j = j, at = at }

            Just span ->
                let
                    from =
                        max at span.from
                in
                if from >= span.to then
                    takeSpans pages spans n (j + 1) -1 o

                else
                    let
                        t =
                            min n (span.to - from)
                    in
                    takeSpans pages spans (n - t) j (from + t) (sliceIn pages span.pi from (from + t) o)


-- A LINE ON ITS BYTES


{-| A line of single-column cells cut at `cols`: each source row's cells,
a wrapped row's up to `old` with empty cells after its extent, the last
row's up to its last cell that is not empty, or its first cell when it has
none but a prompt mark, as `joinLines` takes them. -}
fastLine : Int -> Int -> Array Page -> Array Source -> (taken o : Out) -> Out
fastLine old cols pages rows o =
    let
        done =
            Array.foldl
                (\row acc ->
                    let
                        ext =
                            Bitwise.and 0x3FF row.header

                        wrapped =
                            Bitwise.and 0x8000 row.header /= 0

                        mark =
                            Bitwise.and 3 (Bitwise.shiftRightZfBy 10 row.header)

                        trailing =
                            if wrapped then
                                0

                            else
                                when Array.get row.pi pages is
                                    Just page ->
                                        zeros page.text (row.tEnd - 1) row.ti 0

                                    Nothing ->
                                        0

                        own =
                            if wrapped then
                                ext

                            else if ext - trailing == 0 && mark /= 0 then
                                min 1 ext

                            else
                                ext - trailing

                        pad =
                            if wrapped then
                                max 0 (old - ext)

                            else if ext - trailing == 0 && mark /= 0 && ext == 0 then
                                1

                            else
                                0

                        pen0 =
                            acc.pen

                        pen =
                            if own + pad > 0 then
                                { pen0 | mark = mark }

                            else
                                pen0

                        -- a byte a cell: no byte walked to cut it (§VC41);
                        -- and no style besides: the new page stays plain
                        src =
                            { styled = Bitwise.and 0x4000 row.header == 0
                            , pi = row.pi
                            , plain = Bitwise.and 0x4000 row.header /= 0 && row.tEnd - row.ti == ext
                            , narrow = row.tEnd - row.ti == ext
                            }

                        cells =
                            chunks cols pages src row.ti own { at = row.r, left = 0, style = 0 } acc.out pen

                        padded =
                            chunks cols pages { src | styled = False, plain = True, narrow = True } -1 pad { at = 0, left = 0, style = 0 } cells.out cells.pen
                    in
                    { out = padded.out, pen = padded.pen, any = acc.any || own + pad > 0 }
                )
                { out = o, pen = { n = 0, style = 0, count = 0, wrote = False, mark = 0 }, any = False }
                rows

        out =
            if done.any then
                done.out

            else
                toPage cols done.out
    in
    closeRow False done.pen out


{-| How many empty cells end a row's text, from byte `i` back to `from`:
0 bytes, protected or not, as `emptyCell` does not see protection. -}
zeros : Owned -> Int -> Int -> Int -> Int
zeros text i from n =
    if i < from then
        n

    else if ownedAt text i == 0 then
        zeros text (i - 1) from (n + 1)

    else if ownedAt text i == 0xFD && i - 1 >= from && ownedAt text (i - 1) == 0 then
        zeros text (i - 2) from (n + 1)

    else
        n


{-| `left` cells of a source row written from byte `i`, or empty cells
when `i` is -1, as many at a time as the row being written has room for:
the row closed, wrapped, when it is full and a cell follows, a new page
begun when a row starts and the page is full. `run`: the style run in hand, `left` cells of
`style`, the next at `at`. -}
chunks : Int -> Array Page -> Src -> Int -> Int -> { at : Int, left : Int, style : Int } -> (taken o : Out) -> Pen -> { out : Out, pen : Pen }
chunks cols pages src i left run o pen =
    if left <= 0 then
        { out = o, pen = pen }

    else
        let
            full =
                pen.n >= cols

            closed =
                if full then
                    closeRow True pen o

                else
                    o

            p0 =
                if full then
                    { pen | n = 0, style = 0, count = 0, wrote = False }

                else
                    pen

            o0 =
                if p0.n == 0 then
                    toPage cols closed

                else
                    closed

            k =
                min left (cols - p0.n)
        in
        when Array.get src.pi pages is
            Nothing ->
                { out = o0, pen = p0 }

            Just page ->
                let
                    end =
                        if i < 0 then
                            -1

                        else if src.narrow then
                            i + k

                        else
                            skipCells page.text i k

                    written =
                        put page i end k o0

                    styled =
                        styleCells page.runs src.styled run.at run.left run.style k p0.style p0.count p0.wrote written.runs
                in
                chunks cols pages src end (left - k) { at = styled.at, left = styled.left, style = styled.rstyle } { written | runs = styled.runs, plain = written.plain && src.plain } { p0 | n = p0.n + k, style = styled.style, count = styled.count, wrote = styled.wrote }


{-| A source row's cells, read from `chunks`: its page's place, whether the
row has style runs, whether it is plain, a byte a cell and no style, and
whether it is `narrow`, a byte a cell, style or not. A row reaches
`fastLine` only when every cell is one column, so a byte a cell means each
is ASCII or an empty cell's 0, with no protection byte, and a row's text
ends by arithmetic (§VC41). -}
type alias Src =
    { styled : Bool, pi : Int, plain : Bool, narrow : Bool }


{-| `k` cells, bytes `i` to `end` of the source page's text, put after the
page's text, or empty cells when `i` is -1. -}
put : Page -> Int -> Int -> Int -> (taken o : Out) -> Out
put page i end k o =
    if i < 0 then
        { o | text = pushZeros k o.text }

    else
        { o | text = Owned.appendTo i end page.text o.text }


{-| The byte after `k` single-column cells from byte `i`, each with its
protection byte if it has one. -}
skipCells : Owned -> Int -> Int -> Int
skipCells text i k =
    if k <= 0 then
        if ownedAt text i == 0xFD then
            i + 1

        else
            i

    else
        let
            b =
                ownedAt text i
        in
        if b < 0x80 then
            skipCells text (i + 1) (k - 1)

        else if b == 0xFD then
            skipCells text (i + 1) k

        else if b < 0xE0 then
            skipCells text (i + 2) (k - 1)

        else if b < 0xF0 then
            skipCells text (i + 3) (k - 1)

        else
            skipCells text (i + 4) (k - 1)


pushZeros : Int -> (taken b : Builder UInt8) -> Builder UInt8
pushZeros k b =
    if k <= 0 then
        b

    else
        pushZeros (k - 1) (Builder.pushLast (UInt8.fromInt 0) b)


{-| `k` cells counted in the row's style run, a source run at a time, as
`packCells` counts them a cell at a time: `rleft` cells of `rstyle` left in
the source run in hand, the next at `rr`; an unstyled row's cells are all
style 0. -}
styleCells : Owned -> Bool -> Int -> Int -> Int -> Int -> Int -> Int -> Bool -> (taken out : Builder UInt8) -> { at : Int, left : Int, rstyle : Int, style : Int, count : Int, wrote : Bool, runs : Builder UInt8 }
styleCells runs styled rr rleft rstyle k style count wrote out =
    if k <= 0 then
        { at = rr, left = rleft, rstyle = rstyle, style = style, count = count, wrote = wrote, runs = out }

    else if not styled || rleft > 0 then
        let
            st =
                if styled then
                    rstyle

                else
                    0

            take =
                if styled then
                    min k rleft

                else
                    k
        in
        if count > 0 && st == style then
            styleCells runs styled rr (rleft - take) rstyle (k - take) style (count + take) wrote out

        else if count > 0 then
            styleCells runs styled rr (rleft - take) rstyle (k - take) st take True (pushU16 count (pushU16 (Bitwise.or 0x8000 style) out))

        else
            styleCells runs styled rr (rleft - take) rstyle (k - take) st take wrote out

    else
        let
            v =
                u16At runs rr
        in
        if Bitwise.and 0x8000 v /= 0 then
            styleCells runs styled (rr + 4) (u16At runs (rr + 2)) (Bitwise.and 0x7FFF v) k style count wrote out

        else
            styleCells runs styled (rr + 2) 1000000 v k style count wrote out


{-| The row in hand ended: its last style run written, as `packCells`
ends one, and its header. -}
closeRow : Bool -> Pen -> (taken o : Out) -> Out
closeRow wrapped pen o =
    let
        styled =
            not (pen.count == 0 || (pen.style == 0 && not pen.wrote))

        runs =
            if styled then
                pushU16 pen.style o.runs

            else
                o.runs

        header =
            Bitwise.or (Bitwise.or pen.n (Bitwise.shiftLeftBy 10 pen.mark))
                (Bitwise.or
                    (if wrapped then
                        0x8000

                     else
                        0
                    )
                    (if styled then
                        0

                     else
                        0x4000
                    )
                )
    in
    { o | runs = runs, heads = pushU16 header o.heads }


-- A LINE REFLOWED AS ROWS


{-| A line with a cell of another kind read back into rows, reflowed by
`reflow` and packed again. -}
slowLine : (Int -> Int -> Array Row -> Array Row) -> Int -> Int -> Array Page -> Array Source -> Clusters -> (taken o : Out) -> { out : Out, clusters : Clusters }
slowLine reflow old cols pages rows clusters o =
    let
        read =
            Array.foldl
                (\src acc ->
                    when Array.get src.pi pages is
                        Just page ->
                            let
                                one =
                                    rowAt page src acc.clusters
                            in
                            { rows = Array.pushLast one.row acc.rows, clusters = one.clusters }

                        Nothing ->
                            acc
                )
                { rows = [], clusters = clusters }
                rows

        out =
            Array.foldl (\row acc -> packRow read.clusters row (toPage cols acc)) o (reflow old cols read.rows)
    in
    { out = out, clusters = read.clusters }


{-| A source row read back as the ring keeps it, as `pageRowsOf` reads a
page's. -}
rowAt : Page -> Source -> Clusters -> { row : Row, clusters : Clusters }
rowAt page src clusters =
    let
        ext =
            Bitwise.and 0x3FF src.header

        styles =
            if Bitwise.and 0x4000 src.header /= 0 then
                Array.repeat ext 0

            else
                (unpackRuns page.runs src.r ext []).styles

        text =
            unpackText page.text src.ti ext []

        cells =
            Array.foldl
                (\c acc ->
                    let
                        k =
                            pagedCell { c | style = Maybe.withDefault 0 (Array.get (Array.length acc.cells) styles) } acc.clusters
                    in
                    { cells = Array.pushLast k.cell acc.cells, clusters = k.clusters }
                )
                { cells = [], clusters = clusters }
                text.cells
    in
    { row = { cells = cells.cells, wrapped = Bitwise.and 0x8000 src.header /= 0, prompt = Bitwise.and 3 (Bitwise.shiftRightZfBy 10 src.header) }, clusters = cells.clusters }


packRow : Clusters -> Row -> (taken o : Out) -> Out
packRow clusters row o =
    let
        packed =
            packArray clusters row.cells 0 o.text o.runs 0 0 False

        header =
            Bitwise.or (Bitwise.or (Array.length row.cells) (Bitwise.shiftLeftBy 10 row.prompt))
                (Bitwise.or
                    (if row.wrapped then
                        0x8000

                     else
                        0
                    )
                    (if packed.styled then
                        0

                     else
                        0x4000
                    )
                )
    in
    { o | text = packed.text, runs = packed.runs, heads = pushU16 header o.heads, plain = False }


{-| `packCells` for a row's cells in an array. -}
packArray : Clusters -> Array Int64 -> Int -> (taken text : Builder UInt8) -> (taken runs : Builder UInt8) -> Int -> Int -> Bool -> { text : Builder UInt8, runs : Builder UInt8, styled : Bool }
packArray clusters cells i text runs style count wrote =
    when Array.get i cells is
        Nothing ->
            if count == 0 || (style == 0 && not wrote) then
                { text = text, runs = runs, styled = False }

            else
                { text = text, runs = pushU16 style runs, styled = True }

        Just c ->
            let
                st =
                    cellStyle c

                packed =
                    if Bitwise.and packSpecial c == 0 then
                        pushUtf8 (cellPoint c) text

                    else
                        packOther clusters c text
            in
            if count > 0 && st == style then
                packArray clusters cells (i + 1) packed runs style (count + 1) wrote

            else if count > 0 then
                packArray clusters cells (i + 1) packed (pushU16 count (pushU16 (Bitwise.or 0x8000 style) runs)) st 1 True

            else
                packArray clusters cells (i + 1) packed runs st 1 wrote
