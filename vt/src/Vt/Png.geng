module Vt.Png exposing (Decoded, decode)

{-| PNG decoded to 8-bit RGBA for the Kitty graphics protocol's `f=100`
(`docs/images.md` IM4, `images-kitty.md` KG5): in the core, in Geng, as
`Vt.Inflate` is. The signature; the chunks, IHDR first, PLTE, tRNS and
the IDATs to IEND, the critical ones' CRCs checked; the IDATs joined and
inflated; each scanline unfiltered (none, sub, up, average, Paeth); every
colour type and depth made RGBA (16-bit channels by their high byte, grey
spread, the palette looked up, tRNS giving alpha); Adam7's seven passes
put in their places. Held to `most` bytes of pixels and of inflated data.
A row is unfiltered against the one before it alone and its pixels are
written once into `Bytes`; only an interlaced image keeps its passes' rows
to place them (`docs/images.md` IM39).
-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Bytes.Builder
import UInt8
import Vt.Cell exposing (byteAt)
import Vt.Inflate as Inflate
import Vt.Reason as Reason


type alias Decoded =
    { width : Int, height : Int, pixels : Bytes }


type alias Header =
    { width : Int
    , height : Int
    , depth : Int
    , color : Int
    , interlace : Int where 1 <= width && width <= 10000 && 1 <= height && height <= 10000 && 1 <= depth && depth <= 16 && 0 <= color && color <= 6 && 0 <= interlace && interlace <= 1
    }


type alias Chunks =
    { header : Maybe Header
    , palette : Bytes
    , trns : Bytes
    , idat : Array Bytes
    , ended : Bool
    }


u32 : Bytes -> Int -> Int
u32 data at =
    Bitwise.or (Bitwise.shiftLeftBy 24 (byteAt data at)) (Bitwise.or (Bitwise.shiftLeftBy 16 (byteAt data (at + 1))) (Bitwise.or (Bitwise.shiftLeftBy 8 (byteAt data (at + 2))) (byteAt data (at + 3))))


signature : Array Int
signature =
    [ 137, 80, 78, 71, 13, 10, 26, 10 ]


{-| The image, or why not: "dimensions too large" for a width or height
past 10,000, which Ghostty answers so too. -}
decode : Int -> Bytes -> Result String Decoded
decode most data =
    if Bytes.length data < 8 || Array.any not (Array.indexedMap (\i b -> byteAt data i == b) signature) then
        Err "signature"

    else if Bytes.length data > 419430400 then
        Err "too large"

    else
        when chunks data (clamp 0 419430400 (Bytes.length data)) 8 { header = Nothing, palette = Bytes.empty, trns = Bytes.empty, idat = [], ended = False } is
            Ok c ->
                when c.header is
                    Just h ->
                        pixelsOf most h c

                    Nothing ->
                        meant Reason.FromOutside Err "no IHDR"

            Err why ->
                meant Reason.FromOutside Err why


{-| The chunks from `at` to IEND. -}
chunks : Bytes -> (n : Int where 0 <= n && n <= 419430400) -> (at : Int where 0 <= at && at <= n) -> Chunks -> Result String Chunks
chunks data n at acc =
    if acc.ended then
        Ok acc

    else if at > n - 12 then
        Err "truncated"

    else
        let
            len =
                u32 data at

            kind =
                Bytes.slice (at + 4) (at + 8) data

            name =
                Maybe.withDefault (meant Reason.FromOutside "") (Bytes.toString kind)

            body =
                Bytes.slice (at + 8) (at + 8 + len) data

            critical =
                Bitwise.and 0x20 (byteAt data (at + 4)) == 0

            -- worked only for a critical chunk, whose CRC is checked (the
            -- code review's VI18)
            crcBad =
                critical && crc32 (Bytes.slice (at + 4) (at + 8 + len) data) /= u32 data (at + 8 + len)

            -- the chunk's end; checked within the data below
            next =
                clamp 0 n (at + 12 + clamp 0 419430400 len)
        in
        if len < 0 || len > n - at - 12 then
            Err "truncated"

        else if crcBad then
            Err "crc"

        else if acc.header == Nothing && name /= "IHDR" then
            Err "IHDR not first"

        else if name == "IHDR" && acc.header /= Nothing then
            -- once, first (the code review's VI17)
            Err "IHDR repeated"

        else if name == "IHDR" then
            when header body is
                Ok h ->
                    chunks data n next { acc | header = Just h }

                Err why ->
                    meant Reason.FromOutside Err why

        else if name == "PLTE" && (len < 3 || len > 768 || modBy 3 len /= 0) then
            -- one to 256 entries of three bytes (VI17)
            Err "PLTE length"

        else if name == "PLTE" && not (Array.isEmpty acc.idat) then
            -- before the image data (VI17)
            Err "PLTE after IDAT"

        else if name == "PLTE" then
            chunks data n next { acc | palette = body }

        else if name == "tRNS" then
            chunks data n next { acc | trns = body }

        else if name == "IDAT" then
            chunks data n next { acc | idat = Array.pushLast body acc.idat }

        else if name == "IEND" then
            Ok { acc | ended = True }

        else if critical then
            Err "unknown critical chunk"

        else
            chunks data n next acc


header : Bytes -> Result String Header
header body =
    let
        width =
            u32 body 0

        height =
            u32 body 4

        depth =
            byteAt body 8

        color =
            byteAt body 9

        interlace =
            byteAt body 12

        depths =
            if color == 0 then
                [ 1, 2, 4, 8, 16 ]

            else if color == 3 then
                [ 1, 2, 4, 8 ]

            else if Array.member color [ 2, 4, 6 ] then
                [ 8, 16 ]

            else
                []
    in
    if Bytes.length body /= 13 || width <= 0 || height <= 0 || not (Array.member depth depths) || byteAt body 10 /= 0 || byteAt body 11 /= 0 || interlace > 1 then
        Err "IHDR"

    else if width > 10000 || height > 10000 then
        Err "dimensions too large"

    else
        Ok { width = clamp 1 10000 width, height = clamp 1 10000 height, depth = clamp 1 16 depth, color = clamp 0 6 color, interlace = clamp 0 1 interlace }


channels : Int -> (r : Int where 1 <= r && r <= 4)
channels color =
    if color == 2 then
        3

    else if color == 4 then
        2

    else if color == 6 then
        4

    else
        1


{-| A pass's scanline in bytes, and the bytes a pixel spans for the
filters (at least one). -}
stride : Header -> Int -> (r : Int where 0 <= r && r <= 80000)
stride h width =
    clamp 0 80000 ((clamp 0 10000 width * channels h.color * h.depth + 7) // 8)


pixelBytes : Header -> (r : Int where 1 <= r && r <= 8)
pixelBytes h =
    clamp 1 8 (channels h.color * h.depth // 8)


{-| Adam7's passes: where each starts and its step, in columns and rows. -}
adam7 : Array { x0 : Int, y0 : Int, dx : Int, dy : Int }
adam7 =
    [ { x0 = 0, y0 = 0, dx = 8, dy = 8 }
    , { x0 = 4, y0 = 0, dx = 8, dy = 8 }
    , { x0 = 0, y0 = 4, dx = 4, dy = 8 }
    , { x0 = 2, y0 = 0, dx = 4, dy = 4 }
    , { x0 = 0, y0 = 2, dx = 2, dy = 4 }
    , { x0 = 1, y0 = 0, dx = 2, dy = 2 }
    , { x0 = 0, y0 = 1, dx = 1, dy = 2 }
    ]


passes : Header -> Array { x0 : Int, y0 : Int, dx : Int, dy : Int, w : Int, h : Int }
passes h =
    if h.interlace == 0 then
        [ { x0 = 0, y0 = 0, dx = 1, dy = 1, w = h.width, h = h.height } ]

    else
        Array.map
            (\p ->
                let
                    dx =
                        clamp 1 8 p.dx

                    dy =
                        clamp 1 8 p.dy

                    x0 =
                        clamp 0 7 p.x0

                    y0 =
                        clamp 0 7 p.y0
                in
                { x0 = x0, y0 = y0, dx = dx, dy = dy, w = clamp 0 10000 ((h.width - x0 + dx - 1) // dx), h = clamp 0 10000 ((h.height - y0 + dy - 1) // dy) }
            )
            adam7


pixelsOf : Int -> Header -> Chunks -> Result String Decoded
pixelsOf most h c =
    let
        ps =
            passes h

        -- each pass's rows: a filter byte and its scanline
        raw =
            Array.foldl
                (\p acc ->
                    if p.w == 0 || p.h == 0 then
                        acc

                    else
                        -- past `most`, it is refused below
                        min 419430401 (clamp 0 419430401 acc + clamp 0 10000 p.h * (1 + stride h p.w))
                )
                0
                ps
    in
    if h.width * h.height > most // 4 || raw > most then
        Err "too large"

    else if h.color == 3 && Bytes.length c.palette == 0 then
        Err "no palette"

    else
        when Inflate.zlib raw raw (Bytes.flatten c.idat) is
            Ok inflated ->
                if Bytes.length inflated < raw then
                    Err "short image data"

                else if h.interlace == 0 then
                    -- each row made RGBA as it is unfiltered, against the
                    -- row before it only
                    let
                        s =
                            stride h h.width

                        done =
                            straight h c s (pixelBytes h) inflated 0 0 [] True (Bytes.Builder.empty (h.width * h.height * 4))
                    in
                    if not done.ok then
                        Err "filter type"

                    else
                        Ok { width = h.width, height = h.height, pixels = Bytes.Builder.toBytes done.out }

                else
                    let
                        -- each pass's rows unfiltered, kept to be placed
                        unfiltered =
                            Array.foldl
                                (\p acc ->
                                    if p.w == 0 || p.h == 0 then
                                        { at = acc.at, rows = Array.pushLast [] acc.rows, ok = acc.ok }

                                    else
                                        let
                                            rows =
                                                passRows h (stride h p.w) (pixelBytes h) (clamp 0 10000 p.h) inflated (clamp 0 1000000000 acc.at) []
                                        in
                                        { at = rows.next, rows = Array.pushLast rows.rows acc.rows, ok = acc.ok && rows.ok }
                                )
                                { at = 0, rows = [], ok = True }
                                ps
                    in
                    if not unfiltered.ok then
                        Err "filter type"

                    else
                        Ok { width = h.width, height = h.height, pixels = Bytes.Builder.toBytes (interlaced h c unfiltered.rows 0 0 (Bytes.Builder.empty (h.width * h.height * 4))) }

            Err why ->
                meant Reason.FromOutside Err why


{-| A row's filter byte at `pos` and its `s` bytes after it unfiltered
against `prev`, the row above in the same pass (none for the first). -}
row : Bytes -> (pos : Int where 0 <= pos && pos <= 1000000000) -> (s : Int where 0 <= s && s <= 80000) -> (bpp : Int where 1 <= bpp && bpp <= 8) -> Array UInt8 -> { bytes : Array UInt8, ok : Bool }
row data pos s bpp prev =
    let
        filter =
            byteAt data pos
    in
    { bytes = Builder.toArray (unfilterRow filter data (clamp 0 1000000001 (pos + 1)) s bpp prev 0 (Builder.empty s)), ok = filter <= 4 }


{-| A non-interlaced image's rows from `y`: each unfiltered against the
one before it, then its pixels written. -}
straight : Header -> Chunks -> (s : Int where 0 <= s && s <= 80000) -> (bpp : Int where 1 <= bpp && bpp <= 8) -> Bytes -> (y : Int where 0 <= y) -> (pos : Int where 0 <= pos && pos <= 1000000000) -> Array UInt8 -> Bool -> (taken out : Bytes.Builder.Builder) -> { out : Bytes.Builder.Builder, ok : Bool }
straight h c s bpp data y pos prev ok out =
    if y >= h.height then
        { out = out, ok = ok }

    else
        let
            r =
                row data pos s bpp prev
        in
        straight h c s bpp data (y + 1) (clamp 0 1000000000 (pos + 1 + s)) r.bytes (ok && r.ok) (rowPixels h c r.bytes 0 h.width out)


{-| A pass's `rows` rows unfiltered from `pos`, and where the next pass
starts. -}
passRows : Header -> (s : Int where 0 <= s && s <= 80000) -> (bpp : Int where 1 <= bpp && bpp <= 8) -> (rows : Int where 0 <= rows && rows <= 10000) -> Bytes -> (pos : Int where 0 <= pos && pos <= 1000000000) -> Array (Array UInt8) -> { rows : Array (Array UInt8), next : Int, ok : Bool }
passRows h s bpp rows data pos acc =
    passRowsFrom s bpp rows data 0 pos [] True acc


passRowsFrom : (s : Int where 0 <= s && s <= 80000) -> (bpp : Int where 1 <= bpp && bpp <= 8) -> (rows : Int where 0 <= rows && rows <= 10000) -> Bytes -> (y : Int where 0 <= y) -> (pos : Int where 0 <= pos && pos <= 1000000000) -> Array UInt8 -> Bool -> Array (Array UInt8) -> { rows : Array (Array UInt8), next : Int, ok : Bool }
passRowsFrom s bpp rows data y pos prev ok acc =
    if y >= rows then
        { rows = acc, next = pos, ok = ok }

    else
        let
            r =
                row data pos s bpp prev
        in
        passRowsFrom s bpp rows data (y + 1) (clamp 0 1000000000 (pos + 1 + s)) r.bytes (ok && r.ok) (Array.pushLast r.bytes acc)


{-| A scanline's bytes from `from` unfiltered onto `out`, which holds the
ones before `i`; `prev` is the row above. -}
unfilterRow : Int -> Bytes -> (from : Int where 0 <= from && from <= 1000000001) -> (s : Int where 0 <= s && s <= 80000) -> (bpp : Int where 1 <= bpp && bpp <= 8) -> Array UInt8 -> (i : Int where 0 <= i) -> (taken out : Builder UInt8) -> Builder UInt8
unfilterRow filter data from s bpp prev i out =
    if i >= s then
        out

    else
        let
            x =
                byteAt data (from + i)

            above =
                not (Array.isEmpty prev)

            a =
                if i >= bpp then
                    UInt8.toInt (Builder.getProven (i - bpp) out)

                else
                    0

            b =
                if above then
                    byteOf prev i

                else
                    0

            c =
                if i >= bpp && above then
                    byteOf prev (i - bpp)

                else
                    0

            v =
                if filter == 1 then
                    x + a

                else if filter == 2 then
                    x + b

                else if filter == 3 then
                    x + (a + b) // 2

                else if filter == 4 then
                    x + paeth a b c

                else
                    x
        in
        unfilterRow filter data from s bpp prev (i + 1) (Builder.pushLast (UInt8.fromInt (Bitwise.and 0xFF v)) out)


{-| Byte `i` of an unfiltered row. -}
byteOf : Array UInt8 -> Int -> Int
byteOf bytes i =
    UInt8.toInt (Maybe.withDefault (meant Reason.OutOfRange (UInt8.fromInt 0)) (Array.get i bytes))


paeth : Int -> Int -> Int -> Int
paeth a b c =
    let
        p =
            a + b - c

        dist v =
            if v < 0 then
                0 - v

            else
                v

        pa =
            dist (p - a)

        pb =
            dist (p - b)

        pc =
            dist (p - c)
    in
    if pa <= pb && pa <= pc then
        a

    else if pb <= pc then
        b

    else
        c


{-| Pixels `x` to `w` of an unfiltered row written as RGBA. -}
rowPixels : Header -> Chunks -> Array UInt8 -> Int -> Int -> (taken out : Bytes.Builder.Builder) -> Bytes.Builder.Builder
rowPixels h c bytes x w out =
    if x >= w then
        out

    else
        rowPixels h c bytes (x + 1) w (pixel h c bytes x out)


{-| An interlaced image's pixels from `(x, y)`, row by row, each from the
pass that holds it (Adam7's pattern of eight by eight). -}
interlaced : Header -> Chunks -> Array (Array (Array UInt8)) -> Int -> Int -> (taken out : Bytes.Builder.Builder) -> Bytes.Builder.Builder
interlaced h c rows x y out =
    if y >= h.height then
        out

    else if x >= h.width then
        interlaced h c rows 0 (y + 1) out

    else
        let
            k =
                passOf (modBy 8 x) (modBy 8 y)

            p =
                Array.getProven k adam7

            passRow =
                Maybe.withDefault (meant Reason.OutOfRange []) (Array.get k rows)
                    |> Array.get ((y - p.y0) // max 1 p.dy)
                    |> Maybe.withDefault (meant Reason.OutOfRange [])
        in
        interlaced h c rows (x + 1) y (pixel h c passRow ((x - p.x0) // max 1 p.dx) out)


{-| The Adam7 pass, 0 to 6, of a pixel at column `x` and row `y` of its
eight by eight. -}
passOf : Int -> Int -> Int
passOf x y =
    if modBy 2 y == 1 then
        6

    else if modBy 2 x == 1 then
        5

    else if modBy 4 y == 2 then
        4

    else if modBy 4 x == 2 then
        3

    else if y == 4 then
        2

    else if x == 4 then
        1

    else
        0


{-| Sample `k` of the pixel at `x` of an unfiltered row, at the image's
depth, as 8 bits. -}
sample : Header -> Array UInt8 -> (x : Int where 0 <= x && x <= 10000) -> (k : Int where 0 <= k && k <= 3) -> Int
sample h bytes x k =
    let
        n =
            channels h.color

        index =
            x * n + k
    in
    if h.depth == 8 then
        byteOf bytes index

    else if h.depth == 16 then
        byteOf bytes (2 * index)

    else
        let
            bitAt =
                index * h.depth

            byte =
                byteOf bytes (bitAt // 8)

            v =
                Bitwise.and (Bitwise.shiftLeftBy h.depth 1 - 1) (Bitwise.shiftRightZfBy (8 - h.depth - modBy 8 bitAt) byte)
        in
        if h.color == 3 then
            v

        else
            v * 255 // (Bitwise.shiftLeftBy h.depth 1 - 1)


{-| The raw sample, for the colour key of tRNS: 16 bits at that depth. -}
rawSample : Header -> Array UInt8 -> (x : Int where 0 <= x && x <= 10000) -> (k : Int where 0 <= k && k <= 3) -> Int
rawSample h bytes x k =
    let
        index =
            x * channels h.color + k
    in
    if h.depth == 16 then
        Bitwise.or (Bitwise.shiftLeftBy 8 (byteOf bytes (2 * index))) (byteOf bytes (2 * index + 1))

    else if h.depth == 8 then
        byteOf bytes index

    else
        let
            bitAt =
                index * h.depth
        in
        Bitwise.and (Bitwise.shiftLeftBy h.depth 1 - 1) (Bitwise.shiftRightZfBy (8 - h.depth - modBy 8 bitAt) (byteOf bytes (bitAt // 8)))


{-| The pixel at `x` of an unfiltered row written as RGBA. -}
pixel : Header -> Chunks -> Array UInt8 -> Int -> (taken out : Bytes.Builder.Builder) -> Bytes.Builder.Builder
pixel h c bytes x0 out =
    let
        -- a row is at most 10,000 pixels
        x =
            clamp 0 10000 x0

        s k =
            sample h bytes x (clamp 0 3 k)

        trnsAt i =
            Bitwise.or (Bitwise.shiftLeftBy 8 (byteAt c.trns i)) (byteAt c.trns (i + 1))
    in
    if h.color == 0 then
        let
            g =
                s 0

            a =
                if Bytes.length c.trns >= 2 && rawSample h bytes x 0 == trnsAt 0 then
                    0

                else
                    255
        in
        rgba g g g a out

    else if h.color == 2 then
        let
            keyed =
                Bytes.length c.trns >= 6 && rawSample h bytes x 0 == trnsAt 0 && rawSample h bytes x 1 == trnsAt 2 && rawSample h bytes x 2 == trnsAt 4
        in
        rgba (s 0)
            (s 1)
            (s 2)
            (if keyed then
                0

             else
                255
            )
            out

    else if h.color == 3 then
        let
            i =
                s 0
        in
        if 3 * i + 2 >= Bytes.length c.palette then
            -- an index past the palette: opaque black, as libpng draws it
            -- after its benign error, and as the core drew it (VI17)
            rgba 0 0 0 255 out

        else
            rgba (byteAt c.palette (3 * i))
                (byteAt c.palette (3 * i + 1))
                (byteAt c.palette (3 * i + 2))
                (if i < Bytes.length c.trns then
                    byteAt c.trns i

                 else
                    255
                )
                out

    else if h.color == 4 then
        rgba (s 0) (s 0) (s 0) (s 1) out

    else
        rgba (s 0) (s 1) (s 2) (s 3) out


rgba : Int -> Int -> Int -> Int -> (taken out : Bytes.Builder.Builder) -> Bytes.Builder.Builder
rgba r g b a out =
    out |> Bytes.Builder.pushLast r |> Bytes.Builder.pushLast g |> Bytes.Builder.pushLast b |> Bytes.Builder.pushLast a


{-| CRC-32 (ISO 3309), as PNG's chunks carry it: a byte at a time through
`crcTable`, not eight steps a byte (the code review's VI18). -}
crc32 : Bytes -> Int
crc32 data =
    let
        n =
            Bytes.length data

        go i crc =
            if i >= n then
                Bitwise.xor crc -1

            else
                go (i + 1) (Bitwise.xor (crcEntry (Bitwise.and 0xFF (Bitwise.xor crc (byteAt data i)))) (Bitwise.shiftRightZfBy 8 crc))
    in
    go 0 -1


crcEntry : Int -> Int
crcEntry k =
    Maybe.withDefault (meant Reason.OutOfRange 0) (Array.get k crcTable)


{-| Each byte's CRC after eight steps of the polynomial 0xEDB88320, the
table zlib keeps (`crc32.c`), as 32-bit `Int`s; written out, as zlib
writes it, since a table made by 256 calls at the top level was more
than the refinement checker's memory. -}
crcTable : Array Int
