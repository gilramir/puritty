module Vt.Palette exposing (defaultColor, dynamicColor, dynamicKey, namedColors, paletteColor, programColor, rgbOf, themeReport)

{-| Part of `Vt`: the colors a terminal holds (OSC 4 and 10 to 12) and the
palette before anything sets it, which the renderer (`Vt.View`) resolves a
style's colors with as well as the replies do (`docs/renderer.md` §R8). -}

import Bitwise
import Dict exposing (Dict)
import Vt.Reason as Reason
import Vt.Term exposing (Term)


dynamicKey : Int -> Int
dynamicKey c =
    1000 + c


{-| A dynamic color as a program set it with OSC 10 to 12, or none; the
cursor's is the foreground's when it has none. The renderer's (`Vt.View`),
which has the look's own colors and the cell's under the cursor. -}
programColor : Int -> Term -> Maybe Int
programColor c t =
    if c == 12 then
        when Dict.get (dynamicKey 12) t.colors is
            Just v ->
                Just v

            Nothing ->
                meant Reason.NotSet Dict.get (dynamicKey 10) t.colors

    else if c <= 11 then
        Dict.get (dynamicKey c) t.colors

    else
        Nothing


{-| A dynamic color as OSC 10 to 12 answer it: the one set, else the embedder's foreground or
background (`Term.Embedder`), else none, as libghostty-vt has none unless
its embedder gives one; the cursor's is the foreground's when it has none. -}
dynamicColor : Int -> Term -> Maybe Int
dynamicColor c t =
    if c == 12 then
        when Dict.get (dynamicKey 12) t.colors is
            Just v ->
                Just v

            Nothing ->
                meant Reason.NotSet dynamicColor 10 t

    else if c == 10 || c == 11 then
        when Dict.get (dynamicKey c) t.colors is
            Just v ->
                Just v

            Nothing ->
                meant Reason.NotSet
                    Maybe.map
                        (\look ->
                            if c == 10 then
                                look.foreground

                            else
                                look.background
                        )
                        t.embedder.look

    else
        Nothing


{-| DSR 996's answer, `CSI ? 997 ; 1 n` for a dark background and `; 2 n`
for a light one, from the background OSC 11 answers; none when there is no
background to judge (`docs/tmux.md` TM4). Light is a relative luminance
over half, with sRGB's weights on the channels as they are. -}
themeReport : Term -> Maybe String
themeReport t =
    dynamicColor 11 t
        |> Maybe.map
            (\bg ->
                let
                    luma =
                        2126 * Bitwise.and 0xFF (Bitwise.shiftRightZfBy 16 bg) + 7152 * Bitwise.and 0xFF (Bitwise.shiftRightZfBy 8 bg) + 722 * Bitwise.and 0xFF bg
                in
                if luma > 1275000 then
                    "\u{001B}[?997;2n"

                else
                    "\u{001B}[?997;1n"
            )


paletteColor : Int -> Term -> Int
paletteColor i t =
    when Dict.get i t.colors is
        Just c ->
            c

        Nothing ->
            meant Reason.NotSet
                if i >= 0 && i < 16 then
                    Array.getProven i t.named

                else
                    defaultColor i


{-| The palette as libghostty-vt has it before anything sets it: its 16,
the 6×6×6 cube and the gray ramp. -}
defaultColor : Int -> Int
defaultColor i =
    if i < 0 then
        0

    else if i < 16 then
        Array.getProven i namedColors

    else if i < 232 then
        let
            level v =
                if v == 0 then
                    0

                else
                    v * 40 + 55

            k =
                i - 16
        in
        rgbOf (level (k // 36)) (level (modBy 6 (k // 6))) (level (modBy 6 k))

    else
        let
            v =
                (i - 232) * 10 + 8
        in
        rgbOf v v v


namedColors : Array Int
namedColors =
    [ 0x1D1F21, 0xCC6666, 0xB5BD68, 0xF0C674, 0x81A2BE, 0xB294BB, 0x8ABEB7, 0xC5C8C6, 0x666666, 0xD54E53, 0xB9CA4A, 0xE7C547, 0x7AA6DA, 0xC397D8, 0x70C0B1, 0xEAEAEA ]


rgbOf : Int -> Int -> Int -> Int
rgbOf r g b =
    Bitwise.or (Bitwise.shiftLeftBy 16 r) (Bitwise.or (Bitwise.shiftLeftBy 8 g) b)
