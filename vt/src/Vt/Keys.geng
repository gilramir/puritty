module Vt.Keys exposing (Event, Options, defaultOptions, encode)

{-| What a key sends the program (`docs/phase3-input.md` V47): libghostty-vt's
key encoder (`src/input/key_encode.zig`, `function_keys.zig`, v1.4.0) in Geng,
path for path, so that a gate can hold the two to the same bytes. Legacy
xterm encoding with `modifyOtherKeys` 2 and fixterms' CSI u, or the kitty
protocol when the screen's kitty flags are set.

A key is Ghostty's: its number (`Vt.KeyTables`, as `GhosttyKey` numbers
them), press (1), repeat (2) or release (0), its modifiers as Ghostty's bits
(shift 1, ctrl 2, alt 4, super 8, caps lock 16, num lock 32, and the side of
each of the first four, 64 to 512, set for the right one), the modifiers the
layout consumed to make its text, whether a dead key or an IME is composing,
its text and its unshifted code point.

What Ghostty does only on macOS (the option key as alt, command keys that
send no text) is left out: puritty runs on Linux.
-}

import Bitwise
import Bytes
import UInt8
import Vt.KeyTables exposing (..)
import Vt.Reason as Reason


type alias Event =
    { action : Int
    , key : Int
    , mods : Int
    , consumed : Int
    , composing : Bool
    , text : String
    , unshifted : Int
    }


{-| The terminal's modes a key's bytes depend on: DECCKM (1), DECKPAM (66),
DECBKM (67), 1035, 1036, `modifyOtherKeys` 2, and the kitty flags at the
top of the screen's stack. -}
type alias Options =
    { cursorApplication : Bool
    , keypadApplication : Bool
    , backarrow : Bool
    , ignoreKeypadWithNumlock : Bool
    , altEscPrefix : Bool
    , modifyOtherKeys2 : Bool
    , kittyFlags : Int
    }


defaultOptions : Options
defaultOptions =
    { cursorApplication = False
    , keypadApplication = False
    , backarrow = False
    , ignoreKeypadWithNumlock = False
    , altEscPrefix = False
    , modifyOtherKeys2 = False
    , kittyFlags = 0
    }


-- MODIFIERS


shift : Int
shift =
    1


ctrl : Int
ctrl =
    2


alt : Int
alt =
    4


super : Int
super =
    8


capsLock : Int
capsLock =
    16


numLock : Int
numLock =
    32


has : Int -> Int -> Bool
has bit mods =
    Bitwise.and bit mods /= 0


{-| Shift, ctrl, alt and super: what a binding sees, without locks or sides. -}
binding : Int -> Int
binding mods =
    Bitwise.and 15 mods


effective : Event -> Int
effective e =
    if e.text == "" then
        e.mods

    else
        Bitwise.and e.mods (Bitwise.complement e.consumed)


-- ENCODING


{-| The bytes a key sends, as a string: empty for a key that sends none. -}
encode : Options -> Event -> String
encode opts e =
    if opts.kittyFlags /= 0 then
        kitty opts e

    else
        legacy opts e


codePoints : String -> Array Int
codePoints s =
    Array.map Char.toCode (String.toArray s)


isControl : Int -> Bool
isControl cp =
    cp < 0x20 || cp == 0x7F


isControlText : String -> Bool
isControlText s =
    when codePoints s is
        [ cp ] ->
            cp < 0x80 && isControl cp

        _ ->
            False


-- KITTY


reportEvents : Int
reportEvents =
    2


reportAlternates : Int
reportAlternates =
    4


reportAll : Int
reportAll =
    8


reportAssociated : Int
reportAssociated =
    16


kitty : Options -> Event -> String
kitty opts e =
    let
        flags =
            opts.kittyFlags

        bindingMods =
            binding (effective e)

        entry =
            if kittyCode e.key /= 0 then
                Just { code = kittyCode e.key, final = kittyFinal e.key, modifier = kittyModifier e.key == 1 }

            else if e.unshifted > 0 then
                Just { code = e.unshifted, final = Char.toCode 'u', modifier = False }

            else
                Nothing

        isEnterTabBack =
            e.key == keyEnter || e.key == keyBackspace || e.key == keyTab
    in
    if e.action == 0 && not (has reportEvents flags) then
        ""

    else if e.action == 0 && not (has reportAll flags) && isEnterTabBack then
        ""

    else if e.composing then
        when entry is
            Just en ->
                if en.modifier then
                    kittyEntry opts e en

                else
                    ""

            Nothing ->
                meant Reason.NotKnown ""

    else if e.text /= "" && (e.key == keyEnter || e.key == keyBackspace) && not (isControlText e.text) then
        if e.key == keyBackspace then
            ""

        else
            e.text

    else if not (has reportAll flags) && bindingMods == 0 && e.key == keyEnter then
        "\u{000D}"

    else if not (has reportAll flags) && bindingMods == 0 && e.key == keyTab then
        "\t"

    else if not (has reportAll flags) && bindingMods == 0 && e.key == keyBackspace then
        "\u{007F}"

    else if not (has reportAll flags) && e.text /= "" && bindingMods == 0 && e.action /= 0 && not (Array.any isControl (codePoints e.text)) then
        e.text

    else
        when entry is
            Nothing ->
                meant Reason.NotKnown
                    if e.action == 0 then
                        ""

                    else
                        e.text

            Just en ->
                kittyEntry opts e en


kittyEntry : Options -> Event -> { code : Int, final : Int, modifier : Bool } -> String
kittyEntry opts e en =
    let
        flags =
            opts.kittyFlags

        -- KittyMods.fromInput: shift, alt, ctrl, super, caps and num lock,
        -- in the protocol's bit order
        mods =
            (if has shift e.mods then
                1

             else
                0
            )
                + (if has alt e.mods then
                    2

                   else
                    0
                  )
                + (if has ctrl e.mods then
                    4

                   else
                    0
                  )
                + (if has super e.mods then
                    8

                   else
                    0
                  )
                + (if has capsLock e.mods then
                    64

                   else
                    0
                  )
                + (if has numLock e.mods then
                    128

                   else
                    0
                  )

        event =
            if has reportEvents flags then
                if e.action == 1 then
                    1

                else if e.action == 2 then
                    2

                else
                    3

            else
                0

        cps =
            codePoints e.text

        alternates =
            if not (has reportAlternates flags) || isControl en.code then
                { shifted = 0, base = 0 }

            else
                let
                    keyCp =
                        codepoint e.key
                in
                when Array.first cps is
                    Just cp1 ->
                        { shifted =
                            if cp1 /= en.code && has shift mods then
                                cp1

                            else
                                0
                        , base =
                            if keyCp /= 0 && keyCp /= en.code && cp1 /= keyCp && Array.length cps == 1 then
                                keyCp

                            else
                                0
                        }

                    Nothing ->
                        meant Reason.FromOutside
                            { shifted = 0
                            , base =
                                if keyCp /= 0 && keyCp /= en.code then
                                    keyCp

                                else
                                    0
                            }

        -- preventsText: alt, ctrl or super (hyper and meta are never set)
        text =
            if has reportAssociated flags && event /= 3 && Bitwise.and mods 14 == 0 then
                cps

            else
                []
    in
    if en.modifier && not (has reportAll flags) then
        ""

    else if en.final == Char.toCode 'u' || en.final == Char.toCode '~' then
        kittyFull en.code en.final (mods + 1) event alternates text

    else if event /= 0 then
        "\u{001B}[1;" ++ String.fromInt (mods + 1) ++ ":" ++ String.fromInt event ++ finalOf en.final

    else if mods + 1 > 1 then
        "\u{001B}[1;" ++ String.fromInt (mods + 1) ++ finalOf en.final

    else
        "\u{001B}[" ++ finalOf en.final


finalOf : Int -> String
finalOf c =
    charString c


{-| A code point as a string of one character; none for one that is not a
scalar value, which no table here has. -}
charString : Int -> String
charString c =
    Maybe.withDefault (meant Reason.FromOutside "") (Maybe.map String.fromChar (Char.fromCode c))


kittyFull : Int -> Int -> Int -> Int -> { shifted : Int, base : Int } -> Array Int -> String
kittyFull code final mods event alternates text =
    let
        alts =
            (if alternates.shifted /= 0 then
                ":" ++ String.fromInt alternates.shifted

             else
                ""
            )
                ++ (if alternates.base /= 0 then
                        if alternates.shifted == 0 then
                            "::" ++ String.fromInt alternates.base

                        else
                            ":" ++ String.fromInt alternates.base

                    else
                        ""
                   )

        modPart =
            if event /= 0 && event /= 1 then
                ";" ++ String.fromInt mods ++ ":" ++ String.fromInt event

            else if mods > 1 then
                ";" ++ String.fromInt mods

            else
                ""

        printable =
            Array.keepIf (\cp -> not (isControl cp)) text

        textPart =
            if Array.isEmpty printable then
                ""

            else
                (if modPart == "" then
                    ";;"

                 else
                    ";"
                )
                    ++ String.join ":" (Array.map String.fromInt printable)
    in
    "\u{001B}[" ++ String.fromInt code ++ alts ++ modPart ++ textPart ++ finalOf final


-- LEGACY


legacy : Options -> Event -> String
legacy opts e =
    let
        bindingMods =
            binding (effective e)
    in
    if e.action /= 1 && e.action /= 2 then
        ""

    else if e.composing then
        ""

    else
        let
            pc =
                pcStyle opts e.key e.mods

            pcBlockedByText =
                e.text /= "" && (e.key == keyBackspace || e.key == keyEnter || e.key == keyEscape) && not (isControlText e.text)
        in
        when pc is
            Just sequence ->
                if pcBlockedByText then
                    if e.key == keyBackspace then
                        ""

                    else
                        afterPc opts e bindingMods

                else
                    sequence

            Nothing ->
                meant Reason.NotKnown afterPc opts e bindingMods


afterPc : Options -> Event -> Int -> String
afterPc opts e bindingMods =
    let
        cps =
            codePoints e.text

        modifyOther =
            if opts.modifyOtherKeys2 then
                when cps is
                    [ cp ] ->
                        let
                            mods =
                                binding e.mods

                            should =
                                (cp >= 0x40 && cp <= 0x7F)
                                    || Bitwise.and mods (Bitwise.complement shift) /= 0
                                    || cp == 0x20
                        in
                        if should && mods /= 0 then
                            Just ("\u{001B}[27;" ++ String.fromInt (modifierCode mods) ++ ";" ++ String.fromInt cp ++ "~")

                        else
                            Nothing

                    _ ->
                        Nothing

            else
                Nothing
    in
    when modifyOther is
        Just s ->
            s

        Nothing ->
            meant Reason.NotSet
                when ctrlSeq e.key e.text e.unshifted e.mods is
                    Just c ->
                        if has alt bindingMods then
                            "\u{001B}" ++ charString c

                        else
                            charString c

                    Nothing ->
                        meant Reason.NotKnown
                            if e.text == "" then
                                Maybe.withDefault (meant Reason.NotSet "") (altPrefix opts e bindingMods)

                            else
                                when csiU e cps is
                                    Just s ->
                                        s

                                    Nothing ->
                                        meant Reason.NotSet
                                            when altPrefix opts e bindingMods is
                                                Just s ->
                                                    s

                                                Nothing ->
                                                    meant Reason.NotSet e.text


{-| fixterms' CSI u for a single code point under ctrl, lowercased under
shift as kitty does; shift dropped when it made the character. -}
csiU : Event -> Array Int -> Maybe String
csiU e cps =
    if not (has ctrl e.mods) then
        Nothing

    else
        when cps is
            [ cp0 ] ->
                let
                    shifted =
                        has shift e.mods

                    char =
                        if cp0 >= 0x41 && cp0 <= 0x5A && shifted then
                            cp0 + 32

                        else
                            cp0

                    mods =
                        (if shifted && e.unshifted == char then
                            1

                         else
                            0
                        )
                            + (if has alt e.mods then
                                2

                               else
                                0
                              )
                            + (if has ctrl e.mods then
                                4

                               else
                                0
                              )
                in
                Just ("\u{001B}[" ++ String.fromInt char ++ ";" ++ String.fromInt (mods + 1) ++ "u")

            _ ->
                Nothing


altPrefix : Options -> Event -> Int -> Maybe String
altPrefix opts e bindingMods =
    if not (has alt bindingMods) || not opts.altEscPrefix then
        Nothing

    else if e.text /= "" then
        Just ("\u{001B}" ++ e.text)

    else if e.unshifted > 0 then
        Just ("\u{001B}" ++ charString e.unshifted)

    else
        Nothing


{-| `function_keys.modifiers`' index of a set of binding modifiers, plus 2:
the number xterm puts in a modified key's sequence. -}
modifierCode : Int -> Int
modifierCode mods =
    -- the list runs shift, alt, shift+alt, ctrl, …: bit 0 shift, 1 alt, 2 ctrl, 3 super
    (if has shift mods then
        1

     else
        0
    )
        + (if has alt mods then
            2

           else
            0
          )
        + (if has ctrl mods then
            4

           else
            0
          )
        + (if has super mods then
            8

           else
            0
          )
        + 1


ctrlSeq : Int -> String -> Int -> Int -> Maybe Int
ctrlSeq key text unshifted mods =
    if not (has ctrl mods) then
        Nothing

    else
        let
            unset0 =
                Bitwise.and (binding mods) (Bitwise.complement alt)

            utf8 =
                Bytes.fromString text

            fromText =
                if Bytes.length utf8 == 1 then
                    Maybe.map UInt8.toInt (Bytes.get 0 utf8)

                else
                    Nothing

            fromKey =
                let
                    cp =
                        codepoint key
                in
                if fromText == Nothing && cp > 0 && cp < 256 && unset0 == ctrl then
                    Just cp

                else
                    Nothing
        in
        when (if fromText /= Nothing then
                fromText

              else
                fromKey
             ) is
            Nothing ->
                meant Reason.NotKnown Nothing

            Just char0 ->
                let
                    unset =
                        if has shift unset0 && (char0 < 0x41 || char0 > 0x5A) && char0 /= 0x40 then
                            Bitwise.and unset0 (Bitwise.complement shift)

                        else
                            unset0

                    char =
                        if char0 >= 0x41 && char0 <= 0x5A && unshifted > 0 && unshifted < 256 then
                            unshifted

                        else
                            char0
                in
                if unset /= ctrl then
                    Nothing

                else
                    ctrlByte char


ctrlByte : Int -> Maybe Int
ctrlByte c =
    if c >= 0x61 && c <= 0x7A && c /= 0x69 && c /= 0x6D then
        Just (c - 0x60)

    else
        when c is
            0x20 ->
                Just 0

            0x2F ->
                Just 31

            0x30 ->
                Just 48

            0x31 ->
                Just 49

            0x32 ->
                Just 0

            0x33 ->
                Just 27

            0x34 ->
                Just 28

            0x35 ->
                Just 29

            0x36 ->
                Just 30

            0x37 ->
                Just 31

            0x38 ->
                Just 127

            0x39 ->
                Just 57

            0x3F ->
                Just 127

            0x40 ->
                Just 0

            0x5C ->
                Just 28

            0x5D ->
                Just 29

            0x5E ->
                Just 30

            0x5F ->
                Just 31

            0x7E ->
                Just 30

            _ ->
                Nothing


-- PC-STYLE FUNCTION KEYS


{-| One of `function_keys.zig`'s entries: the binding modifiers it needs (0
with `emptyIsAny` matches any), the cursor and keypad modes and the
`modifyOtherKeys` state it needs (0 any, 1 normal or unset, 2 application or
set), its sequence, and DECBKM's, if it has one. -}
type alias Entry =
    { mods : Int
    , emptyIsAny : Bool
    , cursor : Int
    , keypad : Int
    , modifyOther : Int
    , sequence : String
    , decbkm : String
    }


plainEntry : String -> Entry
plainEntry sequence =
    { mods = 0, emptyIsAny = True, cursor = 0, keypad = 0, modifyOther = 0, sequence = sequence, decbkm = "" }


{-| `pcStyle`: the fifteen modified forms, `{}` the modifier's number. The
forms run in xterm's order, shift 1, alt 2, ctrl 4 and super 8 added to 1. -}
pcForms : String -> String -> Array Entry
pcForms before after =
    Array.initialize 15 1 (\x -> { (plainEntry (before ++ String.fromInt (x + 1) ++ after)) | mods = fromXterm x })


{-| Ghostty's modifier bits for xterm's: shift 1, alt 2, ctrl 4, super 8. -}
fromXterm : Int -> Int
fromXterm x =
    (if has 1 x then
        shift

     else
        0
    )
        + (if has 2 x then
            alt

           else
            0
          )
        + (if has 4 x then
            ctrl

           else
            0
          )
        + (if has 8 x then
            super

           else
            0
          )


cursorForms : String -> String -> Array Entry
cursorForms normal application =
    [ { (plainEntry normal) | cursor = 1 }, { (plainEntry application) | cursor = 2 } ]


cursorKey : String -> String -> String -> Array Entry
cursorKey letter normal application =
    pcForms "\u{001B}[1;" letter ++ cursorForms normal application


plain : String -> String -> Array Entry
plain number sequence =
    pcForms ("\u{001B}[" ++ number ++ ";") "~" ++ [ plainEntry sequence ]


kpKeys : String -> String -> Array Entry
kpKeys suffix normal =
    [ { (plainEntry ("\u{001B}O" ++ suffix)) | emptyIsAny = False, keypad = 2 } ]
        ++ Array.map (\en -> { en | keypad = 2 }) (pcForms "\u{001B}O" suffix)
        ++ [ { (plainEntry normal) | keypad = 1 } ]


{-| The fifteen modified forms of a key under `modifyOtherKeys`: `set` or
`set_other` on each, as Backspace's table spells them out. -}
withMods : Int -> Int -> String -> Entry
withMods mods modifyOther sequence =
    { (plainEntry sequence) | mods = mods, modifyOther = modifyOther }


backspaceEntries : Array Entry
backspaceEntries =
    let
        normal =
            [ { m = 1, s = "\u{007F}" }, { m = 4, s = "\u{001B}\u{007F}" }, { m = 5, s = "\u{001B}\u{007F}" }, { m = 3, s = "\u{0008}" }, { m = 6, s = "\u{001B}\u{0008}" }, { m = 7, s = "\u{001B}\u{0008}" }, { m = 8, s = "\u{007F}" }, { m = 9, s = "\u{007F}" }, { m = 12, s = "\u{001B}\u{007F}" }, { m = 13, s = "\u{001B}\u{007F}" }, { m = 10, s = "\u{0008}" }, { m = 11, s = "\u{0008}" }, { m = 14, s = "\u{001B}\u{0008}" }, { m = 15, s = "\u{001B}\u{0008}" } ]
    in
    Array.map (\p -> withMods p.m 1 p.s) normal
        ++ Array.map (\p -> withMods p.m 2 ("\u{001B}[27;" ++ String.fromInt (modifierCode p.m) ++ ";127~")) normal
        ++ [ { (plainEntry "\u{0008}") | mods = ctrl, decbkm = "\u{007F}" }
           , { (plainEntry "\u{007F}") | decbkm = "\u{0008}" }
           ]


{-| Tab, Enter and Escape: `CSI 27 ; m ; code ~` for every modified form
but those `special` gives, and the key's own byte unmodified. -}
modifiedKey : Int -> Array Entry -> String -> Array Entry
modifiedKey code special own =
    let
        given =
            Array.map .mods special

        rest =
            Array.keepIf (\m -> not (Array.member m given)) (Array.initialize 15 1 identity)
    in
    special
        ++ Array.map (\m -> withMods m 0 ("\u{001B}[27;" ++ String.fromInt (modifierCode m) ++ ";" ++ String.fromInt code ++ "~")) rest
        ++ [ plainEntry own ]


tabEntries : Array Entry
tabEntries =
    -- shift and alt: one form under modifyOtherKeys, another without; the
    -- rest one form only
    [ withMods shift 1 "\u{001B}[Z"
    , withMods alt 1 "\u{001B}\t"
    , withMods shift 2 "\u{001B}[27;2;9~"
    , withMods alt 2 "\u{001B}[27;3;9~"
    ]
        |> (\special -> modifiedKey 9 special "\t")


enterEntries : Array Entry
enterEntries =
    modifiedKey 13
        [ withMods shift 0 "\u{001B}[27;2;13~"
        , withMods alt 1 "\u{001B}\u{000D}"
        , withMods alt 2 "\u{001B}[27;3;13~"
        ]
        "\u{000D}"


escapeEntries : Array Entry
escapeEntries =
    modifiedKey 27
        [ withMods shift 0 "\u{001B}[27;2;27~"
        , withMods alt 1 "\u{001B}\u{001B}"
        , withMods alt 2 "\u{001B}[27;3;27~"
        ]
        "\u{001B}"


functionKey : Int -> Array Entry
functionKey k =
    if k == keyArrowUp || k == keyNumpadUp then
        cursorKey "A" "\u{001B}[A" "\u{001B}OA"

    else if k == keyArrowDown || k == keyNumpadDown then
        cursorKey "B" "\u{001B}[B" "\u{001B}OB"

    else if k == keyArrowRight || k == keyNumpadRight then
        cursorKey "C" "\u{001B}[C" "\u{001B}OC"

    else if k == keyArrowLeft || k == keyNumpadLeft then
        cursorKey "D" "\u{001B}[D" "\u{001B}OD"

    else if k == keyNumpadBegin then
        cursorKey "E" "\u{001B}[E" "\u{001B}OE"

    else if k == keyHome || k == keyNumpadHome then
        cursorKey "H" "\u{001B}[H" "\u{001B}OH"

    else if k == keyEnd || k == keyNumpadEnd then
        cursorKey "F" "\u{001B}[F" "\u{001B}OF"

    else if k == keyInsert || k == keyNumpadInsert then
        plain "2" "\u{001B}[2~"

    else if k == keyDelete || k == keyNumpadDelete then
        plain "3" "\u{001B}[3~"

    else if k == keyPageUp || k == keyNumpadPageUp then
        plain "5" "\u{001B}[5~"

    else if k == keyPageDown || k == keyNumpadPageDown then
        plain "6" "\u{001B}[6~"

    else if k == keyHelp then
        plain "28" "\u{001B}[28~"

    else if k == keyContextMenu then
        plain "29" "\u{001B}[29~"

    else if k == keyF1 then
        pcForms "\u{001B}[1;" "P" ++ [ plainEntry "\u{001B}OP" ]

    else if k == keyF2 then
        pcForms "\u{001B}[1;" "Q" ++ [ plainEntry "\u{001B}OQ" ]

    else if k == keyF3 then
        pcForms "\u{001B}[13;" "~" ++ [ plainEntry "\u{001B}OR" ]

    else if k == keyF4 then
        pcForms "\u{001B}[1;" "S" ++ [ plainEntry "\u{001B}OS" ]

    else if k >= keyF5 && k <= keyF25 then
        let
            n =
                Maybe.withDefault 0 (Array.get (k - keyF5) [ 15, 17, 18, 19, 20, 21, 23, 24, 25, 26, 28, 29, 31, 32, 33, 34, 42, 43, 44, 45, 46 ])
        in
        plain (String.fromInt n) ("\u{001B}[" ++ String.fromInt n ++ "~")

    else if k >= keyNumpad0 && k <= keyNumpad9 then
        kpKeys (charString (0x70 + k - keyNumpad0)) (String.fromInt (k - keyNumpad0))

    else if k == keyNumpadDecimal then
        kpKeys "n" "."

    else if k == keyNumpadDivide then
        kpKeys "o" "/"

    else if k == keyNumpadMultiply then
        kpKeys "j" "*"

    else if k == keyNumpadSubtract then
        kpKeys "m" "-"

    else if k == keyNumpadAdd then
        kpKeys "k" "+"

    else if k == keyNumpadEnter then
        kpKeys "M" "\u{000D}"

    else if k == keyBackspace then
        backspaceEntries

    else if k == keyTab then
        tabEntries

    else if k == keyEnter then
        enterEntries

    else if k == keyEscape then
        escapeEntries

    else
        []


pcStyle : Options -> Int -> Int -> Maybe String
pcStyle opts k mods =
    let
        bm =
            binding mods

        keypadApp =
            not opts.ignoreKeypadWithNumlock && opts.keypadApplication

        fits en =
            (en.cursor == 0 || (en.cursor == 1) == not opts.cursorApplication)
                && (en.keypad == 0 || (en.keypad == 1) == not keypadApp)
                -- `set` (1) is the table's form with modifyOtherKeys off,
                -- `set_other` (2) with it on
                && (en.modifyOther == 0 || (en.modifyOther == 1) == not opts.modifyOtherKeys2)
                && (if en.mods == 0 then
                        bm == 0 || en.emptyIsAny

                    else
                        en.mods == bm
                   )
    in
    Array.findFirst fits (functionKey k)
        |> Maybe.map
            (\found ->
                if opts.backarrow && found.value.decbkm /= "" then
                    found.value.decbkm

                else
                    found.value.sequence
            )
