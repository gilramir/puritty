module Vt.View exposing (Shadow, shadow, frame, Look, defaultLook, Focus, focused)

{-| The renderer's Geng side (`docs/phase2-window.md` §3, V18; in the
core's package by V19, `docs/renderer.md` §R6): a renderer that keeps its
own copy of the screen it drew and diffs the core's screen against it once
a frame, as PuTTY does.

The core's screen is one `Array.Builder` written in place, and a builder is
used once (geng-lang D963), so the renderer cannot keep last frame's handle.
It keeps instead:

  - `cells`, the cells it drew, `rows * cols`, `-1` where nothing is known;
  - `hashes`, a hash of each row it drew. A scroll is found by content: the
    longest band of rows whose hashes are the last frame's moved by `k`
    rows, up or down, with at least two rows in it that are not blank. The
    band is one `CopyArea`, and only what is left is diffed and drawn. The
    rows a scroll vacates keep their pixels, so the shadow keeps their
    cells. A false match costs a copy and is then drawn over: the diff is
    against what the pixels show, so it is never wrong.

The core's ring slots would say which rows moved without hashing, but the
core settles a region's turn by moving rows when the region changes, so a
slot is not a row's identity across a frame (§3).

A frame's display list is `Bytes`: first, in the first frame and in each
whose screen is not the size of the last one's, a size record (`0x04`, the
columns and rows in 2 bytes each), since the core may change its own size
(DECCOLM); then a style record for each style id
its runs use (`0x03`, the id in 2 bytes, then the foreground, background
and underline colours as RGB in 3 bytes each, the style's flags in a byte
as `Vt.Style.Attrs` has them, and its underline's kind in a byte), so that
whatever executes the list keeps no table between frames and resolves
nothing (`docs/renderer.md` V35); then a scroll record (`0x01`, top, bottom,
`k` as a signed 16 bits, rows `top + k` to `bottom + k` copied to `top`) and a run record per changed run (`0x02`, `y`, `x`, `n`, then each
cell: a byte of its width state in the top two bits (0 narrow, 1 the head
of a wide character, 2 its tail, 3 a spacer at a row's end) and its count
of code points below them, its style id in 2 bytes, and its code points in
3 bytes each: its cluster's, up to 63, §13). A run is a stretch of
changed cells with gaps of fewer than four unchanged cells merged in, so
that a glyph overhanging into its neighbour is redrawn with it (S§6.2),
and never starts on a wide character's tail or ends on its head.

**The cursor** is drawn as its cell's run, in a cursor style: the cell's
style id with its top bit set, `0x8000 + id`, whose record this frame
carries the cursor's colours and shape. The shape is the underline byte's
top four bits (1 a block, 2 an underline, 3 a bar, 4 a hollow block, which
is any cursor while the window does not have the focus); its bottom four
are the underline's kind. A block's record has the cell's background as
its foreground and the cursor's colour (OSC 12, else the cell's
foreground) as its background; the others keep the cell's colours and
carry the cursor's as the underline colour, which whatever executes the
list draws the shape in. A wide character's two cells both take it. The
shadow keeps the cursor's cells marked (their shape in bits 56 and up, which
no cell of the core's has), so a cell the cursor leaves differs from what
the shadow says was drawn and is drawn again, and so is one whose cursor
changes shape. Nothing is drawn for a cursor DECTCEM hides, or for a
blinking one (mode 12) while `Focus.blinkOn` is false: blinking is the
loop's, which knows the time.

A style's colours are resolved here, from the core's palette and dynamic
colours (OSC 4, 10, 11) and the profile's `Look`: inverse and the screen's
reverse video (mode 5) swap the two, faint takes the foreground half way
to the background, invisible makes it the background, and bold makes a
colour of the first eight its bright one when the look says so. A cell
whose style's colours change is not a changed cell, so when the palette,
the dynamic colours, mode 5 or the look change, the shadow is forgotten
and the frame draws every cell.

-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Int64
import UInt8
import Vt.Cell exposing (..)
import Vt.Term exposing (..)
import Vt.Screen exposing (..)
import Vt.Style exposing (Attrs, Clusters, Styles, cellPoints, styleOf)
import Vt.Palette exposing (dynamicColour, paletteColour)
import Dict


type alias Shadow =
    { cells : Builder Int64
    , hashes : Builder Int
    , cols : Int
    , rows : Int
    , frames : Int
    , scrolls : Int
    , moved : Int
    , drawn : Int
    , runs : Int
    , bytes : Int
    , colourKey : Int
    , stamps : Builder Int
    , styleIds : Builder Int
    }


{-| What a profile says of colours: the default foreground and background,
which OSC 10 and 11 override, and whether bold brightens one of the first
eight palette colours. -}
type alias Look =
    { foreground : Int
    , background : Int
    , boldIsBright : Bool
    }


{-| What the window says of the cursor: whether the window has the focus,
and whether a blinking cursor is in the half of its blink that shows it. -}
type alias Focus =
    { focused : Bool
    , blinkOn : Bool
    }


focused : Focus
focused =
    { focused = True, blinkOn = True }


{-| The core's palette's own: its white on its black. -}
defaultLook : Look
defaultLook =
    { foreground = 0xC5C8C6, background = 0x1D1F21, boldIsBright = False }


unknown : Int64
unknown =
    Int64.fromInt -1


shadow : Int -> Int -> Shadow
shadow cols rows =
    { cells = Builder.fromArray (Array.repeat (cols * rows) unknown)
    , hashes = Builder.fromArray (Array.repeat rows -1)
    , cols = cols
    , rows = rows
    , frames = 0
    , scrolls = 0
    , moved = 0
    , drawn = 0
    , runs = 0
    , bytes = 0
    , colourKey = -1
    , stamps = Builder.fromArray (Array.repeat (2 * styleMax) -1)
    , styleIds = Builder.empty 64
    }


{-| One frame: the shadow brought up to the term's screen, and the display
list that does the same to the window. -}
frame : Look -> Focus -> Term -> (moved sh0 : Shadow) -> { shadow : Shadow, list : Bytes }
frame look focus t sh0 =
    let
        key =
            colourKey look t

        cursor =
            cursorOf focus t

        sh1 =
            if t.cols /= sh0.cols || t.rows /= sh0.rows || key /= sh0.colourKey then
                let
                    fresh =
                        shadow t.cols t.rows
                in
                { fresh | frames = sh0.frames, scrolls = sh0.scrolls, moved = sh0.moved, drawn = sh0.drawn, runs = sh0.runs, bytes = sh0.bytes, colourKey = key }

            else
                { sh0 | styleIds = Builder.empty 64 }

        rows =
            sh1.rows

        cols =
            sh1.cols

        current =
            Builder.toArray (hashRows t.screen 0 rows cols (Builder.empty rows))

        band =
            searchK (1 - rows) rows current sh1.hashes { score = 1, top = 0, bottom = -1, k = 0 }

        scrolled =
            if band.bottom >= band.top then
                scrollBand band cols sh1

            else
                { shadow = sh1, list = Builder.empty 4096 }

        sh2 =
            scrolled.shadow

        diffed =
            diffRows t.screen t.clusters cursor 0 rows cols sh2 scrolled.list

        sh3 =
            diffed.shadow

        ids =
            Builder.toArray sh3.styleIds

        styles =
            Array.foldl (styleRecord look t cursor.shape) (Builder.empty (14 * Array.length ids)) ids

        size =
            if sh0.frames == 0 || t.cols /= sh0.cols || t.rows /= sh0.rows then
                [ UInt8.fromInt 4 ] ++ Builder.toArray (push16 t.rows (push16 t.cols (Builder.empty 4)))

            else
                []

        bytes =
            Bytes.fromUInt8s (size ++ Builder.toArray styles ++ Builder.toArray diffed.list)
    in
    { shadow = { sh3 | hashes = Builder.fromArray current, styleIds = Builder.empty 64, frames = sh3.frames + 1, bytes = sh3.bytes + Bytes.length bytes }
    , list = bytes
    }


{-| Each row's hash, pushed onto `acc`. A loop, because a function that
captures the screen to read it is refused: a capture takes the builder
(§3.3). -}
hashRows : Screen -> Int -> Int -> Int -> (moved acc : Builder Int) -> Builder Int
hashRows s y rows cols acc =
    if y >= rows then
        acc

    else
        hashRows s (y + 1) rows cols (Builder.pushLast (rowHash s (rowOffset s y) cols) acc)


{-| A hash of the row at `o`: its cells to its extent, and the extent. A
blank row's is 7. -}
rowHash : Screen -> Int -> Int -> Int
rowHash s o cols =
    let
        ext =
            extentAt o s
    in
    Bitwise.xor ext (hashCells s o 0 ext 7)


hashCells : Screen -> Int -> Int -> Int -> Int -> Int
hashCells s o x ext h =
    if x >= ext then
        h

    else
        let
            c =
                Maybe.withDefault 0 (Builder.get (o + x) s.cells)
        in
        hashCells s o (x + 1) ext (Bitwise.xor (rotl (Bitwise.xor (rotl h) (Int64.toIntWrap c))) (cellStyle c))


rotl : Int -> Int
rotl h =
    Bitwise.or (Bitwise.shiftLeftBy 5 h) (Bitwise.shiftRightZfBy 27 h)


type alias Band =
    { score : Int, top : Int, bottom : Int, k : Int }


{-| The best band over every shift `k` from `k` to `rows - 1`, 0 left out:
the one with the most rows that are not blank, more than `best.score`. -}
searchK : Int -> Int -> Array Int -> Builder Int -> Band -> Band
searchK k rows current hashes best =
    if k >= rows then
        best

    else if k == 0 then
        searchK 1 rows current hashes best

    else
        searchK (k + 1) rows current hashes (scanY k (max 0 (0 - k)) (min rows (rows - k)) -1 0 current hashes best)


{-| Rows `y` to `end` at shift `k`: a run of rows that each match the row
`k` below it last frame, `start` its first row (`-1` outside a run) and
`score` its rows that are not blank. -}
scanY : Int -> Int -> Int -> Int -> Int -> Array Int -> Builder Int -> Band -> Band
scanY k y end start score current hashes best =
    let
        closed =
            if start >= 0 && score > best.score then
                { score = score, top = start, bottom = y - 1, k = k }

            else
                best
    in
    if y >= end then
        closed

    else
        let
            h =
                Maybe.withDefault -2 (Array.get y current)
        in
        if h == Maybe.withDefault -3 (Builder.get (y + k) hashes) then
            scanY k (y + 1) end (if start < 0 then y else start) (if h == 7 then score else score + 1) current hashes best

        else
            scanY k (y + 1) end -1 0 current hashes closed


{-| The band moved in the shadow as one `CopyArea` moves it in the window. -}
scrollBand : Band -> Int -> (moved sh : Shadow) -> { shadow : Shadow, list : Builder UInt8 }
scrollBand band cols sh =
    let
        list =
            Builder.empty 4096
                |> Builder.pushLast (UInt8.fromInt 1)
                |> push16 band.top
                |> push16 band.bottom
                |> push16 (Bitwise.and 0xFFFF band.k)
    in
    { shadow =
        { sh
            | cells = Builder.copyWithin (band.top * cols) ((band.top + band.k) * cols) ((band.bottom + 1 + band.k) * cols) sh.cells
            , scrolls = sh.scrolls + 1
            , moved = sh.moved + (band.bottom + 1 - band.top)
        }
    , list = list
    }


diffRows : Screen -> Clusters -> Cursor -> Int -> Int -> Int -> (moved sh : Shadow) -> (moved list : Builder UInt8) -> { shadow : Shadow, list : Builder UInt8 }
diffRows s clusters cursor y rows cols sh list =
    if y >= rows then
        { shadow = sh, list = list }

    else
        let
            o =
                rowOffset s y

            r =
                diffRow s clusters cursor o (extentAt o s) y 0 cols sh list

        in
        diffRows s clusters cursor (y + 1) rows cols r.shadow r.list


{-| The cell the core holds at column `x` of the row at `o`. -}
cellOf : Screen -> Int -> Int -> Int -> Int64
cellOf s o ext x =
    if x < ext then
        Maybe.withDefault 0 (Builder.get (o + x) s.cells)

    else
        0


{-| Row `y` from column `x`: each changed run written to the list and the
shadow. -}
diffRow : Screen -> Clusters -> Cursor -> Int -> Int -> Int -> Int -> Int -> (moved sh : Shadow) -> (moved list : Builder UInt8) -> { shadow : Shadow, list : Builder UInt8 }
diffRow s clusters cursor o ext y x0 cols sh list =
    if x0 >= cols then
        { shadow = sh, list = list }

    else if drawnAs s cursor o ext (y * cols) x0 == Maybe.withDefault unknown (Builder.get (y * cols + x0) sh.cells) then
        diffRow s clusters cursor o ext y (x0 + 1) cols sh list

    else
        let
            x =
                if x0 > 0 && cellWide (cellOf s o ext x0) == wideTail then
                    x0 - 1

                else
                    x0

            end0 =
                runEnd s cursor o ext y (x0 + 1) x0 cols sh.cells

            end =
                if end0 < cols && cellWide (cellOf s o ext (end0 - 1)) == wideHead then
                    end0 + 1

                else
                    end0

            n =
                end - x

            written =
                writeRun s clusters cursor o ext (y * cols) x end sh.frames sh.cells sh.stamps sh.styleIds (list |> Builder.pushLast (UInt8.fromInt 2) |> push16 y |> push16 x |> push16 n)
        in
        diffRow s clusters cursor o ext y end cols { sh | cells = written.cells, stamps = written.stamps, styleIds = written.styleIds, drawn = sh.drawn + n, runs = sh.runs + 1 } written.list


{-| Past the last changed cell of a run that starts before `x`, gaps of
fewer than four unchanged cells taken in; `last` is the last changed cell
seen. -}
runEnd : Screen -> Cursor -> Int -> Int -> Int -> Int -> Int -> Int -> Builder Int64 -> Int
runEnd s cursor o ext y x last cols cells =
    if x >= cols || x - last > 3 then
        last + 1

    else if drawnAs s cursor o ext (y * cols) x == Maybe.withDefault unknown (Builder.get (y * cols + x) cells) then
        runEnd s cursor o ext y (x + 1) last cols cells

    else
        runEnd s cursor o ext y (x + 1) x cols cells


{-| The cells of a run, written to the list and the shadow; each style id
the first time this frame (`stamp`) is added to `styleIds`. -}
writeRun : Screen -> Clusters -> Cursor -> Int -> Int -> Int -> Int -> Int -> Int -> (moved cells : Builder Int64) -> (moved stamps : Builder Int) -> (moved styleIds : Builder Int) -> (moved list : Builder UInt8) -> { cells : Builder Int64, stamps : Builder Int, styleIds : Builder Int, list : Builder UInt8 }
writeRun s clusters cursor o ext row x end stamp cells stamps styleIds list =
    if x >= end then
        { cells = cells, stamps = stamps, styleIds = styleIds, list = list }

    else
        let
            c =
                cellOf s o ext x

            points =
                Array.takeFirst 63 (cellPoints c clusters)

            under =
                isCursor cursor (row + x)

            id =
                if under then
                    0x8000 + Bitwise.and 0x7FFF (cellStyle c)

                else
                    Bitwise.and 0x7FFF (cellStyle c)

            seen =
                Builder.get id stamps == Just stamp
        in
        writeRun s clusters cursor o ext row (x + 1) end stamp
            (Builder.set (row + x) (drawnAs s cursor o ext row x) cells)
            (if seen then stamps else Builder.set id stamp stamps)
            (if seen then styleIds else Builder.pushLast id styleIds)
            (Array.foldl push24
                (list
                    |> Builder.pushLast (UInt8.fromInt (Bitwise.or (Bitwise.shiftRightZfBy 15 (cellWide c)) (Array.length points)))
                    |> push16 id
                )
                points
            )


push24 : Int -> (moved b : Builder UInt8) -> Builder UInt8
push24 v b =
    push16 (Bitwise.and 0xFFFF v) (Builder.pushLast (UInt8.fromInt (Bitwise.shiftRightZfBy 16 v)) b)


push16 : Int -> (moved b : Builder UInt8) -> Builder UInt8
push16 v b =
    Builder.pushLast (UInt8.fromInt (Bitwise.and 0xFF v)) (Builder.pushLast (UInt8.fromInt (Bitwise.and 0xFF (Bitwise.shiftRightZfBy 8 v))) b)


-- COLOURS


{-| What a frame's colours are resolved from, as one number: when it
changes, every cell is drawn again. -}
colourKey : Look -> Term -> Int
colourKey look t =
    let
        mix h v =
            Bitwise.xor (rotl h) v
    in
    Dict.foldl (\k v h -> mix (mix h k) v)
        (mix (mix (mix (if Dict.get 5 t.modes == Just True then 1 else 0) look.foreground) look.background) (if look.boldIsBright then 1 else 0))
        t.colours


-- THE CURSOR


{-| Where the cursor is drawn, as an index into the shadow's cells (`-1`
for none), how many cells it covers, and its shape (1 a block, 2 an
underline, 3 a bar, 4 a hollow block). -}
type alias Cursor =
    { at : Int, cells : Int, shape : Int }


cursorOf : Focus -> Term -> Cursor
cursorOf focus t =
    let
        blinking =
            Dict.get 12 t.modes == Just True

        o =
            rowOffset t.screen t.y

        head =
            if t.x > 0 && cellWide (cellOf t.screen o (extentAt o t.screen) t.x) == wideTail then
                t.x - 1

            else
                t.x

        wide =
            cellWide (cellOf t.screen o (extentAt o t.screen) head) == wideHead && head + 1 < t.cols
    in
    if not t.showCursor || (blinking && not focus.blinkOn) || t.x >= t.cols || t.y >= t.rows || t.x < 0 || t.y < 0 then
        { at = -1, cells = 0, shape = 0 }

    else
        { at = t.y * t.cols + head
        , cells = if wide then 2 else 1
        , shape =
            if not focus.focused then
                4

            else if t.cursorShape == 3 then
                2

            else if t.cursorShape == 5 then
                3

            else
                1
        }


isCursor : Cursor -> Int -> Bool
isCursor cursor i =
    cursor.at >= 0 && i >= cursor.at && i < cursor.at + cursor.cells


{-| The cell as the shadow keeps it once it is drawn: the core's, marked
with the cursor's shape where the cursor is. -}
drawnAs : Screen -> Cursor -> Int -> Int -> Int -> Int -> Int64
drawnAs s cursor o ext row x =
    let
        c =
            cellOf s o ext x
    in
    if isCursor cursor (row + x) then
        Bitwise.or c (Bitwise.shiftLeftBy 56 (Int64.fromInt cursor.shape))

    else
        c


{-| A style id's record: its colours resolved (see the module's comment);
for an id of `0x8000` and more, its cell's under the cursor. -}
styleRecord : Look -> Term -> Int -> Int -> (moved b : Builder UInt8) -> Builder UInt8
styleRecord look t shape id b =
    let
        a =
            styleOf (Bitwise.and 0x7FFF id) t.styles

        cursorShape =
            if id >= 0x8000 then
                shape

            else
                0

        bold =
            Bitwise.and a.flags 1 /= 0

        fg0 =
            colourOf look t True bold a.fg

        bg0 =
            colourOf look t False False a.bg

        swapped =
            (Bitwise.and a.flags 16 /= 0) /= (Dict.get 5 t.modes == Just True)

        fg1 =
            if swapped then bg0 else fg0

        bg =
            if swapped then fg0 else bg0

        fg2 =
            if Bitwise.and a.flags 2 /= 0 then
                halfway fg1 bg

            else
                fg1

        fg =
            if Bitwise.and a.flags 32 /= 0 then
                bg

            else
                fg2

        ulc =
            if a.ulc == 0 then
                fg

            else
                colourOf look t True False a.ulc

        cursorColour =
            Maybe.withDefault fg (dynamicColour 12 t)

        out =
            if cursorShape == 1 then
                { fg = bg, bg = cursorColour, ulc = bg }

            else if cursorShape > 1 then
                { fg = fg, bg = bg, ulc = cursorColour }

            else
                { fg = fg, bg = bg, ulc = ulc }
    in
    b
        |> Builder.pushLast (UInt8.fromInt 3)
        |> push16 id
        |> push24 out.fg
        |> push24 out.bg
        |> push24 out.ulc
        |> Builder.pushLast (UInt8.fromInt (Bitwise.and a.flags 0xFF))
        |> Builder.pushLast (UInt8.fromInt (Bitwise.or (Bitwise.shiftLeftBy 4 cursorShape) a.ul))


{-| A colour of `Attrs` as RGB: 0 the default (OSC 10 or 11, else the
look's), 1 to 256 a palette index and one more, or `0x1000000` and RGB. -}
colourOf : Look -> Term -> Bool -> Bool -> Int -> Int
colourOf look t isFg bold c =
    if c == 0 then
        if isFg then
            Maybe.withDefault look.foreground (dynamicColour 10 t)

        else
            Maybe.withDefault look.background (dynamicColour 11 t)

    else if c <= 256 then
        let
            i =
                c - 1
        in
        paletteColour (if bold && look.boldIsBright && i < 8 then i + 8 else i) t

    else
        Bitwise.and c 0xFFFFFF


{-| Each channel half way from `a` to `b`. -}
halfway : Int -> Int -> Int
halfway a b =
    let
        channel shift =
            Bitwise.shiftLeftBy shift ((Bitwise.and 0xFF (Bitwise.shiftRightZfBy shift a) + Bitwise.and 0xFF (Bitwise.shiftRightZfBy shift b)) // 2)
    in
    Bitwise.or (channel 16) (Bitwise.or (channel 8) (channel 0))
