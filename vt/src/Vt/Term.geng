import Vt.Cell exposing (..)
import Vt.Style exposing (..)


-- THE STATE


{-| What the embedder says of itself, which a program can ask
(`docs/tmux.md` TM4): its foreground and background, which OSC 10 and 11
answer while no program has set them and DSR 996 reports as dark or light;
DA1's answer; and XTVERSION's name. `ghosttyEmbedder` is libghostty-vt's
without an embedder: no colours, `?62;22c` and puritty's name, which the
replay corpus is held to; puritty's window says more (`Vt.withEmbedder`). -}
type alias Embedder =
    { look : Maybe { foreground : Int, background : Int }
    , attributes : String
    , version : String
    }


ghosttyEmbedder : Embedder
ghosttyEmbedder =
    { look = Nothing
    , attributes = "\u{001B}[?62;22c"
    , version = "puritty"
    }


{-| `checksums` turns on DECRQCRA's answer (§VC10). It is off unless asked
for, as Ghostty's is, since a program can checksum the screen a cell at a
time and so read everything on it, other programs' output among it.
`cellWidth` and `cellHeight` are a cell's size in pixels, which the reports
of the size in pixels need (`CSI 14 t`, `CSI 16 t`, mode 2048); 0 is
unknown, and they are not answered (V15). `scrollbackBytes` is the most
the scrollback's pages may hold, in bytes (V21, §VC32); `Vt.scrollbackBytesFor`
gives the bytes for a number of rows of a width. `pageRows` is the rows a
page of scrollback holds, 16 to 4,096: `Vt.defaultPageRows` unless a test
wants pages that fill sooner (V33). -}
type alias Config =
    { cols : Int
    , rows : Int
    , scrollbackBytes : Int
    , pageRows : Int
    , checksums : Bool
    , cellWidth : Int
    , cellHeight : Int
    }


{-| A page of scrollback, and the width its rows were cut at, which is
the screen's: a resize that changes the width cuts every page again on its
bytes, as Ghostty reflows every row at a resize (V20, §VC31; it replaced
V10's reflow when read and V16's widths a page went through). `plain`:
whether every row is in the default style and every cell one ASCII byte
(or an empty cell's 0), so that a row's text is as long as its extent and
a cut needs only the headers (§VC33). Its bytes are `Bytes.Owned`, so a
page has one holder and is given back where it is dropped: a resize's old
pages, a page over the limit, the scrollback at ED 3 and RIS (geng-lang
D1027, D1031, §VC39). -}
type alias Page =
    { text : Owned, heads : Owned, runs : Owned, cols : Int, plain : Plainness }


{-| `Unsure` for a page paged out of the ring, so that paging a row out
costs nothing for it, until a resize decides it as it cuts the page
(`Vt.Pages.plainPage`); the pages a resize writes are `Plain` or
`NotPlain`, and `NotPlain` says only that the page may not be plain. -}
type Plainness
    = Unsure
    | Plain
    | NotPlain


{-| The main screen's scrollback in pages, oldest first from slot `head`
(the slots before it are pages dropped, emptied), each of `pageRows` rows
as `pageOut` cuts them (`Config.pageRows`). `limit`: the most bytes
the pages may hold (V21, §VC32), none when 0; `bytes` and `rows`: what they
hold, the rows at most 2^29, the pages dropped past it as past the limit. `peak`: the most rows the scrollback may have held, the ring's with
the pages', and `dropped`: whether a page has gone for the limit; both stay
once set, and are noted inside a read, where a resize by DECCOLM can bring
the scrollback back down. Ghostty prunes at another point than the core, so
the differential fuzzer compares the scrollback only while neither says it
may have (§VC17, §VC25, `Vt.historyReached`). -}
type alias Back =
    { pages : Builder Page
    , head : Int
    , pageRows : Int where 16 <= pageRows && pageRows <= 4096
    , limit : Int
    , bytes : Int
    , rows : Int
    , peak : Int
    , dropped : Bool
      -- the rows dropped from the oldest end since the term was made, so
      -- that a view scrolled back can stay on its rows as more come in
      -- (`Vt.rowsPushed`); it and `rows` stop at 2^29, so that a sum of
      -- the two and the ring's stays inside `Int` (§VC51)
    , gone : Int where 0 <= rows && rows <= 536870912 && 0 <= gone && gone <= 536870912
    }


{-| What DECSC saves. -}
type alias Saved =
    { x : Int
    , y : Int
    , attrs : Attrs
    , wrapNext : Bool
    , origin : Bool
    , sets : Int
    , gl : Int
    , single : Int
    , guard : Int64
    , isSet : Bool
    }


{-| The kitty keyboard protocol's flags, a stack of eight that wraps, as
Ghostty keeps one for each screen (§VC17). The core reports them and
encodes no key with them yet: keys are phase 2's. -}
type alias Keys =
    { stack : Array Int
    , at : Int where 0 <= at && at < Array.length stack
    }


noKeys : Keys
noKeys =
    { stack = [ 0, 0, 0, 0, 0, 0, 0, 0 ], at = 0 }


{-| CSI ? u, > u, < u and = u, as Ghostty takes them: a push of a value
over 31, or a set of one, does nothing; a pop of eight or more empties the
stack; `=`'s second parameter sets (1), adds (2) or clears (3) the flags. -}
keyFlags : Int -> Array Int -> (taken t : Term) -> Term
keyFlags priv params t =
    let
        k =
            t.keys

        top =
            Array.getProven k.at k.stack

        first =
            Maybe.withDefault 0 (Array.get 0 params)
    in
    if priv == 0x3F then
        reply ("\u{001B}[?" ++ String.fromInt top ++ "u") t

    else if priv == 0x3E then
        let
            flags =
                if Array.length params == 1 then
                    first

                else
                    0

            -- the next slot, wrapping: `at` is inside the stack, so
            -- `at + 1` cannot wrap and is at most its length
            at =
                if k.at + 1 < Array.length k.stack then
                    k.at + 1

                else
                    0
        in
        if flags > 31 then
            t

        else
            { t | keys = { stack = Array.set at flags k.stack, at = at } }

    else if priv == 0x3C then
        let
            count =
                if Array.length params == 1 then
                    first

                else
                    1
        in
        if count >= 8 then
            { t | keys = noKeys }

        else
            { t | keys = popKeys count k }

    else
        let
            flags =
                if Array.length params >= 1 then
                    first

                else
                    0

            how =
                Maybe.withDefault 1 (Array.get 1 params)

            set =
                if how == 1 then
                    flags

                else if how == 2 then
                    Bitwise.or top flags

                else
                    Bitwise.and top (Bitwise.complement flags)
        in
        if flags > 31 || how < 1 || how > 3 then
            t

        else
            { t | keys = { k | stack = Array.set k.at set k.stack } }


popKeys : Int -> Keys -> Keys
popKeys n k =
    if n <= 0 then
        k

    else
        popKeys (n - 1)
            { stack = Array.set k.at 0 k.stack
            , at =
                if k.at > 0 then
                    k.at - 1

                else
                    Array.length k.stack - 1
            }


{-| No cursor saved: DECRC goes home with the defaults. -}
noSaved : Saved
noSaved =
    { x = 0, y = 0, attrs = plainAttrs, wrapNext = False, origin = False, sets = 0, gl = 0, single = -1, guard = 0, isSet = False }


{-| A ring of `size` rows, `stride` slots each, in one builder: the screen's
`rows` rows from physical slot `base` on, the `hist` rows of scrollback not
yet packed into a page just before it, oldest first, and free rows after
it. The region, `top` and `height`, keeps its own `turn`. -}
type alias Screen =
    { cells : Builder Int64
    , cols : Int
    , rows : Int
    , stride : Int
    , base : Int
    , hist : Int
    , size : Int where 0 <= hist && hist + rows <= size && 1 <= cols && cols <= 1000 && 1 <= rows && rows <= 1000 && rows < size && size <= 9193 && 0 <= base && base < size && stride == cols + 1 && Builder.length cells == size * stride
    , top : Int
    , height : Int
    , turn : Int where 0 <= top && 1 <= height && top + height <= rows && 0 <= turn && turn < height
    , saved : Saved
    }


type alias Term =
    { screen : Screen
    , other : Maybe Screen
    , hidden : { x : Int, y : Int, wrap : Bool }
    , keys : Keys
    , otherKeys : Keys
    , otherProtect : Int
    , otherErase : Int64
    , heads : Bool
    , alt : Bool
    , config : Config where 1 <= config.cols && config.cols <= 1000 && 1 <= config.rows && config.rows <= 1000 && 16 <= config.pageRows && config.pageRows <= 4096
    , cols : Int
    , rows : Int where 1 <= cols && cols <= 1000 && 1 <= rows && rows <= 1000 && screen.cols == cols && screen.rows == rows
    , x : Int
    , y : Int where 0 <= x && x < cols && 0 <= y && y < rows
    , wrapNext : Bool
    , top : Int
    , bottom : Int
    , left : Int
    , right : Int where 0 <= top && top <= bottom && bottom < rows && 0 <= left && left <= right && right < cols
    , scroll : Int
    , attrs : Attrs
    , pen : Int64
    , erase : Int64
    , styles : Styles
    , styleCache : Builder Int64
    , clusters : Clusters
    , back : Back
    , tabs : Builder Int
    , autowrap : Bool
    , plain : Bool
    , statusLine : Bool -- DECSASD 1: printing goes nowhere (§VC26)
    , origin : Bool
    , insert : Bool
    , showCursor : Bool
    , newline : Bool
    , lfSlow : Bool
    , prompt : Int
    , otherPrompt : Int
    , redraw : Int
    , modes : Dict Int Bool
    , savedModes : Dict Int Bool
      -- the mouse tracking and format the last of their modes set, as
      -- Ghostty's flags keep them: a reset of any one of them is none
      -- (`Vt.Mouse`)
    , mouseTracking : Int
    , mouseFormat : Int
      -- an OSC 52 (docs/phase3-select.md §16): one field, since every
      -- field of the term costs each of its updates (§16's perf)
    , osc52 : Osc52
    , sets : Int
    , gl : Int
    , single : Int
    , guard : Int64
    , protectMode : Int
    , lastPoint : Int
    , title : String
    , colours : Dict Int Int
      -- the 16 named colours before a program sets one: libghostty-vt's, or
      -- the embedder's (`Vt.withPalette`); OSC 4 answers them, OSC 104 and
      -- RIS bring them back (docs/phase3-select.md §22)
    , named : Array Int where Array.length named == 16
    , embedder : Embedder
    , cursorShape : Int
    , otherShape : Int -- the hidden screen's: each has its own (§VC28)
    , ps : Int
    , params : Array Int
    , cur : Int
    , colons : Int
    , priv : Int
    , inter : Int
    , phase : Int
    , str : Builder UInt8
    , utf : Int
    , need : Int
    , low : Int
    , high : Int
    , replies : Array Bytes
    , xtChecksum : Int
    }


{-| The parser's states. -}
psGround : Int
psGround =
    0


psEscape : Int
psEscape =
    1


psEscInter : Int
psEscInter =
    2


psCsi : Int
psCsi =
    3


psCsiIgnore : Int
psCsiIgnore =
    4


psUtf8 : Int
psUtf8 =
    5


psOsc : Int
psOsc =
    6


psDcs : Int
psDcs =
    7


psString : Int
psString =
    8


{-| An OSC 52's text, kept whole (docs/phase3-select.md §16). -}
psClip : Int
psClip =
    9


{-| An OSC 52 being read: what follows its `52;`, each read's run of it
kept as a slice and joined at its end, up to `Vt.clipMax` bytes (`len`;
`over` past it); and the clipboard writes and reads OSC 52s made, for the
embedder to take. -}
type alias Osc52 =
    { clip : Array Bytes, len : Int, over : Bool, requests : Array Clip }


noOsc52 : Osc52
noOsc52 =
    { clip = [], len = 0, over = False, requests = [] }


{-| A clipboard request of an OSC 52 (docs/phase3-select.md §16):
`selection` 0 PRIMARY (`p` or `s`), 1 CLIPBOARD (`c` or none); `text` the
text to write, or Nothing for a read; `letter` the selection's letter as it
came, and `bel` whether a BEL ended it, for a read's answer. -}
type alias Clip =
    { selection : Int, text : Maybe Bytes, letter : Int, bel : Bool }


newScreen : (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> (size : Int where rows < size && size <= 9193) -> (r : Screen where r.rows == rows && r.cols == cols)
newScreen cols rows size =
    let
        -- one sum, so that the cells' length and the stride are one product
        stride =
            cols + 1
    in
    { cells = Builder.repeat (size * stride) 0
    , cols = cols
    , rows = rows
    , stride = stride
    , base = 0
    , hist = 0
    , size = size
    , top = 0
    , height = rows
    , turn = 0
    , saved = noSaved
    }


reply : String -> (taken t : Term) -> Term
reply text t =
    { t | replies = Array.pushLast (Bytes.fromString text) t.replies }


isAlt : Term -> Bool
isAlt t =
    t.alt
