module Vt.Cell exposing
    ( stringMax
    , oscMax
    , paramMax
    , clusterMax
    , styleMax
    , clusterIdMax
    , wideHead
    , wideTail
    , spacerHead
    , clusterBit
    , cellPoint
    , cellWide
    , cellIsCluster
    , cellStyle
    , styleBits
    , metaExtent
    , wrappedBit
    , rowFlags
    , metaPrompt
    , protectBit
    , bgBit
    , highMask
    , byteAt
    , asciiEnd
    )

{-| Part of `Vt` (docs/vt-core.md §VC23). -}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Int64
import Math
import UInt8
import Vt.Width as Width


-- LIMITS


{-| The bytes an OSC or DCS string keeps; the rest of a longer one is
dropped. -}
stringMax : Int
stringMax =
    4096


{-| The bytes after an OSC's number Ghostty keeps for the commands the core
takes (its parser's `MAX_BUF`); one longer is dropped whole (§VC18). -}
oscMax : Int
oscMax =
    2048


{-| Parameters a CSI may have; one with more is ignored, as Ghostty's
parser ignores it. -}
paramMax : Int
paramMax =
    24


{-| Code points a grapheme cluster keeps; a mark past them is dropped. The
character and 64 marks, as Ghostty keeps them (`grapheme_max_len`, §VC22). -}
clusterMax : Int
clusterMax =
    65


{-| Style ids a terminal hands out (15 bits, since a page's run keeps its
top bit, §VC6); past them a new style is the default one (§VC9, an open
bound). The last eight of the fifteen bits' ids are the preedit's, which
`Vt.View` draws over the screen (`docs/phase3-input.md` V46). -}
styleMax : Int
styleMax =
    32760


{-| Cluster ids a terminal hands out (21 bits). -}
clusterIdMax : Int
clusterIdMax =
    0x1FFFFF


-- CELLS


wideHead : Int
wideHead =
    0x200000


wideTail : Int
wideTail =
    0x400000


spacerHead : Int
spacerHead =
    0x600000


clusterBit : Int
clusterBit =
    0x800000


cellPoint : Int64 -> Int
cellPoint c =
    Int64.toIntWrap (Bitwise.and 0x1FFFFF c)


cellWide : Int64 -> Int
cellWide c =
    Int64.toIntWrap (Bitwise.and 0x600000 c)


cellIsCluster : Int64 -> Bool
cellIsCluster c =
    Bitwise.and 0x800000 c /= 0


cellStyle : Int64 -> Int
cellStyle c =
    Int64.toIntWrap (Bitwise.shiftRightZfBy 32 c)


{-| A style id as a cell's high bits. -}
styleBits : Int -> Int64
styleBits id =
    Bitwise.shiftLeftBy 32 (Int64.fromInt id)


{-| A row's meta slot: its extent in bits 0–15, bit 16 set when the row
wrapped into the next. -}
metaExtent : Int64 -> Int
metaExtent m =
    Int64.toIntWrap (Bitwise.and 0xFFFF m)


wrappedBit : Int64
wrappedBit =
    0x10000


{-| A row's flags in its meta slot: wrapped, and its prompt mark in bits
17–18 (0 none, 1 a prompt, 2 a prompt's continuation, §VC22), which a write
that moves the extent keeps. -}
rowFlags : Int64
rowFlags =
    0x70000


metaPrompt : Int64 -> Int
metaPrompt m =
    Int64.toIntWrap (Bitwise.and 3 (Bitwise.shiftRightZfBy 17 m))


{-| A protected cell (DECSCA, SPA): what DECSED and DECSEL, and in ISO's
mode ED, EL and ECH, leave as it is (§VC12). -}
protectBit : Int64
protectBit =
    0x1000000


{-| A cell in a background colour alone, as an erase leaves it: Ghostty's
`bg_color` cell, which a reflow keeps where it drops an empty cell in a
style (`emptyCell`, §VC17). Every non-zero erase cell carries it, and a
page writes such a cell as a 0xFE byte. -}
bgBit : Int64
bgBit =
    0x2000000


{-| A cell's style, without its content. -}
highMask : Int64
highMask =
    Bitwise.complement 0xFFFFFFFF


byteAt : Bytes -> Int -> Int
byteAt bytes i =
    when Bytes.get i bytes is
        Just b ->
            UInt8.toInt b

        Nothing ->
            -1


{-| The index of the first byte at or after `i` that is not printable ASCII,
or `stop`. -}
asciiEnd : Bytes -> (stop : Int) -> (i : Int) -> (r : Int where i <= r && (r == i || r <= stop))
asciiEnd bytes stop i =
    -- printable ASCII, 0x20 to 0x7E: one call, 16 bytes a step natively
    -- (geng-lang m3-bytes-access.md §BA19)
    Bytes.spanWithin 0x20 0x7E i stop bytes
