module Vt.Placeholder exposing (Cell, Fit, Run, decode, diacriticIndex, fit, isPlaceholder, runsOfRow)

{-| Kitty's Unicode placeholders (`docs/images.md` IM35), as Ghostty reads
them (`src/terminal/kitty/graphics_unicode.zig`, `render.zig`'s
`PlaceholderDecoder`): a virtual placement (`U=1`) is shown by cells that
hold U+10EEEE, each naming its image in its foreground color (the low 24
bits; a third diacritic gives the high 8), its placement in its underline
color (0 for whichever of the image's virtual placements is preferred),
and the row and the column of the image's grid it shows in its first and
second diacritics, from Kitty's table (`rowcolumn-diacritics.txt`). A cell
that leaves out its row or column continues the run to its left.

The cells of a row are cut into runs, each drawn as one piece of the
image: `fit` is Ghostty's `renderPlacement`, which fits the whole image
into the placement's grid keeping its aspect ratio, centred, and gives the
piece a run of cells shows.
-}

import Bitwise
import Dict exposing (Dict)
import Math
import Vt.Reason as Reason
import Vt.Style exposing (Attrs)


{-| The code point a placeholder cell holds. -}
isPlaceholder : Int -> Bool
isPlaceholder cp =
    cp == 0x10EEEE


{-| What one placeholder cell says: its image's id's low 24 bits and its
high 8 (-1 when not given), its placement (0 for none), and its row and
column in the image's grid (-1 when not given). -}
type alias Cell =
    { low : Int, high : Int, placement : Int, row : Int, col : Int }


{-| A run of placeholder cells on a row: its first column and how many,
the image and the placement it asks for, and the row and column of the
image's grid its first cell shows; each next cell shows the next column. -}
type alias Run =
    { x : Int, width : Int, image : Int, placement : Int, row : Int, col : Int }


{-| A cell read from its style and the code points that follow U+10EEEE.
A diacritic not in the table is taken as not there, as Kitty does; those
past the third are ignored. -}
decode : Attrs -> Array Int -> Cell
decode attrs marks =
    let
        mark i =
            when Array.get i marks is
                Just cp ->
                    diacriticIndex cp

                Nothing ->
                    -- a cell may leave its row, column or high byte out
                    meant Reason.FromOutside -1

        high =
            mark 2
    in
    { low = colorId attrs.fg
    , high =
        if high > 255 then
            -1

        else
            high
    , placement = colorId attrs.ulc
    , row = mark 0
    , col = mark 1
    }


{-| A color as an id: a palette index's own number, an RGB color's 24
bits (`Vt.Style.Attrs`: 0 the default, 1 to 256 a palette index and one
more, `0x1000000` and the RGB value). -}
colorId : Int -> Int
colorId c =
    if c <= 0 then
        0

    else if c <= 256 then
        c - 1

    else
        -- an RGB color, `0x1000000` and its value
        Bitwise.and c 0xFFFFFF


{-| The runs of a row's placeholder cells, given left to right with their
columns: a cell continues the run before it when it is in the next column
and names the same image and placement, and its row and column, where it
gives them, are the run's row and its next column. -}
runsOfRow : Array { x : Int, cell : Cell } -> Array Run
runsOfRow cells =
    let
        step c acc =
            when acc.run is
                Just r ->
                    if c.x == r.x + r.width && continues r acc.high c.cell then
                        { acc | run = Just { r | width = r.width + 1 } }

                    else
                        { run = Just (started c), high = startHigh c.cell, done = Array.pushLast (withHigh acc.high r) acc.done }

                Nothing ->
                    -- the row's first placeholder cell
                    meant Reason.NotYet { run = Just (started c), high = startHigh c.cell, done = acc.done }

        last =
            Array.foldl step { run = Nothing, high = -1, done = [] } cells
    in
    when last.run is
        Just r ->
            Array.pushLast (withHigh last.high r) last.done

        Nothing ->
            -- a row with no placeholder cells
            meant Reason.NoMore last.done


{-| A cell beginning a run: a row or column it leaves out is 0. The run's
`image` holds the low bits until the run ends (`withHigh`). -}
started : { x : Int, cell : Cell } -> Run
started c =
    { x = c.x
    , width = 1
    , image = c.cell.low
    , placement = c.cell.placement
    , row = max 0 c.cell.row
    , col = max 0 c.cell.col
    }


startHigh : Cell -> Int
startHigh cell =
    cell.high


continues : Run -> Int -> Cell -> Bool
continues r high cell =
    r.image == cell.low
        && r.placement == cell.placement
        && (cell.row < 0 || cell.row == r.row)
        && (cell.col < 0 || cell.col == r.col + r.width)
        && (cell.high < 0 || cell.high == high)


withHigh : Int -> Run -> Run
withHigh high r =
    { r | image = Bitwise.or r.image (Bitwise.shiftLeftBy 24 (max 0 high)) }


{-| What a run draws (Ghostty's `RenderPlacement`): its offset in its
first cell, the source rectangle in the image's pixels, and the size
drawn, in pixels. -}
type alias Fit =
    { offX : Int, offY : Int, srcX : Int, srcY : Int, srcW : Int, srcH : Int, w : Int, h : Int }


{-| The piece of an image a run shows (Ghostty's `renderPlacement`, its
names kept): the image of `imgW` by `imgH` pixels fitted into the virtual
placement's grid (`cols` by `rows`, or the image's own size in cells where
it gives 0), keeping its aspect ratio and centred, and the run's `width`
cells of the grid's row `row` from column `col`. Nothing when the piece
lies outside the image, or there is no cell size. -}
fit : { cols : Int, rows : Int } -> { imgW : Int, imgH : Int } -> { cw : Int, ch : Int } -> { col : Int, row : Int, width : Int } -> Maybe Fit
fit placement img cell run =
    if cell.cw <= 0 || cell.ch <= 0 || img.imgW <= 0 || img.imgH <= 0 then
        Nothing

    else
        let
            gridRows =
                if placement.rows > 0 then
                    placement.rows

                else
                    (img.imgH + cell.ch - 1) // cell.ch

            gridCols =
                if placement.cols > 0 then
                    placement.cols

                else
                    (img.imgW + cell.cw - 1) // cell.cw

            imgWidth =
                toFloat img.imgW

            imgHeight =
                toFloat img.imgH

            pRowsPx =
                toFloat (gridRows * cell.ch)

            pColsPx =
                toFloat (gridCols * cell.cw)

            pScale =
                if imgWidth * pRowsPx > imgHeight * pColsPx then
                    -- wider than the grid: fit the width, centre the height
                    let
                        s =
                            pColsPx / max imgWidth 1
                    in
                    { xOffset = 0, yOffset = (pRowsPx - imgHeight * s) / 2, xScale = s, yScale = s }

                else
                    -- taller: fit the height, centre the width
                    let
                        s =
                            pRowsPx / max imgHeight 1
                    in
                    { xOffset = (pColsPx - imgWidth * s) / 2, yOffset = 0, xScale = s, yScale = s }

            scaledXOffset =
                pScale.xOffset / pScale.xScale

            scaledYOffset =
                pScale.yOffset / pScale.yScale

            scaledWidth =
                imgWidth + scaledXOffset * 2

            scaledHeight =
                imgHeight + scaledYOffset * 2

            vpWidth =
                toFloat run.width

            vpCol =
                toFloat run.col

            vpRow =
                toFloat run.row

            source0 =
                { w = scaledWidth * (vpWidth / toFloat gridCols)
                , h = scaledHeight * (1 / toFloat gridRows)
                , x = scaledWidth * (vpCol / toFloat gridCols)
                , y = scaledHeight * (vpRow / toFloat gridRows)
                }

            vertical =
                axis source0.y source0.h scaledYOffset scaledHeight imgHeight pScale.yScale (toFloat cell.ch)

            horizontal =
                axis source0.x source0.w scaledXOffset scaledWidth imgWidth pScale.xScale (toFloat (run.width * cell.cw))
        in
        if horizontal.size <= 0 || vertical.size <= 0 then
            Nothing

        else
            Just
                { offX = Math.round (horizontal.offset * pScale.xScale)
                , offY = Math.round (vertical.offset * pScale.yScale)
                , srcX = Math.round horizontal.start
                , srcY = Math.round vertical.start
                , srcW = Math.round horizontal.size
                , srcH = Math.round vertical.size
                , w = Math.round horizontal.dest
                , h = Math.round vertical.dest
                }


{-| One axis of `renderPlacement`'s destination: the source's start and
size in the scaled image, cut where they reach into the centring's blank
margins (which the image itself does not have), the destination's offset
in the scaled image's pixels and its size in the cells' pixels. -}
axis : Float -> Float -> Float -> Float -> Float -> Float -> Float -> { start : Float, size : Float, offset : Float, dest : Float }
axis start size margin scaled original scale dest =
    if start < margin then
        let
            cut =
                margin - start

            size1 =
                size - cut

            dest1 =
                dest - cut * scale
        in
        if size1 > original then
            { start = 0, size = original, offset = cut, dest = original * scale }

        else
            { start = 0, size = size1, offset = cut, dest = dest1 }

    else if start + size > scaled - margin then
        let
            start1 =
                start - margin

            size1 =
                scaled - margin - start1 - margin
        in
        { start = start1, size = size1, offset = 0, dest = size1 * scale }

    else
        { start = start - margin, size = size, offset = 0, dest = dest }


{-| A diacritic's index in Kitty's table, its row's or column's number,
or -1 for a code point not in it. -}
diacriticIndex : Int -> Int
diacriticIndex cp =
    when Dict.get cp diacriticIndices is
        Just i ->
            i

        Nothing ->
            -- not a diacritic of the table: taken as not there, as Kitty does
            meant Reason.NotKnown -1


diacriticIndices : Dict Int Int
diacriticIndices =
    Array.indexedMap (\i cp -> { key = cp, value = i }) diacritics
        |> Array.foldl (\e d -> Dict.set e.key e.value d) Dict.empty


