{-| Editing a row: inserting, deleting and erasing cells, and splitting
the wide characters an edit cuts (`docs/vt-core.md` §VC45). -}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Vt.Base64 as Base64
import Dict exposing (Dict)
import Int64
import Math
import UInt8
import Vt.Keys as Keys
import Vt.Width as Width
import Vt.Cell exposing (..)
import Vt.Style exposing (..)
import Vt.Term exposing (..)
import Vt.Term as State
import Vt.Screen exposing (..)
import Vt.Pages exposing (..)
import Vt.Resize exposing (..)
import Vt.Recut exposing (recut)
import Vt.Dump exposing (..)
import Vt.Palette exposing (..)
import Vt.Cursor exposing (..)
import Vt.Prompt exposing (..)
import Vt.Scroll exposing (..)
import Vt.Sgr exposing (..)


{-| Before columns `x` to `xEnd` of the row at `o` are written, a wide
character whose other half lies outside them loses that half too, which
becomes `fill`, the erase cell, as Ghostty's `blankCell` (§VC17). -}
splitWide : Int64 -> (o : Int where 0 <= o) -> (x : Int where 0 <= x) -> (xEnd : Int) -> Int -> (taken cells : Builder Int64 where o + x < Builder.length cells && o + xEnd <= Builder.length cells) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
splitWide fill o x xEnd ext cells =
    let
        firstCell =
            Maybe.withDefault 0 (Builder.get (o + x) cells)

        -- no cell before an empty run at the row's start: a read at -1
        -- would count back from the builder's end (§VC57)
        lastCell =
            if xEnd > 0 then
                Maybe.withDefault 0 (Builder.get (o + xEnd - 1) cells)

            else
                0

        -- a cell at or past the extent is empty whatever the builder holds
        -- there, which a row cleared by its extent alone leaves behind
        left =
            if cellWide firstCell == wideTail && x > 0 && x < ext then
                Builder.set (o + x - 1) fill cells

            else
                cells
    in
    if cellWide lastCell == wideHead && xEnd < ext then
        Builder.set (o + xEnd) fill left

    else
        left


{-| `splitWide` for an erase, an insert or a delete: the half inside the
columns is made `fill` too, as Ghostty's `splitCellBoundary` clears both
halves whatever is erased after, a protected one too (§VC18). A function of
its own: written into `splitWide`, which clang inlines into the writer of
ASCII runs, where the half inside is written over anyway, it made `gitlog`
and `ls` 5% slower. -}
splitWhole : Int64 -> (o : Int where 0 <= o) -> (x : Int where 0 <= x) -> (xEnd : Int) -> Int -> (taken cells : Builder Int64 where o + x < Builder.length cells && o + xEnd <= Builder.length cells) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
splitWhole fill o x xEnd ext cells =
    let
        firstCell =
            Maybe.withDefault 0 (Builder.get (o + x) cells)

        -- no cell before an empty run at the row's start: a read at -1
        -- would count back from the builder's end (§VC57)
        lastCell =
            if xEnd > 0 then
                Maybe.withDefault 0 (Builder.get (o + xEnd - 1) cells)

            else
                0

        left =
            if cellWide firstCell == wideTail && x > 0 && x < ext then
                Builder.set (o + x) fill (Builder.set (o + x - 1) fill cells)

            else
                cells
    in
    if cellWide lastCell == wideHead && xEnd < ext then
        Builder.set (o + xEnd - 1) fill (Builder.set (o + xEnd) fill left)

    else
        left


{-| `unheadAbove` when `stale`. One call of the writer each path makes,
written into the screen before this, so that clang still inlines a writer
called once (§VC10). -}
unheadIf : (stale : Bool) -> (y : Int where y <= s.rows && (not stale || 1 - s.hist <= y)) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
unheadIf stale y s =
    if stale then
        unheadAbove y s

    else
        s


{-| The row above `y` ending in a spacer head made to end in an empty
cell: once the wide character that wrapped from it is overwritten, Ghostty
makes the spacer head a narrow cell, which a reflow keeps as a blank
(§VC17). -}
unheadAbove : (y : Int where 1 - s.hist <= y && y <= s.rows) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
unheadAbove y s =
    let
        p =
            rowOffset s (y - 1) + s.cols - 1

        c =
            Maybe.withDefault 0 (Builder.get p s.cells)
    in
    if cellWide c == spacerHead then
        { s | cells = Builder.set p (Bitwise.and (Bitwise.complement 0x600000) c) s.cells }

    else
        s


{-| `count` empty cells in `erase` inserted at column `x` of the row at
`o`, the cells from `x` on moving right and those past the row's end lost. -}
insertCells : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (x : Int where 0 <= x && x <= s.cols) -> (count : Int where 0 <= count && count <= 65535) -> Int64 -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
insertCells o x count erase s =
    let
        ext =
            extentAt o s
    in
    if x >= ext && erase == 0 then
        s

    else
        let
            n =
                min count (s.cols - x)

            cells0 =
                reachAt o ext x s.cells

            -- a wide character cut by the row's new end loses its head too
            cells1 =
                splitWhole erase o x x ext cells0

            keepTo =
                min ext (s.cols - n)

            moved =
                if keepTo > x then
                    Builder.copyWithin (o + x + n) (o + x) (o + keepTo) cells1

                else
                    cells1

            lastKept =
                Maybe.withDefault 0 (Builder.get (o + s.cols - 1) moved)

            tidy =
                if keepTo > x && keepTo + n >= s.cols && cellWide lastKept == wideHead then
                    Builder.set (o + s.cols - 1) erase moved

                else
                    moved

            newExt =
                if erase == 0 then
                    min s.cols (max x keepTo + n)

                else
                    max (min s.cols (keepTo + n)) (x + n)

            -- the row's wrapped flag kept, as Ghostty's ICH keeps it (§VC16)
            m =
                Maybe.withDefault 0 (Builder.get (o + s.cols) tidy)
        in
        { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and rowFlags m) (Int64.fromInt newExt)) (Builder.fill (o + x) (o + x + n) erase tidy) }


deleteChars : Int -> (taken t : Term) -> Term
deleteChars count t =
    let
        s =
            t.screen

        o =
            rowOffset s t.y

        ext =
            extentAt o s

        -- the prompt mark kept, as Ghostty's DCH resets the wrap alone
        mark =
            Bitwise.and 0x60000 (metaAt o s)

        x =
            t.x

        n =
            min count (s.cols - x)
    in
    if x >= ext && t.erase == 0 then
        -- the row no longer wraps, as Ghostty's DCH resets it (§VC16)
        { t | screen = setWrapped t.y False s, wrapNext = False }

    else
        let
            cells0 =
                splitWhole t.erase o x (min s.cols (x + n)) ext (reachAt o ext x s.cells)

            from =
                min ext (x + n)

            moved =
                if ext > from then
                    Builder.copyWithin (o + x) (o + from) (o + ext) cells0

                else
                    cells0

            left =
                max x (ext - n)

            -- the cells past the extent move in from the right empty, and
            -- the last `n` are the erase cell
            filled =
                if t.erase == 0 then
                    Builder.set (o + s.cols) (Bitwise.or mark (Int64.fromInt left)) moved

                else
                    Builder.set (o + s.cols) (Bitwise.or mark (Int64.fromInt s.cols)) (Builder.fill (o + s.cols - n) (o + s.cols) t.erase (Builder.fill (o + left) (o + s.cols - n) 0 moved))
        in
        { t | screen = { s | cells = filled }, wrapNext = False }


eraseChars : Int -> (taken t : Term) -> Term
eraseChars count t =
    -- ECH leaves the row not wrapping, as in Ghostty (§VC16)
    let
        end =
            if count >= t.cols - t.x then
                t.cols

            else
                t.x + max 1 count

        -- a wide character at the end is erased whole, as in Ghostty,
        -- which matters when it is protected (§VC18)
        to =
            if end < t.cols && wideAt (end - 1) t == wideHead then
                end + 1

            else
                end
    in
    eraseSpan (t.protectMode == 1) t.x to (resetWrap (splitAbove to (splitAbove t.x { t | wrapNext = False })))


{-| Ghostty's `cursorResetWrap`, which ECH, EL and DCH begin with: the
cursor's row made not to wrap, and when it did, a spacer head at its end
made a cell of the erase colour (§VC18). -}
resetWrap : (taken t : Term) -> (r : Term where r.cols == t.cols)
resetWrap t =
    if rowWrapped t.y t.screen then
        let
            s =
                t.screen

            p =
                rowOffset s t.y + s.cols - 1
        in
        if cellWide (peekCell (rowOffset s t.y) (s.cols - 1) s) == spacerHead then
            { t | screen = setWrapped t.y False { s | cells = Builder.set p t.erase s.cells } }

        else
            { t | screen = setWrapped t.y False s }

    else
        t


{-| Ghostty's `splitCellBoundary` at the row's left edge, where ECH and DCH
begin or end: at column 0 or 1, when the row continues a wrapped one and
starts with a wide character, the spacer head that ends the row above is
made a cell of the erase colour, whatever is erased after. The row above's
wrap stands in for Ghostty's `wrap_continuation`, and above the screen's
top it is the scrollback's newest row, while the ring holds it (§VC18). -}
splitAbove : Int -> (taken t : Term) -> (r : Term where r.cols == t.cols)
splitAbove x t =
    if x <= 1 && (t.y > 0 || t.screen.hist > 0) && rowWrapped (t.y - 1) t.screen && wideAt 0 t == wideHead then
        let
            s =
                t.screen

            p =
                rowOffset s (t.y - 1) + s.cols - 1
        in
        if cellWide (peekCell (rowOffset s (t.y - 1)) (s.cols - 1) s) == spacerHead then
            { t | screen = { s | cells = Builder.set p t.erase s.cells } }

        else
            { t | screen = s }

    else
        t


{-| The wide bits of the cursor's row's cell `x`. -}
wideAt : (x : Int where 0 <= x && x < t.screen.cols) -> (t : Term) -> Int
wideAt x t =
    cellWide (peekCell (rowOffset t.screen t.y) x t.screen)


{-| Columns `from` to `to` of the cursor's row made empty, in the erase
cell. -}
eraseSpan : Bool -> (from : Int where 0 <= from && from <= t.cols) -> (to : Int where to <= t.cols) -> (taken t : Term) -> Term
eraseSpan guarded from to t =
    let
        s =
            t.screen

        o =
            rowOffset s t.y

        m =
            metaAt o s

        ext =
            metaExtent m
    in
    if to <= from then
        { t | screen = s }

    else if t.erase == 0 && from >= ext then
        { t | screen = s }

    else
        let
            newExt =
                if t.erase /= 0 then
                    max ext to

                else if to >= ext && not guarded then
                    from

                else
                    ext

            -- guarded, the cells the extent grows over are made empty
            -- first, or a protected cell left past the extent comes back
            cells0 =
                splitWhole t.erase
                    o
                    from
                    to
                    ext
                    (reachAt o
                        ext
                        (if guarded then
                            newExt

                         else
                            from
                        )
                        s.cells
                    )

            filled =
                if guarded then
                    eraseUnprotected (o + from) (o + min to (max ext to)) t.erase cells0

                else
                    Builder.fill (o + from) (o + min to (max ext to)) t.erase cells0
        in
        { t | screen = { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and rowFlags m) (Int64.fromInt newExt)) filled } }


{-| EL, and DECSEL when `selective`, which leaves protected cells; EL
leaves them too in ISO's protection mode. -}
eraseLine : Bool -> Int -> (taken t : Term) -> Term
eraseLine selective how t =
    let
        guarded =
            selective || t.protectMode == 1
    in
    -- EL 0 and 2 leave the row not wrapping, as Ghostty's cursorResetWrap
    -- does (§VC17); EL 1 keeps it
    -- a wide character the cursor is on is erased whole, as in Ghostty,
    -- which matters when it is protected (§VC18)
    if how == 0 then
        let
            from =
                if t.x > 0 && wideAt t.x t == wideTail then
                    t.x - 1

                else
                    t.x
        in
        eraseSpan guarded from t.cols (resetWrap { t | wrapNext = False })

    else if how == 1 then
        let
            to =
                if wideAt t.x t == wideHead then
                    min t.cols (t.x + 2)

                else
                    t.x + 1
        in
        eraseSpan guarded 0 to { t | wrapNext = False }

    else if how == 2 then
        eraseSpan guarded 0 t.cols (resetWrap { t | wrapNext = False })

    else
        t


{-| The cells from `from` to `to` that are not protected, in the erase cell. -}
eraseUnprotected : Int -> Int -> Int64 -> (taken cells : Builder Int64) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
eraseUnprotected from to fill cells =
    if from >= to then
        cells

    else if Bitwise.and protectBit (Maybe.withDefault 0 (Builder.get from cells)) /= 0 then
        eraseUnprotected (from + 1) to fill cells

    else
        eraseUnprotected (from + 1) to fill (Builder.set from fill cells)


{-| Rows `from` to `to`, their cells that are not protected erased. -}
blankUnprotected : (from : Int where 0 - s.hist <= from) -> (to : Int where to <= s.rows) -> Int64 -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
blankUnprotected from to fill s =
    if from >= to then
        s

    else
        let
            o =
                rowOffset s from

            m =
                metaAt o s

            ext =
                metaExtent m

            newExt =
                if fill /= 0 then
                    s.cols

                else
                    ext

            cells =
                eraseUnprotected o (o + newExt) fill (reachAt o ext newExt s.cells)
        in
        blankUnprotected (from + 1) to fill { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and rowFlags m) (Int64.fromInt newExt)) cells }


{-| ED, and DECSED when `selective`, which leaves protected cells; ED
leaves them too in ISO's protection mode. On the main screen, ED 2 with the
last row that is not blank a prompt's, or its continuation's, scrolls the
screen into the scrollback first, as ED 22 does: Ghostty's way of keeping
what was above a prompt cleared with ^L (#905, §VC22). -}
eraseDisplay : Bool -> Int -> (taken t : Term) -> Term
eraseDisplay selective how t =
    if how == 2 && not t.alt && atPrompt (t.rows - 1) t.screen then
        erasePlain selective 2 (scrollClear t)

    else
        erasePlain selective how t


{-| From row `y` up, the first row with a prompt mark or text: a mark. -}
atPrompt : (y : Int where y < s.rows) -> (s : Screen) -> Bool
atPrompt y s =
    if y < 0 then
        False

    else
        let
            o =
                rowOffset s y

            m =
                metaAt o s
        in
        if metaPrompt m /= 0 then
            True

        else if rowHasText o (clamp 0 s.cols (metaExtent m)) 0 s then
            False

        else
            atPrompt (y - 1) s


rowHasText : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (ext : Int where ext <= s.cols) -> (x : Int where 0 <= x) -> (s : Screen) -> Bool
rowHasText o ext x s =
    if x >= ext then
        False

    else
        let
            c =
                Maybe.withDefault 0 (Builder.get (o + x) s.cells)
        in
        if cellPoint c /= 0 || cellIsCluster c then
            True

        else
            rowHasText o ext (x + 1) s


erasePlain : Bool -> Int -> (taken t : Term) -> Term
erasePlain selective how t =
    if (selective || t.protectMode == 1) && how /= 3 && how /= 22 then
        eraseGuarded selective how t

    else if how == 2 then
        { t | screen = blankRows 0 t.rows t.erase t.screen, wrapNext = False }

    else if how == 3 then
        -- the scrollback only: a pending wrap stays, as in Ghostty (§VC16)
        clearScrollback t

    else if how == 22 then
        scrollClear t

    else if how == 1 then
        -- the rows first, through the term, so that nothing reads the term
        -- after it is handed on (§VC7)
        eraseLine False 1 { t | screen = blankRows 0 t.y t.erase t.screen }

    else if how == 0 then
        eraseLine False 0 { t | screen = blankRows (t.y + 1) t.rows t.erase t.screen }

    else
        t


eraseGuarded : Bool -> Int -> (taken t : Term) -> Term
eraseGuarded selective how t =
    if how == 2 then
        { t | screen = blankUnprotected 0 t.rows t.erase t.screen, wrapNext = False }

    else if how == 1 then
        eraseLine selective 1 { t | screen = blankUnprotected 0 t.y t.erase t.screen }

    else if how == 0 then
        eraseLine selective 0 { t | screen = blankUnprotected (t.y + 1) t.rows t.erase t.screen }

    else
        t


{-| ED 22, Ghostty's (and kitty's) `scroll_complete`: the whole screen
scrolled up, past the margins and its protection, until its last row that
is not empty has gone, into the scrollback on the main screen. The cursor
goes up with its row, or to the top left when the row goes (§VC18). -}
scrollClear : (taken t : Term) -> Term
scrollClear t =
    let
        count =
            filledRows t.screen (t.rows - 1)

        y =
            t.y - count
    in
    if count == 0 then
        { t | wrapNext = False }

    else
        let
            erase =
                t.erase

            -- the rows that come in are blank, not in the erase colour:
            -- Ghostty's `grow`
            up =
                scrollUpBy (keepsScrollback 0 t) count 0 (t.rows - 1) { t | erase = 0 }
        in
        if y < 0 then
            { up | x = 0, y = 0, wrapNext = False, erase = erase }

        else
            { up | y = y, wrapNext = False, erase = erase }


{-| The rows down to the last that is not empty, `y` and above: Ghostty's
`Cell.isEmpty`, for which a cell in a background colour alone is not. -}
filledRows : (s : Screen) -> (y : Int where -1 <= y && y < s.rows) -> (r : Int where 0 <= r && r <= y + 1 && r <= 1001)
filledRows s y =
    if y < 0 then
        0

    else if rowEmpty s (rowOffset s y) 0 then
        filledRows s (y - 1)

    else
        y + 1


rowEmpty : (s : Screen) -> (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (x : Int where 0 <= x) -> Bool
rowEmpty s o x =
    if x >= s.cols then
        True

    else if emptyCell (peekCell o x s) then
        rowEmpty s o (x + 1)

    else
        False


clearScrollback : (taken t : Term) -> Term
clearScrollback t =
    if isAlt t then
        t

    else
        let
            s =
                t.screen

            b =
                t.back
        in
        -- what the pages held goes with them, or every page pushed after
        -- would be taken as over the limit and dropped (§VC38)
        { t | screen = { s | hist = 0 }, back = { b | pages = Builder.empty 0, head = 0, bytes = 0, rows = 0 } }
