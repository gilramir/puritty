-- THE SCREEN


{-| The physical slot of logical row `y`, through the region's turn. -}
phys : (s : Screen) -> (y : Int where 0 - s.size <= y && y <= s.size) -> (r : Int where 0 <= r && r < s.size)
phys s y =
    if s.turn == 0 then
        slot s y

    else
        slot s (inRegion s y)


inRegion : (s : Screen) -> (y : Int where 0 - s.size <= y && y <= s.size) -> (r : Int where r == y || (0 <= r && r < s.rows))
inRegion s y =
    let
        v =
            y - s.top
    in
    if v >= 0 && v < s.height then
        let
            w =
                v + s.turn
        in
        if w >= s.height then
            s.top + w - s.height

        else
            s.top + w

    else
        y


{-| The region's rows put where its turn says they are, its turn 0. -}
settle : (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size && r.turn == 0)
settle s =
    if s.turn == 0 then
        s

    else
        let
            pt =
                slot s s.top

            pb =
                slot s (s.top + s.height - 1)
        in
        { s | cells = Builder.rotate (pt * s.stride) ((pb + 1) * s.stride) (s.turn * s.stride) s.cells, turn = 0 }


withRegion : (top : Int where 0 <= top && top <= bottom) -> (bottom : Int where bottom < s.rows) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
withRegion top bottom s =
    let
        settled =
            settle s
    in
    { settled | top = top, height = bottom - top + 1 }


{-| The physical slot of logical row `y` in the ring alone; a negative `y`
is scrollback in the ring, `-1` the newest. -}
slot : (s : Screen) -> (y : Int where 0 - s.size <= y && y <= s.size) -> (r : Int where 0 <= r && r < s.size)
slot s y =
    let
        p =
            s.base + y
    in
    if p >= s.size then
        p - s.size

    else if p < 0 then
        p + s.size

    else
        p


{-| The offset of logical row `y`'s first cell. -}
rowOffset : (s : Screen) -> (y : Int where 0 - s.hist <= y && y < s.rows) -> (r : Int where 0 <= r && r + s.stride <= Builder.length s.cells)
rowOffset s y =
    phys s y * s.stride


metaAt : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (s : Screen) -> Int64
metaAt o s =
    Maybe.withDefault 0 (Builder.get (o + s.cols) s.cells)


{-| The row's extent, at most its width: a row's meta slot never holds a
wider one, and the clamp says so to the compiler, so that a read below the
extent is a read inside the row (§VC57). -}
extentAt : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (s : Screen) -> (r : Int where 0 <= r && r <= s.cols)
extentAt o s =
    clamp 0 s.cols (metaExtent (metaAt o s))


cellAt : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (x : Int where 0 <= x && x < s.cols) -> (s : Screen) -> Int64
cellAt o x s =
    if x < extentAt o s then
        Maybe.withDefault 0 (Builder.get (o + x) s.cells)

    else
        0


{-| `cellAt` for the paths that are seldom taken: a function of its own so
that `cellAt` keeps the few callers clang inlines it into (§VC10's lesson). -}
peekCell : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (x : Int where 0 <= x && x < s.cols) -> (s : Screen) -> Int64
peekCell o x s =
    if x < extentAt o s then
        Maybe.withDefault 0 (Builder.get (o + x) s.cells)

    else
        0


{-| The row at `o`, about to be written from column `x`: the cells between
its extent `ext` and `x` are made empty. -}
reachAt : Int -> Int -> Int -> (taken cells : Builder Int64) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
reachAt o ext x cells =
    if x > ext then
        Builder.fill (o + ext) (o + x) 0 cells

    else
        cells


{-| The row at `o`'s extent made at least `x`, its wrapped flag kept. -}
extendTo : (o : Int where 0 <= o) -> (cols : Int where 0 <= cols) -> Int -> (taken cells : Builder Int64 where o + cols < Builder.length cells) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
extendTo o cols x cells =
    let
        m =
            Maybe.withDefault 0 (Builder.get (o + cols) cells)
    in
    if x > metaExtent m then
        Builder.set (o + cols) (Bitwise.or (Bitwise.and rowFlags m) (Int64.fromInt x)) cells

    else
        cells


setWrapped : (y : Int where 0 - s.hist <= y && y < s.rows) -> Bool -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
setWrapped y on s =
    let
        o =
            rowOffset s y + s.cols

        m =
            Maybe.withDefault 0 (Builder.get o s.cells)
    in
    { s
        | cells =
            Builder.set o
                (if on then
                    Bitwise.or wrappedBit m

                 else
                    Bitwise.and (Bitwise.complement wrappedBit) m
                )
                s.cells
    }


{-| Rows `top` to `bottom` move up one; a blank row comes in at the bottom,
in `fillCell`. With `keep`, the row that leaves joins the scrollback in the
ring; the caller has made room (`pageOut`). -}
screenUp : (keep : Bool) -> (top : Int where 0 <= top && top <= bottom) -> (bottom : Int where bottom < screen0.rows && (not keep || screen0.hist + screen0.rows < screen0.size)) -> Int64 -> (taken screen0 : Screen) -> (r : Screen where r.rows == screen0.rows && r.cols == screen0.cols && r.size == screen0.size)
screenUp keep top bottom fillCell screen0 =
    let
        screen =
            settle screen0

        last =
            screen.rows - 1

        whole =
            top == 0 && bottom == last
    in
    -- the caller has made room for a row kept (`pageOut`), as its
    -- refinement says
    if keep then
        if whole then
            { screen | base = phys screen 1, hist = screen.hist + 1 } |> clearRow last fillCell

        else
            { screen | base = phys screen 1, hist = screen.hist + 1 } |> downFrom last bottom |> clearRow bottom fillCell

    else if not whole && phys screen top <= phys screen bottom then
        turnRegion top bottom 1 screen |> clearRow bottom fillCell

    else if screen.hist > 0 then
        shiftUp top bottom screen |> clearRow bottom fillCell

    else if whole then
        rotate screen |> clearRow last fillCell

    else if top == 0 && last - bottom < bottom - top then
        rotate screen |> downFrom last bottom |> clearRow bottom fillCell

    else if bottom == last && top < bottom - top then
        rotate screen |> moveRows -1 0 top |> clearRow last fillCell

    else
        shiftUp top bottom screen |> clearRow bottom fillCell


turnRegion : (top : Int where 0 <= top && top <= bottom) -> (bottom : Int where bottom < s0.rows) -> Int -> (taken s0 : Screen) -> (r : Screen where r.rows == s0.rows && r.cols == s0.cols && r.hist == s0.hist && r.size == s0.size)
turnRegion top bottom by s0 =
    let
        s =
            settle s0

        pt =
            phys s top

        pb =
            phys s bottom
    in
    if by > 0 then
        { s | cells = Builder.copyWithin (pt * s.stride) ((pt + by) * s.stride) ((pb + 1) * s.stride) s.cells }

    else
        { s | cells = Builder.copyWithin ((pt - by) * s.stride) (pt * s.stride) ((pb + 1 + by) * s.stride) s.cells }


{-| Logical row `y` made blank: its extent 0, or, when `fillCell` has a
style (an erase in a background color), every cell `fillCell`. -}
clearRow : (y : Int where 0 - s.hist <= y && y < s.rows) -> Int64 -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
clearRow y fillCell s =
    let
        o =
            rowOffset s y
    in
    if fillCell == 0 then
        { s | cells = Builder.set (o + s.cols) 0 s.cells }

    else
        { s | cells = Builder.set (o + s.cols) (Int64.fromInt s.cols) (Builder.fill o (o + s.cols) fillCell s.cells) }


rotate : (taken s0 : Screen) -> (r : Screen where r.rows == s0.rows && r.cols == s0.cols && r.hist == s0.hist && r.size == s0.size)
rotate s0 =
    let
        s =
            settle s0
    in
    { s | base = phys s 1 }


downFrom : (i : Int where 0 - s.size <= i && i < s.size) -> (bottom : Int where 0 - s.size <= bottom && bottom < s.size) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
downFrom i bottom s =
    moveRows bottom (bottom + 1) (i - bottom) s


shiftUp : (i : Int where 0 - s.size <= i && i < s.size) -> (bottom : Int where 0 - s.size <= bottom && bottom < s.size) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
shiftUp i bottom s =
    moveRows (i + 1) i (bottom - i) s


shiftDown : (i : Int where 0 - s.size <= i && i < s.size) -> (top : Int where 0 - s.size <= top && top < s.size) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
shiftDown i top s =
    moveRows top (top + 1) (i - top) s


{-| `count` logical rows from `from` copied to start at `to`, each read
before it is overwritten, in at most three pieces cut at the ring's end. -}
moveRows : (from : Int where 0 - s0.size <= from && from + count <= s0.size) -> (to : Int where 0 - s0.size <= to && to + count <= s0.size) -> (count : Int) -> (taken s0 : Screen) -> (r : Screen where r.rows == s0.rows && r.cols == s0.cols && r.hist == s0.hist && r.size == s0.size)
moveRows from to count s0 =
    let
        s =
            settle s0
    in
    if count <= 0 then
        s

    else if to > from then
        let
            lastFrom =
                phys s (from + count - 1)

            lastTo =
                phys s (to + count - 1)

            run =
                min count (min (lastFrom + 1) (lastTo + 1))
        in
        moveRows from to (count - run) (copyRows (lastFrom + 1 - run) (lastTo + 1 - run) run s)

    else
        let
            pf =
                phys s from

            pt =
                phys s to

            run =
                min count (min (s.size - pf) (s.size - pt))
        in
        moveRows (from + run) (to + run) (count - run) (copyRows pf pt run s)


copyRows : Int -> Int -> Int -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
copyRows pf pt run s =
    { s | cells = Builder.copyWithin (pt * s.stride) (pf * s.stride) ((pf + run) * s.stride) s.cells }


blankRows : (from : Int where 0 - s.hist <= from) -> (to : Int where to <= s.rows) -> Int64 -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
blankRows from to fillCell s =
    if from >= to then
        s

    else
        blankRows (from + 1) to fillCell (clearRow from fillCell s)
