{-| The cursor, the margins, the origin and the tab stops, and the small
helpers the sections above share (`docs/vt-core.md` §VC45). -}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Int64
import Math
import UInt8
import Vt.Base64 as Base64
import Vt.Cell exposing (..)
import Vt.Dump exposing (..)
import Vt.Keys as Keys
import Vt.Pages exposing (..)
import Vt.Palette exposing (..)
import Vt.Reason as Reason
import Vt.Recut exposing (recut)
import Vt.Resize exposing (..)
import Vt.Screen exposing (..)
import Vt.Style exposing (..)
import Vt.Term exposing (..)
import Vt.Term as State
import Vt.Width as Width


{-| The set in slot `g` (G0 to G3): 0 ASCII, 1 DEC's special graphics, 2
British; `sets` holds two bits a slot. -}
slotSet : Int -> Term -> Int
slotSet g t =
    Bitwise.and 3 (Bitwise.shiftRightZfBy (2 * g) t.sets)


param : Int -> (default : Int where 0 <= default && default <= 65535) -> Array Int -> (r : Int where 0 <= r && r <= 65535 && (default < 1 || 1 <= r))
param k default params =
    when Array.get k params is
        Just 0 ->
            default

        Just v ->
            -- the parser keeps each to 0..65535 (`Vt.Parse.csi`), and 0 is
            -- the case above; an array's elements carry no refinement, so
            -- it is said again
            clamp 1 65535 v

        Nothing ->
            meant Reason.NotSet default


rowWrapped : (y : Int where 0 - s.hist <= y && y < s.rows) -> (s : Screen) -> Bool
rowWrapped y s =
    Bitwise.and wrappedBit (metaAt (rowOffset s y) s) /= 0


{-| Whether DECSLRM has narrowed the margins. Narrowed, printing takes the
general path and the scrolls, inserts and deletes work on the columns
between them (§VC13). -}
margined : Term -> Bool
margined t =
    t.left > 0 || t.right < t.cols - 1


{-| NEL's and LNM's CR, after the line feed, so that a cursor right of the
margins at the region's bottom does not scroll, as in Ghostty. -}
carriageReturn : (taken t : Term) -> Term
carriageReturn t =
    { t | x = crX t, wrapNext = False }


{-| LF takes `execute`'s path when LNM is set or a prompt or the input
lasts, which the ground state's tests in one field. -}
withLf : (taken t : Term) -> Term
withLf t =
    { t | lfSlow = t.newline || t.prompt /= 0 }


{-| Where CR takes the cursor: the left margin, or the first column from
left of it outside origin mode. -}
crX : (t : Term) -> (r : Int where 0 <= r && r <= t.left)
crX t =
    if t.left == 0 then
        0

    else if t.origin || t.x >= t.left then
        t.left

    else
        0


{-| The column printing wraps after, plus one: the right margin, or the
screen's last column from right of it. -}
rightEdge : (t : Term) -> (r : Int where 1 <= r && r <= t.cols)
rightEdge t =
    if t.x <= t.right then
        t.right + 1

    else
        t.cols


tabFloor : (t : Term) -> (r : Int where 0 <= r && r <= t.left)
tabFloor t =
    if t.origin then
        t.left

    else
        0


{-| The cursor's column as a report gives it: from the left margin in origin
mode. -}
reportX : Term -> Int
reportX t =
    if t.origin then
        max 0 (t.x - t.left)

    else
        t.x


{-| Rows `top` to `bottom`, between the margins, scrolled up `count`: SU,
DL, and IND at the region's bottom. -}
marginUp : Int -> (top : Int where 0 <= top && top <= bottom) -> (bottom : Int where bottom < t.rows) -> (taken t : Term) -> Term
marginUp count top bottom t =
    let
        n =
            min (max 1 count) (bottom - top + 1)
    in
    { t | screen = clearSpans (bottom - n + 1) bottom t.left t.right t.erase (copyUp (top + n) bottom n t.left t.right t.screen) }


{-| Rows `top` to `bottom`, between the margins, scrolled down `count`: SD,
IL, and RI at the region's top. -}
marginDown : Int -> (top : Int where 0 <= top && top <= bottom) -> (bottom : Int where bottom < t.rows) -> (taken t : Term) -> Term
marginDown count top bottom t =
    let
        n =
            min (max 1 count) (bottom - top + 1)
    in
    { t | screen = clearSpans top (top + n - 1) t.left t.right t.erase (copyDown (bottom - n) top n t.left t.right t.screen) }


{-| Rows `y` to `last`, each copied `n` rows up, between the columns. -}
copyUp : (y : Int where 0 - s.hist <= y - n) -> (last : Int where last < s.rows) -> (n : Int where 0 <= n) -> Int -> Int -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
copyUp y last n left right s =
    if y > last then
        s

    else
        copyUp (y + 1) last n left right (copySpan y (y - n) left right s)


{-| Rows `y` down to `first`, each copied `n` rows down. -}
copyDown : (y : Int where y + n < s.rows) -> (first : Int where 0 - s.hist <= first) -> (n : Int where 0 <= n) -> Int -> Int -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
copyDown y first n left right s =
    if y < first then
        s

    else
        copyDown (y - 1) first n left right (copySpan y (y + n) left right s)


clearSpans : (y : Int where 0 - s.hist <= y) -> (last : Int where last < s.rows) -> Int -> Int -> Int64 -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
clearSpans y last left right fill s =
    if y > last then
        s

    else
        clearSpans (y + 1) last left right fill (clearSpan y left right fill s)


{-| Columns `left` to `right` of row `src` copied to row `dst`; a wide
character the margins cut, in either row, goes. -}
copySpan : (src : Int where 0 - s0.hist <= src && src < s0.rows) -> (dst : Int where 0 - s0.hist <= dst && dst < s0.rows) -> Int -> Int -> (taken s0 : Screen) -> (r : Screen where r.rows == s0.rows && r.cols == s0.cols && r.hist == s0.hist && r.size == s0.size)
copySpan src dst left right s0 =
    let
        so =
            rowOffset s0 src

        dO =
            rowOffset s0 dst

        reach =
            min s0.cols (right + 2)

        s =
            widenTo dO reach (widenTo so reach s0)

        cut =
            shifted dO s.cols left right (shifted so s.cols left right s.cells)
    in
    trim dO (trim so { s | cells = Builder.copyWithin (dO + left) (so + left) (so + right + 1) cut })


clearSpan : (y : Int where 0 - s0.hist <= y && y < s0.rows) -> Int -> Int -> Int64 -> (taken s0 : Screen) -> (r : Screen where r.rows == s0.rows && r.cols == s0.cols && r.hist == s0.hist && r.size == s0.size)
clearSpan y left right fill s0 =
    let
        o =
            rowOffset s0 y

        s =
            widenTo o (min s0.cols (right + 2)) s0
    in
    trim o { s | cells = Builder.fill (o + left) (o + right + 1) fill (shifted o s.cols left right s.cells) }


{-| ICH between the margins: the cells from `x` to `right` move right, those
past `right` lost. -}
insertMargined : (o : Int where 0 <= o && o + s0.stride <= Builder.length s0.cells) -> (x : Int where 0 <= x && x <= 1000) -> (count : Int where 0 <= count && count <= 65535) -> (right : Int where 0 <= right && right <= 1000) -> Int64 -> (taken s0 : Screen) -> (r : Screen where r.rows == s0.rows && r.cols == s0.cols && r.hist == s0.hist && r.size == s0.size)
insertMargined o x count right erase s0 =
    let
        s =
            widen o s0

        n =
            min (max 1 count) (right - x + 1)

        cut =
            cutAt erase o s.cols (right + 1 - n) (cutAt erase o s.cols (right + 1) (cutAt erase o s.cols x s.cells))

        moved =
            if right + 1 - n > x then
                Builder.copyWithin (o + x + n) (o + x) (o + right + 1 - n) cut

            else
                cut
    in
    trim o { s | cells = Builder.fill (o + x) (o + x + n) erase moved }


{-| DCH between the margins: the cells past the deleted ones, to `right`,
move left, and the erase cell comes in at `right`. -}
deleteMargined : (o : Int where 0 <= o && o + s0.stride <= Builder.length s0.cells) -> (x : Int where 0 <= x && x <= 1000) -> (count : Int where 0 <= count && count <= 65535) -> (right : Int where 0 <= right && right <= 1000) -> Int64 -> (taken s0 : Screen) -> (r : Screen where r.rows == s0.rows && r.cols == s0.cols && r.hist == s0.hist && r.size == s0.size)
deleteMargined o x count right erase s0 =
    let
        s =
            widen o s0

        n =
            min (max 1 count) (right - x + 1)

        cut =
            cutAt erase o s.cols (right + 1) (cutAt erase o s.cols (x + n) (cutAt erase o s.cols x s.cells))

        moved =
            if x + n <= right then
                Builder.copyWithin (o + x) (o + x + n) (o + right + 1) cut

            else
                cut
    in
    trim o { s | cells = Builder.fill (o + right + 1 - n) (o + right + 1) erase moved }


{-| The row at `o` with every cell explicit: those past its extent made
empty and its extent the row's width, its wrapped flag kept. -}
widen : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
widen o s =
    let
        m =
            metaAt o s
    in
    { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and rowFlags m) (Int64.fromInt s.cols)) (reachAt o (metaExtent m) s.cols s.cells) }


{-| The row at `o` with every cell before column `x` explicit, as `widen`
makes it but only that far. A span between the margins reads its row only to
the column past the right margin, so it widens that far and not to the row's
width: a scroll inside narrow margins costs the margins' width a row, not the
screen's (§VC11's timeout). -}
widenTo : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> Int -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
widenTo o x s =
    let
        m =
            metaAt o s

        e =
            metaExtent m
    in
    if x > e then
        { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and rowFlags m) (Int64.fromInt x)) (Builder.fill (o + e) (o + x) 0 s.cells) }

    else
        s


{-| The row at `o`'s extent brought back to its last cell that is not
empty. -}
trim : (o : Int where 0 <= o && o + s.stride <= Builder.length s.cells) -> (taken s : Screen) -> (r : Screen where r.rows == s.rows && r.cols == s.cols && r.hist == s.hist && r.size == s.size)
trim o s =
    let
        m =
            metaAt o s
    in
    { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and rowFlags m) (Int64.fromInt (lastFilled o (clamp 0 s.cols (metaExtent m)) s.cells))) s.cells }


lastFilled : (o : Int where 0 <= o) -> (e : Int) -> (cells : Builder Int64 where o + e <= Builder.length cells) -> Int
lastFilled o e cells =
    if e <= 0 then
        0

    else if Maybe.withDefault 0 (Builder.get (o + e - 1) cells) == 0 then
        lastFilled o (e - 1) cells

    else
        e


{-| A row about to have columns `left` to `right` shifted, as Ghostty's
`rowWillBeShifted` readies it (§VC17): a wide character either margin cuts
loses its content, both halves narrow and in their style, and when the
margins reach the row's end or the first two columns, a spacer head at its
end is a narrow cell. -}
shifted : (o : Int where 0 <= o) -> (cols : Int where 1 <= cols && cols <= 1000) -> Int -> Int -> (taken cells : Builder Int64 where o + cols < Builder.length cells) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
shifted o cols left right cells =
    let
        last =
            Maybe.withDefault 0 (Builder.get (o + cols - 1) cells)

        ended =
            if (right == cols - 1 || left < 2) && cellWide last == spacerHead then
                Builder.set (o + cols - 1) (Bitwise.and (Bitwise.complement 0x600000) last) cells

            else
                cells
    in
    cutKeeping o cols (right + 1) (cutKeeping o cols left ended)


{-| `cutAt`, the halves keeping their style and protection. -}
cutKeeping : (o : Int where 0 <= o) -> (cols : Int where 1 <= cols) -> Int -> (taken cells : Builder Int64 where o + cols < Builder.length cells) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
cutKeeping o cols c cells =
    if c <= 0 || c >= cols then
        cells

    else
        let
            tail =
                Maybe.withDefault 0 (Builder.get (o + c) cells)

            head =
                Maybe.withDefault 0 (Builder.get (o + c - 1) cells)
        in
        if cellWide tail == wideTail then
            Builder.set (o + c - 1) (Bitwise.and (Bitwise.complement 0xFFFFFF) head) (Builder.set (o + c) (Bitwise.and (Bitwise.complement 0xFFFFFF) tail) cells)

        else
            cells


{-| A wide character that a boundary before column `c` cuts in two, both
halves made `fill`, the erase cell, as Ghostty clears them (§VC18). -}
cutAt : Int64 -> (o : Int where 0 <= o) -> (cols : Int where 1 <= cols) -> Int -> (taken cells : Builder Int64 where o + cols < Builder.length cells) -> (r : Builder Int64 where Builder.length r == Builder.length cells)
cutAt fill o cols c cells =
    if c <= 0 || c >= cols then
        cells

    else if cellWide (Maybe.withDefault 0 (Builder.get (o + c) cells)) == wideTail then
        Builder.set (o + c - 1) fill (Builder.set (o + c) fill cells)

    else
        cells


{-| The cursor's row as a report gives it: from the region's top in origin
mode. -}
reportY : Term -> Int
reportY t =
    if t.origin then
        max 0 (t.y - t.top)

    else
        t.y


{-| CUP: column `x`, row `y`, from the region's top in origin mode. -}
cursorTo : Int -> Int -> (taken t : Term) -> Term
cursorTo x y t =
    if t.origin then
        -- `clamp t.left t.right (x + t.left)`, written so that the sum
        -- cannot wrap
        { t | x = t.left + clamp 0 (t.right - t.left) x, y = t.top + clamp 0 (t.bottom - t.top) y, wrapNext = False }

    else
        { t | x = clamp 0 (t.cols - 1) x, y = clamp 0 (t.rows - 1) y, wrapNext = False }


{-| The cursor's column and row as CUP gives them, from the margins in
origin mode. -}
originX : (t : Term) -> (r : Int where 0 <= r && r < t.cols)
originX t =
    if t.origin then
        max 0 (t.x - t.left)

    else
        t.x


originY : (t : Term) -> (r : Int where 0 <= r && r < t.rows)
originY t =
    if t.origin then
        max 0 (t.y - t.top)

    else
        t.y


{-| How far up CUU goes: the region's top when the cursor is in it. -}
upperLimit : (t : Term) -> (r : Int where 0 <= r && r <= t.top)
upperLimit t =
    if t.y >= t.top then
        t.top

    else
        0


lowerLimit : (t : Term) -> (r : Int where 0 <= r && r < t.rows)
lowerLimit t =
    if t.y <= t.bottom then
        t.bottom

    else
        t.rows - 1


{-| DECRQM's answer for a mode the core keeps: 1 set, 2 reset. -}
of : Bool -> Int
of on =
    if on then
        1

    else
        2


{-| `plain` kept to what it says: GL is ASCII, autowrap is on and insert is
off, which is when the ground state's fast paths may write a run (§VC5).
Set wherever any of the four changes. -}
withPlain : (taken t : Term) -> Term
withPlain t =
    { t | plain = t.single < 0 && slotSet t.gl t == 0 && t.autowrap && not t.insert && not (margined t) && not t.statusLine }


nextTab : (x : Int where 0 <= x && x < t.cols) -> Int -> (t : Term) -> (r : Int where 0 <= r && r < t.cols)
nextTab x count t =
    if count <= 0 || x >= t.right then
        x

    else
        nextTab (stopAfter (x + 1) t) (count - 1) t


stopAfter : (x : Int where 0 <= x) -> (t : Term) -> (r : Int where 0 <= r && r < t.cols)
stopAfter x t =
    if x >= t.right then
        t.right

    else if Builder.get x t.tabs == Just 1 then
        x

    else
        stopAfter (x + 1) t


previousTab : (x : Int where 0 <= x && x < t.cols) -> Int -> (t : Term) -> (r : Int where 0 <= r && r < t.cols)
previousTab x count t =
    if count <= 0 || x <= tabFloor t then
        x

    else
        previousTab (stopBefore (x - 1) t) (count - 1) t


stopBefore : (x : Int where x < t.cols) -> (t : Term) -> (r : Int where 0 <= r && r < t.cols)
stopBefore x t =
    if x <= tabFloor t then
        tabFloor t

    else if Builder.get x t.tabs == Just 1 then
        x

    else
        stopBefore (x - 1) t


{-| CTC as Ghostty takes it (§VC17): 0 or nothing sets a stop at the
cursor, 2 clears it and 5 clears them all; anything else, or more than one
parameter, does nothing. -}
tabControl : Array Int -> (taken t : Term) -> Term
tabControl params t =
    if params == [] || params == [ 0 ] then
        { t | tabs = Builder.set t.x 1 t.tabs }

    else if params == [ 2 ] then
        clearTabs 0 t

    else if params == [ 5 ] then
        clearTabs 3 t

    else
        t


clearTabs : Int -> (taken t : Term) -> Term
clearTabs how t =
    if how == 0 then
        { t | tabs = Builder.set t.x 0 t.tabs }

    else if how == 3 then
        { t | tabs = Builder.fill 0 t.cols 0 t.tabs }

    else
        t
