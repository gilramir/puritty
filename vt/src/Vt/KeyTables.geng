{-| The code point a key stands for, 0 for none. -}
codepoint : Int -> Int
codepoint k =
    Maybe.withDefault 0 (Array.get k codepointTable)


{-| The kitty protocol's number for a key, 0 for a key it has no entry for. -}
kittyCode : Int -> Int
kittyCode k =
    Maybe.withDefault 0 (Array.get k kittyCodeTable)


{-| The final byte of a key's kitty sequence. -}
kittyFinal : Int -> Int
kittyFinal k =
    Maybe.withDefault 0 (Array.get k kittyFinalTable)


{-| 1 for a modifier key, which only `report all` sends. -}
kittyModifier : Int -> Int
kittyModifier k =
    Maybe.withDefault 0 (Array.get k kittyModifierTable)


{-| The key for an evdev code (an X keycode less 8), 0 for none. -}
evdevKey : Int -> Int
evdevKey k =
    Maybe.withDefault 0 (Array.get k evdevTable)

