module Vt exposing
    ( Term, Config, new, feed, takeReplies, resize
    , dump, historyBound
    )

{-| visiterm's headless terminal core (`docs/vt-core.md`).

A `Term` is fed the bytes a program writes to its terminal, a read at a
time, and holds the screen, the scrollback, the modes and the replies the
program asked for. Everything that happens to a terminal's state happens in
`feed`; nothing in it reads a clock or a file.

**The screen** is the builder probe's (`probes/geng/core/src/Hot.geng`,
`phase1-core.md` §14–§23): a ring of rows in one `Array.Builder Int64`,
`stride` slots a row, its `cols` cells and then its meta slot (the extent,
the column past which the row is blank, and the wrapped flag). Slot `p`'s
row starts at `p * stride`. `base` is the slot of row 0; on the main screen
the ring holds recent scrollback before it, and when the ring is full the
oldest `pageRows` rows of it are packed into a page (geng-lang D901). A
region keeps its own turn, so its line feed moves no rows. The cells past a
row's extent are never read.

**A cell** is an `Int64` (§VC2, V1): bits 0–20 its code point, or the id of
its grapheme cluster when bit 23 is set; bits 21–22 its width state (narrow,
wide, the wide cell's spacer, or a spacer at the end of a row a wide
character did not fit); bits 32–47 its style id. 0 is an empty cell in the
default style.

**The parser** is Paul Williams' DEC state machine, resumable at any byte: a
read may end anywhere and the next picks up from the state it left. In the
ground state a run of printable ASCII is written to its row at once.

-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Int64
import Math
import UInt8
import Vt.Width as Width


-- LIMITS


{-| Rows in a page of scrollback. -}
pageRows : Int
pageRows =
    256


{-| The bytes an OSC or DCS string keeps; the rest of a longer one is
dropped. -}
stringMax : Int
stringMax =
    4096


{-| The bytes after an OSC's number Ghostty keeps for the commands the core
takes (its parser's `MAX_BUF`); one longer is dropped whole (§VC18). -}
oscMax : Int
oscMax =
    2048


{-| Parameters a CSI may have; one with more is ignored, as Ghostty's
parser ignores it. -}
paramMax : Int
paramMax =
    24


{-| Code points a grapheme cluster keeps; a mark past them is dropped. -}
clusterMax : Int
clusterMax =
    32


{-| Style ids a terminal hands out (15 bits, since a page's run keeps its
top bit, §VC6); past them a new style is the default one (§VC9, an open
bound). -}
styleMax : Int
styleMax =
    32768


{-| Cluster ids a terminal hands out (21 bits). -}
clusterIdMax : Int
clusterIdMax =
    0x1FFFFF


-- CELLS


wideHead : Int
wideHead =
    0x200000


wideTail : Int
wideTail =
    0x400000


spacerHead : Int
spacerHead =
    0x600000


clusterBit : Int
clusterBit =
    0x800000


cellPoint : Int64 -> Int
cellPoint c =
    Int64.toIntWrap (Bitwise.and 0x1FFFFF c)


cellWide : Int64 -> Int
cellWide c =
    Int64.toIntWrap (Bitwise.and 0x600000 c)


cellIsCluster : Int64 -> Bool
cellIsCluster c =
    Bitwise.and 0x800000 c /= 0


cellStyle : Int64 -> Int
cellStyle c =
    Int64.toIntWrap (Bitwise.shiftRightZfBy 32 c)


{-| A style id as a cell's high bits. -}
styleBits : Int -> Int64
styleBits id =
    Bitwise.shiftLeftBy 32 (Int64.fromInt id)


{-| A row's meta slot: its extent in bits 0–15, bit 16 set when the row
wrapped into the next. -}
metaExtent : Int64 -> Int
metaExtent m =
    Int64.toIntWrap (Bitwise.and 0xFFFF m)


wrappedBit : Int64
wrappedBit =
    0x10000


{-| A protected cell (DECSCA, SPA): what DECSED and DECSEL, and in ISO's
mode ED, EL and ECH, leave as it is (§VC12). -}
protectBit : Int64
protectBit =
    0x1000000


{-| A cell in a background colour alone, as an erase leaves it: Ghostty's
`bg_color` cell, which a reflow keeps where it drops an empty cell in a
style (`emptyCell`, §VC17). Every non-zero erase cell carries it, and a
page writes such a cell as a 0xFE byte. -}
bgBit : Int64
bgBit =
    0x2000000


{-| A cell's style, without its content. -}
highMask : Int64
highMask =
    Bitwise.complement 0xFFFFFFFF


-- STYLES


{-| What SGR sets. A colour is 0 for the default, 1 to 256 for a palette
index and one more, or `0x1000000` and the RGB value. `flags`: bold 1, faint
2, italic 4, blink 8, inverse 16, invisible 32, strikethrough 64, overline
128. `ul` is the underline's kind, 0 for none. -}
type alias Attrs =
    { fg : Int
    , bg : Int
    , ulc : Int
    , flags : Int
    , ul : Int
    }


plainAttrs : Attrs
plainAttrs =
    { fg = 0, bg = 0, ulc = 0, flags = 0, ul = 0 }


{-| The styles in use, each an id. `ids` maps a style's key, everything but
its underline colour, to the ids with that key. -}
type alias Styles =
    { ids : Dict Int64 (Array Int)
    , table : Array Attrs
    }


noStyles : Styles
noStyles =
    { ids = Dict.set (styleKey plainAttrs) [ 0 ] Dict.empty
    , table = [ plainAttrs ]
    }


styleKey : Attrs -> Int64
styleKey a =
    Bitwise.or (Bitwise.shiftLeftBy 53 (Int64.fromInt a.flags))
        (Bitwise.or (Bitwise.shiftLeftBy 50 (Int64.fromInt a.ul))
            (Bitwise.or (Bitwise.shiftLeftBy 25 (Int64.fromInt a.fg)) (Int64.fromInt a.bg))
        )


intern : Attrs -> Styles -> { id : Int, styles : Styles }
intern a styles =
    let
        key =
            styleKey a

        same =
            Maybe.withDefault [] (Dict.get key styles.ids)

        found =
            Array.findFirst (\id -> (Maybe.withDefault plainAttrs (Array.get id styles.table)).ulc == a.ulc) same
    in
    when found is
        Just f ->
            { id = f.value, styles = styles }

        Nothing ->
            let
                id =
                    Array.length styles.table
            in
            if id >= styleMax then
                { id = 0, styles = styles }

            else
                { id = id
                , styles =
                    { ids = Dict.set key (Array.pushLast id same) styles.ids
                    , table = Array.pushLast a styles.table
                    }
                }


styleOf : Int -> Styles -> Attrs
styleOf id styles =
    Maybe.withDefault plainAttrs (Array.get id styles.table)


-- CLUSTERS


{-| Grapheme clusters, each an id: a cell whose code point is joined by
marks holds its cluster's id. A cluster of two code points, the commonest,
is found by both in one `Int64` (`pairs`), any other by its code points as
text (`ids`). -}
type alias Clusters =
    { pairs : Dict Int64 Int
    , ids : Dict String Int
    , table : Array (Array Int)
    }


noClusters : Clusters
noClusters =
    { pairs = Dict.empty, ids = Dict.empty, table = [] }


clusterKey : Array Int -> String
clusterKey points =
    String.join "," (Array.map String.fromInt points)


internCluster : Array Int -> Clusters -> Maybe { id : Int, clusters : Clusters }
internCluster points clusters =
    if Array.length points == 2 then
        let
            key =
                Bitwise.or (Bitwise.shiftLeftBy 21 (Int64.fromInt (Maybe.withDefault 0 (Array.get 0 points)))) (Int64.fromInt (Maybe.withDefault 0 (Array.get 1 points)))
        in
        when Dict.get key clusters.pairs is
            Just id ->
                Just { id = id, clusters = clusters }

            Nothing ->
                newCluster points (\id c -> { c | pairs = Dict.set key id c.pairs }) clusters

    else
        let
            key =
                clusterKey points
        in
        when Dict.get key clusters.ids is
            Just id ->
                Just { id = id, clusters = clusters }

            Nothing ->
                newCluster points (\id c -> { c | ids = Dict.set key id c.ids }) clusters


newCluster : Array Int -> (Int -> Clusters -> Clusters) -> Clusters -> Maybe { id : Int, clusters : Clusters }
newCluster points index clusters =
    let
        id =
            Array.length clusters.table
    in
    if id >= clusterIdMax then
        Nothing

    else
        Just { id = id, clusters = index id { clusters | table = Array.pushLast points clusters.table } }


{-| A cell's code points: its own, or its cluster's. -}
cellPoints : Int64 -> Clusters -> Array Int
cellPoints c clusters =
    if cellIsCluster c then
        Maybe.withDefault [] (Array.get (cellPoint c) clusters.table)

    else if cellPoint c == 0 then
        []

    else
        [ cellPoint c ]


-- THE STATE


{-| `checksums` turns on DECRQCRA's answer (§VC10). It is off unless asked
for, as Ghostty's is, since a program can checksum the screen a cell at a
time and so read everything on it, other programs' output among it. -}
type alias Config =
    { cols : Int
    , rows : Int
    , scrollback : Int
    , checksums : Bool
    }


{-| A page of scrollback, and the width its rows were cut at: a resize
leaves a page as it is and its rows are reflowed when read (V10, §VC14). -}
type alias Page =
    { text : Bytes, heads : Bytes, runs : Bytes, cols : Int }


type alias Back =
    { pages : Builder Page
    , head : Int
    , limit : Int
    }


{-| What DECSC saves. -}
type alias Saved =
    { x : Int
    , y : Int
    , attrs : Attrs
    , wrapNext : Bool
    , origin : Bool
    , sets : Int
    , gl : Int
    , single : Int
    , guard : Int64
    , isSet : Bool
    }


{-| At least as many rows as the scrollback holds at the terminal's width:
the ring's, and each page's times as many rows as one of its rows can become
(V10 leaves a page at the width it was cut at). For the differential fuzzer,
which compares the scrollback only while it has never reached its limit,
where the core and Ghostty prune it differently (§VC17); reading the pages
would cost a reflow each time. -}
historyBound : Term -> Int
historyBound t =
    let
        ring =
            if t.alt then
                when t.other is
                    Just main ->
                        main.hist

                    Nothing ->
                        0

            else
                t.screen.hist
    in
    Array.foldl (\p n -> n + (Bytes.length p.heads // 2) * max 1 ((p.cols + t.cols - 1) // t.cols)) ring (pagesOf t.back)


{-| The kitty keyboard protocol's flags, a stack of eight that wraps, as
Ghostty keeps one for each screen (§VC17). The core reports them and
encodes no key with them yet: keys are phase 2's. -}
type alias Keys =
    { stack : Array Int, at : Int }


noKeys : Keys
noKeys =
    { stack = [ 0, 0, 0, 0, 0, 0, 0, 0 ], at = 0 }


{-| CSI ? u, > u, < u and = u, as Ghostty takes them: a push of a value
over 31, or a set of one, does nothing; a pop of eight or more empties the
stack; `=`'s second parameter sets (1), adds (2) or clears (3) the flags. -}
keyFlags : Int -> Array Int -> (moved t : Term) -> Term
keyFlags priv params t =
    let
        k =
            t.keys

        top =
            Maybe.withDefault 0 (Array.get k.at k.stack)

        first =
            Maybe.withDefault 0 (Array.get 0 params)
    in
    if priv == 0x3F then
        reply ("\u{001B}[?" ++ String.fromInt top ++ "u") t

    else if priv == 0x3E then
        let
            flags =
                if Array.length params == 1 then
                    first

                else
                    0

            at =
                modBy 8 (k.at + 1)
        in
        if flags > 31 then
            t

        else
            { t | keys = { stack = Array.set at flags k.stack, at = at } }

    else if priv == 0x3C then
        let
            count =
                if Array.length params == 1 then
                    first

                else
                    1
        in
        if count >= 8 then
            { t | keys = noKeys }

        else
            { t | keys = popKeys count k }

    else
        let
            flags =
                if Array.length params >= 1 then
                    first

                else
                    0

            how =
                Maybe.withDefault 1 (Array.get 1 params)

            set =
                if how == 1 then
                    flags

                else if how == 2 then
                    Bitwise.or top flags

                else
                    Bitwise.and top (Bitwise.complement flags)
        in
        if flags > 31 || how < 1 || how > 3 then
            t

        else
            { t | keys = { k | stack = Array.set k.at set k.stack } }


popKeys : Int -> Keys -> Keys
popKeys n k =
    if n <= 0 then
        k

    else
        popKeys (n - 1) { stack = Array.set k.at 0 k.stack, at = modBy 8 (k.at - 1) }


{-| No cursor saved: DECRC goes home with the defaults. -}
noSaved : Saved
noSaved =
    { x = 0, y = 0, attrs = plainAttrs, wrapNext = False, origin = False, sets = 0, gl = 0, single = -1, guard = 0, isSet = False }


{-| A ring of `size` rows, `stride` slots each, in one builder: the screen's
`rows` rows from physical slot `base` on, the `hist` rows of scrollback not
yet packed into a page just before it, oldest first, and free rows after
it. The region, `top` and `height`, keeps its own `turn`. -}
type alias Screen =
    { cells : Builder Int64
    , cols : Int
    , rows : Int
    , stride : Int
    , base : Int
    , hist : Int
    , size : Int
    , top : Int
    , height : Int
    , turn : Int
    , saved : Saved
    }


type alias Term =
    { screen : Screen
    , other : Maybe Screen
    , hidden : { x : Int, y : Int, wrap : Bool }
    , keys : Keys
    , otherKeys : Keys
    , otherProtect : Int
    , heads : Bool
    , alt : Bool
    , config : Config
    , cols : Int
    , rows : Int
    , x : Int
    , y : Int
    , wrapNext : Bool
    , top : Int
    , bottom : Int
    , left : Int
    , right : Int
    , scroll : Int
    , attrs : Attrs
    , pen : Int64
    , erase : Int64
    , styles : Styles
    , styleCache : Builder Int64
    , clusters : Clusters
    , back : Back
    , tabs : Builder Int
    , autowrap : Bool
    , plain : Bool
    , origin : Bool
    , insert : Bool
    , showCursor : Bool
    , newline : Bool
    , modes : Dict Int Bool
    , savedModes : Dict Int Bool
    , sets : Int
    , gl : Int
    , single : Int
    , guard : Int64
    , protectMode : Int
    , lastPoint : Int
    , title : String
    , colours : Dict Int Int
    , cursorShape : Int
    , ps : Int
    , params : Array Int
    , cur : Int
    , colons : Int
    , priv : Int
    , inter : Int
    , phase : Int
    , str : Builder UInt8
    , utf : Int
    , need : Int
    , low : Int
    , high : Int
    , replies : Array Bytes
    , xtChecksum : Int
    }


{-| The parser's states. -}
psGround : Int
psGround =
    0


psEscape : Int
psEscape =
    1


psEscInter : Int
psEscInter =
    2


psCsi : Int
psCsi =
    3


psCsiIgnore : Int
psCsiIgnore =
    4


psUtf8 : Int
psUtf8 =
    5


psOsc : Int
psOsc =
    6


psDcs : Int
psDcs =
    7


psString : Int
psString =
    8


new : Config -> Term
new config0 =
    let
        config =
            { cols = clamp 1 1000 config0.cols
            , rows = clamp 1 1000 config0.rows
            , scrollback = max 0 config0.scrollback
            , checksums = config0.checksums
            }
    in
    withScroll (fresh config)


fresh : Config -> Term
fresh config =
    let
        limit =
            (config.scrollback + pageRows - 1) // pageRows
    in
    { screen = newScreen config.cols config.rows (config.rows + 2 * pageRows + 1)
    , other = Nothing
    , hidden = { x = 0, y = 0, wrap = False }
    , keys = noKeys
    , otherKeys = noKeys
    , otherProtect = 0
    , heads = False
    , alt = False
    , config = config
    , cols = config.cols
    , rows = config.rows
    , x = 0
    , y = 0
    , wrapNext = False
    , top = 0
    , bottom = config.rows - 1
    , left = 0
    , right = config.cols - 1
    , scroll = scrollFull
    , attrs = plainAttrs
    , pen = 0
    , erase = 0
    , styles = noStyles
    , styleCache = Builder.fromArray (Array.repeat (2 * styleCacheSize) -1)
    , clusters = noClusters
    , back = { pages = Builder.empty 0, head = 0, limit = limit }
    , tabs = Builder.fromArray (Array.initialize config.cols 0 (\i -> if modBy 8 i == 0 && i > 0 then 1 else 0))
    , autowrap = True
    , plain = True
    , origin = False
    , insert = False
    , showCursor = True
    , newline = False
    , modes = Dict.empty
    , savedModes = Dict.empty
    , sets = 0
    , gl = 0
    , single = -1
    , guard = 0
    , protectMode = 0
    , lastPoint = 0
    , title = ""
    , colours = Dict.empty
    , cursorShape = 1
    , ps = psGround
    , params = []
    , cur = 0
    , colons = 0
    , priv = 0
    , inter = 0
    , phase = 0
    , str = Builder.empty 0
    , utf = 0
    , need = 0
    , low = 0x80
    , high = 0xBF
    , xtChecksum = 23
    , replies = []
    }


newScreen : Int -> Int -> Int -> Screen
newScreen cols rows size =
    { cells = Builder.fromArray (Array.repeat (size * (cols + 1)) 0)
    , cols = cols
    , rows = rows
    , stride = cols + 1
    , base = 0
    , hist = 0
    , size = size
    , top = 0
    , height = rows
    , turn = 0
    , saved = noSaved
    }


{-| The replies the terminal has to write back to the program, oldest
first, taken out. -}
takeReplies : (moved t : Term) -> { term : Term, replies : Array Bytes }
takeReplies t =
    let
        replies =
            t.replies
    in
    { term = { t | replies = [] }, replies = replies }


reply : String -> (moved t : Term) -> Term
reply text t =
    { t | replies = Array.pushLast (Bytes.fromString text) t.replies }


-- THE SCREEN


{-| The physical slot of logical row `y`, through the region's turn. -}
phys : Screen -> Int -> Int
phys s y =
    if s.turn == 0 then
        slot s y

    else
        slot s (inRegion s y)


inRegion : Screen -> Int -> Int
inRegion s y =
    let
        v =
            y - s.top
    in
    if v >= 0 && v < s.height then
        let
            w =
                v + s.turn
        in
        if w >= s.height then
            s.top + w - s.height

        else
            s.top + w

    else
        y


{-| The region's rows put where its turn says they are, its turn 0. -}
settle : (moved s : Screen) -> Screen
settle s =
    if s.turn == 0 then
        s

    else
        let
            pt =
                slot s s.top

            pb =
                slot s (s.top + s.height - 1)
        in
        { s | cells = Builder.rotate (pt * s.stride) ((pb + 1) * s.stride) (s.turn * s.stride) s.cells, turn = 0 }


withRegion : Int -> Int -> (moved s : Screen) -> Screen
withRegion top bottom s =
    let
        settled =
            settle s
    in
    { settled | top = top, height = bottom - top + 1 }


{-| The physical slot of logical row `y` in the ring alone; a negative `y`
is scrollback in the ring, `-1` the newest. -}
slot : Screen -> Int -> Int
slot s y =
    let
        p =
            s.base + y
    in
    if p >= s.size then
        p - s.size

    else if p < 0 then
        p + s.size

    else
        p


{-| The offset of logical row `y`'s first cell. -}
rowOffset : Screen -> Int -> Int
rowOffset s y =
    phys s y * s.stride


metaAt : Int -> Screen -> Int64
metaAt o s =
    Maybe.withDefault 0 (Builder.get (o + s.cols) s.cells)


extentAt : Int -> Screen -> Int
extentAt o s =
    metaExtent (metaAt o s)


cellAt : Int -> Int -> Screen -> Int64
cellAt o x s =
    if x < extentAt o s then
        Maybe.withDefault 0 (Builder.get (o + x) s.cells)

    else
        0


{-| `cellAt` for the paths that are seldom taken: a function of its own so
that `cellAt` keeps the few callers clang inlines it into (§VC10's lesson). -}
peekCell : Int -> Int -> Screen -> Int64
peekCell o x s =
    if x < extentAt o s then
        Maybe.withDefault 0 (Builder.get (o + x) s.cells)

    else
        0


{-| The row at `o`, about to be written from column `x`: the cells between
its extent `ext` and `x` are made empty. -}
reachAt : Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
reachAt o ext x cells =
    if x > ext then
        Builder.fill (o + ext) (o + x) 0 cells

    else
        cells


{-| The row at `o`'s extent made at least `x`, its wrapped flag kept. -}
extendTo : Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
extendTo o cols x cells =
    let
        m =
            Maybe.withDefault 0 (Builder.get (o + cols) cells)
    in
    if x > metaExtent m then
        Builder.set (o + cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt x)) cells

    else
        cells


setWrapped : Int -> Bool -> (moved s : Screen) -> Screen
setWrapped y on s =
    let
        o =
            rowOffset s y + s.cols

        m =
            Maybe.withDefault 0 (Builder.get o s.cells)
    in
    { s
        | cells =
            Builder.set o
                (if on then
                    Bitwise.or wrappedBit m

                 else
                    Bitwise.and 0xFFFF m
                )
                s.cells
    }


{-| Rows `top` to `bottom` move up one; a blank row comes in at the bottom,
in `fillCell`. With `keep`, the row that leaves joins the scrollback in the
ring; the caller has made room (`pageOut`). -}
screenUp : Bool -> Int -> Int -> Int64 -> (moved screen0 : Screen) -> Screen
screenUp keep top bottom fillCell screen0 =
    let
        screen =
            settle screen0

        last =
            screen.rows - 1

        whole =
            top == 0 && bottom == last
    in
    if keep then
        if whole then
            { screen | base = phys screen 1, hist = screen.hist + 1 } |> clearRow last fillCell

        else
            { screen | base = phys screen 1, hist = screen.hist + 1 } |> downFrom last bottom |> clearRow bottom fillCell

    else if not whole && phys screen top <= phys screen bottom then
        turnRegion top bottom 1 screen |> clearRow bottom fillCell

    else if screen.hist > 0 then
        shiftUp top bottom screen |> clearRow bottom fillCell

    else if whole then
        rotate screen |> clearRow last fillCell

    else if top == 0 && last - bottom < bottom - top then
        rotate screen |> downFrom last bottom |> clearRow bottom fillCell

    else if bottom == last && top < bottom - top then
        rotate screen |> moveRows -1 0 top |> clearRow last fillCell

    else
        shiftUp top bottom screen |> clearRow bottom fillCell


turnRegion : Int -> Int -> Int -> (moved s0 : Screen) -> Screen
turnRegion top bottom by s0 =
    let
        s =
            settle s0

        pt =
            phys s top

        pb =
            phys s bottom
    in
    if by > 0 then
        { s | cells = Builder.copyWithin (pt * s.stride) ((pt + by) * s.stride) ((pb + 1) * s.stride) s.cells }

    else
        { s | cells = Builder.copyWithin ((pt - by) * s.stride) (pt * s.stride) ((pb + 1 + by) * s.stride) s.cells }


{-| Logical row `y` made blank: its extent 0, or, when `fillCell` has a
style (an erase in a background colour), every cell `fillCell`. -}
clearRow : Int -> Int64 -> (moved s : Screen) -> Screen
clearRow y fillCell s =
    let
        o =
            rowOffset s y
    in
    if fillCell == 0 then
        { s | cells = Builder.set (o + s.cols) 0 s.cells }

    else
        { s | cells = Builder.set (o + s.cols) (Int64.fromInt s.cols) (Builder.fill o (o + s.cols) fillCell s.cells) }


rotate : (moved s0 : Screen) -> Screen
rotate s0 =
    let
        s =
            settle s0
    in
    { s | base = phys s 1 }


downFrom : Int -> Int -> (moved s : Screen) -> Screen
downFrom i bottom s =
    moveRows bottom (bottom + 1) (i - bottom) s


shiftUp : Int -> Int -> (moved s : Screen) -> Screen
shiftUp i bottom s =
    moveRows (i + 1) i (bottom - i) s


shiftDown : Int -> Int -> (moved s : Screen) -> Screen
shiftDown i top s =
    moveRows top (top + 1) (i - top) s


{-| `count` logical rows from `from` copied to start at `to`, each read
before it is overwritten, in at most three pieces cut at the ring's end. -}
moveRows : Int -> Int -> Int -> (moved s0 : Screen) -> Screen
moveRows from to count s0 =
    let
        s =
            settle s0
    in
    if count <= 0 then
        s

    else if to > from then
        let
            lastFrom =
                phys s (from + count - 1)

            lastTo =
                phys s (to + count - 1)

            run =
                min count (min (lastFrom + 1) (lastTo + 1))
        in
        moveRows from to (count - run) (copyRows (lastFrom + 1 - run) (lastTo + 1 - run) run s)

    else
        let
            pf =
                phys s from

            pt =
                phys s to

            run =
                min count (min (s.size - pf) (s.size - pt))
        in
        moveRows (from + run) (to + run) (count - run) (copyRows pf pt run s)


copyRows : Int -> Int -> Int -> (moved s : Screen) -> Screen
copyRows pf pt run s =
    { s | cells = Builder.copyWithin (pt * s.stride) (pf * s.stride) ((pf + run) * s.stride) s.cells }


blankRows : Int -> Int -> Int64 -> (moved s : Screen) -> Screen
blankRows from to fillCell s =
    if from >= to then
        s

    else
        blankRows (from + 1) to fillCell (clearRow from fillCell s)


-- THE SCROLLBACK


{-| The oldest `pageRows` rows of the ring's scrollback packed into a page
(geng-lang D901): each row's text as UTF-8 and its header and style runs
(§VC6). Their slots stay where they are, the free part of the ring now. -}
pageOut : Clusters -> (moved s : Screen) -> (moved back : Back) -> { screen : Screen, back : Back }
pageOut clusters s back =
    let
        first =
            phys s (0 - s.hist)

        firstStop =
            min s.size (first + pageRows)

        rest =
            pageRows - (firstStop - first)

        older =
            packRows clusters first firstStop s (Builder.empty (pageRows * 8)) (Builder.empty (pageRows * 2)) (Builder.empty (pageRows * 4))

        both =
            packRows clusters 0 rest s older.text older.heads older.runs

        page =
            { text = Bytes.fromUInt8s (Builder.toArray both.text)
            , heads = Bytes.fromUInt8s (Builder.toArray both.heads)
            , runs = Bytes.fromUInt8s (Builder.toArray both.runs)
            , cols = s.cols
            }
    in
    { screen = { s | hist = s.hist - pageRows }, back = pushPage page back }


packRows : Clusters -> Int -> Int -> Screen -> (moved text : Builder UInt8) -> (moved heads : Builder UInt8) -> (moved runs : Builder UInt8) -> { text : Builder UInt8, heads : Builder UInt8, runs : Builder UInt8 }
packRows clusters p stop s text heads runs =
    if p >= stop then
        { text = text, heads = heads, runs = runs }

    else
        let
            o =
                p * s.stride

            m =
                Maybe.withDefault 0 (Builder.get (o + s.cols) s.cells)

            ext =
                metaExtent m

            row =
                packCells clusters o (o + ext) s text runs 0 0 False

            header =
                Bitwise.or ext
                    (Bitwise.or
                        (if Bitwise.and wrappedBit m /= 0 then
                            0x8000

                         else
                            0
                        )
                        (if row.styled then
                            0

                         else
                            0x4000
                        )
                    )
        in
        packRows clusters (p + 1) stop s row.text (Builder.pushLast (UInt8.fromInt (Bitwise.shiftRightZfBy 8 header)) (Builder.pushLast (UInt8.fromInt (Bitwise.and 0xFF header)) heads)) row.runs


{-| A row's cells from `i` to `stop` packed: their text, and their style
runs after the row's header (§VC6). `wrote` says a run has been written;
the run in hand, `count` cells of `style`, is written when the style changes
or the row ends, the last without its count. A row all in the default style
writes no run (`styled` is false). -}
packCells : Clusters -> Int -> Int -> Screen -> (moved text : Builder UInt8) -> (moved runs : Builder UInt8) -> Int -> Int -> Bool -> { text : Builder UInt8, runs : Builder UInt8, styled : Bool }
packCells clusters i stop s text runs style count wrote =
    if i >= stop then
        if count == 0 || (style == 0 && not wrote) then
            { text = text, runs = runs, styled = False }

        else
            { text = text, runs = pushU16 style runs, styled = True }

    else
        let
            c =
                Maybe.withDefault 0 (Builder.get i s.cells)

            st =
                cellStyle c

            -- one test for a plain cell, the commonest
            packed =
                if Bitwise.and packSpecial c == 0 then
                    pushUtf8 (cellPoint c) text

                else
                    packOther clusters c text
        in
        if count > 0 && st == style then
            packCells clusters (i + 1) stop s packed runs style (count + 1) wrote

        else if count > 0 then
            packCells clusters (i + 1) stop s packed (pushU16 count (pushU16 (Bitwise.or 0x8000 style) runs)) st 1 True

        else
            packCells clusters (i + 1) stop s packed runs st 1 wrote


{-| The bits that make a cell more than its code point to `packCells`: its
width and a cluster (0xE00000), a background colour alone (`bgBit`) and
protection (`protectBit`). The compiler folds it into a literal (geng-lang
D1023); before, it was a value computed on first use and cost 17
instructions a cell here (§VC19). -}
packSpecial : Int64
packSpecial =
    Bitwise.or 0xE00000 (Bitwise.or bgBit protectBit)


{-| A cell with a `packSpecial` bit packed: a wide character's spacer as
nothing, a cluster as its code points, a spacer head as 0xFF, a cell in a
background colour alone as 0xFE, and a protected cell's text followed by
0xFD, which UTF-8 never has either (§VC19). -}
packOther : Clusters -> Int64 -> (moved text : Builder UInt8) -> Builder UInt8
packOther clusters c text =
    let
        w =
            cellWide c

        next =
            if w == wideTail then
                text

            else if cellIsCluster c then
                Array.foldl pushUtf8 text (cellPoints c clusters)

            else if w == spacerHead then
                Builder.pushLast (UInt8.fromInt 0xFF) text

            else if Bitwise.and bgBit c /= 0 then
                Builder.pushLast (UInt8.fromInt 0xFE) text

            else
                pushUtf8 (cellPoint c) text
    in
    if Bitwise.and protectBit c /= 0 && w /= wideTail then
        Builder.pushLast (UInt8.fromInt 0xFD) next

    else
        next


pushU16 : Int -> (moved b : Builder UInt8) -> Builder UInt8
pushU16 v b =
    Builder.pushLast (UInt8.fromInt (Bitwise.shiftRightZfBy 8 v)) (Builder.pushLast (UInt8.fromInt (Bitwise.and 0xFF v)) b)


{-| A cell's code point as UTF-8; an empty cell is a 0 byte, a spacer head
0xFF (`packCells`). A value no
scalar value is would be U+FFFD, but the decoder never makes one. -}
pushUtf8 : Int -> (moved b : Builder UInt8) -> Builder UInt8
pushUtf8 cp b =
    if cp < 0x80 then
        Builder.pushLast (UInt8.fromInt cp) b

    else if cp < 0x800 then
        b
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0xC0 (Bitwise.shiftRightZfBy 6 cp)))
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0x80 (Bitwise.and 0x3F cp)))

    else if cp < 0x10000 then
        b
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0xE0 (Bitwise.shiftRightZfBy 12 cp)))
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 6 cp))))
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0x80 (Bitwise.and 0x3F cp)))

    else
        b
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0xF0 (Bitwise.shiftRightZfBy 18 cp)))
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 12 cp))))
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 6 cp))))
            |> Builder.pushLast (UInt8.fromInt (Bitwise.or 0x80 (Bitwise.and 0x3F cp)))


pushPage : Page -> (moved back : Back) -> Back
pushPage page back =
    if back.limit == 0 then
        back

    else if Builder.length back.pages < back.limit then
        { back | pages = Builder.pushLast page back.pages }

    else
        { back
            | pages = Builder.set back.head page back.pages
            , head = modBy back.limit (back.head + 1)
        }


-- READING BYTES


byteAt : Bytes -> Int -> Int
byteAt bytes i =
    when Bytes.get i bytes is
        Just b ->
            UInt8.toInt b

        Nothing ->
            -1


{-| The index of the first byte at or after `i` that is not printable ASCII,
or `stop`. -}
asciiEnd : Bytes -> Int -> Int -> Int
asciiEnd bytes stop i =
    if i < stop then
        let
            b =
                byteAt bytes i
        in
        if b >= 0x20 && b < 0x7F then
            asciiEnd bytes stop (i + 1)

        else
            i

    else
        i


-- THE PARSER


{-| The terminal fed one read's bytes. -}
feed : Bytes -> (moved t : Term) -> Term
feed bytes t =
    let
        n =
            Bytes.length bytes
    in
    if t.ps == psGround then
        resume bytes n 0 t

    else if t.ps == psEscape then
        escape bytes n 0 { t | ps = psGround }

    else if t.ps == psEscInter then
        escInter bytes n 0 { t | ps = psGround }

    else if t.ps == psCsi then
        let
            params =
                t.params
        in
        csi bytes n 0 { t | ps = psGround, params = [] } (Builder.fromArray params) t.cur t.colons t.priv t.inter t.phase

    else if t.ps == psCsiIgnore then
        csiIgnore bytes n 0 { t | ps = psGround }

    else if t.ps == psUtf8 then
        continueUtf8 bytes n 0 { t | ps = psGround }

    else if t.ps == psOsc then
        oscString bytes n 0 { t | ps = psGround }

    else if t.ps == psDcs then
        dcsString bytes n 0 { t | ps = psGround }

    else
        ignoreString bytes n 0 { t | ps = psGround }


ground : Bytes -> Int -> Int -> (moved t : Term) -> Term
ground bytes n i t =
    if i >= n then
        t

    else
        let
            b =
                byteAt bytes i
        in
        if b >= 0x20 && b < 0x7F then
            if t.plain then
                printAscii bytes n i b t

            else
                ground bytes n (i + 1) (printPoint (graphic t b) 1 (unshift t))

        else if b >= 0x80 then
            if t.plain && not t.wrapNext then
                printUnicode bytes n i b t

            else
                startUtf8 bytes n i b t

        else if b == 13 then
            -- CR and LF here, not through `execute`, as the probe had them
            ground bytes n (i + 1) { t | x = 0, wrapNext = False }

        else if b == 10 && not t.newline then
            ground bytes n (i + 1) (lineFeed { t | wrapNext = False })

        else if b == 0x1B then
            escape bytes n (i + 1) t

        else
            ground bytes n (i + 1) (execute b t)


{-| Back to the ground state after a sequence, a string or a decoded
character: `ground`, which takes CR to column 0, or with the margins
narrowed `groundMargined`. The margins change only inside a sequence, so the
test is made once a sequence, not at every CR, which on `vte-scrolling` cost
a cycle a line, 4% of its time (§VC13). -}
resume : Bytes -> Int -> Int -> (moved t : Term) -> Term
resume bytes n i t =
    if t.left == 0 && t.right == t.cols - 1 then
        ground bytes n i t

    else
        groundMargined bytes n i t


{-| The ground state with the margins narrowed: no fast paths, which
`plain` turns off anyway, and CR to the left margin. -}
groundMargined : Bytes -> Int -> Int -> (moved t : Term) -> Term
groundMargined bytes n i t =
    if i >= n then
        t

    else
        let
            b =
                byteAt bytes i
        in
        if b >= 0x20 && b < 0x7F then
            groundMargined bytes n (i + 1) (printPoint (graphic t b) 1 (unshift t))

        else if b >= 0x80 then
            startUtf8 bytes n i b t

        else if b == 13 then
            groundMargined bytes n (i + 1) { t | x = crX t, wrapNext = False }

        else if b == 0x1B then
            escape bytes n (i + 1) t

        else
            groundMargined bytes n (i + 1) (execute b t)


{-| A C0 control. -}
execute : Int -> (moved t : Term) -> Term
execute b t =
    if b == 10 || b == 11 || b == 12 then
        if t.newline then
            carriageReturn (lineFeed { t | wrapNext = False })

        else
            lineFeed { t | wrapNext = False }

    else if b == 13 then
        { t | x = crX t, wrapNext = False }

    else if b == 8 then
        cursorLeft 1 t

    else if b == 9 then
        { t | x = nextTab t.x 1 t }

    else if b == 14 then
        withPlain { t | gl = 1 }

    else if b == 15 then
        withPlain { t | gl = 0 }

    else
        t


{-| The ASCII byte `b` through the character set GL holds, or the one a
single shift names: DEC's special graphics set maps `` ` `` to `~` to
line-drawing characters, and the British set `#` to `£`. The sets are
Ghostty's, `_` left as it is (§VC17). -}
graphic : Term -> Int -> Int
graphic t b =
    let
        set =
            if t.single >= 0 then
                slotSet t.single t

            else
                slotSet t.gl t
    in
    if set == 1 && b >= 0x60 && b <= 0x7E then
        Maybe.withDefault b (Array.get (b - 0x60) decGraphics)

    else if set == 2 && b == 0x23 then
        0xA3

    else
        b


{-| The set in slot `g` (G0 to G3): 0 ASCII, 1 DEC's special graphics, 2
British; `sets` holds two bits a slot. -}
slotSet : Int -> Term -> Int
slotSet g t =
    Bitwise.and 3 (Bitwise.shiftRightZfBy (2 * g) t.sets)


{-| A character printed uses up a single shift, a mark that joins the cell
before as well, as in Ghostty. -}
unshift : (moved t : Term) -> Term
unshift t =
    if t.single >= 0 then
        withPlain { t | single = -1 }

    else
        t


decGraphics : Array Int
decGraphics =
    [ 0x25C6, 0x2592, 0x2409, 0x240C, 0x240D, 0x240A, 0xB0, 0xB1, 0x2424, 0x240B, 0x2518, 0x2510, 0x250C, 0x2514, 0x253C, 0x23BA, 0x23BB, 0x2500, 0x23BC, 0x23BD, 0x251C, 0x2524, 0x2534, 0x252C, 0x2502, 0x2264, 0x2265, 0x03C0, 0x2260, 0xA3, 0xB7 ]


{-| Wrap first if the last write left the cursor past the end. -}
wrapped : (moved t : Term) -> Term
wrapped t =
    if t.wrapNext && t.autowrap then
        wrapNow t

    else
        t


{-| A pending wrap taken: the row marked wrapped and a line feed, the cursor
at the left margin. The row is marked only when the cursor wraps from the
screen's last column, not from a right margin, as in Ghostty. Apart from
`wrapped`, which every character calls, so that `wrapped` stays small
enough to inline (§VC13). -}
wrapNow : (moved t : Term) -> Term
wrapNow t =
    let
        marked =
            if t.x == t.cols - 1 then
                { t | screen = setWrapped t.y True t.screen }

            else
                t

        -- the line feed first, from where the cursor is, so that a wrap
        -- from right of the margins does not scroll them; then the left
        -- margin, as Ghostty's printWrap does (§VC16)
        fed =
            lineFeed { marked | wrapNext = False }
    in
    { fed | x = fed.left }


writeAscii : Bytes -> Int -> Int -> Int64 -> Int -> (moved row : Builder Int64) -> Builder Int64
writeAscii bytes i end pen x row =
    if i < end then
        writeAscii bytes (i + 1) end pen (x + 1) (Builder.set x (Bitwise.or pen (Int64.fromInt (byteAt bytes i))) row)

    else
        row


{-| A run of printable ASCII written from column `x` to `xEnd` of the row at
`o`, `first` the byte at `i`. A wide character the run's ends cut in half is
made empty. -}
asciiRow : Bytes -> Int -> Int -> Int64 -> Int64 -> Int -> Int -> Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
asciiRow bytes i end pen erase cols o x xEnd first cells =
    let
        m =
            Maybe.withDefault 0 (Builder.get (o + cols) cells)

        old =
            metaExtent m

        cut =
            if x < old then
                splitWide erase o x xEnd old cells

            else
                cells
    in
    Builder.set (o + cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt (max xEnd old))) (writeAscii bytes (i + 1) end pen (o + x + 1) (Builder.set (o + x) (Bitwise.or pen (Int64.fromInt first)) (reachAt o old x cut)))


{-| Before columns `x` to `xEnd` of the row at `o` are written, a wide
character whose other half lies outside them loses that half too, which
becomes `fill`, the erase cell, as Ghostty's `blankCell` (§VC17). -}
splitWide : Int64 -> Int -> Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
splitWide fill o x xEnd ext cells =
    let
        firstCell =
            Maybe.withDefault 0 (Builder.get (o + x) cells)

        lastCell =
            Maybe.withDefault 0 (Builder.get (o + xEnd - 1) cells)

        -- a cell at or past the extent is empty whatever the builder holds
        -- there, which a row cleared by its extent alone leaves behind
        left =
            if cellWide firstCell == wideTail && x > 0 && x < ext then
                Builder.set (o + x - 1) fill cells

            else
                cells
    in
    if cellWide lastCell == wideHead && xEnd < ext then
        Builder.set (o + xEnd) fill left

    else
        left


{-| `splitWide` for an erase, an insert or a delete: the half inside the
columns is made `fill` too, as Ghostty's `splitCellBoundary` clears both
halves whatever is erased after, a protected one too (§VC18). A function of
its own: written into `splitWide`, which clang inlines into the writer of
ASCII runs, where the half inside is written over anyway, it made `gitlog`
and `ls` 5% slower. -}
splitWhole : Int64 -> Int -> Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
splitWhole fill o x xEnd ext cells =
    let
        firstCell =
            Maybe.withDefault 0 (Builder.get (o + x) cells)

        lastCell =
            Maybe.withDefault 0 (Builder.get (o + xEnd - 1) cells)

        left =
            if cellWide firstCell == wideTail && x > 0 && x < ext then
                Builder.set (o + x) fill (Builder.set (o + x - 1) fill cells)

            else
                cells
    in
    if cellWide lastCell == wideHead && xEnd < ext then
        Builder.set (o + xEnd - 1) fill (Builder.set (o + xEnd) fill left)

    else
        left


{-| `unheadAbove` when `stale`. One call of the writer each path makes,
written into the screen before this, so that clang still inlines a writer
called once (§VC10). -}
unheadIf : Bool -> Int -> (moved s : Screen) -> Screen
unheadIf stale y s =
    if stale then
        unheadAbove y s

    else
        s


{-| The row above `y` ending in a spacer head made to end in an empty
cell: once the wide character that wrapped from it is overwritten, Ghostty
makes the spacer head a narrow cell, which a reflow keeps as a blank
(§VC17). -}
unheadAbove : Int -> (moved s : Screen) -> Screen
unheadAbove y s =
    let
        p =
            rowOffset s (y - 1) + s.cols - 1

        c =
            Maybe.withDefault 0 (Builder.get p s.cells)
    in
    if cellWide c == spacerHead then
        { s | cells = Builder.set p (Bitwise.and (Bitwise.complement 0x600000) c) s.cells }

    else
        s


{-| A run of printable ASCII in the ground state, GL ASCII, autowrap on and
insert off. `b` is the run's first byte, read by `ground`. -}
printAscii : Bytes -> Int -> Int -> Int -> (moved t0 : Term) -> Term
printAscii bytes n i b t0 =
    let
        t =
            wrapped t0

        cols =
            t.cols

        end =
            asciiEnd bytes (min n (i + cols - t.x)) (i + 1)

        x =
            t.x + end - i

        s =
            t.screen

        o =
            rowOffset s t.y

        -- tested only once a spacer head has been written (`heads`): a
        -- read of the row at every line's start cost `vte-scrolling` 24
        -- instructions a line, 5% (§VC17)
        stale =
            -- read through the extent: a cleared row keeps its old cells;
            -- or a wide character's head in column 1 written over, which
            -- one wrapped there under a left margin has (§VC18)
            t.heads && t.x <= 1 && t.y > 0 && (cellWide (peekCell o 0 s) == wideHead || (x > 1 && cols > 2 && cellWide (peekCell o 1 s) == wideHead))
    in
    ground bytes
        n
        end
        { t
            | screen = unheadIf stale t.y { s | cells = asciiRow bytes i end t.pen t.erase cols o t.x x b s.cells }
            , x = min (cols - 1) x
            , wrapNext = x >= cols
            , lastPoint =
                if end == i + 1 then
                    b

                else
                    byteAt bytes (end - 1)
        }


{-| One code point of width `w` written at the cursor, through every mode:
autowrap, insert, a wide character at the row's end, and a mark joined to
the cell before. -}
printPoint : Int -> Int -> (moved t0 : Term) -> Term
printPoint cp w t0 =
    if w == 0 then
        joinMark cp t0

    else
        let
            t1 =
                wrapped t0

            t =
                if t1.wrapNext then
                    -- autowrap off: the last column is written again
                    { t1 | wrapNext = False }

                else
                    t1

            -- a wide character with one column to write in is an empty
            -- narrow cell, and the cursor moves on as after a narrow one,
            -- as in Ghostty (§VC16); written here and not by a call of
            -- `printPoint`, which costs every character a cycle or more
            one =
                w == 2 && rightEdge t - t.left <= 1

            wc =
                if one then
                    1

                else
                    w

            cc =
                if one then
                    0

                else
                    cp
        in
        if wc == 2 && t.x + 2 > rightEdge t then
            -- Ghostty inserts first, where the character does not fit,
            -- and then wraps or, with autowrap off, writes nothing (§VC18)
            edgeWide cp w (insertBefore t)

        else
            let
                edge =
                    rightEdge t

                -- 0 no insert, 1 between margins, 2 the whole row
                inserting =
                    if not t.insert then
                        0

                    else if margined t then
                        if t.x >= t.left && t.x <= t.right then
                            1

                        else
                            0

                    else
                        2

                s0 =
                    t.screen

                o =
                    rowOffset s0 t.y

                s =
                    if inserting == 0 then
                        s0

                    else if inserting == 1 then
                        insertMargined o t.x wc t.right t.erase s0

                    else
                        insertCells o t.x wc t.erase s0

                ext =
                    extentAt o s

                -- a wide character's head in column 0 overwritten, but by
                -- one at the same place: a spacer head above loses its
                -- meaning, as in Ghostty's `writeCell` (§VC17)
                stale =
                    t.heads && t.x <= 1 && t.y > 0 && ((t.x == 1 || wc /= 2) && cellWide (cellAt o 0 s) == wideHead || (t.x == 1 && wc /= 2 && t.cols > 2 && cellWide (peekCell o 1 s) == wideHead))

                cells =
                    splitWide t.erase o t.x (t.x + wc) ext (reachAt o ext t.x s.cells)

                written =
                    if wc == 2 then
                        Builder.set (o + t.x + 1) (Bitwise.or t.pen (Int64.fromInt wideTail)) (Builder.set (o + t.x) (Bitwise.or t.pen (Int64.fromInt (Bitwise.or wideHead cc))) cells)

                    else
                        Builder.set (o + t.x) (Bitwise.or t.pen (Int64.fromInt cc)) cells

                x =
                    t.x + wc
            in
            { t
                | screen = unheadIf stale t.y { s | cells = extendTo o t.cols x written }
                , x = min (edge - 1) x
                , wrapNext = x >= edge
                , lastPoint = cp
            }


{-| A wide character where it does not fit, at the right edge or margin:
with autowrap on, a spacer head in the pen and the character on the next
row; with it off, nothing, but it is the character REP repeats. -}
edgeWide : Int -> Int -> (moved t : Term) -> Term
edgeWide cp w t =
    if t.autowrap && t.cols >= 2 then
        let
            -- in the pen, as Ghostty writes it; a spacer head at the
            -- screen's edge, and between margins an empty narrow cell
            -- (§VC17)
            head =
                if rightEdge t == t.cols then
                    Bitwise.or t.pen (Int64.fromInt spacerHead)

                else
                    t.pen

            s =
                t.screen

            o =
                rowOffset s t.y

            headed =
                { t | screen = { s | cells = extendTo o t.cols (t.x + 1) (Builder.set (o + t.x) head (reachAt o (extentAt o s) t.x (splitWide t.erase o t.x (t.x + 1) (extentAt o s) s.cells))) }, heads = True }

            inserting =
                headed.insert

            -- no insert on the next row: Ghostty decides on one before
            -- the wrap, where the character does not fit (§VC17)
            r =
                printPoint cp w { headed | wrapNext = True, insert = False }
        in
        { r | insert = inserting }

    else
        -- nothing written, but REP repeats it, as Ghostty keeps every
        -- printable character before it writes one (§VC19)
        { t | lastPoint = cp }


{-| Insert mode's blanks for a wide character that does not fit, made where
it is, as Ghostty makes them before it wraps: when the character would end
before the screen's edge, between the margins when the cursor is between
them. -}
insertBefore : (moved t : Term) -> Term
insertBefore t =
    if not t.insert || t.x + 2 >= t.cols then
        t

    else if margined t then
        if t.x >= t.left && t.x <= t.right then
            let
                s =
                    t.screen
            in
            { t | screen = insertMargined (rowOffset s t.y) t.x 2 t.right t.erase s }

        else
            t

    else
        let
            s =
                t.screen
        in
        { t | screen = insertCells (rowOffset s t.y) t.x 2 t.erase s }


{-| A mark joined to the cell the last character was written to, as the
next code point of its cluster. A mark with no cell before it is dropped. -}
joinMark : Int -> (moved t : Term) -> Term
joinMark cp t =
    let
        s =
            t.screen

        o =
            rowOffset s t.y

        -- the cell under a pending wrap, but with autowrap off the one
        -- before the cursor even in the last column, as in Ghostty (§VC17)
        at0 =
            if t.wrapNext && t.autowrap then
                t.x

            else
                t.x - 1

        at =
            if at0 >= 1 && cellWide (cellAt o at0 s) == wideTail then
                at0 - 1

            else
                at0

        c =
            if at >= 0 then
                cellAt o at s

            else
                0

        points =
            cellPoints c t.clusters
    in
    if Array.length points == 0 || Array.length points >= clusterMax then
        { t | screen = s }

    else if (cp == 0xFE0F || cp == 0xFE0E) && not (Width.pictographic (Maybe.withDefault 0 (Array.get 0 points))) then
        -- a variation selector after what is not an emoji is dropped, as
        -- Ghostty drops it (§VC17)
        { t | screen = s }

    else
        when internCluster (Array.pushLast cp points) t.clusters is
            Just k ->
                let
                    cell =
                        Bitwise.or (Bitwise.and (Bitwise.or highMask (Bitwise.or protectBit 0x600000)) c) (Int64.fromInt (Bitwise.or clusterBit k.id))
                in
                { t | screen = { s | cells = Builder.set (o + at) cell s.cells }, clusters = k.clusters }

            Nothing ->
                { t | screen = s }


{-| A run of UTF-8, and the printable ASCII inside it, written to the
cursor's row at once (`decodeRun`), in the ground state with GL ASCII,
autowrap on and insert off. The run stops before anything the general path
has to see: a control, a sequence that is cut by the read's end or is not
well formed, a C1 control, a mark, a wide character that does not fit, and
the row's end. When it stops at once, the lead byte `b` at `i` takes the
general path. A pending wrap takes the general path too, since a mark after
it joins the row it would leave. -}
printUnicode : Bytes -> Int -> Int -> Int -> (moved t : Term) -> Term
printUnicode bytes n i b t =
    let
        s =
            t.screen

        o =
            rowOffset s t.y

        ext =
            extentAt o s

        -- the cell the run starts on, read before the run writes it: a wide
        -- character's tail there loses its head, but only once the run has
        -- written something, since a run that stops at once (a mark, which
        -- joins the cell before) leaves the row to the general path as it
        -- was (§VC11's mark on a tail)
        first =
            Maybe.withDefault 0 (Builder.get (o + t.x) s.cells)

        headAt0 =
            -- read through the extent: a cleared row keeps its old cells
            t.heads && t.x <= 1 && t.y > 0 && cellWide (peekCell o 0 s) == wideHead

        headAt1 =
            t.heads && t.x <= 1 && t.y > 0 && t.cols > 2 && cellWide (peekCell o 1 s) == wideHead

        r =
            decodeRun bytes n i t.pen o t.cols t.x 0 (reachAt o ext t.x s.cells)
    in
    if r.next == i then
        startUtf8 bytes n i b { t | screen = { s | cells = r.cells } }

    else
        let
            headless =
                if cellWide first == wideTail && t.x > 0 && t.x < ext then
                    Builder.set (o + t.x - 1) t.erase r.cells

                else
                    r.cells

            -- a wide character whose head the run overwrote loses its spacer
            after =
                Maybe.withDefault 0 (Builder.get (o + r.x) headless)

            tidy =
                if r.x < ext && cellWide after == wideTail then
                    Builder.set (o + r.x) t.erase headless

                else
                    headless

            stale =
                headAt0 && (t.x == 1 || cellWide (Maybe.withDefault 0 (Builder.get o tidy)) /= wideHead) || headAt1 && r.x > 1 && cellWide (Maybe.withDefault 0 (Builder.get (o + 1) tidy)) == 0
        in
        ground bytes
            n
            r.next
            { t
                | screen = unheadIf stale t.y { s | cells = extendTo o t.cols r.x tidy }
                , x = min (t.cols - 1) r.x
                , wrapNext = r.x >= t.cols
                , lastPoint = r.last
            }


type alias Run =
    { cells : Builder Int64, x : Int, next : Int, last : Int }


decodeRun : Bytes -> Int -> Int -> Int64 -> Int -> Int -> Int -> Int -> (moved row : Builder Int64) -> Run
decodeRun bytes n i pen o cols x last row =
    if i >= n || x >= cols then
        { cells = row, x = x, next = i, last = last }

    else
        let
            b =
                byteAt bytes i
        in
        if b < 0x20 || b == 0x7F then
            { cells = row, x = x, next = i, last = last }

        else if b < 0x80 then
            decodeRun bytes n (i + 1) pen o cols (x + 1) b (Builder.set (o + x) (Bitwise.or pen (Int64.fromInt b)) row)

        else
            let
                len =
                    leadLength b

                cp =
                    if len == 0 || i + len > n then
                        -1

                    else
                        wellFormed bytes i b len

                w =
                    if cp < 0xA0 then
                        -1

                    else
                        Width.width cp
            in
            if w == 1 then
                decodeRun bytes n (i + len) pen o cols (x + 1) cp (Builder.set (o + x) (Bitwise.or pen (Int64.fromInt cp)) row)

            else if w == 2 && x + 2 <= cols then
                decodeRun bytes n (i + len) pen o cols (x + 2) cp (Builder.set (o + x + 1) (Bitwise.or pen (Int64.fromInt wideTail)) (Builder.set (o + x) (Bitwise.or pen (Int64.fromInt (Bitwise.or wideHead cp))) row))

            else
                { cells = row, x = x, next = i, last = last }


{-| How many bytes a UTF-8 sequence that starts with `b` has, or 0 when no
well-formed one starts with it. -}
leadLength : Int -> Int
leadLength b =
    if b >= 0xC2 && b <= 0xDF then
        2

    else if b >= 0xE0 && b <= 0xEF then
        3

    else if b >= 0xF0 && b <= 0xF4 then
        4

    else
        0


{-| The code point of the `len`-byte sequence at `i` that starts with `b`,
or -1 when it is not well formed (Unicode §3.9, table 3-7). -}
wellFormed : Bytes -> Int -> Int -> Int -> Int
wellFormed bytes i b len =
    let
        b1 =
            byteAt bytes (i + 1)

        low =
            if b == 0xE0 then
                0xA0

            else if b == 0xF0 then
                0x90

            else
                0x80

        high =
            if b == 0xED then
                0x9F

            else if b == 0xF4 then
                0x8F

            else
                0xBF
    in
    if b1 < low || b1 > high then
        -1

    else if len == 2 then
        Bitwise.or (Bitwise.shiftLeftBy 6 (Bitwise.and 0x1F b)) (Bitwise.and 0x3F b1)

    else
        let
            b2 =
                byteAt bytes (i + 2)
        in
        if b2 < 0x80 || b2 > 0xBF then
            -1

        else if len == 3 then
            Bitwise.or (Bitwise.shiftLeftBy 12 (Bitwise.and 0x0F b)) (Bitwise.or (Bitwise.shiftLeftBy 6 (Bitwise.and 0x3F b1)) (Bitwise.and 0x3F b2))

        else
            let
                b3 =
                    byteAt bytes (i + 3)
            in
            if b3 < 0x80 || b3 > 0xBF then
                -1

            else
                Bitwise.or (Bitwise.shiftLeftBy 18 (Bitwise.and 0x07 b))
                    (Bitwise.or (Bitwise.shiftLeftBy 12 (Bitwise.and 0x3F b1))
                        (Bitwise.or (Bitwise.shiftLeftBy 6 (Bitwise.and 0x3F b2)) (Bitwise.and 0x3F b3))
                    )


{-| A UTF-8 sequence's lead byte, in the ground state. A byte that cannot
start one is U+FFFD. -}
startUtf8 : Bytes -> Int -> Int -> Int -> (moved t : Term) -> Term
startUtf8 bytes n i b t =
    if b >= 0xC2 && b <= 0xDF then
        continueUtf8 bytes n (i + 1) { t | utf = Bitwise.and b 0x1F, need = 1, low = 0x80, high = 0xBF }

    else if b >= 0xE0 && b <= 0xEF then
        continueUtf8 bytes
            n
            (i + 1)
            { t
                | utf = Bitwise.and b 0x0F
                , need = 2
                , low =
                    if b == 0xE0 then
                        0xA0

                    else
                        0x80
                , high =
                    if b == 0xED then
                        0x9F

                    else
                        0xBF
            }

    else if b >= 0xF0 && b <= 0xF4 then
        continueUtf8 bytes
            n
            (i + 1)
            { t
                | utf = Bitwise.and b 0x07
                , need = 3
                , low =
                    if b == 0xF0 then
                        0x90

                    else
                        0x80
                , high =
                    if b == 0xF4 then
                        0x8F

                    else
                        0xBF
            }

    else
        resume bytes n (i + 1) (printDecoded 0xFFFD t)


{-| The continuation bytes of a UTF-8 sequence; a read that ends in one
leaves the parser in `psUtf8`. A byte that cannot continue it ends the
sequence as U+FFFD and is read again in the ground state (the maximal
subpart, Unicode §3.9). -}
continueUtf8 : Bytes -> Int -> Int -> (moved t : Term) -> Term
continueUtf8 bytes n i t =
    if t.need <= 0 then
        resume bytes n i (printDecoded t.utf t)

    else if i >= n then
        { t | ps = psUtf8 }

    else
        let
            b =
                byteAt bytes i
        in
        if b >= t.low && b <= t.high then
            continueUtf8 bytes n (i + 1) { t | utf = Bitwise.or (Bitwise.shiftLeftBy 6 t.utf) (Bitwise.and 0x3F b), need = t.need - 1, low = 0x80, high = 0xBF }

        else
            resume bytes n i (printDecoded 0xFFFD { t | need = 0 })


printDecoded : Int -> (moved t : Term) -> Term
printDecoded cp t =
    if cp < 0xA0 then
        -- a C1 control as UTF-8 is not printed
        t

    else
        printPoint cp (Width.width cp) (unshift t)


escape : Bytes -> Int -> Int -> (moved t : Term) -> Term
escape bytes n i t =
    if i >= n then
        { t | ps = psEscape }

    else
        let
            b =
                byteAt bytes i
        in
        if b == 0x5B then
            csi bytes n (i + 1) t (Builder.empty 16) 0 0 0 0 0

        else if b == 0x5D then
            oscString bytes n (i + 1) { t | str = Builder.empty 64 }

        else if b == 0x50 then
            dcsString bytes n (i + 1) { t | str = Builder.empty 64 }

        else if b == 0x58 || b == 0x5E || b == 0x5F then
            ignoreString bytes n (i + 1) t

        else if b >= 0x20 && b < 0x30 then
            escInter bytes n (i + 1) { t | inter = b }

        else if b == 0x1B then
            escape bytes n (i + 1) t

        else if b == 0x18 || b == 0x1A then
            resume bytes n (i + 1) t

        else if b < 0x20 then
            escape bytes n (i + 1) (execute b t)

        else if b >= 0x80 && b < 0xA0 then
            c1 bytes n (i + 1) b t

        else if b == 0x7F || b >= 0xA0 then
            escape bytes n (i + 1) t

        else
            resume bytes n (i + 1) (escDispatch b t)


escDispatch : Int -> (moved t : Term) -> Term
escDispatch b t =
    if b == 0x37 then
        saveCursor t

    else if b == 0x56 then
        protect 1 t

    else if b == 0x57 then
        protect 0 t

    else if b == 0x38 then
        restoreCursor t

    else if b == 0x44 then
        lineFeed { t | wrapNext = False }

    else if b == 0x45 then
        carriageReturn (lineFeed { t | wrapNext = False })

    else if b == 0x48 then
        { t | tabs = Builder.set t.x 1 t.tabs }

    else if b == 0x4D then
        reverseIndex t

    else if b == 0x63 then
        reset t

    else if b == 0x6E || b == 0x6F then
        -- LS2 and LS3; LS1R to LS3R shift into GR, which UTF-8 never reads
        withPlain { t | gl = b - 0x6C }

    else if b == 0x4E || b == 0x4F then
        -- SS2 and SS3, for the next character
        withPlain { t | single = b - 0x4C }

    else if b == 0x5A then
        reply primaryAttributes t

    else if b == 0x3D then
        { t | modes = Dict.set 66 True t.modes }

    else if b == 0x3E then
        { t | modes = Dict.set 66 False t.modes }

    else
        t


escInter : Bytes -> Int -> Int -> (moved t : Term) -> Term
escInter bytes n i t =
    if i >= n then
        { t | ps = psEscInter }

    else
        let
            b =
                byteAt bytes i
        in
        if b >= 0x20 && b < 0x30 then
            -- a second intermediate: nothing the core takes has one
            escInter bytes n (i + 1) { t | inter = 0xFF }

        else if b == 0x1B then
            escape bytes n (i + 1) t

        else if b == 0x18 || b == 0x1A then
            resume bytes n (i + 1) t

        else if b < 0x20 then
            escInter bytes n (i + 1) (execute b t)

        else if b >= 0x80 && b < 0xA0 then
            c1 bytes n (i + 1) b t

        else if b == 0x7F || b >= 0xA0 then
            escInter bytes n (i + 1) t

        else if t.inter >= 0x28 && t.inter <= 0x2B then
            resume bytes n (i + 1) (designate (t.inter - 0x28) (charset b) t)

        else if t.inter == 0x23 && b == 0x38 then
            resume bytes n (i + 1) (alignment t)

        else
            resume bytes n (i + 1) t


{-| The set a designation's final byte names, or -1 for one Ghostty does
not know, which leaves the slot as it was (§VC17). -}
charset : Int -> Int
charset final =
    if final == 0x42 then
        0

    else if final == 0x30 then
        1

    else if final == 0x41 then
        2

    else
        -1


designate : Int -> Int -> (moved t : Term) -> Term
designate g set t =
    if set < 0 then
        t

    else
        withPlain { t | sets = Bitwise.or (Bitwise.shiftLeftBy (2 * g) set) (Bitwise.and (Bitwise.complement (Bitwise.shiftLeftBy (2 * g) 3)) t.sets) }


{-| An OSC string, to BEL or ST, its first `stringMax` bytes kept. -}
oscString : Bytes -> Int -> Int -> (moved t : Term) -> Term
oscString bytes n i t =
    if i >= n then
        { t | ps = psOsc }

    else
        let
            b =
                byteAt bytes i
        in
        if b == 7 then
            resume bytes n (i + 1) (oscDispatch "\u{0007}" t)

        else if b == 0x1B then
            escape bytes n (i + 1) (oscDispatch "\u{001B}\\" t)

        else if b == 0x18 || b == 0x1A then
            resume bytes n (i + 1) { t | str = Builder.empty 0 }

        else if b < 0x20 then
            oscString bytes n (i + 1) t

        else
            oscString bytes n (i + 1) (keepByte b t)


{-| An OSC's command number as Ghostty reads one: digits only, and no
leading zero but in `0` itself, so `04` and `+4` are no command (§VC16). -}
oscNumber : String -> Maybe Int
oscNumber text =
    if text == "" || not (String.all Char.isDigit text) || (String.startsWith "0" text && text /= "0") then
        Nothing

    else
        String.toInt text


keepByte : Int -> (moved t : Term) -> Term
keepByte b t =
    if Builder.length t.str < stringMax then
        { t | str = Builder.pushLast (UInt8.fromInt b) t.str }

    else
        t


{-| A DCS string, to ST, its first `stringMax` bytes kept. Bytes above 0x7F
are payload. -}
dcsString : Bytes -> Int -> Int -> (moved t : Term) -> Term
dcsString bytes n i t =
    if i >= n then
        { t | ps = psDcs }

    else
        let
            b =
                byteAt bytes i
        in
        if b == 0x1B then
            escape bytes n (i + 1) (dcsDispatch t)

        else if b == 0x18 || b == 0x1A then
            -- CAN and SUB end it as ESC does, dispatched: leaving Ghostty's
            -- DCS state unhooks it (§VC17)
            resume bytes n (i + 1) (dcsDispatch t)

        else if b >= 0x80 && b < 0xA0 && dcsHeader t.str 0 0 then
            c1 bytes n (i + 1) b { t | str = Builder.empty 0 }

        else
            dcsString bytes n (i + 1) (keepByte b t)


{-| Whether a DCS kept so far is still in its parameters and
intermediates, where a C1 control works as anywhere else; past the final
byte, or once the header is one Ghostty ignores, a high byte is payload,
as in Ghostty. `phase` is 0 at the start, 1 among the parameters, 2 among
the intermediates; controls and DEL are skipped, as Ghostty skips them. -}
dcsHeader : Builder UInt8 -> Int -> Int -> Bool
dcsHeader str i phase =
    if i >= Builder.length str then
        Builder.length str < stringMax

    else
        let
            b =
                when Builder.get i str is
                    Just v ->
                        UInt8.toInt v

                    Nothing ->
                        0
        in
        if b < 0x20 || b == 0x7F || b >= 0x80 then
            dcsHeader str (i + 1) phase

        else if b < 0x30 then
            dcsHeader str (i + 1) 2

        else if b < 0x40 then
            if phase == 2 || b == 0x3A || (phase == 1 && b >= 0x3C) then
                False

            else
                dcsHeader str (i + 1) 1

        else
            False


{-| A C1 control as an 8-bit byte, outside the ground state and the
strings that take high bytes as text (OSC, a DCS's payload): Ghostty's
"anywhere" transitions. It starts CSI, OSC, DCS or SOS/PM/APC, ends what
was being parsed at ST, and otherwise is the ESC sequence it stands for
(0x85 is ESC E). In the ground state such a byte is UTF-8's. -}
c1 : Bytes -> Int -> Int -> Int -> (moved t : Term) -> Term
c1 bytes n i b t =
    if b == 0x9B then
        csi bytes n i t (Builder.empty 16) 0 0 0 0 0

    else if b == 0x9D then
        oscString bytes n i { t | str = Builder.empty 64 }

    else if b == 0x90 then
        dcsString bytes n i { t | str = Builder.empty 64 }

    else if b == 0x98 || b == 0x9E || b == 0x9F then
        ignoreString bytes n i t

    else if b == 0x9C then
        resume bytes n i t

    else
        resume bytes n i (escDispatch (b - 0x40) t)


{-| SOS, PM or APC: skipped to ST. -}
ignoreString : Bytes -> Int -> Int -> (moved t : Term) -> Term
ignoreString bytes n i t =
    if i >= n then
        { t | ps = psString }

    else
        let
            b =
                byteAt bytes i
        in
        if b == 0x1B then
            escape bytes n (i + 1) t

        else if b == 0x18 || b == 0x1A then
            resume bytes n (i + 1) t

        else if b >= 0x80 && b < 0xA0 then
            c1 bytes n (i + 1) b t

        else
            ignoreString bytes n (i + 1) t


{-| The bytes of the string kept, taken out of the term. -}
takeString : (moved t : Term) -> { term : Term, text : Array UInt8 }
takeString t =
    let
        text =
            Builder.toArray t.str
    in
    { term = { t | str = Builder.empty 0 }, text = text }


stringOf : Array UInt8 -> String
stringOf text =
    Bytes.toString (Bytes.fromUInt8s text) |> Maybe.withDefault ""


oscDispatch : String -> (moved t0 : Term) -> Term
oscDispatch end t0 =
    let
        taken =
            takeString t0

        t =
            taken.term

        -- text that is not UTF-8 is still read, a high byte as one no
        -- command or colour has, as Ghostty reads the bytes (§VC16)
        text =
            when Bytes.toString (Bytes.fromUInt8s taken.text) is
                Just decoded ->
                    decoded

                Nothing ->
                    stringOf (Array.map lowByte taken.text)

        parts =
            String.split ";" text

        command =
            oscNumber (Maybe.withDefault "" (Array.first parts))

        rest =
            String.join ";" (Array.dropFirst 1 parts)

        -- what follows the number and its `;`: Ghostty keeps 2,048 bytes
        -- of it for each command the core takes, and drops a longer one
        long =
            Array.length taken.text - String.count (Maybe.withDefault "" (Array.first parts)) - 1 > oscMax
    in
    when (if long then Nothing else command) is
        Just 0 ->
            { t | title = rest }

        Just 2 ->
            { t | title = rest }

        Just 4 ->
            paletteColours end (Array.keepIf (\w -> w /= "") (Array.dropFirst 1 parts)) "" t

        Just 104 ->
            resetPalette (Array.dropFirst 1 parts) t

        Just c ->
            if c >= 10 && c <= 19 then
                dynamicColours end c (Array.keepIf (\w -> w /= "") (Array.dropFirst 1 parts)) "" t

            else if c >= 110 && c <= 112 && Array.all (\w -> w == "") (Array.dropFirst 1 parts) then
                -- an empty parameter is none: Ghostty's words skip them
                { t | colours = Dict.remove (dynamicKey (c - 100)) t.colours }

            else
                t

        Nothing ->
            t


-- COLOURS


{-| OSC 4: pairs of an index and a colour or `?`, each set or answered in
order, the answers in one reply ended as the request was; the first pair
that does not parse ends it, as in Ghostty (§VC12). An index of 256 to 260
is one of Ghostty's special colours (OSC 5's), which it passes over: a
query or a colour that parses goes on to the next pair (§VC17). -}
paletteColours : String -> Array String -> String -> (moved t : Term) -> Term
paletteColours end words answers t =
    when { i = Maybe.andThen digits (Array.get 0 words), spec = Array.get 1 words } is
        { i = Just i, spec = Just spec } ->
            if i >= 256 && i <= 260 && (spec == "?" || parseColour spec /= Nothing) then
                paletteColours end (Array.dropFirst 2 words) answers t

            else if i < 0 || i > 255 then
                withAnswers answers t

            else if spec == "?" then
                paletteColours end (Array.dropFirst 2 words) (answers ++ "\u{001B}]4;" ++ String.fromInt i ++ ";" ++ rgb16 (paletteColour i t) ++ end) t

            else
                when parseColour spec is
                    Just c ->
                        paletteColours end (Array.dropFirst 2 words) answers { t | colours = Dict.set i c t.colours }

                    Nothing ->
                        withAnswers answers t

        _ ->
            withAnswers answers t


{-| OSC 10 to 19: colours or `?` for the dynamic colours from `c` on, each
the next's. The foreground (10), background (11) and cursor (12) are kept;
the rest are passed over, as Ghostty passes them. -}
dynamicColours : String -> Int -> Array String -> String -> (moved t : Term) -> Term
dynamicColours end c words answers t =
    when Array.first words is
        Just spec ->
            if spec == "?" then
                let
                    more =
                        when dynamicColour c t is
                            Just v ->
                                answers ++ "\u{001B}]" ++ String.fromInt c ++ ";" ++ rgb16 v ++ end

                            Nothing ->
                                answers
                in
                nextDynamic end c words more t

            else
                when parseColour spec is
                    Just v ->
                        if c <= 12 then
                            nextDynamic end c words answers { t | colours = Dict.set (dynamicKey c) v t.colours }

                        else
                            nextDynamic end c words answers t

                    Nothing ->
                        withAnswers answers t

        Nothing ->
            withAnswers answers t


{-| The next dynamic colour's word, or the end after OSC 19's. A function of
its own, not a local one handed the term: a term handed to a function value
is kept by every path of the parser, and each update of it copies (§VC7). -}
nextDynamic : String -> Int -> Array String -> String -> (moved t : Term) -> Term
nextDynamic end c words answers t =
    if c >= 19 then
        withAnswers answers t

    else
        dynamicColours end (c + 1) (Array.dropFirst 1 words) answers t


withAnswers : String -> (moved t : Term) -> Term
withAnswers answers t =
    if answers == "" then
        t

    else
        reply answers t


{-| OSC 104: the palette entries named set back, or every one. -}
resetPalette : Array String -> (moved t : Term) -> Term
resetPalette words t =
    let
        named =
            Array.mapAndKeepJust digits (Array.keepIf (\w -> w /= "") words)
    in
    if Array.isEmpty named then
        { t | colours = Dict.keepIf (\k _ -> k > 255) t.colours }

    else
        { t | colours = Array.foldl Dict.remove t.colours named }


{-| A colour's index: decimal digits only, no sign, as Ghostty's
`parseInt` for an unsigned type takes it (§VC18). One too big for any
index is 99999, which none has. -}
digits : String -> Maybe Int
digits w =
    if w /= "" && String.all Char.isDigit w then
        if String.count w > 5 then
            when String.toInt (String.takeLast 5 w) is
                Just v ->
                    if String.all (\c -> c == '0') (String.dropLast 5 w) then
                        Just v

                    else
                        Just 99999

                Nothing ->
                    Nothing

        else
            String.toInt w

    else
        Nothing


dynamicKey : Int -> Int
dynamicKey c =
    1000 + c


{-| A dynamic colour: the one set, or none, since the core has no default
foreground or background, as libghostty-vt has none unless its embedder
gives one; the cursor's is the foreground's when it has none. -}
dynamicColour : Int -> Term -> Maybe Int
dynamicColour c t =
    if c == 12 then
        when Dict.get (dynamicKey 12) t.colours is
            Just v ->
                Just v

            Nothing ->
                Dict.get (dynamicKey 10) t.colours

    else if c <= 11 then
        Dict.get (dynamicKey c) t.colours

    else
        Nothing


paletteColour : Int -> Term -> Int
paletteColour i t =
    Maybe.withDefault (defaultColour i) (Dict.get i t.colours)


{-| The palette as libghostty-vt has it before anything sets it: its 16,
the 6×6×6 cube and the grey ramp. -}
defaultColour : Int -> Int
defaultColour i =
    if i < 16 then
        Maybe.withDefault 0 (Array.get i namedColours)

    else if i < 232 then
        let
            level v =
                if v == 0 then
                    0

                else
                    v * 40 + 55

            k =
                i - 16
        in
        rgbOf (level (k // 36)) (level (modBy 6 (k // 6))) (level (modBy 6 k))

    else
        let
            v =
                (i - 232) * 10 + 8
        in
        rgbOf v v v


namedColours : Array Int
namedColours =
    [ 0x1D1F21, 0xCC6666, 0xB5BD68, 0xF0C674, 0x81A2BE, 0xB294BB, 0x8ABEB7, 0xC5C8C6, 0x666666, 0xD54E53, 0xB9CA4A, 0xE7C547, 0x7AA6DA, 0xC397D8, 0x70C0B1, 0xEAEAEA ]


rgbOf : Int -> Int -> Int -> Int
rgbOf r g b =
    Bitwise.or (Bitwise.shiftLeftBy 16 r) (Bitwise.or (Bitwise.shiftLeftBy 8 g) b)


{-| A colour as xterm reports one: `rgb:` and each channel in 16 bits. -}
rgb16 : Int -> String
rgb16 c =
    let
        channel v =
            hex2 v ++ hex2 v
    in
    "rgb:" ++ channel (Bitwise.shiftRightZfBy 16 c) ++ "/" ++ channel (Bitwise.shiftRightZfBy 8 c) ++ "/" ++ channel c


{-| A colour as XParseColor reads one, as Ghostty reads it: `#` and 1 to 4
hex digits a channel, 3 or 6 hex digits alone, `rgb:` and 1 to 4 a channel,
or `rgbi:` and an intensity from 0 to 1 a channel; each scaled to 8 bits.
X11's colour names are not taken (§VC12). -}
parseColour : String -> Maybe Int
parseColour spec0 =
    let
        spec =
            String.trim spec0

        n =
            String.count spec

        groups text k =
            Maybe.map3 rgbOf (scaledHex (String.slice 0 k text)) (scaledHex (String.slice k (2 * k) text)) (scaledHex (String.slice (2 * k) (3 * k) text))

        parts text f =
            when String.split "/" text is
                [ r, g, b ] ->
                    Maybe.map3 rgbOf (f r) (f g) (f b)

                _ ->
                    Nothing
    in
    if String.startsWith "#" spec then
        if n == 4 || n == 7 || n == 10 || n == 13 then
            groups (String.dropFirst 1 spec) ((n - 1) // 3)

        else
            Nothing

    else if n == 3 || n == 6 then
        groups spec (n // 3)

    else if String.startsWith "rgbi:" spec then
        parts (String.dropFirst 5 spec) intensity

    else if String.startsWith "rgb:" spec then
        parts (String.dropFirst 4 spec) scaledHex

    else
        Nothing


scaledHex : String -> Maybe Int
scaledHex text =
    let
        n =
            String.count text

        value =
            String.foldl
                (\ch acc ->
                    Maybe.andThen
                        (\v ->
                            let
                                d =
                                    Char.toCode ch
                            in
                            if d >= 0x30 && d <= 0x39 then
                                Just (v * 16 + d - 0x30)

                            else if d >= 0x61 && d <= 0x66 then
                                Just (v * 16 + d - 0x57)

                            else if d >= 0x41 && d <= 0x46 then
                                Just (v * 16 + d - 0x37)

                            else
                                Nothing
                        )
                        acc
                )
                (Just 0)
                text
    in
    if n < 1 || n > 4 then
        Nothing

    else
        Maybe.map (\v -> v * 255 // (Bitwise.shiftLeftBy (4 * n) 1 - 1)) value


intensity : String -> Maybe Int
intensity text =
    when String.toFloat text is
        Just f ->
            if f >= 0 && f <= 1 then
                Just (Math.floor (f * 255))

            else
                Nothing

        Nothing ->
            Nothing


dcsDispatch : (moved t0 : Term) -> Term
dcsDispatch t0 =
    let
        taken =
            takeString t0

        t =
            taken.term

        header =
            Array.foldl dcsClean { phase = 0, kept = [] } taken.text

        -- the parameters before the intermediates, which DECRQSS has none of;
        -- a high byte is one no setting has, so a request with one is
        -- answered as not recognized, as Ghostty does, not dropped as text
        -- that is not UTF-8
        text =
            if header.phase < 0 then
                ""

            else
                dropParams (stringOf (Array.map lowByte header.kept))
    in
    if String.startsWith "$q" text && String.count text <= 4 then
        -- Ghostty keeps two bytes of a request and drops one longer
        -- unanswered (§VC16)
        reply ("\u{001B}P" ++ requestStatus (String.dropFirst 2 text) t ++ "\u{001B}\\") t

    else
        t


{-| A DCS's bytes as Ghostty's parser reads its header: a control, DEL or
high byte before the final byte skipped, and a header it ignores (a colon,
a parameter byte among the intermediates, `<` to `?` after a parameter)
phase -1. Phases as `dcsHeader`'s, and 3 past the final byte, where every
byte is kept (§VC17). -}
dcsClean : UInt8 -> { phase : Int, kept : Array UInt8 } -> { phase : Int, kept : Array UInt8 }
dcsClean v st =
    let
        b =
            UInt8.toInt v
    in
    if st.phase == 3 then
        { phase = 3, kept = Array.pushLast v st.kept }

    else if st.phase < 0 || b < 0x20 || b == 0x7F || b >= 0x80 then
        st

    else if b < 0x30 then
        { phase = 2, kept = Array.pushLast v st.kept }

    else if b < 0x40 then
        if st.phase == 2 || b == 0x3A || (st.phase == 1 && b >= 0x3C) then
            { phase = -1, kept = st.kept }

        else
            { phase = 1, kept = Array.pushLast v st.kept }

    else
        { phase = 3, kept = Array.pushLast v st.kept }


{-| A high byte in a string that is not UTF-8, as a byte no command, colour
or setting has: 0x01, not `?`, which OSC 4 and 10 read as a query (§VC17). -}
lowByte : UInt8 -> UInt8
lowByte b =
    if UInt8.toInt b >= 0x80 then
        UInt8.fromInt 0x01

    else
        b


dropParams : String -> String
dropParams text =
    when String.popFirst text is
        Just c ->
            if Char.isDigit c.first || c.first == ';' || c.first == ':' then
                dropParams c.rest

            else
                text

        Nothing ->
            text


{-| DECRQSS's answer to `setting`: `1$r` and the setting, or `0$r`. -}
requestStatus : String -> Term -> String
requestStatus setting t =
    if setting == "m" then
        "1$r" ++ sgrText t.attrs ++ "m"

    else if setting == " q" then
        "1$r"
            ++ String.fromInt
                (t.cursorShape
                    + (if Dict.get 12 t.modes == Just True then
                        0

                       else
                        1
                      )
                )
            ++ " q"

    else if setting == "s" then
        if Dict.get 69 t.modes == Just True then
            "1$r" ++ String.fromInt (t.left + 1) ++ ";" ++ String.fromInt (t.right + 1) ++ "s"

        else
            "0$r"

    else if setting == "r" then
        "1$r" ++ String.fromInt (t.top + 1) ++ ";" ++ String.fromInt (t.bottom + 1) ++ "r"

    else
        "0$r"


sgrText : Attrs -> String
sgrText a =
    let
        on bit text =
            if Bitwise.and bit a.flags /= 0 then
                [ text ]

            else
                []

        under =
            if a.ul == 0 then
                []

            else if a.ul == 1 then
                [ "4" ]

            else
                [ "4:" ++ String.fromInt a.ul ]

        colour base low high c =
            if c == 0 then
                []

            else if c <= 8 then
                [ low ++ String.fromInt (c - 1) ]

            else if c <= 16 then
                [ high ++ String.fromInt (c - 9) ]

            else if c <= 256 then
                [ base ++ ":5:" ++ String.fromInt (c - 1) ]

            else
                [ base
                    ++ ":2::"
                    ++ String.fromInt (Bitwise.and 0xFF (Bitwise.shiftRightZfBy 16 c))
                    ++ ":"
                    ++ String.fromInt (Bitwise.and 0xFF (Bitwise.shiftRightZfBy 8 c))
                    ++ ":"
                    ++ String.fromInt (Bitwise.and 0xFF c)
                ]
    in
    String.join ";"
        (Array.flatten
            [ [ "0" ]
            , on 1 "1"
            , on 2 "2"
            , on 4 "3"
            , under
            , on 128 "53"
            , on 8 "5"
            , on 16 "7"
            , on 32 "8"
            , on 64 "9"
            , colour "38" "3" "9" a.fg
            , colour "48" "4" "10" a.bg
            ]
        )


{-| A CSI's parameters and intermediates, then its final byte. `colons`
has bit `k` set when parameter `k` was followed by a colon, and `cur` is the
parameter being read. `phase` is 0 before any parameter byte, 1 among them
with no digit since the last separator, 2 with one, and 3 or 4 after an
intermediate, 4 if a digit came after the last separator. A separator ends
a parameter, 0 if it had no digit, and the final byte keeps the last only
if it had one, as Ghostty's parser does, so that `CSI 3 ; m` has one
parameter and `CSI m` none (§VC16); the digit is kept in `phase`, which
every byte passes on anyway, so that a digit costs what it did. A colon
outside SGR makes the sequence ignored, as in Ghostty. -}
csi : Bytes -> Int -> Int -> (moved t : Term) -> (moved params : Builder Int) -> Int -> Int -> Int -> Int -> Int -> Term
csi bytes n i t params cur colons priv inter phase =
    if i >= n then
        { t | ps = psCsi, params = Builder.toArray params, cur = cur, colons = colons, priv = priv, inter = inter, phase = phase }

    else
        let
            b =
                byteAt bytes i
        in
        if b >= 0x30 && b <= 0x39 then
            if phase >= 3 then
                csiIgnore bytes n (i + 1) t

            else
                csi bytes n (i + 1) t params (min 65535 (cur * 10 + b - 0x30)) colons priv inter 2

        else if b == 0x3B || b == 0x3A then
            if phase >= 3 || (phase == 0 && b == 0x3A) then
                -- a colon first, before any parameter or marker, makes
                -- the sequence ignored, as in Ghostty's table (§VC18)
                csiIgnore bytes n (i + 1) t

            else
                let
                    k =
                        Builder.length params
                in
                if k + 1 < paramMax then
                    csi bytes
                        n
                        (i + 1)
                        t
                        (Builder.pushLast cur params)
                        0
                        (if b == 0x3A then
                            Bitwise.or colons (Bitwise.shiftLeftBy k 1)

                         else
                            colons
                        )
                        priv
                        inter
                        1

                else
                    csiIgnore bytes n (i + 1) t

        else if b >= 0x3C && b <= 0x3F then
            if phase == 0 then
                csi bytes n (i + 1) t params cur colons b inter 1

            else
                csiIgnore bytes n (i + 1) t

        else if b >= 0x20 && b < 0x30 then
            -- a second intermediate makes one no command has, as none of
            -- Ghostty's takes two (§VC17)
            csi bytes
                n
                (i + 1)
                t
                params
                cur
                colons
                priv
                (if phase >= 3 then
                    0xFF

                 else
                    b
                )
                (if phase == 2 || phase == 4 then
                    4

                 else
                    3
                )

        else if b >= 0x40 && b <= 0x7E then
            -- one call of `dispatch`, so that clang still inlines it (§VC10)
            if colons /= 0 && b /= 0x6D then
                resume bytes n (i + 1) t

            else
                resume bytes
                    n
                    (i + 1)
                    (dispatch b
                        priv
                        inter
                        colons
                        (Builder.toArray
                            (if phase == 2 || phase == 4 then
                                Builder.pushLast cur params

                             else
                                params
                            )
                        )
                        t
                    )

        else if b == 0x1B then
            escape bytes n (i + 1) t

        else if b == 0x18 || b == 0x1A then
            resume bytes n (i + 1) t

        else if b < 0x20 then
            csi bytes n (i + 1) (execute b t) params cur colons priv inter phase

        else if b >= 0x80 && b < 0xA0 then
            c1 bytes n (i + 1) b t

        else
            csi bytes n (i + 1) t params cur colons priv inter phase


csiIgnore : Bytes -> Int -> Int -> (moved t : Term) -> Term
csiIgnore bytes n i t =
    if i >= n then
        { t | ps = psCsiIgnore }

    else
        let
            b =
                byteAt bytes i
        in
        if b >= 0x40 && b <= 0x7E then
            resume bytes n (i + 1) t

        else if b == 0x1B then
            escape bytes n (i + 1) t

        else if b == 0x18 || b == 0x1A then
            resume bytes n (i + 1) t

        else if b < 0x20 then
            csiIgnore bytes n (i + 1) (execute b t)

        else if b >= 0x80 && b < 0xA0 then
            c1 bytes n (i + 1) b t

        else
            csiIgnore bytes n (i + 1) t


param : Int -> Int -> Array Int -> Int
param k default params =
    when Array.get k params is
        Just 0 ->
            default

        Just v ->
            v

        Nothing ->
            default


{-| A CSI sequence's action. SGR and CUP, most of what a program sends, are
taken here, and every other sequence by `dispatchRest`, a call, so that this
function stays small enough for clang to inline into `csi`. With every
sequence in one function it sat just under clang's limit for a function
called once, and three more fields in `Term` pushed it over: an out-of-line
call for each sequence cost `cup` 15 cycles a sequence, 12% of its time.
`dispatchRest` is called from two places, since clang inlines a function
called from only one into its caller whatever its size, and this one would
be too big again (§VC10). -}
dispatch : Int -> Int -> Int -> Int -> Array Int -> (moved t : Term) -> Term
dispatch final priv inter colons params t =
    if priv == 0 && inter == 0 then
        if final == 0x6D then
            withPen (sgr params colons 0 t.attrs) t

        else if final == 0x48 || final == 0x66 then
            if Array.length params <= 2 then
                cursorTo (param 1 1 params - 1) (param 0 1 params - 1) t

            else
                t

        else
            dispatchRest final priv inter params t

    else
        dispatchRest final priv inter params t


dispatchRest : Int -> Int -> Int -> Array Int -> (moved t : Term) -> Term
dispatchRest final priv inter params t =
    if priv == 0 && inter == 0 then
        dispatchRare final params t

    else if final == 0x75 && inter == 0 then
        keyFlags priv params t

    else if priv == 0x3F && inter == 0 then
        if final == 0x68 then
            Array.foldl (\p acc -> setPrivate p True acc) t params

        else if final == 0x57 && params == [ 5 ] then
            -- DECST8C: a stop every eight columns, as Ghostty's tab_reset
            { t | tabs = Builder.fromArray (Array.initialize t.cols 0 (\i -> if modBy 8 i == 0 && i > 0 then 1 else 0)) }

        else if final == 0x6C then
            Array.foldl (\p acc -> setPrivate p False acc) t params

        else if final == 0x73 then
            Array.foldl saveMode t params

        else if final == 0x72 then
            Array.foldl restoreMode t params

        else if Array.length params > 1 then
            t

        else if final == 0x4A then
            eraseDisplay True (param 0 0 params) t

        else if final == 0x4B then
            eraseLine True (param 0 0 params) t

        else if final == 0x6E && param 0 0 params == 6 then
            reply ("\u{001B}[?" ++ String.fromInt (reportY t + 1) ++ ";" ++ String.fromInt (reportX t + 1) ++ ";1R") t

        else
            t

    else if priv == 0x3F && inter == 0x24 && final == 0x70 && Array.length params == 1 then
        let
            p =
                param 0 0 params
        in
        reply ("\u{001B}[?" ++ String.fromInt p ++ ";" ++ String.fromInt (privateState p t) ++ "$y") t

    else if priv == 0 && inter == 0x24 && final == 0x70 && Array.length params == 1 then
        let
            p =
                param 0 0 params
        in
        reply ("\u{001B}[" ++ String.fromInt p ++ ";" ++ String.fromInt (ansiState p t) ++ "$y") t

    else if priv == 0x3E && final == 0x63 && inter == 0 then
        reply "\u{001B}[>1;0;0c" t

    else if priv == 0x3E && final == 0x71 && inter == 0 then
        reply "\u{001B}P>|visiterm\u{001B}\\" t

    else if priv == 0x3D && final == 0x63 && inter == 0 then
        reply "\u{001B}P!|00000000\u{001B}\\" t

    else if priv == 0 && inter == 0x21 && final == 0x70 && Array.length params == 0 then
        softReset t

    else if priv == 0 && inter == 0x22 && final == 0x71 && Array.length params <= 1 then
        let
            p =
                param 0 0 params
        in
        if p == 1 then
            protect 2 t

        else if p == 0 || p == 2 then
            protect 0 t

        else
            t

    else if priv == 0 && inter == 0x2A && final == 0x79 && t.config.checksums && Array.length params <= 6 then
        reply ("\u{001B}P" ++ String.fromInt (param 0 0 params) ++ "!~" ++ hex4 (rectChecksum params t) ++ "\u{001B}\\") t

    else if priv == 0 && inter == 0x23 && final == 0x79 && t.config.checksums && Array.length params <= 1 then
        { t | xtChecksum = Bitwise.and 31 (param 0 0 params) }

    else if priv == 0 && inter == 0x20 && final == 0x71 && Array.length params <= 1 then
        cursorStyle (param 0 0 params) t

    else
        t


{-| The plain sequences `dispatch` does not take itself. Each takes as
many parameters as Ghostty's takes, and one with more is ignored
(§VC16): one for the cursor moves, the erases, the inserts and deletes,
the scrolls, the tabs and REP, two for DECSTBM, and exactly one for DSR
and XTWINOPS 18. -}
dispatchRare : Int -> Array Int -> (moved t : Term) -> Term
dispatchRare final params t =
    if Array.length params > 1 && takesOne final then
        t

    else if zeroIsNothing final && count0 params == 0 then
        t

    else if final == 0x41 || final == 0x6B then
        { t | y = max (upperLimit t) (t.y - param 0 1 params), wrapNext = False }

    else if final == 0x42 then
        { t | y = min (lowerLimit t) (t.y + param 0 1 params), wrapNext = False }

    else if final == 0x65 then
        -- VPR is CUP's row moved, to the screen's bottom or in origin mode
        -- the region's, not CUD (§VC16); by 0 too, which ends a pending
        -- wrap and in origin mode brings the cursor into the region (§VC17)
        cursorTo (originX t) (originY t + count0 params) t

    else if final == 0x61 then
        cursorTo (originX t + count0 params) (originY t) t

    else if final == 0x43 then
        { t
            | x =
                min
                    (if t.x <= t.right then
                        t.right

                     else
                        t.cols - 1
                    )
                    (t.x + param 0 1 params)
            , wrapNext = False
        }

    else if final == 0x44 || final == 0x6A then
        cursorLeft (param 0 1 params) t

    else if final == 0x45 then
        { t | y = min (lowerLimit t) (t.y + param 0 1 params), x = crX t, wrapNext = False }

    else if final == 0x46 then
        { t | y = max (upperLimit t) (t.y - param 0 1 params), x = crX t, wrapNext = False }

    else if final == 0x47 || final == 0x60 then
        if t.origin then
            { t | x = clamp t.left t.right (param 0 1 params - 1 + t.left), wrapNext = False }

        else
            { t | x = clamp 0 (t.cols - 1) (param 0 1 params - 1), wrapNext = False }

    else if final == 0x64 then
        cursorTo (originX t) (param 0 1 params - 1) t

    else if final == 0x49 then
        { t | x = nextTab t.x (param 0 1 params) t }

    else if final == 0x5A then
        { t | x = previousTab t.x (param 0 1 params) t }

    else if final == 0x4A then
        eraseDisplay False (param 0 0 params) t

    else if final == 0x4B then
        eraseLine False (param 0 0 params) t

    else if final == 0x58 then
        eraseChars (param 0 1 params) t

    else if final == 0x40 then
        if not (margined t) then
            let
                s =
                    t.screen
            in
            { t | screen = insertCells (rowOffset s t.y) t.x (param 0 1 params) t.erase s, wrapNext = False }

        else if t.x >= t.left && t.x <= t.right then
            let
                s =
                    t.screen
            in
            { t | screen = insertMargined (rowOffset s t.y) t.x (param 0 1 params) t.right t.erase s, wrapNext = False }

        else
            { t | wrapNext = False }

    else if final == 0x50 then
        if not (margined t) then
            deleteChars (param 0 1 params) (resetWrap (splitAbove (t.x + min (param 0 1 params) (t.cols - t.x)) (splitAbove t.x t)))

        else if t.x >= t.left && t.x <= t.right then
            let
                split =
                    resetWrap (splitAbove (t.x + min (param 0 1 params) (t.right + 1 - t.x)) (splitAbove t.x t))

                s =
                    split.screen
            in
            { split | screen = setWrapped split.y False (deleteMargined (rowOffset s split.y) split.x (param 0 1 params) split.right split.erase s), wrapNext = False }

        else
            t

    else if final == 0x72 && Array.length params <= 2 then
        let
            top =
                param 0 1 params - 1

            bottom =
                min (t.rows - 1) (param 1 t.rows params - 1)
        in
        if top < bottom then
            cursorTo 0 0 (withScroll { t | top = top, bottom = bottom })

        else
            t

    else if final == 0x53 then
        if margined t then
            marginUp (param 0 1 params) t.top t.bottom t

        else
            -- no more rows to the scrollback than the region has; a
            -- region that is not the screen's top, or on the alternate
            -- screen not its bottom, is DL's and its rows stop wrapping, as
            -- in Ghostty (§VC16)
            let
                scrolls =
                    t.top == 0 && (not (isAlt t) || t.bottom == t.rows - 1)

                top =
                    t.top

                bottom =
                    t.bottom

                up =
                    regionUp (min (count0 params) (bottom - top + 1)) top bottom t
            in
            if scrolls then
                up

            else
                unwrapRegion top bottom up

    else if final == 0x54 then
        if margined t then
            marginDown (param 0 1 params) t.top t.bottom t

        else
            unwrapRegion t.top t.bottom (regionDown (param 0 1 params) t.top t.bottom t)

    else if final == 0x4C then
        if t.y < t.top || t.y > t.bottom then
            t

        else if margined t then
            if t.x >= t.left && t.x <= t.right then
                marginDown (param 0 1 params) t.y t.bottom { t | x = t.left, wrapNext = False }

            else
                t

        else
            unwrapRegion t.y t.bottom (regionDown (param 0 1 params) t.y t.bottom { t | x = 0, wrapNext = False })

    else if final == 0x4D then
        if t.y < t.top || t.y > t.bottom then
            t

        else if margined t then
            if t.x >= t.left && t.x <= t.right then
                marginUp (param 0 1 params) t.y t.bottom { t | x = t.left, wrapNext = False }

            else
                t

        else
            unwrapRegion t.y t.bottom (scrollUpBy False (count0 params) t.y t.bottom { t | x = 0, wrapNext = False })

    else if final == 0x62 then
        repeatLast (min 65535 (param 0 1 params)) t

    else if final == 0x67 then
        clearTabs (param 0 0 params) t

    else if final == 0x57 then
        tabControl params t

    else if final == 0x68 then
        Array.foldl (\p acc -> setAnsi p True acc) t params

    else if final == 0x6C then
        Array.foldl (\p acc -> setAnsi p False acc) t params

    else if final == 0x6E && Array.length params == 1 then
        let
            p =
                param 0 0 params
        in
        if p == 6 then
            reply ("\u{001B}[" ++ String.fromInt (reportY t + 1) ++ ";" ++ String.fromInt (reportX t + 1) ++ "R") t

        else if p == 5 then
            reply "\u{001B}[0n" t

        else
            t

    else if final == 0x63 then
        reply primaryAttributes t

    else if final == 0x74 && Array.length params == 1 && (param 0 0 params == 18 || param 0 0 params == 19) then
        -- 19, the screen's size, is the text area's as in Ghostty and VTE
        reply ("\u{001B}[" ++ String.fromInt (param 0 0 params - 10) ++ ";" ++ String.fromInt t.rows ++ ";" ++ String.fromInt t.cols ++ "t") t

    else if final == 0x73 then
        -- CSI s is SCOSC, or with left and right margins on (?69) DECSLRM;
        -- with parameters it is DECSLRM, which does nothing with them off
        -- (`CSI 0 s` among them, §VC16); with more than two, nothing
        if Array.length params > 2 then
            t

        else if Dict.get 69 t.modes == Just True then
            setMargins (param 0 1 params) (param 1 t.cols params) t

        else if Array.length params == 0 then
            saveCursor t

        else
            t

    else if final == 0x75 then
        restoreCursor t

    else
        t


{-| A count, 1 when there is no parameter, and 0 when it is 0. -}
count0 : Array Int -> Int
count0 params =
    Maybe.withDefault 1 (Array.first params)


{-| The finals whose count of 0 does nothing, as in Ghostty, where for the
rest 0 is 1 (§VC16): CHT, CBT, IL, DL, DCH, SU and SD. HPR and VPR by 0
move as CUP does, to where the cursor is (§VC17). -}
zeroIsNothing : Int -> Bool
zeroIsNothing final =
    final == 0x49
        || final == 0x5A
        || final == 0x4C
        || final == 0x4D
        || final == 0x50
        || final == 0x53
        || final == 0x54


{-| The finals that take one parameter at most. -}
takesOne : Int -> Bool
takesOne final =
    (final >= 0x40 && final <= 0x47)
        || final == 0x4A
        || final == 0x4B
        || final == 0x4C
        || final == 0x4D
        || final == 0x50
        || final == 0x53
        || final == 0x54
        || final == 0x58
        || final == 0x5A
        || final == 0x49
        || final == 0x60
        || final == 0x61
        || final == 0x62
        || final == 0x64
        || final == 0x65
        || final == 0x67
        || final == 0x6A
        || final == 0x6B


{-| DA1's answer, and DECID's: a VT220 with ANSI colour, as libghostty-vt
answers when its embedder does not say otherwise (§VC10). -}
primaryAttributes : String
primaryAttributes =
    "\u{001B}[?62;22c"


{-| BS and CUB: `n` columns left. With autowrap and reverse wraparound
(?45), a move past the first column goes on from the last column of the row
above if that row wrapped into this one, and stops at the region's top; with
the extended form (?1045) it goes on whether the row wrapped or not, and from
the region's top to its bottom. A pending wrap takes one of the `n`. As xterm
and Ghostty do (§VC12). -}
cursorLeft : Int -> (moved t : Term) -> Term
cursorLeft n t =
    let
        mode =
            if not t.autowrap then
                0

            else if Dict.get 1045 t.modes == Just True then
                2

            else if Dict.get 45 t.modes == Just True then
                1

            else
                0
    in
    if mode == 0 then
        -- the left margin stops it, unless it starts left of the margin
        { t | x = max (if t.x < t.left then 0 else t.left) (t.x - n), wrapNext = False }

    else
        let
            count =
                if t.wrapNext then
                    n - 1

                else
                    n

            -- the left margin, or the first column from left of it
            lm =
                if t.x < t.left then
                    0

                else
                    t.left
        in
        if count <= 0 then
            { t | wrapNext = False }

        else if t.x == lm && mode == 1 && t.y <= t.top then
            { t | x = lm, y = t.top, wrapNext = False }

        else
            reverseLeft mode lm count { t | wrapNext = False }


reverseLeft : Int -> Int -> Int -> (moved t : Term) -> Term
reverseLeft mode lm count t0 =
    let
        amount =
            min (t0.x - lm) count

        rest =
            count - amount

        t =
            { t0 | x = t0.x - amount }
    in
    if rest == 0 then
        t

    else if t.y == t.top then
        if mode == 2 then
            reverseLeft mode lm (rest - 1) { t | x = t.right, y = t.bottom }

        else
            t

    else if t.y == 0 then
        t

    else if mode == 1 && not (rowWrapped (t.y - 1) t.screen) then
        t

    else
        reverseLeft mode lm (rest - 1) { t | x = t.right, y = t.y - 1 }


rowWrapped : Int -> Screen -> Bool
rowWrapped y s =
    Bitwise.and wrappedBit (metaAt (rowOffset s y) s) /= 0


-- LEFT AND RIGHT MARGINS


{-| Whether DECSLRM has narrowed the margins. Narrowed, printing takes the
general path and the scrolls, inserts and deletes work on the columns
between them (§VC13). -}
margined : Term -> Bool
margined t =
    t.left > 0 || t.right < t.cols - 1


{-| NEL's and LNM's CR, after the line feed, so that a cursor right of the
margins at the region's bottom does not scroll, as in Ghostty. -}
carriageReturn : (moved t : Term) -> Term
carriageReturn t =
    { t | x = crX t, wrapNext = False }


{-| Where CR takes the cursor: the left margin, or the first column from
left of it outside origin mode. -}
crX : Term -> Int
crX t =
    if t.left == 0 then
        0

    else if t.origin || t.x >= t.left then
        t.left

    else
        0


{-| The column printing wraps after, plus one: the right margin, or the
screen's last column from right of it. -}
rightEdge : Term -> Int
rightEdge t =
    if t.x <= t.right then
        t.right + 1

    else
        t.cols


tabFloor : Term -> Int
tabFloor t =
    if t.origin then
        t.left

    else
        0


{-| DECSLRM, columns from 1, as Ghostty sets them: the cursor home after. -}
setMargins : Int -> Int -> (moved t : Term) -> Term
setMargins l r t =
    let
        left =
            max 1 l

        right =
            min t.cols r
    in
    if left >= right then
        t

    else
        cursorTo 0 0 (withScroll (withPlain { t | left = left - 1, right = right - 1 }))


{-| The cursor's column as a report gives it: from the left margin in origin
mode. -}
reportX : Term -> Int
reportX t =
    if t.origin then
        max 0 (t.x - t.left)

    else
        t.x


{-| Rows `top` to `bottom`, between the margins, scrolled up `count`: SU,
DL, and IND at the region's bottom. -}
marginUp : Int -> Int -> Int -> (moved t : Term) -> Term
marginUp count top bottom t =
    let
        n =
            min (max 1 count) (bottom - top + 1)
    in
    { t | screen = clearSpans (bottom - n + 1) bottom t.left t.right t.erase (copyUp (top + n) bottom n t.left t.right t.screen) }


{-| Rows `top` to `bottom`, between the margins, scrolled down `count`: SD,
IL, and RI at the region's top. -}
marginDown : Int -> Int -> Int -> (moved t : Term) -> Term
marginDown count top bottom t =
    let
        n =
            min (max 1 count) (bottom - top + 1)
    in
    { t | screen = clearSpans top (top + n - 1) t.left t.right t.erase (copyDown (bottom - n) top n t.left t.right t.screen) }


{-| Rows `y` to `last`, each copied `n` rows up, between the columns. -}
copyUp : Int -> Int -> Int -> Int -> Int -> (moved s : Screen) -> Screen
copyUp y last n left right s =
    if y > last then
        s

    else
        copyUp (y + 1) last n left right (copySpan y (y - n) left right s)


{-| Rows `y` down to `first`, each copied `n` rows down. -}
copyDown : Int -> Int -> Int -> Int -> Int -> (moved s : Screen) -> Screen
copyDown y first n left right s =
    if y < first then
        s

    else
        copyDown (y - 1) first n left right (copySpan y (y + n) left right s)


clearSpans : Int -> Int -> Int -> Int -> Int64 -> (moved s : Screen) -> Screen
clearSpans y last left right fill s =
    if y > last then
        s

    else
        clearSpans (y + 1) last left right fill (clearSpan y left right fill s)


{-| Columns `left` to `right` of row `src` copied to row `dst`; a wide
character the margins cut, in either row, goes. -}
copySpan : Int -> Int -> Int -> Int -> (moved s0 : Screen) -> Screen
copySpan src dst left right s0 =
    let
        so =
            rowOffset s0 src

        dO =
            rowOffset s0 dst

        reach =
            min s0.cols (right + 2)

        s =
            widenTo dO reach (widenTo so reach s0)

        cut =
            shifted dO s.cols left right (shifted so s.cols left right s.cells)
    in
    trim dO (trim so { s | cells = Builder.copyWithin (dO + left) (so + left) (so + right + 1) cut })


clearSpan : Int -> Int -> Int -> Int64 -> (moved s0 : Screen) -> Screen
clearSpan y left right fill s0 =
    let
        o =
            rowOffset s0 y

        s =
            widenTo o (min s0.cols (right + 2)) s0
    in
    trim o { s | cells = Builder.fill (o + left) (o + right + 1) fill (shifted o s.cols left right s.cells) }


{-| ICH between the margins: the cells from `x` to `right` move right, those
past `right` lost. -}
insertMargined : Int -> Int -> Int -> Int -> Int64 -> (moved s0 : Screen) -> Screen
insertMargined o x count right erase s0 =
    let
        s =
            widen o s0

        n =
            min (max 1 count) (right - x + 1)

        cut =
            cutAt erase o s.cols (right + 1 - n) (cutAt erase o s.cols (right + 1) (cutAt erase o s.cols x s.cells))

        moved =
            if right + 1 - n > x then
                Builder.copyWithin (o + x + n) (o + x) (o + right + 1 - n) cut

            else
                cut
    in
    trim o { s | cells = Builder.fill (o + x) (o + x + n) erase moved }


{-| DCH between the margins: the cells past the deleted ones, to `right`,
move left, and the erase cell comes in at `right`. -}
deleteMargined : Int -> Int -> Int -> Int -> Int64 -> (moved s0 : Screen) -> Screen
deleteMargined o x count right erase s0 =
    let
        s =
            widen o s0

        n =
            min (max 1 count) (right - x + 1)

        cut =
            cutAt erase o s.cols (right + 1) (cutAt erase o s.cols (x + n) (cutAt erase o s.cols x s.cells))

        moved =
            if x + n <= right then
                Builder.copyWithin (o + x) (o + x + n) (o + right + 1) cut

            else
                cut
    in
    trim o { s | cells = Builder.fill (o + right + 1 - n) (o + right + 1) erase moved }


{-| The row at `o` with every cell explicit: those past its extent made
empty and its extent the row's width, its wrapped flag kept. -}
widen : Int -> (moved s : Screen) -> Screen
widen o s =
    let
        m =
            metaAt o s
    in
    { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt s.cols)) (reachAt o (metaExtent m) s.cols s.cells) }


{-| The row at `o` with every cell before column `x` explicit, as `widen`
makes it but only that far. A span between the margins reads its row only to
the column past the right margin, so it widens that far and not to the row's
width: a scroll inside narrow margins costs the margins' width a row, not the
screen's (§VC11's timeout). -}
widenTo : Int -> Int -> (moved s : Screen) -> Screen
widenTo o x s =
    let
        m =
            metaAt o s

        e =
            metaExtent m
    in
    if x > e then
        { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt x)) (Builder.fill (o + e) (o + x) 0 s.cells) }

    else
        s


{-| The row at `o`'s extent brought back to its last cell that is not
empty. -}
trim : Int -> (moved s : Screen) -> Screen
trim o s =
    let
        m =
            metaAt o s
    in
    { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt (lastFilled o (metaExtent m) s.cells))) s.cells }


lastFilled : Int -> Int -> Builder Int64 -> Int
lastFilled o e cells =
    if e <= 0 then
        0

    else if Maybe.withDefault 0 (Builder.get (o + e - 1) cells) == 0 then
        lastFilled o (e - 1) cells

    else
        e


{-| A row about to have columns `left` to `right` shifted, as Ghostty's
`rowWillBeShifted` readies it (§VC17): a wide character either margin cuts
loses its content, both halves narrow and in their style, and when the
margins reach the row's end or the first two columns, a spacer head at its
end is a narrow cell. -}
shifted : Int -> Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
shifted o cols left right cells =
    let
        last =
            Maybe.withDefault 0 (Builder.get (o + cols - 1) cells)

        ended =
            if (right == cols - 1 || left < 2) && cellWide last == spacerHead then
                Builder.set (o + cols - 1) (Bitwise.and (Bitwise.complement 0x600000) last) cells

            else
                cells
    in
    cutKeeping o cols (right + 1) (cutKeeping o cols left ended)


{-| `cutAt`, the halves keeping their style and protection. -}
cutKeeping : Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
cutKeeping o cols c cells =
    if c <= 0 || c >= cols then
        cells

    else
        let
            tail =
                Maybe.withDefault 0 (Builder.get (o + c) cells)

            head =
                Maybe.withDefault 0 (Builder.get (o + c - 1) cells)
        in
        if cellWide tail == wideTail then
            Builder.set (o + c - 1) (Bitwise.and (Bitwise.complement 0xFFFFFF) head) (Builder.set (o + c) (Bitwise.and (Bitwise.complement 0xFFFFFF) tail) cells)

        else
            cells


{-| A wide character that a boundary before column `c` cuts in two, both
halves made `fill`, the erase cell, as Ghostty clears them (§VC18). -}
cutAt : Int64 -> Int -> Int -> Int -> (moved cells : Builder Int64) -> Builder Int64
cutAt fill o cols c cells =
    if c <= 0 || c >= cols then
        cells

    else if cellWide (Maybe.withDefault 0 (Builder.get (o + c) cells)) == wideTail then
        Builder.set (o + c - 1) fill (Builder.set (o + c) fill cells)

    else
        cells


{-| The cursor's row as a report gives it: from the region's top in origin
mode. -}
reportY : Term -> Int
reportY t =
    if t.origin then
        max 0 (t.y - t.top)

    else
        t.y


{-| CUP: column `x`, row `y`, from the region's top in origin mode. -}
cursorTo : Int -> Int -> (moved t : Term) -> Term
cursorTo x y t =
    if t.origin then
        { t | x = clamp t.left t.right (x + t.left), y = clamp t.top t.bottom (y + t.top), wrapNext = False }

    else
        { t | x = clamp 0 (t.cols - 1) x, y = clamp 0 (t.rows - 1) y, wrapNext = False }


{-| The cursor's column and row as CUP gives them, from the margins in
origin mode. -}
originX : Term -> Int
originX t =
    if t.origin then
        max 0 (t.x - t.left)

    else
        t.x


originY : Term -> Int
originY t =
    if t.origin then
        max 0 (t.y - t.top)

    else
        t.y


{-| How far up CUU goes: the region's top when the cursor is in it. -}
upperLimit : Term -> Int
upperLimit t =
    if t.y >= t.top then
        t.top

    else
        0


lowerLimit : Term -> Int
lowerLimit t =
    if t.y <= t.bottom then
        t.bottom

    else
        t.rows - 1


-- MODES


setPrivate : Int -> Bool -> (moved t : Term) -> Term
setPrivate p on t =
    if p == 47 || p == 1047 || p == 1048 || p == 1049 then
        -- recorded as well, as Ghostty records every mode before it acts,
        -- so DECRQM answers what was set last, not which screen shows
        -- (§VC17)
        screenMode p on { t | modes = Dict.set p on t.modes }

    else if p == 6 then
        cursorTo 0 0 { t | origin = on }

    else if p == 7 then
        withPlain { t | autowrap = on }

    else if p == 25 then
        { t | showCursor = on }

    else if p == 3 then
        deccolm on t

    else if p == 69 then
        if on then
            { t | modes = Dict.set 69 True t.modes }

        else
            withScroll (withPlain { t | modes = Dict.set 69 False t.modes, left = 0, right = t.cols - 1 })

    else
        { t | modes = Dict.set p on t.modes }


{-| DECCOLM (?3), Ghostty's `deccolm`: with ?40 set, the terminal resized
to 132 columns or 80, as a host resizes it, its lines reflowed, then erased
as ED 2 erases it and the cursor put home; without, ignored and recorded
reset (§VC18). -}
deccolm : Bool -> (moved t : Term) -> Term
deccolm on t =
    if Dict.get 40 t.modes /= Just True then
        { t | modes = Dict.set 3 False t.modes }

    else
        let
            cols =
                if on then
                    132

                else
                    80

            rows =
                t.rows
        in
        cursorTo 0 0 (eraseDisplay False 2 (resize cols rows { t | modes = Dict.set 3 on t.modes }))


screenMode : Int -> Bool -> (moved t : Term) -> Term
screenMode p on t =
    if p == 1049 then
        if on then
            if isAlt t then
                -- again on the alternate screen: the cursor saved and the
                -- screen erased, as Ghostty does (§VC16)
                eraseDisplay False 2 (saveCursor t)

            else
                toAlt True (saveCursor t)

        else
            restoreCursor (toMain False t)

    else if p == 1048 then
        if on then
            saveCursor t

        else
            restoreCursor t

    else if p == 1047 then
        if on then
            toAlt False t

        else
            toMain True t

    else if p == 47 then
        if on then
            toAlt False t

        else
            toMain False t

    else
        t


{-| XTSAVE: a private mode's state kept for XTRESTORE, one each. -}
saveMode : Int -> (moved t : Term) -> Term
saveMode p t =
    let
        state =
            privateState p t
    in
    if state == 1 || state == 2 then
        { t | savedModes = Dict.set p (state == 1) t.savedModes }

    else
        t


{-| XTRESTORE: a private mode set as XTSAVE kept it, or to its state in a
new terminal if it was never kept, as Ghostty restores it. -}
restoreMode : Int -> (moved t : Term) -> Term
restoreMode p t =
    when Dict.get p t.savedModes is
        Just on ->
            setPrivate p on t

        Nothing ->
            let
                state =
                    privateState p (fresh t.config)
            in
            if state == 1 || state == 2 then
                setPrivate p (state == 1) t

            else
                t


{-| DECRQM's answer for a mode the core keeps: 1 set, 2 reset. -}
of : Bool -> Int
of on =
    if on then
        1

    else
        2


{-| DECRQM's state of private mode `p`: 1 set, 2 reset, 0 not recognised.
`of` is a function of its own, not a `let`'s: a local function is a value
to geng-lang's `inplace` pass, and a call of one with a field of `t` kept
`t`, which made every update of the term along the parser's paths a copy
(§VC7). -}
privateState : Int -> Term -> Int
privateState p t =
    if p == 6 then
        of t.origin

    else if p == 7 then
        of t.autowrap

    else if p == 25 then
        of t.showCursor

    else if not (Array.member p knownPrivate) then
        -- a mode Ghostty does not know is not recognised, set or not
        0

    else
        when Dict.get p t.modes is
            Just on ->
                of on

            Nothing ->
                if Array.member p [ 1007, 1035, 1036 ] then
                    -- set until changed, as Ghostty's defaults
                    1

                else
                    2


{-| The private modes DECRQM answers for although the core only records
them: Ghostty's table (`modes.zig`), where 1007, 1035 and 1036 are set
until changed (§VC17). Not 5522, kitty's paste events, which Ghostty
reports as unrecognised without a clipboard to read, and the core has none
(§VC18). -}
knownPrivate : Array Int
knownPrivate =
    [ 1, 3, 4, 5, 8, 9, 12, 40, 45, 47, 66, 67, 69, 1000, 1002, 1003, 1004, 1005, 1006, 1007, 1015, 1016, 1035, 1036, 1039, 1045, 1047, 1048, 1049, 2004, 2026, 2027, 2031, 2033, 2048 ]


setAnsi : Int -> Bool -> (moved t : Term) -> Term
setAnsi p on t =
    if p == 4 then
        withPlain { t | insert = on }

    else if p == 20 then
        { t | newline = on }

    else if p == 2 || p == 12 then
        { t | modes = Dict.set (ansiKey p) on t.modes }

    else
        t


{-| Where `modes` keeps an ANSI mode the core only records, apart from the
private modes. -}
ansiKey : Int -> Int
ansiKey p =
    -1000 - p


ansiState : Int -> Term -> Int
ansiState p t =
    if p == 4 then
        of t.insert

    else if p == 20 then
        of t.newline

    else if p == 2 || p == 12 then
        of (Maybe.withDefault (p == 12) (Dict.get (ansiKey p) t.modes))

    else if Array.member p [ 1, 5, 7, 10, 11, 13, 14, 15, 16, 17, 18, 19 ] then
        -- GATM, SRTM, VEM, HEM, PUM, FEAM, FETM, MATM, TTM, SATM, TSM and EBM
        -- are permanently reset, as in xterm and Ghostty.
        4

    else
        0


{-| The alternate screen shown, cleared first when `clear`. Once made it is
kept, its text and its saved cursor, while the main screen is shown, as xterm
and Ghostty keep it (§VC10). -}
toAlt : Bool -> (moved t : Term) -> Term
toAlt clear t =
    if isAlt t then
        if clear then
            { t | screen = clearAlt t.protectMode t.rows t.screen }

        else
            t

    else
        let
            main =
                t.screen

            alt =
                when t.other is
                    Just kept ->
                        if clear then
                            clearAlt t.otherProtect t.rows kept

                        else
                            kept

                    Nothing ->
                        newScreen t.cols t.rows (t.rows + 1)
        in
        withScroll { t | other = Just main, screen = alt, alt = True, hidden = { x = t.x, y = t.y, wrap = t.wrapNext }, keys = t.otherKeys, otherKeys = t.keys, protectMode = t.otherProtect, otherProtect = t.protectMode }


{-| The alternate screen cleared, as Ghostty's ED 2: its protected cells
kept when its protection was last ISO's, SPA's (§VC18). -}
clearAlt : Int -> Int -> (moved s : Screen) -> Screen
clearAlt mode rows s =
    if mode == 1 then
        blankUnprotected 0 rows 0 s

    else
        blankRows 0 rows 0 s


isAlt : Term -> Bool
isAlt t =
    t.alt


{-| The main screen shown again, the alternate cleared first when `clear`
and kept. -}
toMain : Bool -> (moved t : Term) -> Term
toMain clear t =
    if not t.alt then
        t

    else
        when t.other is
            Just main ->
                let
                    alt =
                        if clear then
                            clearAlt t.protectMode t.rows t.screen

                        else
                            t.screen
                in
                -- cleared, the alternate screen is erased as ED 2 does,
                -- which ends a pending wrap before the cursor is carried
                -- over, as in Ghostty (§VC17)
                withScroll { t | other = Just alt, screen = main, alt = False, hidden = { x = t.x, y = t.y, wrap = t.wrapNext && not clear }, keys = t.otherKeys, otherKeys = t.keys, protectMode = t.otherProtect, otherProtect = t.protectMode, wrapNext = t.wrapNext && not clear }

            Nothing ->
                t


{-| DECSCUSR: the cursor's shape (1 a block, 3 an underline, 5 a bar) and
whether it blinks, which is mode 12, as Ghostty keeps it. 0 is the default,
a steady block. -}
cursorStyle : Int -> (moved t : Term) -> Term
cursorStyle p t =
    if p == 0 then
        { t | cursorShape = 1, modes = Dict.set 12 False t.modes }

    else if p >= 1 && p <= 6 then
        { t | cursorShape = p - 1 + modBy 2 p, modes = Dict.set 12 (modBy 2 p == 1) t.modes }

    else
        t


{-| SPA (ESC V, `how` 1), DECSCA 1 (2), and EPA or DECSCA 0 or 2 (0): what
the cursor writes from now on is protected, or not. The mode, ISO's or
DEC's, is what ED, EL and ECH go by, and stopping protection does not
change it, as in Ghostty. -}
protect : Int -> (moved t : Term) -> Term
protect how t =
    if how == 0 then
        { t | guard = 0, pen = Bitwise.and (Bitwise.complement protectBit) t.pen }

    else
        { t | guard = protectBit, protectMode = how, pen = Bitwise.or protectBit t.pen }


saveCursor : (moved t : Term) -> Term
saveCursor t =
    let
        s =
            t.screen
    in
    { t
        | screen =
            { s
                | saved =
                    { x = t.x
                    , y = t.y
                    , attrs = t.attrs
                    , wrapNext = t.wrapNext
                    , origin = t.origin
                    , sets = t.sets
                    , gl = t.gl
                    , single = t.single
                    , guard = t.guard
                    , isSet = True
                    }
            }
    }


restoreCursor : (moved t : Term) -> Term
restoreCursor t =
    let
        v =
            t.screen.saved
    in
    withPlain <| withPen v.attrs
        { t
            | x = min (t.cols - 1) v.x
            , y = min (t.rows - 1) v.y
            , wrapNext = v.wrapNext
            , origin = v.origin
            , sets = v.sets
            , gl = v.gl
            , single = v.single
            , guard = v.guard
            , pen = Bitwise.or v.guard (Bitwise.and (Bitwise.complement protectBit) t.pen)
        }


{-| RIS: the terminal as new, its replies kept, and the dynamic colours
(OSC 10 to 19), which Ghostty's full reset keeps as its DECSTR does; the
palette is reset (§VC16). -}
reset : Term -> Term
reset t =
    let
        replies =
            t.replies

        blank =
            fresh t.config
    in
    withScroll { blank | replies = replies, colours = Dict.keepIf (\k _ -> k > 255) t.colours }


{-| DECSTR. Like RIS, it brings back the checksum XTCHECKSUM changed (V14). -}
softReset : (moved t : Term) -> Term
softReset t =
    withPen plainAttrs
        (withScroll
            { t
                | top = 0
                , bottom = t.rows - 1
                , insert = False
                , origin = False
                , autowrap = True
                , showCursor = True
                , sets = 0
                , gl = 0
                , single = -1
                , cursorShape = 1
                , modes = Array.foldl Dict.remove (Dict.set 12 False t.modes) softResetModes
                , guard = 0
                , protectMode = 0
                , left = 0
                , right = t.cols - 1
                , pen = Bitwise.and (Bitwise.complement protectBit) t.pen
                , colours = Dict.keepIf (\k _ -> k > 255) t.colours
                , xtChecksum = 23
            }
        )
        |> resetSaved
        |> withPlain


{-| The recorded modes DECSTR resets besides the ones `softReset` names, as
Ghostty's soft reset does: cursor keys, reverse wraparound and its extended
form, the numeric keypad (?66, which ESC = and ESC > set as well, as in
Ghostty), left and right margins, and KAM. -}
softResetModes : Array Int
softResetModes =
    [ 1, 45, 66, 69, 1045, ansiKey 2 ]


resetSaved : (moved t : Term) -> Term
resetSaved t =
    let
        s =
            t.screen
    in
    { t | screen = { s | saved = noSaved } }


{-| `plain` kept to what it says: GL is ASCII, autowrap is on and insert is
off, which is when the ground state's fast paths may write a run (§VC5).
Set wherever any of the four changes. -}
withPlain : (moved t : Term) -> Term
withPlain t =
    { t | plain = t.single < 0 && slotSet t.gl t == 0 && t.autowrap && not t.insert && not (margined t) }


-- TABS


nextTab : Int -> Int -> Term -> Int
nextTab x count t =
    if count <= 0 || x >= t.right then
        x

    else
        nextTab (stopAfter (x + 1) t) (count - 1) t


stopAfter : Int -> Term -> Int
stopAfter x t =
    if x >= t.right then
        t.right

    else if Builder.get x t.tabs == Just 1 then
        x

    else
        stopAfter (x + 1) t


previousTab : Int -> Int -> Term -> Int
previousTab x count t =
    if count <= 0 || x <= tabFloor t then
        x

    else
        previousTab (stopBefore (x - 1) t) (count - 1) t


stopBefore : Int -> Term -> Int
stopBefore x t =
    if x <= tabFloor t then
        tabFloor t

    else if Builder.get x t.tabs == Just 1 then
        x

    else
        stopBefore (x - 1) t


{-| CTC as Ghostty takes it (§VC17): 0 or nothing sets a stop at the
cursor, 2 clears it and 5 clears them all; anything else, or more than one
parameter, does nothing. -}
tabControl : Array Int -> (moved t : Term) -> Term
tabControl params t =
    if params == [] || params == [ 0 ] then
        { t | tabs = Builder.set t.x 1 t.tabs }

    else if params == [ 2 ] then
        clearTabs 0 t

    else if params == [ 5 ] then
        clearTabs 3 t

    else
        t


clearTabs : Int -> (moved t : Term) -> Term
clearTabs how t =
    if how == 0 then
        { t | tabs = Builder.set t.x 0 t.tabs }

    else if how == 3 then
        { t | tabs = Builder.fill 0 t.cols 0 t.tabs }

    else
        t


-- STYLES


{-| The pen made from `attrs`, and the cell an erase writes: empty, in the
pen's background alone. A style with no underline colour is looked up in
`styleCache` first, which maps its key to both ids. -}
withPen : Attrs -> (moved t : Term) -> Term
withPen attrs t =
    if attrs == t.attrs then
        t

    else if attrs.ulc /= 0 then
        withPenInterned attrs t

    else
        let
            key =
                styleKey attrs

            h =
                cacheSlot key

            hit =
                Builder.get h t.styleCache == Just key
        in
        if hit then
            let
                ids =
                    Maybe.withDefault 0 (Builder.get (h + 1) t.styleCache)
            in
            { t
                | attrs = attrs
                , pen = Bitwise.or t.guard (Bitwise.shiftLeftBy 32 (Bitwise.and 0xFFFF ids))
                , erase = eraseCell (Bitwise.shiftLeftBy 16 (Bitwise.and 0xFFFF0000 ids))
            }

        else
            let
                set =
                    withPenInterned attrs t

                ids =
                    Bitwise.or (Bitwise.and 0xFFFF (Bitwise.shiftRightZfBy 32 set.pen)) (Bitwise.shiftRightZfBy 16 (Bitwise.and highMask set.erase))
            in
            { set | styleCache = Builder.set (h + 1) ids (Builder.set h key set.styleCache) }


withPenInterned : Attrs -> (moved t : Term) -> Term
withPenInterned attrs t =
    let
        pen =
            intern attrs t.styles

        erase =
            if attrs.bg == 0 then
                { id = 0, styles = pen.styles }

            else
                intern { plainAttrs | bg = attrs.bg } pen.styles
    in
    { t | attrs = attrs, pen = Bitwise.or t.guard (styleBits pen.id), erase = eraseCell (styleBits erase.id), styles = erase.styles }


eraseCell : Int64 -> Int64
eraseCell style =
    if style == 0 then
        0

    else
        Bitwise.or bgBit style


styleCacheSize : Int
styleCacheSize =
    512


{-| The cache's slot for a style's key: its key at the slot, and its pen's
id and its erase cell's id, 16 bits each, after it. -}
cacheSlot : Int64 -> Int
cacheSlot key =
    let
        mixed =
            Bitwise.xor key (Bitwise.xor (Bitwise.shiftRightZfBy 17 key) (Bitwise.shiftRightZfBy 37 key))
    in
    2 * Int64.toIntWrap (Bitwise.and (Int64.fromInt (styleCacheSize - 1)) mixed)


sgr : Array Int -> Int -> Int -> Attrs -> Attrs
sgr params colons k a =
    if Array.length params == 0 then
        -- `CSI m`, which has no parameters (§VC16)
        { fg = 0, bg = 0, ulc = 0, flags = 0, ul = 0 }

    else
        sgrLoop params colons k a.fg a.bg a.ulc a.flags a.ul


{-| SGR's parameters from `k` on, each attribute a number of its own, so
that a parameter changes no record (§VC7). -}
sgrLoop : Array Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Attrs
sgrLoop params colons k fg bg ulc flags ul =
    if k >= Array.length params then
        { fg = fg, bg = bg, ulc = ulc, flags = flags, ul = ul }

    else
        let
            p =
                Maybe.withDefault 0 (Array.get k params)

            next =
                k + 1
        in
        if colons /= 0 && Bitwise.and colons (Bitwise.shiftLeftBy k 1) /= 0 && p /= 4 && p /= 38 && p /= 48 && p /= 58 then
            -- a colon after a parameter that takes none: it and what the
            -- colons join to it are skipped, as Ghostty does (§VC16)
            sgrLoop params colons (pastColons colons next) fg bg ulc flags ul

        else
        when p is
            0 ->
                sgrLoop params colons next 0 0 0 0 0

            1 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 1) ul

            2 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 2) ul

            3 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 4) ul

            4 ->
                if Bitwise.and colons (Bitwise.shiftLeftBy k 1) /= 0 then
                    -- Ghostty's `4:`: nothing with no style after it, the
                    -- group skipped with a colon after the style, and a
                    -- style it does not know a single underline (§VC17)
                    if next >= Array.length params then
                        sgrLoop params colons next fg bg ulc flags ul

                    else if Bitwise.and colons (Bitwise.shiftLeftBy next 1) /= 0 then
                        sgrLoop params colons (pastColons colons k) fg bg ulc flags ul

                    else
                        let
                            style =
                                Maybe.withDefault 1 (Array.get next params)
                        in
                        sgrLoop params colons (k + 2) fg bg ulc flags (if style >= 0 && style <= 5 then style else 1)

                else
                    sgrLoop params colons next fg bg ulc flags 1

            5 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 8) ul

            6 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 8) ul

            7 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 16) ul

            8 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 32) ul

            9 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 64) ul

            21 ->
                sgrLoop params colons next fg bg ulc flags 2

            22 ->
                sgrLoop params colons next fg bg ulc (Bitwise.and flags (Bitwise.complement 3)) ul

            23 ->
                sgrLoop params colons next fg bg ulc (Bitwise.and flags (Bitwise.complement 4)) ul

            24 ->
                sgrLoop params colons next fg bg ulc flags 0

            25 ->
                sgrLoop params colons next fg bg ulc (Bitwise.and flags (Bitwise.complement 8)) ul

            27 ->
                sgrLoop params colons next fg bg ulc (Bitwise.and flags (Bitwise.complement 16)) ul

            28 ->
                sgrLoop params colons next fg bg ulc (Bitwise.and flags (Bitwise.complement 32)) ul

            29 ->
                sgrLoop params colons next fg bg ulc (Bitwise.and flags (Bitwise.complement 64)) ul

            38 ->
                let
                    c =
                        extendedColour params colons k
                in
                sgrLoop params colons (colourNext c) (colourOr fg c) bg ulc flags ul

            39 ->
                sgrLoop params colons next 0 bg ulc flags ul

            48 ->
                let
                    c =
                        extendedColour params colons k
                in
                sgrLoop params colons (colourNext c) fg (colourOr bg c) ulc flags ul

            49 ->
                sgrLoop params colons next fg 0 ulc flags ul

            53 ->
                sgrLoop params colons next fg bg ulc (Bitwise.or flags 128) ul

            55 ->
                sgrLoop params colons next fg bg ulc (Bitwise.and flags (Bitwise.complement 128)) ul

            58 ->
                let
                    c =
                        extendedColour params colons k
                in
                sgrLoop params colons (colourNext c) fg bg (colourOr ulc c) flags ul

            59 ->
                sgrLoop params colons next fg bg 0 flags ul

            _ ->
                if p >= 30 && p <= 37 then
                    sgrLoop params colons next (p - 30 + 1) bg ulc flags ul

                else if p >= 40 && p <= 47 then
                    sgrLoop params colons next fg (p - 40 + 1) ulc flags ul

                else if p >= 90 && p <= 97 then
                    sgrLoop params colons next (p - 90 + 9) bg ulc flags ul

                else if p >= 100 && p <= 107 then
                    sgrLoop params colons next fg (p - 100 + 9) ulc flags ul

                else
                    sgrLoop params colons next fg bg ulc flags ul


{-| `extendedColour`'s answer is the parameter after the colour times 2²⁶,
and the colour and one more below it, 0 when there is no colour: one `Int`,
so that a colour allocates nothing. -}
colourNext : Int -> Int
colourNext c =
    Bitwise.shiftRightZfBy 26 c


colourOr : Int -> Int -> Int
colourOr old c =
    let
        v =
            Bitwise.and 0x3FFFFFF c
    in
    if v == 0 then
        old

    else
        v - 1


packColour : Int -> Int -> Int
packColour colour next =
    Bitwise.or (Bitwise.shiftLeftBy 26 next) (colour + 1)


{-| The index past a run of parameters joined by colons, from `i`. -}
pastColons : Int -> Int -> Int
pastColons colons i =
    if Bitwise.and colons (Bitwise.shiftLeftBy i 1) /= 0 then
        pastColons colons (i + 1)

    else
        i + 1


{-| The colour of SGR 38, 48 or 58 at `k`, and the parameter after it
(`packColour`), by Ghostty's rules (§VC16): `5` and an index, the index
taken modulo 256; or `2` and red, green and blue, which with colons may
carry a colour space before them, three or four parameters joined to the
`2`, and with any other count the colons' run is skipped. A colour that is
not one is -1, and then only the 38 is passed over, so that what follows is
read as SGR of its own (`38;5` is blink). -}
extendedColour : Array Int -> Int -> Int -> Int
extendedColour params colons k =
    let
        get j =
            Maybe.withDefault 0 (Array.get j params)

        len =
            Array.length params - k

        kind =
            get (k + 1)
    in
    if len >= 3 && kind == 5 then
        packColour (Bitwise.and 0xFF (get (k + 2)) + 1) (k + 3)

    else if len >= 2 && kind == 2 then
        if len < 5 then
            packColour -1 (k + 1)

        else if Bitwise.and colons (Bitwise.shiftLeftBy k 1) == 0 then
            packColour (rgbAt params (k + 2)) (k + 5)

        else
            let
                joined =
                    colonRun colons (Array.length params - 1) (k + 1) 0
            in
            if joined == 3 then
                packColour (rgbAt params (k + 2)) (k + 5)

            else if joined == 4 then
                packColour (rgbAt params (k + 3)) (k + 6)

            else
                packColour -1 (k + 2 + joined)

    else
        packColour -1 (k + 1)


foundOr : { row : Int, x : Int } -> Maybe { row : Int, x : Int } -> { row : Int, x : Int }
foundOr before found =
    when found is
        Just at ->
            if at.row >= 0 then
                at

            else
                before

        Nothing ->
            before


{-| Red, green and blue at `at` of the parameters, as a direct colour. -}
rgbAt : Array Int -> Int -> Int
rgbAt params at =
    Bitwise.or 0x1000000
        (Bitwise.or (Bitwise.shiftLeftBy 16 (Bitwise.and 0xFF (Maybe.withDefault 0 (Array.get at params))))
            (Bitwise.or (Bitwise.shiftLeftBy 8 (Bitwise.and 0xFF (Maybe.withDefault 0 (Array.get (at + 1) params)))) (Bitwise.and 0xFF (Maybe.withDefault 0 (Array.get (at + 2) params))))
        )


{-| How many parameters from `j` on are followed by a colon, up to the
last parameter, as Ghostty's `countColon`. -}
colonRun : Int -> Int -> Int -> Int -> Int
colonRun colons last j count =
    if j < last && j < 32 && Bitwise.and colons (Bitwise.shiftLeftBy j 1) /= 0 then
        colonRun colons last (j + 1) (count + 1)

    else
        count


-- PRINTING AGAIN


repeatLast : Int -> (moved t : Term) -> Term
repeatLast count t =
    if count <= 0 || t.lastPoint == 0 then
        t

    else
        repeatLast (count - 1) (printPoint t.lastPoint (printedWidth t.lastPoint) t)


printedWidth : Int -> Int
printedWidth cp =
    if cp < 0x80 then
        1

    else
        Width.width cp


{-| DECALN: the screen filled with `E`. The pen keeps its colours alone,
and stays so, and the E's are written in it, unprotected, as Ghostty's
`decaln` writes them (§VC17). -}
alignment : (moved t0 : Term) -> Term
alignment t0 =
    let
        a =
            t0.attrs

        t =
            withPen { plainAttrs | fg = a.fg, bg = a.bg } t0

        s =
            settle t.screen

        filled =
            fillRows 0 t.rows (Bitwise.or (Bitwise.and highMask t.pen) 0x45) s
    in
    withPlain (withScroll { t | screen = filled, top = 0, bottom = t.rows - 1, left = 0, right = t.cols - 1, origin = False, x = 0, y = 0, wrapNext = False })


fillRows : Int -> Int -> Int64 -> (moved s : Screen) -> Screen
fillRows y stop cell s =
    if y >= stop then
        s

    else
        let
            o =
                rowOffset s y
        in
        fillRows (y + 1) stop cell { s | cells = Builder.set (o + s.cols) (Int64.fromInt s.cols) (Builder.fill o (o + s.cols) cell s.cells) }


-- EDITING A ROW


{-| `count` empty cells in `erase` inserted at column `x` of the row at
`o`, the cells from `x` on moving right and those past the row's end lost. -}
insertCells : Int -> Int -> Int -> Int64 -> (moved s : Screen) -> Screen
insertCells o x count erase s =
    let
        ext =
            extentAt o s
    in
    if x >= ext && erase == 0 then
        s

    else
        let
            n =
                min count (s.cols - x)

            cells0 =
                reachAt o ext x s.cells

            -- a wide character cut by the row's new end loses its head too
            cells1 =
                splitWhole erase o x x ext cells0

            keepTo =
                min ext (s.cols - n)

            moved =
                if keepTo > x then
                    Builder.copyWithin (o + x + n) (o + x) (o + keepTo) cells1

                else
                    cells1

            lastKept =
                Maybe.withDefault 0 (Builder.get (o + s.cols - 1) moved)

            tidy =
                if keepTo > x && keepTo + n >= s.cols && cellWide lastKept == wideHead then
                    Builder.set (o + s.cols - 1) erase moved

                else
                    moved

            newExt =
                if erase == 0 then
                    min s.cols (max x keepTo + n)

                else
                    max (min s.cols (keepTo + n)) (x + n)

            -- the row's wrapped flag kept, as Ghostty's ICH keeps it (§VC16)
            m =
                Maybe.withDefault 0 (Builder.get (o + s.cols) tidy)
        in
        { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt newExt)) (Builder.fill (o + x) (o + x + n) erase tidy) }


deleteChars : Int -> (moved t : Term) -> Term
deleteChars count t =
    let
        s =
            t.screen

        o =
            rowOffset s t.y

        ext =
            extentAt o s

        x =
            t.x

        n =
            min count (s.cols - x)
    in
    if x >= ext && t.erase == 0 then
        -- the row no longer wraps, as Ghostty's DCH resets it (§VC16)
        { t | screen = setWrapped t.y False s, wrapNext = False }

    else
        let
            cells0 =
                splitWhole t.erase o x (min s.cols (x + n)) ext (reachAt o ext x s.cells)

            from =
                min ext (x + n)

            moved =
                if ext > from then
                    Builder.copyWithin (o + x) (o + from) (o + ext) cells0

                else
                    cells0

            left =
                max x (ext - n)

            -- the cells past the extent move in from the right empty, and
            -- the last `n` are the erase cell
            filled =
                if t.erase == 0 then
                    Builder.set (o + s.cols) (Int64.fromInt left) moved

                else
                    Builder.set (o + s.cols) (Int64.fromInt s.cols) (Builder.fill (o + s.cols - n) (o + s.cols) t.erase (Builder.fill (o + left) (o + s.cols - n) 0 moved))
        in
        { t | screen = { s | cells = filled }, wrapNext = False }


eraseChars : Int -> (moved t : Term) -> Term
eraseChars count t =
    -- ECH leaves the row not wrapping, as in Ghostty (§VC16)
    let
        end =
            min t.cols (t.x + max 1 count)

        -- a wide character at the end is erased whole, as in Ghostty,
        -- which matters when it is protected (§VC18)
        to =
            if end < t.cols && wideAt (end - 1) t == wideHead then
                end + 1

            else
                end
    in
    eraseSpan (t.protectMode == 1) t.x to (resetWrap (splitAbove to (splitAbove t.x { t | wrapNext = False })))


{-| Ghostty's `cursorResetWrap`, which ECH, EL and DCH begin with: the
cursor's row made not to wrap, and when it did, a spacer head at its end
made a cell of the erase colour (§VC18). -}
resetWrap : (moved t : Term) -> Term
resetWrap t =
    if rowWrapped t.y t.screen then
        let
            s =
                t.screen

            p =
                rowOffset s t.y + s.cols - 1
        in
        if cellWide (peekCell (rowOffset s t.y) (s.cols - 1) s) == spacerHead then
            { t | screen = setWrapped t.y False { s | cells = Builder.set p t.erase s.cells } }

        else
            { t | screen = setWrapped t.y False s }

    else
        t


{-| Ghostty's `splitCellBoundary` at the row's left edge, where ECH and DCH
begin or end: at column 0 or 1, when the row continues a wrapped one and
starts with a wide character, the spacer head that ends the row above is
made a cell of the erase colour, whatever is erased after. The row above's
wrap stands in for Ghostty's `wrap_continuation`, and above the screen's
top it is the scrollback's newest row, while the ring holds it (§VC18). -}
splitAbove : Int -> (moved t : Term) -> Term
splitAbove x t =
    if x <= 1 && (t.y > 0 || t.screen.hist > 0) && rowWrapped (t.y - 1) t.screen && wideAt 0 t == wideHead then
        let
            s =
                t.screen

            p =
                rowOffset s (t.y - 1) + s.cols - 1
        in
        if cellWide (peekCell (rowOffset s (t.y - 1)) (s.cols - 1) s) == spacerHead then
            { t | screen = { s | cells = Builder.set p t.erase s.cells } }

        else
            { t | screen = s }

    else
        t


{-| The wide bits of the cursor's row's cell `x`. -}
wideAt : Int -> Term -> Int
wideAt x t =
    cellWide (peekCell (rowOffset t.screen t.y) x t.screen)


{-| Columns `from` to `to` of the cursor's row made empty, in the erase
cell. -}
eraseSpan : Bool -> Int -> Int -> (moved t : Term) -> Term
eraseSpan guarded from to t =
    let
        s =
            t.screen

        o =
            rowOffset s t.y

        m =
            metaAt o s

        ext =
            metaExtent m
    in
    if to <= from then
        { t | screen = s }

    else if t.erase == 0 && from >= ext then
        { t | screen = s }

    else
        let
            newExt =
                if t.erase /= 0 then
                    max ext to

                else if to >= ext && not guarded then
                    from

                else
                    ext

            -- guarded, the cells the extent grows over are made empty
            -- first, or a protected cell left past the extent comes back
            cells0 =
                splitWhole t.erase
                    o
                    from
                    to
                    ext
                    (reachAt o
                        ext
                        (if guarded then
                            newExt

                         else
                            from
                        )
                        s.cells
                    )

            filled =
                if guarded then
                    eraseUnprotected (o + from) (o + min to (max ext to)) t.erase cells0

                else
                    Builder.fill (o + from) (o + min to (max ext to)) t.erase cells0
        in
        { t | screen = { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt newExt)) filled } }


{-| EL, and DECSEL when `selective`, which leaves protected cells; EL
leaves them too in ISO's protection mode. -}
eraseLine : Bool -> Int -> (moved t : Term) -> Term
eraseLine selective how t =
    let
        guarded =
            selective || t.protectMode == 1
    in
    -- EL 0 and 2 leave the row not wrapping, as Ghostty's cursorResetWrap
    -- does (§VC17); EL 1 keeps it
    -- a wide character the cursor is on is erased whole, as in Ghostty,
    -- which matters when it is protected (§VC18)
    if how == 0 then
        let
            from =
                if t.x > 0 && wideAt t.x t == wideTail then
                    t.x - 1

                else
                    t.x
        in
        eraseSpan guarded from t.cols (resetWrap { t | wrapNext = False })

    else if how == 1 then
        let
            to =
                if wideAt t.x t == wideHead then
                    min t.cols (t.x + 2)

                else
                    t.x + 1
        in
        eraseSpan guarded 0 to { t | wrapNext = False }

    else if how == 2 then
        eraseSpan guarded 0 t.cols (resetWrap { t | wrapNext = False })

    else
        t


{-| The cells from `from` to `to` that are not protected, in the erase cell. -}
eraseUnprotected : Int -> Int -> Int64 -> (moved cells : Builder Int64) -> Builder Int64
eraseUnprotected from to fill cells =
    if from >= to then
        cells

    else if Bitwise.and protectBit (Maybe.withDefault 0 (Builder.get from cells)) /= 0 then
        eraseUnprotected (from + 1) to fill cells

    else
        eraseUnprotected (from + 1) to fill (Builder.set from fill cells)


{-| Rows `from` to `to`, their cells that are not protected erased. -}
blankUnprotected : Int -> Int -> Int64 -> (moved s : Screen) -> Screen
blankUnprotected from to fill s =
    if from >= to then
        s

    else
        let
            o =
                rowOffset s from

            m =
                metaAt o s

            ext =
                metaExtent m

            newExt =
                if fill /= 0 then
                    s.cols

                else
                    ext

            cells =
                eraseUnprotected o (o + newExt) fill (reachAt o ext newExt s.cells)
        in
        blankUnprotected (from + 1) to fill { s | cells = Builder.set (o + s.cols) (Bitwise.or (Bitwise.and wrappedBit m) (Int64.fromInt newExt)) cells }


{-| ED, and DECSED when `selective`, which leaves protected cells; ED
leaves them too in ISO's protection mode. -}
eraseDisplay : Bool -> Int -> (moved t : Term) -> Term
eraseDisplay selective how t =
    if (selective || t.protectMode == 1) && how /= 3 && how /= 22 then
        eraseGuarded selective how t

    else if how == 2 then
        { t | screen = blankRows 0 t.rows t.erase t.screen, wrapNext = False }

    else if how == 3 then
        -- the scrollback only: a pending wrap stays, as in Ghostty (§VC16)
        clearScrollback t

    else if how == 22 then
        scrollClear t

    else if how == 1 then
        -- the rows first, through the term, so that nothing reads the term
        -- after it is handed on (§VC7)
        eraseLine False 1 { t | screen = blankRows 0 t.y t.erase t.screen }

    else if how == 0 then
        eraseLine False 0 { t | screen = blankRows (t.y + 1) t.rows t.erase t.screen }

    else
        t


eraseGuarded : Bool -> Int -> (moved t : Term) -> Term
eraseGuarded selective how t =
    if how == 2 then
        { t | screen = blankUnprotected 0 t.rows t.erase t.screen, wrapNext = False }

    else if how == 1 then
        eraseLine selective 1 { t | screen = blankUnprotected 0 t.y t.erase t.screen }

    else if how == 0 then
        eraseLine selective 0 { t | screen = blankUnprotected (t.y + 1) t.rows t.erase t.screen }

    else
        t


{-| ED 22, Ghostty's (and kitty's) `scroll_complete`: the whole screen
scrolled up, past the margins and its protection, until its last row that
is not empty has gone, into the scrollback on the main screen. The cursor
goes up with its row, or to the top left when the row goes (§VC18). -}
scrollClear : (moved t : Term) -> Term
scrollClear t =
    let
        count =
            filledRows t.screen (t.rows - 1)

        y =
            t.y - count
    in
    if count == 0 then
        { t | wrapNext = False }

    else
        let
            erase =
                t.erase

            -- the rows that come in are blank, not in the erase colour:
            -- Ghostty's `grow`
            up =
                scrollUpBy (keepsScrollback 0 t) count 0 (t.rows - 1) { t | erase = 0 }
        in
        if y < 0 then
            { up | x = 0, y = 0, wrapNext = False, erase = erase }

        else
            { up | y = y, wrapNext = False, erase = erase }


{-| The rows down to the last that is not empty, `y` and above: Ghostty's
`Cell.isEmpty`, for which a cell in a background colour alone is not. -}
filledRows : Screen -> Int -> Int
filledRows s y =
    if y < 0 then
        0

    else if rowEmpty s (rowOffset s y) 0 then
        filledRows s (y - 1)

    else
        y + 1


rowEmpty : Screen -> Int -> Int -> Bool
rowEmpty s o x =
    if x >= s.cols then
        True

    else if emptyCell (peekCell o x s) then
        rowEmpty s o (x + 1)

    else
        False


clearScrollback : (moved t : Term) -> Term
clearScrollback t =
    if isAlt t then
        t

    else
        let
            s =
                t.screen

            b =
                t.back
        in
        { t | screen = { s | hist = 0 }, back = { b | pages = Builder.empty 0, head = 0 } }


-- SCROLLING


lineFeed : (moved t : Term) -> Term
lineFeed t =
    if t.y == t.bottom then
        if t.scroll == scrollFull then
            feedFull t

        else if t.scroll == scrollRegion then
            feedRegion t

        else
            feedOther t

    else if t.y < t.rows - 1 then
        { t | y = t.y + 1 }

    else
        t


{-| A line feed at the region's bottom that is neither `feedFull`'s nor
`feedRegion`'s: between narrowed margins, when the cursor is between them,
or `regionUp`'s. -}
feedOther : (moved t : Term) -> Term
feedOther t =
    if margined t then
        if t.x >= t.left && t.x <= t.right then
            marginUp 1 t.top t.bottom t

        else
            t

    else
        regionUp 1 t.top t.bottom t


{-| The kinds of line feed at the bottom of the region that `lineFeed` takes
straight to their work, decided where the region, the screen or the
scrollback change (`withScroll`): the whole main screen with scrollback
kept, and a region of the screen with none kept. Any other is
`regionUp`'s. A screen whose erase cell has a style takes `regionUp` too. -}
scrollFull : Int
scrollFull =
    1


scrollRegion : Int
scrollRegion =
    2


scrollOther : Int
scrollOther =
    0


keepsScrollback : Int -> Term -> Bool
keepsScrollback top t =
    top == 0 && t.back.limit > 0 && not (isAlt t)


withScroll : (moved t : Term) -> Term
withScroll t =
    let
        keep =
            keepsScrollback t.top t

        whole =
            t.top == 0 && t.bottom == t.rows - 1
    in
    if margined t then
        { t | scroll = scrollOther, screen = withRegion t.top t.bottom t.screen }

    else if keep && whole then
        { t | scroll = scrollFull, screen = withRegion t.top t.bottom t.screen }

    else if not keep && not whole then
        { t | scroll = scrollRegion, screen = withRegion t.top t.bottom t.screen }

    else
        { t | scroll = scrollOther, screen = withRegion t.top t.bottom t.screen }


{-| `regionUp 1` of the whole main screen, scrollback kept. -}
feedFull : (moved t : Term) -> Term
feedFull t =
    let
        s =
            t.screen

        last =
            t.rows - 1
    in
    if s.hist + s.rows >= s.size then
        let
            room =
                pageOut t.clusters s t.back

            r =
                room.screen
        in
        { t | screen = { r | base = phys r 1, hist = r.hist + 1 } |> clearRow last t.erase, back = room.back }

    else
        { t | screen = { s | base = phys s 1, hist = s.hist + 1 } |> clearRow last t.erase }


{-| `regionUp 1` of a region, no scrollback kept: when the region is one
stretch of the ring, its turn counted on by one and the row that left, now
its bottom row, cleared. -}
feedRegion : (moved t : Term) -> Term
feedRegion t =
    if slot t.screen t.top <= slot t.screen t.bottom then
        let
            s =
                t.screen
        in
        { t
            | screen =
                { s
                    | turn =
                        if s.turn + 1 >= s.height then
                            0

                        else
                            s.turn + 1
                }
                    |> clearRow t.bottom t.erase
        }

    else
        regionUp 1 t.top t.bottom t


reverseIndex : (moved t : Term) -> Term
reverseIndex t =
    -- a scroll keeps a pending wrap and a move up clears it, as in
    -- Ghostty, whose RI is a scroll down or a CUU (§VC16)
    if t.y == t.top && margined t then
        if t.x >= t.left && t.x <= t.right then
            marginDown 1 t.top t.bottom t

        else
            { t | wrapNext = False }

    else if t.y == t.top then
        -- Ghostty's scrollDown, as SD: no row of the region wraps (§VC17)
        unwrapRegion t.top t.bottom (regionDown 1 t.top t.bottom t)

    else if t.y > 0 then
        { t | y = t.y - 1, wrapNext = False }

    else
        { t | wrapNext = False }


{-| Rows `top` to `bottom` scrolled up `count` times. On the main screen,
with the region starting at the top, the rows that leave go to the
scrollback. -}
regionUp : Int -> Int -> Int -> (moved t : Term) -> Term
regionUp count top bottom t =
    -- a loop of its own and not a call of `scrollUpBy`, which clang would
    -- inline into `lineFeed`, and `lineFeed` then not into the ground state
    if count <= 0 then
        t

    else
        let
            keep =
                keepsScrollback top t
        in
        if keep && t.screen.hist + t.rows >= t.screen.size then
            let
                room =
                    pageOut t.clusters t.screen t.back
            in
            regionUp (count - 1)
                top
                bottom
                { t
                    | screen = screenUp keep top bottom t.erase room.screen
                    , back = room.back
                }

        else
            regionUp (count - 1) top bottom { t | screen = screenUp keep top bottom t.erase t.screen }


{-| Rows `top` to `bottom` made not to wrap, as Ghostty's IL and DL leave
the rows they shift when the region is the screen's width (§VC16). -}
unwrapRegion : Int -> Int -> (moved t : Term) -> Term
unwrapRegion top bottom t =
    if top > bottom then
        t

    else
        unwrapRegion (top + 1) bottom { t | screen = setWrapped top False t.screen }


{-| `regionUp` with no scrollback kept, for DL, which keeps none in
Ghostty (§VC16). -}
scrollUpBy : Bool -> Int -> Int -> Int -> (moved t : Term) -> Term
scrollUpBy keep count top bottom t =
    if count <= 0 then
        t

    else if keep && t.screen.hist + t.rows >= t.screen.size then
        let
            room =
                pageOut t.clusters t.screen t.back
        in
        scrollUpBy keep
            (count - 1)
            top
            bottom
            { t
                | screen = screenUp keep top bottom t.erase room.screen
                , back = room.back
            }

    else
        scrollUpBy keep (count - 1) top bottom { t | screen = screenUp keep top bottom t.erase t.screen }


regionDown : Int -> Int -> Int -> (moved t0 : Term) -> Term
regionDown count top bottom t0 =
    let
        t =
            { t0 | screen = settle t0.screen }
    in
    if count <= 0 then
        t

    else if phys t.screen top <= phys t.screen bottom then
        regionDown (count - 1) top bottom { t | screen = turnRegion top bottom -1 t.screen |> clearRow top t.erase }

    else
        regionDown (count - 1) top bottom { t | screen = shiftDown bottom top t.screen |> clearRow top t.erase }


-- RESIZING


{-| The terminal made `cols` by `rows`, as its host resizes it, by
Ghostty's rules (§VC14, V8). The main screen's lines reflow to the new
width, its scrollback with them, unless autowrap is off; the alternate
screen's rows are cut or extended and never reflow. The cursor and the saved cursors move
with the cells they are on. The scroll region and the margins are reset,
and the tab stops when the width changes. -}
resize : Int -> Int -> (moved t : Term) -> Term
resize cols0 rows0 t =
    let
        cols =
            clamp 1 1000 cols0

        rows =
            clamp 1 1000 rows0
    in
    if cols == t.cols && rows == t.rows then
        t

    else
        resizeTo cols rows t


resizeTo : Int -> Int -> (moved t : Term) -> Term
resizeTo cols rows t =
    let
        active =
            settle t.screen

        here =
            { x = t.x, y = t.y, wrap = t.wrapNext }

        config =
            t.config
    in
    if t.alt then
        when t.other is
            Just main0 ->
                let
                    main =
                        settle main0

                    -- the main screen's own cursor, where it was when the
                    -- alternate screen was shown, as Ghostty keeps one for
                    -- each screen (§VC17)
                    m =
                        resizeScreen t.autowrap True cols rows t.hidden (savedPoint main.saved) t.clusters main t.back

                    a =
                        resizeScreen False False cols rows here (savedPoint active.saved) m.clusters active { pages = Builder.empty 0, head = 0, limit = 0 }
                in
                resized cols rows a.cursor
                    { t
                        | screen = withSaved a.saved a.screen
                        , other = Just (withSaved m.saved m.screen)
                        , hidden = m.cursor
                        , back = m.back
                        , clusters = a.clusters
                        , config = { config | cols = cols, rows = rows }
                    }

            Nothing ->
                { t | screen = active }

    else
        let
            m =
                resizeScreen t.autowrap True cols rows here (savedPoint active.saved) t.clusters active t.back
        in
        when t.other is
            Just alt0 ->
                let
                    alt =
                        settle alt0

                    a =
                        resizeScreen False False cols rows t.hidden (savedPoint alt.saved) m.clusters alt { pages = Builder.empty 0, head = 0, limit = 0 }
                in
                resized cols rows m.cursor
                    { t
                        | screen = withSaved m.saved m.screen
                        , other = Just (withSaved a.saved a.screen)
                        , hidden = a.cursor
                        , back = m.back
                        , clusters = a.clusters
                        , config = { config | cols = cols, rows = rows }
                    }

            Nothing ->
                resized cols rows m.cursor
                    { t
                        | screen = withSaved m.saved m.screen
                        , back = m.back
                        , clusters = m.clusters
                        , config = { config | cols = cols, rows = rows }
                    }


{-| What follows the size: the cursor, the region and margins, the tabs. -}
resized : Int -> Int -> { x : Int, y : Int, wrap : Bool } -> (moved t0 : Term) -> Term
resized cols rows cursor t0 =
    let
        t =
            if cols == t0.cols then
                t0

            else
                { t0 | tabs = Builder.fromArray (Array.initialize cols 0 (\i -> if modBy 8 i == 0 && i > 0 then 1 else 0)) }
    in
    withScroll
        { t
            | cols = cols
            , rows = rows
            , x = cursor.x
            , y = cursor.y
            , wrapNext = cursor.wrap
            -- a reflow may have written spacer heads
            , heads = True
            , top = 0
            , bottom = rows - 1
            , left = 0
            , right = cols - 1
        }


savedPoint : Saved -> { x : Int, y : Int, wrap : Bool }
savedPoint v =
    { x = v.x, y = v.y, wrap = v.wrapNext }


{-| The saved cursor moved where a resize took it; with nothing saved,
nothing is moved, as Ghostty keeps none (§VC16). -}
withSaved : { x : Int, y : Int, wrap : Bool } -> (moved s : Screen) -> Screen
withSaved p s =
    let
        v =
            s.saved
    in
    if v.isSet then
        { s | saved = { v | x = p.x, y = p.y, wrapNext = p.wrap } }

    else
        s


withState : Saved -> (moved s : Screen) -> Screen
withState v s =
    { s | saved = v }


{-| A row of a screen or its scrollback out of the ring or a page: its
cells as the ring keeps them, up to its extent, and whether it wrapped. -}
type alias Row =
    { cells : Array Int64, wrapped : Bool }


{-| A point carried with its cell through a resize: `row` counts from the
oldest row of the scrollback. -}
type alias Point =
    { row : Int, x : Int, wrap : Bool }


{-| The rows a resize works on, the first `hist` of them scrollback, the
cursor and the saved cursor, and the row the cursor was on before (`y0`),
which Ghostty keeps the rows below of (§VC14). `more` says pages of
scrollback are left above the rows, and `short` that the resize wanted rows
from them. -}
type alias Flow =
    { rows : Array Row, hist : Int, cursor : Point, saved : Point, y0 : Int, more : Bool, short : Bool }


{-| One screen resized: `reflow` its lines, `keep` its scrollback (the
main screen's). The pages are left as they are but for the newest, which
are taken back into the ring for as long as the resize wants rows from them
or a line runs on from them; all of them when the resize would lose cells,
with autowrap off or in one column, as a reflow when read would not (V10). -}
resizeScreen : Bool -> Bool -> Int -> Int -> { x : Int, y : Int, wrap : Bool } -> { x : Int, y : Int, wrap : Bool } -> Clusters -> Screen -> Back -> { screen : Screen, back : Back, clusters : Clusters, cursor : { x : Int, y : Int, wrap : Bool }, saved : { x : Int, y : Int, wrap : Bool } }
resizeScreen reflow keep cols rows cursor saved clusters s back =
    let
        -- the saved cursor's state, which the new screen takes over; a
        -- resize moves only its position (§VC16)
        before =
            s.saved

        pages =
            if keep then
                pagesOf back

            else
                []

        count =
            Array.length pages

        lossy =
            cols /= s.cols && (not reflow || cols == 1)

        r =
            pullUntil reflow keep cols rows cursor saved clusters s pages
                (if lossy then
                    count

                 else
                    lineStart pages count 0
                )

        flow =
            r.flow

        built =
            rebuild cols rows flow r.clusters (newScreen cols rows (if keep then rows + 2 * pageRows + 1 else rows + 1)) { pages = Builder.fromArray (Array.takeFirst (count - r.taken) pages), head = 0, limit = back.limit }

        c =
            flow.cursor

        v =
            flow.saved

        vy =
            v.row - flow.hist
    in
    { screen = withState before built.screen
    , back = built.back
    , clusters = r.clusters
    , cursor =
        -- a cursor whose row went into the scrollback goes home, as
        -- Ghostty's cursorReload puts it (§VC16)
        if c.row < flow.hist then
            offEdge cols { x = 0, y = 0, wrap = c.wrap }

        else
            offEdge cols { x = c.x, y = min (rows - 1) (c.row - flow.hist), wrap = c.wrap }
    , saved =
        if vy >= 0 && vy < rows then
            offEdge cols { x = v.x, y = vy, wrap = v.wrap }

        else
            { x = 0, y = 0, wrap = False }
    }


{-| The resize made with the newest `k` pages taken back, and again with
more while it wants rows they do not hold. -}
pullUntil : Bool -> Bool -> Int -> Int -> { x : Int, y : Int, wrap : Bool } -> { x : Int, y : Int, wrap : Bool } -> Clusters -> Screen -> Array Page -> Int -> { flow : Flow, clusters : Clusters, taken : Int }
pullUntil reflow keep cols rows cursor saved clusters s pages k =
    let
        count =
            Array.length pages

        paged =
            readPages s.cols clusters (Array.dropFirst (count - k) pages)

        history =
            paged.rows ++ Array.map (\y -> ringRowOf (rowOffset s y) s) (Array.range (0 - s.hist) -1)

        h0 =
            Array.length history

        flow0 =
            { rows = history ++ Array.map (\y -> ringRowOf (rowOffset s y) s) (Array.range 0 (s.rows - 1))
            , hist = h0
            , cursor = { row = h0 + cursor.y, x = cursor.x, wrap = cursor.wrap }
            -- none saved, none carried: Ghostty tracks a saved cursor
            -- only when there is one (§VC17)
            , saved =
                if s.saved.isSet then
                    { row = h0 + saved.y, x = saved.x, wrap = saved.wrap }

                else
                    { row = -1, x = 0, wrap = False }
            , y0 = cursor.y
            , more = k < count
            , short = False
            }

        flow =
            if reflow && cols /= s.cols then
                if cols < s.cols then
                    reflowCols s.cols cols (changeRows keep s.rows rows flow0)

                else
                    changeRows keep s.rows rows (reflowCols s.cols cols flow0)

            else
                changeRows keep s.rows rows (cutCols s.cols cols flow0)
    in
    if flow.short && k < count then
        pullUntil reflow keep cols rows cursor saved clusters s pages (lineStart pages count (k + 1))

    else
        { flow = flow, clusters = paged.clusters, taken = k }


{-| At least the newest `k` of the pages, and as many more as the line the
oldest of them starts in runs on from. -}
lineStart : Array Page -> Int -> Int -> Int
lineStart pages count k =
    if k >= count then
        count

    else
        when Array.get (count - k - 1) pages is
            Just page ->
                if lastWrapped page then
                    lineStart pages count (k + 1)

                else
                    k

            Nothing ->
                k


{-| A cursor waiting to wrap that a resize moved off the right edge goes on
to the next cell instead, as Ghostty's does. -}
offEdge : Int -> { x : Int, y : Int, wrap : Bool } -> { x : Int, y : Int, wrap : Bool }
offEdge cols p =
    if p.wrap && p.x /= cols - 1 then
        { x = min (cols - 1) (p.x + 1), y = p.y, wrap = False }

    else
        { x = min (cols - 1) p.x, y = p.y, wrap = p.wrap }


ringRowOf : Int -> Screen -> Row
ringRowOf o s =
    let
        m =
            metaAt o s
    in
    { cells = Builder.slice o (o + metaExtent m) s.cells, wrapped = Bitwise.and wrappedBit m /= 0 }


{-| The scrollback's pages, oldest first. -}
pagesOf : Back -> Array Page
pagesOf back =
    let
        count =
            Builder.length back.pages
    in
    Array.mapAndKeepJust (\i -> Builder.get (modBy (max 1 count) (i + back.head)) back.pages) (Array.range 0 (count - 1))


{-| Pages read back into rows at `cols` columns, oldest first: each run of
pages cut at another width reflowed to `cols` (V10). A run ends at the end
of a line, since a resize takes back a page a line runs on from (`lineStart`). -}
readPages : Int -> Clusters -> Array Page -> { rows : Array Row, clusters : Clusters }
readPages cols clusters pages =
    let
        done =
            Array.foldl
                (\page acc ->
                    let
                        one =
                            pageRowsOf page acc.clusters
                    in
                    if page.cols == acc.width then
                        { acc | group = acc.group ++ one.rows, clusters = one.clusters }

                    else
                        { rows = acc.rows ++ reflowed acc.width cols acc.group, group = one.rows, width = page.cols, clusters = one.clusters }
                )
                { rows = [], group = [], width = cols, clusters = clusters }
                pages
    in
    { rows = done.rows ++ reflowed done.width cols done.group, clusters = done.clusters }


pageRowsOf : Page -> Clusters -> { rows : Array Row, clusters : Clusters }
pageRowsOf page clusters =
    Array.foldl
        (\row a ->
            let
                cells =
                    Array.foldl
                        (\c b ->
                            let
                                k =
                                    pagedCell c b.clusters
                            in
                            { cells = Array.pushLast k.cell b.cells, clusters = k.clusters }
                        )
                        { cells = [], clusters = a.clusters }
                        row.cells
            in
            { rows = Array.pushLast { cells = cells.cells, wrapped = row.wrapped } a.rows, clusters = cells.clusters }
        )
        { rows = [], clusters = clusters }
        (unpackPage page)


{-| Rows cut at `old` columns cut again at `cols`, with no cursor to carry
and every line kept. -}
reflowed : Int -> Int -> Array Row -> Array Row
reflowed old cols rows =
    if old == cols || Array.isEmpty rows then
        rows

    else
        let
            none =
                { row = -1, x = 0, wrap = False }

            joined =
                joinLines old cols { rows = rows, hist = 0, cursor = none, saved = none, y0 = 0, more = False, short = False } 0 { lines = [], line = [], cursor = { line = -1, at = 0 }, saved = { line = -1, at = 0 } }
        in
        Array.mapAndFlatten (\line -> (splitLine cols line [] 0).rows) joined.lines


{-| Whether a page's last row wrapped, so that its line goes on past it. -}
lastWrapped : Page -> Bool
lastWrapped page =
    Bitwise.and 0x8000 (u16At page.heads (Bytes.length page.heads - 2)) /= 0


{-| A cell read back from a page as the ring keeps it; a cluster's code
points are its id again. -}
pagedCell : { points : Array Int, wide : Int, style : Int } -> Clusters -> { cell : Int64, clusters : Clusters }
pagedCell c clusters =
    let
        high =
            Bitwise.or (styleBits c.style) (Int64.fromInt c.wide)
    in
    when c.points is
        [] ->
            { cell = high, clusters = clusters }

        [ p ] ->
            { cell = Bitwise.or high (Int64.fromInt p), clusters = clusters }

        _ ->
            when internCluster c.points clusters is
                Just k ->
                    { cell = Bitwise.or high (Int64.fromInt (Bitwise.or clusterBit k.id)), clusters = k.clusters }

                Nothing ->
                    { cell = Bitwise.or high (Int64.fromInt (Maybe.withDefault 0 (Array.first c.points))), clusters = clusters }


{-| An empty cell, as Ghostty's `isEmpty`: no text, narrow, and not in a
background colour alone, whatever its style (§VC17). -}
emptyCell : Int64 -> Bool
emptyCell c =
    Bitwise.and (Bitwise.or bgBit 0xFFFFFF) c == 0


{-| A row with no text, which the rows a resize takes away go first:
Ghostty's `hasTextAny`, for which a cell in a background colour alone, or a
spacer, is blank (§VC17). -}
blankRow : Row -> Bool
blankRow row =
    Array.all (\c -> cellPoint c == 0 && not (cellIsCluster c)) row.cells


{-| The screen's rows made `rows`, no line reflowed. Fewer: blank rows
below the cursor go first, then rows from the top, into the scrollback when
`keep`. More: rows come back out of the scrollback, then blank rows below,
but only when the cursor was on the last of the `old` rows, as Ghostty
pulls (`resizeWithoutReflow`); otherwise blank rows alone (§VC17). -}
changeRows : Bool -> Int -> Int -> Flow -> Flow
changeRows keep old rows flow =
    let
        total =
            Array.length flow.rows

        now =
            total - flow.hist
    in
    if rows < now then
        let
            blanks =
                -- nor past the saved cursor, which Ghostty's resize tracks
                -- as it does the cursor (§VC17)
                countBlank flow.rows (total - 1) (max flow.hist (max flow.cursor.row flow.saved.row + 1)) 0

            cut =
                min blanks (now - rows)

            rest =
                now - rows - cut

            kept =
                Array.dropLast cut flow.rows
        in
        if keep then
            { flow | rows = kept, hist = flow.hist + rest }

        else
            { flow
                | rows = Array.dropFirst rest kept
                , cursor = shiftPoint rest flow.cursor
                , saved = shiftPoint rest flow.saved
            }

    else if rows > now then
        let
            pulled =
                if keep && flow.y0 >= old - 1 then
                    min flow.hist (rows - now)

                else
                    0
        in
        { flow
            | rows = flow.rows ++ Array.repeat (rows - now - pulled) { cells = [], wrapped = False }
            , hist = flow.hist - pulled
            , short = flow.short || (keep && flow.y0 >= old - 1 && flow.more && flow.hist < rows - now)
        }

    else
        flow


countBlank : Array Row -> Int -> Int -> Int -> Int
countBlank rows i stop n =
    if i < stop then
        n

    else
        when Array.get i rows is
            Just row ->
                if blankRow row then
                    countBlank rows (i - 1) stop (n + 1)

                else
                    n

            Nothing ->
                n


{-| A point moved up `by` rows; one whose row is dropped goes to the top
left, as Ghostty's `cursorReload` takes a cursor whose row is gone (§VC17). -}
shiftPoint : Int -> Point -> Point
shiftPoint by p =
    if p.row < 0 then
        p

    else if p.row < by then
        { row = 0, x = 0, wrap = p.wrap }

    else
        { p | row = p.row - by }


{-| Every row cut to `cols` or left as it is, no line reflowed: a wide
character the new edge cuts goes, and a wider row no longer wraps, as in
Ghostty. -}
cutCols : Int -> Int -> Flow -> Flow
cutCols old cols flow =
    if cols < old then
        { flow
            | rows = Array.map (\row -> { row | cells = cutRow cols row.cells }) flow.rows
            , cursor = clampPoint cols flow.cursor
            , saved = clampPoint cols flow.saved
        }

    else if cols > old then
        { flow | rows = Array.map (\row -> { row | wrapped = False }) flow.rows }

    else
        flow


cutRow : Int -> Array Int64 -> Array Int64
cutRow cols cells =
    if Array.length cells <= cols then
        cells

    else
        let
            kept =
                Array.takeFirst cols cells
        in
        when Array.last kept is
            Just c ->
                if cellWide c == wideHead then
                    Array.set (cols - 1) 0 kept

                else
                    kept

            Nothing ->
                kept


clampPoint : Int -> Point -> Point
clampPoint cols p =
    { p | x = min (cols - 1) p.x }


{-| The rows' lines reflowed from `old` columns to `cols` (§VC14): each
line, its wrapped rows joined, is cut again at the new width, a wide
character that does not fit leaving a spacer head, or in one column an
empty cell. Blank lines at the end
are dropped, and the screen is the last rows, as many blank rows added
below as keep the rows that were below the cursor (Ghostty's
`resizeCols`). -}
reflowCols : Int -> Int -> Flow -> Flow
reflowCols old cols flow =
    let
        now =
            Array.length flow.rows - flow.hist

        before =
            continuations flow.rows flow.hist flow.cursor.row

        joined =
            joinLines old cols flow 0 { lines = [], line = [], cursor = { line = 0, at = 0 }, saved = { line = -1, at = 0 } }

        used =
            lastUsed joined.lines (Array.length joined.lines - 1) (max joined.cursor.line joined.saved.line)

        split =
            Array.foldl
                (\li acc ->
                    let
                        line =
                            Maybe.withDefault [] (Array.get li joined.lines)

                        marks =
                            [ if joined.cursor.line == li then joined.cursor.at else -1
                            , if joined.saved.line == li then joined.saved.at else -1
                            ]

                        cut =
                            splitLine cols line marks (Array.length acc.rows)
                    in
                    -- a line the cursor is not on finds it at row -1, and
                    -- leaves where an earlier line found it (§VC16)
                    { rows = acc.rows ++ cut.rows
                    , cursor = foundOr acc.cursor (Array.get 0 cut.found)
                    , saved = foundOr acc.saved (Array.get 1 cut.found)
                    }
                )
                { rows = [], cursor = { row = -1, x = 0 }, saved = { row = -1, x = 0 } }
                (Array.range 0 used)

        padded =
            split.rows ++ Array.repeat (now - Array.length split.rows) { cells = [], wrapped = False }

        hist =
            Array.length padded - now

        cur =
            split.cursor

        grow =
            if cur.row >= hist then
                let
                    remaining =
                        max 0 (now - (flow.y0 + 1))

                    after =
                        continuations padded hist cur.row

                    below =
                        now - (cur.row - hist + 1)
                in
                max 0 (max 0 (remaining - max 0 (after - before)) - below)

            else
                0
    in
    { rows = padded ++ Array.repeat grow { cells = [], wrapped = False }
    , hist = hist + grow
    , cursor = { row = cur.row, x = cur.x, wrap = flow.cursor.wrap }
    , saved =
        if split.saved.row < 0 then
            { row = -1, x = 0, wrap = False }

        else
            { row = split.saved.row, x = split.saved.x, wrap = flow.saved.wrap }
    , y0 = flow.y0
    , more = flow.more
    , short = flow.short || (flow.more && Array.length split.rows < now)
    }


{-| The rows from `from` to `to` that carry on a row that wrapped. -}
continuations : Array Row -> Int -> Int -> Int
continuations rows from to =
    Array.foldl
        (\r n ->
            when Array.get (r - 1) rows is
                Just prev ->
                    if prev.wrapped then
                        n + 1

                    else
                        n

                Nothing ->
                    n
        )
        0
        (Array.range (max 1 from) to)


lastUsed : Array (Array Int64) -> Int -> Int -> Int
lastUsed lines i floor =
    if i <= floor then
        floor

    else if Array.isEmpty (Maybe.withDefault [] (Array.get i lines)) then
        lastUsed lines (i - 1) floor

    else
        i


type alias Joined =
    { lines : Array (Array Int64)
    , line : Array Int64
    , cursor : { line : Int, at : Int }
    , saved : { line : Int, at : Int }
    }


{-| The rows from `i` on joined into lines. A wrapped row is its `old`
cells, less a spacer head at its end; a row that ends a line is its cells
up to the last that is not empty, less a spacer head there, and then up to
the cursor, as Ghostty keeps the cells before the cursor. A saved cursor in those blanks is kept
within a row of the new width. -}
joinLines : Int -> Int -> Flow -> Int -> Joined -> Joined
joinLines old cols flow i j =
    when Array.get i flow.rows is
        Nothing ->
            if Array.isEmpty j.line then
                j

            else
                { j | lines = Array.pushLast j.line j.lines, line = [] }

        Just row ->
            let
                base =
                    Array.length j.line

                own =
                    if row.wrapped then
                        withoutSpacer (row.cells ++ Array.repeat (old - Array.length row.cells) 0)

                    else
                        -- a spacer head is dropped wherever it is, as
                        -- Ghostty's reflow ignores one; the blanks before
                        -- it stay (§VC18)
                        withoutSpacer (trimmed row.cells (Array.length row.cells))

                len =
                    Array.length own

                li =
                    Array.length j.lines

                savedAt =
                    if flow.saved.row /= i then
                        -1

                    else if not row.wrapped && flow.saved.x >= len then
                        -- held to the row it starts on at the new width, from
                        -- the column the line so far ends at, a wide
                        -- character moved down counted (§VC18)
                        base + min flow.saved.x (cols - 1 - endColumn cols j.line 0 0)

                    else
                        base + min flow.saved.x (max 0 (len - 1))

                cursorAt =
                    if flow.cursor.row /= i then
                        -1

                    else if row.wrapped then
                        -- on a spacer head that is dropped, the cursor goes
                        -- on to the cell after, the character it was for, as
                        -- Ghostty moves its pin before it skips the head
                        base + min flow.cursor.x (max 0 (old - 1))

                    else
                        base + flow.cursor.x

                -- a wrapped row's cursor is in it or, on a dropped spacer
                -- head, on the next row's first cell, and adds no blanks
                need =
                    if row.wrapped then
                        max len (savedAt - base + 1)

                    else
                        max len (max (cursorAt - base + 1) (savedAt - base + 1))

                -- the cells up to the cursor are the row's own, a blank in
                -- a style kept, as Ghostty copies them; up to a saved
                -- cursor, which it does not track, they are empty (§VC18)
                kept =
                    if not row.wrapped && cursorAt - base + 1 > len then
                        Array.takeFirst (cursorAt - base + 1) row.cells

                    else
                        own

                line =
                    j.line ++ kept ++ Array.repeat (need - Array.length kept) 0

                marked =
                    { j
                        | line = line
                        -- on a dropped spacer head, the offset is written
                        -- -2 - at, for `splitAt` to tell (`markOffset`)
                        , cursor =
                            if cursorAt >= 0 && row.wrapped && flow.cursor.x >= len then
                                { line = li, at = -2 - cursorAt }

                            else if cursorAt >= 0 then
                                { line = li, at = cursorAt }

                            else
                                j.cursor
                        , saved =
                            if savedAt >= 0 then
                                { line = li, at = savedAt }

                            else
                                j.saved
                    }
            in
            if row.wrapped then
                joinLines old cols flow (i + 1) marked

            else
                joinLines old cols flow (i + 1) { marked | lines = Array.pushLast line marked.lines, line = [] }


{-| The column the next cell of `line` would go to, cut at `cols` as
`splitAt` cuts it: 0 when a row has just filled. -}
endColumn : Int -> Array Int64 -> Int -> Int -> Int
endColumn cols line j p =
    when Array.get j line is
        Nothing ->
            if p >= cols then
                0

            else
                p

        Just c ->
            if p >= cols then
                endColumn cols line j 0

            else if cellWide c == wideHead && cols == 1 then
                endColumn cols line (j + 2) (p + 1)

            else if cellWide c == wideHead && p == cols - 1 then
                endColumn cols line j 0

            else
                endColumn cols line (j + 1) (p + 1)


withoutSpacer : Array Int64 -> Array Int64
withoutSpacer cells =
    when Array.last cells is
        Just c ->
            if cellWide c == spacerHead then
                Array.dropLast 1 cells

            else
                cells

        Nothing ->
            cells


trimmed : Array Int64 -> Int -> Array Int64
trimmed cells n =
    if n <= 0 then
        []

    else if emptyCell (Maybe.withDefault 0 (Array.get (n - 1) cells)) then
        trimmed cells (n - 1)

    else
        Array.takeFirst n cells


{-| A line cut into rows of `cols`, and where each of `marks`, an offset in
the line or -1, lands: its row, counted from `first`, and its column. -}
splitLine : Int -> Array Int64 -> Array Int -> Int -> { rows : Array Row, found : Array { row : Int, x : Int } }
splitLine cols line marks first =
    splitAt cols line marks first 0 0 [] [] (Array.map (\_ -> { row = -1, x = 0 }) marks)


splitAt : Int -> Array Int64 -> Array Int -> Int -> Int -> Int -> Array Int64 -> Array Row -> Array { row : Int, x : Int } -> { rows : Array Row, found : Array { row : Int, x : Int } }
splitAt cols line marks first j p row rows found =
    when Array.get j line is
        Nothing ->
            -- a mark from a dropped spacer head at the end goes where a
            -- next cell would, or on the last one written when the row is
            -- full, as the oracle's reflow moves a pin (patch 0006, §VC18)
            { rows = Array.pushLast { cells = row, wrapped = False } rows, found = headMarks marks j (first + Array.length rows) (min p (cols - 1)) found }

        Just c ->
            if p >= cols then
                splitAt cols line (Array.map (\m -> if m == -2 - j then -1 else m) marks) first j 0 [] (Array.pushLast { cells = row, wrapped = True } rows) (headMarks marks j (first + Array.length rows) (cols - 1) found)

            else if cellWide c == wideHead && cols == 1 then
                -- No column holds it: it is an empty cell, its spacer gone,
                -- as in Ghostty, whose reflow writes it before it copies a
                -- style, so in none (§VC17)
                splitAt cols line marks first (j + 2) (p + 1) (Array.pushLast 0 row) rows (markAt marks j (j + 2) (first + Array.length rows) p found)

            else if cellWide c == wideHead && p == cols - 1 then
                -- a mark from a dropped spacer head before it stays on the
                -- one written here, as Ghostty moves a pin to where the
                -- next cell goes, here, before the cell wraps (§VC18)
                splitAt cols line (Array.map (\m -> if m == -2 - j then -1 else m) marks) first j 0 [] (Array.pushLast { cells = Array.pushLast (Int64.fromInt spacerHead) row, wrapped = True } rows) (headMarks marks j (first + Array.length rows) p found)

            else
                splitAt cols line marks first (j + 1) (p + 1) (Array.pushLast c row) rows (markAt marks j (j + 1) (first + Array.length rows) p found)


{-| A mark's offset in its line: one written -2 - at was on a spacer head
the reflow dropped (`joinLines`). -}
markOffset : Int -> Int
markOffset at =
    if at < -1 then
        -2 - at

    else
        at


{-| Each mark from a dropped spacer head at offset `j` found at `row` and
`x`. -}
headMarks : Array Int -> Int -> Int -> Int -> Array { row : Int, x : Int } -> Array { row : Int, x : Int }
headMarks marks j row x found =
    Array.indexedMap
        (\k f ->
            if Maybe.withDefault -1 (Array.get k marks) == -2 - j then
                { row = row, x = x }

            else
                f
        )
        found


{-| Each mark at an offset from `from` to `to` found at `row` and `x`. -}
markAt : Array Int -> Int -> Int -> Int -> Int -> Array { row : Int, x : Int } -> Array { row : Int, x : Int }
markAt marks from to row x found =
    Array.indexedMap
        (\k f ->
            let
                at =
                    markOffset (Maybe.withDefault -1 (Array.get k marks))
            in
            if at >= from && at < to then
                { row = row, x = x }

            else
                f
        )
        found


{-| A screen made of the flow's rows: the scrollback written into the ring
and paged out as it fills, as line feeds would, then the screen's rows. -}
rebuild : Int -> Int -> Flow -> Clusters -> (moved s : Screen) -> (moved back : Back) -> { screen : Screen, back : Back }
rebuild cols rows flow clusters s back =
    let
        hist =
            pushHistory clusters flow.rows 0 flow.hist s back

        r =
            hist.screen
    in
    { screen = writeRows flow.rows flow.hist 0 rows r, back = hist.back }


pushHistory : Clusters -> Array Row -> Int -> Int -> (moved s : Screen) -> (moved back : Back) -> { screen : Screen, back : Back }
pushHistory clusters rows i stop s back =
    if i >= stop then
        { screen = s, back = back }

    else if s.hist + s.rows >= s.size then
        let
            room =
                pageOut clusters s back
        in
        pushHistory clusters rows i stop room.screen room.back

    else
        let
            written =
                writeRow (rowOffset s 0) (Maybe.withDefault { cells = [], wrapped = False } (Array.get i rows)) s
        in
        pushHistory clusters rows (i + 1) stop { written | base = phys written 1, hist = written.hist + 1 } back


writeRows : Array Row -> Int -> Int -> Int -> (moved s : Screen) -> Screen
writeRows rows from y count s =
    if y >= count then
        s

    else
        writeRows rows from (y + 1) count (writeRow (rowOffset s y) (Maybe.withDefault { cells = [], wrapped = False } (Array.get (from + y) rows)) s)


writeRow : Int -> Row -> (moved s : Screen) -> Screen
writeRow o row s =
    let
        cells =
            Array.takeFirst s.cols row.cells

        meta =
            Bitwise.or (Int64.fromInt (Array.length cells))
                (if row.wrapped then
                    wrappedBit

                 else
                    0
                )
    in
    { s | cells = Builder.set (o + s.cols) meta (Builder.setMany o cells s.cells) }


-- THE DUMP


{-| The terminal in visiterm's screen dump (`docs/vt-core.md` §VC3), the
form harness/oracle/ghostty-dump prints libghostty-vt's in. -}
dump : Term -> String
dump t =
    let
        history =
            historyRows t

        yes flag text =
            if flag then
                text

            else
                ""

        head =
            [ "screen " ++ String.fromInt t.cols ++ "x" ++ String.fromInt t.rows ++ " " ++ yes (not (isAlt t)) "main" ++ yes (isAlt t) "alt"
            , "cursor " ++ String.fromInt t.x ++ "," ++ String.fromInt t.y ++ yes t.wrapNext " wrap" ++ yes (not t.showCursor) " hidden"
            , "history " ++ String.fromInt (Array.length history)
            ]

        histLines =
            Array.indexedMap (\i row -> rowLines ("h" ++ String.fromInt i) row t.styles) history

        screenLines =
            Array.map (\y -> rowLines (String.fromInt y) (screenRow y t) t.styles) (Array.range 0 (t.rows - 1))

        replyLines =
            Array.map (\r -> "reply " ++ escapeReply r) t.replies
    in
    String.join "\n" (Array.flatten [ head, Array.flatten histLines, Array.flatten screenLines, replyLines ]) ++ "\n"


{-| A row as the dump reads it: its cells, each its code points, width
state and style, and whether it wrapped. -}
type alias DumpRow =
    { cells : Array { points : Array Int, wide : Int, style : Int }
    , wrapped : Bool
    }


screenRow : Int -> Term -> DumpRow
screenRow y t =
    ringRow (rowOffset t.screen y) t


ringRow : Int -> Term -> DumpRow
ringRow o t =
    let
        m =
            metaAt o t.screen

        ext =
            metaExtent m
    in
    { cells =
        Array.map
            (\x ->
                let
                    c =
                        Maybe.withDefault 0 (Builder.get (o + x) t.screen.cells)
                in
                { points = cellPoints c t.clusters, wide = cellWide c, style = cellStyle c }
            )
            (Array.range 0 (ext - 1))
    , wrapped = Bitwise.and wrappedBit m /= 0
    }


{-| The scrollback, oldest first: the pages, each read at the screen's width
(V10), then the ring's rows. -}
historyRows : Term -> Array DumpRow
historyRows t =
    if isAlt t then
        []

    else
        let
            paged =
                readPages t.cols t.clusters (pagesOf t.back)

            pages =
                Array.map
                    (\row ->
                        { cells = Array.map (\c -> { points = cellPoints c paged.clusters, wide = cellWide c, style = cellStyle c }) row.cells
                        , wrapped = row.wrapped
                        }
                    )
                    paged.rows

            ring =
                Array.map (\y -> ringRow (phys t.screen y * t.screen.stride) t) (Array.range (0 - t.screen.hist) -1)
        in
        Array.append ring pages


unpackPage : Page -> Array DumpRow
unpackPage page =
    unpackRows page 0 0 0 []


unpackRows : Page -> Int -> Int -> Int -> Array DumpRow -> Array DumpRow
unpackRows page h r ti acc =
    if h >= Bytes.length page.heads then
        acc

    else
        let
            header =
                u16At page.heads h

            ext =
                Bitwise.and 0x3FFF header

            styles =
                if Bitwise.and 0x4000 header /= 0 then
                    { styles = Array.repeat ext 0, next = r }

                else
                    unpackRuns page.runs r ext []

            row =
                unpackText page.text ti ext []

            cells =
                Array.indexedMap (\x c -> { c | style = Maybe.withDefault 0 (Array.get x styles.styles) }) row.cells
        in
        unpackRows page (h + 2) styles.next row.next (Array.pushLast { cells = cells, wrapped = Bitwise.and 0x8000 header /= 0 } acc)


u16At : Bytes -> Int -> Int
u16At bytes i =
    byteAt bytes i + 256 * byteAt bytes (i + 1)


unpackRuns : Bytes -> Int -> Int -> Array Int -> { styles : Array Int, next : Int }
unpackRuns runs r left acc =
    if left <= 0 then
        { styles = acc, next = r }

    else
        let
            v =
                u16At runs r
        in
        if Bitwise.and 0x8000 v /= 0 then
            let
                count =
                    u16At runs (r + 2)
            in
            unpackRuns runs (r + 4) (left - count) (Array.prepend acc (Array.repeat count (Bitwise.and 0x7FFF v)))

        else
            { styles = Array.prepend acc (Array.repeat left v), next = r + 2 }


{-| A row's `ext` cells read back from its text: a wide character is its
cell and a spacer, a code point of width 0 joins the cell before, a 0
byte is an empty cell, a 0xFF byte, which UTF-8 never has, a spacer head
(§VC14), a 0xFE byte, which it never has either, a cell in a background
colour alone (`bgBit`, §VC17), and a 0xFD byte after a cell's text, that the
cell is protected (§VC19). -}
unpackText : Bytes -> Int -> Int -> Array { points : Array Int, wide : Int, style : Int } -> { cells : Array { points : Array Int, wide : Int, style : Int }, next : Int }
unpackText text i left acc =
    if left <= 0 && not (startsMark text i) then
        { cells = acc, next = i }

    else
        let
            d =
                decodeAt text i
        in
        if byteAt text i == 0xFF then
            unpackText text (i + 1) (left - 1) (Array.pushLast { points = [], wide = spacerHead, style = 0 } acc)

        else if byteAt text i == 0xFE then
            -- a cell in a background colour alone, its bit carried as its
            -- width, which `pagedCell` puts back into the cell
            unpackText text (i + 1) (left - 1) (Array.pushLast { points = [], wide = Int64.toIntWrap bgBit, style = 0 } acc)

        else if byteAt text i == 0xFD then
            -- the cell before is protected, and a wide character's spacer
            -- with it; the bit is carried as its width too (§VC19)
            let
                n =
                    Array.length acc

                guarded k a =
                    when Array.get k a is
                        Just cell ->
                            Array.set k { cell | wide = Bitwise.or (Int64.toIntWrap protectBit) cell.wide } a

                        Nothing ->
                            a

                tail =
                    when Array.get (n - 1) acc is
                        Just last ->
                            last.wide == wideTail

                        Nothing ->
                            False
            in
            unpackText text (i + 1) left (guarded (n - 1) (if tail then guarded (n - 2) acc else acc))

        else if d.cp == 0 then
            unpackText text d.next (left - 1) (Array.pushLast { points = [], wide = 0, style = 0 } acc)

        else if d.cp >= 0x80 && Width.width d.cp == 0 then
            let
                n =
                    Array.length acc

                -- a mark after a wide character joins its head, not the
                -- tail written after it (§VC17)
                at =
                    when Array.get (n - 1) acc is
                        Just last ->
                            if last.wide == wideTail then
                                n - 2

                            else
                                n - 1

                        Nothing ->
                            -1
            in
            when Array.get at acc is
                Just cell ->
                    unpackText text d.next left (Array.set at { cell | points = Array.pushLast d.cp cell.points } acc)

                Nothing ->
                    unpackText text d.next left acc

        else if d.cp >= 0x80 && Width.width d.cp == 2 then
            unpackText text d.next (left - 2) (Array.pushLast { points = [], wide = wideTail, style = 0 } (Array.pushLast { points = [ d.cp ], wide = wideHead, style = 0 } acc))

        else
            unpackText text d.next (left - 1) (Array.pushLast { points = [ d.cp ], wide = 0, style = 0 } acc)


startsMark : Bytes -> Int -> Bool
startsMark text i =
    if i >= Bytes.length text || byteAt text i == 0xFF then
        False

    else if byteAt text i == 0xFD then
        True

    else
        let
            d =
                decodeAt text i
        in
        d.cp >= 0x80 && Width.width d.cp == 0


decodeAt : Bytes -> Int -> { cp : Int, next : Int }
decodeAt text i =
    let
        b =
            byteAt text i
    in
    if b < 0x80 then
        { cp = b, next = i + 1 }

    else if b < 0xE0 then
        { cp = Bitwise.or (Bitwise.shiftLeftBy 6 (Bitwise.and 0x1F b)) (Bitwise.and 0x3F (byteAt text (i + 1))), next = i + 2 }

    else if b < 0xF0 then
        { cp = Bitwise.or (Bitwise.shiftLeftBy 12 (Bitwise.and 0x0F b)) (Bitwise.or (Bitwise.shiftLeftBy 6 (Bitwise.and 0x3F (byteAt text (i + 1)))) (Bitwise.and 0x3F (byteAt text (i + 2)))), next = i + 3 }

    else
        { cp = Bitwise.or (Bitwise.shiftLeftBy 18 (Bitwise.and 0x07 b)) (Bitwise.or (Bitwise.shiftLeftBy 12 (Bitwise.and 0x3F (byteAt text (i + 1)))) (Bitwise.or (Bitwise.shiftLeftBy 6 (Bitwise.and 0x3F (byteAt text (i + 2)))) (Bitwise.and 0x3F (byteAt text (i + 3))))), next = i + 4 }


rowLines : String -> DumpRow -> Styles -> Array String
rowLines label row styles =
    let
        lastText =
            Array.foldl
                (\c acc ->
                    { x = acc.x + 1
                    , last =
                        if Array.length c.points > 0 then
                            acc.x

                        else
                            acc.last
                    }
                )
                { x = 0, last = -1 }
                row.cells

        text =
            Array.foldl
                (\c acc ->
                    if acc.x > lastText.last then
                        { acc | x = acc.x + 1 }

                    else if c.wide == wideTail || c.wide == spacerHead then
                        { acc | x = acc.x + 1 }

                    else if Array.length c.points == 0 then
                        { x = acc.x + 1, out = acc.out ++ " " }

                    else
                        { x = acc.x + 1, out = acc.out ++ String.fromArray (Array.mapAndKeepJust Char.fromCode c.points) }
                )
                { x = 0, out = "" }
                row.cells

        runs =
            styleRuns (Array.map .style row.cells) 0 [] styles

        mark =
            if row.wrapped then
                "+"

            else
                ""
    in
    Array.prepend [ label ++ mark ++ " |" ++ text.out ++ "|" ] runs


styleRuns : Array Int -> Int -> Array String -> Styles -> Array String
styleRuns ids x acc styles =
    when Array.get x ids is
        Nothing ->
            acc

        Just id ->
            let
                end =
                    runEnd ids id (x + 1)

                text =
                    styleText (styleOf id styles)
            in
            if text == "" then
                styleRuns ids end acc styles

            else
                styleRuns ids end (Array.pushLast ("  " ++ String.fromInt x ++ "-" ++ String.fromInt (end - 1) ++ text) acc) styles


runEnd : Array Int -> Int -> Int -> Int
runEnd ids id x =
    if Array.get x ids == Just id then
        runEnd ids id (x + 1)

    else
        x


styleText : Attrs -> String
styleText a =
    let
        colour name c =
            if c == 0 then
                ""

            else if c <= 256 then
                " " ++ name ++ "=" ++ String.fromInt (c - 1)

            else
                " " ++ name ++ "=#" ++ hex2 (Bitwise.shiftRightZfBy 16 c) ++ hex2 (Bitwise.shiftRightZfBy 8 c) ++ hex2 c

        on bit text =
            if Bitwise.and bit a.flags /= 0 then
                text

            else
                ""
    in
    colour "fg" a.fg
        ++ colour "bg" a.bg
        ++ on 1 " bold"
        ++ on 2 " faint"
        ++ on 4 " italic"
        ++ (if a.ul == 0 then
                ""

            else
                " ul=" ++ String.fromInt a.ul
           )
        ++ colour "ulc" a.ulc
        ++ on 8 " blink"
        ++ on 16 " inverse"
        ++ on 32 " invisible"
        ++ on 64 " strike"
        ++ on 128 " overline"


{-| DECRQCRA's checksum of the rectangle `params` names (its id, a page, then
top, left, bottom and right from 1), as xterm's `xtermCheckRect` makes it
with the bits XTCHECKSUM chose (`t.xtChecksum`, V14): 1 not negated, 2 no
attributes added, 4 no blanks left out, 8 a cell never written to counted
as a space, 16 the code point rather than the DEC 8-bit value. A new
terminal's are 23, xterm's `checksumExtension: 23`, which is what esctest2
expects of xterm 334 and later and what Ghostty's runner sets. In origin
mode the rectangle is from the region's top and the left margin; a 0 is the
default, and each edge is held to the screen. -}
rectChecksum : Array Int -> Term -> Int
rectChecksum params t =
    let
        margin =
            if t.origin then
                t.top

            else
                0

        side =
            if t.origin then
                t.left

            else
                0

        edge i default m most =
            clamp 1 most (param i default params + m)

        top =
            edge 2 1 margin t.rows

        left =
            edge 3 1 side t.cols

        bottom =
            edge 4 t.rows margin t.rows

        right =
            edge 5 t.cols side t.cols

        sum =
            if top > bottom || left > right then
                0

            else
                Bitwise.and 0xFFFF (checksumRows t (left - 1) (right - 1) (top - 1) (bottom - 1) 0x10000)
    in
    if Bitwise.and 1 t.xtChecksum /= 0 then
        sum

    else
        Bitwise.and 0xFFFF (0 - sum)


{-| The sum so far in bits 0–15, and bit 16 while the cell counted next is
the rectangle's first, the one blank the DEC checksum does not leave out. -}
checksumRows : Term -> Int -> Int -> Int -> Int -> Int -> Int
checksumRows t left right y bottom acc =
    if y > bottom then
        acc

    else
        checksumRows t left right (y + 1) bottom (Bitwise.and 0xFFFF (checksumCells t (rowOffset t.screen y) left right acc))


checksumCells : Term -> Int -> Int -> Int -> Int -> Int
checksumCells t o x right acc =
    if x > right then
        acc

    else
        let
            flags =
                t.xtChecksum

            c =
                cellAt o x t.screen

            v =
                checksumValue flags c t.clusters
        in
        if v < 0 then
            checksumCells t o (x + 1) right acc

        else
            let
                a =
                    styleOf (cellStyle c) t.styles

                ch =
                    if Bitwise.and 2 flags == 0 then
                        Bitwise.and 0xFFFF (v + checksumAttributes c a)

                    else
                        v

                sum =
                    Bitwise.and 0xFFFF acc

                next =
                    if Bitwise.and 4 flags /= 0 then
                        -- xterm adds a cluster's marks only to the DEC sum
                        -- with nothing left out
                        if Bitwise.and 16 flags == 0 && cellIsCluster c then
                            Array.foldl (\p n -> n + Bitwise.and 0xFFFF p) (sum + ch) (Array.dropFirst 1 (cellPoints c t.clusters))

                        else
                            sum + ch

                    else if Bitwise.and 0x10000 acc /= 0 || ch /= 0x20 || checksumKeeps a then
                        sum + ch

                    else
                        sum
            in
            checksumCells t o (x + 1) right (Bitwise.and 0xFFFF next)


{-| A cell's value before attributes, or -1 when it is not counted. A wide
character's spacer is ESC in the DEC checksum, as xterm's placeholder there
is, and nothing with the code point. A cell never written to is a space only
with bit 4 or 8. The DEC 8-bit value is xterm's `xtermCharSetDec` for ASCII,
from the code point, since the byte sent is not kept. -}
checksumValue : Int -> Int64 -> Clusters -> Int
checksumValue flags c clusters =
    if cellWide c == wideTail then
        if Bitwise.and 16 flags /= 0 then
            -1

        else
            0x1B

    else
        let
            cp =
                if cellIsCluster c then
                    Maybe.withDefault 0 (Array.first (cellPoints c clusters))

                else
                    cellPoint c
        in
        if cp == 0 then
            if Bitwise.and 12 flags /= 0 then
                0x20

            else
                -1

        else if Bitwise.and 16 flags /= 0 then
            Bitwise.and 0xFFFF cp

        else if cp == 0x7F || cp == 0xFF then
            0

        else if (cp >= 0x20 && cp <= 0x9F) || (cp >= 0xA1 && cp <= 0xFE) then
            Bitwise.and 0x7F cp

        else
            0x1B


{-| The VT100 attributes xterm adds to a cell's value. -}
checksumAttributes : Int64 -> Attrs -> Int
checksumAttributes c a =
    let
        on bit weight =
            if Bitwise.and bit a.flags /= 0 then
                weight

            else
                0
    in
    (if Bitwise.and protectBit c /= 0 then 0x04 else 0)
        + on 32 0x08
        + (if a.ul /= 0 then 0x10 else 0)
        + on 16 0x20
        + on 8 0x40
        + on 1 0x80


{-| Faint, italic, struck through or a double underline: not added, but they
keep a blank from being left out. -}
checksumKeeps : Attrs -> Bool
checksumKeeps a =
    Bitwise.and (Bitwise.or 2 (Bitwise.or 4 64)) a.flags /= 0 || a.ul == 2


hex4 : Int -> String
hex4 v =
    String.toUpper (hex2 (Bitwise.shiftRightZfBy 8 v) ++ hex2 v)


hex2 : Int -> String
hex2 v =
    let
        digit d =
            String.slice d (d + 1) "0123456789abcdef"

        b =
            Bitwise.and 0xFF v
    in
    digit (b // 16) ++ digit (modBy 16 b)


escapeReply : Bytes -> String
escapeReply bytes =
    String.join ""
        (Array.map
            (\i ->
                let
                    c =
                        byteAt bytes i
                in
                if c >= 0x21 && c < 0x7F && c /= 0x5C then
                    String.fromChar (Maybe.withDefault '?' (Char.fromCode c))

                else
                    "\\x" ++ hex2 c
            )
            (Array.range 0 (Bytes.length bytes - 1))
        )
