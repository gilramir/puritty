{-| puritty's headless terminal core (`docs/vt-core.md`).

A `Term` is fed the bytes a program writes to its terminal, a read at a
time, and holds the screen, the scrollback, the modes and the replies the
program asked for. Everything that happens to a terminal's state happens in
`feed`; nothing in it reads a clock or a file.

**The screen** is the builder probe's (`probes/geng/core/src/Hot.geng`,
`phase1-core.md` §14–§23): a ring of rows in one `Array.Builder Int64`,
`stride` slots a row, its `cols` cells and then its meta slot (the extent,
the column past which the row is blank, and the wrapped flag). Slot `p`'s
row starts at `p * stride`. `base` is the slot of row 0; on the main screen
the ring holds recent scrollback before it, and when the ring is full the
oldest `Config.pageRows` rows of it are packed into a page (geng-lang D901). A
region keeps its own turn, so its line feed moves no rows. The cells past a
row's extent are never read.

**A cell** is an `Int64` (§VC2, V1): bits 0–20 its code point, or the id of
its grapheme cluster when bit 23 is set; bits 21–22 its width state (narrow,
wide, the wide cell's spacer, or a spacer at the end of a row a wide
character did not fit); bits 32–47 its style id. 0 is an empty cell in the
default style.

**The parser** is Paul Williams' DEC state machine, resumable at any byte: a
read may end anywhere and the next picks up from the state it left. In the
ground state a run of printable ASCII is written to its row at once.

-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Int64
import Math
import UInt8
import Vt.Base64 as Base64
import Vt.Cell exposing (..)
import Vt.Dump exposing (..)
import Vt.Edit as Edit
import Vt.Keys as Keys
import Vt.Modes exposing (fresh, modifyOtherKeysKey, privateState)
import Vt.Pages exposing (..)
import Vt.Palette exposing (..)
import Vt.Parse as Parse
import Vt.Print exposing (wrapped)
import Vt.Reason as Reason
import Vt.Recut exposing (recut)
import Vt.Resize exposing (..)
import Vt.Screen exposing (..)
import Vt.Scroll as Scroll exposing (resizeQuiet, withScroll)
import Vt.Style exposing (..)
import Vt.Term exposing (..)
import Vt.Term as State
import Vt.Width as Width


{-| A terminal (`Vt.Term.Term`). -}
type alias Term =
    State.Term


{-| A clipboard request of an OSC 52 (`Vt.Term.Clip`, `takeClipboard`). -}
type alias Clip =
    State.Clip


{-| What the embedder says of itself (`withEmbedder`). -}
type alias Embedder =
    State.Embedder


{-| The rows a view scrolled back shows (`viewAt`), for `Vt.View.frameBack`:
a screen of them, and the clusters to read them with. -}
type alias View =
    { screen : State.Screen, clusters : Clusters }


{-| What a terminal is made with (`Vt.Term.Config`). -}
type alias Config =
    State.Config


{-| The rows the scrollback holds at the terminal's width
(`Vt.Scroll.historyBound`). 536,880,105 is 2^29 + 9,193: the most rows the
pages count (`Back`, §VC51) and the most a ring keeps. -}
historyBound : Term -> (r : Int where 0 <= r && r <= 536880105)
historyBound t =
    Scroll.historyBound t


{-| The rows above the screen a view can scroll back to (`docs/phase3-select.md`
§1, §11): the main screen's scrollback, in the ring and in the pages; none
while the alternate screen is up, which keeps none. 536,880,105 is 2^29 +
9,193: the most rows the pages count (`Back`, §VC51) and the most a ring
keeps. -}
scrollbackRows : Term -> (r : Int where 0 <= r && r <= 536880105)
scrollbackRows t =
    if t.alt then
        0

    else
        t.screen.hist + t.back.rows


{-| The rows that have entered the main screen's scrollback since the term was
made: those it holds and those dropped from its oldest end. A view scrolled
back stays on its rows by moving up as many as this grew by. 1,073,751,017
is 2^30 + 9,193: the rows the scrollback holds and those dropped, each at
most 2^29, and the ring's. -}
rowsPushed : Term -> (r : Int where 0 <= r && r <= 1073751017)
rowsPushed t =
    historyBound t + t.back.gone


{-| An absolute row (`Point`'s) as a row of the screen, `pushed` rows having
entered the scrollback: below the screen's top for one in the scrollback.
One more than 2^30 rows above the screen is taken as that far, which is
above any scrollback (§VC51), so that a point from anywhere is never past
`Int`'s range. 1,073,751,017 is 2^30 + 9,193: the rows the scrollback holds
and those dropped, each at most 2^29, and the ring's. -}
fromAbsolute : Int -> (pushed : Int where 0 <= pushed && pushed <= 1073751017) -> (r : Int where 0 - 1073741824 <= r)
fromAbsolute row pushed =
    if row < pushed - 1073741824 then
        0 - 1073741824

    else
        row - pushed


{-| The screen a view scrolled `back` rows up shows, as a screen of its
own, `rows` rows of the scrollback and the screen from `back` rows above
the screen's top (`back` kept between 0 and `scrollbackRows`). A row in the
ring is copied; one in the pages is read from its page, which interns its
clusters in a copy of the term's table that the view carries, so the term
is only read. -}
viewAt : Int -> Term -> View
viewAt back0 t =
    let
        back =
            clamp 0 (scrollbackRows t) back0

        read =
            rowsBetween (0 - back) t.rows t
    in
    -- a ring has a row past its screen's, which a view never uses
    { screen = writeRows read.rows 0 0 t.rows (newScreen t.cols t.rows (t.rows + 1)), clusters = read.clusters }


{-| The screen as a view (`viewAt 0`), with text painted over its cells
at a row and a column each: what an embedder draws over the terminal and
takes away again, as puritty's menu (`docs/settings.md` ST26), while the
term itself is only read. The text is plain, in the default style, a
character's cells by its width; a wide character cut at either edge of
what is painted is a space. -}
viewPainted : Array { row : Int, col : Int, text : String } -> Term -> View
viewPainted paints t =
    let
        read =
            paintedRows paints t
    in
    { screen = writeRows read.rows 0 0 t.rows (newScreen t.cols t.rows (t.rows + 1)), clusters = read.clusters }


{-| Spans of the screen drawn inverse, as puritty draws a selection over
the panes it laid on (`docs/tmux.md` TM17): each cell from `from` to `to`
in its row, both included, its style's inverse flag turned over. -}
invert : Array { row : Int, from : Int, to : Int } -> (taken t : Term) -> Term
invert spans t =
    if Array.isEmpty spans then
        t

    else
        let
            cols =
                t.cols

            read =
                rowsBetween 0 t.rows t

            start =
                { rows = Array.map (\r -> r.cells ++ Array.repeat (cols - Array.length r.cells) (Int64.fromInt 0)) read.rows, styles = t.styles }

            done =
                Array.foldl
                    (\sp acc ->
                        when Array.get sp.row acc.rows is
                            Just cells ->
                                let
                                    turned =
                                        Array.foldl
                                            (\x a ->
                                                when Array.get x a.cells is
                                                    Just c ->
                                                        let
                                                            attrs =
                                                                styleOf (Bitwise.and 0xFFFF (cellStyle c)) a.styles

                                                            interned =
                                                                intern { attrs | flags = Bitwise.xor 16 attrs.flags } a.styles
                                                        in
                                                        { cells = Array.set x (Bitwise.or (styleBits interned.id) (Bitwise.and (Bitwise.complement (styleBits 0xFFFF)) c)) a.cells, styles = interned.styles }

                                                    Nothing ->
                                                        meant Reason.OutOfRange a
                                            )
                                            { cells = cells, styles = acc.styles }
                                            (Array.range (max 0 sp.from) (min (cols - 1) sp.to))
                                in
                                { rows = Array.set sp.row turned.cells acc.rows, styles = turned.styles }

                            Nothing ->
                                meant Reason.OutOfRange acc
                    )
                    start
                    spans
        in
        { t | screen = writeRows (Array.map (\cells -> { cells = cells, wrapped = False, prompt = 0 }) done.rows) 0 0 t.rows t.screen, styles = done.styles }


{-| Where the cursor is on the screen, and whether DECTCEM shows it. -}
cursorOf : Term -> { x : Int, y : Int, visible : Bool }
cursorOf t =
    { x = t.x, y = t.y, visible = t.showCursor }


{-| Panes drawn into a terminal's screen, as puritty draws tmux's panes in
one window (`docs/tmux.md` TM14): each place's pane, by its index, its
screen's rows and columns from the place's row and column of this
terminal's, in the places' order, so a later pane lies over an earlier
one, and cut at this terminal's edges. The panes are only read. A pane's cells keep
their characters, clusters and styles: its styles and clusters are taken
into this terminal's own tables. What no pane covers keeps what this
terminal's screen held, so panes, and text `paint` paints between them, can
be laid on in turns; ED 2 first clears it. This terminal is the embedder's canvas, never fed a program's output; its
cursor is the embedder's to place.

A pane's colors by number resolve against this terminal's palette, and a
pane's own OSC 4, 10 and 11 are not carried. -}
compose : Builder Term -> Array { index : Int, x : Int, y : Int, back : Int } -> (taken t : Term) -> Term
compose panes places t =
    composeStyled panes (Array.map (\p -> { index = p.index, x = p.x, y = p.y, back = p.back, fg = 0, bg = 0 }) places) t


{-| `compose`, each pane with a foreground and a background its cells
take where they have none of their own (0: none), as tmux's
`window-style` and `window-active-style` give a pane (puritty
`docs/tmux.md` TM52). Colors are as `Attrs` holds them: 1 to 256 a
palette index and one more, `0x1000000` and the RGB value. -}
composeStyled : Builder Term -> Array { index : Int, x : Int, y : Int, back : Int, fg : Int, bg : Int } -> (taken t : Term) -> Term
composeStyled panes places t =
    let
        cols =
            t.cols

        rows =
            t.rows

        -- what the screen holds, each row its full width
        start =
            { rows = Array.map (\r -> r.cells ++ Array.repeat (cols - Array.length r.cells) (Int64.fromInt 0)) (rowsBetween 0 rows t).rows
            , styles = t.styles
            , clusters = t.clusters
            }

        done =
            Array.foldl
                (\place acc ->
                    when Builder.get place.index panes is
                        Just pane ->
                            composePane cols rows pane place.x place.y place.back { fg = place.fg, bg = place.bg } acc

                        Nothing ->
                            meant Reason.NotKnown acc
                )
                start
                places

        written =
            Array.map (\cells -> { cells = cells, wrapped = False, prompt = 0 }) done.rows
    in
    { t | screen = writeRows written 0 0 rows t.screen, styles = done.styles, clusters = done.clusters }


composePane : (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> Term -> Int -> Int -> Int -> { fg : Int, bg : Int } -> { rows : Array (Array Int64), styles : Styles, clusters : Clusters } -> { rows : Array (Array Int64), styles : Styles, clusters : Clusters }
composePane cols rows pane px py back0 base acc =
    let
        -- the pane's rows scrolled `back` rows up, as `viewAt` reads them
        back =
            clamp 0 (scrollbackRows pane) back0

        read =
            rowsBetween (0 - back) pane.rows pane

        -- a place far outside the window draws nothing, so that nothing
        -- computed from it can wrap
        width =
            if px < 0 || px > 16384 then
                0

            else
                max 0 (min pane.cols (cols - px))
    in
    Array.indexedFoldl
        (\ry row a ->
            let
                ty =
                    if ry < rows && py >= -16384 && py <= 16384 then
                        py + ry

                    else
                        -1
            in
            if ty < 0 || ty >= rows || width == 0 || px < 0 then
                a

            else
                let
                    cells =
                        Array.takeFirst width row.cells

                    padded =
                        cells ++ Array.repeat (width - Array.length cells) (Int64.fromInt 0)

                    moved =
                        Array.foldl
                            (\c m ->
                                let
                                    one =
                                        composeCell base pane.styles read.clusters c m.styles m.clusters
                                in
                                { cells = Array.pushLast one.cell m.cells, styles = one.styles, clusters = one.clusters }
                            )
                            { cells = [], styles = a.styles, clusters = a.clusters }
                            padded

                    target =
                        Maybe.withDefault [] (Array.get ty a.rows)
                in
                { rows = Array.set ty (Array.setMany px moved.cells target |> Array.takeFirst cols) a.rows
                , styles = moved.styles
                , clusters = moved.clusters
                }
        )
        acc
        read.rows


{-| A pane's cell with its style and cluster ids this terminal's. -}
composeCell : { fg : Int, bg : Int } -> Styles -> Clusters -> Int64 -> Styles -> Clusters -> { cell : Int64, styles : Styles, clusters : Clusters }
composeCell base paneStyles paneClusters c styles clusters =
    let
        style =
            Bitwise.and 0xFFFF (cellStyle c)

        interned =
            if base.fg == 0 && base.bg == 0 then
                if style == 0 then
                    { id = 0, styles = styles }

                else
                    intern (styleOf style paneStyles) styles

            else
                -- the pane's own defaults where the cell has none
                let
                    attrs =
                        if style == 0 then
                            plainAttrs

                        else
                            styleOf style paneStyles
                in
                intern
                    { attrs
                        | fg =
                            if attrs.fg == 0 then
                                base.fg

                            else
                                attrs.fg
                        , bg =
                            if attrs.bg == 0 then
                                base.bg

                            else
                                attrs.bg
                    }
                    styles

        styled =
            Bitwise.or (styleBits interned.id) (Bitwise.and (Bitwise.complement (styleBits 0xFFFF)) c)
    in
    if cellIsCluster c then
        when internCluster (cellPoints c paneClusters) clusters is
            Just k ->
                { cell = Bitwise.or (Int64.fromInt k.id) (Bitwise.and (Bitwise.complement 0x1FFFFF) styled), styles = interned.styles, clusters = k.clusters }

            Nothing ->
                -- no room for another cluster: its first code point alone
                meant Reason.NoMore { cell = Bitwise.or (Int64.fromInt (Maybe.withDefault (meant Reason.NotKnown 32) (Array.first (cellPoints c paneClusters)))) (Bitwise.and (Bitwise.complement 0xFFFFFF) styled), styles = interned.styles, clusters = clusters }

    else
        { cell = styled, styles = interned.styles, clusters = clusters }


{-| The text `viewPainted` paints, painted into the term's own screen
instead: for a test to read with `dump`, which reads a term. -}
paint : Array { row : Int, col : Int, text : String } -> (taken t : Term) -> Term
paint paints t =
    let
        read =
            paintedRows paints t

        rows =
            t.rows
    in
    { t | screen = writeRows read.rows 0 0 rows t.screen }


paintedRows : Array { row : Int, col : Int, text : String } -> Term -> { rows : Array Row, clusters : Clusters }
paintedRows paints t =
    let
        read =
            rowsBetween 0 t.rows t
    in
    { rows =
        Array.indexedMap
            (\y r ->
                Array.foldl
                    (\p acc ->
                        if p.row == y then
                            { acc | cells = paintCells p.col p.text acc.cells }

                        else
                            acc
                    )
                    r
                    paints
            )
            read.rows
    , clusters = read.clusters
    }


{-| A row's cells with text written from a column, as plain cells. -}
paintCells : Int -> String -> Array Int64 -> Array Int64
paintCells col text cells0 =
    let
        widthOf cp =
            if cp < 0x20 then
                0

            else if cp < 0x80 then
                1

            else
                Width.width cp

        points =
            String.toArray text |> Array.map Char.toCode |> Array.keepIf (\cp -> widthOf cp > 0)

        span =
            Array.foldl (\cp n -> n + widthOf cp) 0 points

        padded =
            if Array.length cells0 < col + span + 1 then
                cells0 ++ Array.repeat (col + span + 1 - Array.length cells0) 0

            else
                cells0

        -- a wide character the text begins on the tail of, or ends on the
        -- head of, loses its other half: a space
        mended =
            padded
                |> mendAt (col - 1) wideHead
                |> mendAt (col + span) wideTail

        written =
            Array.foldl
                (\cp acc ->
                    if widthOf cp == 2 then
                        { x = acc.x + 2
                        , cells = acc.cells |> Array.set acc.x (Int64.fromInt (Bitwise.or wideHead cp)) |> Array.set (acc.x + 1) (Int64.fromInt wideTail)
                        }

                    else
                        { x = acc.x + 1, cells = Array.set acc.x (Int64.fromInt cp) acc.cells }
                )
                { x = col, cells = mended }
                points
    in
    written.cells


mendAt : Int -> Int -> Array Int64 -> Array Int64
mendAt i half cells =
    when Array.get i cells is
        Just c ->
            if cellWide c == half then
                Array.set i 32 cells

            else
                cells

        Nothing ->
            meant Reason.OutOfRange cells


{-| `count` rows of the main screen and its scrollback from logical row `first`
on (negative in the scrollback), read as `viewAt` reads them: the ring's
copied, the pages' read with their clusters interned in a copy of the term's
table. The caller keeps `first` and the count within the scrollback and the
screen. 536,880,105 is 2^29 + 9,193: the most rows the pages count (`Back`,
§VC51) and the most a ring keeps. -}
rowsBetween : (first : Int where 0 - 536880105 <= first && first <= t.rows) -> (count : Int where 0 <= count && first + count <= t.rows) -> (t : Term) -> { rows : Array Row, clusters : Clusters }
rowsBetween first count t =
    let
        hist =
            t.screen.hist

        -- the rows above the ring's scrollback are the pages'; paged row
        -- `t.back.rows - 1` is logical row `-hist - 1`
        fromPages =
            if t.alt then
                0

            else
                min count (max 0 (0 - hist - first))

        paged =
            viewPages t.back t.back.head 0 (t.back.rows + first + hist) fromPages t.clusters []

        ring =
            -- from the ring's oldest row: a read that ends above it reads
            -- none of it
            ringRows (max (0 - hist) (first + fromPages)) (first + count) t []
    in
    { rows = paged.rows ++ ring, clusters = paged.clusters }


{-| A place in the terminal for a selection (`docs/phase3-select.md` §5):
`row` counts from the first row the main screen ever had, so it stays on
its text as rows scroll into the scrollback (`rowsPushed` plus the row on
the screen); `col` from 0. -}
type alias Point =
    { row : Int, col : Int }


{-| The text between two points, both included, in either order, as a copy
reads it (`docs/phase3-select.md` §5): a row that wraps joined to the next,
a newline after any other, the blanks at a line's end dropped, a wide
character's tail and a spacer at a row's end skipped, a cluster read whole.
Rows dropped from the scrollback's oldest end are gone from it. -}
selectionText : Point -> Point -> Term -> String
selectionText p q t =
    let
        ordered =
            if p.row < q.row || (p.row == q.row && p.col <= q.col) then
                { a = p, b = q }

            else
                { a = q, b = p }

        pushed =
            rowsPushed t

        ya =
            fromAbsolute ordered.a.row pushed

        yb =
            fromAbsolute ordered.b.row pushed

        first =
            max ya (0 - scrollbackRows t)

        last =
            min yb (t.rows - 1)
    in
    if last < first then
        ""

    else
        let
            read =
                rowsBetween first (last - first + 1) t

            lo =
                if first == ya then
                    ordered.a.col

                else
                    0

            hi =
                if last == yb then
                    ordered.b.col

                else
                    t.cols - 1
        in
        textOfRows read.rows read.clusters lo hi t.cols 0 ""


textOfRows : Array Row -> Clusters -> Int -> Int -> Int -> Int -> String -> String
textOfRows rows clusters lo hi cols i acc =
    when Array.get i rows is
        Nothing ->
            meant Reason.NoMore acc

        Just row ->
            let
                n =
                    Array.length rows

                from =
                    if i == 0 then
                        lo

                    else
                        0

                to =
                    if i == n - 1 then
                        hi

                    else
                        cols - 1

                piece =
                    cellsText row.cells clusters from to ""

                text =
                    if row.wrapped && i < n - 1 then
                        piece

                    else
                        String.trimRight piece
                            ++ (if i < n - 1 then
                                    "\n"

                                else
                                    ""
                               )
            in
            textOfRows rows clusters lo hi cols (i + 1) (acc ++ text)


cellsText : Array Int64 -> Clusters -> Int -> Int -> String -> String
cellsText cells clusters x to acc =
    if x > to then
        acc

    else
        let
            c =
                if x < 0 then
                    0

                else
                    Maybe.withDefault (meant Reason.OutOfRange 0) (Array.get x cells)

            w =
                cellWide c

            text =
                if w == wideTail || w == spacerHead then
                    ""

                else
                    when cellPoints c clusters is
                        [] ->
                            " "

                        points ->
                            String.fromArray (Array.mapAndKeepJust Char.fromCode points)
        in
        cellsText cells clusters (x + 1) to (acc ++ text)


{-| The characters that end a word for a double click, Ghostty's
`selection-word-chars`: tab, space and `'"│`|:;,()[]{}<>$`. -}
defaultWordBoundaries : Array Int
defaultWordBoundaries =
    Array.map Char.toCode (String.toArray "\t '\"│`|:;,()[]{}<>$")


{-| The word under a point for a double click, as Ghostty's
`Screen.selectWord` finds it: the run of cells on either side whose first
code point is a boundary character (`boundaries`) when the point's is one,
and is not when it is not; a run stops at a cell with no text and at the
end of a line, and goes on across a row that wraps. A wide character's tail
is its head; a spacer at a row's end is the wide character it moved to the
next row. Nothing when the point's cell has no text. -}
wordAt : Array Int -> Point -> Term -> Maybe { start : Point, end : Point }
wordAt boundaries p t =
    let
        line =
            lineCells p t
    in
    when Maybe.andThen identity (Array.get line.at line.cps) is
        Nothing ->
            meant Reason.OutOfRange Nothing

        Just cp ->
            let
                want =
                    Array.member cp boundaries

                left =
                    runEdge boundaries want line.cps line.at -1

                right =
                    runEdge boundaries want line.cps line.at 1
            in
            Just { start = pointOf line left, end = pointOf line right }


runEdge : Array Int -> Bool -> Array (Maybe Int) -> Int -> Int -> Int
runEdge boundaries want cps i step =
    let
        -- the next index along, -1 for none: one back, or one on while it
        -- is inside the line, so that it cannot wrap
        next =
            if i < 0 then
                -1

            else if step < 0 then
                i - 1

            else if i < Array.length cps then
                i + 1

            else
                -1
    in
    -- `Array.get` counts a negative index from the end
    when (if next < 0 then
            Nothing

          else
            Maybe.andThen identity (Array.get next cps)
         ) is
        Just c ->
            if Array.member c boundaries == want then
                runEdge boundaries want cps next step

            else
                i

        Nothing ->
            meant Reason.OutOfRange i


{-| The line under a point for a triple click: its rows, from the first
after a row that does not wrap to the first that does not, without the
blanks at either end, as Ghostty's `Screen.selectLine` trims them. Nothing
on a blank line. -}
lineAt : Point -> Term -> Maybe { start : Point, end : Point }
lineAt p t =
    let
        line =
            lineCells p t

        n =
            Array.length line.cps
    in
    when inkFrom line.cps 0 1 n is
        Just f ->
            when inkFrom line.cps (n - 1) -1 n is
                Just l ->
                    Just { start = pointOf line f, end = pointOf line l }

                Nothing ->
                    Nothing

        Nothing ->
            meant Reason.NoMore Nothing


inkFrom : Array (Maybe Int) -> Int -> Int -> Int -> Maybe Int
inkFrom cps i step n =
    if i < 0 || i >= n then
        Nothing

    else
        when Maybe.andThen identity (Array.get i cps) is
            Just c ->
                if c /= 32 && c /= 9 then
                    Just i

                else
                    inkFrom cps (i + step) step n

            Nothing ->
                meant Reason.OutOfRange inkFrom cps (i + step) step n


type alias LineCells =
    { cps : Array (Maybe Int), at : Int, base : Int, cols : Int }


pointOf : LineCells -> Int -> Point
pointOf line i =
    { row = line.base + i // line.cols, col = modBy line.cols i }


{-| The cells of the line a point is on, each its first code point as a
word reads it (Nothing for a cell with no text), the point's index among
them, and the absolute row of the line's first. Up to 100 rows each way
are read. -}
lineCells : Point -> Term -> LineCells
lineCells p t =
    let
        pushed =
            rowsPushed t

        most =
            scrollbackRows t

        y =
            clamp (0 - most) (t.rows - 1) (fromAbsolute p.row pushed)

        first =
            max (0 - most) (y - 100)

        last =
            min (t.rows - 1) (y + 100)

        read =
            rowsBetween first (last - first + 1) t

        k =
            y - first

        top =
            lineTop read.rows k

        bottom =
            lineBottom read.rows k

        cols =
            t.cols
    in
    { cps = lineCps read.rows read.clusters cols top bottom []
    , at = (k - top) * cols + clamp 0 (cols - 1) p.col
    , base = pushed + first + top
    , cols = cols
    }


lineCps : Array Row -> Clusters -> Int -> Int -> Int -> Array (Maybe Int) -> Array (Maybe Int)
lineCps rows clusters cols r bottom acc =
    if r > bottom then
        acc

    else
        let
            cells =
                Maybe.withDefault (meant Reason.OutOfRange []) (Maybe.map .cells (Array.get r rows))

            next =
                -- the row after `r`, which there is none of unless `r` is
                -- one of the rows, so that `r + 1` is no wider than their
                -- count
                if r < Array.length rows then
                    Maybe.withDefault (meant Reason.OutOfRange []) (Maybe.map .cells (Array.get (r + 1) rows))

                else
                    []

            cpAt x =
                let
                    own =
                        -- a cell past the row's extent is empty
                        when Array.get x cells is
                            Nothing ->
                                meant Reason.OutOfRange 0

                            Just c ->
                                let
                                    w =
                                        cellWide c
                                in
                                if w == wideTail && x > 0 then
                                    Array.getProven (x - 1) cells

                                else if w == spacerHead then
                                    Maybe.withDefault (meant Reason.OutOfRange 0) (Array.get 0 next)

                                else
                                    c
                in
                Array.first (cellPoints own clusters)
        in
        lineCps rows clusters cols (r + 1) bottom (acc ++ Array.map cpAt (Array.range 0 (cols - 1)))


wrapsAt : (rows : Array Row) -> (i : Int where 0 <= i && i < Array.length rows) -> Bool
wrapsAt rows i =
    (Array.getProven i rows).wrapped


lineTop : Array Row -> Int -> Int
lineTop rows k =
    if k > 0 && k <= Array.length rows && wrapsAt rows (k - 1) then
        lineTop rows (k - 1)

    else
        k


lineBottom : Array Row -> Int -> Int
lineBottom rows k =
    if k >= 0 && k < Array.length rows - 1 && wrapsAt rows k then
        lineBottom rows (k + 1)

    else
        k


{-| A hash of the screen's rows between two absolute rows, those still on
the screen: what a selection's highlight is held to, so that it goes when
a program writes over the rows it covers (`docs/phase3-select.md` §5). -}
rowsHash : Int -> Int -> Term -> Int
rowsHash a b t =
    let
        pushed =
            rowsPushed t

        first =
            max 0 (fromAbsolute (min a b) pushed)

        last =
            min (t.rows - 1) (fromAbsolute (max a b) pushed)
    in
    if last < first then
        0

    else
        hashRowsOf (ringRows first (last + 1) t []) (7 + first)


hashRowsOf : Array Row -> Int -> Int
hashRowsOf rows h0 =
    Array.foldl
        (\r h ->
            Array.foldl (\c acc -> Bitwise.and 0x3FFFFFFF (acc * 31 + Int64.toIntWrap (Bitwise.xor c (Bitwise.shiftRightZfBy 32 c))))
                (Bitwise.and 0x3FFFFFFF
                    (h * 31
                        + (if r.wrapped then
                            1

                           else
                            2
                          )
                    )
                )
                r.cells
        )
        h0
        rows


{-| The ring's rows `y` to `stop - 1`, a loop, since a function that
captures the screen to read it would take its builder. -}
ringRows : (y : Int where 0 - t.screen.hist <= y) -> (stop : Int where stop <= t.rows) -> (t : Term) -> Array Row -> Array Row
ringRows y stop t acc =
    if y >= stop then
        acc

    else
        ringRows (y + 1) stop t (Array.pushLast (ringRowOf (rowOffset t.screen y) t.screen) acc)


{-| A view scrolled to the shell's previous prompt (`delta` below 0) or its
next, as Ghostty's `jump_to_prompt` scrolls (`PageList.scrollPrompt`): the
prompt is a row marked as a prompt's start (OSC 133 `A`, §VC22), and it is
put at the view's top. Down, the search starts below the view's top row and
past the continuations of a prompt there; a prompt on the screen itself is
the bottom, 0. With no prompt that way, the view stays where it is. -}
promptJump : Int -> Int -> Term -> Int
promptJump delta back0 t =
    let
        most =
            scrollbackRows t

        back =
            clamp 0 most back0

        top =
            0 - back
    in
    if most == 0 || delta == 0 then
        back

    else if delta < 0 then
        when promptUp (top - 1) (0 - most) t is
            Just y ->
                0 - y

            Nothing ->
                meant Reason.NoMore back

    else
        let
            start =
                if promptMark top t /= 0 then
                    pastContinuations (top + 1) t

                else
                    top + 1
        in
        when promptDown start (t.rows - 1) t is
            Just y ->
                max 0 (0 - y)

            Nothing ->
                meant Reason.NoMore back


-- 536,880,105 is 2^29 + 9,193: the most rows the pages count (`Back`,
-- §VC51) and the most a ring keeps
promptUp : (y : Int where y < t.rows) -> (stop : Int where 0 - 536880105 <= stop) -> (t : Term) -> Maybe Int
promptUp y stop t =
    if y < stop then
        Nothing

    else if promptMark y t == 1 then
        Just y

    else
        promptUp (y - 1) stop t


-- 536,880,105 is 2^29 + 9,193: the most rows the pages count (`Back`,
-- §VC51) and the most a ring keeps
promptDown : (y : Int where 0 - 536880105 <= y) -> (stop : Int where stop < t.rows) -> (t : Term) -> Maybe Int
promptDown y stop t =
    if y > stop then
        Nothing

    else if promptMark y t == 1 then
        Just y

    else
        promptDown (y + 1) stop t


-- 536,880,105 is 2^29 + 9,193: the most rows the pages count (`Back`,
-- §VC51) and the most a ring keeps
pastContinuations : (y : Int where 0 - 536880105 <= y) -> Term -> (r : Int where y <= r)
pastContinuations y t =
    if y < t.rows && promptMark y t == 2 then
        pastContinuations (y + 1) t

    else
        y


{-| The prompt mark of logical row `y` of the main screen and its scrollback: 0
none, 1 a prompt's start, 2 its continuation, as the ring's meta slot and a
page's row header keep it. 536,880,105 is 2^29 + 9,193: the most rows the
pages count (`Back`, §VC51) and the most a ring keeps. -}
promptMark : (y : Int where 0 - 536880105 <= y && y < t.rows) -> (t : Term) -> Int
promptMark y t =
    if y >= 0 - t.screen.hist then
        metaPrompt (metaAt (rowOffset t.screen y) t.screen)

    else
        pagedPrompt t.back t.back.head (t.back.rows + y + t.screen.hist)


{-| The prompt mark of paged row `r` counted from slot `i`'s page on: the
pages before the one it lies in are stepped over, `r` less each one's rows. -}
pagedPrompt : Back -> Int -> Int -> Int
pagedPrompt b i r =
    when Builder.get i b.pages is
        Nothing ->
            meant Reason.OutOfRange 0

        Just page ->
            let
                count =
                    pageRowCount page
            in
            if count <= r then
                pagedPrompt b (i + 1) (r - count)

            else
                pagePromptAt page r


{-| `want` rows of the pages from paged row `at` on, read from each page
they lie in; `start` is the paged row slot `i`'s page begins at. A loop
over the slots, as `readBack` is, so the pages are only lent. -}
viewPages : Back -> Int -> Int -> Int -> Int -> Clusters -> Array Row -> { rows : Array Row, clusters : Clusters }
viewPages b i start at want clusters acc =
    if want <= 0 then
        { rows = acc, clusters = clusters }

    else
        when Builder.get i b.pages is
            Nothing ->
                meant Reason.NoMore { rows = acc, clusters = clusters }

            Just page ->
                let
                    count =
                        pageRowCount page
                in
                if count <= at - start then
                    viewPages b (i + 1) (start + count) at want clusters acc

                else
                    let
                        read =
                            pageRowsOf page clusters

                        taken =
                            Array.slice (at - start) (at - start + want) read.rows

                        n =
                            Array.length taken
                    in
                    viewPages b (i + 1) (start + count) (at + n) (want - n) read.clusters (acc ++ taken)


{-| Whether the scrollback may have been pruned, by the core or by a
terminal keeping `rows` rows: whether a page has gone for the byte limit,
or the scrollback may have held `rows` rows, at any time since the term was
made, inside a read as well as between them (`Back`'s `dropped` and `peak`,
§VC25, §VC32). For the differential fuzzer, whose Ghostty keeps `rows`. -}
historyReached : Int -> Term -> Bool
historyReached rows t =
    t.back.dropped || max t.back.peak (historyBound t) >= rows


{-| The rows a page of scrollback holds unless `Config.pageRows` says
otherwise: 1,024, so that a full collection, whose marking follows a page's
objects and not its bytes, meets G7's 4 ms goal at eight panes (puritty
`docs/phase2-window.md` §15.4, V33). The harnesses use 256, so that a short
case still fills pages. -}
defaultPageRows : Int
defaultPageRows =
    1024


{-| The bytes of scrollback (`Config.scrollbackBytes`) that hold at least
`rows` rows `cols` wide of text in one style, a byte a cell: a row's cells
and its header. Text of shorter lines takes fewer bytes a row and so gets
more rows, often several times as many; a style changed inside a row, or
characters of more bytes than columns, take more and get fewer (§VC32). -}
scrollbackBytesFor : { cols : Int, rows : Int } -> Int
scrollbackBytesFor size =
    max 0 size.rows * (max 1 size.cols + 2)


{-| Whether the scrollback's pages, cut again at `cols` on their bytes
(`recut`, V20), hold the rows the reflow of the ring's rows makes of them
(`reflowed`): each cell's code points, width and style, and each row's
wrapped flag and prompt mark. For the fuzzer (§VC31). -}
recutHolds : Int -> Term -> Bool
recutHolds cols t =
    let
        read =
            readBack t.cols t.clusters t.back

        want =
            reflowed t.cols cols read.rows

        -- copies, since the term is only lent
        pages =
            copyPages t.back

        cut =
            recut t.back.pageRows reflowed t.cols cols read.clusters (Array.length pages) pages

        got =
            readPages cols cut.clusters cut.pages 0

        key clusters row =
            { cells = Array.map (\c -> { points = cellPoints c clusters, rest = Bitwise.and c (Bitwise.complement 0x9FFFFF) }) row.cells, wrapped = row.wrapped, prompt = row.prompt }
    in
    t.cols == cols || Array.map (key read.clusters) want == Array.map (key got.clusters) got.rows


new : Config -> Term
new config0 =
    let
        config =
            { cols = clamp 1 1000 config0.cols
            , rows = clamp 1 1000 config0.rows
            , scrollbackBytes = max 0 config0.scrollbackBytes
            , pageRows = clamp 16 4096 config0.pageRows
            , checksums = config0.checksums
            , cellWidth = max 0 config0.cellWidth
            , cellHeight = max 0 config0.cellHeight
            }
    in
    withScroll (fresh config)


{-| The terminal with what its embedder says of itself (`Term.Embedder`,
`docs/tmux.md` TM4): the colors OSC 10 and 11 answer and DSR 996 judges,
DA1's answer and XTVERSION's name. When the theme that makes dark or light
changes and a program asked to hear of it (mode 2031), the terminal tells
it, `CSI ? 997 ; 1 n` or `; 2 n`, among its replies: puritty's settings
reloaded with another background is such a change. -}
withEmbedder : Embedder -> (taken t : Term) -> Term
withEmbedder embedder t =
    let
        before =
            themeReport t

        told =
            { t | embedder = embedder }

        after =
            themeReport told
    in
    when after is
        Just report ->
            if after /= before && Dict.get 2031 told.modes == Just True then
                reply report told

            else
                told

        Nothing ->
            meant Reason.NotSet told


{-| The terminal with its 16 named colors as its embedder's (puritty's
`[colors] palette`, docs/phase3-select.md §22): the first `Array.length`
of them, up to 16, in place of libghostty-vt's; the rest are kept. They are
what OSC 4 answers and what OSC 104 and RIS go back to. -}
withPalette : Array Int -> (taken t : Term) -> Term
withPalette colors t =
    { t | named = Array.indexedMap (\i d -> Maybe.withDefault (meant Reason.NotSet d) (Array.get i colors)) t.named }


{-| The terminal with its 16 named colors as its embedder's, over
libghostty-vt's own rather than the ones it has: `withPalette` for a
palette changed while the terminal runs (puritty's settings reloaded,
`docs/settings.md` ST4), so that a color the new palette no longer names
goes back to its default. Colors a program set with OSC 4 stay its. -}
setPalette : Array Int -> (taken t : Term) -> Term
setPalette colors t =
    { t | named = Array.indexedMap (\i d -> Maybe.withDefault (meant Reason.NotSet d) (Array.get i colors)) namedColors }


{-| The most bytes the scrollback's pages may hold, changed while the
terminal runs (`Config.scrollbackBytes`; puritty's settings reloaded,
`docs/settings.md` ST4): a smaller limit drops the oldest pages over it at
once, a larger one keeps what there is and lets it grow, and none at all
clears the scrollback as ED 3 does, so that the terminal holds what one
made with the limit would. On the alternate screen ED 3 leaves the main
screen's rows, so a limit of none then drops its pages and keeps its last
rows until the main screen is back. -}
setScrollbackBytes : Int -> (taken t : Term) -> Term
setScrollbackBytes bytes t =
    let
        back =
            t.back

        limited =
            { t | back = dropOver { back | limit = max 0 bytes } }
    in
    if bytes <= 0 then
        Edit.clearScrollback limited

    else
        limited


{-| The clipboard requests OSC 52 made since the last take
(`docs/phase3-select.md` §16), for the embedder, which decides what may
be done with them. -}
takeClipboard : (taken t : Term) -> { term : Term, requests : Array Clip }
takeClipboard t =
    let
        requests =
            t.osc52.requests

        o =
            t.osc52
    in
    { term = { t | osc52 = { o | requests = [] } }, requests = requests }


{-| The terminal listening for the diagnostic log at `level`
(`Term.Embedder`'s `listening`, `docs/diagnostics.md` DG6), its other
embedder's sayings as they were. -}
listen : Int -> (taken t : Term) -> Term
listen level t =
    let
        e =
            t.embedder
    in
    if e.listening == level then
        t

    else
        { t | embedder = { e | listening = level } }


{-| What the diagnostic log heard since it was last taken (`docs/diagnostics.md`
DG6), a line each, `probe …` or `ignored …`, while the embedder listens. -}
takeHeard : (taken t : Term) -> { term : Term, heard : Array String }
takeHeard t =
    let
        heard =
            t.heard
    in
    { term = { t | heard = [] }, heard = heard }


{-| The replies the terminal has to write back to the program, oldest
first, taken out. -}
takeReplies : (taken t : Term) -> { term : Term, replies : Array Bytes }
takeReplies t =
    let
        replies =
            t.replies
    in
    { term = { t | replies = [] }, replies = replies }


{-| The terminal fed one read's bytes (`Vt.Parse.feed`). -}
feed : Bytes -> (taken t : Term) -> Term
feed bytes t =
    Parse.feed bytes t


-- MODES


{-| Which mouse events the program asked for and in which format, as
`Vt.Mouse` takes them: the last of modes 9, 1000, 1002 and 1003 set, and of
1005, 1006, 1015 and 1016, with a reset of any one of a group taking it back
to none, as Ghostty's flags do. -}
mouseModes : Term -> { tracking : Int, format : Int }
mouseModes t =
    { tracking = t.mouseTracking, format = t.mouseFormat }


{-| What a key's bytes depend on, for `Vt.Keys.encode`: the modes, the
`modifyOtherKeys` state, and the kitty flags on top of the active screen's
stack. -}
keyOptions : Term -> Keys.Options
keyOptions t =
    { cursorApplication = privateState 1 t == 1
    , keypadApplication = privateState 66 t == 1
    , backarrow = privateState 67 t == 1
    , ignoreKeypadWithNumlock = privateState 1035 t == 1
    , altEscPrefix = privateState 1036 t == 1
    , modifyOtherKeys2 = Dict.get modifyOtherKeysKey t.modes == Just True
    , kittyFlags = Array.getProven t.keys.at t.keys.stack
    }


-- SCROLLING


{-| The terminal made `cols` by `rows`, as its host resizes it, by Ghostty's
rules (§VC14, V8). The main screen's lines reflow to the new width, its
scrollback with them, unless autowrap is off; the alternate screen's rows
are cut or extended and never reflow. The cursor and the saved cursors move
with the cells they are on. The scroll region and the margins are reset, and
the tab stops when the width changes. With mode 2048 set the new size is
reported, as Ghostty reports it even when the size is the same (V15). -}
resize : Int -> Int -> (taken t : Term) -> Term
resize cols rows t =
    let
        r =
            resizeQuiet cols rows t
    in
    if Dict.get 2048 r.modes == Just True then
        sizeReport r

    else
        r


-- THE DUMP


{-| The terminal in puritty's screen dump (`docs/vt-core.md` §VC3), the
form harness/oracle/ghostty-dump prints libghostty-vt's in. -}
dump : Term -> String
dump t =
    let
        history =
            historyRows t

        yes flag text =
            if flag then
                text

            else
                ""

        head =
            [ "screen " ++ String.fromInt t.cols ++ "x" ++ String.fromInt t.rows ++ " " ++ yes (not (isAlt t)) "main" ++ yes (isAlt t) "alt"
            , "cursor " ++ String.fromInt t.x ++ "," ++ String.fromInt t.y ++ yes t.wrapNext " wrap" ++ yes (not t.showCursor) " hidden"
            , "history " ++ String.fromInt (Array.length history)
            ]

        histLines =
            Array.indexedMap (\i row -> rowLines ("h" ++ String.fromInt i) row t.styles) history

        screenLines =
            Array.indexedMap (\y row -> rowLines (String.fromInt y) row t.styles) (screenRows t)

        replyLines =
            Array.map (\r -> "reply " ++ escapeReply r) t.replies
    in
    String.join "\n" (Array.flatten [ head, Array.flatten histLines, Array.flatten screenLines, replyLines ]) ++ "\n"
