module Main exposing (main)

{-| What visiterm's output queue costs, by its shape (docs/phase3-select.md
§19): `Main.send`'s queue, a paste in it, and EVENTS reports of 12 bytes
after it, a write tried after each one, as the loop tries one every turn.
The pty takes nothing for the first STALL writes, as a program that is not
reading, and TAKE bytes at each one after.

usage: queue MODE PASTE EVENTS STALL TAKE [check]
  MODE flatten    one Bytes, Bytes.flatten [ out, bytes ] at each send (today's)
       pieces     an Array Bytes; a write takes from the first piece, and what
                  it leaves goes back on the front
       coalesce   the same, and before a write a first piece under 4 KB is
                  joined with the pieces after it, up to 64 KB, and kept so
       offset     coalesce with an offset into the first piece in place of
                  putting its rest back on the front: a piece is popped
                  only when it is all written
       twolist    coalesce's joining on Okasaki's two-list queue: cons lists,
                  `front` taken from and `back` added to, reversed into
                  `front` when it runs out

It prints the milliseconds the loop took, the bytes written and left, and
with `check` a sum over every byte written in order, which every mode must
agree on.
-}

import Bytes exposing (Bytes)
import Console
import Int64
import Os.Env
import Task exposing (Task)
import Time
import UInt8


type alias Queue =
    { flat : Bytes, pieces : Array Bytes, at : Int, front : Stack, back : Stack }


{-| A cons list of pieces. -}
type Stack
    = Nil
    | Cons { head : Bytes, tail : Stack }


reverseOnto : Stack -> Stack -> Stack
reverseOnto from onto =
    when from is
        Nil ->
            onto

        Cons c ->
            reverseOnto c.tail (Cons { head = c.head, tail = onto })


{-| The leading pieces of the stack, up to 64 KB (the first always), and what
is left. -}
takeLeading : Stack -> Int -> Array Bytes -> { taken : Array Bytes, rest : Stack }
takeLeading st size acc =
    when st is
        Cons c ->
            if size > 0 && size + Bytes.length c.head > 65536 then
                { taken = acc, rest = st }

            else
                takeLeading c.tail (size + Bytes.length c.head) (Array.pushLast c.head acc)

        Nil ->
            { taken = acc, rest = st }


{-| The bytes a report is, numbered so a lost or reordered one shows. -}
report : Int -> Bytes
report i =
    Bytes.fromString ("\u{001B}[<0;" ++ String.padLeft 6 '0' (String.fromInt (modBy 1000000 i)) ++ "M")


send : String -> Bytes -> Queue -> Queue
send mode bytes q =
    if mode == "twolist" then
        { q | back = Cons { head = bytes, tail = q.back } }

    else if mode == "flatten" then
        if Bytes.isEmpty q.flat then
            { q | flat = bytes }

        else
            { q | flat = Bytes.flatten [ q.flat, bytes ] }

    else
        { q | pieces = Array.pushLast bytes q.pieces }


{-| For `coalesce`, the leading pieces joined into one, up to 64 KB, when
the first is under 4 KB, and kept joined: a byte is joined once, not again
at every write the pty takes less of. -}
joined : String -> Queue -> Queue
joined mode q =
    if mode == "twolist" then
        let
            -- back moved over, each piece once, when front is empty or is
            -- one small piece that wants what comes after it
            q1 =
                when q.front is
                    Nil ->
                        { q | front = reverseOnto q.back Nil, back = Nil }

                    Cons c ->
                        when c.tail is
                            Nil ->
                                if Bytes.length c.head < 4096 then
                                    { q | front = Cons { head = c.head, tail = reverseOnto q.back Nil }, back = Nil }

                                else
                                    q

                            _ ->
                                q
        in
        when q1.front is
            Cons c ->
                if Bytes.length c.head >= 4096 then
                    q1

                else
                    let
                        t =
                            takeLeading q1.front 0 []
                    in
                    { q1 | front = Cons { head = Bytes.flatten t.taken, tail = t.rest } }

            Nil ->
                q1

    else if mode == "offset" then
        when Array.first q.pieces is
            Just p ->
                if Bytes.length p - q.at >= 4096 || Array.length q.pieces < 2 then
                    q

                else
                    let
                        front =
                            leading (Array.set 0 (Bytes.slice q.at (Bytes.length p) p) q.pieces) 0 0 []
                    in
                    { q | pieces = Array.pushFirst (Bytes.flatten front) (Array.dropFirst (Array.length front) q.pieces), at = 0 }

            Nothing ->
                q

    else if mode /= "coalesce" then
        q

    else
        when Array.first q.pieces is
            Just p ->
                if Bytes.length p >= 4096 || Array.length q.pieces < 2 then
                    q

                else
                    let
                        front =
                            leading q.pieces 0 0 []
                    in
                    { q | pieces = Array.pushFirst (Bytes.flatten front) (Array.dropFirst (Array.length front) q.pieces) }

            Nothing ->
                q


{-| What a write offers the pty, and the queue once `n` of it are taken. -}
offer : String -> Queue -> Bytes
offer mode q =
    if mode == "flatten" then
        q.flat

    else if mode == "twolist" then
        when q.front is
            Cons c ->
                c.head

            Nil ->
                Bytes.empty

    else if mode == "offset" then
        when Array.first q.pieces is
            Just p ->
                Bytes.slice q.at (Bytes.length p) p

            Nothing ->
                Bytes.empty

    else
        Maybe.withDefault Bytes.empty (Array.first q.pieces)


leading : Array Bytes -> Int -> Int -> Array Bytes -> Array Bytes
leading pieces i size acc =
    when Array.get i pieces is
        Just p ->
            if size > 0 && size + Bytes.length p > 65536 then
                acc

            else
                leading pieces (i + 1) (size + Bytes.length p) (Array.pushLast p acc)

        Nothing ->
            acc


taken : String -> Int -> Queue -> Queue
taken mode n q =
    if mode == "flatten" then
        { q | flat = Bytes.slice n (Bytes.length q.flat) q.flat }

    else if mode == "twolist" then
        { q | front = dropStack n q.front }

    else if mode == "offset" then
        when Array.first q.pieces is
            Just p ->
                if q.at + n >= Bytes.length p then
                    { q | pieces = Array.dropFirst 1 q.pieces, at = 0 }

                else
                    { q | at = q.at + n }

            Nothing ->
                q

    else
        { q | pieces = drop n q.pieces }


dropStack : Int -> Stack -> Stack
dropStack n st =
    if n <= 0 then
        st

    else
        when st is
            Cons c ->
                if Bytes.length c.head <= n then
                    dropStack (n - Bytes.length c.head) c.tail

                else
                    Cons { head = Bytes.slice n (Bytes.length c.head) c.head, tail = c.tail }

            Nil ->
                st


{-| `n` bytes off the front of the pieces. -}
drop : Int -> Array Bytes -> Array Bytes
drop n pieces =
    if n <= 0 then
        pieces

    else
        when Array.popFirst pieces is
            Just { first, rest } ->
                if Bytes.length first <= n then
                    drop (n - Bytes.length first) rest

                else
                    Array.pushFirst (Bytes.slice n (Bytes.length first) first) rest

            Nothing ->
                pieces


type alias State =
    { q : Queue, written : Int, sum : Int }


sumOf : Bytes -> Int -> Int
sumOf b s =
    sumFrom b 0 s


sumFrom : Bytes -> Int -> Int -> Int
sumFrom b i s =
    when Bytes.get i b is
        Just x ->
            sumFrom b (i + 1) (modBy 1000000007 (s * 31 + UInt8.toInt x))

        Nothing ->
            s


turn : String -> Bool -> Int -> Int -> Int -> Int -> State -> State
turn mode check events stall take i st =
    if i >= events then
        st

    else
        let
            q =
                joined mode (send mode (report i) st.q)

            offered =
                offer mode q

            n =
                if i < stall then
                    0

                else
                    min take (Bytes.length offered)

            out =
                Bytes.slice 0 n offered
        in
        turn mode
            check
            events
            stall
            take
            (i + 1)
            { q = taken mode n q
            , written = st.written + n
            , sum =
                if check then
                    sumOf out st.sum

                else
                    st.sum
            }


left : Queue -> Int
left q =
    Bytes.length q.flat + Array.foldl (\p n -> n + Bytes.length p) 0 q.pieces - q.at + stackBytes q.front 0 + stackBytes q.back 0


stackBytes : Stack -> Int -> Int
stackBytes st n =
    when st is
        Cons c ->
            stackBytes c.tail (n + Bytes.length c.head)

        Nil ->
            n


main : Task Never {}
main =
    Os.Env.getEnvironment
        |> Task.andThen
            (\e ->
                let
                    arg i =
                        Maybe.withDefault 0 (Array.get i e.args |> Maybe.andThen String.toInt)

                    mode =
                        Maybe.withDefault "flatten" (Array.get 0 e.args)

                    paste =
                        Bytes.fromString (String.repeat (arg 1) "x")

                    start =
                        if mode == "flatten" then
                            { flat = paste, pieces = [], at = 0, front = Nil, back = Nil }

                        else if mode == "twolist" then
                            { flat = Bytes.empty
                            , pieces = []
                            , at = 0
                            , front =
                                if Bytes.isEmpty paste then
                                    Nil

                                else
                                    Cons { head = paste, tail = Nil }
                            , back = Nil
                            }

                        else if Bytes.isEmpty paste then
                            { flat = Bytes.empty, pieces = [], at = 0, front = Nil, back = Nil }

                        else
                            { flat = Bytes.empty, pieces = [ paste ], at = 0, front = Nil, back = Nil }

                    check =
                        Array.get 5 e.args == Just "check"
                in
                Time.monotonic
                    |> Task.andThen
                        (\t0 ->
                            let
                                st =
                                    turn mode check (arg 2) (arg 3) (arg 4) 0 { q = start, written = 0, sum = 0 }
                            in
                            Time.monotonic
                                |> Task.andThen
                                    (\t1 ->
                                        Console.write
                                            (String.fromInt (Int64.toInt (Time.inMilliseconds t1) - Int64.toInt (Time.inMilliseconds t0))
                                                ++ " ms, written "
                                                ++ String.fromInt st.written
                                                ++ ", left "
                                                ++ String.fromInt (left st.q)
                                                ++ ", sum "
                                                ++ String.fromInt st.sum
                                                ++ "\n"
                                            )
                                    )
                        )
            )
