module Probe exposing (add, addTask, xcbScreens)

import Task exposing (Task)


@externPure(c, "probe_add")
add : Int -> Int -> Int


@extern(c, "probe_add_task")
addTask : Int -> Int -> Task x Int


{-| Connects to the X server `$DISPLAY` names through libxcb and answers how
many screens it has, or fails with xcb's connection error code. -}
@extern(c, "probe_xcb_screens")
xcbScreens : Int -> Task Int Int
