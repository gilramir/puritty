module Main exposing (main)

{-| A probe: synthetic terminal output through a byte scanner into a grid of
immutable rows (Array (Array Int)), to measure what pure Geng does today. -}

import Bitwise
import Bytes exposing (Bytes)
import Console
import Int64
import Task exposing (Task)
import Time
import UInt8


cols : Int
cols =
    160


lines : Int
lines =
    50


type alias Grid =
    { rows : Array (Array Int)
    , x : Int
    , y : Int
    , style : Int
    }


blankRow : Array Int
blankRow =
    Array.repeat cols 32


emptyGrid : Grid
emptyGrid =
    { rows = Array.repeat lines blankRow, x = 0, y = 0, style = 0 }


-- INPUT


{-| 1: ls-like lines with SGR runs (200,000 of them). 2: a cursor move and one
cell (2,000,000 of them), the worst case for a row-copy grid. -}
variant : Int
variant =
    1


sampleLine : Int -> String
sampleLine n =
    if variant == 1 then
        sampleLineText n

    else
        sampleLineMove n


sampleLineMove : Int -> String
sampleLineMove n =
    "\u{001B}[" ++ String.fromInt (modBy 50 (n * 7) + 1) ++ ";" ++ String.fromInt (modBy 160 (n * 13) + 1) ++ "Hx"


sampleLineText : Int -> String
sampleLineText n =
    "drwxr-xr-x  2 gram gram  4096 Oct 23 10:"
        ++ String.fromInt (modBy 60 n)
        ++ " \u{001B}[01;34mdirectory-"
        ++ String.fromInt n
        ++ "\u{001B}[0m and some more ordinary text to fill the line out\r\n"


input : Int -> Bytes
input count =
    Bytes.flatten (Array.initialize count 0 (\n -> Bytes.fromString (sampleLine n)))


-- SCANNING


byteAt : Bytes -> Int -> Int
byteAt bytes i =
    when Bytes.get i bytes is
        Just b ->
            UInt8.toInt b

        Nothing ->
            -1


{-| The index of the first byte at or after `i` below 0x20, or the length. -}
runEnd : Bytes -> Int -> Int -> Int
runEnd bytes n i =
    if i < n && byteAt bytes i >= 32 then
        runEnd bytes n (i + 1)

    else
        i


run : Bytes -> Int -> Int -> Grid -> Grid
run bytes n i grid =
    if i >= n then
        grid

    else
        let
            b =
                byteAt bytes i
        in
        if b == 27 then
            csi bytes n (i + 2) 0 grid

        else if b == 10 then
            run bytes n (i + 1) (lineFeed grid)

        else if b == 13 then
            run bytes n (i + 1) { grid | x = 0 }

        else if b < 32 then
            run bytes n (i + 1) grid

        else
            let
                end =
                    runEnd bytes n i
            in
            run bytes n end (print bytes i end grid)


csi : Bytes -> Int -> Int -> Int -> Grid -> Grid
csi bytes n i param grid =
    csi2 bytes n i 0 param grid


csi2 : Bytes -> Int -> Int -> Int -> Int -> Grid -> Grid
csi2 bytes n i first param grid =
    let
        b =
            byteAt bytes i
    in
    if b >= 48 && b <= 57 then
        csi2 bytes n (i + 1) first (param * 10 + b - 48) grid

    else if b == 59 then
        csi2 bytes n (i + 1) param 0 grid

    else if b == 72 then
        run bytes n (i + 1) { grid | y = clamp 0 (lines - 1) (first - 1), x = clamp 0 (cols - 1) (param - 1) }

    else if b == 109 then
        run bytes n (i + 1) { grid | style = param }

    else
        run bytes n (i + 1) grid


print : Bytes -> Int -> Int -> Grid -> Grid
print bytes start end grid =
    let
        count =
            min (end - start) (cols - grid.x)

        style =
            Bitwise.shiftLeftBy 21 grid.style

        cells =
            Array.initialize count start (\k -> Bitwise.or style (byteAt bytes k))

        row =
            Maybe.withDefault blankRow (Array.get grid.y grid.rows)
    in
    if count <= 0 then
        grid

    else
        { grid
            | rows = Array.set grid.y (Array.setMany grid.x cells row) grid.rows
            , x = grid.x + count
        }


lineFeed : Grid -> Grid
lineFeed grid =
    if grid.y + 1 >= lines then
        { grid | rows = Array.pushLast blankRow (Array.dropFirst 1 grid.rows) }

    else
        { grid | y = grid.y + 1 }


checksum : Grid -> Int
checksum grid =
    Array.foldl (\row sum -> Array.foldl (\c s -> Bitwise.xor (s * 31) c) sum row) 0 grid.rows


main : Task Never {}
main =
    let
        bytes =
            input
                (if variant == 1 then
                    200000

                 else
                    2000000
                )
    in
    Time.now
        |> Task.andThen
            (\t0 ->
                let
                    grid =
                        run bytes (Bytes.length bytes) 0 emptyGrid
                in
                Time.now
                    |> Task.andThen
                        (\t1 ->
                            let
                                ms =
                                    Time.posixToMillis t1 - Time.posixToMillis t0

                                mb =
                                    toFloat (Bytes.length bytes) / 1000000
                            in
                            Console.write
                                (String.fromFloat mb
                                    ++ " MB in "
                                    ++ String.fromInt (Int64.toInt ms)
                                    ++ " ms, checksum "
                                    ++ String.fromInt (checksum grid)
                                    ++ "\n"
                                )
                        )
            )
