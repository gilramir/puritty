module Hot exposing (main)

{-| Phase 1's survey probe, the second way: Main.geng's parser, styles and
scrollback, over a screen kept as `Array.Builder`s, written in place.

The screen is a ring of row builders in a builder, `base` the physical index
of row 0, and since geng-lang D978 the ring holds recent scrollback too, as
Alacritty's grid does: 563 rows on the main screen, the 50 of the screen, up
to 512 of scrollback before them and a free one after. A run is written
straight into its row's builder, a cell at a time, with no array made for it.
A full-screen scroll moves `base`, which makes the top row scrollback, and
clears the free row in place as the new bottom row; nothing is copied or
allocated. When the ring is full, the oldest 256 rows of its scrollback are
copied out trimmed (`Builder.slice`, one copy since D983) and joined into a
page (D901), and their row builders are free to be written again. A region
that touches the top scrolls the same way and moves back only the rows below
it; with scrollback in the ring, any other region moves its own rows, and on
the alternate screen, which keeps none, the ring turns as before. Each row's
extent, the column past which it is blank, is kept in the row's own last
cell, past its `cols`, so a row goes to a page trimmed without a scan and a
row moves with its extent (geng-lang `m4-visiterm.md` §VA27). The cells past
a row's extent are never read: they may hold what a row in that slot held
before, so a row is made blank by setting its extent to 0, and a write that
starts past the extent blanks the cells between first (`reach`). The page count `checksum` and the summary
print counts the full pages of rows the ring still holds, so that it is the
count of a probe that paged every row as it left the screen.

Since geng-lang D904, an erase is one `Builder.fill` of its row, rows a scroll
moves are one `Builder.copyWithin` of the screen for
each stretch of the ring the move covers, and an erase in display is a `fill` of
the screen for each stretch of the ring it covers. Since D991 a region that is
one stretch of the ring scrolls as one `Builder.rotate` of its rows, the row
that leaves coming in at the other end (geng-lang `m4-visiterm.md` §VA20).
The scrollback's pages are a builder, each page set in place (§VA27). A printable run is still
written a cell at a time: a `setMany` of an array made for it was no faster
(geng-lang `m4-visiterm.md` §VA11). `PACK=points` joins a page's text with
`Bytes.fromCodePoints` (D905).

A builder is used once, as geng-lang's ownership checker holds every program
to (D963), and every write is a store in place (D976). A renderer's snapshot
would be `Builder.slice` of each row, a copy, since `toArray` gives the row
up.

usage: probe-hot FILE      environment: PACK (seq, string, points or cells), SCROLLBACK

-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Bytes.Encode as Encode
import Console
import Dict exposing (Dict)
import Int64
import Os.Env
import Os.File
import Os.Path
import Task exposing (Task)
import Time
import UInt8
import Width


cols : Int
cols =
    160


lines : Int
lines =
    50


pageRows : Int
pageRows =
    256


blank : Int
blank =
    32


readSize : Int
readSize =
    65536


-- THE STATE


type PackMode
    = PackSeq
    | PackString
    | PackPoints
    | PackCells


type Page
    = Joined { text : Bytes, attrs : Bytes }
    | Flat { cells : Array Int, ends : Array Int }


type alias Back =
    { pages : Builder Page
    , head : Int
    , limit : Int
    , pack : PackMode
    }


{-| A ring of `size` row builders: the screen's `lines` rows from physical
slot `base` on, the `hist` rows of scrollback not yet joined into a page just
before it, oldest first, and free rows after it. -}
type alias Screen =
    { rows : Builder (Builder Int)
    , base : Int
    , hist : Int
    , size : Int
    }


{-| The main screen's ring: the screen, two pages of scrollback as rows, and
a free row. The alternate screen keeps no scrollback, and its ring is the
screen and one free row. -}
ringRows : Int
ringRows =
    lines + 2 * pageRows + 1


type alias Term =
    { screen : Screen
    , saved : Maybe Screen
    , x : Int
    , y : Int
    , wrapNext : Bool
    , top : Int
    , bottom : Int
    , pen : Int
    , fg : Int
    , bg : Int
    , flags : Int
    , styles : Dict Int64 Int
    , back : Back
    , ps : Int
    , params : Array Int
    , cur : Int
    , priv : Int
    , utf : Int
    , need : Int
    , replies : Array Bytes
    }


blankArray : Array Int
blankArray =
    Array.pushLast 0 (Array.repeat cols blank)


blankRow : {} -> Builder Int
blankRow _ =
    Builder.fromArray blankArray


{-| What a slot holds while its row is out (`Builder.swap`) or after its row
moved (`Builder.moveWithin`); always overwritten before it is read
(geng-lang `m4-unique.md` D913). Made at each use, since a builder is used
once and a top-level one would be shared by every use (`m4-own.md` §OW27). -}
holeRow : {} -> Builder Int
holeRow {} =
    Builder.empty 0


newScreen : Int -> Screen
newScreen size =
    { rows = Array.foldl (\_ b -> Builder.pushLast (blankRow {}) b) (Builder.empty size) (Array.repeat size 0)
    , base = 0
    , hist = 0
    , size = size
    }


newTerm : PackMode -> Int -> Term
newTerm pack scrollback =
    { screen = newScreen ringRows
    , saved = Nothing
    , x = 0
    , y = 0
    , wrapNext = False
    , top = 0
    , bottom = lines - 1
    , pen = 0
    , fg = 0
    , bg = 0
    , flags = 0
    , styles = Dict.empty
    , back = { pages = Builder.empty 0, head = 0, limit = scrollback // pageRows, pack = pack }
    , ps = 0
    , params = []
    , cur = 0
    , priv = 0
    , utf = 0
    , need = 0
    , replies = []
    }


-- THE SCREEN


{-| The physical slot of logical row `y`; a negative `y` is scrollback in the
ring, `-1` the newest. -}
phys : Screen -> Int -> Int
phys s y =
    let
        p =
            s.base + y
    in
    if p >= s.size then
        p - s.size

    else if p < 0 then
        p + s.size

    else
        p


rowAt : Int -> Screen -> Builder Int
rowAt y s =
    when Builder.get (phys s y) s.rows is
        Just r ->
            r

        Nothing ->
            blankRow {}


extentAt : Int -> Screen -> Int
extentAt y s =
    when Builder.get (phys s y) s.rows is
        Just r ->
            extentOf r

        Nothing ->
            0


{-| A row's extent, kept in its last cell, past its `cols` cells. -}
extentOf : Builder Int -> Int
extentOf row =
    Maybe.withDefault 0 (Builder.get cols row)


{-| A row with its extent set. -}
withExtentOf : Int -> (moved row : Builder Int) -> Builder Int
withExtentOf ext row =
    Builder.set cols ext row


{-| A row made blank: its extent 0. Its cells past its extent are not read,
and a write past it clears the cells between first (`reach`). -}
cleared : (moved row : Builder Int) -> Builder Int
cleared row =
    Builder.set cols 0 row


{-| A row about to be written from column `x`: when `x` is past its extent
`ext`, the cells between, which may hold what a row there before held, are
made blank. -}
reach : Int -> Int -> (moved row : Builder Int) -> Builder Int
reach ext x row =
    if x > ext then
        Builder.fill ext x blank row

    else
        row


{-| A row about to be written from column `x`, by `reach` of its extent. -}
reached : Int -> (moved row : Builder Int) -> Builder Int
reached x row =
    reach (extentOf row) x row


{-| A row written by `write` from column `from`, its extent at least `x`. -}
withExtent : Int -> Int -> (Builder Int -> Builder Int) -> (moved row : Builder Int) -> Builder Int
withExtent from x write row =
    let
        old =
            extentOf row
    in
    Builder.set cols (max x old) (write (reach old from row))


{-| Put a row and its extent at logical row `y`. -}
setRow : Int -> (moved row : Builder Int) -> Int -> (moved s : Screen) -> Screen
setRow y row ext s =
    let
        p =
            phys s y
    in
    { s | rows = Builder.set p (Builder.set cols ext row) s.rows }


{-| The extent at logical row `y`. -}
setExtent : Int -> Int -> (moved s : Screen) -> Screen
setExtent y ext s =
    { s | rows = Builder.update (phys s y) (withExtentOf ext) s.rows }


{-| Rows `top` to `bottom` move up one; a blank row comes in at the bottom.
With `keep`, the row that leaves joins the scrollback in the ring: the ring
turns, `hist` counts one more, and the free row after the screen, cleared in
place, is the new bottom row (geng-lang `m4-visiterm.md` §VA16, D978); the
caller has made room (`pageOut`). Without it, the ring turns only when it
holds no scrollback, since a turn would make the leaving row scrollback.
-}
screenUp : Bool -> Int -> Int -> (moved screen : Screen) -> Screen
screenUp keep top bottom screen =
    let
        whole =
            top == 0 && bottom == lines - 1
    in
    if keep then
        if whole then
            { screen | base = phys screen 1, hist = screen.hist + 1 } |> clearRowAt (lines - 1)

        else
            { screen | base = phys screen 1, hist = screen.hist + 1 } |> downFrom (lines - 1) bottom |> setRow bottom (blankRow {}) 0

    else if not whole && phys screen top <= phys screen bottom then
        -- the region in one stretch of the ring: its rows turned, the one
        -- that left coming in at the bottom, cleared (D991)
        turnRegion top bottom 1 screen |> clearRowAt bottom

    else if screen.hist > 0 then
        shiftUp top bottom screen |> setRow bottom (blankRow {}) 0

    else if whole then
        rotate screen |> clearRowAt (lines - 1)

    else if top == 0 && lines - 1 - bottom < bottom - top then
        -- turn the ring, then move the rows below the region back down; the
        -- free row the move would overwrite is the region's new bottom row
        let
            turned =
                rotate screen

            ext =
                extentAt (lines - 1) turned

            taken =
                Builder.swap (phys turned (lines - 1)) (holeRow {}) turned.rows

            row =
                when taken.old is
                    Just free ->
                        Builder.fill 0 ext blank free

                    Nothing ->
                        blankRow {}
        in
        { turned | rows = taken.builder } |> downFrom (lines - 1) bottom |> setRow bottom row 0

    else if bottom == lines - 1 && top < bottom - top then
        -- turn the ring, then move the rows above the region back up
        let
            ext0 =
                extentAt 0 screen

            taken =
                Builder.swap (phys screen 0) (holeRow {}) screen.rows

            row0 =
                Maybe.withDefault (blankRow {}) taken.old
        in
        let
            turned =
                rotate { screen | rows = taken.builder }

            -- the row leaving the region, which the move would overwrite, is
            -- its new bottom row
            ext =
                extentAt (top - 1) turned

            leaving =
                Builder.swap (phys turned (top - 1)) (holeRow {}) turned.rows

            row =
                when leaving.old is
                    Just old ->
                        Builder.fill 0 ext blank old

                    Nothing ->
                        blankRow {}
        in
        { turned | rows = leaving.builder } |> setRow (lines - 1) row 0 |> downTo (top - 1) |> setRow 0 row0 ext0

    else
        shiftUp top bottom screen |> setRow bottom (blankRow {}) 0


{-| Logical rows `top` to `bottom`, which are one stretch of the ring, turned
`by` places toward the top. -}
turnRegion : Int -> Int -> Int -> (moved s : Screen) -> Screen
turnRegion top bottom by s =
    let
        pt =
            phys s top

        pb =
            phys s bottom
    in
    { s | rows = Builder.rotate pt (pb + 1) by s.rows }


{-| Logical row `y` made blank in place, a `fill` of the row builder there,
which a row taken from the free part of the ring always is: a full row. -}
clearRowAt : Int -> (moved s : Screen) -> Screen
clearRowAt y s =
    { s | rows = Builder.update (phys s y) cleared s.rows }


rotate : (moved s : Screen) -> Screen
rotate s =
    { s | base = phys s 1 }


{-| Logical rows `bottom + 1` to `i` each take the row above them. -}
downFrom : Int -> Int -> (moved s : Screen) -> Screen
downFrom i bottom s =
    moveRows bottom (bottom + 1) (i - bottom) s


{-| Logical rows 1 to `i` each take the row above them. -}
downTo : Int -> (moved s : Screen) -> Screen
downTo i s =
    moveRows 0 1 i s


{-| Logical rows `i` to `bottom - 1` each take the row below them. -}
shiftUp : Int -> Int -> (moved s : Screen) -> Screen
shiftUp i bottom s =
    moveRows (i + 1) i (bottom - i) s


{-| Logical rows `top + 1` to `i` each take the row above them. -}
shiftDown : Int -> Int -> (moved s : Screen) -> Screen
shiftDown i top s =
    moveRows top (top + 1) (i - top) s


{-| `count` logical rows from `from` copied to start at `to`, each read
before it is overwritten. The runs are cut where either crosses the ring's
end, which makes at most three pieces, and each piece is one `moveWithin`: the last piece first when the rows move
down, the first when they move up. -}
moveRows : Int -> Int -> Int -> (moved s : Screen) -> Screen
moveRows from to count s =
    if count <= 0 then
        s

    else if to > from then
        let
            lastFrom =
                phys s (from + count - 1)

            lastTo =
                phys s (to + count - 1)

            run =
                min count (min (lastFrom + 1) (lastTo + 1))
        in
        moveRows from to (count - run) (copyRows (lastFrom + 1 - run) (lastTo + 1 - run) run s)

    else
        let
            pf =
                phys s from

            pt =
                phys s to

            run =
                min count (min (s.size - pf) (s.size - pt))
        in
        moveRows (from + run) (to + run) (count - run) (copyRows pf pt run s)


{-| `run` rows from physical row `pf` copied to start at physical row `pt`,
neither run crossing the ring's end. One row is two `set`s, which cost less
than a `copyWithin`'s bounds and its record of the run it replaced. -}
copyRows : Int -> Int -> Int -> (moved s : Screen) -> Screen
copyRows pf pt run s =
    if run == 1 then
        let
            taken =
                Builder.swap pf (holeRow {}) s.rows
        in
        when taken.old is
            Just row ->
                { s | rows = Builder.set pt row taken.builder }

            Nothing ->
                { s | rows = taken.builder }

    else
        { s | rows = Builder.moveWithin pt pf (pf + run) (holeRow {}) s.rows }


{-| Logical rows `from` up to `to` made blank, one `fill` of the rows for
each stretch of the ring they cover, which is one or two. -}
blankRows : Int -> Int -> (moved s : Screen) -> Screen
blankRows from to s =
    if from >= to then
        s

    else
        let
            pf =
                phys s from

            run =
                min (to - from) (s.size - pf)

            row =
                blankRow {}
        in
        blankRows (from + run)
            to
            { s | rows = Builder.fill pf (pf + run) row s.rows }


-- THE SCROLLBACK


{-| The oldest `pageRows` rows of the ring's scrollback, each copied out
trimmed to its extent (`Builder.slice`) and joined into a page (D901). Their
row builders stay where they are, the free part of the ring now, to be
cleared and written again in place. -}
pageOut : (moved s : Screen) -> (moved back : Back) -> { screen : Screen, back : Back }
pageOut s back =
    let
        page =
            when back.pack is
                PackCells ->
                    let
                        first =
                            phys s (0 - s.hist)

                        firstStop =
                            min s.size (first + pageRows)

                        rest =
                            pageRows - (firstStop - first)

                        older =
                            physRows first firstStop s (Builder.empty (pageRows * 8)) (Builder.empty pageRows)

                        both =
                            physRows 0 rest s older.cells older.ends
                    in
                    Flat { cells = Builder.toArray both.cells, ends = Builder.toArray both.ends }

                _ ->
                    join back.pack (Builder.toArray (trimmedRows (0 - s.hist) (pageRows - s.hist) s (Builder.empty pageRows)))
    in
    { screen = { s | hist = s.hist - pageRows }, back = pushPage page back }


{-| The rows in physical slots `p` to `stop`, each trimmed to its extent and
appended to `cells`, and their extents to `ends`, each row read once. -}
physRows : Int -> Int -> Screen -> (moved cells : Builder Int) -> (moved ends : Builder Int) -> { cells : Builder Int, ends : Builder Int }
physRows p stop s cells ends =
    if p >= stop then
        { cells = cells, ends = ends }

    else
        when Builder.get p s.rows is
            Just r ->
                let
                    ext =
                        extentOf r
                in
                physRows (p + 1) stop s (Builder.appendSlice 0 ext r cells) (Builder.pushLast ext ends)

            Nothing ->
                physRows (p + 1) stop s cells (Builder.pushLast 0 ends)


trimmedRows : Int -> Int -> Screen -> (moved acc : Builder (Array Int)) -> Builder (Array Int)
trimmedRows y stop s acc =
    if y >= stop then
        acc

    else
        trimmedRows (y + 1) stop s (Builder.pushLast (Builder.slice 0 (extentAt y s) (rowAt y s)) acc)


pushPage : Page -> (moved back : Back) -> Back
pushPage page back =
    if Builder.length back.pages < back.limit then
        { back | pages = Builder.pushLast page back.pages }

    else
        { back
            | pages = Builder.set back.head page back.pages
            , head = modBy back.limit (back.head + 1)
        }


{-| The scrollback's pages, counting each full page of rows the ring still
holds, as the probe that paged every row at once counted them. -}
pageCount : Term -> Int
pageCount t =
    let
        hist =
            when t.saved is
                Just s ->
                    s.hist

                Nothing ->
                    t.screen.hist
    in
    min t.back.limit (Builder.length t.back.pages + hist // pageRows)


join : PackMode -> Array (Array Int) -> Page
join pack rows =
    when pack is
        PackCells ->
            Flat { cells = Array.flatten rows, ends = Array.map Array.length rows }

        PackSeq ->
            Joined
                { text = Encode.encode (Encode.sequence (Array.mapAndFlatten (Array.map utf8) rows))
                , attrs = Encode.encode (Encode.sequence (Array.map attrRuns rows))
                }

        PackString ->
            Joined
                { text = Bytes.fromString (String.fromArray (Array.mapAndFlatten (Array.mapAndKeepJust textChar) rows))
                , attrs = Encode.encode (Encode.sequence (Array.map attrRuns rows))
                }

        PackPoints ->
            Joined
                { text = Result.withDefault Bytes.empty (Bytes.fromCodePoints (Array.map textPoint (Array.keepIf (\cell -> Bitwise.and 0x200000 cell == 0) (Array.flatten rows))))
                , attrs = Encode.encode (Encode.sequence (Array.map attrRuns rows))
                }


textChar : Int -> Maybe Char
textChar cell =
    if Bitwise.and 0x200000 cell /= 0 then
        Nothing

    else
        Char.fromCode (Bitwise.and 0x1FFFFF cell)


{-| A cell's code point. A value no scalar value is, which a malformed
sequence can decode to, is U+FFFD, so `fromCodePoints` never refuses. The
right half of a wide character is left out before this is asked. -}
textPoint : Int -> Int
textPoint cell =
    let
        cp =
            Bitwise.and 0x1FFFFF cell
    in
    if (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF then
        0xFFFD

    else
        cp


utf8 : Int -> Encode.Encoder
utf8 cell =
    let
        cp =
            Bitwise.and 0x1FFFFF cell

        u8 v =
            Encode.unsignedInt8 (UInt8.fromInt v)
    in
    if Bitwise.and 0x200000 cell /= 0 then
        Encode.sequence []

    else if cp < 0x80 then
        u8 cp

    else if cp < 0x800 then
        Encode.sequence [ u8 (Bitwise.or 0xC0 (Bitwise.shiftRightZfBy 6 cp)), u8 (Bitwise.or 0x80 (Bitwise.and 0x3F cp)) ]

    else if cp < 0x10000 then
        Encode.sequence
            [ u8 (Bitwise.or 0xE0 (Bitwise.shiftRightZfBy 12 cp))
            , u8 (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 6 cp)))
            , u8 (Bitwise.or 0x80 (Bitwise.and 0x3F cp))
            ]

    else
        Encode.sequence
            [ u8 (Bitwise.or 0xF0 (Bitwise.shiftRightZfBy 18 cp))
            , u8 (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 12 cp)))
            , u8 (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 6 cp)))
            , u8 (Bitwise.or 0x80 (Bitwise.and 0x3F cp))
            ]


{-| A row's attribute runs: each run of one style as its style id and its
length, two bytes each, after the row's length in cells. -}
attrRuns : Array Int -> Encode.Encoder
attrRuns cells =
    let
        step c acc =
            let
                style =
                    Bitwise.shiftRightZfBy 22 c
            in
            if acc.count > 0 && style == acc.style then
                { acc | count = acc.count + 1 }

            else if acc.count > 0 then
                { style = style, count = 1, out = Array.pushLast (run16 acc.style acc.count) acc.out }

            else
                { acc | style = style, count = 1 }

        done =
            Array.foldl step { style = 0, count = 0, out = [ Encode.unsignedInt8 (UInt8.fromInt (Array.length cells)) ] } cells
    in
    Encode.sequence (Array.pushLast (run16 done.style done.count) done.out)


run16 : Int -> Int -> Encode.Encoder
run16 style count =
    Encode.sequence [ Encode.unsignedInt8 (UInt8.fromInt style), Encode.unsignedInt8 (UInt8.fromInt count) ]


-- READING BYTES


byteAt : Bytes -> Int -> Int
byteAt bytes i =
    when Bytes.get i bytes is
        Just b ->
            UInt8.toInt b

        Nothing ->
            -1


{-| The index of the first byte at or after `i` that is not printable ASCII,
or `stop`. -}
asciiEnd : Bytes -> Int -> Int -> Int
asciiEnd bytes stop i =
    if i < stop then
        let
            b =
                byteAt bytes i
        in
        if b >= 0x20 && b < 0x7F then
            asciiEnd bytes stop (i + 1)

        else
            i

    else
        i


-- THE PARSER


feed : Bytes -> (moved t : Term) -> Term
feed bytes t =
    let
        n =
            Bytes.length bytes
    in
    when t.ps is
        1 ->
            escape bytes n 0 { t | ps = 0 }

        2 ->
            csi bytes n 0 { t | ps = 0, params = [] } (Builder.fromArray t.params) t.cur t.priv

        3 ->
            skipEsc bytes n 0 { t | ps = 0 }

        5 ->
            continueUtf8 bytes n 0 t.utf t.need { t | ps = 0 }

        _ ->
            ground bytes n 0 t


ground : Bytes -> Int -> Int -> (moved t : Term) -> Term
ground bytes n i t =
    if i >= n then
        t

    else
        let
            b =
                byteAt bytes i
        in
        if b >= 0x20 && b < 0x7F then
            printAscii bytes n i b t

        else if b >= 0x80 then
            printUnicode bytes n i t

        else if b == 0x1B then
            escape bytes n (i + 1) t

        else if b == 10 || b == 11 || b == 12 then
            ground bytes n (i + 1) (lineFeed { t | wrapNext = False })

        else if b == 13 then
            ground bytes n (i + 1) { t | x = 0, wrapNext = False }

        else if b == 9 then
            ground bytes n (i + 1) { t | x = min (cols - 1) ((t.x // 8 + 1) * 8) }

        else if b == 8 then
            ground bytes n (i + 1) { t | x = max 0 (t.x - 1), wrapNext = False }

        else
            ground bytes n (i + 1) t


{-| Wrap first if the last write left the cursor past the end. -}
wrapped : (moved t : Term) -> Term
wrapped t =
    if t.wrapNext then
        lineFeed { t | x = 0, wrapNext = False }

    else
        t


{-| The cursor's row, written by `write` from column `t.x`, and the cursor
moved to column `x`. -}
written : Int -> (Builder Int -> Builder Int) -> (moved t : Term) -> Term
written x write t =
    let
        s =
            t.screen

        p =
            phys s t.y
    in
    { t
        | screen = { s | rows = Builder.update p (withExtent t.x x write) s.rows }
        , x = min (cols - 1) x
        , wrapNext = x >= cols
    }


writeAscii : Bytes -> Int -> Int -> Int -> Int -> (moved row : Builder Int) -> Builder Int
writeAscii bytes i end style x row =
    if i < end then
        writeAscii bytes (i + 1) end style (x + 1) (Builder.set x (Bitwise.or style (byteAt bytes i)) row)

    else
        row


{-| A run of printable ASCII written to a row, `first` the byte at `i`, which
`ground` read, and its extent at least `xEnd`. -}
asciiRow : Bytes -> Int -> Int -> Int -> Int -> Int -> Int -> (moved row : Builder Int) -> Builder Int
asciiRow bytes i end style x xEnd first row =
    let
        old =
            extentOf row
    in
    Builder.set cols (max xEnd old) (writeAscii bytes (i + 1) end style (x + 1) (Builder.set x (Bitwise.or style first) (reach old x row)))


{-| A run of printable ASCII. `written`'s work is written out here, so that
the compiler sees `Builder.update` handed a partial application of
`writeAscii` and makes it one call, with no closure (geng-lang
`m4-visiterm.md` §VA16, D982). Taking the row out with `Builder.swap` and
putting it back instead costs more than the closure did. `b` is the run's
first byte, read by `ground`; the scan starts after it (geng-lang
`m4-visiterm.md` §VA29). -}
printAscii : Bytes -> Int -> Int -> Int -> (moved t0 : Term) -> Term
printAscii bytes n i b t0 =
    let
        t =
            wrapped t0

        end =
            asciiEnd bytes (min n (i + cols - t.x)) (i + 1)

        style =
            Bitwise.shiftLeftBy 22 t.pen

        x =
            t.x + end - i

        s =
            t.screen

        p =
            phys s t.y
    in
    ground bytes
        n
        end
        { t
            | screen = { s | rows = Builder.update p (asciiRow bytes i end style t.x x b) s.rows }
            , x = min (cols - 1) x
            , wrapNext = x >= cols
        }


{-| A run of UTF-8, decoded into the row until a byte below 0x20, the row's
end or a sequence the read cut short. ASCII inside it stays in the run. -}
printUnicode : Bytes -> Int -> Int -> (moved t0 : Term) -> Term
printUnicode bytes n i t0 =
    let
        t =
            wrapped t0

        s =
            t.screen

        p =
            phys s t.y

        taken =
            Builder.swap p (holeRow {}) s.rows

        r =
            decodeRun bytes n i (Bitwise.shiftLeftBy 22 t.pen) t.x (reached t.x (Maybe.withDefault (blankRow {}) taken.old))

        rows =
            if r.x == t.x then
                Builder.set p r.row taken.builder

            else
                Builder.set p (Builder.set cols (max r.x (extentOf r.row)) r.row) taken.builder

        t1 =
            if r.x == t.x then
                { t | screen = { s | rows = rows } }

            else
                { t
                    | screen = { s | rows = rows }
                    , x = min (cols - 1) r.x
                    , wrapNext = r.x >= cols
                }
    in
    if r.cut > 0 then
        { t1 | ps = 5, utf = r.cp, need = r.cut }

    else if r.wide then
        -- a wide character that does not fit: wrap, and go on
        ground bytes n r.next { t1 | wrapNext = True }

    else
        ground bytes n r.next t1


type alias Run =
    { row : Builder Int, x : Int, next : Int, cut : Int, cp : Int, wide : Bool }


decodeRun : Bytes -> Int -> Int -> Int -> Int -> (moved row : Builder Int) -> Run
decodeRun bytes n i style x row =
    if i >= n || x >= cols then
        { row = row, x = x, next = i, cut = 0, cp = 0, wide = False }

    else
        let
            b =
                byteAt bytes i
        in
        if b < 0x20 || b == 0x7F then
            { row = row, x = x, next = i, cut = 0, cp = 0, wide = False }

        else if b < 0x80 then
            decodeRun bytes n (i + 1) style (x + 1) (Builder.set x (Bitwise.or style b) row)

        else
            let
                len =
                    if b >= 0xF0 then
                        4

                    else if b >= 0xE0 then
                        3

                    else if b >= 0xC0 then
                        2

                    else
                        1

                lead =
                    if len == 4 then
                        Bitwise.and b 0x07

                    else if len == 3 then
                        Bitwise.and b 0x0F

                    else if len == 2 then
                        Bitwise.and b 0x1F

                    else
                        0xFFFD
            in
            if i + len > n then
                { row = row, x = x, next = n, cut = len - 1 - (n - i - 1), cp = cont bytes (i + 1) n lead, wide = False }

            else
                let
                    cp =
                        cont bytes (i + 1) (i + len) lead

                    w =
                        Width.width cp
                in
                if w == 0 then
                    decodeRun bytes n (i + len) style x row

                else if w == 2 then
                    if x + 2 > cols then
                        { row = row, x = x, next = i, cut = 0, cp = 0, wide = True }

                    else
                        decodeRun bytes n (i + len) style (x + 2) (Builder.set (x + 1) (Bitwise.or (Bitwise.or style 0x200000) cp) (Builder.set x (Bitwise.or style cp) row))

                else
                    decodeRun bytes n (i + len) style (x + 1) (Builder.set x (Bitwise.or style cp) row)


cont : Bytes -> Int -> Int -> Int -> Int
cont bytes i stop acc =
    if i < stop then
        cont bytes (i + 1) stop (Bitwise.or (Bitwise.shiftLeftBy 6 acc) (Bitwise.and 0x3F (byteAt bytes i)))

    else
        acc


continueUtf8 : Bytes -> Int -> Int -> Int -> Int -> (moved t : Term) -> Term
continueUtf8 bytes n i acc need t =
    if need <= 0 then
        let
            style =
                Bitwise.shiftLeftBy 22 t.pen

            w =
                Width.width acc

            t1 =
                wrapped t
        in
        if w == 0 then
            ground bytes n i t1

        else if w == 2 && t1.x + 2 <= cols then
            ground bytes n i (written (t1.x + 2) (\row -> Builder.set (t1.x + 1) (Bitwise.or (Bitwise.or style 0x200000) acc) (Builder.set t1.x (Bitwise.or style acc) row)) t1)

        else
            ground bytes n i (written (t1.x + 1) (Builder.set t1.x (Bitwise.or style acc)) t1)

    else if i >= n then
        { t | ps = 5, utf = acc, need = need }

    else
        continueUtf8 bytes n (i + 1) (Bitwise.or (Bitwise.shiftLeftBy 6 acc) (Bitwise.and 0x3F (byteAt bytes i))) (need - 1) t


escape : Bytes -> Int -> Int -> (moved t : Term) -> Term
escape bytes n i t =
    if i >= n then
        { t | ps = 1 }

    else
        let
            b =
                byteAt bytes i
        in
        if b == 0x5B then
            csi bytes n (i + 1) t (Builder.empty 16) 0 0

        else if b == 0x5D then
            skipEsc bytes n (i + 1) t

        else if b == 0x4D then
            ground bytes n (i + 1) (reverseIndex t)

        else if b == 0x44 then
            ground bytes n (i + 1) (lineFeed t)

        else if b == 0x45 then
            ground bytes n (i + 1) (lineFeed { t | x = 0 })

        else if b >= 0x20 && b < 0x30 then
            -- a charset designation: its final byte is skipped
            ground bytes n (i + 2) t

        else
            ground bytes n (i + 1) t


{-| An OSC or a string, skipped to BEL or ST. -}
skipEsc : Bytes -> Int -> Int -> (moved t : Term) -> Term
skipEsc bytes n i t =
    if i >= n then
        { t | ps = 3 }

    else
        let
            b =
                byteAt bytes i
        in
        if b == 7 then
            ground bytes n (i + 1) t

        else if b == 0x1B then
            ground bytes n (i + 2) t

        else
            skipEsc bytes n (i + 1) t


csi : Bytes -> Int -> Int -> (moved t : Term) -> (moved params : Builder Int) -> Int -> Int -> Term
csi bytes n i t params cur priv =
    if i >= n then
        { t | ps = 2, params = Builder.toArray params, cur = cur, priv = priv }

    else
        let
            b =
                byteAt bytes i
        in
        if b >= 0x30 && b <= 0x39 then
            csi bytes n (i + 1) t params (min 65535 (cur * 10 + b - 0x30)) priv

        else if b == 0x3B || b == 0x3A then
            csi bytes n (i + 1) t (if Builder.length params < 32 then Builder.pushLast cur params else params) 0 priv

        else if b >= 0x3C && b <= 0x3F then
            csi bytes n (i + 1) t params cur b

        else if b >= 0x20 && b < 0x30 then
            csi bytes n (i + 1) t params cur priv

        else if b >= 0x40 && b <= 0x7E then
            ground bytes n (i + 1) (dispatch b priv (Builder.toArray (Builder.pushLast cur params)) t)

        else
            ground bytes n (i + 1) t


param : Int -> Int -> Array Int -> Int
param k default params =
    when Array.get k params is
        Just 0 ->
            default

        Just v ->
            v

        Nothing ->
            default


isAlt : Term -> Bool
isAlt t =
    when t.saved is
        Just _ ->
            True

        Nothing ->
            False


dispatch : Int -> Int -> Array Int -> (moved t : Term) -> Term
dispatch final priv params t =
    if priv == 0x3F then
        if final == 0x68 && param 0 0 params == 1049 then
            if isAlt t then
                t

            else
                { t | saved = Just t.screen, screen = newScreen (lines + 1) }

        else if final == 0x6C && param 0 0 params == 1049 then
            when t.saved is
                Just s ->
                    { t | saved = Nothing, screen = s }

                Nothing ->
                    { t | saved = Nothing }

        else
            t

    else if final == 0x6D then
        sgr params 0 t

    else if final == 0x48 || final == 0x66 then
        { t | y = clamp 0 (lines - 1) (param 0 1 params - 1), x = clamp 0 (cols - 1) (param 1 1 params - 1), wrapNext = False }

    else if final == 0x41 then
        { t | y = max t.top (t.y - param 0 1 params), wrapNext = False }

    else if final == 0x42 then
        { t | y = min t.bottom (t.y + param 0 1 params), wrapNext = False }

    else if final == 0x43 then
        { t | x = min (cols - 1) (t.x + param 0 1 params), wrapNext = False }

    else if final == 0x44 then
        { t | x = max 0 (t.x - param 0 1 params), wrapNext = False }

    else if final == 0x47 then
        { t | x = clamp 0 (cols - 1) (param 0 1 params - 1), wrapNext = False }

    else if final == 0x64 then
        { t | y = clamp 0 (lines - 1) (param 0 1 params - 1), wrapNext = False }

    else if final == 0x4A then
        eraseDisplay (param 0 0 params) t

    else if final == 0x4B then
        eraseLine (param 0 0 params) t

    else if final == 0x72 then
        let
            top =
                param 0 1 params - 1

            bottom =
                param 1 lines params - 1
        in
        if top < bottom && bottom < lines then
            { t | top = top, bottom = bottom, x = 0, y = 0, wrapNext = False }

        else
            t

    else if final == 0x53 then
        regionUp (param 0 1 params) t.top t.bottom t

    else if final == 0x54 then
        regionDown (param 0 1 params) t.top t.bottom t

    else if final == 0x4C then
        if t.y >= t.top && t.y <= t.bottom then
            regionDown (param 0 1 params) t.y t.bottom t

        else
            t

    else if final == 0x4D then
        if t.y >= t.top && t.y <= t.bottom then
            regionUp (param 0 1 params) t.y t.bottom t

        else
            t

    else if final == 0x6E && param 0 0 params == 6 then
        { t | replies = Array.pushLast (Bytes.fromString ("\u{001B}[" ++ String.fromInt (t.y + 1) ++ ";" ++ String.fromInt (t.x + 1) ++ "R")) t.replies }

    else
        t


-- STYLES


sgr : Array Int -> Int -> (moved t : Term) -> Term
sgr params k t =
    if k >= Array.length params then
        intern t

    else
        let
            p =
                Maybe.withDefault 0 (Array.get k params)
        in
        if p == 0 then
            sgr params (k + 1) { t | fg = 0, bg = 0, flags = 0 }

        else if p < 10 then
            sgr params (k + 1) { t | flags = Bitwise.or t.flags (Bitwise.shiftLeftBy p 1) }

        else if p >= 22 && p <= 29 then
            sgr params (k + 1) { t | flags = Bitwise.and t.flags (Bitwise.complement (Bitwise.shiftLeftBy (p - 20) 1)) }

        else if p >= 30 && p <= 37 then
            sgr params (k + 1) { t | fg = p - 30 + 1 }

        else if p == 38 || p == 48 then
            let
                kind =
                    Maybe.withDefault 0 (Array.get (k + 1) params)

                v1 =
                    Maybe.withDefault 0 (Array.get (k + 2) params)

                colour =
                    if kind == 5 then
                        Bitwise.and 0xFF v1 + 1

                    else
                        Bitwise.or 0x1000000
                            (Bitwise.or (Bitwise.shiftLeftBy 16 (Bitwise.and 0xFF v1))
                                (Bitwise.or (Bitwise.shiftLeftBy 8 (Bitwise.and 0xFF (Maybe.withDefault 0 (Array.get (k + 3) params))))
                                    (Bitwise.and 0xFF (Maybe.withDefault 0 (Array.get (k + 4) params)))
                                )
                            )

                skip =
                    if kind == 5 then
                        3

                    else
                        5
            in
            if p == 38 then
                sgr params (k + skip) { t | fg = colour }

            else
                sgr params (k + skip) { t | bg = colour }

        else if p == 39 then
            sgr params (k + 1) { t | fg = 0 }

        else if p >= 40 && p <= 47 then
            sgr params (k + 1) { t | bg = p - 40 + 1 }

        else if p == 49 then
            sgr params (k + 1) { t | bg = 0 }

        else if p >= 90 && p <= 97 then
            sgr params (k + 1) { t | fg = p - 90 + 9 }

        else if p >= 100 && p <= 107 then
            sgr params (k + 1) { t | bg = p - 100 + 9 }

        else
            sgr params (k + 1) t


{-| The pen's style id, from the table, adding the style if it is new. -}
intern : (moved t : Term) -> Term
intern t =
    let
        key =
            Bitwise.or (Bitwise.shiftLeftBy 39 (Int64.fromInt t.flags))
                (Bitwise.or (Bitwise.shiftLeftBy 25 (Int64.fromInt t.fg)) (Int64.fromInt t.bg))
    in
    when Dict.get key t.styles is
        Just id ->
            { t | pen = id }

        Nothing ->
            let
                id =
                    modBy 1024 (Dict.count t.styles)
            in
            { t | pen = id, styles = Dict.set key id t.styles }


-- SCROLLING AND ERASING


lineFeed : (moved t : Term) -> Term
lineFeed t =
    if t.y == t.bottom then
        regionUp 1 t.top t.bottom t

    else if t.y < lines - 1 then
        { t | y = t.y + 1 }

    else
        t


reverseIndex : (moved t : Term) -> Term
reverseIndex t =
    if t.y == t.top then
        regionDown 1 t.top t.bottom t

    else if t.y > 0 then
        { t | y = t.y - 1 }

    else
        t


{-| On the main screen, with the region starting at the top, the rows that
leave go to the scrollback. -}
regionUp : Int -> Int -> Int -> (moved t : Term) -> Term
regionUp count top bottom t =
    if count <= 0 then
        t

    else
        let
            keep =
                top == 0 && t.back.limit > 0 && not (isAlt t)
        in
        if keep && t.screen.hist + lines >= t.screen.size then
            let
                room =
                    pageOut t.screen t.back
            in
            regionUp (count - 1)
                top
                bottom
                { t
                    | screen = screenUp keep top bottom room.screen
                    , back = room.back
                }

        else
            regionUp (count - 1) top bottom { t | screen = screenUp keep top bottom t.screen }


regionDown : Int -> Int -> Int -> (moved t : Term) -> Term
regionDown count top bottom t =
    if count <= 0 then
        t

    else
        if phys t.screen top <= phys t.screen bottom then
            regionDown (count - 1) top bottom { t | screen = turnRegion top bottom -1 t.screen |> clearRowAt top }

        else
            regionDown (count - 1) top bottom { t | screen = shiftDown bottom top t.screen |> setRow top (blankRow {}) 0 }


eraseDisplay : Int -> (moved t : Term) -> Term
eraseDisplay how t =
    if how == 2 || how == 3 then
        { t | screen = blankRows 0 lines t.screen }

    else
        let
            line =
                eraseLine how t
        in
        if how == 1 then
            { line | screen = blankRows 0 t.y line.screen }

        else
            { line | screen = blankRows (t.y + 1) lines line.screen }


eraseLine : Int -> (moved t : Term) -> Term
eraseLine how t =
    let
        from =
            if how == 0 then
                t.x

            else
                0

        to =
            if how == 1 then
                t.x + 1

            else
                cols

        ext =
            extentAt t.y t.screen
    in
    if to <= from then
        t

    else
        let
            s =
                t.screen

            p =
                phys s t.y

            left =
                if to >= ext then
                    min ext from

                else
                    ext
        in
        { t | screen = { s | rows = Builder.update p (erased from to left) s.rows } }


{-| A row with columns `from` to `to` blank, and its extent `ext`. -}
erased : Int -> Int -> Int -> (moved row : Builder Int) -> Builder Int
erased from to ext row =
    Builder.set cols ext (Builder.fill from to blank row)


-- RUNNING IT


checksum : Term -> Int
checksum t =
    Array.foldl
        (\y sum ->
            let
                row =
                    rowAt y t.screen
            in
            Array.foldl (\c s -> Bitwise.xor (s * 31) c) sum (Array.append (Array.repeat (cols - extentOf row) blank) (Builder.slice 0 (extentOf row) row))
        )
        (pageCount t)
        (Array.range 0 (lines - 1))


feedAll : Bytes -> Int -> (moved t : Term) -> Term
feedAll bytes at t =
    if at >= Bytes.length bytes then
        t

    else
        feedAll bytes (at + readSize) (feed (Bytes.slice at (at + readSize) bytes) t)


setting : String -> String -> Dict String String -> String
setting name default env =
    Maybe.withDefault default (Dict.get name env)


main : Task Never {}
main =
    Task.map3 (\e env perm -> { args = e.argsAsBytes, env = env, perm = perm }) Os.Env.getEnvironment Os.Env.getEnvironmentVariables Os.File.initialize
        |> Task.andThen
            (\s ->
                let
                    path =
                        Maybe.withDefault Bytes.empty (Array.get 0 s.args)

                    pack =
                        when setting "PACK" "cells" s.env is
                            "seq" ->
                                PackSeq

                            "string" ->
                                PackString

                            "points" ->
                                PackPoints

                            _ ->
                                PackCells

                    scrollback =
                        Maybe.withDefault 100000 (String.toInt (setting "SCROLLBACK" "100000" s.env))
                in
                Os.File.readFile s.perm (Os.Path.fromBytes path)
                    |> Task.andThen
                        (\bytes ->
                            Time.monotonic
                                |> Task.andThen
                                    (\t0 ->
                                        let
                                            t =
                                                feedAll bytes 0 (newTerm pack scrollback)
                                        in
                                        Time.monotonic
                                            |> Task.andThen
                                                (\t1 ->
                                                    Console.write
                                                        (String.fromInt (Bytes.length bytes)
                                                            ++ " bytes in "
                                                            ++ String.fromInt (Int64.toInt (Time.inMilliseconds t1) - Int64.toInt (Time.inMilliseconds t0))
                                                            ++ " ms; pages "
                                                            ++ String.fromInt (pageCount t)
                                                            ++ ", styles "
                                                            ++ String.fromInt (Dict.count t.styles)
                                                            ++ ", replies "
                                                            ++ String.fromInt (Array.length t.replies)
                                                            ++ ", checksum "
                                                            ++ String.fromInt (checksum t)
                                                            ++ "\n"
                                                        )
                                                )
                                    )
                        )
                    |> Task.onError (\_ -> Console.write "cannot read the file\n")
            )
