module Main exposing (main)

{-| The floor of a reflow on packed pages: each page's row headers walked,
a line's length carried across pages, new headers written for the width;
the text bytes, plain ASCII and unstyled, are left as they are. -}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Console
import Int64
import Os.Env
import Os.File
import Os.Path
import Task exposing (Task)
import Time
import UInt8
import Vt
import Vt.Cell exposing (byteAt)
import Vt.Pages exposing (pagesOf)
import Vt.Term exposing (Page)


feedAll : Bytes -> Int -> (moved t : Vt.Term) -> Vt.Term
feedAll bytes at t =
    if at >= Bytes.length bytes then
        t

    else
        feedAll bytes (at + 65536) (Vt.feed (Bytes.slice at (at + 65536) bytes) t)


u16At : Bytes -> Int -> Int
u16At bytes i =
    byteAt bytes i + 256 * byteAt bytes (i + 1)


pushU16 : Int -> (moved b : Builder UInt8) -> Builder UInt8
pushU16 v b =
    Builder.pushLast (UInt8.fromInt (Bitwise.shiftRightZfBy 8 v)) (Builder.pushLast (UInt8.fromInt (Bitwise.and 0xFF v)) b)


{-| One page's rows re-cut at `w`: `len`, the cells of the line carried in
from the page before. -}
recut : Int -> Bytes -> Int -> Int -> (moved out : Builder UInt8) -> { len : Int, out : Builder UInt8 }
recut w heads h len out =
    if h >= Bytes.length heads then
        { len = len, out = out }

    else
        let
            header =
                u16At heads h

            l =
                len + Bitwise.and 0x3FF header
        in
        if Bitwise.and 0x8000 header /= 0 then
            recut w heads (h + 2) l out

        else
            recut w heads (h + 2) 0 (emit w l (max 1 ((l + w - 1) // w)) out)


emit : Int -> Int -> Int -> (moved out : Builder UInt8) -> Builder UInt8
emit w left n out =
    if n <= 1 then
        pushU16 (Bitwise.or 0x4000 left) out

    else
        emit w (left - w) (n - 1) (pushU16 (Bitwise.or 0xC000 w) out)


pass : Int -> Array Page -> Int
pass w pages =
    let
        r =
            Array.foldl (\p acc -> let o = recut w p.heads 0 acc.len (Builder.empty (Bytes.length p.heads)) in { len = o.len, rows = acc.rows + Builder.length o.out // 2 }) { len = 0, rows = 0 } pages
    in
    r.rows


{-| The cells of a page's text counted, a lead byte at a time: what a re-cut
costs when it must find where each cell's bytes start. -}
cellsIn : Bytes -> Int -> Int -> Int
cellsIn text i n =
    if i >= Bytes.length text then
        n

    else
        let
            b =
                byteAt text i
        in
        if b < 0x80 then
            cellsIn text (i + 1) (n + 1)

        else if b < 0xE0 then
            cellsIn text (i + 2) (n + 1)

        else if b < 0xF0 then
            cellsIn text (i + 3) (n + 1)

        else
            cellsIn text (i + 4) (n + 1)


walks : Int -> Array Page -> Int -> Int -> Int
walks n pages i acc =
    if i >= n then
        acc

    else
        walks n pages (i + 1) (acc + Array.foldl (\p a -> a + cellsIn p.text 0 0) 0 pages)


passes : Int -> Array Page -> Int -> Int -> Int
passes n pages i acc =
    if i >= n then
        acc

    else
        passes n pages (i + 1) (acc + pass (if modBy 2 i == 0 then 80 else 160) pages)


plain : Array Page -> Bool
plain pages =
    Array.all (\p -> Array.all (\i -> byteAt p.text i < 0x80) (Array.range 0 (Bytes.length p.text - 1)) && Array.all (\h -> Bitwise.and 0x4000 (u16At p.heads (2 * h)) /= 0) (Array.range 0 (Bytes.length p.heads // 2 - 1))) pages


ms : Time.Duration -> Time.Duration -> String
ms a b =
    String.fromInt (Int64.toInt (Time.inMilliseconds b) - Int64.toInt (Time.inMilliseconds a))


main : Task Never {}
main =
    Task.map2 (\e perm -> { args = e.args, raw = e.argsAsBytes, perm = perm }) Os.Env.getEnvironment Os.File.initialize
        |> Task.andThen
            (\s ->
                Os.File.readFile s.perm (Os.Path.fromBytes (Maybe.withDefault Bytes.empty (Array.get 0 s.raw)))
                    |> Task.andThen
                        (\bytes ->
                            let
                                t =
                                    feedAll bytes 0 (Vt.new { cols = 160, rows = 50, scrollbackBytes = Vt.scrollbackBytesFor { cols = 160, rows = 25000 }, checksums = False, cellWidth = 0, cellHeight = 0 })

                                pages =
                                    pagesOf t.back

                                n =
                                    Maybe.withDefault 20 (Maybe.andThen String.toInt (Array.get 1 s.args))
                            in
                            Time.monotonic
                                |> Task.andThen
                                    (\t0 ->
                                        let
                                            rows =
                                                passes n pages 0 0
                                        in
                                        Time.monotonic
                                            |> Task.andThen
                                                (\t1 ->
                                                    let
                                                        cells =
                                                            walks n pages 0 0
                                                    in
                                                    Time.monotonic
                                                        |> Task.andThen (\t2 ->
                                                    Console.write
                                                        (String.fromInt (Array.length pages)
                                                            ++ " pages, plain "
                                                            ++ (if plain pages then "yes" else "no")
                                                            ++ "; "
                                                            ++ String.fromInt n
                                                            ++ " re-cuts in "
                                                            ++ ms t0 t1
                                                            ++ " ms, "
                                                            ++ String.fromInt rows
                                                            ++ " rows written; "
                                                            ++ String.fromInt n
                                                            ++ " byte walks in "
                                                            ++ ms t1 t2
                                                            ++ " ms, "
                                                            ++ String.fromInt cells
                                                            ++ " cells\n"
                                                        ))
                                                )
                                    )
                        )
                    |> Task.onError (\_ -> Console.write "proto: cannot read the file\n")
            )
