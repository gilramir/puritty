module Pty exposing (spawn, read, write)

{-| Phase 2's survey probe (`docs/phase2-window.md` §4): a program started on
a new pty, as `os` starts a child (`posix_spawn`, an empty signal mask) but in
a session of its own with the pty's slave as its descriptors 0, 1 and 2, and
the master read through the scheduler's `poll`. One read at a time. -}

import Bytes exposing (Bytes)
import Task exposing (Task)


{-| Starts the program `argv` names on a pty of `cols` by `rows`; answers the
master's descriptor, or a negative errno. -}
@extern(c, "probe_pty_spawn")
spawn : Int -> Int -> Array String -> Task x Int


{-| The next read of the master, at most 64 KB, waiting in `poll`; empty when
the slave is closed (the program has ended). -}
@extern(c, "probe_pty_read")
read : Int -> Task x Bytes


{-| Writes `bytes` to the master: the core's replies. A probe's write, which
loops until all is written. -}
@extern(c, "probe_pty_write")
write : Int -> Bytes -> Task x {}
