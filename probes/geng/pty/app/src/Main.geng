module Main exposing (main)

{-| The pty probe (`docs/phase2-window.md` §4): `cat FILE` on a 160 by 50 pty,
every read of the master fed to the core, and with `frame` a renderer's frame
(`Vt.View.frame`) whenever 16 ms have passed since the last. It prints the
time from the spawn to the end of the output, the reads, and the frames.

The pty is `os`'s (geng-lang D1042, `m3-os.md` §OS25), which replaced the
probe's own `Pty` package.

usage: pty FILE [frame]

-}

import Bytes exposing (Bytes)
import Console
import Int64
import Os.Env
import Os.Error exposing (Error)
import Os.File as File
import Os.Process as Process exposing (Connection(..))
import Task exposing (Task)
import Time
import Vt
import Vt.View as View


type alias Run =
    { term : Vt.Term
    , shadow : View.Shadow
    , frames : Bool
    , last : Int
    , reads : Int
    , bytes : Int
    }


now : Task x Int
now =
    Time.monotonic |> Task.map (\t -> Int64.toInt (Time.inMilliseconds t))


loop : File.Handle -> (taken r : Run) -> Task Error Run
loop fd r =
    File.read fd
        |> Task.andThen
            (\chunk ->
                if Bytes.length chunk == 0 then
                    Task.succeed r

                else
                    let
                        t =
                            Vt.feed chunk r.term
                    in
                    if r.frames then
                        now
                            |> Task.andThen
                                (\ms ->
                                    if ms - r.last >= 16 then
                                        let
                                            f =
                                                View.frame View.defaultLook View.focused t r.shadow
                                        in
                                        loop fd { term = t, shadow = f.shadow, frames = True, last = ms, reads = r.reads + 1, bytes = r.bytes + Bytes.length chunk }

                                    else
                                        loop fd { r | term = t, reads = r.reads + 1, bytes = r.bytes + Bytes.length chunk }
                                )

                    else
                        loop fd { r | term = t, reads = r.reads + 1, bytes = r.bytes + Bytes.length chunk }
            )


main : Task Never {}
main =
    Process.initialize
        |> Task.andThen (\cp -> Os.Env.getEnvironment |> Task.andThen (\e -> now |> Task.andThen (\t0 -> run cp e.args t0)))
        |> Task.onError (\err -> Console.write ("pty: " ++ Os.Error.toString err ++ "\n"))


run : Process.Permission -> Array String -> Int -> Task Error {}
run cp args t0 =
    Process.spawn cp "cat" [ Maybe.withDefault "" (Array.get 0 args) ] (Process.defaultSpawnOptions (Terminal { columns = 160, rows = 50, utf8 = True }))
        |> Task.andThen
            (\child ->
                when Process.terminal child is
                    Nothing ->
                        Console.write "pty: no terminal\n"

                    Just terminal ->
                        loop (Process.terminalHandle terminal)
                            { term = Vt.new { cols = 160, rows = 50, scrollbackBytes = Vt.scrollbackBytesFor { cols = 160, rows = 100000 }, pageRows = Vt.defaultPageRows, checksums = False, cellWidth = 0, cellHeight = 0 }
                            , shadow = View.shadow 160 50
                            , frames = Array.get 1 args == Just "frame"
                            , last = t0
                            , reads = 0
                            , bytes = 0
                            }
                            |> Task.andThen (\r -> now |> Task.andThen (\t1 -> report r (t1 - t0)))
            )


report : Run -> Int -> Task x {}
report r ms =
    Console.write
        (String.fromInt r.bytes
            ++ " bytes in "
            ++ String.fromInt ms
            ++ " ms; reads "
            ++ String.fromInt r.reads
            ++ " frames "
            ++ String.fromInt r.shadow.frames
            ++ " bound "
            ++ String.fromInt (Vt.historyBound r.term)
            ++ "\n"
        )
