module Answer exposing (later, refused, count)

{-| Whether a C thread can answer a row's `Task` the way geng-plan.md §3.1
says works today: the row starts a thread, the thread sleeps and writes an
eventfd, and the loop, woken, answers the wait the row was handed. -}

import Source exposing (Source)
import Task exposing (Task)


{-| Answers `value` after `ms` milliseconds, from a thread of its own. -}
@extern(c, "probe_later")
later : Int -> Int -> Task x Int


{-| How many answers a thread sent after its row was cancelled, which the
closed post refused. -}
@extern(c, "probe_refused")
refused : Int -> Task x Int


{-| A thread sends 1 to `n` to a post, each emitted into the source. -}
@extern(c, "probe_count")
count : Source Int -> Int -> Task x {}
