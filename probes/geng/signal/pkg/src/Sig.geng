module Sig exposing (pid, blockHere, waitFor)

{-| Whether a signal blocked on the program's thread alone can be read from a
`signalfd`, or whether the kernel hands it to `geng_main`'s thread, which
waits in `GC_pthread_join` with nothing blocked. -}

import Task exposing (Task)


@extern(c, "probe_pid")
pid : Int -> Task x Int


{-| Blocks the signal on the calling thread, the program's. -}
@extern(c, "probe_block_here")
blockHere : Int -> Task x {}


{-| Reads one signal of the given number from a signalfd, waiting in the
scheduler's poll; answers its number. -}
@extern(c, "probe_wait_for")
waitFor : Int -> Task x Int
