module Main exposing (main)

import Console
import Sig
import Task exposing (Task)


sigterm : Int
sigterm =
    15


main : Task Never {}
main =
    Sig.blockHere sigterm
        |> Task.andThen (\_ -> Sig.pid 0)
        |> Task.andThen (\p -> Console.write ("pid " ++ String.fromInt p ++ "\n"))
        |> Task.andThen (\_ -> Sig.waitFor sigterm)
        |> Task.andThen (\n -> Console.write ("read signal " ++ String.fromInt n ++ " from the signalfd\n"))
