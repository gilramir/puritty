module X exposing (open, draw, events, take, keys)

{-| Phase 2's survey probe (`docs/phase2-window.md` §5): the C side of the
renderer, which executes `Vt.View`'s display list on an X server with
XRender (S§6.2). One window, one font; events are counted, and an expose
redrawn. -}

import Bytes exposing (Bytes)
import Task exposing (Task)


{-| Opens a window of `cols` by `rows` cells of DejaVu Sans Mono at `points`
on `$DISPLAY`; answers 0, or a negative code. -}
@extern(c, "probe_x_open")
open : Int -> Int -> Int -> Task x Int


{-| Executes one frame's display list; answers the glyphs uploaded so far. -}
@extern(c, "probe_x_draw")
draw : Bytes -> Task x Int


{-| Waits for X events: answers 1 once there are some, or -1 once the
connection has failed. It takes none, so a race that cancels it after it
answered loses nothing; [`take`](#take) takes them (`docs/phase2-window.md`
§12). An expose is redrawn from the pixmap in C. -}
@extern(c, "probe_x_events")
events : Task x Int


{-| Takes the X events that came since the last take: answers how many. -}
@extern(c, "probe_x_take")
take : Task x Int


{-| The keys pressed since the last call, as records: a keysym in 4 bytes,
big-endian; a byte of modifiers (shift 1, ctrl 2, alt 4, super 8); a byte
of length and the key's UTF-8 text (`docs/phase2-window.md` §14). -}
@extern(c, "probe_x_keys")
keys : Task x Bytes
