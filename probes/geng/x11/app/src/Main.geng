module Main exposing (main)

{-| The x11 probe (`docs/phase2-window.md` §5, §12): a program on a 160 by
50 terminal, its output fed to the core, the core's replies written back,
and frames drawn in an X window. It prints the bytes read, the time, the
frames, the display lists' bytes, and how late the frames came; the X
connection's bytes are counted outside it, by a proxy.

Two loops, to be compared (§12):

  - `read`, §5's: a frame is drawn when a read comes and 16 ms have passed
    since the last, and once at the end, so output that stops inside a
    frame waits for the next read;
  - `race`, the plan's (`geng-plan.md` §3.1): each turn races the
    terminal's read, the X connection's events and, while something read
    is not drawn yet, a timer for the frame that is due.

`stress` is `race` with a 1 ms timer in every turn, so that a read and a
timer often finish together, and `double` races two reads of the
terminal, which both take bytes when they are there; `race1` races the
read alone and `race2` the read and the X events, to price each branch
(§12).

A frame's lateness is the time from the first read it shows to the frame.

Keys (§14) are read with the X events and written to the terminal in
legacy xterm encoding. A read that comes after a key, before a frame,
is drawn at once, not when 16 ms have passed: the 16 ms cap held the
echo of fast typing back by 6 ms.

The terminal is `os`'s (geng-lang D1042), which replaced the probe's own
`Pty` package. The window is `packages/x11`'s (`docs/renderer.md` §R9),
which replaced the probe's own C: a resize of the window resizes the core
and the terminal, the focus is drawn in the cursor, and a close ends the
probe. `PROBE_FONT` and `PROBE_LANG` choose the font and the fallback
language, and `PROBE_GLYPH_CAP` the glyph set's cap in bytes (V37).

usage: x11 read|race|race1|race2|stress|double PROGRAM ARGS...

-}

import Bitwise
import Bytes exposing (Bytes)
import Console
import Dict exposing (Dict)
import Int64
import Os.Env
import Os.Error exposing (Error)
import Os.File as File
import Os.Path as Path
import Os.Process as Process exposing (Connection(..))
import Process as Sleep
import Task exposing (Task)
import Time
import UInt8
import Vt
import Vt.View as View
import Window


type alias Run =
    { term : Vt.Term
    , shadow : View.Shadow
    , last : Int
    , pending : Int
    , reads : Int
    , bytes : Int
    , turns : Int
    , events : Int
    , lateMax : Int
    , lateSum : Int
    , late16 : Int
    , stress : Bool
    , double : Bool
    , branches : Int
    , keyed : Bool
    , focus : View.Focus
    , closed : Bool
    , ballast : Array Vt.Term
    }


type Turn
    = Read Bytes
    | Events Bool
    | Due


now : Task x Int
now =
    Time.monotonic |> Task.map (\t -> Int64.toInt (Time.inMilliseconds t))


writeAll : File.Handle -> Array Bytes -> Task Error {}
writeAll fd replies =
    Array.foldl (\r task -> task |> Task.andThen (\_ -> File.write r fd)) (Task.succeed {}) replies


{-| Draws a frame at `ms`, and counts how late it is if it shows a read. -}
drawFrame : Int -> (taken r : Run) -> Task x Run
drawFrame ms r =
    let
        f =
            View.frame View.defaultLook r.focus r.term r.shadow

        late =
            if r.pending < 0 then
                0

            else
                ms - r.pending
    in
    Window.draw f.list
        |> Task.map
            (\up ->
                { r
                    | shadow = View.inked (Maybe.withDefault Bytes.empty up) f.shadow
                    , last = ms
                    , pending = -1
                    , keyed = False
                    , closed = r.closed || up == Nothing
                    , lateMax = max r.lateMax late
                    , lateSum = r.lateSum + late
                    , late16 =
                        if late > 16 then
                            r.late16 + 1

                        else
                            r.late16
                }
            )


{-| A read fed to the core and its replies written back. -}
feed : File.Handle -> Bytes -> Int -> (taken r : Run) -> Task Error Run
feed fd chunk ms r =
    let
        taken =
            Vt.takeReplies (Vt.feed chunk r.term)
    in
    writeAll fd taken.replies
        |> Task.map
            (\_ ->
                { r
                    | term = taken.term
                    , reads = r.reads + 1
                    , bytes = r.bytes + Bytes.length chunk
                    , pending =
                        if r.pending < 0 then
                            ms

                        else
                            r.pending
                }
            )


readLoop : File.Handle -> (taken r : Run) -> Task Error Run
readLoop fd r =
    File.read fd
        |> Task.andThen
            (\chunk ->
                now
                    |> Task.andThen
                        (\ms ->
                            if Bytes.length chunk == 0 then
                                drawFrame ms r

                            else
                                feed fd chunk ms r
                                    |> Task.andThen
                                        (\next ->
                                            if ms - next.last >= 16 then
                                                drawFrame ms next |> Task.andThen (readLoop fd)

                                            else
                                                readLoop fd next
                                        )
                        )
            )


raceLoop : Process.Terminal -> File.Handle -> (taken r : Run) -> Task Error Run
raceLoop terminal fd r =
    now
        |> Task.andThen
            (\ms0 ->
                let
                    waits =
                        if r.stress then
                            [ Window.events |> Task.map Events
                            , Sleep.sleep 1 |> Task.map (\_ -> Due)
                            ]

                        else if r.pending < 0 then
                            [ Window.events |> Task.map Events ]

                        else
                            [ Window.events |> Task.map Events
                            , Sleep.sleep (toFloat (max 0 (r.last + 16 - ms0))) |> Task.map (\_ -> Due)
                            ]
                in
                Task.race (File.read fd |> Task.map Read)
                    (if r.double then
                        [ File.read fd |> Task.map Read ]

                     else
                        Array.takeFirst (r.branches - 1) waits
                    )
                    |> Task.andThen
                        (\turn ->
                            now
                                |> Task.andThen
                                    (\ms ->
                                        let
                                            counted =
                                                { r | turns = r.turns + 1 }
                                        in
                                        when turn is
                                            Read chunk ->
                                                if Bytes.length chunk == 0 then
                                                    drawFrame ms counted

                                                else
                                                    feed fd chunk ms counted
                                                        |> Task.andThen
                                                            (\next ->
                                                                if ms - next.last >= 16 || next.keyed then
                                                                    drawFrame ms next |> Task.andThen (again terminal fd)

                                                                else
                                                                    raceLoop terminal fd next
                                                            )

                                            Events up ->
                                                if not up then
                                                    Task.succeed counted

                                                else
                                                    Window.take
                                                        |> Task.andThen (\evs -> handle terminal fd evs { counted | events = counted.events + Array.length evs })
                                                        |> Task.andThen (again terminal fd)

                                            Due ->
                                                drawFrame ms counted |> Task.andThen (again terminal fd)
                                    )
                        )
            )


{-| The loop again, unless the window has closed. -}
again : Process.Terminal -> File.Handle -> (taken r : Run) -> Task Error Run
again terminal fd r =
    if r.closed then
        Task.succeed r

    else
        raceLoop terminal fd r


{-| The window's events: keys sent to the program, a new size given to the
core and the terminal, the focus kept for the cursor, a close ending the
loop. A frame follows a key or a resize at once. -}
handle : Process.Terminal -> File.Handle -> Array Window.Event -> (taken r : Run) -> Task Error Run
handle terminal fd evs r =
    when Array.first evs is
        Nothing ->
            Task.succeed r

        Just ev ->
            let
                rest =
                    Array.dropFirst 1 evs
            in
            when ev is
                Window.Key k ->
                    File.write (encodeKey k.sym k.mods k.text) fd
                        |> Task.andThen (\_ -> handle terminal fd rest { r | keyed = True })

                Window.Resized size ->
                    Process.resize terminal { columns = size.cols, rows = size.rows }
                        |> Task.andThen (\_ -> handle terminal fd rest { r | term = Vt.resize size.cols size.rows r.term, keyed = True })

                Window.Focus on ->
                    handle terminal fd rest { r | focus = { focused = on, blinkOn = True }, keyed = True }

                Window.Close ->
                    Task.succeed { r | closed = True }


{-| What the keys send to the program (§14): legacy xterm encoding, the
smallest set that a shell and an editor need. The key's text, which
xkbcommon has already turned to a control character under ctrl; ESC
before it under alt; and a sequence for each named key. Cursor keys in
application mode (DECCKM), the function keys, modifiers on named keys and
the kitty protocol are phase 3's. -}
encodeKey : Int -> Int -> Bytes -> Bytes
encodeKey sym mods text =
    let
        named =
            when sym is
                0xFF0D ->
                    Just "\r"

                0xFF08 ->
                    Just "\u{007F}"

                0xFF09 ->
                    Just "\t"

                0xFF1B ->
                    Just "\u{001B}"

                0xFF52 ->
                    Just "\u{001B}[A"

                0xFF54 ->
                    Just "\u{001B}[B"

                0xFF53 ->
                    Just "\u{001B}[C"

                0xFF51 ->
                    Just "\u{001B}[D"

                0xFF50 ->
                    Just "\u{001B}[H"

                0xFF57 ->
                    Just "\u{001B}[F"

                0xFFFF ->
                    Just "\u{001B}[3~"

                0xFF55 ->
                    Just "\u{001B}[5~"

                0xFF56 ->
                    Just "\u{001B}[6~"

                _ ->
                    Nothing

        body =
            when named is
                Just s ->
                    Bytes.fromString s

                Nothing ->
                    text
    in
    if Bitwise.and mods 4 /= 0 && Bytes.length body > 0 && named == Nothing then
        Bytes.flatten [ Bytes.fromString "\u{001B}", body ]

    else
        body


main : Task Never {}
main =
    Process.initialize
        |> Task.andThen
            (\cp ->
                Os.Env.getEnvironment
                    |> Task.andThen
                        (\e ->
                            Os.Env.getEnvironmentVariables
                                |> Task.andThen (\vars -> ballastFrom vars |> Task.andThen (\b -> start cp b e.args))
                        )
            )
        |> Task.onError (\err -> Console.write ("x11: " ++ Os.Error.toString err ++ "\n"))


{-| Panes that sit idle beside the one drawn, for the GC survey (§15):
`PROBE_PANES` of them, each fed `PROBE_FILL`'s bytes in 64 KB reads, so
that its scrollback is as full as the file makes it, and kept alive and
untouched while the program runs, as G7's survey kept them (geng-lang
`m4-puritty.md` §VA7). -}
ballastFrom : Dict String String -> Task Error (Array Vt.Term)
ballastFrom vars =
    when { n = Dict.get "PROBE_PANES" vars |> Maybe.andThen String.toInt, fill = Dict.get "PROBE_FILL" vars } is
        { n = Just n, fill = Just fill } ->
            File.initialize
                |> Task.andThen (\fs -> File.readFile fs (Path.fromString fill))
                |> Task.map (\bytes -> Array.initialize n 0 (\_ -> feedAll bytes 0 (Vt.new (config 160 50))))

        _ ->
            Task.succeed []


config : Int -> Int -> Vt.Config
config cols rows =
    { cols = cols, rows = rows, scrollbackBytes = Vt.scrollbackBytesFor { cols = cols, rows = 100000 }, pageRows = Vt.defaultPageRows, checksums = False, cellWidth = 0, cellHeight = 0 }


feedAll : Bytes -> Int -> (taken t : Vt.Term) -> Vt.Term
feedAll bytes at t =
    if at >= Bytes.length bytes then
        t

    else
        feedAll bytes (at + 65536) (Vt.feed (Bytes.slice at (at + 65536) bytes) t)


start : Process.Permission -> (taken ballast : Array Vt.Term) -> Array String -> Task Error {}
start cp ballast args =
    when { mode = Array.get 0 args, program = Array.get 1 args } is
        { mode = Just mode, program = Just program } ->
            if mode /= "read" && mode /= "race" && mode /= "stress" && mode /= "double" && mode /= "race1" && mode /= "race2" then
                Console.write "usage: x11 read|race|race1|race2|stress|double PROGRAM ARGS...\n"

            else
                Os.Env.getEnvironmentVariables
                    |> Task.andThen
                        (\vars ->
                            Window.open
                                { cols = 160
                                , rows = 50
                                , font = Maybe.withDefault "DejaVu Sans Mono" (Dict.get "PROBE_FONT" vars)
                                , points = 11
                                , lang = Maybe.withDefault "" (Dict.get "PROBE_LANG" vars)
                                , glyphCap = Maybe.withDefault (8 * 1024 * 1024) (Dict.get "PROBE_GLYPH_CAP" vars |> Maybe.andThen String.toInt)
                                , title = "puritty-probe"
                                }
                        )
                    |> Task.andThen
                        (\opened ->
                            when opened is
                                Err why ->
                                    Console.write ("x11: cannot open the window: " ++ why ++ "\n")

                                Ok _ ->
                                    now |> Task.andThen (\t0 -> run cp ballast mode program (Array.dropFirst 2 args) t0)
                        )

        _ ->
            Console.write "usage: x11 read|race|race1|race2|stress|double PROGRAM ARGS...\n"


run : Process.Permission -> (taken ballast : Array Vt.Term) -> String -> String -> Array String -> Int -> Task Error {}
run cp ballast mode program args t0 =
    let
        race =
            mode /= "read"

        stress =
            mode == "stress"
    in
    Process.spawn cp program args (Process.defaultSpawnOptions (Terminal { columns = 160, rows = 50, utf8 = True }))
        |> Task.andThen
            (\child ->
                when Process.terminal child is
                    Nothing ->
                        Console.write "x11: no terminal\n"

                    Just terminal ->
                        let
                            fd =
                                Process.terminalHandle terminal

                            r0 =
                                { term = Vt.new (config 160 50)
                                , shadow = View.shadow 160 50
                                , last = t0
                                , pending = -1
                                , reads = 0
                                , bytes = 0
                                , turns = 0
                                , events = 0
                                , lateMax = 0
                                , lateSum = 0
                                , late16 = 0
                                , stress = stress
                                , double = mode == "double"
                                , keyed = False
                                , focus = View.focused
                                , closed = False
                                , ballast = ballast
                                , branches =
                                    if mode == "race1" then
                                        1

                                    else if mode == "race2" then
                                        2

                                    else
                                        3
                                }
                        in
                        (if race then
                            raceLoop terminal fd r0

                         else
                            readLoop fd r0
                        )
                            |> Task.andThen (\r -> now |> Task.andThen (\t1 -> report r (t1 - t0) t0))
            )


report : Run -> Int -> Int -> Task x {}
report r ms t0 =
    Console.write
        (String.fromInt r.bytes
            ++ " bytes in "
            ++ String.fromInt ms
            ++ " ms; reads "
            ++ String.fromInt r.reads
            ++ " turns "
            ++ String.fromInt r.turns
            ++ " events "
            ++ String.fromInt r.events
            ++ " frames "
            ++ String.fromInt r.shadow.frames
            ++ " late max "
            ++ String.fromInt r.lateMax
            ++ " mean "
            ++ String.fromInt (r.lateSum // max 1 r.shadow.frames)
            ++ " over16 "
            ++ String.fromInt r.late16
            ++ " scrolls "
            ++ String.fromInt r.shadow.scrolls
            ++ " cells "
            ++ String.fromInt r.shadow.drawn
            ++ " runs "
            ++ String.fromInt r.shadow.runs
            ++ " list-bytes "
            ++ String.fromInt r.shadow.bytes
            ++ " start "
            ++ String.fromInt t0
            ++ " panes "
            ++ String.fromInt (1 + Array.length r.ballast)
            ++ "\n"
        )
