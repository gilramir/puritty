    , { key = [ "start" ]
      , kind = Launch
      , optional = False
      , label = "What puritty opens"
      , description = "What `puritty` with nothing after it opens: \"shell\", a local shell; \"hosts\", the host list; \"host:NAME\", that host. The host list on Windows and a shell on Linux by default."
      , words = [ "start", "launch", "open", "ssh", "hosts", "shell" ]
      , page = Program
