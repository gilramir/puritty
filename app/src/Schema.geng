    , { key = [ "font", "language" ]
      , kind = AnyText
      , optional = True
      , label = "Fallback language"
      , description = "The language fallback fonts are chosen for, which decides the forms of Han (ja, ko, zh-cn, zh-tw); the system's when unset."
      , words = [ "cjk", "han", "kanji", "hanja", "chinese", "japanese", "korean", "locale" ]
      , page = TextAndLanguage
      , applies = AtOnce
      , get = \c -> Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Text c.language)
      , set =
            \v c ->
                when v is
                    Text t ->
                        { c | language = Just t }

                    Unset ->
                        { c | language = Nothing }

                    _ ->
                        c
      }
    , { key = [ "font", "ligatures" ]
      , kind = OnOff
      , optional = False
      , label = "Ligatures"
      , description = "Joins letters the font joins, as Fira Code draws != or .. as one sign. The cell under the cursor is always drawn on its own."
      , words = [ "calt", "liga", "fira", "programming", "join" ]
      , page = TextAndLanguage
      , applies = AtOnce
      , get = \c -> Flag c.ligatures
      , set =
            \v c ->
                when v is
                    Flag b ->
                        { c | ligatures = b }

                    _ ->
                        c
      }
    , { key = [ "font", "glyph_cache_mb" ]
      , kind = WholeIn { low = 4, high = 1024, unit = "MB" }
      , optional = False
      , label = "Glyph cache"
      , description = "The glyphs kept before they are made again."
      , words = [ "memory", "cache" ]
      , page = Advanced
      , applies = AtOnce
