      , description = "Each window writes what it does to a file of its own, to find a problem's cause: keys by name, pastes by size, what tmux said and was sent. What is typed, pasted or shown is not written. The files are in puritty's logs folder; the last twenty are kept."
      , words = [ "debug", "log", "diagnostic", "trace", "problem", "bug", "report" ]
      , page = Advanced
