    , { key = [ "cursor", "blink_ms" ]
      , kind = WholeIn { low = 0, high = 10000, unit = "ms" }
      , optional = False
      , label = "Cursor blink"
      , description = "Half of a blink, when a program asks the cursor to blink; 0 does not blink."
      , words = [ "blinking", "caret" ]
      , page = Appearance
