    , { key = [ "selection", "copy_to_clipboard" ]
      , kind = OnOff
      , optional = False
      , label = "Copy the selection to the clipboard"
      , description = "Text selected with the mouse is copied to the clipboard when the button is let go, as PuTTY does. On Windows the paste button and Shift+Insert then paste the clipboard, so text copied in another program is pasted too. On by default on Windows."
      , words = [ "copy", "select", "clipboard", "putty" ]
      , page = MouseAndSelection
      , applies = AtOnce
      , get = \c -> Flag c.copyToClipboard
      , set =
            \v c ->
