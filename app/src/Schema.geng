{-| Every setting puritty has, in one table (`docs/settings.md` ST5,
`settings-ui.md` §2): its key in `config.toml`, what kind of value it
takes, its label, description and search words, the page of the settings
window it is on, and whether a running window takes it. `Config.defaults`
holds the defaults; each setting reads and writes its part of a `Config`
through `Value`.

From the table come the decoder, which is lenient (`decode`), the settings
window's rows and its search (step 5), and the example below, which a test
holds to it.

@docs Setting, Kind, Value, Page, Applies, Report, settings, find, keyName, pages, pageName, decode, Decoded, write, hostFields, nameSetting, writeHost, deleteHost, renameHost, toText, fromText, hex, example

-}

import Chord
import Config exposing (Config)
import Dict exposing (Dict)
import Palettes
import Reason
import Toml
import Toml.Ast as Ast
import Toml.Decode
import Toml.Edit
import Toml.Table
import Words exposing (Message)


{-| One setting. `key` is its path in the file, `["font", "size"]`;
`optional` when it may be left unset, which is not its default but the
locale's or the platform's choice (`font.language`, `terminal.charset`). -}
type alias Setting =
    { key : Array String
    , kind : Kind
    , optional : Bool
    , label : String
    , description : String
    , words : Array String
    , page : Page
    , applies : Applies
    , get : Config -> Value
    , set : Value -> Config -> Config
    }


{-| What a setting takes. -}
type Kind
    = WholeIn { low : Int, high : Int, unit : String }
    | AnyText
    | OnOff
    | OneColor
    | ColorList { most : Int }
    | OneOf (Array String)
    | FontFamily
    | Command
    | Launch
    | HostName
    | Address
    | KeyChord


{-| A setting's value, of its kind: `Unset` only for an optional one. -}
type Value
    = Whole Int
    | Text String
    | Flag Bool
    | Color Int
    | Colors (Array Int)
    | Words (Array String)
    | Unset


{-| The settings window's pages (`settings-ui.md` §3). -}
type Page
    = Appearance
    | WindowPage
    | TextAndLanguage
    | MouseAndSelection
    | Clipboard
    | Program
    | SoundPage
    | Advanced
    | HostsPage
    | KeysPage


{-| Whether a running window takes a change, or only a window opened after
it (V59). -}
type Applies
    = AtOnce
    | NewWindows


{-| Something wrong in the file, at a line (1 for the file as a whole). -}
type alias Report =
    { line : Int
    , message : String
    }


pages : Array Page
pages =
    [ Appearance, WindowPage, TextAndLanguage, MouseAndSelection, Clipboard, KeysPage, Program, SoundPage, Advanced ]


pageName : Page -> String
pageName page =
    when page is
        Appearance ->
            "Appearance"

        WindowPage ->
            "Window"

        TextAndLanguage ->
            "Text & language"

        MouseAndSelection ->
            "Mouse & selection"

        Clipboard ->
            "Clipboard"

        Program ->
            "Program"

        SoundPage ->
            "Sound"

        Advanced ->
            "Advanced"

        HostsPage ->
            "Hosts"

        KeysPage ->
            "Keys"


{-| A key as the file and the reports write it, `font.size`. -}
keyName : Setting -> String
keyName s =
    String.join "." s.key


-- THE TABLE


settings : Array Setting
settings =
    [ { key = [ "window", "columns" ]
      , kind = WholeIn { low = 2, high = 1000, unit = "cells" }
      , optional = False
      , label = "Columns"
      , description = "The window's width in cells when it opens."
      , words = [ "width", "size", "cols" ]
      , page = WindowPage
      , applies = NewWindows
      , get = \c -> Whole c.columns
      , set =
            \v c ->
                when v is
                    Whole n ->
                        { c | columns = n }

                    _ ->
                        c
      }
    , { key = [ "window", "rows" ]
      , kind = WholeIn { low = 1, high = 1000, unit = "cells" }
      , optional = False
      , label = "Rows"
      , description = "The window's height in cells when it opens."
      , words = [ "height", "size", "lines" ]
      , page = WindowPage
      , applies = NewWindows
      , get = \c -> Whole c.rows
      , set =
            \v c ->
                when v is
                    Whole n ->
                        { c | rows = n }

                    _ ->
                        c
      }
    , { key = [ "window", "title" ]
      , kind = AnyText
      , optional = False
      , label = "Title"
      , description = "The window's title while the program has set none."
      , words = [ "name", "caption" ]
      , page = WindowPage
      , applies = AtOnce
      , get = \c -> Text c.title
      , set =
            \v c ->
                when v is
                    Text t ->
                        { c | title = t }

                    _ ->
                        c
      }
    , { key = [ "font", "family" ]
      , kind = FontFamily
      , optional = False
      , label = "Font"
      , description = "The font, as the system names its family. To add your own, copy its files into ~/.local/share/fonts (on Windows, right-click them and Install). More in the Fonts guide."
      , words = [ "typeface", "family", "font name" ]
      , page = Appearance
      , applies = AtOnce
      , get = \c -> Text c.font
      , set =
            \v c ->
                when v is
                    Text t ->
                        { c | font = t }

                    _ ->
                        c
      }
    , { key = [ "font", "size" ]
      , kind = WholeIn { low = 4, high = 200, unit = "pt" }
      , optional = False
      , label = "Font size"
      , description = "In points."
      , words = [ "text size", "zoom", "points" ]
      , page = Appearance
      , applies = AtOnce
      , get = \c -> Whole c.points
      , set =
