      , label = "Color scheme"
      , description = "Colors copied from another terminal: Ghostty, Alacritty, PuTTY, xterm, Windows Terminal's. A foreground, background or palette set here wins over it."
      , words = [ "theme", "colors", "palette", "ghostty", "alacritty", "putty", "xterm", "solarized", "tango" ]
