    , chordSetting "mark_log" "Mark the diagnostic log" "While the diagnostic log is on, writes a numbered mark in it with the state of the window, to find the lines around a problem; the menu has it too. While the log is off the key goes to the program." (\c -> c.keyMarkLog) (\t c -> { c | keyMarkLog = t })
    , chordSetting "new_tab" "New tab" "A new tab, after the last, where the shown one is; in a tab under tmux -CC, tmux's new window." (\c -> c.keyNewTab) (\t c -> { c | keyNewTab = t })
    , chordSetting "close_tab" "Close tab" "Closes the tab shown, asking first when something runs in it; with one tab, the window." (\c -> c.keyCloseTab) (\t c -> { c | keyCloseTab = t })
    , chordSetting "rename_tab" "Rename tab" "Asks for the shown tab's name." (\c -> c.keyRenameTab) (\t c -> { c | keyRenameTab = t })
    , chordSetting "color_tab" "Tab color" "Asks for the shown tab's color; none by default, as the menu and a right click on the tab ask too." (\c -> c.keyColorTab) (\t c -> { c | keyColorTab = t })
    , chordSetting "reopen_tab" "Reopen closed tab" "Opens again the tab closed last, in the last ten minutes: its screen and scrollback, name and color, with a new shell where it was or a new session to its host." (\c -> c.keyReopenTab) (\t c -> { c | keyReopenTab = t })
    , chordSetting "next_tab" "Next tab" "The tab after the shown one; in a tab under tmux -CC, tmux's next window. With one tab the key goes to the program." (\c -> c.keyNextTab) (\t c -> { c | keyNextTab = t })
    , chordSetting "previous_tab" "Previous tab" "The tab before the shown one; in a tab under tmux -CC, tmux's previous window. With one tab the key goes to the program." (\c -> c.keyPreviousTab) (\t c -> { c | keyPreviousTab = t })
    , chordSetting "next_tab_always" "Next tab, from any tab" "puritty's next tab, also from a tab under tmux -CC." (\c -> c.keyNextTabAlways) (\t c -> { c | keyNextTabAlways = t })
    , chordSetting "previous_tab_always" "Previous tab, from any tab" "puritty's previous tab, also from a tab under tmux -CC." (\c -> c.keyPreviousTabAlways) (\t c -> { c | keyPreviousTabAlways = t })
    , chordSetting "move_tab_right" "Move tab right" "Moves the shown tab one place right." (\c -> c.keyMoveTabRight) (\t c -> { c | keyMoveTabRight = t })
    , chordSetting "move_tab_left" "Move tab left" "Moves the shown tab one place left." (\c -> c.keyMoveTabLeft) (\t c -> { c | keyMoveTabLeft = t })
    , chordSetting "copy" "Copy" "The selection to the clipboard." (\c -> c.keyCopy) (\t c -> { c | keyCopy = t })
    , chordSetting "paste" "Paste" "The clipboard, pasted." (\c -> c.keyPaste) (\t c -> { c | keyPaste = t })
    , chordSetting "paste_selection" "Paste the selection" "The selection (PRIMARY), pasted." (\c -> c.keyPasteSelection) (\t c -> { c | keyPasteSelection = t })
    , chordSetting "search" "Search" "Opens the search bar over the scrollback." (\c -> c.keySearch) (\t c -> { c | keySearch = t })
    , chordSetting "settings" "Settings" "Opens the settings window." (\c -> c.keySettings) (\t c -> { c | keySettings = t })
    , { key = [ "clipboard", "osc52_read" ]
      , kind = OneOf [ "deny", "allow" ]
      , optional = False
      , label = "Programs may read the clipboard"
      , description = "Whether a program may read the clipboard with OSC 52."
      , words = [ "osc 52", "clipboard", "security" ]
      , page = Clipboard
      , applies = AtOnce
      , get =
            \c ->
                Text
                    (if c.osc52Read then
                        "allow"

                     else
                        "deny"
                    )
      , set =
            \v c ->
                when v is
                    Text "allow" ->
                        { c | osc52Read = True }

                    Text "deny" ->
                        { c | osc52Read = False }

                    _ ->
                        c
      }
    ]


{-| Whether a key is a setting's. -}
isSetting : Array String -> Bool
isSetting key =
    when find key is
        Just _ ->
            True

        Nothing ->
            meant Reason.NotKnown False


{-| The setting at a key, `["font", "size"]`. -}
find : Array String -> Maybe Setting
find key =
    Array.findFirst (\s -> s.key == key) settings |> Maybe.map .value


sections : Array String
sections =
    Array.foldl
        (\s acc ->
            when Array.first s.key is
                Just section ->
                    if Array.member section acc then
                        acc

                    else
                        Array.pushLast section acc

                Nothing ->
                    acc
        )
        []
        settings


-- DECODING


{-| What a file gives: the settings, each left out or refused its
default, and what was wrong, in the order of the file. -}
type alias Decoded =
    { config : Config
    , reports : Array Report
    }


{-| The settings a file gives, leniently (`settings-ui.md` §5): a key that
is not a setting, or a value a setting does not take, is reported with its
line and left at its default, and the rest are read. A file that is not
TOML at all is `Err`, with where it stops being TOML: nothing in it is
read. -}
decode : String -> Result Report Decoded
decode text =
    when Toml.parse text is
        Err e ->
            meant Reason.FromOutside Err { line = e.row, message = Toml.errorToString e }

        Ok doc ->
            when Toml.Table.fromDocument doc is
                Err e ->
                    meant Reason.FromOutside Err { line = Maybe.withDefault (meant Reason.NotKnown 1) (Dict.get e.path (linesOf doc)), message = Toml.Table.errorToString e }

                Ok table ->
                    let
                        lines =
                            linesOf doc

                        at =
                            { line = \path -> Maybe.withDefault (meant Reason.NotKnown 1) (Dict.get (String.join "." path) lines), integer = \path -> Toml.Decode.fromDocument (Toml.Decode.at path Toml.Decode.int) doc |> Result.mapError (\_ -> "too large a number") }

                        -- the scheme first, so that a color the file sets
                        -- beside it wins whatever the keys' order (ST29)
                        start =
                            when schemeIn table is
                                Just name ->
                                    Palettes.apply name Config.defaults

                                Nothing ->
                                    meant Reason.NotSet Config.defaults

                        found =
                            Dict.foldl (\section value acc -> top at section value acc)
                                { config = start, reports = [] }
                                (Toml.Table.entries table)
                    in
                    Ok { found | reports = Array.sortBy .line found.reports }


{-| `[colors] scheme`, if the file names one. -}
schemeIn : Toml.Table.Table -> Maybe String
schemeIn table =
    when Dict.get "colors" (Toml.Table.entries table) is
        Just (Toml.Table.TableValue colors) ->
            when Dict.get "scheme" (Toml.Table.entries colors) is
                Just (Toml.Table.StringValue name) ->
                    Just name

                _ ->
                    meant Reason.NotSet Nothing

        _ ->
            meant Reason.NotSet Nothing


{-| Where in the file: the line of a key, and the integer at it, which
gren-toml reads to an `Int` only through its decoders. -}
type alias At =
    { line : Array String -> Int
    , integer : Array String -> Result String Int
    }


top : At -> String -> Toml.Table.Value -> Decoded -> Decoded
top at section value acc =
    if section == "hosts" then
        when value is
            Toml.Table.TableValue inner ->
                Dict.foldl (\name v a -> hostAt at name v a) acc (Toml.Table.entries inner)

            _ ->
                report (at.line [ section ]) "hosts is a table of hosts, each written [hosts.\"name\"]" acc

    else if isSetting [ section ] then
        one at [ section ] value acc

    else if Array.member section sections then
        when value is
            Toml.Table.TableValue inner ->
                Dict.foldl (\name v a -> one at [ section, name ] v a) acc (Toml.Table.entries inner)

            _ ->
                report (at.line [ section ]) (section ++ " is a table of settings, written [" ++ section ++ "]") acc

    else
        report (at.line [ section ])
            ("[" ++ section ++ "] is not a table of settings" ++ suggest section (Array.map (\k -> "[" ++ k ++ "]") (Array.pushLast "hosts" sections)))
            acc


one : At -> Array String -> Toml.Table.Value -> Decoded -> Decoded
one at key value acc =
    let
        name =
            String.join "." key
    in
    when find key is
        Nothing ->
            meant Reason.FromOutside
                report (at.line key)
                    (name ++ " is not a setting" ++ suggest name (Array.map keyName settings))
                    acc

        Just s ->
            when read (\_ -> at.integer key) s.kind value is
                Ok v ->
                    { acc | config = s.set v acc.config }

                Err why ->
                    meant Reason.FromOutside report (at.line key) (name ++ ": " ++ why ++ "; " ++ shown s (s.get Config.defaults) ++ " is used") acc


{-| A host's table: its keys read as settings are, each reported at its
line when it is not one a host takes or has a value it does not; a host
with no `host` is reported and left out. -}
hostAt : At -> String -> Toml.Table.Value -> Decoded -> Decoded
hostAt at name value acc =
    let
        here =
            [ "hosts", name ]

        named =
            "hosts." ++ hostName name
    in
    when value is
        Toml.Table.TableValue table ->
            let
                gathered =
                    Dict.foldl (\key v r -> hostKey at here named key v r)
                        { host = Config.host name "", reports = [] }
                        (Toml.Table.entries table)

                withReports =
                    { acc | reports = acc.reports ++ gathered.reports }
            in
            if gathered.host.host == "" then
                report (at.line here) (named ++ " has no host = \"…\", where to connect; it is left out") withReports

            else
                let
                    config =
                        withReports.config
                in
                { withReports | config = { config | hosts = Array.pushLast gathered.host config.hosts } }

        _ ->
            report (at.line here) (named ++ " is a table, written [" ++ named ++ "]") acc


{-| A setting's key as the settings window's tables of words know it
(`Words`): its path joined by dots, a host's field without the host's name
(`hosts.*.user`), and a host's name `hosts.name`. -}
tableKey : Setting -> String
tableKey s =
    when s.key is
        [ "hosts", _ ] ->
            "hosts.name"

        [ "hosts", _, field ] ->
            "hosts.*." ++ field

        [ "hosts", _, table, field ] ->
            "hosts.*." ++ table ++ "." ++ field

        _ ->
            String.join "." s.key


hostName : String -> String
hostName name =
    if String.all (\c -> Char.isAlphaNum c || c == '-' || c == '_') name && name /= "" then
        name

    else
        "\"" ++ name ++ "\""


hostKeys : Array String
hostKeys =
    [ "host", "user", "port", "identity", "jump", "command", "charset", "title", "client", "colors", "font" ]


hostKey : At -> Array String -> String -> String -> Toml.Table.Value -> { host : Config.Host, reports : Array Report } -> { host : Config.Host, reports : Array Report }
hostKey at here named key value r =
    let
        path =
            here ++ [ key ]

        bad why =
            { r | reports = Array.pushLast { line = at.line path, message = named ++ "." ++ key ++ ": " ++ why ++ "; it is left out" } r.reports }

        h =
            r.host

        text f =
            when string value is
                Ok t ->
                    { r | host = f t }

                Err why ->
                    meant Reason.FromOutside bad why
    in
    if key == "host" then
        text (\t -> { h | host = t })

    else if key == "user" then
        text (\t -> { h | user = Just t })

    else if key == "identity" then
        text (\t -> { h | identity = Just t })

    else if key == "jump" then
        text (\t -> { h | jump = Just t })

    else if key == "command" then
        text (\t -> { h | command = Just t })

    else if key == "title" then
        text (\t -> { h | title = Just t })

    else if key == "client" then
        when read (\_ -> Err "") (OneOf [ "openssh", "built-in" ]) value is
            Ok (Text t) ->
                { r | host = { h | client = Just t } }

            Ok _ ->
                r

            Err why ->
                meant Reason.FromOutside bad why

    else if key == "charset" then
        when read (\_ -> Err "") (OneOf [ "utf-8", "euc-kr", "cp949" ]) value is
            Ok (Text t) ->
                { r | host = { h | charset = Just t } }

            Ok _ ->
                r

            Err why ->
                meant Reason.FromOutside bad why

    else if key == "port" then
        when read (\_ -> at.integer path) (WholeIn { low = 1, high = 65535, unit = "" }) value is
            Ok (Whole n) ->
                { r | host = { h | port = Just n } }

            Ok _ ->
                r

            Err why ->
                meant Reason.FromOutside bad why

    else if key == "colors" || key == "font" then
        when value is
            Toml.Table.TableValue inner ->
                Dict.foldl (\k v acc -> hostLook at path (named ++ "." ++ key) key k v acc) r (Toml.Table.entries inner)

            _ ->
                bad ("a table, written [" ++ named ++ "." ++ key ++ "]")

    else
        { r | reports = Array.pushLast { line = at.line path, message = named ++ "." ++ key ++ " is not a host's setting" ++ suggest key hostKeys } r.reports }


{-| A host's look over the settings': its colors and its font. -}
hostLook : At -> Array String -> String -> String -> String -> Toml.Table.Value -> { host : Config.Host, reports : Array Report } -> { host : Config.Host, reports : Array Report }
hostLook at here named table key value r =
    let
        path =
            here ++ [ key ]

        h =
            r.host

        bad why =
            { r | reports = Array.pushLast { line = at.line path, message = named ++ "." ++ key ++ ": " ++ why ++ "; it is left out" } r.reports }

        allowed =
            if table == "colors" then
                [ "foreground", "background", "tab", "palette" ]

            else
                [ "family", "size" ]
    in
    if not (Array.member key allowed) then
        { r | reports = Array.pushLast { line = at.line path, message = named ++ "." ++ key ++ " is not a host's setting" ++ suggest key allowed } r.reports }

    else if table == "colors" && key == "tab" then
        -- the host's tabs' color (docs/tabs.md TB9), which the settings
        -- have none of
        when read (\_ -> at.integer path) OneColor value is
            Ok (Color n) ->
                { r | host = { h | tab = Just n } }

            Ok _ ->
                r

            Err why ->
                meant Reason.FromOutside bad why

    else
        when find [ table, key ] is
            Just s ->
                when read (\_ -> at.integer path) s.kind value is
                    Ok (Color n) ->
                        { r
                            | host =
                                if key == "foreground" then
                                    { h | foreground = Just n }

                                else
                                    { h | background = Just n }
                        }

                    Ok (Colors p) ->
                        { r | host = { h | palette = Just p } }

                    Ok (Text t) ->
                        { r | host = { h | font = Just t } }

                    Ok (Whole n) ->
                        { r | host = { h | points = Just n } }

                    Ok _ ->
                        r

                    Err why ->
                        meant Reason.FromOutside bad why

            Nothing ->
                r


report : Int -> String -> Decoded -> Decoded
report line message acc =
    { acc | reports = Array.pushLast { line = line, message = message } acc.reports }


{-| A value of the file as a setting of `kind` takes it, or why not. -}
read : ({} -> Result String Int) -> Kind -> Toml.Table.Value -> Result String Value
read integerHere kind value =
    when kind is
        WholeIn r ->
            integer integerHere value
                |> Result.andThen
                    (\n ->
                        if n < r.low || n > r.high then
                            Err (String.fromInt n ++ " is not from " ++ String.fromInt r.low ++ " to " ++ String.fromInt r.high)

                        else
                            Ok (Whole n)
                    )

        AnyText ->
            string value |> Result.map Text

        FontFamily ->
            string value |> Result.map Text

        OnOff ->
            when value is
                Toml.Table.BooleanValue b ->
                    Ok (Flag b)

                _ ->
                    Err "not true or false"

        OneColor ->
            string value |> Result.andThen (inEnglish color) |> Result.map Color

        ColorList r ->
            when value is
                Toml.Table.ArrayValue items ->
                    if Array.length items > r.most then
                        Err (String.fromInt (Array.length items) ++ " colors, where the palette has " ++ String.fromInt r.most)

                    else
                        Array.foldl
                            (\item acc -> Result.map2 Array.pushLast (string item |> Result.andThen (inEnglish color)) acc)
                            (Ok [])
                            items
                            |> Result.map Colors

                _ ->
                    Err "not a list of colors"

        OneOf names ->
            string value
                |> Result.andThen
                    (\t ->
                        if Array.member t names then
                            Ok (Text t)

                        else
                            Err ("\"" ++ t ++ "\" is not " ++ alternatives names)
                    )

        Command ->
            when value is
                Toml.Table.ArrayValue items ->
                    Array.foldl (\item acc -> Result.map2 Array.pushLast (string item) acc) (Ok []) items
                        |> Result.map Words

                _ ->
                    Err "not a list of strings, the program and its arguments"

        Launch ->
            string value |> Result.andThen (inEnglish launch) |> Result.map Text

        HostName ->
            string value |> Result.map Text

        Address ->
            string value
                |> Result.andThen
                    (\t ->
                        if t == "" then
                            Err "where to connect is empty"

                        else
                            Ok (Text t)
                    )

        KeyChord ->
            string value |> Result.andThen chordText


{-| A check that answers a `Message`, its message in English, as the
file's reports are (they go to the terminal with the file's line). -}
inEnglish : (a -> Result Message b) -> a -> Result String b
inEnglish check value =
    check value |> Result.mapError (Words.say Words.English)


integer : ({} -> Result String Int) -> Toml.Table.Value -> Result String Int
integer here value =
    when value is
        Toml.Table.IntegerValue _ ->
            here {}

        _ ->
            Err "not a whole number"


string : Toml.Table.Value -> Result String String
string value =
    when value is
        Toml.Table.StringValue t ->
            Ok t

        _ ->
            Err "not a string"


{-| A color as `#rrggbb`. -}
color : String -> Result Message Int
color text =
    let
        digits =
            String.dropFirst 1 text

        value =
            String.foldl (\c acc -> Maybe.andThen (\v -> Maybe.map (\d -> v * 16 + d) (hexDigit c)) acc) (Just 0) digits
    in
    when value is
        Just v ->
            if String.startsWith "#" text && String.count digits == 6 then
                Ok v

            else
                Err (Words.message "problem.notColor" |> Words.with "text" text)

        Nothing ->
            meant Reason.FromOutside Err (Words.message "problem.notColor" |> Words.with "text" text)


hexDigit : Char -> Maybe Int
hexDigit c =
    let
        code =
            Char.toCode c
    in
    if code >= 48 && code <= 57 then
        Just (code - 48)

    else if code >= 97 && code <= 102 then
        Just (code - 87)

    else if code >= 65 && code <= 70 then
        Just (code - 55)

    else
        Nothing


alternatives : Array String -> String
alternatives names =
    let
        quoted =
            Array.map (\n -> "\"" ++ n ++ "\"") names
    in
    when Array.popLast quoted is
        Just { last, initial } ->
            if Array.isEmpty initial then
                last

            else
                String.join ", " initial ++ " or " ++ last

        Nothing ->
            "anything"


{-| A value as the file writes it, for a report. -}
shown : Setting -> Value -> String
shown s v =
    when v is
        Whole n ->
            String.fromInt n

        Text t ->
            "\"" ++ t ++ "\""

        Flag b ->
            if b then
                "true"

            else
                "false"

        Color n ->
            "\"" ++ hex n ++ "\""

        Colors p ->
            "[" ++ String.join ", " (Array.map (\n -> "\"" ++ hex n ++ "\"") p) ++ "]"

        Words w ->
            "[" ++ String.join ", " (Array.map (\t -> "\"" ++ t ++ "\"") w) ++ "]"

        Unset ->
            if s.optional then
                "the system's choice"

            else
                "nothing"


hex : Int -> String
hex n =
    let
        digit d =
            String.fromChar (Maybe.withDefault '0' (String.toArray "0123456789abcdef" |> Array.get d))

        two b =
            digit (b // 16) ++ digit (modBy 16 b)
    in
    "#" ++ two (modBy 256 (n // 65536)) ++ two (modBy 256 (n // 256)) ++ two (modBy 256 n)


{-| "; did you mean X?" for the nearest of `known` within two edits, or
nothing. -}
suggest : String -> Array String -> String
suggest name known =
    let
        best =
            Array.foldl
                (\k acc ->
                    let
                        d =
                            distance name
                                (if String.startsWith "[" k then
                                    String.slice 1 -1 k

                                 else
                                    k
                                )
                    in
                    if d <= 2 && (acc.distance < 0 || d < acc.distance) then
                        { distance = d, key = k }

                    else
                        acc
                )
                { distance = -1, key = "" }
                known
    in
    if best.distance < 0 then
        ""

    else
        "; did you mean " ++ best.key ++ "?"


{-| Levenshtein's distance between two strings. -}
distance : String -> String -> Int
distance a b =
    let
        bs =
            String.toArray b

        first =
            Array.range 0 (Array.length bs)
    in
    String.foldl
        (\ca row ->
            let
                start =
                    Maybe.withDefault 0 (Array.first row) + 1
            in
            Array.indexedFoldl
                (\j cb acc ->
                    let
                        above =
                            Maybe.withDefault 0 (Array.get (j + 1) row)

                        diagonal =
                            Maybe.withDefault 0 (Array.get j row)

                        left =
                            Maybe.withDefault 0 (Array.last acc)

                        cost =
                            if ca == cb then
                                0

                            else
                                1
                    in
                    Array.pushLast (min (min (above + 1) (left + 1)) (diagonal + cost)) acc
                )
                [ start ]
                bs
        )
        first
        a
        |> Array.last
        |> Maybe.withDefault 0


-- A HOST'S FIELDS


{-| A host's name, as the first row of its form: typed, it renames the
host (`renameHost`), which the settings window does on Enter. -}
nameSetting : String -> Setting
nameSetting name =
    { key = [ "hosts", name ]
    , kind = HostName
    , optional = False
    , label = "Name"
    , description = "What the host is called here, in the list and on the command line (puritty --host NAME)."
    , words = []
    , page = HostsPage
    , applies = AtOnce
    , get = \_ -> Text name
    , set = \_ c -> c
    }


{-| A host's fields as settings, so that the settings window edits them as
it edits the rest (`docs/settings.md` ST25): each reads and writes its part
of the host of that name among the settings' hosts, and its key is its
path in the file, `["hosts", name, "user"]`. All but `host` may be unset,
which takes the key out of the file. -}
hostFields : String -> Array Setting
hostFields name =
    let
        field path kind optional label description get put =
            { key = [ "hosts", name ] ++ path
            , kind = kind
            , optional = optional
            , label = label
            , description = description
            , words = []
            , page = HostsPage
            , applies = NewWindows
            , get =
                \c ->
                    when Array.findFirst (\h -> h.name == name) c.hosts is
                        Just found ->
                            get found.value

                        Nothing ->
                            meant Reason.NotKnown Unset
            , set =
                \v c ->
                    let
                        here =
                            Array.findFirst (\h -> h.name == name) c.hosts |> Maybe.map .value |> Maybe.withDefault (meant Reason.NotKnown Config.host name name)

                        changed =
                            put v here
                    in
                    { c | hosts = Array.keepIf (\h -> h.name /= name) c.hosts |> Array.pushLast changed }
            }

        text t =
            Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Text t)

        textOf v =
            when v is
                Text t ->
                    Just t

                _ ->
                    Nothing

        wholeOf v =
            when v is
                Whole n ->
                    Just n

                _ ->
                    Nothing

        colorOf v =
            when v is
                Color n ->
                    Just n

                _ ->
                    Nothing
    in
    [ field [ "host" ] Address False "Host" "Where to connect: a name or an address." (\h -> Text h.host) (\v h -> { h | host = Maybe.withDefault (meant Reason.NotSet h.host) (textOf v) })
    , field [ "user" ] AnyText True "User" "Who to log in as; ssh's own choice when unset." (\h -> text h.user) (\v h -> { h | user = textOf v })
    , field [ "port" ] (WholeIn { low = 1, high = 65535, unit = "" }) True "Port" "22, ssh's own, when unset." (\h -> Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Whole h.port)) (\v h -> { h | port = wholeOf v })
    , field [ "identity" ] AnyText True "Key" "The file of the private key to log in with; ssh's own choice when unset." (\h -> text h.identity) (\v h -> { h | identity = textOf v })
    , field [ "jump" ] AnyText True "Through" "Another host's name, or user@host:port, to connect through." (\h -> text h.jump) (\v h -> { h | jump = textOf v })
    , field [ "command" ] AnyText True "Command" "Run there, on a terminal, instead of the login shell." (\h -> text h.command) (\v h -> { h | command = textOf v })
    , field [ "charset" ] (OneOf [ "utf-8", "euc-kr", "cp949" ]) True "Character set" "The host's; the settings' when unset." (\h -> text h.charset) (\v h -> { h | charset = textOf v })
    , field [ "title" ] AnyText True "Title" "The window's title; the host's name when unset." (\h -> text h.title) (\v h -> { h | title = textOf v })
    , field [ "client" ] (OneOf [ "openssh", "built-in" ]) True "Client" "Which ssh connects: OpenSSH's on the terminal, or puritty's own; when unset, puritty's own on Windows and OpenSSH's on Linux." (\h -> text h.client) (\v h -> { h | client = textOf v })
    , field [ "colors", "foreground" ] OneColor True "Foreground" "The color of text, over the settings'." (\h -> Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Color h.foreground)) (\v h -> { h | foreground = colorOf v })
    , field [ "colors", "background" ] OneColor True "Background" "The color behind text, over the settings'; a red one for production is the usual." (\h -> Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Color h.background)) (\v h -> { h | background = colorOf v })
    , field [ "colors", "tab" ] OneColor True "Tab" "The color of its tabs in the bar, until a tab is given its own; none when unset." (\h -> Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Color h.tab)) (\v h -> { h | tab = colorOf v })
    , field [ "colors", "palette" ]
        (ColorList { most = 16 })
        True
        "Palette"
        "The 16 named colors, over the settings'."
        (\h -> Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Colors h.palette))
        (\v h ->
            { h
                | palette =
                    when v is
                        Colors p ->
                            Just p

                        _ ->
                            Nothing
            }
        )
    , field [ "font", "family" ] FontFamily True "Font" "The font, over the settings'." (\h -> text h.font) (\v h -> { h | font = textOf v })
    , field [ "font", "size" ] (WholeIn { low = 4, high = 200, unit = "pt" }) True "Font size" "In points, over the settings'." (\h -> Maybe.withDefault (meant Reason.NotSet Unset) (Maybe.map Whole h.points)) (\v h -> { h | points = wholeOf v })
    ]


{-| A host written whole into the file: each field set, or taken out when
the host leaves it unset, so that what is already there as the host has it
is not touched (`Toml.Edit.set` leaves a value the file means alone). -}
writeHost : Config.Host -> Toml.Document -> Toml.Document
writeHost h doc =
    let
        defaults =
            Config.defaults

        config =
            { defaults | hosts = [ h ] }
    in
    Array.foldl (\f d -> write f (f.get config) d) doc (hostFields h.name)


{-| A host taken out of the file: its table and the tables under it. -}
deleteHost : String -> Toml.Document -> Toml.Document
deleteHost name doc =
    Toml.Edit.removeTable [ "hosts", name ] doc


{-| A host renamed in the file: its table and the tables under it. -}
renameHost : String -> String -> Toml.Document -> Toml.Document
renameHost from to doc =
    Toml.Edit.renameTable [ "hosts", from ] to doc


-- AS TEXT


{-| A setting's value as the settings window edits it: a number as its
digits, a color as `#rrggbb`, a palette as its colors joined by commas,
a command as its words, quoted where one holds a space; unset as nothing. -}
toText : Value -> String
toText v =
    when v is
        Whole n ->
            String.fromInt n

        Text t ->
            t

        Flag b ->
            if b then
                "true"

            else
                "false"

        Color n ->
            hex n

        Colors p ->
            String.join ", " (Array.map hex p)

        Words w ->
            String.join " "
                (Array.map
                    (\word ->
                        if String.contains " " word || word == "" then
                            "\"" ++ word ++ "\""

                        else
                            word
                    )
                    w
                )

        Unset ->
            ""


{-| What the settings window's text gives a setting, or why it does not
take it: the file's checks, on text (`read`). An optional setting left
empty is unset. -}
fromText : Setting -> String -> Result Message Value
fromText s text0 =
    let
        text =
            String.trim text0
    in
    if s.optional && text == "" then
        Ok Unset

    else
        when s.kind is
            WholeIn r ->
                when String.toInt text is
                    Just n ->
                        if n < r.low || n > r.high then
                            Err
                                (Words.message "problem.outOfRange"
                                    |> Words.with "n" (String.fromInt n)
                                    |> Words.with "low" (String.fromInt r.low)
                                    |> Words.with "high" (String.fromInt r.high)
                                )

                        else
                            Ok (Whole n)

                    Nothing ->
                        meant Reason.FromOutside Err (Words.message "problem.notWhole")

            AnyText ->
                Ok (Text text0)

            FontFamily ->
                if text == "" then
                    Err (Words.message "problem.noFont")

                else
                    Ok (Text text)

            OnOff ->
                if text == "true" then
                    Ok (Flag True)

                else if text == "false" then
                    Ok (Flag False)

                else
                    Err (Words.message "problem.notTrueOrFalse")

            OneColor ->
                color text |> Result.map Color

            ColorList r ->
                let
                    parts =
                        if text == "" then
                            []

                        else
                            Array.map String.trim (String.split "," text)
                in
                if Array.length parts > r.most then
                    Err (Words.message "problem.tooManyColors" |> Words.with "n" (String.fromInt (Array.length parts)) |> Words.with "most" (String.fromInt r.most))

                else
                    Array.foldl (\part acc -> Result.map2 Array.pushLast (color part) acc) (Ok []) parts
                        |> Result.map Colors

            OneOf names ->
                if Array.member text names then
                    Ok (Text text)

                else
                    Err (Words.message "problem.notOneOf" |> Words.with "text" text |> Words.with "choices" (String.join ", " (Array.map (\n -> "\"" ++ n ++ "\"") names)))

            Command ->
                words text |> Result.map Words

            Launch ->
                launch text |> Result.map Text

            HostName ->
                if text == "" then
                    Err (Words.message "problem.hostNeedsName")

                else
                    Ok (Text text)

            Address ->
                if text == "" then
                    Err (Words.message "problem.whereToConnect")

                else
                    Ok (Text text)

            KeyChord ->
                chordText text |> Result.mapError (\_ -> Words.message "problem.notAChord" |> Words.with "text" text)


{-| What `start` takes: `shell`, `hosts`, or `host:` and a host's name. -}
launch : String -> Result Message String
launch text =
    if text == "shell" || text == "hosts" then
        Ok text

    else if String.startsWith "host:" text && String.count text > 5 then
        Ok text

    else
        Err (Words.message "problem.notLaunch" |> Words.with "text" text)


{-| A command's words: split at spaces, a quoted word kept whole. -}
words : String -> Result Message (Array String)
words text =
    let
        step c acc =
            if acc.quoted then
                if c == '"' then
                    { acc | quoted = False, any = True }

                else
                    { acc | word = acc.word ++ String.fromChar c }

            else if c == '"' then
                { acc | quoted = True, any = True }

            else if c == ' ' then
                if acc.any || acc.word /= "" then
                    { acc | done = Array.pushLast acc.word acc.done, word = "", any = False }

                else
                    acc

            else
                { acc | word = acc.word ++ String.fromChar c }

        end =
            String.foldl step { done = [], word = "", quoted = False, any = False } text
    in
    if end.quoted then
        Err (Words.message "problem.quoteNotClosed")

    else if end.any || end.word /= "" then
        Ok (Array.pushLast end.word end.done)

    else
        Ok end.done


-- WRITING


{-| A setting written into the file (`docs/settings.md` ST6): set when it
differs from its default, which `Toml.Edit.set` does in place, keeping the
file's comments and layout, and leaving a value the file already means as
the file writes it; taken out when it is the default (or unset), so the
file holds only what differs, and its table with it when nothing is left
under it and it has no comment of its own, which would go with it. Nothing
else in the file changes. -}
write : Setting -> Value -> Toml.Document -> Toml.Document
write s v doc =
    if v == s.get Config.defaults then
        let
            removed =
                Toml.Edit.remove s.key doc

            table =
                Array.slice 0 (Array.length s.key - 1) s.key

            -- a comment over a header is the header's in gren-toml, and goes
            -- with the table: a table with one stays, empty (ST18)
            headerComments =
                Toml.Edit.tableComments table removed

            emptied =
                not (Array.isEmpty table)
                    && not (Array.any (\path -> Array.slice 0 (Array.length table) path == table) (Toml.Edit.paths removed))
                    && Array.isEmpty headerComments.leading
                    && headerComments.trailing == Nothing
        in
        if emptied then
            Toml.Edit.removeTable table removed

        else
            removed

    else
        Toml.Edit.set s.key (editValue v) doc


editValue : Value -> Toml.Edit.Value
editValue v =
    when v is
        Whole n ->
            Toml.Edit.int n

        Text t ->
            Toml.Edit.string t

        Flag b ->
            Toml.Edit.bool b

        Color n ->
            Toml.Edit.string (hex n)

        Colors p ->
            Toml.Edit.array (Array.map (\n -> Toml.Edit.string (hex n)) p)

        Words w ->
            Toml.Edit.array (Array.map Toml.Edit.string w)

        Unset ->
            Toml.Edit.string ""


-- LINES


{-| The line each key and each table header is on, by its path joined
with dots: gren-toml keeps no positions, so they are counted from the
document's expressions, each a line but for a value that runs on. -}
linesOf : Toml.Document -> Dict String Int
linesOf doc =
    (Array.foldl
        (\e acc ->
            let
                next =
                    acc.line + Array.length (String.split "\n" (Toml.toString { hasBom = False, expressions = [ e ] })) - 1
            in
            when e.content is
                Ast.Pair p ->
                    { acc | line = next, found = Dict.set (String.join "." (acc.table ++ keyPath p.keyval.key)) acc.line acc.found }

                Ast.Header h ->
                    let
                        path =
                            keyPath h.header.key
                    in
                    { acc | line = next, table = path, found = Dict.set (String.join "." path) acc.line acc.found }

                Ast.Empty _ ->
                    { acc | line = next }
        )
        { line = 1, table = [], found = Dict.empty }
        doc.expressions
    ).found


keyPath : Ast.Key -> Array String
keyPath key =
    Array.pushFirst key.first.value (Array.map (\part -> part.key.value) key.rest)


-- THE EXAMPLE


{-| Every setting with an example value and what it means, as `README.md`
and `Config` show the file. A test holds it to the table: it decodes with
nothing reported, and it names every setting. -}
example : String
example =
    """
    start = "shell"               # what `puritty` opens: "shell", "hosts" (the
                                  # host list), or "host:NAME"

    [window]
    columns = 80
    rows = 24
    title = "puritty"

    [font]
    family = "DejaVu Sans Mono"   # as the system names it; on Windows
                                  # "Cascadia Mono" (`Platform.font`)
    size = 11                     # points
    language = "ja"               # what fallback fonts are asked for (V25);
                                  # the locale's when left out
    ligatures = true              # the font's (Fira Code's != and ..)
    glyph_cache_mb = 8            # the glyphs kept (V37), 4 or more

    [colors]
    scheme = "puritty"            # or "ghostty", "alacritty", "putty", "xterm",
                                  # "campbell", "solarized-dark", ...: colors
                                  # copied from another terminal; the keys
                                  # below win over it
    foreground = "#c5c8c6"
    background = "#1d1f21"
    bold_is_bright = false
    palette = ["#1d1f21", "#cc6666"]
                                  # the 16 named colors from 0, as many as
                                  # given; libghostty-vt's for the rest

    [cursor]
    blink_ms = 500                # the half of a blink; 0 does not blink

    [frames]
    every_ms = 16                 # output is drawn at most this often (V31)
    sync_timeout_ms = 150         # how long mode 2026 may hold a frame back

    [scrollback]
    lines = 25000                 # in bytes, as many as so many full lines take

    [program]
    command = ["htop"]            # what runs; $SHELL when left out
                                  # (on Windows PowerShell, `Platform`)

    [terminal]
    charset = "euc-kr"            # or "utf-8", "cp949": the program's; the
                                  # locale's when left out

    [selection]
    word_boundaries = " \\t'\\"│`|:;,()[]{}<>$"
                                  # the characters that end a word for a
                                  # double click (docs/user/copy-and-paste.md)
    copy_to_clipboard = true      # a selection is copied to the clipboard
                                  # too; true on Windows, false on Linux

    [mouse]
    paste_button = "middle"       # or "right": the button that pastes the
                                  # selection (docs/user/copy-and-paste.md)

    [tmux]
    tabs = "bottom"               # or "top": where the tab bar of tmux's
                                  # windows goes under tmux -CC
    look = "puritty"              # or "tmux": tmux -CC's prompts and
                                  # messages in a box, or on the bar's row

    [tabs]
    bar = "auto"                  # or "always": the bar of puritty's own
                                  # tabs, from two tabs on, or always
    look = "puritty"              # or "plain": square tabs
    middle_click_closes = true
    ask_before_closing = true     # when something runs in the tab
    restore = false               # true: open the last session's tabs again

    [sound]
    bell = "none"                 # or "system", "apple2", "ibm-pc", "atari-st",
                                  # "bbc-micro", "x11": Ctrl-G's sound
    keys = false                  # a click for each key typed

    [keys]                        # "" for none, so the program has the key
    new_tab = "Ctrl+Shift+T"
    close_tab = "Ctrl+Shift+W"
    rename_tab = "Ctrl+Shift+R"
    color_tab = ""               # none: the menu and a right click on a tab
    reopen_tab = "Ctrl+Alt+Shift+T"
    mark_log = "Ctrl+Alt+Shift+M"  # while [debug] log is on
    next_tab = "Ctrl+PageDown"
    previous_tab = "Ctrl+PageUp"
    next_tab_always = "Ctrl+Alt+PageDown"
    previous_tab_always = "Ctrl+Alt+PageUp"
    move_tab_right = "Ctrl+Shift+PageDown"
    move_tab_left = "Ctrl+Shift+PageUp"
    copy = "Ctrl+Shift+C"
    paste = "Ctrl+Shift+V"
    paste_selection = "Shift+Insert"
    search = "Ctrl+Shift+F"
    settings = "Ctrl+Comma"

    [clipboard]
    osc52_read = "deny"           # or "allow": whether a program may read the
                                  # clipboard with OSC 52 (the same guide)

    [debug]
    log = false                   # true: each window writes a diagnostic log,
                                  # nothing typed, pasted or shown in it

    [hosts."build-box"]           # a host, started with `puritty --host build-box`
    host = "build.example.com"
    user = "gilbert"              # left out: ssh's own choice, as for each below
    port = 2222
    identity = "~/.ssh/id_ed25519"
    jump = "bastion.example.com"  # another host's name, or user@host:port
    command = "tmux new -A -s main"
    charset = "euc-kr"
    title = "build"
    client = "built-in"           # or "openssh": which ssh connects

    [hosts."build-box".colors]   # this host's look, over the settings'
    background = "#2a1010"
    tab = "#c62828"               # its tabs' color in the bar

    [hosts."build-box".font]
    size = 13
    """


{-| A `[keys]` entry (docs/tabs.md TB6): the key an action of puritty's
own is on, named as `Chord` reads it, and empty for none. Each applies at
once, on the Keys page. -}
chordSetting : String -> String -> String -> (Config -> String) -> (String -> Config -> Config) -> Setting
chordSetting name label description get set =
    { key = [ "keys", name ]
    , kind = KeyChord
    , optional = False
    , label = label
    , description = description ++ " Empty: the program gets the key."
    , words = [ "keys", "key", "shortcut", "keyboard", "bind" ] ++ String.split "_" name
    , page = KeysPage
    , applies = AtOnce
    , get = \c -> Text (get c)
    , set =
        \v c ->
            when v is
                Text t ->
                    set t c

                _ ->
                    c
    }


{-| A key's name as puritty writes it, or "" for none, or why it names no
key. -}
chordText : String -> Result String Value
chordText text =
    Chord.parse text |> Result.map (\found -> Text (found |> Maybe.map Chord.show |> Maybe.withDefault (meant Reason.NotSet "")))
