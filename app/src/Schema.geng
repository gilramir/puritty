      , words = [ "paste", "click", "button" ]
      , page = MouseAndSelection
      , applies = AtOnce
      , get =
            \c ->
                Text
                    (if c.pasteButton == 2 then
                        "right"

                     else
                        "middle"
                    )
      , set =
            \v c ->
                when v is
                    Text "right" ->
                        { c | pasteButton = 2 }

                    Text "middle" ->
                        { c | pasteButton = 3 }

                    _ ->
                        c
      }
    , { key = [ "tmux", "tabs" ]
      , kind = OneOf [ "bottom", "top" ]
      , optional = False
