module SettingsProgram exposing (run, Outcome(..), Opener)

{-| `puritty settings` (`docs/settings.md` ST2, ST7): the settings window,
a process of its own (V57). `SettingsWindow` is what it shows and does;
this is the window around it. Its screen is fed to a terminal core of its
own and drawn as the terminal's is, so its text, fonts, input method and
both platforms are the terminal's. It keeps its own look (V60): the
platform's font at the default size and the default colors, so that no
setting can make the window that changes it unreadable.

Each change is written to the file at once (`SettingsFile`), which every
terminal follows (ST3); the file's directory is watched here too, so that
an edit by hand shows in the window.
-}

import Bytes exposing (Bytes)
import Config exposing (Config)
import Hosts
import Os.Process as Process
import SshConfig
import Dict exposing (Dict)
import Os.Directory as Directory
import Os.Error
import Os.File as File
import Os.Path as Path
import Platform
import Schema
import SettingsFile exposing (Store)
import SettingsSource exposing (Given, Read(..))
import SettingsGui
import SettingsWindow
import Text
import Words
import Source exposing (Source)
import Int64
import Task exposing (Task)
import Time
import Toml
import Window


type alias State =
    { window : SettingsWindow.Model
      -- a cell's size in pixels, the window's language, and the boxes the
      -- last frame's clicks land in (docs/settings-gui.md SG3)
    , cell : { width : Int, height : Int }
    , lang : Words.Lang
    , hits : Array SettingsGui.Hit
    , preedit : { points : Array Int, feedback : Array Int, caret : Int }
    , store : Maybe Store
    , given : Given
    , events : Maybe (Source Directory.Change)
    , closed : Bool
    , lost : Bool
      -- with PURITTY_SHOT set, the file each frame's picture is written to,
      -- for the settings gate (harness/settings.py)
    , shotPath : Maybe String
      -- how a session is started in a new window, and, for the host list,
      -- the host it becomes (V65)
    , opener : Maybe Opener
    , launcher : Bool
    , outcome : Maybe Config.Host
      -- the last left press, to count a double click (ST27)
    , lastPress : { at : Int, row : Int, col : Int, count : Int }
    }


{-| How the window starts a session in a window of its own: this
program's file, with `--host` or `ssh`, and `--config` when it was given
one. -}
type alias Opener =
    { cp : Process.Permission
    , program : String
    , config : Maybe String
    }


{-| How the window ended: closed, or, as the host list, connected to a
host, whose session the same window becomes (V65). -}
type Outcome
    = Closed
    | Session Config.Host


{-| The window's size in the terminal font's cells: narrower and taller
than a terminal's, so that it does not look like one (SG8). -}
size : { cols : Int, rows : Int }
size =
    { cols = 84, rows = 38 }


type alias Asked =
    { fs : File.Permission
    , vars : Dict String String
    , config : Maybe Path.Path
    , launcher : Bool
    , opener : Maybe Opener
    }


run : Asked -> Task String Outcome
run r =
    let
        given =
            { file = SettingsSource.settingsFile r.vars r.config, fs = r.fs, title = Nothing, program = [] }
    in
    -- the window's language, the system's (docs/settings-gui.md SG4)
    Platform.locale r.vars
        |> Task.andThen
            (\locale ->
                let
                    said =
                        Words.words (Words.langOf locale.language)
                in
                -- one settings window: a second raises the first and ends
                -- (ST8); each host list is a session to be, so there may be
                -- several
                (if r.launcher then Task.succeed False else Window.raise said.title)
                    |> Task.andThen
                        (\already ->
                            if already then
                                Task.succeed Closed

                            else
                                openWindow r given locale
                        )
            )


openWindow : Asked -> Given -> Platform.Locale -> Task String Outcome
openWindow r given locale =
    let
        lang =
            Words.langOf locale.language

        said =
            Words.words lang
    in
                SettingsSource.readSettings given
                    |> Task.andThen
                        (\read ->
                            Window.open
                                { cols = size.cols
                                , rows = size.rows
                                , font = Platform.font
                                , points = Config.defaults.points
                                , lang = locale.language
                                , glyphCap = Config.defaults.glyphCacheMb * 1024 * 1024
                                , title = if r.launcher then said.hostsTitle else said.title
                                }
                                |> Task.andThen
                                    (\opened ->
                                        when opened is
                                            Err why ->
                                                Task.fail ("cannot open the window: " ++ why)

                                            Ok cell ->
                                                Task.map3 (\events fonts aliases -> { events = events, fonts = fonts, aliases = aliases })
                                                    (SettingsSource.watchSettings given)
                                                    Window.fonts
                                                    (sshAliases r)
                                                    -- an arrow over a window of choices, not the
                                                    -- terminal's I-beam (Gilbert, 2026-11-10)
                                                    |> Task.andThen (\w -> Window.setPointer Window.ArrowPointer |> Task.map (\_ -> w))
                                                    |> Task.andThen (\w -> Text.interfaceFont Platform.interfaceFont |> Task.map (\_ -> w))
                                                    |> Task.andThen (\w -> loop (first r given read cell w (Dict.get "PURITTY_SHOT" r.vars) lang))
                                                    -- and the I-beam back for a session that takes this
                                                    -- window, whose loop begins with one
                                                    |> Task.andThen (\s -> Window.setPointer Window.TextPointer |> Task.map (\_ -> s))
                                                    |> Task.map
                                                        (\s ->
                                                            when s.outcome is
                                                                Just h ->
                                                                    Session h

                                                                Nothing ->
                                                                    Closed
                                                        )
                                    )
                        )


{-| The hosts `~/.ssh/config` names, or none when it cannot be read. -}
sshAliases : Asked -> Task x (Array String)
sshAliases r =
    when Platform.sshConfig r.vars is
        Just path ->
            File.readFile r.fs (Path.fromString path)
                |> Task.map (\b -> SshConfig.aliases (Bytes.toStringLossy b))
                |> Task.onError (\_ -> Task.succeed [])

        Nothing ->
            Task.succeed []


first : Asked -> Given -> Read -> Window.Cell -> { events : Maybe (Source Directory.Change), fonts : Array String, aliases : Array String } -> Maybe String -> Words.Lang -> State
first r given read cell w shotPath lang =
    let
        got =
            when read is
                Gave g ->
                    g

                Unread why ->
                    { config = Config.defaults, problems = [ why ] }

        path =
            Maybe.map (\f -> Path.toString f.path) given.file |> Maybe.withDefault "(no settings file)"
    in
    { window =
        SettingsWindow.init
            { config = got.config
            , path = path
            , reports = got.problems
            , cols = size.cols
            , rows = size.rows
            , fonts = w.fonts
            , aliases = w.aliases
            , launcher = r.launcher
            }
    , cell = { width = cell.width, height = cell.height }
    , lang = lang
    , hits = []
    , preedit = { points = [], feedback = [], caret = 0 }
    , store = Maybe.map (\f -> SettingsFile.store given.fs f.path) given.file
    , given = given
    , events = w.events
    , closed = False
    , lost = False
    , shotPath = shotPath
    , opener = r.opener
    , launcher = r.launcher
    , outcome = Nothing
    , lastPress = { at = -1000, row = -1, col = -1, count = 0 }
    }


{-| Draw, then wait for the window or the file, until the window is closed
or lost. -}
loop : State -> Task String State
loop s0 =
    draw s0
        |> Task.andThen
            (\s ->
                if s.closed || s.lost then
                    Task.succeed s

                else
                    let
                        file =
                            when s.events is
                                Just events ->
                                    [ Source.next events |> Task.map FileChanged ]

                                Nothing ->
                                    []
                    in
                    Task.race (Window.events |> Task.map WindowEvents) file
                        |> Task.andThen
                            (\turn ->
                                when turn is
                                    WindowEvents up ->
                                        if not up then
                                            Task.succeed { s | lost = True }

                                        else
                                            Window.take |> Task.andThen (\evs -> handle evs s)

                                    FileChanged change ->
                                        fileChanged change s
                            )
                        |> Task.andThen loop
            )


type Turn
    = WindowEvents Bool
    | FileChanged (Maybe Directory.Change)


draw : State -> Task x State
draw s =
    let
        preedit =
            String.fromArray (Array.mapAndKeepJust Char.fromCode s.preedit.points)

        window =
            measured s s.window

        frame =
            SettingsGui.paint s.lang window { cols = s.window.cols, rows = s.window.rows, cellWidth = s.cell.width, cellHeight = s.cell.height } preedit
    in
    Window.draw frame.list
        |> Task.andThen (\up -> Window.spot frame.spot |> Task.map (\_ -> up))
        |> Task.andThen
            (\up ->
                when s.shotPath is
                    Just path ->
                        Window.shot path |> Task.map (\_ -> up)

                    Nothing ->
                        Task.succeed up
            )
        |> Task.map (\up -> { s | window = window, hits = frame.hits, lost = s.lost || up == Nothing })


handle : Array Window.Event -> State -> Task String State
handle evs s =
    when Array.popFirst evs is
        Nothing ->
            Task.succeed s

        Just { first = ev, rest } ->
            one ev s |> Task.andThen (handle rest)


one : Window.Event -> State -> Task String State
one ev s =
    when ev is
        Window.Key k ->
            if k.action == 0 then
                Task.succeed s

            else
                input (SettingsWindow.Key { sym = k.sym, mods = k.mods, text = Bytes.toStringLossy k.text }) s

        Window.Commit text ->
            input (SettingsWindow.Typed (Bytes.toStringLossy text)) s

        Window.Preedit p ->
            let
                cps =
                    Array.map Char.toCode (String.toArray (Bytes.toStringLossy p.text))

                old =
                    s.preedit

                points =
                    Array.takeFirst p.first old.points ++ cps ++ Array.dropFirst (p.first + p.length) old.points

                feedback =
                    Array.takeFirst p.first old.feedback
                        ++ Array.initialize (Array.length cps) 0 (\i -> Maybe.withDefault 0 (Array.get i p.feedback))
                        ++ Array.dropFirst (p.first + p.length) old.feedback
            in
            Task.succeed { s | preedit = { points = points, feedback = feedback, caret = p.caret } }

        Window.PreeditDone ->
            Task.succeed { s | preedit = { points = [], feedback = [], caret = 0 } }

        Window.Resized r ->
            input (SettingsWindow.Resized { cols = r.cols, rows = r.rows }) s

        Window.Rescaled cell ->
            -- another monitor's scale (docs/windows.md WS30): the text is
            -- laid out again by the new cell when the Resized that follows
            -- comes
            Task.succeed { s | cell = cell }

        Window.Pointer p ->
            if p.action == 0 && p.button == 1 && p.cellWidth > 0 && p.cellHeight > 0 then
                -- a second press within 400 ms on the same cell is a double
                -- click (ST27)
                Time.monotonic
                    |> Task.map (\t -> Int64.toInt (Time.inMilliseconds t))
                    |> Task.andThen
                        (\ms ->
                            let
                                cell =
                                    { col = p.x // p.cellWidth, row = p.y // p.cellHeight }

                                last =
                                    s.lastPress

                                count =
                                    if ms - last.at <= 400 && last.row == cell.row && last.col == cell.col then last.count + 1 else 1

                                -- the topmost box under the pointer: the last
                                -- drawn comes first
                                hit =
                                    Array.findFirst (\b -> p.x >= b.x && p.x < b.x + b.w && p.y >= b.y && p.y < b.y + b.h) s.hits
                                        |> Maybe.map (\found -> found.value.target)

                                pressed =
                                    { s | lastPress = { at = ms, row = cell.row, col = cell.col, count = count } }
                            in
                            when hit is
                                Just t ->
                                    input (SettingsWindow.Hit { target = t, count = count }) pressed

                                Nothing ->
                                    Task.succeed pressed
                        )

            else if p.action == 0 && (p.button == 4 || p.button == 5) then
                -- the wheel: a step up or down
                input (SettingsWindow.Scroll (if p.button == 4 then -1 else 1)) s

            else
                Task.succeed s

        Window.Close ->
            Task.succeed { s | closed = True }

        _ ->
            Task.succeed s


{-| An input to the window, and what it asks done. -}
input : SettingsWindow.Input -> State -> Task String State
input i s =
    let
        r =
            SettingsWindow.update i (measured s s.window)
    in
    Array.foldl (\e t -> t |> Task.andThen (effect e)) (Task.succeed { s | window = measured s r.model }) r.effects


{-| The window with its rows measured as they will be drawn (SG12). -}
measured : State -> SettingsWindow.Model -> SettingsWindow.Model
measured s w =
    SettingsWindow.withRowLines (SettingsGui.measure s.lang w { cols = w.cols, rows = w.rows, cellWidth = s.cell.width, cellHeight = s.cell.height }) w


effect : SettingsWindow.Effect -> State -> Task String State
effect e s =
    when e is
        SettingsWindow.Close ->
            Task.succeed { s | closed = True }

        SettingsWindow.ConnectHost name ->
            connect (Hosts.named name s.window.config) [ "--host", name ] s

        SettingsWindow.ConnectQuick target ->
            when Hosts.quick target is
                Just h ->
                    connect h [ "ssh", target ] s

                Nothing ->
                    Task.succeed s

        SettingsWindow.Write w ->
            writeWith (Schema.write w.setting w.value) s

        SettingsWindow.PutHost h ->
            writeWith (Schema.writeHost h) s

        SettingsWindow.DeleteHost name ->
            writeWith (Schema.deleteHost name) s

        SettingsWindow.RenameHost r ->
            writeWith (Schema.renameHost r.from r.to) s


{-| The file changed by an edit (`SettingsFile.change`); a failure shown at
the window's foot. -}
writeWith : (Toml.Document -> Toml.Document) -> State -> Task String State
writeWith edit s =
    when s.store is
        Nothing ->
            Task.succeed { s | window = SettingsWindow.told (Words.message "message.noFile") s.window }

        Just store ->
            SettingsFile.change edit store
                |> Task.map Ok
                |> Task.onError (\why -> Task.succeed (Err why))
                |> Task.andThen
                    (\written ->
                        when written is
                            Ok st ->
                                Task.succeed { s | store = Just st }

                            Err why ->
                                Task.succeed { s | window = SettingsWindow.told (Words.message "message.notWritten" |> Words.with "why" why) s.window }
                    )


{-| A session: the host list becomes it (V65); the settings window starts
it in a window of its own, this program again with `args`. -}
connect : Config.Host -> Array String -> State -> Task String State
connect h args s =
    if s.launcher then
        Task.succeed { s | outcome = Just h, closed = True }

    else
        when s.opener is
            Just o ->
                Process.spawn o.cp o.program (args ++ Maybe.withDefault [] (Maybe.map (\c -> [ "--config", c ]) o.config)) (Process.defaultSpawnOptions Process.Ignored)
                    |> Task.map (\_ -> Nothing)
                    |> Task.onError (\e -> Task.succeed (Just (Os.Error.toString e)))
                    |> Task.map
                        (\failed ->
                            when failed is
                                Just why ->
                                    { s | window = SettingsWindow.told (Words.message "message.notStarted" |> Words.with "why" why) s.window }

                                Nothing ->
                                    s
                        )

            Nothing ->
                Task.succeed { s | window = SettingsWindow.told (Words.message "message.noExecutable") s.window }


{-| The file changed: read again, and its settings shown. The window's own
writes come back this way too, as what it already shows. -}
fileChanged : Maybe Directory.Change -> State -> Task String State
fileChanged change s =
    let
        ours path =
            when s.given.file is
                Just f ->
                    Path.filename path == Path.filename f.path

                Nothing ->
                    False

        again =
            when change is
                Just (Directory.Added path) ->
                    Just (ours path)

                Just (Directory.Changed path) ->
                    Just (ours path)

                Just (Directory.Removed path) ->
                    Just (ours path)

                Just Directory.Lost ->
                    Just True

                _ ->
                    Nothing
    in
    when again is
        Just True ->
            SettingsSource.readSettings s.given
                |> Task.onError (\why -> Task.succeed (Unread why))
                |> Task.map
                    (\read ->
                        when read is
                            Gave g ->
                                { s | window = SettingsWindow.fileRead { config = g.config, reports = g.problems } s.window }

                            Unread why ->
                                { s | window = SettingsWindow.told (Words.plain why) s.window }
                    )

        Just False ->
            Task.succeed s

        Nothing ->
            Task.succeed { s | events = Nothing }
