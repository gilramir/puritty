module Dialog exposing (Dialog, Swatch, Button, contrast, draw, swatchAt, buttonAt, searchBar, scrollbar, scrollbarHit)

{-| A question asked over the terminal (`docs/ssh-client.md` SC23), as
ChromeOS's Terminal asks for a password: a box in the middle of the
window, in the settings window's look, drawn with the renderer's interface
records after the terminal's cells, so nothing of the terminal lies over
it. A title, lines of text, a field with what is typed (bullets for a
secret) and a caret, a row of colors to choose from (`docs/tabs.md`
TB9), and a line of the keys that answer, with buttons beside it for a
mouse (`docs/tabs.md` TB12).
-}

import Bitwise
import Bytes exposing (Bytes)
import Math
import SettingsGui exposing (box, clip, fit, framed, look, noClip, text)
import Text


type alias Dialog =
    { title : String
    , lines : Array String
    , field : Maybe { typed : String, hidden : Bool, caret : Int }
    , swatches : Array Swatch
    , hint : String
    , buttons : Array Button
    }


{-| A button on the box's last row, at its right: the first is the
answer Enter gives, filled in the accent color. -}
type alias Button =
    { label : String
    , primary : Bool
    }


{-| A color to choose: drawn filled, its key's name on it, and framed when
it is the one in use. -}
type alias Swatch =
    { color : Int
    , label : String
    , marked : Bool
    }


{-| Where a box's parts are, in pixels, for `draw` and `swatchAt`. -}
type alias Layout =
    { px : Int -> Int
    , body : Int
    , small : Int
    , pad : Int
    , lineH : Int
    , fieldH : Int
    , bx : Int
    , by : Int
    , bw : Int
    , bh : Int
    , inner : Int
    , swatchY : Int
    , swatch : Int
    , swatchGap : Int
    , fieldY : Int
    , buttonH : Int
    , buttonY : Int
    , buttonXs : Array { x : Int, w : Int }
    }


layout : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> Dialog -> Layout
layout size d =
    let
        w =
            size.cols * size.cellWidth

        h =
            size.rows * size.cellHeight

        k =
            toFloat size.cellHeight / 17

        px n =
            max 1 (Math.round (toFloat n * k))

        pad =
            px 22

        lineH =
            px 22

        fieldH =
            px 34

        bw =
            min (w - px 32) (px 560)

        inner =
            bw - 2 * pad

        -- the swatches' row: each square, as many as fit the box's width
        swatchGap =
            px 8

        count =
            Array.length d.swatches

        swatch =
            if count == 0 then 0 else min (px 30) ((inner - (count - 1) * swatchGap) // count)

        swatchRow =
            if count == 0 then 0 else px 8 + swatch

        -- the last row: the hint, and the buttons at its right
        buttonH =
            px 30

        rowH =
            if Array.isEmpty d.buttons then lineH else max lineH buttonH

        buttonWs =
            Array.map (\b -> Text.width (px 14) b.label + 2 * px 16) d.buttons

        buttonGap =
            px 8

        buttonsW =
            Array.foldl (+) 0 buttonWs + max 0 (Array.length buttonWs - 1) * buttonGap

        bh =
            pad
                + lineH
                + Array.length d.lines * lineH
                + swatchRow
                + (when d.field is
                    Just _ ->
                        px 8 + fieldH

                    Nothing ->
                        0
                  )
                + px 12
                + rowH
                + pad

        bx =
            (w - bw) // 2

        by =
            max 0 ((h - bh) // 2)

        swatchY =
            by + pad + (1 + Array.length d.lines) * lineH + px 8

        buttonXs =
            Array.foldl
                (\bw0 acc -> { x = acc.x + bw0 + buttonGap, placed = Array.pushLast { x = acc.x, w = bw0 } acc.placed })
                { x = bx + bw - pad - buttonsW, placed = [] }
                buttonWs
                |> .placed
    in
    { px = px
    , body = px 14
    , small = px 12
    , pad = pad
    , lineH = lineH
    , fieldH = fieldH
    , bx = bx
    , by = by
    , bw = bw
    , bh = bh
    , inner = inner
    , swatchY = swatchY
    , swatch = swatch
    , swatchGap = swatchGap
    , fieldY = swatchY - px 8 + swatchRow + px 8
    , buttonH = buttonH
    , buttonY = by + bh - pad - buttonH
    , buttonXs = buttonXs
    }


{-| The button under a point, by its place in the row. -}
buttonAt : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> Dialog -> { x : Int, y : Int } -> Maybe Int
buttonAt size d p =
    let
        l =
            layout size d
    in
    if p.y >= l.buttonY && p.y < l.buttonY + l.buttonH then
        Array.findFirst (\b -> p.x >= b.x && p.x < b.x + b.w) l.buttonXs |> Maybe.map .index

    else
        Nothing


{-| The swatch under a point, by its place in the row. -}
swatchAt : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> Dialog -> { x : Int, y : Int } -> Maybe Int
swatchAt size d p =
    let
        l =
            layout size d

        i =
            (p.x - l.bx - l.pad) // max 1 (l.swatch + l.swatchGap)

        left =
            l.bx + l.pad + i * (l.swatch + l.swatchGap)
    in
    if l.swatch > 0 && p.y >= l.swatchY && p.y < l.swatchY + l.swatch && p.x >= l.bx + l.pad && p.x < left + l.swatch && i < Array.length d.swatches then
        Just i

    else
        Nothing


{-| The box's records for a window of `cols` by `rows` cells, and where the
caret is, in cells, for an input method's window. -}
draw : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> Dialog -> { list : Bytes, spot : { x : Int, y : Int } }
draw size d =
    let
        l =
            layout size d

        px =
            l.px

        body =
            l.body

        small =
            l.small

        pad =
            l.pad

        lineH =
            l.lineH

        fieldH =
            l.fieldH

        bw =
            l.bw

        bh =
            l.bh

        bx =
            l.bx

        by =
            l.by

        inner =
            l.inner

        baseline row =
            by + pad + row * lineH + lineH // 2 + body // 3

        fieldY =
            l.fieldY

        swatchRecords =
            Array.indexedMap
                (\i sw ->
                    let
                        x =
                            bx + pad + i * (l.swatch + l.swatchGap)
                    in
                    Bytes.flatten
                        [ if sw.marked then
                            framed { x = x - px 3, y = l.swatchY - px 3, w = l.swatch + px 6, h = l.swatch + px 6, r = px 7, color = look.bg, border = look.accent }

                          else
                            Bytes.empty
                        , framed { x = x, y = l.swatchY, w = l.swatch, h = l.swatch, r = px 5, color = sw.color, border = look.fieldLine }
                        , text { x = x + (l.swatch - Text.width small sw.label) // 2, y = l.swatchY + l.swatch // 2 + small // 3, size = small, color = contrast sw.color, text = sw.label }
                        ]
                )
                d.swatches

        shown =
            when d.field is
                Just f ->
                    if f.hidden then
                        String.repeat (String.count f.typed) "•"

                    else
                        f.typed

                Nothing ->
                    ""

        -- the caret where it is in what is typed; at the end when hidden
        typedW =
            when d.field is
                Just f ->
                    if f.hidden then
                        Text.width body shown

                    else
                        Text.width body (String.takeFirst f.caret shown)

                Nothing ->
                    0

        caretX =
            bx + pad + px 10 + min typedW (inner - px 20)

        hintY =
            if Array.isEmpty d.buttons then
                by + bh - pad - lineH // 2 + small // 3

            else
                l.buttonY + l.buttonH // 2 + small // 3

        hintW =
            when Array.first l.buttonXs is
                Just first ->
                    max 0 (first.x - px 12 - (bx + pad))

                Nothing ->
                    inner

        buttonRecords =
            Array.indexedMap
                (\i b ->
                    when Array.get i l.buttonXs is
                        Just at ->
                            Bytes.flatten
                                [ framed { x = at.x, y = l.buttonY, w = at.w, h = l.buttonH, r = px 5, color = if b.primary then look.accent else look.field, border = if b.primary then look.accent else look.fieldLine }
                                , text { x = at.x + (at.w - Text.width body b.label) // 2, y = l.buttonY + l.buttonH // 2 + body // 3, size = body, color = if b.primary then contrast look.accent else look.strong, text = b.label }
                                ]

                        Nothing ->
                            Bytes.empty
                )
                d.buttons

        records =
            [ framed { x = bx, y = by, w = bw, h = bh, r = px 10, color = look.bg, border = look.fieldLine }
            , text { x = bx + pad, y = baseline 0, size = body, color = look.strong, text = fit body inner d.title }
            ]
                ++ Array.indexedMap (\i line -> text { x = bx + pad, y = baseline (i + 1), size = body, color = look.text, text = fit body inner line }) d.lines
                ++ swatchRecords
                ++ (when d.field is
                        Just _ ->
                            [ framed { x = bx + pad, y = fieldY, w = inner, h = fieldH, r = px 5, color = look.field, border = look.accent }
                            , clip { x = bx + pad + 1, y = fieldY, w = inner - 2, h = fieldH }
                            , text { x = bx + pad + px 10, y = fieldY + fieldH // 2 + body // 3, size = body, color = look.strong, text = shown }
                            , box { x = caretX, y = fieldY + px 7, w = 1, h = fieldH - px 14, r = 0, color = look.strong }
                            , noClip
                            ]

                        Nothing ->
                            []
                   )
                ++ [ text { x = bx + pad, y = hintY, size = small, color = look.dim, text = fit small hintW d.hint } ]
                ++ buttonRecords
    in
    { list = Bytes.flatten records
    , spot =
        when d.field is
            Just _ ->
                { x = caretX // max 1 size.cellWidth, y = fieldY // max 1 size.cellHeight }

            Nothing ->
                { x = (bx + pad) // max 1 size.cellWidth, y = baseline 0 // max 1 size.cellHeight }
    }



{-| Dark text on a light color, white on a dark one. -}
contrast : Int -> Int
contrast color =
    let
        r =
            Bitwise.and 0xFF (Bitwise.shiftRightZfBy 16 color)

        g =
            Bitwise.and 0xFF (Bitwise.shiftRightZfBy 8 color)

        b =
            Bitwise.and 0xFF color
    in
    if 299 * r + 587 * g + 114 * b > 150000 then 0x1C1C1C else 0xFFFFFF


{-| The search bar (`docs/phase3-select.md` §23): a field at the window's
top right with the query and a caret, and under it a note (no match, or
the keys). -}
searchBar : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> { query : String, note : String, failed : Bool } -> { list : Bytes, spot : { x : Int, y : Int } }
searchBar size b =
    let
        w =
            size.cols * size.cellWidth

        k =
            toFloat size.cellHeight / 17

        px n =
            max 1 (Math.round (toFloat n * k))

        body =
            px 13

        small =
            px 11

        bw =
            min (w - px 16) (px 380)

        bh =
            px 64

        bx =
            w - bw - px 14

        by =
            px 8

        field =
            { x = bx + px 10, y = by + px 8, w = bw - px 20, h = px 28 }

        typedW =
            Text.width body b.query

        caretX =
            field.x + px 8 + min typedW (field.w - px 16)
    in
    { list =
        Bytes.flatten
            [ framed { x = bx, y = by, w = bw, h = bh, r = px 8, color = look.bg, border = look.fieldLine }
            , framed { x = field.x, y = field.y, w = field.w, h = field.h, r = px 4, color = look.field, border = if b.failed then look.error else look.accent }
            , clip { x = field.x + 1, y = field.y, w = field.w - 2, h = field.h }
            , text { x = field.x + px 8, y = field.y + field.h // 2 + body // 3, size = body, color = if b.query == "" then look.dim else look.strong, text = if b.query == "" then "Search" else b.query }
            , box { x = caretX, y = field.y + px 6, w = 1, h = field.h - px 12, r = 0, color = look.strong }
            , noClip
            , text { x = field.x, y = by + bh - px 10, size = small, color = if b.failed then look.error else look.dim, text = fit small field.w b.note }
            ]
    , spot = { x = caretX // max 1 size.cellWidth, y = field.y // max 1 size.cellHeight }
    }


{-| The scrollbar (`docs/phase3-select.md` §23): a thumb at the window's
right edge, as tall as the view is of all there is and as far down as the
view is, for a view `back` rows up of `most`. -}
scrollbar : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> { back : Int, most : Int } -> Bytes
scrollbar size v =
    let
        g =
            barGeometry size v
    in
    if v.most <= 0 then
        Bytes.empty

    else
        box { x = g.x, y = g.thumbY, w = g.width, h = g.thumbH, r = g.width // 2, color = 0x7A7A7A }


{-| Where the scrollbar's column is, and how far back a pointer at pixel
`y` of it puts the view: the thumb's middle at the pointer. `Nothing` when
the pointer is not in the column. -}
scrollbarHit : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> { back : Int, most : Int } -> { x : Int, y : Int } -> Maybe Int
scrollbarHit size v p =
    let
        g =
            barGeometry size v

        room =
            max 1 (g.track - g.thumbH)
    in
    if v.most <= 0 || p.x < g.x - g.width then
        Nothing

    else
        -- the thumb's top at the pointer less half the thumb, as a share of
        -- the track: 0 at the top is all the way back
        Just (clamp 0 v.most (v.most - (v.most * (p.y - g.top - g.thumbH // 2)) // room))


barGeometry : { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int } -> { back : Int, most : Int } -> { x : Int, width : Int, top : Int, track : Int, thumbY : Int, thumbH : Int }
barGeometry size v =
    let
        w =
            size.cols * size.cellWidth

        h =
            size.rows * size.cellHeight

        k =
            toFloat size.cellHeight / 17

        px n =
            max 1 (Math.round (toFloat n * k))

        width =
            px 6

        top =
            px 4

        track =
            h - 2 * top

        all =
            max 1 (v.most + size.rows)

        thumbH =
            max (px 24) (track * size.rows // all)

        room =
            max 0 (track - thumbH)

        thumbY =
            top + room - (room * clamp 0 v.most v.back) // max 1 v.most
    in
    { x = w - width - px 3, width = width, top = top, track = track, thumbY = thumbY, thumbH = thumbH }
