module NotifyText exposing (plain)

{-| A notification's text made ready for the desktop's notification
service (puritty `docs/claude-code.md` CL8, CL12). -}


{-| A body as plain text for the notification service, which may read a
body as markup (`<b>`, `<a href>`, `<img src>`; GNOME Shell, KDE and
dunst do): `&`, `<` and `>` written as entities, the Desktop
Notifications spec's rule for plain text. A body is a program's text, a
remote one's too (OSC 9, 777, 99; the code review's X28). Linux's
`notify-send` takes it; Windows' balloon reads no markup. -}
plain : String -> String
plain text =
    text
        |> String.replace "&" "&amp;"
        |> String.replace "<" "&lt;"
        |> String.replace ">" "&gt;"
