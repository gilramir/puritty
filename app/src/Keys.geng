module Keys exposing (encode)

{-| What a key sends the program (`docs/phase3-input.md` V47): the window's
key record, made in C from xkbcommon, handed to `Vt.Keys`, Ghostty's
encoder in Geng, with the options the core's modes give.
-}

import Bytes exposing (Bytes)
import Vt
import Vt.KeyTables
import Vt.Keys


{-| The bytes a key sends, under the terminal's modes. -}
encode : Vt.Term -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes
encode term k =
    Vt.Keys.encode (Vt.keyOptions term)
        { action = k.action
        , key = Vt.KeyTables.evdevKey (k.keycode - 8)
        , mods = k.mods
        , consumed = k.consumed
        , composing = False
        , text = Bytes.toStringLossy k.text
        , unshifted = k.unshifted
        }
        |> Bytes.fromString
