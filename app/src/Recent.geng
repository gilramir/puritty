module Recent exposing (Recent(..), added, arguments, commandLine, fileName, forgotten, fromOldText, fromText, keep, name, oldFileName, toText)

{-| The connections made last (`docs/settings-gui.md` SG14, Dnene59), newest
first, which the host list offers before the saved ones: a saved host by its
name, so that a change to it applies, or what quick connect was given, as it
was typed, `gilbert@build tmux -CC attach`. Kept in a TOML file of their own
in puritty's state folder, never in the settings file, and never a password:

    [[connections]]
    host = "build-box"

    [[connections]]
    quick = "gilbert@build tmux -CC attach"

-}

import Reason
import Toml.Decode as Decode exposing (Decoder)
import Toml.Encode as Encode


type Recent
    = Saved String
    | Quick String


{-| The file's name in the state folder. -}
fileName : String
fileName =
    "recent.toml"


{-| How many are kept unless the settings say otherwise (`recent`). -}
keep : Int
keep =
    8


{-| The file's connections read: one that is neither `host` nor `quick` is
passed over, as a file from a later puritty might have; a file that is not
TOML is none. -}
fromText : String -> Array Recent
fromText text =
    Decode.fromString connections text |> Result.withDefault (meant Reason.FromOutside [])


connections : Decoder (Array Recent)
connections =
    Decode.optionalField "connections" (Decode.array (Decode.maybe connection))
        |> Decode.map (Maybe.withDefault [] >> Array.mapAndKeepJust identity)


connection : Decoder Recent
connection =
    Decode.oneOf
        [ Decode.field "host" nonEmpty |> Decode.map Saved
        , Decode.field "quick" nonEmpty |> Decode.map Quick
        ]


nonEmpty : Decoder String
nonEmpty =
    Decode.string
        |> Decode.andThen
            (\t ->
                if t == "" then
                    Decode.fail "empty"

                else
                    Decode.succeed t
            )


{-| The file before it was TOML (`docs/sftp.md` FT33), read once into the
new one. The import goes when the machines that had it have been through
it. -}
oldFileName : String
oldFileName =
    "recent.txt"


{-| The old file's lines, `host NAME` or `quick TEXT`; another is passed
over. -}
fromOldText : String -> Array Recent
fromOldText text =
    String.lines text
        |> Array.mapAndKeepJust
            (\line ->
                if String.startsWith "host " line && String.count line > 5 then
                    Just (Saved (String.dropFirst 5 line))

                else if String.startsWith "quick " line && String.count line > 6 then
                    Just (Quick (String.dropFirst 6 line))

                else
                    Nothing
            )


toText : Array Recent -> String
toText recents =
    Encode.toString
        [ Encode.field "connections"
            (Encode.tableArray
                (Array.map
                    (\r ->
                        when r is
                            Saved host ->
                                [ Encode.field "host" (Encode.string host) ]

                            Quick text ->
                                [ Encode.field "quick" (Encode.string text) ]
                    )
                    recents
                )
            )
        ]


{-| A connection made: first, the same one further down gone, and no more
than `most` kept; none at all when `most` is 0. -}
added : Int -> Recent -> Array Recent -> Array Recent
added most r recents =
    Array.pushFirst r (forgotten r recents)
        |> Array.takeFirst (max 0 most)


forgotten : Recent -> Array Recent -> Array Recent
forgotten r recents =
    Array.keepIf (\x -> x /= r) recents


{-| What puritty is started with to make the connection again
(`docs/settings-gui.md` SG19): a saved host by `--host`, what quick connect
was given by `ssh`, as the host list starts them. -}
arguments : Recent -> Array String
arguments r =
    when r is
        Saved host ->
            [ "--host", host ]

        Quick text ->
            [ "ssh", text ]


{-| How a menu names it: the saved host's name, or what quick connect was
given. -}
name : Recent -> String
name r =
    when r is
        Saved host ->
            host

        Quick text ->
            text


{-| Arguments as one Windows command line, each split back out as the C
runtime splits one (`CommandLineToArgvW`): in quotes when it is empty or
holds a space, a tab or a quote; a quote written `\"`, and the backslashes
before a quote or the closing quote doubled. Os.Process quotes a child's
so; a jump list's link takes its arguments as one line. -}
commandLine : Array String -> String
commandLine args =
    String.join " " (Array.map quoted args)


quoted : String -> String
quoted arg =
    if arg /= "" && not (String.any (\c -> c == ' ' || c == '\t' || c == '"') arg) then
        arg

    else
        let
            done =
                String.foldl
                    (\c acc ->
                        if c == '\\' then
                            { acc | slashes = acc.slashes + 1 }

                        else if c == '"' then
                            { out = acc.out ++ String.repeat (acc.slashes * 2 + 1) "\\" ++ "\"", slashes = 0 }

                        else
                            { out = acc.out ++ String.repeat acc.slashes "\\" ++ String.fromChar c, slashes = 0 }
                    )
                    { out = "", slashes = 0 }
                    arg
        in
        "\"" ++ done.out ++ String.repeat (done.slashes * 2) "\\" ++ "\""
