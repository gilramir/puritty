module Config exposing (Config, defaults, decode, languageOf, charsetOf)

{-| puritty's settings (`docs/renderer.md` §R10), read from
`$XDG_CONFIG_HOME/puritty/config.toml`, or `~/.config/puritty/config.toml`.
Every key may be left out, and a key the file does not know is refused, so
that a misspelt one is not a setting silently left at its default:

    [window]
    columns = 80
    rows = 24
    title = "puritty"

    [font]
    family = "DejaVu Sans Mono"   # as fontconfig names it
    size = 11                     # points
    language = "ja"               # what fallback fonts are asked for (V25);
                                  # the locale's when left out
    glyph_cache_mb = 8            # the X server's glyph set (V37), 4 or more

    [colours]
    foreground = "#c5c8c6"
    background = "#1d1f21"
    bold_is_bright = false
    palette = ["#1d1f21", "#cc6666"]
                                  # the 16 named colours from 0, as many as
                                  # given; libghostty-vt's for the rest

    [cursor]
    blink_ms = 500                # the half of a blink; 0 does not blink

    [frames]
    every_ms = 16                 # output is drawn at most this often (V31)
    sync_timeout_ms = 150         # how long mode 2026 may hold a frame back

    [scrollback]
    lines = 25000                 # in bytes, as many as so many full lines take

    [program]
    command = ["htop"]            # what runs; $SHELL when left out

    [selection]
    word_boundaries = " \t'\"│`|:;,()[]{}<>$"
                                  # the characters that end a word for a
                                  # double click (docs/user/copy-and-paste.md);
                                  # these are the default, Ghostty's

    [mouse]
    paste_button = "middle"       # or "right": the button that pastes the
                                  # selection (docs/user/copy-and-paste.md)

    [clipboard]
    osc52_read = "deny"           # or "allow": whether a program may read the
                                  # clipboard with OSC 52 (the same guide)

-}

import Bitwise
import Dict exposing (Dict)
import Toml.Decode as Decode exposing (Decoder)
import Toml.Table


type alias Config =
    { columns : Int
    , rows : Int
    , title : String
    , font : String
    , points : Int
    , language : Maybe String
    , glyphCacheMb : Int
    , foreground : Int
    , background : Int
    , boldIsBright : Bool
    , palette : Array Int
    , blinkMs : Int
    , frameMs : Int
    , syncTimeoutMs : Int
    , scrollbackLines : Int
    , command : Array String
    , charset : Maybe String
    , wordBoundaries : String
    , pasteButton : Int
    , osc52Read : Bool
    }


defaults : Config
defaults =
    { columns = 80
    , rows = 24
    , title = "puritty"
    , font = "DejaVu Sans Mono"
    , points = 11
    , language = Nothing
    , glyphCacheMb = 8
    , foreground = 0xC5C8C6
    , background = 0x1D1F21
    , boldIsBright = False
    , palette = []
    , blinkMs = 500
    , frameMs = 16
    , syncTimeoutMs = 150
    , scrollbackLines = 25000
    , command = []
    , charset = Nothing
    , wordBoundaries = "\t '\"│`|:;,()[]{}<>$"
    , pasteButton = 3
    , osc52Read = False
    }


{-| The settings a file gives, each left out its default's. -}
decode : String -> Result String Config
decode text =
    Decode.fromString decoder text
        |> Result.mapError Decode.errorToString


decoder : Decoder Config
decoder =
    Decode.succeed
        (\{} window font colours cursor frames scrollback program terminal selection mouse clipboard ->
            { columns = window.columns
            , rows = window.rows
            , title = window.title
            , font = font.family
            , points = font.size
            , language = font.language
            , glyphCacheMb = font.glyphCacheMb
            , foreground = colours.foreground
            , background = colours.background
            , boldIsBright = colours.boldIsBright
            , palette = colours.palette
            , blinkMs = cursor
            , frameMs = frames.everyMs
            , syncTimeoutMs = frames.syncTimeoutMs
            , scrollbackLines = scrollback
            , command = program
            , charset = terminal
            , wordBoundaries = selection
            , pasteButton = mouse
            , osc52Read = clipboard
            }
        )
        |> Decode.andMap (onlyKeys [ "window", "font", "colours", "cursor", "frames", "scrollback", "program", "terminal", "selection", "mouse", "clipboard" ])
        |> Decode.andMap
            (section "window"
                { columns = defaults.columns, rows = defaults.rows, title = defaults.title }
                (Decode.succeed (\{} c r t -> { columns = c, rows = r, title = t })
                    |> Decode.andMap (onlyKeys [ "columns", "rows", "title" ])
                    |> Decode.andMap (setting "columns" (bounded 2 1000 Decode.int) defaults.columns)
                    |> Decode.andMap (setting "rows" (bounded 1 1000 Decode.int) defaults.rows)
                    |> Decode.andMap (setting "title" Decode.string defaults.title)
                )
            )
        |> Decode.andMap
            (section "font"
                { family = defaults.font, size = defaults.points, language = defaults.language, glyphCacheMb = defaults.glyphCacheMb }
                (Decode.succeed (\{} f s l g -> { family = f, size = s, language = l, glyphCacheMb = g })
                    |> Decode.andMap (onlyKeys [ "family", "size", "language", "glyph_cache_mb" ])
                    |> Decode.andMap (setting "family" Decode.string defaults.font)
                    |> Decode.andMap (setting "size" (bounded 4 200 Decode.int) defaults.points)
                    |> Decode.andMap (Decode.optionalField "language" Decode.string)
                    -- A screen of new ideographs is some 2.7 MB of glyphs:
                    -- under a cap below that every frame uploads its
                    -- glyphs again (renderer.md §R9).
                    |> Decode.andMap (setting "glyph_cache_mb" (bounded 4 1024 Decode.int) defaults.glyphCacheMb)
                )
            )
        |> Decode.andMap
            (section "colours"
                { foreground = defaults.foreground, background = defaults.background, boldIsBright = defaults.boldIsBright, palette = defaults.palette }
                (Decode.succeed (\{} f b bb p -> { foreground = f, background = b, boldIsBright = bb, palette = p })
                    |> Decode.andMap (onlyKeys [ "foreground", "background", "bold_is_bright", "palette" ])
                    |> Decode.andMap (setting "foreground" colour defaults.foreground)
                    |> Decode.andMap (setting "background" colour defaults.background)
                    |> Decode.andMap (setting "bold_is_bright" Decode.bool defaults.boldIsBright)
                    -- docs/phase3-select.md §22: the 16 named colours, from 0
                    |> Decode.andMap (setting "palette" palette defaults.palette)
                )
            )
        |> Decode.andMap
            (section "cursor"
                defaults.blinkMs
                (Decode.succeed (\{} b -> b)
                    |> Decode.andMap (onlyKeys [ "blink_ms" ])
                    |> Decode.andMap (setting "blink_ms" (bounded 0 10000 Decode.int) defaults.blinkMs)
                )
            )
        |> Decode.andMap
            (section "frames"
                { everyMs = defaults.frameMs, syncTimeoutMs = defaults.syncTimeoutMs }
                (Decode.succeed (\{} e s -> { everyMs = e, syncTimeoutMs = s })
                    |> Decode.andMap (onlyKeys [ "every_ms", "sync_timeout_ms" ])
                    |> Decode.andMap (setting "every_ms" (bounded 1 1000 Decode.int) defaults.frameMs)
                    |> Decode.andMap (setting "sync_timeout_ms" (bounded 0 10000 Decode.int) defaults.syncTimeoutMs)
                )
            )
        |> Decode.andMap
            (section "scrollback"
                defaults.scrollbackLines
                (Decode.succeed (\{} l -> l)
                    |> Decode.andMap (onlyKeys [ "lines" ])
                    |> Decode.andMap (setting "lines" (bounded 0 10000000 Decode.int) defaults.scrollbackLines)
                )
            )
        |> Decode.andMap
            (section "program"
                defaults.command
                (Decode.succeed (\{} c -> c)
                    |> Decode.andMap (onlyKeys [ "command" ])
                    |> Decode.andMap (setting "command" (Decode.array Decode.string) defaults.command)
                )
            )
        |> Decode.andMap
            (section "terminal"
                defaults.charset
                (Decode.succeed (\{} c -> c)
                    |> Decode.andMap (onlyKeys [ "charset" ])
                    -- the remote character set (cjk-and-thai.md §10.3): what
                    -- the program reads and writes; the locale's when left out
                    |> Decode.andMap (Decode.optionalField "charset" charsetName)
                )
            )
        |> Decode.andMap
            (section "selection"
                defaults.wordBoundaries
                (Decode.succeed (\{} w -> w)
                    |> Decode.andMap (onlyKeys [ "word_boundaries" ])
                    -- docs/phase3-select.md §14: Gilbert asked for it to be
                    -- the user's; null (U+0000) is always one
                    |> Decode.andMap (setting "word_boundaries" Decode.string defaults.wordBoundaries)
                )
            )
        |> Decode.andMap
            (section "mouse"
                defaults.pasteButton
                (Decode.succeed (\{} b -> b)
                    |> Decode.andMap (onlyKeys [ "paste_button" ])
                    -- Gilbert (docs/phase3-select.md §15): the user chooses
                    -- the middle button, as xterm, or the right, as PuTTY;
                    -- in Ghostty's numbering, middle 3 and right 2
                    |> Decode.andMap (setting "paste_button" pasteButton defaults.pasteButton)
                )
            )
        |> Decode.andMap
            (section "clipboard"
                defaults.osc52Read
                (Decode.succeed (\{} r -> r)
                    |> Decode.andMap (onlyKeys [ "osc52_read" ])
                    -- docs/phase3-select.md §11: refused unless allowed, and
                    -- never asked about
                    |> Decode.andMap (setting "osc52_read" allowDeny defaults.osc52Read)
                )
            )


allowDeny : Decoder Bool
allowDeny =
    Decode.string
        |> Decode.andThen
            (\name ->
                if name == "allow" then
                    Decode.succeed True

                else if name == "deny" then
                    Decode.succeed False

                else
                    Decode.fail ("\"" ++ name ++ "\" is not allow or deny")
            )


pasteButton : Decoder Int
pasteButton =
    Decode.string
        |> Decode.andThen
            (\name ->
                if name == "middle" then
                    Decode.succeed 3

                else if name == "right" then
                    Decode.succeed 2

                else
                    Decode.fail ("\"" ++ name ++ "\" is not middle or right")
            )


charsetName : Decoder String
charsetName =
    Decode.string
        |> Decode.andThen
            (\name ->
                if Array.member name [ "utf-8", "euc-kr", "cp949" ] then
                    Decode.succeed name

                else
                    Decode.fail ("\"" ++ name ++ "\" is not utf-8, euc-kr or cp949")
            )


{-| The remote character set a local program uses, from the locale's
codeset (`ko_KR.euckr`, `ko_KR.EUC-KR`, `ko_KR.CP949`, `ko_KR.UHC`):
`euc-kr`, `cp949`, else `utf-8` (`cjk-and-thai.md` §10.3 rule 1). -}
charsetOf : Dict String String -> String
charsetOf vars =
    let
        locale =
            [ "LC_ALL", "LC_CTYPE", "LANG" ]
                |> Array.mapAndKeepJust (\name -> Dict.get name vars)
                |> Array.findFirst (\v -> v /= "")
                |> Maybe.map .value
                |> Maybe.withDefault ""

        codeset =
            String.split "." locale
                |> Array.get 1
                |> Maybe.withDefault ""
                |> String.split "@"
                |> Array.first
                |> Maybe.withDefault ""
                |> String.toLower
                |> String.replace "-" ""
                |> String.replace "_" ""
    in
    if codeset == "euckr" then
        "euc-kr"

    else if codeset == "cp949" || codeset == "uhc" then
        "cp949"

    else
        "utf-8"


{-| A table of the file, or the defaults when it is left out. -}
section : String -> a -> Decoder a -> Decoder a
section name fallback inner =
    Decode.optionalField name inner |> Decode.map (Maybe.withDefault fallback)


setting : String -> Decoder a -> a -> Decoder a
setting name inner fallback =
    Decode.optionalField name inner |> Decode.map (Maybe.withDefault fallback)


bounded : Int -> Int -> Decoder Int -> Decoder Int
bounded low high inner =
    inner
        |> Decode.andThen
            (\n ->
                if n < low || n > high then
                    Decode.fail (String.fromInt n ++ " is not from " ++ String.fromInt low ++ " to " ++ String.fromInt high)

                else
                    Decode.succeed n
            )


{-| Up to 16 colours, the named ones from 0. -}
palette : Decoder (Array Int)
palette =
    Decode.array colour
        |> Decode.andThen
            (\colours ->
                if Array.length colours > 16 then
                    Decode.fail (String.fromInt (Array.length colours) ++ " colours, where the palette has 16")

                else
                    Decode.succeed colours
            )


{-| A colour as `#rrggbb`. -}
colour : Decoder Int
colour =
    Decode.string
        |> Decode.andThen
            (\text ->
                let
                    digits =
                        String.dropFirst 1 text

                    value =
                        String.foldl
                            (\c acc ->
                                Maybe.andThen
                                    (\v ->
                                        Maybe.map (\d -> v * 16 + d) (hexDigit c)
                                    )
                                    acc
                            )
                            (Just 0)
                            digits
                in
                when value is
                    Just v ->
                        if String.startsWith "#" text && String.count digits == 6 then
                            Decode.succeed v

                        else
                            Decode.fail ("\"" ++ text ++ "\" is not a colour as #rrggbb")

                    Nothing ->
                        Decode.fail ("\"" ++ text ++ "\" is not a colour as #rrggbb")
            )


hexDigit : Char -> Maybe Int
hexDigit c =
    let
        code =
            Char.toCode c
    in
    if code >= 48 && code <= 57 then
        Just (code - 48)

    else if code >= 97 && code <= 102 then
        Just (code - 87)

    else if code >= 65 && code <= 70 then
        Just (code - 55)

    else
        Nothing


{-| Refuse a key a table does not have, naming it, as the compiler's own
manifest does. -}
onlyKeys : Array String -> Decoder {}
onlyKeys allowed =
    Decode.table
        |> Decode.andThen
            (\table ->
                when Array.findFirst (\key -> not (Array.member key allowed)) (Toml.Table.keys table) is
                    Just { value = key } ->
                        Decode.fail ("\"" ++ key ++ "\" is not a key here; the keys are " ++ String.join ", " allowed)

                    Nothing ->
                        Decode.succeed {}
            )


{-| The language fallback fonts are asked for when the file names none
(V25): the locale's, from `LC_ALL`, `LC_CTYPE` or `LANG` in that order,
as fontconfig names a language (`ja`, `ko`, `zh-tw`); none for `C` and
`POSIX`. -}
languageOf : Dict String String -> String
languageOf vars =
    let
        locale =
            [ "LC_ALL", "LC_CTYPE", "LANG" ]
                |> Array.mapAndKeepJust (\name -> Dict.get name vars)
                |> Array.findFirst (\v -> v /= "")
                |> Maybe.map .value
                |> Maybe.withDefault ""

        base =
            locale
                |> String.split "."
                |> Array.first
                |> Maybe.withDefault ""
                |> String.split "@"
                |> Array.first
                |> Maybe.withDefault ""

        parts =
            String.split "_" base
    in
    when parts is
        [ lang, region ] ->
            if lang == "zh" then
                "zh-" ++ String.toLower region

            else
                String.toLower lang

        [ lang ] ->
            if lang == "C" || lang == "POSIX" then
                ""

            else
                String.toLower lang

        _ ->
            ""
