module Config exposing (Config, Host, bellSound, defaults, host)

{-| puritty's settings (`docs/renderer.md` §R10), read from
`$XDG_CONFIG_HOME/puritty/config.toml`, or `~/.config/puritty/config.toml`,
and on Windows `%APPDATA%\puritty\config.toml` (`Platform`).

The record and its defaults. Every setting, its key in the file, its
bounds and what it means, is `Schema`'s table, which decodes the file and
whose `example` shows every key.
-}

import Platform


type alias Config =
    { columns : Int
    , rows : Int
    , title : String
    , font : String
    , points : Int
    , language : Maybe String
    , glyphCacheMb : Int
    , ligatures : Bool
    , foreground : Int
    , background : Int
    , scheme : String
    , boldIsBright : Bool
    , palette : Array Int
    , blinkMs : Int
    , frameMs : Int
    , syncTimeoutMs : Int
    , scrollbackLines : Int
    , command : Array String
    , charset : Maybe String
    , wordBoundaries : String
    , pasteButton : Int
    , copyToClipboard : Bool
    , tmuxTabs : String
    , tmuxLook : String
    , tabsBar : String
    , tabsLook : String
    -- the bell's sound and the key sounds (docs/sounds.md SN6)
    , soundBell : String
    , soundKeys : Bool
    , tabsMiddleCloses : Bool
    , tabsAskBeforeClosing : Bool
    , tabsRestore : Bool
    , debugLog : Bool
    , keyMarkLog : String
    , keyNewTab : String
    , keyCloseTab : String
    , keyRenameTab : String
    , keyColorTab : String
    , keyReopenTab : String
    , keyNextTab : String
    , keyPreviousTab : String
    , keyNextTabAlways : String
    , keyPreviousTabAlways : String
    , keyMoveTabRight : String
    , keyMoveTabLeft : String
    , keyCopy : String
    , keyPaste : String
    , keyPasteSelection : String
    , keySearch : String
    , keySettings : String
    , osc52Read : Bool
    , start : String
    , hosts : Array Host
    , remote : Maybe Host
    , hostName : Maybe String
    }


{-| A host (`docs/settings.md` ST10, V61-V62): a named way to start an ssh
session, its `[hosts."name"]` table. `host` is where to connect; the rest
are left out unless given: the user, the port, the key, a jump host (a
host's name, or `user@host:port`), a command run there; and what the
session's window takes over the settings: its colors, font and size, its
charset and its title; and which client connects, `"openssh"` (OpenSSH's
`ssh` on the terminal) or `"built-in"` (`docs/ssh-client.md` SC18),
OpenSSH's when unset until the built-in one is Windows' default (SC12
question 6). `remote` is set on the config of a window whose session is
the built-in client's, to the host it goes to; `hostName` on the config of
any host's window, whichever client, to the host's name, so that its tabs
take the host's tab color (`docs/tabs.md` TB9). `tab` is that color. -}
type alias Host =
    { name : String
    , host : String
    , user : Maybe String
    , port : Maybe Int
    , identity : Maybe String
    , jump : Maybe String
    , command : Maybe String
    , foreground : Maybe Int
    , background : Maybe Int
    , tab : Maybe Int
    , palette : Maybe (Array Int)
    , font : Maybe String
    , points : Maybe Int
    , charset : Maybe String
    , title : Maybe String
    , client : Maybe String
    }


{-| A host of this name with nothing but its name and where it is. -}
host : String -> String -> Host
host name address =
    { name = name
    , host = address
    , user = Nothing
    , port = Nothing
    , identity = Nothing
    , jump = Nothing
    , command = Nothing
    , foreground = Nothing
    , background = Nothing
    , tab = Nothing
    , palette = Nothing
    , font = Nothing
    , points = Nothing
    , charset = Nothing
    , title = Nothing
    , client = Nothing
    }


defaults : Config
defaults =
    { columns = 80
    , rows = 24
    , title = "puritty"
    , font = Platform.font
    , points = 11
    , language = Nothing
    , glyphCacheMb = 8
    , ligatures = True
    , foreground = 0xC5C8C6
    , background = 0x1D1F21
    , scheme = "puritty"
    , boldIsBright = False
    , palette = []
    , blinkMs = 500
    , frameMs = 16
    , syncTimeoutMs = 150
    , scrollbackLines = 25000
    , command = []
    , charset = Nothing
    , wordBoundaries = "\t '\"│`|:;,()[]{}<>$"
    , pasteButton = 3
    , copyToClipboard = Platform.copyToClipboard
    , tmuxTabs = "bottom"
    , tmuxLook = "puritty"
    , tabsBar = "auto"
    , tabsLook = "puritty"
    , soundBell = "none"
    , soundKeys = False
    , tabsMiddleCloses = True
    , tabsAskBeforeClosing = True
    , tabsRestore = False
    , debugLog = False
    , keyMarkLog = "Ctrl+Alt+Shift+M"
    , keyNewTab = "Ctrl+Shift+T"
    , keyCloseTab = "Ctrl+Shift+W"
    , keyRenameTab = "Ctrl+Shift+R"
    , keyColorTab = ""
    , keyReopenTab = "Ctrl+Alt+Shift+T"
    , keyNextTab = "Ctrl+PageDown"
    , keyPreviousTab = "Ctrl+PageUp"
    , keyNextTabAlways = "Ctrl+Alt+PageDown"
    , keyPreviousTabAlways = "Ctrl+Alt+PageUp"
    , keyMoveTabRight = "Ctrl+Shift+PageDown"
    , keyMoveTabLeft = "Ctrl+Shift+PageUp"
    , keyCopy = "Ctrl+Shift+C"
    , keyPaste = "Ctrl+Shift+V"
    , keyPasteSelection = "Shift+Insert"
    , keySearch = "Ctrl+Shift+F"
    , keySettings = "Ctrl+Comma"
    , osc52Read = False
    , start = Platform.start
    , hosts = []
    , remote = Nothing
    , hostName = Nothing
    }


{-| `[sound] bell`'s sound for `Window.sound`: -1 the system's own, the
bells from 2 in `make-bells.sh`'s order; none for `none`. The terminal
rings it, and the settings window plays it as it is chosen
(`docs/sounds.md` SN7). -}
bellSound : String -> Maybe Int
bellSound name =
    when name is
        "system" ->
            Just -1

        "apple2" ->
            Just 2

        "ibm-pc" ->
            Just 3

        "atari-st" ->
            Just 4

        "bbc-micro" ->
            Just 5

        "x11" ->
            Just 6

        _ ->
            Nothing
