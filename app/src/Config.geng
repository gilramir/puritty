module Config exposing (Config, defaults)

{-| puritty's settings (`docs/renderer.md` §R10), read from
`$XDG_CONFIG_HOME/puritty/config.toml`, or `~/.config/puritty/config.toml`,
and on Windows `%APPDATA%\puritty\config.toml` (`Platform`).

The record and its defaults. Every setting, its key in the file, its
bounds and what it means, is `Schema`'s table, which decodes the file and
whose `example` shows every key.
-}

import Platform


type alias Config =
    { columns : Int
    , rows : Int
    , title : String
    , font : String
    , points : Int
    , language : Maybe String
    , glyphCacheMb : Int
    , foreground : Int
    , background : Int
    , boldIsBright : Bool
    , palette : Array Int
    , blinkMs : Int
    , frameMs : Int
    , syncTimeoutMs : Int
    , scrollbackLines : Int
    , command : Array String
    , charset : Maybe String
    , wordBoundaries : String
    , pasteButton : Int
    , osc52Read : Bool
    }


defaults : Config
defaults =
    { columns = 80
    , rows = 24
    , title = "puritty"
    , font = Platform.font
    , points = 11
    , language = Nothing
    , glyphCacheMb = 8
    , foreground = 0xC5C8C6
    , background = 0x1D1F21
    , boldIsBright = False
    , palette = []
    , blinkMs = 500
    , frameMs = 16
    , syncTimeoutMs = 150
    , scrollbackLines = 25000
    , command = []
    , charset = Nothing
    , wordBoundaries = "\t '\"│`|:;,()[]{}<>$"
    , pasteButton = 3
    , osc52Read = False
    }
