    ]


names : Array String
names =
    Array.map .name all


find : String -> Maybe Scheme
find name =
    Array.findFirst (\s -> s.name == name) all |> Maybe.map .value


{-| A config with a scheme's colors, or as it is for a name puritty does
not have (the setting's own check reports it). -}
apply : String -> Config -> Config
apply name c =
    when find name is
        Just s ->
            { c | scheme = name, foreground = s.foreground, background = s.background, palette = s.palette }

        Nothing ->
            meant Reason.NotKnown c
