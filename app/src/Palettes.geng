      , background = 0x000000
      , palette = [ 0x000000, 0xA87400, 0xBF8400, 0xD19100, 0xA87400, 0xBF8400, 0xE09B00, 0xF0A600, 0x5C3F00, 0xFFB000, 0xFFBA1F, 0xFFC33D, 0xFFB000, 0xFFBA1F, 0xFFC33D, 0xFFDD88 ]
