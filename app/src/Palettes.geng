module Palettes exposing (Scheme, all, apply, find, names)

{-| Color schemes built in (`docs/settings.md` ST29), each a foreground,
a background and the 16 named colors, copied from the terminal named:
from its own source where puritty has it (Ghostty, Alacritty, PuTTY and
Windows Terminal are vendored for the surveys; xterm's from its
`XTerm-color` app-defaults in its nixpkgs package). `[colors] scheme`
picks one; a `foreground`, `background` or `palette` written beside it
wins over it.
-}

import Config exposing (Config)
import Reason


type alias Scheme =
    { name : String
    , label : String
    , foreground : Int
    , background : Int
    , palette : Array Int
    }


all : Array Scheme
all =
    [ -- puritty's own: Ghostty's 16 colors on the Tomorrow Night foreground and background
      { name = "puritty"
      , label = "puritty"
      , foreground = 0xC5C8C6
