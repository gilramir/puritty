module Chooser exposing (Chooser, Outcome(..), dialog, key, received, refused, start)

{-| The folder on the host files dropped are to go to, chosen in a box
(`docs/sftp.md` FT6, FT24): for an ssh tab without `tmux -CC`, and for a
pane whose folder tmux can't say. It lists the host's folders over SFTP,
on a channel of its own, as the transfer that follows uses one.

The box shows the folder listed, in its field, and its folders under it.
Up and Down choose one (`..` first), which puts its path in the field;
Enter goes to the path in the field, and Enter on the folder listed
chooses it; a path can be typed, `~` or a relative one read by the host
(`realpath`); Esc cancels.

Pure, as `Ssh.Transfer` is: told the channel's bytes and the keys, it
answers bytes to send and what came of a key. Names are the host's bytes;
the caller says how its character set reads and writes them.
-}

import Bytes exposing (Bytes)
import Dialog
import Dict exposing (Dict)
import Reason
import Ssh.Sftp as Sftp exposing (Request(..), Response(..))
import TextEdit


type alias Chooser =
    { client : Sftp.Client
    , ready : Bool
    -- where to begin, before the server is ready
    , at : Bytes
    -- the folder listed, its real path, and its folders' names, sorted
    , folder : Maybe Bytes
    , folders : Array Bytes
    -- the row chosen: -1 none (the field is what was typed, or the folder
    -- listed), 0 `..`, 1 on the folders
    , selected : Int
    , edit : TextEdit.Edit
    , waiting : Dict Int Want
    -- a folder being read: its path, its handle, and its folders so far
    -- and the links in it whose `stat` is still to come, and whether its
    -- end has (FT30: a link to a folder is listed too)
    , reading : Maybe { path : Bytes, handle : Maybe Bytes, found : Array Bytes, links : Int, ended : Bool }
    , problem : Maybe String
    , files : Array Bytes
    }


type Want
    = Real
    | Opened Bytes
    | Listed
    | LinkStat Bytes
    | Closed


{-| What a key came to. -}
type Outcome
    = Stay
    | Chosen Bytes
    | Cancelled


{-| A chooser begun for `files`, at `at` (the host's home when empty):
its first bytes are SFTP's `INIT`, for the channel the caller opened. -}
start : { files : Array Bytes, at : Bytes } -> { chooser : Chooser, send : Bytes }
start s =
    let
        begun =
            Sftp.start
    in
    { chooser =
        { client = begun.client
        , ready = False
        , at =
            if Bytes.isEmpty s.at then
                Bytes.fromString "."

            else
                s.at
        , folder = Nothing
        , folders = []
        , selected = -1
        , edit = { chars = [], caret = 0, anchor = 0 }
        , waiting = Dict.empty
        , reading = Nothing
        , problem = Nothing
        , files = s.files
        }
    , send = begun.send
    }


ask : Request -> Want -> { chooser : Chooser, send : Array Bytes } -> { chooser : Chooser, send : Array Bytes }
ask r want acc =
    let
        c =
            acc.chooser

        q =
            Sftp.request r c.client
    in
    { chooser = { c | client = q.client, waiting = Dict.set q.id want c.waiting }, send = Array.pushLast q.send acc.send }


done : { chooser : Chooser, send : Array Bytes } -> { chooser : Chooser, send : Bytes }
done acc =
    { chooser = acc.chooser, send = Bytes.flatten acc.send }


{-| The channel was refused: SFTP is off on the host. -}
refused : String -> Chooser -> Chooser
refused why c =
    { c | problem = Just ("SFTP is turned off on this host, and the folders are read with it: " ++ why) }


{-| The channel's bytes. -}
received : Bytes -> Chooser -> { chooser : Chooser, send : Bytes }
received bytes c0 =
    let
        got =
            Sftp.received bytes c0.client
    in
    Array.foldl onEvent { chooser = { c0 | client = got.client }, send = [] } got.events
        |> done


onEvent : Sftp.Event -> { chooser : Chooser, send : Array Bytes } -> { chooser : Chooser, send : Array Bytes }
onEvent e acc =
    let
        c =
            acc.chooser
    in
    when e is
        Sftp.Ready _ ->
            goTo c.at { acc | chooser = { c | ready = True } }

        Sftp.Broken why ->
            { acc | chooser = { c | problem = Just ("the host's SFTP answered what is not SFTP: " ++ why), reading = Nothing } }

        Sftp.Answer a ->
            when Dict.get a.id c.waiting is
                Just want ->
                    answered want a.response { acc | chooser = { c | waiting = Dict.remove a.id c.waiting } }

                Nothing ->
                    meant Reason.NotKnown acc


{-| A path read by the host, then listed. -}
goTo : Bytes -> { chooser : Chooser, send : Array Bytes } -> { chooser : Chooser, send : Array Bytes }
goTo path acc =
    let
        c =
            acc.chooser
    in
    ask (RealPath path) Real { acc | chooser = { c | problem = Nothing } }


answered : Want -> Response -> { chooser : Chooser, send : Array Bytes } -> { chooser : Chooser, send : Array Bytes }
answered want response acc =
    let
        c =
            acc.chooser
    in
    when { want = want, response = response } is
        { want = Real, response = Names names } ->
            when Array.first names is
                Just n ->
                    ask (OpenDir n.name) (Opened n.name) { acc | chooser = { c | reading = Just { path = n.name, handle = Nothing, found = [], links = 0, ended = False } } }

                Nothing ->
                    meant Reason.FromOutside { acc | chooser = { c | problem = Just "the host gave no path" } }

        { want = Opened _, response = Handle h } ->
            when c.reading is
                Just r ->
                    ask (ReadDir h) Listed { acc | chooser = { c | reading = Just { r | handle = Just h } } }

                Nothing ->
                    meant Reason.NotOpen acc

        { want = Listed, response = Names entries } ->
            when c.reading is
                Just r ->
                    let
                        found =
                            Array.keepIf isFolder entries |> Array.map .name

                        links =
                            Array.keepIf isLink entries |> Array.map .name

                        -- each link's `stat`, which follows it
                        asked =
                            Array.foldl (\name inner -> ask (Stat (under r.path name)) (LinkStat name) inner)
                                { acc | chooser = { c | reading = Just { r | found = r.found ++ found, links = r.links + Array.length links } } }
                                links
                    in
                    when r.handle is
                        Just h ->
                            ask (ReadDir h) Listed asked

                        Nothing ->
                            meant Reason.NotOpen acc

                Nothing ->
                    meant Reason.NotOpen acc

        { want = LinkStat name, response = _ } ->
            -- a link's `stat`: listed when it leads to a folder; a link
            -- that leads nowhere answers a status, and is not
            when c.reading is
                Just r ->
                    let
                        folder =
                            when response is
                                Attributes a ->
                                    Maybe.map (\mode -> modBy 65536 mode // 4096 == 4) a.permissions == Just True

                                _ ->
                                    False

                        next =
                            { r
                                | links = r.links - 1
                                , found =
                                    if folder then
                                        Array.pushLast name r.found

                                    else
                                        r.found
                            }
                    in
                    if next.ended && next.links <= 0 then
                        { acc | chooser = listed next c }

                    else
                        { acc | chooser = { c | reading = Just next } }

                Nothing ->
                    meant Reason.NotOpen acc

        { want = Listed, response = Status s } ->
            -- the end of the folder (EOF, 1), or a failure reading it
            when c.reading is
                Just r ->
                    let
                        closed =
                            when r.handle is
                                Just h ->
                                    ask (Close h) Closed acc

                                Nothing ->
                                    meant Reason.NotOpen acc

                        cc =
                            closed.chooser
                    in
                    if s.code == 1 then
                        if r.links <= 0 then
                            { closed | chooser = listed r cc }

                        else
                            -- the links' answers still to come
                            { closed | chooser = { cc | reading = Just { r | ended = True } } }

                    else
                        { closed | chooser = { cc | reading = Nothing, problem = Just (Bytes.toStringLossy r.path ++ ": " ++ s.message) } }

                Nothing ->
                    meant Reason.NotOpen acc

        { want = Closed, response = _ } ->
            acc

        { want = _, response = Status s } ->
            -- a path not there, or not a folder, or not readable: the
            -- server's words, the folder listed before kept
            { acc | chooser = { c | reading = Nothing, problem = Just s.message } }

        _ ->
            { acc | chooser = { c | reading = Nothing, problem = Just "the host answered what was not asked" } }


{-| A folder read to its end, its links' answers in: listed. -}
listed : { path : Bytes, handle : Maybe Bytes, found : Array Bytes, links : Int, ended : Bool } -> Chooser -> Chooser
listed r c =
    { c
        | reading = Nothing
        , folder = Just r.path
        , folders = Array.sortBy sortKey r.found
        , selected = -1
        , edit = { chars = [], caret = 0, anchor = 0 }
    }


{-| A link, as its attributes say (`S_IFLNK`): `stat` says where it leads. -}
isLink : Sftp.Entry -> Bool
isLink e =
    Maybe.map (\mode -> modBy 65536 mode // 4096 == 10) e.attrs.permissions == Just True


{-| A folder, as its attributes say: not `.` or `..`. A link to one is
found by `isLink` and its `stat`. -}
isFolder : Sftp.Entry -> Bool
isFolder e =
    e.name /= Bytes.fromString "." && e.name /= Bytes.fromString ".." && Maybe.map (\mode -> modBy 65536 mode // 4096 == 4) e.attrs.permissions == Just True


{-| Folders in the order a person reads them: hidden ones (`.name`) last,
the rest by name, letters' case not counted. -}
sortKey : Bytes -> String
sortKey name =
    let
        text =
            String.toLower (Bytes.toStringLossy name)
    in
    if String.startsWith "." text then
        "~" ++ text

    else
        text


{-| A folder's path in `parent`. -}
under : Bytes -> Bytes -> Bytes
under parent name =
    if Bytes.get (Bytes.length parent - 1) parent == Bytes.get 0 (Bytes.fromString "/") then
        Bytes.flatten [ parent, name ]

    else
        Bytes.flatten [ parent, Bytes.fromString "/", name ]


{-| A key, with the tab's character set to read names (`decode`) and
write a typed path (`encode`, `Nothing` for a character it has not). -}
key : { sym : Int, mods : Int, text : String } -> { decode : Bytes -> String, encode : String -> Maybe Bytes } -> Chooser -> { chooser : Chooser, send : Bytes, outcome : Outcome }
key k with c =
    let
        stay ch =
            { chooser = ch, send = Bytes.empty, outcome = Stay }

        -- the field's text for a row
        rowPath i =
            when c.folder is
                Just f ->
                    if i == 0 then
                        Just
                            (Bytes.flatten
                                [ f
                                , Bytes.fromString
                                    (if Bytes.get (Bytes.length f - 1) f == Bytes.get 0 (Bytes.fromString "/") then
                                        ".."

                                     else
                                        "/.."
                                    )
                                ]
                            )

                    else
                        Array.get (i - 1) c.folders |> Maybe.map (under f)

                Nothing ->
                    meant Reason.NotYet Nothing

        choose i =
            when rowPath i is
                Just p ->
                    let
                        text =
                            with.decode p
                    in
                    stay { c | selected = i, edit = { chars = String.toArray text, caret = String.count text, anchor = String.count text } }

                Nothing ->
                    meant Reason.NotYet (stay { c | selected = -1 })

        typed =
            String.fromArray c.edit.chars
    in
    if k.sym == 0xFF1B then
        { chooser = c, send = Bytes.empty, outcome = Cancelled }

    else if k.sym == 0xFF52 then
        -- Up
        if c.selected > 0 then
            choose (c.selected - 1)

        else
            stay c

    else if k.sym == 0xFF54 then
        -- Down
        if c.selected < Array.length c.folders then
            choose (c.selected + 1)

        else
            stay c

    else if k.sym == 0xFF0D || k.sym == 0xFF8D then
        if c.reading /= Nothing || not c.ready then
            stay c

        else if typed == "" || Maybe.map with.decode c.folder == Just typed then
            when c.folder is
                Just f ->
                    { chooser = c, send = Bytes.empty, outcome = Chosen f }

                Nothing ->
                    meant Reason.NotYet (stay c)

        else
            when with.encode typed is
                Just path ->
                    let
                        r =
                            done (goTo path { chooser = c, send = [] })
                    in
                    { chooser = r.chooser, send = r.send, outcome = Stay }

                Nothing ->
                    meant Reason.FromOutside (stay { c | problem = Just "the path has characters the host's character set can't write" })

    else
        let
            -- an empty field shows the folder listed: what is typed edits that
            seeded =
                if Array.isEmpty c.edit.chars then
                    when c.folder is
                        Just f ->
                            let
                                text =
                                    with.decode f
                            in
                            { chars = String.toArray text, caret = String.count text, anchor = String.count text }

                        Nothing ->
                            meant Reason.NotYet c.edit

                else
                    c.edit
        in
        when TextEdit.key k seeded is
            TextEdit.Edited e ->
                stay { c | edit = e, selected = -1 }

            TextEdit.Copied x ->
                stay { c | edit = x.edit }

            TextEdit.PasteAsked ->
                stay c

            TextEdit.NotMine ->
                stay c


{-| The box: the files, the folder's folders around the one chosen, the
path in the field. -}
dialog : (Bytes -> String) -> Chooser -> Dialog.Dialog
dialog decode c =
    let
        names =
            Array.map (\p -> lastName (decode p)) c.files

        what =
            if Array.length names == 1 then
                String.join "" names

            else
                String.fromInt (Array.length names) ++ " files and folders"

        shown =
            12

        rows =
            Array.pushFirst ".." (Array.map (\f -> decode f ++ "/") c.folders)

        first =
            -- the chosen row near the middle, the subtraction made only
            -- past it
            clamp 0
                (max 0 (Array.length rows - shown))
                (if c.selected > shown // 2 then
                    c.selected - shown // 2

                 else
                    0
                )

        listing =
            if c.folder == Nothing then
                if c.problem == Nothing then
                    [ "Reading the host's folders…" ]

                else
                    []

            else
                Array.slice first (first + shown) rows
                    |> Array.indexedMap
                        (\i row ->
                            if first + i == c.selected then
                                "▸ " ++ row

                            else
                                "  " ++ row
                        )

        problem =
            when c.problem is
                Just p ->
                    -- in lines the box holds (about 60 characters)
                    Array.pushFirst "" (wrapWords 58 p)

                Nothing ->
                    meant Reason.NotSet []

        text =
            String.fromArray c.edit.chars
    in
    { title = "Send " ++ what ++ " to which folder on the host?"
    , lines = listing ++ problem
    , field =
        Just
            { typed =
                if text == "" then
                    Maybe.map decode c.folder |> Maybe.withDefault (meant Reason.NotYet "")

                else
                    text
            , hidden = False
            , caret =
                if text == "" then
                    String.count (Maybe.map decode c.folder |> Maybe.withDefault (meant Reason.NotYet ""))

                else
                    c.edit.caret
            }
    , swatches = []
    , check = Nothing
    , buttons = [ { label = "Send here", primary = True }, { label = "Cancel", primary = False } ]
    , hint = "↑↓: choose    Enter: open, again: send    Esc: cancel"
    }


lastName : String -> String
lastName path =
    String.split "/" (String.replace "\\" "/" path) |> Array.keepIf (\p -> p /= "") |> Array.last |> Maybe.withDefault (meant Reason.NoMore path)


{-| Words in lines of at most `most` characters; a word longer than that
on a line of its own. -}
wrapWords : Int -> String -> Array String
wrapWords most text =
    String.split " " text
        |> Array.foldl
            (\word lines ->
                when Array.popLast lines is
                    Just l ->
                        if l.last == "" then
                            Array.pushLast word l.initial

                        else if String.count l.last + 1 + String.count word <= most then
                            Array.pushLast (l.last ++ " " ++ word) l.initial

                        else
                            Array.pushLast word lines

                    Nothing ->
                        meant Reason.NoMore [ word ]
            )
            [ "" ]
