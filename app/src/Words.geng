module Words exposing
    ( Lang(..)
    , langOf
    , Words
    , words
    , Message
    , message
    , with
    , plain
    , say
    , lookup
    , english
    , korean
    )

{-| The settings window's words in English and Korean
(`docs/settings-gui.md` SG4, SG7), as gren-i18next's tables: a key's text
in the window's language, else in English, which is American (*color*), as
the file's keys are (`[colors]`). A setting's English is the schema's own (`lookup`), so only its
Korean is here, under `setting.<its key>.label` and `.description`.

What the window says (a check's problem, a host made, a write that failed)
is a `Message`, a key and the values its `{{name}}` placeholders take,
and is put in words only where it is shown, in the language of the window
that shows it.
-}

import I18Next exposing (Delims(..), Translations)


type Lang
    = English
    | Korean


{-| The language a system's language name gives: Korean for one that
starts `ko` (`ko`, `ko-KR`, `ko_KR.UTF-8`), English for any other. -}
langOf : String -> Lang
langOf name =
    if String.startsWith "ko" (String.toLower name) then
        Korean

    else
        English


{-| Something the window says: a table's key and its placeholders' values. -}
type alias Message =
    { key : String
    , values : Array { placeholder : String, replacement : String }
    }


{-| A message with no placeholders. -}
message : String -> Message
message key =
    { key = key, values = [] }


{-| A placeholder's value added to a message. -}
with : String -> String -> Message -> Message
with placeholder replacement m =
    { m | values = Array.pushLast { placeholder = placeholder, replacement = replacement } m.values }


{-| Text said as it is, in every language: a reason the system gave. -}
plain : String -> Message
plain text =
    message "message.plain" |> with "text" text


{-| A message in a language's words, in English where the language has
none for it. -}
say : Lang -> Message -> String
say lang m =
    I18Next.trf (tables lang) Curly m.key m.values


{-| A key's text in a language, or `fallback` (the schema's English) where
the language has none. -}
lookup : Lang -> String -> String -> String
lookup lang key fallback =
    when lang is
        English ->
            fallback

        Korean ->
            if I18Next.hasKey korean key then
                I18Next.t korean key

            else
                fallback


tables : Lang -> Array Translations
tables lang =
    when lang is
        English ->
            [ english ]

        Korean ->
            [ korean, english ]


{-| The window's own words. -}
type alias Words =
    { search : String
    , modifiedOnly : String
    , newWindows : String
    , noMatch : String
    , nothingModified : String
    , quickConnect : String
    , quickConnectHint : String
    , quickConnectDescription : String
    , newHost : String
    , newHostDescription : String
    , systemDefault : String
    , systemShell : String
    , defaults : String
    , ofSixteen : String
    , on : String
    , off : String
    , noFont : String
    , monospaced : String
    , sample : String
    , reset : String
    , title : String
    , hostsTitle : String
    , hintTyping : String
    , hintQuick : String
    , hintFont : String
    , hintSearch : String
    , hintPages : String
    , hintRows : String
    , hintHosts : String
    , hintHostList : String
    , hintHostListHere : String
    }


words : Lang -> Words
words lang =
    { search = say lang (message "window.search")
    , modifiedOnly = say lang (message "window.modifiedOnly")
    , newWindows = say lang (message "window.newWindows")
    , noMatch = say lang (message "window.noMatch")
    , nothingModified = say lang (message "window.nothingModified")
    , quickConnect = say lang (message "window.quickConnect")
    , quickConnectHint = say lang (message "window.quickConnectHint")
    , quickConnectDescription = say lang (message "window.quickConnectDescription")
    , newHost = say lang (message "window.newHost")
    , newHostDescription = say lang (message "window.newHostDescription")
    , systemDefault = say lang (message "window.systemDefault")
    , systemShell = say lang (message "window.systemShell")
    , defaults = say lang (message "window.defaults")
    , ofSixteen = say lang (message "window.ofSixteen")
    , on = say lang (message "window.on")
    , off = say lang (message "window.off")
    , noFont = say lang (message "window.noFont")
    , monospaced = say lang (message "window.monospaced")
    , sample = say lang (message "window.sample")
    , reset = say lang (message "window.reset")
    , title = say lang (message "window.title")
    , hostsTitle = say lang (message "window.hostsTitle")
    , hintTyping = say lang (message "window.hintTyping")
    , hintQuick = say lang (message "window.hintQuick")
    , hintFont = say lang (message "window.hintFont")
    , hintSearch = say lang (message "window.hintSearch")
    , hintPages = say lang (message "window.hintPages")
    , hintRows = say lang (message "window.hintRows")
    , hintHosts = say lang (message "window.hintHosts")
    , hintHostList = say lang (message "window.hintHostList")
    , hintHostListHere = say lang (message "window.hintHostListHere")
    }


table : Array { key : String, text : String } -> Translations
table entries =
    I18Next.fromTree (Array.map (\e -> { label = e.key, item = I18Next.string e.text }) entries)


