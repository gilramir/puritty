        , { key = "message.hostRemoved", text = "{{name}}을(를) 지웠습니다 · Ctrl+Z로 되돌립니다" }
        , { key = "message.renamed", text = "{{from}}의 이름이 이제 {{to}}입니다" }
        , { key = "message.hostMade", text = "{{name}}을(를) 만들었습니다. 연결할 곳을 입력하세요" }
        , { key = "message.notAnAddress", text = "\"{{text}}\"은(는) 사용자@호스트:포트 형식의 연결할 곳이 아닙니다" }
        , { key = "message.noFile", text = "쓸 설정 파일이 없습니다" }
        , { key = "message.notWritten", text = "쓰지 못했습니다: {{why}}" }
        , { key = "message.notStarted", text = "시작하지 못했습니다: {{why}}" }
        , { key = "message.noExecutable", text = "이 프로그램의 파일을 알 수 없어 창을 열 수 없습니다" }
        , { key = "problem.outOfRange", text = "{{n}}은(는) {{low}}부터 {{high}}까지의 값이 아닙니다" }
        , { key = "problem.notWhole", text = "정수가 아닙니다" }
        , { key = "problem.noFont", text = "글꼴 이름이 없습니다" }
        , { key = "problem.notTrueOrFalse", text = "true나 false가 아닙니다" }
        , { key = "problem.tooManyColors", text = "색이 {{n}}개입니다. 팔레트에는 {{most}}개까지입니다" }
        , { key = "problem.notColors", text = "색의 목록이 아닙니다" }
        , { key = "problem.notOneOf", text = "\"{{text}}\"은(는) {{choices}} 중 하나가 아닙니다" }
        , { key = "problem.notCommand", text = "프로그램과 인수의 문자열 목록이 아닙니다" }
        , { key = "problem.addressEmpty", text = "연결할 곳이 비어 있습니다" }
        , { key = "problem.notString", text = "문자열이 아닙니다" }
        , { key = "problem.notColor", text = "\"{{text}}\"은(는) #rrggbb 형식의 색이 아닙니다" }
        , { key = "problem.hostNeedsName", text = "호스트에는 이름이 있어야 합니다" }
        , { key = "problem.whereToConnect", text = "연결할 곳: 이름이나 주소" }
        , { key = "problem.notLaunch", text = "\"{{text}}\"은(는) \"shell\", \"hosts\", 또는 \"host:\"와 호스트 이름이 아닙니다" }
        , { key = "problem.notAChord", text = "\"{{text}}\"은(는) Ctrl+Shift+T나 Ctrl+PageDown 같은 키가 아닙니다. 없애려면 비워 두세요" }
        , { key = "problem.quoteNotClosed", text = "닫히지 않은 따옴표가 있습니다" }
