        , { key = "setting.hosts.*.font.size.label", text = "글꼴 크기" }
        , { key = "setting.window.columns.description", text = "창을 열 때의 너비(칸)." }
        , { key = "setting.window.rows.description", text = "창을 열 때의 높이(줄)." }
        , { key = "setting.window.title.description", text = "프로그램이 제목을 정하지 않았을 때의 창 제목." }
        , { key = "setting.font.family.description", text = "시스템에 있는 글꼴 이름." }
        , { key = "setting.font.size.description", text = "포인트 단위." }
        , { key = "setting.font.language.description", text = "대체 글꼴을 고를 때의 언어로, 한자의 모양을 정합니다(ja, ko, zh-cn, zh-tw). 지정하지 않으면 시스템의 언어." }
        , { key = "setting.font.ligatures.description", text = "글꼴이 잇는 글자를 이어 그립니다. Fira Code는 != 나 .. 를 한 기호로 그립니다. 커서 아래의 칸은 언제나 따로 그립니다." }
        , { key = "setting.font.glyph_cache_mb.description", text = "다시 그리기 전까지 보관하는 글리프의 양." }
        , { key = "setting.colors.foreground.description", text = "색이 지정되지 않은 글자의 색." }
        , { key = "setting.colors.scheme.description", text = "다른 터미널에서 가져온 색: Ghostty, Alacritty, PuTTY, xterm, Windows 터미널. 여기서 정한 전경색, 배경색, 팔레트가 이것보다 우선합니다." }
        , { key = "setting.colors.background.description", text = "색이 지정되지 않은 글자 뒤의 색." }
        , { key = "setting.colors.bold_is_bright.description", text = "처음 여덟 색 중 하나인 굵은 글자를 밝은 색으로 그립니다." }
        , { key = "setting.colors.palette.description", text = "0번부터의 16가지 이름 있는 색. 주지 않은 색은 기본값." }
        , { key = "setting.cursor.blink_ms.description", text = "프로그램이 커서 깜박임을 요청할 때 깜박임 한 번의 절반. 0이면 깜박이지 않습니다." }
        , { key = "setting.frames.every_ms.description", text = "출력을 최대 이 간격으로 그립니다." }
        , { key = "setting.frames.sync_timeout_ms.description", text = "프로그램이 화면을 붙잡아 둘 수 있는 시간(모드 2026)." }
        , { key = "setting.scrollback.lines.description", text = "이만큼의 꽉 찬 줄을 기록으로 보관합니다. 0이면 보관하지 않습니다." }
        , { key = "setting.program.command.description", text = "실행할 프로그램과 인수. 비워 두면 시스템 셸." }
        , { key = "setting.start.description", text = "아무것도 붙이지 않은 `puritty`가 여는 것: \"shell\"은 로컬 셸, \"hosts\"는 호스트 목록, \"host:이름\"은 그 호스트. 기본값은 Windows에서 호스트 목록, Linux에서 셸." }
        , { key = "setting.terminal.charset.description", text = "프로그램이 읽고 쓰는 문자 집합. 지정하지 않으면 로캘의 것." }
        , { key = "setting.selection.word_boundaries.description", text = "더블 클릭할 때 단어를 끝내는 문자들." }
        , { key = "setting.selection.copy_to_clipboard.description", text = "마우스로 선택한 글자를 버튼을 놓을 때 클립보드에 복사합니다. PuTTY처럼. Windows에서는 붙여넣기 버튼과 Shift+Insert가 클립보드를 붙여넣으므로 다른 프로그램에서 복사한 글자도 붙여넣습니다. Windows에서는 기본으로 켜져 있습니다." }
        , { key = "setting.mouse.paste_button.description", text = "선택한 것을 붙여넣는 마우스 버튼." }
        , { key = "setting.tmux.tabs.description", text = "tmux -CC에서 tmux 창의 탭 막대를 놓을 곳: tmux의 상태 줄이 있던 아래, 또는 위." }
        , { key = "setting.tabs.bar.description", text = "puritty 탭 막대를 언제 보일지: 탭이 둘 이상일 때, 또는 항상." }
        , { key = "setting.tabs.look.description", text = "puritty의 둥근 탭과 호박색의 보이는 탭, 또는 대부분의 터미널처럼 네모난 탭과 밝은 보이는 탭." }
        , { key = "setting.tabs.ask_before_closing.description", text = "탭의 셸에서 프로그램이 돌고 있거나 ssh 세션이 열려 있으면 닫기 전에 묻습니다. 쉬고 있는 셸은 바로 닫습니다." }
        , { key = "setting.tabs.restore.description", text = "puritty가 마지막으로 끝날 때 열려 있던 창과 탭을 다시 엽니다: 호스트나 디렉터리, 이름, 색, 순서. 다른 창이 열려 있을 때 닫은 창은 복원하지 않습니다." }
        , { key = "setting.tabs.middle_click_closes.description", text = "탭을 가운데 버튼으로 클릭하면 닫고, 그 안에서 돌던 것을 끝냅니다." }
        , { key = "setting.tmux.look.description", text = "tmux -CC의 프롬프트, 질문, 메시지의 모양: 창 위의 상자에 puritty 모양으로, 또는 tmux가 상태 줄을 그리듯 탭 막대 줄에 tmux 모양으로." }
        , { key = "setting.clipboard.osc52_read.description", text = "프로그램이 OSC 52로 클립보드를 읽을 수 있는지." }
        , { key = "setting.hosts.name.description", text = "목록과 명령줄(puritty --host 이름)에서 쓰는 호스트의 이름." }
        , { key = "setting.hosts.*.host.description", text = "연결할 곳: 이름이나 주소." }
        , { key = "setting.hosts.*.user.description", text = "로그인할 사용자. 지정하지 않으면 ssh가 정합니다." }
        , { key = "setting.hosts.*.port.description", text = "지정하지 않으면 ssh의 기본값인 22." }
        , { key = "setting.hosts.*.identity.description", text = "로그인에 쓸 개인 키 파일. 지정하지 않으면 ssh가 정합니다." }
        , { key = "setting.hosts.*.jump.description", text = "거쳐서 연결할 다른 호스트의 이름, 또는 사용자@호스트:포트." }
        , { key = "setting.hosts.*.command.description", text = "로그인 셸 대신 터미널에서 실행할 명령." }
        , { key = "setting.hosts.*.charset.description", text = "호스트의 문자 집합. 지정하지 않으면 설정의 것." }
        , { key = "setting.hosts.*.title.description", text = "창 제목. 지정하지 않으면 호스트의 이름." }
        , { key = "setting.hosts.*.client.description", text = "연결할 ssh: 터미널의 OpenSSH, 또는 puritty 자체. 지정하지 않으면 Windows에서는 puritty 자체, Linux에서는 OpenSSH." }
        , { key = "setting.hosts.*.colors.foreground.description", text = "설정 대신 쓰는 글자색." }
        , { key = "setting.hosts.*.colors.background.description", text = "설정 대신 쓰는 배경색. 운영 서버에는 붉은 색을 흔히 씁니다." }
        , { key = "setting.hosts.*.colors.tab.description", text = "탭 막대에서 이 호스트 탭의 색. 탭에 따로 색을 주기 전까지 씁니다. 지정하지 않으면 없음." }
        , { key = "setting.hosts.*.colors.palette.description", text = "설정 대신 쓰는 16가지 이름 있는 색." }
        , { key = "setting.hosts.*.font.family.description", text = "설정 대신 쓰는 글꼴." }
        , { key = "setting.hosts.*.font.size.description", text = "설정 대신 쓰는 포인트 크기." }
