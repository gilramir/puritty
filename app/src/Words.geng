module Words exposing
    ( Lang(..)
    , Words
    , description
    , label
    , langOf
    , pageName
    , words
    )

{-| The settings window's words in English and Korean
(`docs/settings-gui.md` SG4). English is the schema's own, in American
spelling (*color*; the file's keys, such as `[colours]`, are the file
format's and keep theirs); Korean is this table's. A setting with no Korean
here shows its English, so a new setting never shows nothing.
-}

import Dict exposing (Dict)
import Schema exposing (Setting)


type Lang
    = English
    | Korean


{-| The language a system's language name gives: Korean for one that
starts `ko` (`ko`, `ko-KR`, `ko_KR.UTF-8`), English for any other. -}
langOf : String -> Lang
langOf name =
    if String.startsWith "ko" (String.toLower name) then
        Korean

    else
        English


{-| The window's own words. -}
type alias Words =
    { search : String
    , modifiedOnly : String
    , newWindows : String
    , noMatch : String
    , nothingModified : String
    , quickConnect : String
    , quickConnectHint : String
    , quickConnectDescription : String
    , newHost : String
    , newHostDescription : String
    , systemDefault : String
    , systemShell : String
    , defaults : String
    , ofSixteen : String
    , on : String
    , off : String
    , noFont : String
    , monospaced : String
    , sample : String
    , reset : String
    , title : String
    , hostsTitle : String
    , hintTyping : String
    , hintFont : String
    , hintSearch : String
    , hintPages : String
    , hintRows : String
    , hintHosts : String
    , hintHostList : String
    , hintHostListHere : String
    }


words : Lang -> Words
words lang =
    when lang is
        English ->
            { search = "Search settings"
            , modifiedOnly = "Modified only"
            , newWindows = "New windows take it."
            , noMatch = "No setting matches."
            , nothingModified = "Nothing here differs from its default."
            , quickConnect = "Quick connect"
            , quickConnectHint = "user@host:port"
            , quickConnectDescription = "Connect without saving a host."
            , newHost = "New host…"
            , newHostDescription = "A host of the settings, named as you type."
            , systemDefault = "The system's"
            , systemShell = "The system's shell"
            , defaults = "The defaults"
            , ofSixteen = "of 16"
            , on = "On"
            , off = "Off"
            , noFont = "No font of the system's has that name."
            , monospaced = "monospaced"
            , sample = "The quick brown fox · 0O 1lI · 한글"
            , reset = "Reset"
            , title = "puritty settings"
            , hostsTitle = "puritty hosts"
            , hintTyping = "Enter keep · Esc as it was"
            , hintFont = "Type to narrow · Up and Down choose · Enter take it · Esc as it was"
            , hintSearch = "Type to search · Down to the settings · Esc clear"
            , hintPages = "Up and Down choose a page · Tab move · Esc close"
            , hintRows = "Enter change · Del reset · Ctrl+Z undo · Ctrl+M modified only · Esc close"
            , hintHosts = "Enter change · Del unset · ← the hosts · Ctrl+D copy · Ctrl+Z undo"
            , hintHostList = "Enter connects in a new window · → change · Del remove · Ctrl+D copy · Esc close"
            , hintHostListHere = "Enter connects here · → change · Del remove · Ctrl+D copy · Esc close"
            }

        Korean ->
            { search = "설정 검색"
            , modifiedOnly = "변경한 것만"
            , newWindows = "새 창부터 적용됩니다."
            , noMatch = "일치하는 설정이 없습니다."
            , nothingModified = "기본값과 다른 설정이 없습니다."
            , quickConnect = "빠른 연결"
            , quickConnectHint = "사용자@호스트:포트"
            , quickConnectDescription = "호스트를 저장하지 않고 연결합니다."
            , newHost = "새 호스트…"
            , newHostDescription = "입력하는 이름으로 새 호스트를 만듭니다."
            , systemDefault = "시스템 기본값"
            , systemShell = "시스템 셸"
            , defaults = "기본값"
            , ofSixteen = "/ 16"
            , on = "켬"
            , off = "끔"
            , noFont = "그런 이름의 글꼴이 시스템에 없습니다."
            , monospaced = "고정폭"
            , sample = "The quick brown fox · 0O 1lI · 한글"
            , reset = "초기화"
            , title = "puritty 설정"
            , hostsTitle = "puritty 호스트"
            , hintTyping = "Enter 적용 · Esc 취소"
            , hintFont = "입력해서 좁히기 · 위아래 선택 · Enter 적용 · Esc 취소"
            , hintSearch = "입력해서 검색 · 아래 화살표로 설정 · Esc 지우기"
            , hintPages = "위아래로 페이지 선택 · Tab 이동 · Esc 닫기"
            , hintRows = "Enter 변경 · Del 초기화 · Ctrl+Z 되돌리기 · Ctrl+M 변경한 것만 · Esc 닫기"
            , hintHosts = "Enter 변경 · Del 지우기 · ← 호스트 목록 · Ctrl+D 복사 · Ctrl+Z 되돌리기"
            , hintHostList = "Enter 새 창으로 연결 · → 변경 · Del 삭제 · Ctrl+D 복사 · Esc 닫기"
            , hintHostListHere = "Enter 이 창에서 연결 · → 변경 · Del 삭제 · Ctrl+D 복사 · Esc 닫기"
            }


pageName : Lang -> Schema.Page -> String
pageName lang page =
    when lang is
        English ->
            Schema.pageName page

        Korean ->
            when page is
                Schema.Appearance ->
                    "모양"

                Schema.WindowPage ->
                    "창"

                Schema.TextAndLanguage ->
                    "텍스트 및 언어"

                Schema.MouseAndSelection ->
                    "마우스 및 선택"

                Schema.Clipboard ->
                    "클립보드"

                Schema.Program ->
                    "프로그램"

                Schema.Advanced ->
                    "고급"

                Schema.HostsPage ->
                    "호스트"


{-| A setting's key as this table knows it: its path joined by dots, a
host's field without the host's name (`hosts.*.user`). -}
keyOf : Setting -> String
keyOf s =
    when s.key is
        [ "hosts", _ ] ->
            "hosts.name"

        [ "hosts", _, field ] ->
            "hosts.*." ++ field

        [ "hosts", _, table, field ] ->
            "hosts.*." ++ table ++ "." ++ field

        _ ->
            String.join "." s.key


label : Lang -> Setting -> String
label lang s =
    when lang is
        English ->
            american s.label

        Korean ->
            Dict.get (keyOf s) korean |> Maybe.map .label |> Maybe.withDefault (american s.label)


description : Lang -> Setting -> String
description lang s =
    when lang is
        English ->
            american s.description

        Korean ->
            Dict.get (keyOf s) korean |> Maybe.map .description |> Maybe.withDefault (american s.description)


{-| The schema's British spelling as American, in what is shown. -}
american : String -> String
american text =
    text
        |> String.replace "colours" "colors"
        |> String.replace "Colours" "Colors"
        |> String.replace "colour" "color"
        |> String.replace "Colour" "Color"


korean : Dict String { label : String, description : String }
korean =
    Dict.empty
        |> Dict.set "window.columns" { label = "열", description = "창을 열 때의 너비(칸)." }
        |> Dict.set "window.rows" { label = "행", description = "창을 열 때의 높이(줄)." }
        |> Dict.set "window.title" { label = "제목", description = "프로그램이 제목을 정하지 않았을 때의 창 제목." }
        |> Dict.set "font.family" { label = "글꼴", description = "시스템에 있는 글꼴 이름." }
        |> Dict.set "font.size" { label = "글꼴 크기", description = "포인트 단위." }
        |> Dict.set "font.language" { label = "대체 글꼴 언어", description = "대체 글꼴을 고를 때의 언어로, 한자의 모양을 정합니다(ja, ko, zh-cn, zh-tw). 지정하지 않으면 시스템의 언어." }
        |> Dict.set "font.glyph_cache_mb" { label = "글리프 캐시", description = "다시 그리기 전까지 보관하는 글리프의 양." }
        |> Dict.set "colours.foreground" { label = "글자색", description = "색이 지정되지 않은 글자의 색." }
        |> Dict.set "colours.background" { label = "배경색", description = "색이 지정되지 않은 글자 뒤의 색." }
        |> Dict.set "colours.bold_is_bright" { label = "굵은 글자는 밝게", description = "처음 여덟 색 중 하나인 굵은 글자를 밝은 색으로 그립니다." }
        |> Dict.set "colours.palette" { label = "팔레트", description = "0번부터의 16가지 이름 있는 색. 주지 않은 색은 기본값." }
        |> Dict.set "cursor.blink_ms" { label = "커서 깜박임", description = "프로그램이 커서 깜박임을 요청할 때 깜박임 한 번의 절반. 0이면 깜박이지 않습니다." }
        |> Dict.set "frames.every_ms" { label = "화면 갱신 간격", description = "출력을 최대 이 간격으로 그립니다." }
        |> Dict.set "frames.sync_timeout_ms" { label = "동기 출력 제한 시간", description = "프로그램이 화면을 붙잡아 둘 수 있는 시간(모드 2026)." }
        |> Dict.set "scrollback.lines" { label = "스크롤백", description = "이만큼의 꽉 찬 줄을 기록으로 보관합니다. 0이면 보관하지 않습니다." }
        |> Dict.set "program.command" { label = "명령", description = "실행할 프로그램과 인수. 비워 두면 시스템 셸." }
        |> Dict.set "start" { label = "puritty가 여는 것", description = "아무것도 붙이지 않은 `puritty`가 여는 것: \"shell\"은 로컬 셸, \"hosts\"는 호스트 목록, \"host:이름\"은 그 호스트." }
        |> Dict.set "terminal.charset" { label = "문자 집합", description = "프로그램이 읽고 쓰는 문자 집합. 지정하지 않으면 로캘의 것." }
        |> Dict.set "selection.word_boundaries" { label = "단어 경계", description = "더블 클릭할 때 단어를 끝내는 문자들." }
        |> Dict.set "mouse.paste_button" { label = "붙여넣기 버튼", description = "선택한 것을 붙여넣는 마우스 버튼." }
        |> Dict.set "clipboard.osc52_read" { label = "프로그램의 클립보드 읽기 허용", description = "프로그램이 OSC 52로 클립보드를 읽을 수 있는지." }
        |> Dict.set "hosts.name" { label = "이름", description = "목록과 명령줄(puritty --host 이름)에서 쓰는 호스트의 이름." }
        |> Dict.set "hosts.*.host" { label = "호스트", description = "연결할 곳: 이름이나 주소." }
        |> Dict.set "hosts.*.user" { label = "사용자", description = "로그인할 사용자. 지정하지 않으면 ssh가 정합니다." }
        |> Dict.set "hosts.*.port" { label = "포트", description = "지정하지 않으면 ssh의 기본값인 22." }
        |> Dict.set "hosts.*.identity" { label = "키", description = "로그인에 쓸 개인 키 파일. 지정하지 않으면 ssh가 정합니다." }
        |> Dict.set "hosts.*.jump" { label = "경유", description = "거쳐서 연결할 다른 호스트의 이름, 또는 사용자@호스트:포트." }
        |> Dict.set "hosts.*.command" { label = "명령", description = "로그인 셸 대신 터미널에서 실행할 명령." }
        |> Dict.set "hosts.*.charset" { label = "문자 집합", description = "호스트의 문자 집합. 지정하지 않으면 설정의 것." }
        |> Dict.set "hosts.*.title" { label = "제목", description = "창 제목. 지정하지 않으면 호스트의 이름." }
        |> Dict.set "hosts.*.client" { label = "클라이언트", description = "연결할 ssh: 터미널의 OpenSSH, 또는 puritty 자체. 지정하지 않으면 Windows에서는 puritty 자체, Linux에서는 OpenSSH." }
        |> Dict.set "hosts.*.colours.foreground" { label = "글자색", description = "설정 대신 쓰는 글자색." }
        |> Dict.set "hosts.*.colours.background" { label = "배경색", description = "설정 대신 쓰는 배경색. 운영 서버에는 붉은 색을 흔히 씁니다." }
        |> Dict.set "hosts.*.colours.palette" { label = "팔레트", description = "설정 대신 쓰는 16가지 이름 있는 색." }
        |> Dict.set "hosts.*.font.family" { label = "글꼴", description = "설정 대신 쓰는 글꼴." }
        |> Dict.set "hosts.*.font.size" { label = "글꼴 크기", description = "설정 대신 쓰는 포인트 크기." }
