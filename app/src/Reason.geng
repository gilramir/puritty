module Reason exposing (Reason(..))

{-| Why a fallback in this package runs: each `meant` names one of these
(geng-lang `docs/user/checks.md`), and `geng checks` holds every one to
running and every reason to being used. -}


{-| The reasons a `meant` here names. -}
type Reason
    = {-| what came from outside the program (tmux, a file, the network, the OS, the keyboard or the input method) was short, missing or not what was asked -}
      FromOutside
    | {-| a setting or option is not set, so its default applies -}
      NotSet
    | {-| a part of the model is empty because its menu, search, dialog, prompt or mode is not open -}
      NotOpen
    | {-| it is not known yet; a later event fills it in -}
      NotYet
    | {-| a pane, tab, window or session closed before an event about it was handled -}
      Gone
    | {-| a call to the OS, a file or the network failed -}
      Refused
    | {-| a scan, list or queue ended, and this is its end -}
      NoMore
    | {-| a name, key or id is not in the program's own tables -}
      NotKnown
    | {-| an index or position is past an edge, and this is the edge's answer -}
      OutOfRange
