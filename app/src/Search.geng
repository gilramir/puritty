module Search exposing (State, backFor, find, findTyped, matchesIn, start)

{-| Scrollback search (`docs/phase3-select.md` §23): the query as typed,
and the match shown, found row by row in the scrollback and the screen,
ignoring case. A match is found within one row; its columns count each
character's cells, so a match after wide characters is where it shows.
-}

import Reason
import Vt
import Vt.Width as Width


type alias State =
    { query : String
    , match : Maybe { start : Vt.Point, end : Vt.Point }
    , failed : Bool
    , missed : Maybe Missed
    }


{-| A query found nowhere from row `bottom` up, when the terminal had
pushed `pushed` rows into its scrollback and was `cols` wide. The rows it
covered that cannot change since are those that were in the scrollback
then, up to `bottom`: a row in the scrollback keeps its text while the
width does (a resize reflows it), and the screen's rows can be written
again at any time. -}
type alias Missed =
    { query : String, bottom : Int, pushed : Int, cols : Int }


start : State
start =
    { query = "", match = Nothing, failed = False, missed = Nothing }


{-| `find` going older from `bottom`, for a query as it is typed. One that
begins with a query found nowhere is found nowhere in the rows that miss
covered and that cannot have changed, so only the rows after them are
read (the code review's MAN1: each character typed after a miss read the
whole scrollback again). What missed is answered, for the next. -}
findTyped : String -> Int -> Maybe Missed -> Vt.Term -> { match : Maybe { start : Vt.Point, end : Vt.Point }, missed : Maybe Missed }
findTyped query bottom missed t =
    let
        q =
            lowered query

        oldest =
            Vt.rowsPushed t - Vt.scrollbackRows t

        newest =
            Vt.rowsPushed t + t.rows - 1

        -- the newest row the miss covered that cannot have changed
        covered =
            when missed is
                Just mq ->
                    -- the same width, and no fewer rows pushed: ED 3 can
                    -- lower the count, and rows' numbers with it (VP3)
                    if mq.cols == t.cols && Vt.rowsPushed t >= mq.pushed && mq.query /= "" && String.startsWith (lowered mq.query) q then
                        min mq.bottom (mq.pushed - 1)

                    else
                        oldest - 1

                Nothing ->
                    meant Reason.NotSet (oldest - 1)

        match =
            if q == "" then
                Nothing

            else
                findFrom q True (clamp oldest newest bottom) (max oldest (covered + 1)) newest t
    in
    { match = match
    , missed =
        if match == Nothing && query /= "" then
            Just { query = query, bottom = bottom, pushed = Vt.rowsPushed t, cols = t.cols }

        else
            Nothing
    }


{-| The first row, from `from` on, going older (`older`) or newer, that
holds the query, and where in it: the first occurrence in the row. Rows
are absolute, as `Vt.Point`s are. -}
find : String -> Bool -> Int -> Vt.Term -> Maybe { start : Vt.Point, end : Vt.Point }
find query older from t =
    let
        q =
            lowered query

        oldest =
            Vt.rowsPushed t - Vt.scrollbackRows t

        newest =
            Vt.rowsPushed t + t.rows - 1
    in
    if q == "" then
        Nothing

    else
        findFrom q older (clamp oldest newest from) oldest newest t


{-| The rows read at a time: a page's worth, so that each page of the
scrollback is read once for its rows, not once a row (the code review's
MA3). -}
block : Int
block =
    1024


findFrom : String -> Bool -> Int -> Int -> Int -> Vt.Term -> Maybe { start : Vt.Point, end : Vt.Point }
findFrom q older row oldest newest t =
    if row < oldest || row > newest then
        Nothing

    else
        let
            lo =
                if older then
                    max oldest (row - block + 1)

                else
                    row

            hi =
                if older then
                    row

                else
                    min newest (row + block - 1)

            read =
                Vt.rowTexts lo (hi - lo + 1) t

            n =
                Array.length read.texts

            -- the block's rows in the order they are searched
            order =
                if older then
                    Array.range 0 (n - 1) |> Array.reverse

                else
                    Array.range 0 (n - 1)
        in
        when Array.findFirst (\k -> String.contains q (lowered (Maybe.withDefault "" (Array.get k read.texts)))) order is
            Just found ->
                let
                    text =
                        Maybe.withDefault "" (Array.get found.value read.texts)
                in
                when String.firstIndexOf q (lowered text) is
                    Just i ->
                        let
                            before =
                                cells (String.takeFirst i text)

                            within =
                                cells (String.slice i (i + String.count q) text)

                            at =
                                read.from + found.value
                        in
                        Just { start = { row = at, col = before }, end = { row = at, col = before + max 1 within - 1 } }

                    Nothing ->
                        meant Reason.NoMore Nothing

            Nothing ->
                meant Reason.NoMore
                    findFrom q
                        older
                        (if older then
                            lo - 1

                         else
                            hi + 1
                        )
                        oldest
                        newest
                        t


{-| The cells a piece of text takes. -}
cells : String -> Int
cells text =
    String.foldl
        (\c n ->
            let
                cp =
                    Char.toCode c
            in
            -- the table answers from 0x80 up; below, a character is a cell
            n
                + (if cp < 0x80 then
                    1

                   else
                    Width.width cp
                  )
        )
        0
        text


{-| How far back the view goes to show a row near its middle, or not at
all when it is on the screen already. -}
backFor : Int -> Int -> Vt.Term -> Int
backFor row back t =
    let
        top =
            Vt.rowsPushed t - back
    in
    if row >= top && row < top + t.rows then
        back

    else
        clamp 0 (Vt.scrollbackRows t) (Vt.rowsPushed t - row + t.rows // 2)


{-| Every match of `query` in rows `first` to `last`, as tmux's copy mode
marks them (`docs/tmux.md` TM41): within one row, left to right, not
overlapping, and ignoring case when the query has no capitals, as tmux's
`window_copy_is_lowercase`. -}
matchesIn : String -> Int -> Int -> Vt.Term -> Array { start : Vt.Point, end : Vt.Point }
matchesIn query first last t =
    if query == "" || last < first then
        []

    else
        let
            caseless =
                lowered query == query

            n =
                String.count query
        in
        let
            -- the rows' text read at once, each page once (review MA3)
            read =
                Vt.rowTexts first (last - first + 1) t
        in
        Array.indexedMap (\k text -> rowMatches query caseless n (read.from + k) text) read.texts
            |> Array.flatten


rowMatches : String -> Bool -> Int -> Int -> String -> Array { start : Vt.Point, end : Vt.Point }
rowMatches query caseless n row text =
    let
        hay =
            if caseless then
                lowered text

            else
                text
    in
    matchesFrom query n row text hay 0 []


matchesFrom : String -> Int -> Int -> String -> String -> Int -> Array { start : Vt.Point, end : Vt.Point } -> Array { start : Vt.Point, end : Vt.Point }
matchesFrom query n row text hay from found =
    when String.firstIndexOf query (String.dropFirst from hay) is
        Just j ->
            let
                i =
                    from + j

                before =
                    cells (String.takeFirst i text)

                within =
                    cells (String.slice i (i + n) text)
            in
            if n < 1 then
                found

            else
                matchesFrom query n row text hay (i + n) (Array.pushLast { start = { row = row, col = before }, end = { row = row, col = before + max 1 within - 1 } } found)

        Nothing ->
            meant Reason.NoMore found


{-| Text in lower case a character at a time, each character's lower case
kept only when it is one character: so that an index found in it is the
index in the text, which the columns are measured on. `İ` lowers to two
(`i` and a combining dot), which moved every match after it a column to
the right (the code review's MA17); it is kept as it is, and found only
as itself. -}
lowered : String -> String
lowered text =
    let
        whole =
            String.toLower text
    in
    -- nearly every row lowers to as many characters: taken whole
    if String.count whole == String.count text then
        whole

    else
        bySingle text


bySingle : String -> String
bySingle text =
    String.toArray text
        |> Array.map
            (\c ->
                let
                    one =
                        String.fromChar c

                    lower =
                        String.toLower one
                in
                if String.count lower == 1 then
                    lower

                else
                    one
            )
        |> String.join ""
