module Backend exposing (Backend, Incoming(..), Size, pty, ssh, withSshHelpers)

{-| What a window's terminal talks to (`docs/ssh-client.md` SC11 step 1,
SC18): the bytes the remote end writes, the bytes it is sent, its size,
and its end. Either a program on a pseudo terminal or the built-in ssh
client's session; the loop in `Main` knows neither.
-}

import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Os.Error exposing (Error)
import Os.File as File
import Os.Path exposing (Path)
import Os.Process as Process
import Process as Light
import Reason
import Source exposing (Source)
import Ssh.Connection as Connection
import Ssh.Session as Session
import Task exposing (Task)


{-| What a read answers: the terminal's bytes (none once the remote end is
done), or what the ssh session tells the window, which a pseudo terminal
never does. -}
type Incoming
    = Data Bytes
    | Notice Session.Notice


{-| A terminal's size: its cells, and its pixels as the program on it reads
them (`TIOCGWINSZ`, ssh's `pty-req` and `window-change`), 0 when not known
(`docs/images.md` IM21). -}
type alias Size =
    { columns : Int
    , rows : Int
    , widthInPixels : Int
    , heightInPixels : Int
    }


{-| `read` answers what came; `writeSome` takes what it can and answers how
much; `writable` waits until it can take more, and the loop races it beside
`read` (V48). `kill` ends the remote end; `waitForExit` answers its exit
status, negative for none. `answer` and `reconnect` are the ssh session's:
the user's answer to its question, and a new connection after one ended,
at the window's size then.
`hangUp` lets the remote end go when its tab does: a pseudo terminal is
closed, which hangs it up (`SIGHUP` to what runs on it, as a terminal
emulator's closing does), its program is sent `SIGTERM` too, and it is
waited for beside the window, so that nothing of it is kept; an ssh
session is hung up as `kill` does. A tab's `kill` alone sent one `SIGTERM`
to the program started, which an interactive shell ignores, and kept the
terminal's descriptor for the window's life (the code review's MB1;
`docs/tabs.md` Dnene51).
`busy` names what runs in front of the program started, as a shell's
command line does, for asking before a tab is closed (docs/tabs.md TB4);
an ssh session answers `Nothing`, and `Main` asks from its own state.
`directory` is where the program started is, as its `cd` left it, for a
new tab opened there (TB4); an ssh session answers `Nothing`.
`side` gives an ssh session the inputs that open and feed channels beside
it on its connection (`docs/sftp.md` FT12, FT13); a pseudo terminal has
none.
-}
type alias Backend =
    { read : Task Error Incoming
    , writeSome : Bytes -> Task Error Int
    , writable : Task Error {}
    , resize : Size -> Task Error {}
    , kill : Task String {}
    , hangUp : Task String {}
    , waitForExit : Task String Int
    , answer : Session.Answer -> Task Error {}
    , reconnect : Size -> Task Error {}
    , busy : Task Error (Maybe String)
    , directory : Task Error (Maybe Path)
    , side : Maybe (Session.Input -> Task Error {})
    }


{-| A program on its pseudo terminal, or `Nothing` when it was started
without one. -}
pty : Process.Child -> Maybe Backend
pty child =
    Process.terminal child
        |> Maybe.map
            (\terminal ->
                let
                    fd =
                        Process.terminalHandle terminal
                in
                { read = File.read fd |> Task.map Data
                , writeSome = \bytes -> File.writeSome bytes fd
                , writable = File.writable fd
                , resize = \size -> Process.resize terminal size
                , kill = Process.kill child
                , hangUp =
                    -- a second close fails, and is let go: the tab is
                    -- gone either way
                    File.close fd
                        |> Task.onError (\_ -> Task.succeed {})
                        |> Task.andThen (\_ -> Process.kill child)
                        |> Task.andThen (\_ -> Light.spawn (Process.waitForExit child))
                        |> Task.map (\_ -> {})
                , waitForExit = Process.waitForExit child
                , answer = \_ -> Task.succeed {}
                , reconnect = \_ -> Task.succeed {}
                , busy = Process.foreground terminal
                , directory = Process.directory terminal
                , side = Nothing
                }
            )


{-| The built-in ssh client's session, run beside the window's loop: what
it tells the window comes through `read`, keys, sizes and answers go to it.
Its exit status is what it tells (`Session.Exited`), which `Main` keeps; a
session that ends waits for a reconnect or a hang-up. -}
ssh : Session.Permissions -> { options : Session.Options, jumps : Array Session.Options } -> Task x Backend
ssh permissions options =
    Task.map2 (\notices inputs -> { notices = notices, inputs = inputs }) Source.new Source.new
        |> Task.andThen
            (\sources ->
                Light.spawn (supervise permissions options sources)
                    |> Task.map
                        (\_ ->
                            { read =
                                -- output read is output the loop takes, now: the
                                -- session gives the server window back for it, and
                                -- only for it (SC35)
                                Source.next sources.notices
                                    |> Task.andThen
                                        (\notice ->
                                            when notice is
                                                Nothing ->
                                                    meant Reason.NoMore Task.succeed (Data Bytes.empty)

                                                Just (Session.Output bytes) ->
                                                    Source.emit sources.inputs (Session.Taken (Bytes.length bytes))
                                                        |> Task.map (\_ -> Data bytes)

                                                Just other ->
                                                    Task.succeed (Notice other)
                                        )
                            , writeSome = \bytes -> Source.emit sources.inputs (Session.Keys bytes) |> Task.map (\_ -> Bytes.length bytes)
                            , writable = Task.succeed {}
                            , resize = \size -> Source.emit sources.inputs (Session.Resize size)
                            , kill = Source.emit sources.inputs Session.Hangup
                            , hangUp = Source.emit sources.inputs Session.Hangup
                            , waitForExit = Task.succeed -1
                            , answer = \a -> Source.emit sources.inputs (Session.Answered a)
                            , reconnect =
                                \size ->
                                    Source.emit sources.inputs (Session.Resize size)
                                        |> Task.andThen (\_ -> Source.emit sources.inputs Session.Reconnect)
                            , busy = Task.succeed Nothing
                            , directory = Task.succeed Nothing
                            , side = Just (\input -> Source.emit sources.inputs input)
                            }
                        )
            )


{-| The session run, and again on each reconnect, until the window hangs
up; then the notices close, which ends the window's reads. -}
supervise : Session.Permissions -> { options : Session.Options, jumps : Array Session.Options } -> { notices : Source Session.Notice, inputs : Source Session.Input } -> Task x {}
supervise permissions options sources =
    Session.run permissions options.jumps options.options sources.notices sources.inputs
        |> Task.andThen (\_ -> afterEnd permissions options sources)


afterEnd : Session.Permissions -> { options : Session.Options, jumps : Array Session.Options } -> { notices : Source Session.Notice, inputs : Source Session.Input } -> Task x {}
afterEnd permissions options sources =
    Source.next sources.inputs
        |> Task.andThen
            (\input ->
                when input is
                    Just Session.Reconnect ->
                        supervise permissions options sources

                    Just (Session.Resize size) ->
                        -- the window resized while the session was down:
                        -- the next connection asks for that size
                        afterEnd permissions { options | options = Session.resized size options.options } sources

                    Just Session.Hangup ->
                        Source.close sources.notices

                    Nothing ->
                        meant Reason.NoMore Source.close sources.notices

                    Just _ ->
                        afterEnd permissions options sources
            )


{-| A tab of OpenSSH's `ssh` given side channels (`docs/sftp.md` FT31), as
the built-in client's session has them: each `OpenSubsystem` or
`OpenExec` a helper `ssh` that goes through the tab's connection by its
control socket (`ControlMaster`), `ssh OPTIONS -s HOST NAME` or
`ssh OPTIONS HOST COMMAND`, on pipes; its output told through `read` as
the session's side events are. `options` holds what reaches the tab's
master (`-S` and the socket, or the user's own `ControlPath` by their
config) and `BatchMode`, so that a helper that finds no master fails
rather than asking for a password.

A write to a helper is answered by a `Sent 0` once the pipe has taken it,
for the engines that pace what they read by what waits. A subsystem whose
helper ends having written nothing, its status not 0, is `Refused` with
what `ssh` said, as a session's refused channel is: `subsystem request
failed` where the host has SFTP off. -}
withSshHelpers : Process.Permission -> { options : Array Bytes, host : Bytes } -> Backend -> Task x Backend
withSshHelpers cp via b =
    Task.map2 (\events inputs -> { events = events, inputs = inputs }) Source.new Source.new
        |> Task.andThen
            (\s ->
                Light.spawn (helpers cp via s Dict.empty)
                    |> Task.map
                        (\_ ->
                            { b
                                | read =
                                    Task.race b.read
                                        [ Source.next s.events
                                            |> Task.map
                                                (\e ->
                                                    when e is
                                                        Just side ->
                                                            Notice (Session.Side side)

                                                        Nothing ->
                                                            meant Reason.NoMore (Data Bytes.empty)
                                                )
                                        ]
                                , side = Just (\i -> Source.emit s.inputs i)
                            }
                        )
            )


type alias Helpers =
    { events : Source { ref : Int, event : Connection.Event }, inputs : Source Session.Input }


{-| The side inputs taken in turn, each helper kept by its reference. -}
helpers : Process.Permission -> { options : Array Bytes, host : Bytes } -> Helpers -> Dict Int { child : Process.Child, pipes : Process.Pipes } -> Task x {}
helpers cp via s children =
    let
        tell ref event =
            Source.emit s.events { ref = ref, event = event }

        withChild ref f =
            when Dict.get ref children is
                Just c ->
                    f c

                Nothing ->
                    -- one that ended, or never started
                    meant Reason.Gone (Task.succeed {})
    in
    Source.next s.inputs
        |> Task.andThen
            (\input ->
                when input is
                    Just (Session.OpenSubsystem o) ->
                        started cp s o.ref True (via.options ++ [ Bytes.fromString "-s", via.host, Bytes.fromString o.name ])
                            |> Task.andThen (\c -> helpers cp via s (Maybe.withDefault (meant Reason.Refused children) (Maybe.map (\one -> Dict.set o.ref one children) c)))

                    Just (Session.OpenExec o) ->
                        started cp s o.ref False (via.options ++ [ via.host, o.command ])
                            |> Task.andThen (\c -> helpers cp via s (Maybe.withDefault (meant Reason.Refused children) (Maybe.map (\one -> Dict.set o.ref one children) c)))

                    Just (Session.SideWrite w) ->
                        withChild w.ref (\c -> File.write w.bytes c.pipes.input |> Task.onError (\_ -> Task.succeed {}) |> Task.andThen (\_ -> tell w.ref (Connection.Sent 0)))
                            |> Task.andThen (\_ -> helpers cp via s children)

                    Just (Session.SideEof ref) ->
                        withChild ref (\c -> File.close c.pipes.input |> Task.onError (\_ -> Task.succeed {}))
                            |> Task.andThen (\_ -> helpers cp via s children)

                    Just (Session.SideClose ref) ->
                        withChild ref (\c -> Process.kill c.child |> Task.onError (\_ -> Task.succeed {}))
                            |> Task.andThen (\_ -> helpers cp via s (Dict.remove ref children))

                    Just _ ->
                        -- the session's own inputs: a pseudo terminal's tab has none
                        helpers cp via s children

                    Nothing ->
                        meant Reason.NoMore (Task.succeed {})
            )


{-| A helper started: `Started`, and its output read beside, or `Refused`
and `Ended` when it could not start. -}
started : Process.Permission -> Helpers -> Int -> Bool -> Array Bytes -> Task x (Maybe { child : Process.Child, pipes : Process.Pipes })
started cp s ref subsystem args =
    Process.spawnAsBytes cp (Bytes.fromString "ssh") args (Process.defaultSpawnOptions Process.External)
        |> Task.map Ok
        |> Task.onError (\e -> Task.succeed (Err (Os.Error.toString e)))
        |> Task.andThen
            (\got ->
                when got is
                    Ok child ->
                        when Process.pipes child is
                            Just pipes ->
                                Source.emit s.events { ref = ref, event = Connection.Started }
                                    |> Task.andThen (\_ -> Light.spawn (helperOutput s ref subsystem child pipes False))
                                    |> Task.map (\_ -> Just { child = child, pipes = pipes })

                            Nothing ->
                                meant Reason.FromOutside (refused s ref "ssh was started with no pipes")

                    Err why ->
                        meant Reason.Refused (refused s ref ("ssh could not be started: " ++ why))
            )


refused : Helpers -> Int -> String -> Task x (Maybe { child : Process.Child, pipes : Process.Pipes })
refused s ref why =
    Source.emit s.events { ref = ref, event = Connection.Refused why }
        |> Task.andThen (\_ -> Source.emit s.events { ref = ref, event = Connection.Ended })
        |> Task.map (\_ -> Nothing)


{-| A helper's output told until it ends, then what it said on its error
output and how it ended. -}
helperOutput : Helpers -> Int -> Bool -> Process.Child -> Process.Pipes -> Bool -> Task x {}
helperOutput s ref subsystem child pipes wrote =
    File.read pipes.output
        |> Task.onError (\_ -> Task.succeed Bytes.empty)
        |> Task.andThen
            (\bytes ->
                if Bytes.isEmpty bytes then
                    errorOutput pipes.error []
                        |> Task.andThen
                            (\said ->
                                Process.waitForExit child
                                    |> Task.onError (\_ -> Task.succeed -1)
                                    |> Task.andThen
                                        (\status ->
                                            (if subsystem && not wrote && status /= 0 then
                                                Source.emit s.events { ref = ref, event = Connection.Refused (String.trim (Bytes.toStringLossy said)) }

                                             else
                                                (if Bytes.isEmpty said then
                                                    Task.succeed {}

                                                 else
                                                    Source.emit s.events { ref = ref, event = Connection.ErrorOutput said }
                                                )
                                                    |> Task.andThen (\_ -> Source.emit s.events { ref = ref, event = Connection.Exited status })
                                            )
                                                |> Task.andThen (\_ -> Source.emit s.events { ref = ref, event = Connection.Ended })
                                        )
                            )
                        |> Task.andThen (\_ -> File.close pipes.output |> Task.onError (\_ -> Task.succeed {}))
                        |> Task.andThen (\_ -> File.close pipes.error |> Task.onError (\_ -> Task.succeed {}))

                else
                    Source.emit s.events { ref = ref, event = Connection.Output bytes }
                        |> Task.andThen (\_ -> helperOutput s ref subsystem child pipes True)
            )


errorOutput : File.Handle -> Array Bytes -> Task x Bytes
errorOutput h pieces =
    File.read h
        |> Task.onError (\_ -> Task.succeed Bytes.empty)
        |> Task.andThen
            (\b ->
                if Bytes.isEmpty b then
                    Task.succeed (Bytes.flatten pieces)

                else
                    errorOutput h (Array.pushLast b pieces)
            )
