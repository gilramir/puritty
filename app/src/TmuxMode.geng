{-| tmux control mode in puritty's window (`docs/tmux.md` TM13 step 3,
TM14): when `tmux -CC` starts on the terminal, the window shows the tmux
window's panes, each a terminal of its own fed its `%output`; tiled panes
where tmux puts them with a line between, floating panes over them in a
box; the active pane's cursor. Keys go to the active pane, the window's
size to tmux. `%exit` gives the terminal back.

The panes' terminals answer nothing: tmux answered their programs already.
-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Clock
import Dict exposing (Dict)
import Drop
import Keys
import Reason
import Search
import Tmux.Bindings as Bindings
import Tmux.Borders as Borders
import Tmux.Caps as Caps exposing (Caps)
import Tmux.Command as Command
import Tmux.Control as Control exposing (Event(..), Notice(..))
import Tmux.Customize as Customize
import Tmux.Layout as Layout
import Tmux.Passthrough as Passthrough
import Tmux.Style as Style
import Tmux.Syntax as Syntax
import Vt
import Vt.Mouse as Mouse
import Vt.Width as Width
import Window


type alias State =
    { reader : Control.Reader
    -- the line typed outside control mode since the last Enter, or
    -- `Nothing` when a key that edits it unseen (an arrow, a recalled
    -- line) was typed: on Enter, whether it starts `tmux -CC` (TM108)
    , typedLine : Maybe String
    , on : Bool
    -- control mode begun and tmux's reply to the command it was started
    -- with not yet ended: what it has said meanwhile, which is an error
    -- when it ends control mode before attaching (TM70)
    , starting : Maybe (Array String)
    -- the tmux window shown, -1 until tmux says which
    , window : Int
    , name : String
    -- the session attached to, -1 until `%session-changed` says which:
    -- the first, right after the attach, is for the session the attach's
    -- own questions are about (the code review's TA9, TM124)
    , sessionId : Int
    -- each pane's terminal, and its id at the same index: as many of
    -- one as of the other, which the compiler holds every update to
    -- (TM34)
    , ids : Array Int
    , panes : Builder Vt.Term where Array.length ids == Builder.length panes
    , layout : Maybe Layout.Cell
    , active : Int
    -- whether the window has a modal pane, which takes every key
    , modal : Bool
    -- the window's picture, made of the panes (`Vt.compose`)
    , canvas : Vt.Term
    -- what each command sent waits for in its reply, in the order sent,
    -- with the command and the number of the line it went on: tmux answers
    -- a client's commands in turn (docs/tmux.md TM5.2), and ends a line at
    -- its first that fails (docs/tmux-checks.md TK10); and the lines sent
    , expecting : Array Asked
    -- this client's replies that came when no question waited: each one a
    -- question answered by the reply to another, so none should come
    -- (the code review's TA5, TB3), and the diagnosis says how many
    , unasked : Int
    -- a binding sent that may move the active pane, not yet settled: keys
    -- typed meanwhile wait, in order, for the window's answer, so that a
    -- named key sent by the pane's id and text sent through the client
    -- reach the same pane (the code review's TA4, docs/tmux.md TM109)
    , settling : Settling
    -- a binding run that may bind keys or set the prefix: the key tables
    -- read again when its block comes (the code review's TA12, TM114)
    , rereadKeys : Bool
    , heldKeys : Array { k : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes }, bytes : Bytes, ms : Int }
    , linesSent : Int
    -- what puritty showed of tmux when last read (`viewLine`)
    , shownView : String
    -- what tmux said of each pane on attach, for its capture
    , info : Dict Int PaneInfo
    -- a floating pane being moved or resized by its box, and the pane a
    -- press began in, which keeps the mouse until it is let go
    , drag : Maybe Drag
    , grab : Maybe Int
    , mouseLast : Maybe Mouse.Cell
    -- how far back each pane's view is scrolled, 0 or missing at the
    -- bottom; a selection, in one pane's rows (absolute, as the core's
    -- `Point`s are); the last press of the left button, for double and
    -- triple clicks (docs/tmux.md TM17)
    , back : Dict Int Int
    , selection : Maybe Sel
    , clicks : { at : Int, count : Int, pane : Int, point : Vt.Point }
    -- the session's windows, shown as tabs on the window's first row
    -- (docs/tmux.md TM18)
    , tabs : Array { id : Int, index : Int, name : String }
    -- panes in which a `tmux -CC` was started, each read as control mode
    -- so that its lines are dropped until it ends (TM19)
    , nested : Dict Int Control.Reader
    -- the start of `ESC P 1000 p` a pane's output ended with, joined to
    -- its next output (the code review's TP13)
    , entryHeld : Dict Int Bytes
    -- the tab bar at the window's top, or at its bottom where tmux's
    -- status line was (`[tmux] tabs`, TM22)
    , barTop : Bool
    -- the bar's place as the config says it; in tmux's look tmux's
    -- status-position decides once it is known (TM49)
    , barTopConfig : Bool
    -- tmux's key bindings, by table and key, and the prefix keys, read
    -- on attach; the table the client is in as puritty follows it, and
    -- until when a repeatable binding keeps it there, -1 when none does
    -- (TM24)
    , keys : Bindings.Follow
    -- what tmux said (`%message`) or puritty says of a key, shown at the
    -- tab bar's right until the next key (TM24)
    , said : String
    -- the bells tmux's options let sound (`bell-action`, `visual-bell`,
    -- `monitor-bell`), counted as the panes ring (TM99)
    , audible : Int
    -- the window's cell size and the image limit, which the panes'
    -- terminals are given, so that their Kitty graphics placements cover
    -- cells (`docs/images.md` IM18)
    , paneCell : { width : Int, height : Int, limit : Int }
    -- what the panes' terminals say of themselves when asked (puritty's
    -- version, DA1, colors), as the window's terminal does: they answer
    -- only what a program asks past tmux (`docs/images.md` IM33)
    , paneEmbedder : Maybe Vt.Embedder
    -- each pane's place in tmux's passthrough envelopes (IM33)
    , scans : Dict Int Passthrough.Scan
    -- tmux's version in tenths (3.6a 36, 3.8 38, next-3.9 39), 0 until
    -- it is known: what tmux draws differs by it (TM44)
    , version : Int
    -- each pane's mode's key table (`copy-mode-vi` in copy mode), and
    -- `mode-keys`; a prompt puritty asks for tmux, the answers given
    -- before, and whether it is drawn in tmux's look (TM25)
    , modes : Dict Int String
    , modeKeys : String
    , asking : Maybe Asking
    -- this client ending: 1 once a key or a typed line that detaches it
    -- (or ends the server) is on its way, 2 once that went, after which
    -- nothing more is sent until `%exit`: tmux no longer reads, and what
    -- was written would be typed into the shell it leaves (TM92)
    , ending : Int
    -- each prompt type's answers typed here, and what tmux has of each
    -- from 3.3, read as a prompt opens (TM89); before 3.3 one list, `all`
    , history : Dict String (Array String)
    , tmuxHistory : Dict String (Array String)
    , lookTmux : Bool
    -- every `tmux -CC` entered at once, never asked about (`[tmux] start
    -- = "always"`, TM112)
    , startAlways : Bool
    -- what a binding or a command printed, shown in a view that takes
    -- the keys until it is closed (TM26)
    , view : Maybe View
    -- a menu of tmux's shown by puritty, and a count that tells its
    -- formats' answers from an earlier menu's (TM27)
    , menu : Maybe Menuing
    , serial : Int
    -- the panes' numbers shown (`display-panes`, TM28), the time as the
    -- last key or tick said, and `display-panes-time`
    , numbers : Maybe Numbering
    , clock : Int
    -- when the status line is next asked, before tmux 3.2 has
    -- subscriptions (TM72); -1 when it is told
    , pollAt : Int
    -- the pane whose options hold the mouse's word and line, set for a
    -- binding puritty runs (TB15): unset once nothing that may read them
    -- is open
    , mouseOptions : Maybe Int
    -- when tmux, asked after a line that was not its own, is given up on
    -- (docs/tmux-checks.md TK14); -1 when nothing is in doubt, -2 when the
    -- wait starts at the next tick, which knows the time (a read does not,
    -- and `clock` is the last tick's)
    , strayUntil : Int
    , panesMs : Int
    -- tmux's status line as it subscribes to it (TM29), tmux 3.8's
    -- theme names in it written as the theme's colors (TM65), and as
    -- tmux sent it
    , status : StatusLine
    , rawStatus : StatusLine
    -- tmux 3.8's theme colors, dark and light, in `Style.themeNames`'
    -- order, as tmux expands them for a client of 24-bit color; the
    -- `theme` option; whether puritty's background is light, which
    -- `theme detect` follows (TM65)
    , themes : { dark : Array String, light : Array String }
    -- this client's name, as tmux's message log names it, and the
    -- commands run for the user, the last 50 (TM65)
    , clientName : String
    , userRan : Array String
    , themeChoice : String
    , lightBackground : Bool
    -- each pane in copy mode as tmux last said it, and the panes asked
    -- about and not yet answered: `True` once something has changed
    -- since the question was sent, to ask again (TM31)
    , copy : Dict Int Copying
    , copyAsked : Dict Int Bool
    -- each pane's mode by tmux's name for it (`clock-mode`), the time
    -- of day in ms at a reading of the loop's clock for the clock (TM32,
    -- RE11), and the tree
    -- puritty shows for `choose-tree`
    , paneModes : Dict Int String
    , dayAt : Maybe { clock : Int, ms : Int }
    , tree : Maybe Tree
    -- choose-buffer's or choose-client's list, drawn by puritty (TM55)
    , listing : Maybe Listing
    -- tmux's commands and their aliases, for the prompt's Tab (TM57)
    , commandNames : Array String
    -- what else the prompt completes a first word to (TM96): each
    -- command's short alias (`splitw`, from its usage line) and the names
    -- `command-alias` gives (`split-pane`)
    , shortNames : Array String
    , aliasNames : Array String
    -- the client's session when Tab last asked for -t's targets (TM97)
    , targetSession : String
    -- what this tmux takes, from its `list-commands` (TM72), and whether
    -- it expands `#{T:…}` (from 2.9)
    , caps : Caps
    -- whether `caps` is this tmux's, read from its answer to
    -- `list-commands`; until then puritty sends no size, since it does not
    -- know which form this tmux takes (docs/tmux-checks.md TK10.10)
    , capsKnown : Bool
    , timeFormats : Bool
    -- customize-mode, drawn by puritty (TM62)
    , customizing : Maybe Customizing
    -- the pane a drag of files is over, marked with the folder they would
    -- go to on the host (docs/sftp.md FT6, FT23)
    , dropMark : Maybe DropMark
    }


{-| The pane a drag is over: its folder as last read, the parts of tmux's
answer to the question out, if one is, and when it was asked: asked again
each second the drag stays, so that the folder a drop uses is the pane's
then, not the one it had when the drag came (FT6, FT30). -}
type alias DropMark =
    { pane : Int, folder : DropFolder, parts : Array Bytes, inFlight : Bool, askedAt : Int }


{-| The folder files dropped on a pane would go to: still being asked of
tmux; the folder, its bytes as the host has them; or none tmux can say,
and why, which is the folder chooser's to ask. -}
type DropFolder
    = Asking (Array Bytes)
    | Folder Bytes
    | NoFolder String


{-| `choose-tree` shown by puritty (TM32): the sessions and windows tmux
listed, `loaded` once both lists are in, which sessions are open, the row
chosen, the command a choice runs, the pane it was run in, and whether
it covers every pane (`-Z`). -}
type alias Tree =
    { sessions : Array { id : Int, name : String, attached : Bool, windows : Int, activity : Int, text : String }
    , windows : Array { session : Int, id : Int, index : Int, name : String, active : Bool, panes : Int, activity : Int, text : String }
    , panes : Array { window : Int, id : Int, index : Int, command : String, text : String }
    , loaded : Int
    , open : Dict Int Bool
    , openWindows : Dict Int Bool
    , selected : Int
    , start : Int
    , filter : String
    , passing : Maybe (Array Int)
    , noMatches : Bool
    , search : String
    -- the preview off (0), as tmux draws it (1) or big (2), `v`; the sort
    -- (0 index, 1 name, 2 time, `O`) and whether reversed (`r`); the
    -- rows tagged, by target (`t`); and, while the lists are asked
    -- again, the row chosen before (TM46)
    , previewMode : Int
    -- 3.8's information shown in place of the preview (`i`, TM65)
    , info : Bool
    , sort : Int
    , reversed : Bool
    , tagged : Array String
    , reload : Maybe { session : Int, window : Int, pane : Int }
    , template : String
    , pane : Int
    , zoom : Bool
    , preview : Preview
    }


{-| The tree's preview of its chosen row, as tmux draws it below the list
(TM35): a window's panes where they are in it, or a session's windows side
by side, each with what it shows. `serial` counts the questions asked, so
that a reply to one for a row since left is dropped; `target` is the row
asked about (`@2`, `$1`, empty for none). -}
type alias Preview =
    { serial : Int
    , target : String
    , session : Bool
    , items : Array PreviewItem
    -- how far `<` and `>` moved a session's windows from where they
    -- start (TM65)
    , offset : Int
    -- tmux 3.8's information on the row (`i`), its lines as tmux
    -- expands them (TM65)
    , info : Array String
    }


{-| A pane of the window previewed, or a window of the session: tmux's id
for it, its label, where it is in the window (a session's windows are each
at 0, 0), whether it is the active one, and the lines it shows. -}
type alias PreviewItem =
    { id : String
    , label : String
    , x : Int
    , y : Int
    , w : Int
    , h : Int
    , active : Bool
    , lines : Array String
    -- its label's style, tmux 3.8's tree-mode-preview-style for it
    -- (TM65); empty before 3.8
    , style : String
    }


noPreview : Preview
noPreview =
    { serial = 0, target = "", session = False, items = [], offset = 0, info = [] }


{-| choose-buffer's or choose-client's list (TM55): which (`buffer`,
`client`), its rows as tmux gives them, the chosen one, the tagged names,
the order (`O`) and whether reversed (`r`), the preview off (0), as tmux
draws it (1) or big (2), the chosen buffer's lines for it, the filter and
the names it keeps, the search, the command a choice runs, whether it
zooms, and the pane it was opened in. -}
type alias Listing =
    { kind : String
    , rows : Array ListRow
    , loaded : Bool
    , selected : Int where 0 <= selected && (selected == 0 || selected < Array.length rows)
    , tagged : Array String
    , sort : Int
    , reversed : Bool
    , previewMode : Int
    , preview : { name : String, lines : Array String }
    , filter : String
    , passing : Maybe (Array String)
    , noMatches : Bool
    , search : String
    , template : String
    , zoom : Bool
    , pane : Int
    -- each buffer's whole text, asked when a search needs it, as tmux
    -- searches it (TM81); dropped when the buffers are listed again
    , contents : Dict String String
    }


{-| A buffer or a client as the list shows it: its name, tmux's text for it
(`WINDOW_BUFFER_DEFAULT_FORMAT`, `WINDOW_CLIENT_DEFAULT_FORMAT`), and what
it sorts by. -}
type alias ListRow =
    { name : String, text : String, created : Int, size : Int, activity : Int, control : Bool, seq : Int }


{-| A row of the tree: a session, a window or a pane, its depth, name and text, and
what its branch is drawn by (TM44). -}
type alias TreeRow =
    { session : Int
    , window : Int
    , pane : Int
    , depth : Int
    , name : String
    , text : String
    , last : Bool
    , parentLast : Bool
    , children : Bool
    , expanded : Bool
    }


{-| A pane in copy mode as tmux describes it (TM31): how far back it is
(`scroll_position`), its history's lines (`history_size`), the cursor in
the pane, and the selection's ends, in tmux's lines (0 the history's
first), and whether it is a rectangle. `located` is whether tmux says
where the cursor and the selection are: before 3.1 it has no
`copy_cursor_x` or `selection_start_x`, so neither is drawn rather than
drawn at the corner (docs/tmux-checks.md TK8). -}
type alias Copying =
    { scroll : Int
    , hsize : Int
    , located : Bool
    , cx : Int
    , cy : Int
    , selection : Maybe { sx : Int, sy : Int, ex : Int, ey : Int }
    , rectangle : Bool
    , marked : Bool
    , count : Int
    , partial : Bool
    , timedOut : Bool
    -- when the view's top line was written, as tmux writes it (`t/p`:
    -- `21:03`, `Mon16`), from 3.6; empty before, or for a line with no
    -- time (TM103)
    , lineTime : String
    , search : String
    }


{-| tmux's status line, as `refresh-client -B` tells puritty of it (TM29):
`status-left` and `status-right` expanded (strftime too), `status-style`,
`window-status-separator`, the two lengths, and each window's
`window-status-format` (its current one for the active window) expanded,
its style and its flags, by window id; and the panes' borders (TM30):
`pane-border-status`, `pane-border-style`, and each pane's
`pane-border-format` expanded, its border's style (the active one's for
the active pane) and whether it is marked, by pane id. -}
type alias StatusLine =
    { left : String
    , right : String
    , style : String
    , separator : String
    , leftLength : Int
    , rightLength : Int
    , windows : Dict Int { text : String, style : String, flags : String }
    , borderStatus : String
    , borderStyle : String
    -- each pane's title, border style and mark, and its own
    -- window-style and window-active-style, a tab between (TM66: a
    -- popup's pane is given popup-style)
    , panes : Dict Int { title : String, border : String, marked : Bool, style : String, paneStatus : String }
    -- tmux's drawing options by name, as `optionNames` lists them (TM47)
    , options : Dict String String
    -- `status-format[1]` to `[4]` expanded, for `status 2` to `5` (TM54)
    , extra : Dict Int String
    }


noStatus : StatusLine
noStatus =
    { left = "", right = "", style = "bg=green,fg=black", separator = " ", leftLength = 10, rightLength = 40, windows = Dict.empty, borderStatus = "off", borderStyle = "", panes = Dict.empty, options = Dict.empty, extra = Dict.empty }


{-| The options puritty draws by (TM47), sent together, tab between: an
option tmux does not have (3.6's lack of 3.8's) comes as nothing, and
its default is used. -}
optionNames : Array String
optionNames =
    [ "message-style"
    , "message-command-style"
    , "mode-style"
    , "menu-selected-style"
    , "copy-mode-match-style"
    , "copy-mode-current-match-style"
    , "pane-border-lines"
    , "pane-border-indicators"
    , "status-justify"
    , "status-position"
    , "status"
    , "window-style"
    , "window-active-style"
    , "pane-scrollbars"
    , "pane-scrollbars-style"
    , "pane-scrollbars-position"
    , "display-panes-colour"
    , "display-panes-active-colour"
    , "clock-mode-colour"
    , "clock-mode-style"
    , "menu-style"
    , "menu-border-style"
    , "tree-mode-border-style"
    , "display-panes-border-style"
    -- the prompt's keys and its words (TM100)
    , "status-keys"
    , "word-separators"
    -- what a bell does (TM99)
    , "bell-action"
    , "visual-bell"
    , "monitor-bell"
    ]


{-| The colors tmux's look draws with, from the user's options or tmux's
defaults (TM47). -}
type alias Colors =
    { message : String
    -- the prompt in vi's command mode (TM100)
    , messageCommand : String
    , mode : String
    , menuSelected : String
    , match : String
    , currentMatch : String
    , clock : String
    , panes : String
    , panesActive : String
    -- a menu's items and its border, the tree's box (TM65)
    , menu : String
    , menuBorder : String
    , treeBorder : String
    }


colorsOf : StatusLine -> Colors
colorsOf status =
    let
        styled name fallback =
            when Dict.get name status.options is
                Just v ->
                    if String.trim v == "" then
                        fallback

                    else
                        Style.sgr (Style.apply v Style.plain)

                Nothing ->
                    meant Reason.NotSet fallback

        -- a color option's value, or tmux's default
        colour name fallback =
            when Dict.get name status.options is
                Just v ->
                    if String.trim v == "" then
                        fallback

                    else
                        String.trim v

                Nothing ->
                    meant Reason.NotSet fallback
    in
    { message = styled "message-style" messageColor
    , messageCommand = styled "message-command-style" messageColor
    , mode = styled "mode-style" messageColor
    , menuSelected = styled "menu-selected-style" (styled "mode-style" messageColor)
    , match = styled "copy-mode-match-style" matchColor
    , currentMatch = styled "copy-mode-current-match-style" currentMatchColor
    , clock = colour "clock-mode-colour" "blue"
    , panes = colour "display-panes-colour" "blue"
    , panesActive = colour "display-panes-active-colour" "red"
    , menu = styled "menu-style" "\u{001B}[0;38;5;254;48;5;235m"
    , menuBorder =
        when Dict.get "menu-border-style" status.options is
            Just v ->
                if String.trim v == "" then
                    "\u{001B}[0;38;5;249;48;5;235m"

                else
                    Style.sgr (Style.apply v (Style.apply (Maybe.withDefault (meant Reason.NotSet "") (Dict.get "menu-style" status.options)) Style.plain))

            Nothing ->
                meant Reason.NotSet "\u{001B}[0;38;5;249;48;5;235m"
    , treeBorder = styled "tree-mode-border-style" "\u{001B}[0m"
    }


{-| `display-panes` shown by puritty (TM28): each pane's index by its id,
as tmux answers, until when they are shown, the command a digit runs and
whether digits are taken, and the pane it was run in. -}
type alias Numbering =
    { indexes : Array { id : Int, index : Int }
    , until : Int
    , template : String
    , keys : Bool
    , pane : Int
    }


{-| A menu of tmux's (`display-menu`) shown by puritty (TM27): its title and
items, their formats answered by tmux as they come (`pending` still to
come), the item chosen (an index into `items`, -1 for none), the pane it
was opened for and the mouse's cell when a click opened it, where it goes
(`-x`, `-y`), and whether the pointer has been pressed or moved since it
opened, so that the release of the click that opened it chooses nothing. -}
type alias Menuing =
    { serial : Int
    , title : String
    , items : Array Syntax.MenuItem
    , pending : Int
    , selected : Int
    , pane : Int
    , mouse : Maybe { col : Int, row : Int }
    , x : String
    , y : String
    , armed : Bool
    -- `-O` and `-C` (TM84)
    , stayOpen : Bool
    , start : Maybe String
    -- a mode's own menu (TM87): each item's command is a key given to the
    -- mode, as `mode_tree_menu_callback` gives it
    , forMode : Bool
    -- the prompt's menu of what Tab matched (3.2 to 3.7, TM98): each
    -- item's command is the text that takes the word's place
    , completes : Bool
    }


{-| What a command puritty runs for tmux runs in (TM27): the pane, and the
mouse's cell when a click began it. -}
type alias Context =
    { pane : Int, mouse : Maybe { col : Int, row : Int } }


{-| A menu's row as shown: a line, or an item (its index in the menu) with
its name, its key and whether it can be chosen. -}
type alias MenuRow =
    { index : Int, line : Bool, text : String, key : String, enabled : Bool }


{-| What tmux printed for this client (TM26): its lines, the first shown,
and how many rows the view had when it was last drawn, a page. -}
type alias View =
    { lines : Array String
    , top : Int
    , rows : Int
    , all : Array String
    , filter : String
    , filtering : Bool
    }


{-| A prompt of tmux's, asked by puritty (TM25): what the binding asks,
the commands after it, which of its questions is asked and the answers to
those before, the question as tmux would show it, and what is typed with
the caret. `edited` once a key has changed the text, so that a first text
tmux expands late does not replace it. -}
type alias Asking =
    { ask : Syntax.Ask
    , after : String
    , step : Int
    , answers : Array String
    , label : String
    , chars : Array Char
    , caret : Int
    , edited : Bool
    , recall : String
    , purpose : Int
    -- what C-w last cut, which C-y puts back from 3.0 (TM80)
    , cut : String
    -- the names Tab matched and could not choose between, shown after
    -- the line until the next key (3.8's `prompt_store_complete`, TM96)
    , matches : Array String
    -- vi's command mode, with `status-keys vi` (TM100)
    , commandMode : Bool
    }


{-| A selection within a pane: from `anchor` to `head`, by cells (mode 0),
words (1) or lines (2), the first word or line kept as `first` to `last`;
`made` once the button is let go, with its text. -}
type alias Sel =
    { pane : Int
    , anchor : Vt.Point
    , head : Vt.Point
    , first : Vt.Point
    , last : Vt.Point
    , mode : Int
    , moved : Bool
    , made : Bool
    , text : String
    -- the screen it was made on, and a hash of each of its rows once made,
    -- so that it goes when the pane leaves that screen or writes over
    -- them, as without tmux (`Main.kept`, TM91)
    , alt : Bool
    , hashes : Dict Int Int
    }


{-| A drag of a floating pane's box, or of the line beside or below a
tiled pane (TM20): from where, the pane as it was, and what was last sent,
so that a motion within a cell sends nothing. `kind`: 0 the box moved (its
top edge), 1 the box's bottom right corner, 2 the line right of a tiled
pane, 3 the line below it, and the box's other edges (TM38): 4 the right,
5 the bottom, 6 the left, 7 the bottom left corner. -}
type alias Drag =
    { pane : Int
    , kind : Int
    , col : Int
    , row : Int
    , x : Int
    , y : Int
    , w : Int
    , h : Int
    , sent : { col : Int, row : Int }
    }


{-| A command sent: what its reply is for, the command, and the number of
the line it went on, which the commands sent together share (TK10). -}
type alias Asked =
    { expect : Expect, command : String, line : Int }


{-| What a command's reply is for. -}
type Expect
    = ForWindow
    | ForTabs
    | ForPanes
    | ForLiving
    | ForInfo Int
    | ForSaved Int
    | ForCapture Int
    | ForKeys
    | ForPrefixes
    | ForModes
    | ForLabel
    | ForInput
    | ForRan
    | ForCondition { pane : Int, mouse : Maybe { col : Int, row : Int }, yes : String, no : String, after : String }
    | ForNumbers
    | ForCopy Int
    | ForTreeSessions
    | ForTreeWindows
    | ForTreePanes
    | ForTreeFilter
    | ForListRows
    | ForCommandNames
    | ForCaps
    | ForPromptPaste
    | ForPoll { name : String, scope : Int }
    | ForTimeProbe
    | ForRawOptions { name : String, target : String, format : String, options : Array String }
    | ForRunExpanded Context
    | ForListFilter
    | ForListPreview String
    | ForListContent String
    | ForPromptHistory String
    | ForAliases
    | ForTargets { line : String, caret : Int }
    | ForTargetSession
    | ForBellWindow
    | ForCustomize Int
    | ForCustomizeNotes String
    | ForCustomizeFilter { filter : String, ids : Array String }
    | ForCustomizeDetail { id : String, part : Int }
    | ForPreviewList Int
    | ForTreeInfo Int
    | ForPreviewCapture { serial : Int, index : Int }
    | ForDayTime
    | ForPanesTime
    | ForMenuTitle Int
    | ForMenuName { serial : Int, item : Int }
    | ForMenuCommand { serial : Int, item : Int }
    | ForTheme
    | ForClientName
    | ForDropFolder { pane : Int, part : Int }
    | ForNothing
    -- the end of what a command that runs commands ran (`source-file`,
    -- `if-shell`): each of them answers with a block of puritty's own from
    -- tmux 3.2, and every block before this one's is theirs
    -- (docs/tmux-checks.md TK10)
    | ForFence


{-| A pane as `list-panes` describes it on attach (TM5.8), and the main
screen's lines a capture of its saved grid gave while the alternate screen
was up. -}
type alias PaneInfo =
    { w : Int
    , h : Int
    , x : Int
    , y : Int
    , alt : Bool
    , top : Int
    , bottom : Int
    , modes : Array Int
    , saved : Array Bytes
    -- the cell tmux takes the window's to be, in pixels, which a program
    -- in the pane is told (`CSI 14t`, the pane's size in pixels) and
    -- sizes its pictures by: tmux's default, 16 by 32, for a control
    -- client gives none (`docs/images.md` IM32); 0 before tmux 3.3,
    -- which does not say
    , cellW : Int
    , cellH : Int
    }


idle : {} -> State
idle _ =
    { reader = Control.reader
    , typedLine = Just ""
    , on = False
    , starting = Nothing
    , window = -1
    , name = ""
    , sessionId = -1
    , ids = []
    , panes = Builder.empty 0
    , layout = Nothing
    , active = -1
    , modal = False
    , canvas = blank 1 1
    , expecting = []
    , unasked = 0
    , settling = Settled
    , rereadKeys = False
    , heldKeys = []
    , linesSent = 0
    , shownView = ""
    , info = Dict.empty
    , drag = Nothing
    , grab = Nothing
    , mouseLast = Nothing
    , back = Dict.empty
    , selection = Nothing
    , clicks = { at = -1000, count = 0, pane = -1, point = { row = 0, col = 0 } }
    , tabs = []
    , nested = Dict.empty
    , entryHeld = Dict.empty
    , barTop = False
    , barTopConfig = False
    , keys = Bindings.follow
    , said = ""
    , audible = 0
    , paneCell = { width = 0, height = 0, limit = 10000000 }
    , paneEmbedder = Nothing
    , scans = Dict.empty
    , version = 0
    , modes = Dict.empty
    , modeKeys = "emacs"
    , asking = Nothing
    , ending = 0
    , history = Dict.empty
    , tmuxHistory = Dict.empty
    , lookTmux = False
    , startAlways = False
    , view = Nothing
    , menu = Nothing
    , serial = 0
    , numbers = Nothing
    , clock = 0
    , pollAt = -1
    , mouseOptions = Nothing
    , strayUntil = -1
    , panesMs = 1000
    , status = noStatus
    , rawStatus = noStatus
    , themes = { dark = Style.darkTheme, light = Style.lightTheme }
    , themeChoice = "detect"
    , clientName = ""
    , userRan = []
    , lightBackground = False
    , copy = Dict.empty
    , copyAsked = Dict.empty
    , paneModes = Dict.empty
    , dayAt = Nothing
    , tree = Nothing
    , listing = Nothing
    , commandNames = []
    , shortNames = []
    , aliasNames = []
    , targetSession = ""
    , caps = Caps.assumed
    , capsKnown = False
    , timeFormats = True
    , customizing = Nothing
    , dropMark = Nothing
    }


{-| The rows of history a pane's terminal keeps, and so the most of it a
capture asks for (TM119). -}
historyRows : Int
historyRows =
    1000


blank : Int -> Int -> Vt.Term
blank cols rows =
    Vt.new
        { cols = max 1 cols
        , rows = max 1 rows
        , scrollbackBytes = Vt.scrollbackBytesFor { cols = max 1 cols, rows = historyRows }
        , pageRows = Vt.defaultPageRows
        , checksums = False
        , cellWidth = 0
        , cellHeight = 0
        }


isOn : State -> Bool
isOn s =
    s.on


{-| Whether nothing more may be sent: this client is ending, and what
detaches it has gone (TM92). -}
isEnding : State -> Bool
isEnding s =
    s.ending >= 2


{-| After a batch of commands went: the one that ends this client was
the last to go (TM92). -}
afterSent : (taken s : State) -> State
afterSent s =
    if s.ending == 1 then
        { s | ending = 2 }

    else
        s


{-| Whether a command line ends this client, named `client` (empty while
it is not known): `detach-client` (`detach`) without `-a`, which detaches
the others, and with no `-t` naming another client; or `kill-server`, whose
`%exit` follows (TM92). A `-s` is taken as this client's session, which it
may not be; a detach that does not end this client is let go of when its
line fails (`replies`), and one that succeeds leaves `%exit` to come. -}
endsClient : String -> String -> Bool
endsClient client line =
    Syntax.commands (Syntax.tokens line)
        |> Array.any
            (\words ->
                let
                    values =
                        Array.map .value words
                in
                when Array.first values is
                    Just name ->
                        if name == "detach-client" || name == "detach" then
                            let
                                flags =
                                    detachFlags (Array.dropFirst 1 values) { all = False, target = Nothing }
                            in
                            not flags.all
                                && (when flags.target is
                                        Just target ->
                                            client == "" || target == client

                                        Nothing ->
                                            -- no client named: this one
                                            meant Reason.NotSet True
                                   )

                        else
                            name == "kill-server"

                    Nothing ->
                        meant Reason.NoMore False
            )


{-| `detach-client`'s flags as tmux's getopt reads them (`-aP`, `-E
command`, `-s session`, `-t client`): letters run together, and a flag
that takes a value takes the rest of its word or else the next word.
(review TA2) -}
detachFlags : Array String -> { all : Bool, target : Maybe String } -> { all : Bool, target : Maybe String }
detachFlags words acc =
    when Array.popFirst words is
        Just { first = word, rest = rest } ->
            if word == "--" || not (String.startsWith "-" word) || word == "-" then
                acc

            else
                detachLetters (String.dropFirst 1 word) rest acc

        Nothing ->
            meant Reason.NoMore acc


detachLetters : String -> Array String -> { all : Bool, target : Maybe String } -> { all : Bool, target : Maybe String }
detachLetters letters rest acc =
    when String.popFirst letters is
        Just { first = c, rest = more } ->
            if c == 'a' then
                detachLetters more rest { acc | all = True }

            else if c == 't' || c == 's' || c == 'E' then
                let
                    value =
                        if more /= "" then
                            { value = more, after = rest }

                        else
                            { value = Maybe.withDefault (meant Reason.NoMore "") (Array.first rest), after = Array.dropFirst 1 rest }

                    taken =
                        if c == 't' then
                            { acc | target = Just value.value }

                        else
                            acc
                in
                detachFlags value.after taken

            else
                detachLetters more rest acc

        Nothing ->
            meant Reason.NoMore detachFlags rest acc


title : State -> String
title s =
    "tmux: " ++ s.name


{-| A read's bytes: the terminal's own (`outside`, for its core), and
what tmux said, done to the panes. `commands` are tmux commands to write,
each a line; `trace` is what tmux said, for the diagnostic log
(`docs/diagnostics.md` DG2): each notification and reply a line, a pane's
output counted, never shown. -}
read : { cols : Int, rows : Int } -> Bytes -> (taken s : State) -> { state : State, outside : Bytes, commands : Array String, trace : Array String, view : Maybe String }
read size bytes s =
    let
        wasAsking =
            Maybe.map .ask s.asking

        r =
            readHere size bytes s

        -- a prompt a reply opened (an if-shell's, a run -C's) asks its
        -- history (TM89)
        asked =
            historyAsked wasAsking { state = r.state, commands = r.commands }
    in
    { state = asked.state, outside = r.outside, commands = asked.commands, trace = r.trace, view = r.view }


{-| `read`'s bytes, before a prompt they opened asks its history. -}
readHere : { cols : Int, rows : Int } -> Bytes -> (taken s : State) -> { state : State, outside : Bytes, commands : Array String, trace : Array String, view : Maybe String }
readHere size bytes s =
    let
        -- `[tmux] start = "always"`: any entry is expected (TM112)
        reader =
            if s.startAlways && not (Control.isAsking s.reader) then
                Control.expect True s.reader

            else
                s.reader
    in
    readEvents size (Control.feed bytes reader) s


{-| Whether the next `ESC P 1000 p` is expected: the tab's user has just
started `tmux -CC` (TM108). -}
expectEntry : Bool -> (taken s : State) -> State
expectEntry yes s =
    { s | reader = Control.expect yes s.reader }


{-| Whether a command line starts `tmux -CC` (TM108): a word that is
`tmux` or ends in `/tmux`, and after it a flag holding `CC` (`-CC`,
`-CCu`), as `tmux -CC attach` or `ssh -t host tmux -CC new -A`. -}
startsTmux : String -> Bool
startsTmux line =
    let
        words =
            String.words line
    in
    when Array.findFirst (\w -> w == "tmux" || String.endsWith "/tmux" w) words is
        Just found ->
            Array.any (\w -> String.startsWith "-" w && not (String.startsWith "--" w) && String.contains "CC" w) (Array.dropFirst (found.index + 1) words)

        Nothing ->
            meant Reason.FromOutside False


{-| A key's bytes typed outside control mode: the line kept, and on Enter
whether control mode is expected next (TM108). Erasing keys are
followed; any other control or escape sequence makes the line unknown
until the next Enter, as a recalled line is. -}
typedOutside : Bytes -> (taken s : State) -> State
typedOutside bytes s =
    if s.on then
        s

    else
        String.foldl typedChar s (Bytes.toStringLossy bytes)


typedChar : Char -> (taken st : State) -> State
typedChar c st =
    let
        code =
            Char.toCode c
    in
    if code == 0x0D || code == 0x0A then
        { st | typedLine = Just "", reader = Control.expect (Maybe.map startsTmux st.typedLine |> Maybe.withDefault (meant Reason.FromOutside False)) st.reader }

    else if code == 0x7F || code == 0x08 then
        { st | typedLine = Maybe.map (String.dropLast 1) st.typedLine }

    else if code == 0x15 || code == 0x03 then
        { st | typedLine = Just "" }

    else if code < 0x20 then
        { st | typedLine = Nothing }

    else
        { st | typedLine = Maybe.map (\l -> l ++ String.fromChar c) st.typedLine }


{-| Whether an entry that was not expected waits to be answered (TM108). -}
entryAsked : State -> Bool
entryAsked s =
    Control.isAsking s.reader


{-| The answer to an entry that was not expected: `True` follows control
mode from it, `False` gives its bytes to the terminal (TM108). -}
answerEntry : { cols : Int, rows : Int } -> Bool -> (taken s : State) -> { state : State, outside : Bytes, commands : Array String, trace : Array String, view : Maybe String }
answerEntry size yes s =
    readEvents size (Control.answer yes s.reader) s


{-| What a read's events did. -}
readEvents : { cols : Int, rows : Int } -> { reader : Control.Reader, events : Array Event } -> (taken s : State) -> { state : State, outside : Bytes, commands : Array String, trace : Array String, view : Maybe String }
readEvents size fed s =
    let
        -- each pane's bells before the output, so that one that rang is
        -- found (TM99)
        rangBefore =
            paneBells s

        done =
            Array.foldl (\e a -> event size e (traced e a)) { state = { s | reader = fed.reader }, outside = [], commands = [], trace = [], run = Nothing } fed.events
                |> endRun
                |> bellsRung rangBefore

        view =
            if done.state.on then
                viewLine done.state

            else
                ""

        changed =
            if view /= done.state.shownView then
                Just view

            else
                Nothing

        st =
            done.state
    in
    { state = { st | shownView = view }
    , outside = Bytes.flatten done.outside
    , commands = done.commands
    , trace = done.trace
    , view = changed
    }


{-| What a read did: the state, the terminal's own bytes, the commands to
write, and the log's lines with a run of one pane's output being counted. -}
type alias Acc =
    { state : State, outside : Array Bytes, commands : Array String, trace : Array String, run : Maybe { pane : Int, count : Int, bytes : Int } }


{-| An event's line in the log, before the event is done: a reply is
named by what puritty waits for from it, the first of `expecting`. -}
traced : Event -> (taken acc : Acc) -> Acc
traced e acc =
    when e is
        Notice (Output o) ->
            let
                n =
                    Bytes.length o.bytes
            in
            when acc.run is
                Just r ->
                    if r.pane == o.pane then
                        { acc | run = Just { r | count = r.count + 1, bytes = r.bytes + n } }

                    else
                        { (endRun acc) | run = Just { pane = o.pane, count = 1, bytes = n } }

                Nothing ->
                    meant Reason.NotOpen { acc | run = Just { pane = o.pane, count = 1, bytes = n } }

        _ ->
            let
                next =
                    Array.first acc.state.expecting |> Maybe.map .expect

                line =
                    describe next e
            in
            { (endRun acc) | trace = acc.trace ++ line }


{-| A run of output counted into the log, and ended. -}
endRun : (taken acc : Acc) -> Acc
endRun acc =
    when acc.run is
        Just r ->
            { acc
                | trace =
                    Array.pushLast
                        ("output %"
                            ++ String.fromInt r.pane
                            ++ " "
                            ++ String.fromInt r.bytes
                            ++ " bytes"
                            ++ (if r.count > 1 then
                                    " in " ++ String.fromInt r.count ++ " lines"

                                else
                                    ""
                               )
                        )
                        acc.trace
                , run = Nothing
            }

        Nothing ->
            meant Reason.NotOpen acc


{-| An event other than a pane's output, as the log says it. -}
describe : Maybe Expect -> Event -> Array String
describe next e =
    let
        cut n text =
            if String.count text > n then
                String.takeFirst n text ++ "…"

            else
                text
    in
    when e is
        Outside b ->
            if Bytes.isEmpty b then
                []

            else
                [ "outside control mode " ++ String.fromInt (Bytes.length b) ++ " bytes" ]

        Entered ->
            [ "control mode began" ]

        Exited ->
            [ "control mode ended" ]

        Stray ->
            [ "a line that is not tmux's: tmux asked whether it is there" ]

        Asked ->
            [ "control mode's start not expected: the user is asked" ]

        Foreign b ->
            [ "tmux answered: " ++ String.fromInt (Bytes.length b) ++ " bytes another program wrote into the terminal" ]

        Notice n ->
            [ noticeLine n ]

        Reply r ->
            let
                total =
                    Array.foldl (\l t -> t + Bytes.length l) 0 r.lines

                whose =
                    if r.flags == 0 then
                        "not puritty's command"

                    else
                        "for " ++ Maybe.withDefault (meant Reason.FromOutside "nothing waited for") (Maybe.map expectName next)

                head =
                    "reply #"
                        ++ String.fromInt r.number
                        ++ (if r.ok then
                                " ok"

                            else
                                " ERROR"
                           )
                        ++ ", "
                        ++ String.fromInt (Array.length r.lines)
                        ++ " lines, "
                        ++ String.fromInt total
                        ++ " bytes, "
                        ++ whose

                -- the lines of puritty's own questions, which say nothing
                -- typed or shown; an error's first line, which is tmux's
                shown =
                    if not r.ok then
                        Array.takeFirst 1 r.lines

                    else
                        when next is
                            Just ForWindow ->
                                Array.takeFirst 3 r.lines

                            Just ForPrefixes ->
                                Array.takeFirst 3 r.lines

                            Just ForModes ->
                                Array.takeFirst 8 r.lines

                            -- the search string is what was typed: only its
                            -- length (docs/diagnostics.md)
                            Just (ForCopy _) ->
                                Array.takeFirst 3 r.lines |> Array.map withoutSearch

                            Just ForPanesTime ->
                                Array.takeFirst 1 r.lines

                            Just ForDayTime ->
                                Array.takeFirst 1 r.lines

                            Just ForTheme ->
                                Array.takeFirst 1 r.lines

                            Just ForClientName ->
                                Array.takeFirst 1 r.lines

                            _ ->
                                meant Reason.NotKnown []
            in
            Array.pushFirst head (Array.map (\l -> "  | " ++ cut 160 (Bytes.toStringLossy l)) shown)


{-| A copy-mode state line (`copyFormat`) for the diagnostic log: the
search string, last, written by its length. -}
withoutSearch : Bytes -> Bytes
withoutSearch line =
    let
        words =
            String.split " " (Bytes.toStringLossy line)

        search =
            String.join " " (Array.dropFirst 17 words)
    in
    if Array.length words <= 17 then
        line

    else
        Bytes.fromString (String.join " " (Array.takeFirst 17 words) ++ " <" ++ String.fromInt (String.count search) ++ " chars>")


noticeLine : Notice -> String
noticeLine n =
    let
        pane p =
            "%" ++ String.fromInt p

        window w =
            "@" ++ String.fromInt w

        session x =
            "$" ++ String.fromInt x

        cut text =
            if String.count text > 120 then
                String.takeFirst 120 text ++ "…"

            else
                text
    in
    when n is
        Output o ->
            "output " ++ pane o.pane ++ " " ++ String.fromInt (Bytes.length o.bytes) ++ " bytes"

        Pause p ->
            "pause " ++ pane p

        Continue p ->
            "continue " ++ pane p

        LayoutChange l ->
            "layout-change "
                ++ window l.window
                ++ (if l.flags == "" then
                        ""

                    else
                        " flags " ++ l.flags
                   )

        WindowAdd w ->
            "window-add " ++ window w

        WindowClose w ->
            "window-close " ++ window w

        WindowRenamed r ->
            "window-renamed " ++ window r.window

        UnlinkedWindowAdd w ->
            "unlinked-window-add " ++ window w

        UnlinkedWindowClose w ->
            "unlinked-window-close " ++ window w

        UnlinkedWindowRenamed r ->
            "unlinked-window-renamed " ++ window r.window

        WindowPaneChanged c ->
            "window-pane-changed " ++ window c.window ++ " " ++ pane c.pane

        SessionChanged c ->
            "session-changed " ++ session c.session

        ClientSessionChanged c ->
            "client-session-changed " ++ session c.session

        SessionRenamed r ->
            "session-renamed " ++ session r.session

        SessionsChanged ->
            "sessions-changed"

        SessionWindowChanged c ->
            "session-window-changed " ++ session c.session ++ " " ++ window c.window

        PaneModeChanged p ->
            "pane-mode-changed " ++ pane p

        ClientDetached _ ->
            "client-detached"

        SubscriptionChanged c ->
            "subscription-changed " ++ c.name

        PasteBufferChanged _ ->
            "paste-buffer-changed"

        PasteBufferDeleted _ ->
            "paste-buffer-deleted"

        Message m ->
            "message " ++ cut m

        ConfigError m ->
            "config-error " ++ cut m

        Exit m ->
            "exit " ++ cut m

        Unknown m ->
            "unknown notification " ++ cut (String.takeFirst 40 m)


expectName : Expect -> String
expectName x =
    when x is
        ForWindow ->
            "the window"

        ForTabs ->
            "the tabs"

        ForPanes ->
            "the panes"

        ForLiving ->
            "the panes still there"

        ForInfo p ->
            "pane %" ++ String.fromInt p ++ "'s info"

        ForSaved p ->
            "pane %" ++ String.fromInt p ++ "'s saved screen"

        ForCapture p ->
            "pane %" ++ String.fromInt p ++ "'s capture"

        ForKeys ->
            "the key bindings"

        ForPrefixes ->
            "the prefixes"

        ForModes ->
            "the panes' modes"

        ForLabel ->
            "a prompt's label"

        ForInput ->
            "a prompt's answer"

        ForRan ->
            "a command run"

        ForCondition c ->
            "a condition in pane %" ++ String.fromInt c.pane

        ForNumbers ->
            "the panes' numbers"

        ForCopy _ ->
            "copy mode's state"

        ForTreeSessions ->
            "the tree's sessions"

        ForTreeWindows ->
            "the tree's windows"

        ForTreePanes ->
            "the tree's panes"

        ForTreeFilter ->
            "the tree's filter"

        ForListRows ->
            "the list's rows"

        ForCommandNames ->
            "tmux's commands"

        ForCaps ->
            "what tmux takes"

        ForPromptPaste ->
            "the newest buffer, for the prompt"

        ForPoll p ->
            "the status line's " ++ p.name

        ForTimeProbe ->
            "whether #{T:} is known"

        ForRawOptions r ->
            "the options in " ++ r.name

        ForRunExpanded _ ->
            "a run -C's commands"

        ForListFilter ->
            "the list's filter"

        ForListContent _ ->
            "a buffer's text, for the search"

        ForPromptHistory kind ->
            "tmux's " ++ kind ++ " prompt history"

        ForAliases ->
            "the command aliases"

        ForTargets _ ->
            "the sessions and windows, for -t"

        ForTargetSession ->
            "the client's session, for -t"

        ForBellWindow ->
            "the window a bell rang in"

        ForListPreview _ ->
            "the list's preview"

        ForCustomize part ->
            "customize-mode's answer " ++ String.fromInt part

        ForCustomizeNotes _ ->
            "customize-mode's key notes"

        ForCustomizeFilter _ ->
            "customize-mode's filter"

        ForCustomizeDetail _ ->
            "customize-mode's details"

        ForPreviewList _ ->
            "the tree preview's panes or windows"

        ForTreeInfo _ ->
            "the tree's information on a row"

        ForPreviewCapture c ->
            "the tree preview's capture " ++ String.fromInt c.index

        ForDayTime ->
            "the time of day"

        ForPanesTime ->
            "display-panes-time"

        ForMenuTitle _ ->
            "a menu's title"

        ForMenuName _ ->
            "a menu item's name"

        ForMenuCommand _ ->
            "a menu item's command"

        ForTheme ->
            "tmux's theme colors"

        ForClientName ->
            "this client's name"

        ForDropFolder _ ->
            "a pane's folder, for a drop"

        ForNothing ->
            "nothing (a reply not read)"

        ForFence ->
            "the end of a command's commands"


{-| What puritty shows of tmux, a line for the diagnostic log when it
changes (docs/tmux-checks.md TK11): the tabs by index, each its window's
id and name; the window shown; its panes as its layout has them, the
active one marked; the window's size, each pane's, and the panes in a
mode (copy mode and the others). -}
viewLine : State -> String
viewLine s =
    let
        n =
            String.fromInt

        panes =
            when s.layout is
                Just cell ->
                    (Layout.tiled cell ++ Layout.floating cell) |> Array.sortBy .id

                Nothing ->
                    meant Reason.NotYet []

        size =
            when s.layout is
                Just (Layout.Split c) ->
                    n c.w ++ "x" ++ n c.h

                Just (Layout.Leaf p) ->
                    n p.w ++ "x" ++ n p.h

                Nothing ->
                    meant Reason.NotYet ""
    in
    "tabs "
        ++ String.join " " (Array.map (\t -> "@" ++ n t.id ++ ":" ++ t.name) (Array.sortBy .index s.tabs))
        ++ " | window @"
        ++ n s.window
        ++ " | panes "
        ++ String.join " "
            (Array.map
                (\p ->
                    "%"
                        ++ n p.id
                        ++ (if p.id == s.active then
                                "*"

                            else
                                ""
                           )
                )
                panes
            )
        ++ " | size "
        ++ size
        ++ " | boxes "
        ++ String.join " " (Array.map (\p -> "%" ++ n p.id ++ ":" ++ n p.w ++ "x" ++ n p.h) panes)
        ++ " | modes "
        ++ String.join " "
            (Array.mapAndKeepJust
                (\p ->
                    when Dict.get p.id s.paneModes is
                        Just mode ->
                            if mode == "" then
                                Nothing

                            else
                                Just ("%" ++ n p.id ++ ":" ++ mode)

                        Nothing ->
                            meant Reason.NotYet Nothing
                )
                panes
            )


{-| A pane's line in a mark. -}
paneSaid : State -> Int -> String
paneSaid s id =
    let
        yes b =
            if b then
                "on"

            else
                "off"

        term =
            withPane id
                s
                (\t ->
                    "paste-brackets "
                        ++ yes (Dict.get 2004 t.modes == Just True)
                        ++ ", focus-reports "
                        ++ yes (Dict.get 1004 t.modes == Just True)
                        ++ ", mouse "
                        ++ yes ((Vt.mouseModes t).tracking /= Mouse.none)
                        ++ ", alt-screen "
                        ++ yes t.alt
                        ++ ", app-cursor "
                        ++ yes (Dict.get 1 t.modes == Just True)
                        ++ ", size "
                        ++ String.fromInt t.cols
                        ++ "x"
                        ++ String.fromInt t.rows
                )
                |> Maybe.withDefault (meant Reason.Gone "no terminal")

        extra =
            [ when Dict.get id s.paneModes is
                Just mode ->
                    if mode == "" then
                        ""

                    else
                        ", mode " ++ mode

                Nothing ->
                    meant Reason.NotYet ""
            , when Dict.get id s.modes is
                Just table ->
                    if table == "" then
                        ""

                    else
                        ", key table " ++ table

                Nothing ->
                    meant Reason.NotYet ""
            , when Dict.get id s.back is
                Just b ->
                    if b == 0 then
                        ""

                    else
                        ", view scrolled back " ++ String.fromInt b

                Nothing ->
                    meant Reason.NotOpen ""
            , if Dict.member id s.copy then
                ", copy mode"

              else
                ""
            , if Dict.member id s.nested then
                ", NESTED control mode (output dropped)"

              else
                ""
            ]
    in
    "  pane %"
        ++ String.fromInt id
        ++ (if id == s.active then
                " (active)"

            else
                ""
           )
        ++ ": "
        ++ term
        ++ String.join "" extra


{-| Each pane's line in a mark, walked so that nothing captures the state. -}
panesSaid : Array Int -> State -> Array String
panesSaid ids s =
    when Array.first ids is
        Just id ->
            Array.pushFirst (paneSaid s id) (panesSaid (Array.dropFirst 1 ids) s)

        Nothing ->
            meant Reason.NoMore []


{-| What the diagnostic log's mark says of control mode
(`docs/diagnostics.md` DG3): the panes, each with the modes that decide
where keys, pastes and the mouse go, and what puritty waits for. -}
diagnose : State -> Array String
diagnose s =
    let
        yes b =
            if b then
                "on"

            else
                "off"

        open =
            [ if s.asking /= Nothing then
                "a prompt"

              else
                ""
            , if s.menu /= Nothing then
                "a menu"

              else
                ""
            , if s.numbers /= Nothing then
                "pane numbers"

              else
                ""
            , if s.view /= Nothing then
                "a view"

              else
                ""
            , if s.tree /= Nothing then
                "the tree"

              else
                ""
            , if s.listing /= Nothing then
                "a list"

              else
                ""
            , if s.customizing /= Nothing then
                "customize-mode"

              else
                ""
            , if s.drag /= Nothing then
                "a drag"

              else
                ""
            ]
                |> Array.keepIf (\x -> x /= "")
    in
    if not s.on then
        [ "tmux control mode: off" ]

    else
        [ "tmux control mode: on, window @"
            ++ String.fromInt s.window
            ++ ", active pane %"
            ++ String.fromInt s.active
            ++ (if s.modal then
                    ", a modal pane"

                else
                    ""
               )
        , "  key table "
            ++ s.keys.table
            ++ (if s.keys.byTable then
                    ", keys by table (send-keys -K)"

                else
                    ", keys as bytes (tmux before 3.4)"
               )
        , "  replies no question waited for: " ++ String.fromInt s.unasked
        , "  keys held behind a binding: " ++ String.fromInt (Array.length s.heldKeys)
        , "  terminals kept: " ++ String.fromInt (Array.length s.ids) ++ " (" ++ String.join " " (Array.map (\i -> "%" ++ String.fromInt i) s.ids) ++ ")"
        , "  waiting for "
            ++ String.fromInt (Array.length s.expecting)
            ++ " replies"
            ++ (if Array.isEmpty s.expecting then
                    ""

                else
                    ": " ++ String.join "; " (Array.map (\a -> expectName a.expect) (Array.takeFirst 6 s.expecting))
               )
        , "  open: "
            ++ (if Array.isEmpty open then
                    "nothing"

                else
                    String.join ", " open
               )
        , "  selection "
            ++ (when s.selection is
                    Just sel ->
                        "made in pane %" ++ String.fromInt sel.pane

                    Nothing ->
                        meant Reason.NotOpen "none"
               )
            ++ (when s.grab is
                    Just g ->
                        ", pointer held by pane %" ++ String.fromInt g

                    Nothing ->
                        meant Reason.NotOpen ""
               )
        ]
            ++ panesSaid s.ids s


windowQuery : String
windowQuery =
    Command.display "W #{window_id} #{pane_id} #{window_visible_layout} #{window_name}"


{-| A pane's mode and `mode-keys`, a line starting with `M`. -}
modeFormat : String
modeFormat =
    "M #{pane_id} #{pane_mode} #{mode-keys}"


{-| The session's windows, each a line starting with `T`. -}
tabsQuery : String
tabsQuery =
    Command.listWindows "T #{window_id} #{window_index} #{window_name}"


{-| The window's cell size and the image limit, for the panes' terminals
(`docs/images.md` IM18). -}
setCell : { width : Int, height : Int, limit : Int } -> (taken s : State) -> State
setCell cell s =
    { s | paneCell = cell }


{-| What the panes' terminals say of themselves, the window's (IM33). -}
setEmbedder : Vt.Embedder -> (taken s : State) -> State
setEmbedder embedder s =
    { s | paneEmbedder = Just embedder }


{-| Every pane's terminal given the window's cell size and image limit,
those made since and those made before a zoom alike. -}
celled : (taken s : State) -> State
celled s =
    let
        -- each pane's cell as tmux takes it, where tmux says (IM32)
        cells =
            Array.map
                (\id ->
                    when Dict.get id s.info is
                        Just i ->
                            if i.cellW > 0 && i.cellH > 0 then
                                { width = i.cellW, height = i.cellH }

                            else
                                { width = s.paneCell.width, height = s.paneCell.height }

                        Nothing ->
                            -- a pane listed before its info is read
                            meant Reason.NotYet { width = s.paneCell.width, height = s.paneCell.height }
                )
                s.ids
    in
    { s | panes = celledFrom s.paneCell s.paneEmbedder cells 0 s.panes }


{-| Each pane's terminal given its cell, tmux's (`cells`, by the pane's
place in `ids`) or else the window's, and the window's image limit; its
pictures are drawn on the canvas scaled from that cell to the window's
(`Vt.composeStyled`, `docs/images.md` IM32). -}
celledFrom : { width : Int, height : Int, limit : Int } -> Maybe Vt.Embedder -> Array { width : Int, height : Int } -> Int -> (taken panes : Builder Vt.Term) -> (r : Builder Vt.Term where Builder.length r == Builder.length panes)
celledFrom window embedder cells i panes =
    if i < Builder.length panes then
        let
            cell =
                Array.getProven i cells

            -- the window's embedder, Kitty's pictures drawn into the cells
            -- (IM30) and Sixel's and iTerm2's drawn, and no file a pane's
            -- program names read, since tmux may run on another machine
            -- and nothing here reads a pane's (KG9); told only when it
            -- differs, since telling may answer a theme's change
            told t =
                when embedder is
                    Just e ->
                        let
                            wanted =
                                { e | extraImages = True, kittyErases = True, kittyFiles = False }
                        in
                        if Vt.embedderOf t == wanted then
                            t

                        else
                            (Vt.takeReplies (Vt.withEmbedder wanted t)).term

                    Nothing ->
                        -- before the window has told its own (setEmbedder)
                        meant Reason.NotYet (Vt.withKittyErases True (Vt.withExtraImages True t))
        in
        celledFrom window embedder cells (i + 1) (Builder.update i (\t -> told (Vt.withImageLimit window.limit (Vt.withCellSize cell t))) panes)

    else
        panes


{-| The tab bar at the top (`True`) or the bottom of the window. -}
setBar : Bool -> (taken s : State) -> State
setBar top s =
    barPlaced { s | barTopConfig = top }


{-| The bar at the top or the bottom: in tmux's look where status-position
puts tmux's status line, else where the config says. -}
barPlaced : (taken s : State) -> State
barPlaced s =
    let
        position =
            Maybe.withDefault (meant Reason.NotSet "") (Dict.get "status-position" s.status.options)
    in
    { s
        | barTop =
            if s.lookTmux && position /= "" then
                position == "top"

            else
                s.barTopConfig
    }


{-| The prompt puritty asks for tmux, in puritty's look, for the window's
box (`Dialog`): the question, what is typed and where the caret is, and the
keys that answer (TM25). -}
promptBox : State -> Maybe { title : String, typed : String, caret : Int, field : Bool, hint : String }
promptBox s =
    if s.lookTmux then
        Nothing

    else
        Maybe.map
            (\a ->
                when a.ask is
                    Syntax.Confirm c ->
                        { title = String.trim a.label, typed = "", caret = 0, field = False, hint = c.key ++ ": yes    any other key: no" }

                    Syntax.Prompt p ->
                        { title = String.trim a.label
                        , typed = String.fromArray a.chars
                        , caret = a.caret
                        , field = True
                        , hint =
                            when p.entry is
                                Syntax.Single ->
                                    "a key answers    Esc: cancel"

                                Syntax.KeyName ->
                                    "a key answers"

                                _ ->
                                    if Array.isEmpty a.matches then
                                        "Enter: run    Esc: cancel    Up, Down: earlier answers"

                                    else
                                        -- what Tab matched (TM96)
                                        String.join "  " a.matches
                        }
            )
            s.asking


{-| Whether puritty asks one of tmux's prompts, which then takes what an
input method commits and what is pasted, or shows a view (TM26), which
drops them. -}
isAsking : State -> Bool
isAsking s =
    s.asking /= Nothing || s.view /= Nothing || s.menu /= Nothing || s.numbers /= Nothing || s.tree /= Nothing || s.listing /= Nothing || s.customizing /= Nothing


{-| Text from an input method or a paste, typed into the prompt: a line
end as a space, other control characters left out; a prompt that takes a
key or digits takes none of it. -}
typeInto : String -> (taken s : State) -> State
typeInto text s =
    when s.view is
        Just v ->
            if v.filtering then
                { s | view = Just (filtered (v.filter ++ viewText (String.replace "\n" " " text)) v) }

            else
                s

        Nothing ->
            meant Reason.NotOpen typeIntoPrompt text s


typeIntoPrompt : String -> (taken s : State) -> State
typeIntoPrompt text s =
    when s.asking is
        Just a ->
            when a.ask is
                Syntax.Prompt p ->
                    if p.entry == Syntax.Text then
                        let
                            clean =
                                String.toArray text
                                    |> Array.map
                                        (\c ->
                                            if c == '\n' || c == '\r' || c == '\t' then
                                                ' '

                                            else
                                                c
                                        )
                                    |> Array.keepIf (\c -> Char.toCode c >= 0x20 && Char.toCode c /= 0x7F)
                                    |> String.fromArray
                        in
                        { s | asking = Just (insert clean a) }

                    else
                        s

                Syntax.Confirm _ ->
                    s

        Nothing ->
            meant Reason.NotOpen s


{-| Every `tmux -CC` entered at once (`True`, `[tmux] start = "always"`),
or one the tab did not start asked about (TM108, TM112). -}
setStart : Bool -> (taken s : State) -> State
setStart always s =
    { s | startAlways = always }


{-| tmux's prompts and messages in tmux's look (`True`) or puritty's. -}
setLook : Bool -> (taken s : State) -> State
setLook tmuxLook s =
    barPlaced { s | lookTmux = tmuxLook }


{-| The rows of puritty's window that are not tmux's panes: tmux's status
lines in tmux's look, as `status` says (`off` none, `2` to `5` that many,
TM54; 2.7 and 2.8 write a flag, `0` off and `1` on, TM79), else the tab
bar's one. -}
statusRows : State -> (r : Int where 0 <= r && r <= 5)
statusRows s =
    if s.lookTmux then
        when Dict.get "status" s.status.options is
            Just "off" ->
                0

            Just "0" ->
                0

            Just v ->
                clamp 1 5 (Maybe.withDefault (meant Reason.FromOutside 1) (String.toInt v))

            Nothing ->
                meant Reason.NotSet 1

    else
        1


{-| The tab bar's one row. -}
bar : Int
bar =
    1


{-| Where a pane's title has its `#[range=control|N]` parts, as
`paneBorders` lays the title out (after `#[align=right]`, against the
pane's right edge, shown when it fits): each one's N, row and columns
(TM83). -}
titleControls : State -> Layout.Pane -> Array { n : Int, row : Int, from : Int, to : Int }
titleControls s p =
    let
        tcOwn =
            Dict.get p.id s.status.panes

        tcTitle =
            Maybe.map .title tcOwn |> Maybe.withDefault (meant Reason.NotYet "")

        tcStatus =
            when Maybe.map .paneStatus tcOwn is
                Just v ->
                    if v == "" then
                        windowBorderStatus s

                    else
                        v

                Nothing ->
                    meant Reason.NotYet (windowBorderStatus s)

        tcRow =
            if tcStatus == "top" then
                p.y - 1

            else
                p.y + p.h

        tcParts =
            String.split "#[align=right]" tcTitle

        tcWidth text =
            Array.foldl (\r n -> n + String.count r.text) 0 (Style.runs Style.plain text)

        tcRoom =
            max 0 (p.w - 2)

        tcUsed =
            min tcRoom (tcWidth (Array.getProven 0 tcParts))

        tcRight =
            String.join "" (Array.dropFirst 1 tcParts)

        tcStart =
            p.x + 2 + tcRoom - tcWidth tcRight

        controls =
            String.split "#[range=" tcRight
                |> Array.dropFirst 1
                |> Array.foldl
                    (\tcSeg acc ->
                        let
                            tcSpec =
                                Array.getProven 0 (String.split "]" tcSeg)

                            tcBody =
                                String.dropFirst (String.count tcSpec + 1) tcSeg

                            tcIn =
                                Array.getProven 0 (String.split "#[norange]" tcBody)

                            n =
                                if String.startsWith "control|" tcSpec then
                                    String.toInt (String.dropFirst 8 tcSpec)

                                else
                                    Nothing
                        in
                        { at = acc.at + tcWidth tcBody
                        , spans =
                            when n is
                                Just k ->
                                    Array.pushLast { n = k, row = tcRow, from = tcStart + acc.at, to = tcStart + acc.at + tcWidth tcIn - 1 } acc.spans

                                Nothing ->
                                    -- a range of another kind, the user's
                                    -- own: not a button of tmux's
                                    meant Reason.FromOutside acc.spans
                        }
                    )
                    { at = tcWidth (Array.getProven 0 (String.split "#[range=" tcRight)), spans = [] }
                |> .spans
    in
    if (tcStatus /= "top" && tcStatus /= "bottom") || tcUsed + 1 + tcWidth tcRight > tcRoom then
        []

    else
        controls


{-| The tiled panes' `pane-border-status`, as tmux draws them, each by its
own option (inherited from the window's): the first tiled pane's, where
tmux has told it, else the one asked without a pane (`puritty-borders`),
which tmux answers for the current pane: a modal popup's own `top`
would make every pane's (TM82). -}
tiledBorderStatus : StatusLine -> Array Int -> String
tiledBorderStatus status ids =
    ids
        |> Array.mapAndKeepJust (\id -> Dict.get id status.panes |> Maybe.map .paneStatus)
        |> Array.keepIf (\v -> v /= "")
        |> Array.first
        |> Maybe.withDefault (meant Reason.NotYet status.borderStatus)


{-| `tiledBorderStatus` of the window puritty has. -}
windowBorderStatus : State -> String
windowBorderStatus s =
    tiledBorderStatus s.status
        (when s.layout is
            Just cell ->
                Layout.tiled cell |> Array.map .id

            Nothing ->
                meant Reason.NotYet []
        )


{-| A pane of the layout as tmux sizes it: its title's row (`fittedTitles`)
and, with `pane-scrollbars on`, its scrollbar's columns taken out of the
cell, on its right or, with `pane-scrollbars-position left`, its left
(TM53; measured: a 40-wide cell is a 39-wide pane). -}
fittedIn : State -> Int -> Layout.Pane -> Layout.Pane
fittedIn s height p0 =
    let
        p =
            fittedTitles (windowBorderStatus s) height p0

        sb =
            scrollbarOf s
    in
    if sb.on && p.w > sb.width then
        let
            cut =
                clamp 0 p.w sb.width
        in
        if sb.left then
            { p | x = min 16384 (p.x + cut), w = p.w - cut }

        else
            { p | w = p.w - cut }

    else
        p


{-| A pane's scrollbar as `screen_redraw_draw_pane_scrollbar` draws it
(TM53): beside the pane, in `pane-scrollbars-style`, the slider in it
reversed; out of a mode the slider at the bottom, as tall as the screen's
share of the screen and its history; in copy mode where the view is. None
on the alternate screen, and with `modal` none out of a mode. -}
scrollbarPieces : State -> Layout.Pane -> Array { row : Int, col : Int, color : String, text : String }
scrollbarPieces s p =
    let
        sb =
            scrollbarOf s

        inMode =
            Maybe.withDefault (meant Reason.NotYet "") (Dict.get p.id s.paneModes) /= ""

        alt =
            withPane p.id s (\t -> t.alt) == Just True

        h =
            p.h

        slider =
            when Dict.get p.id s.copy is
                Just c ->
                    let
                        total =
                            c.hsize + h

                        sliderH =
                            max 1 ((h * h) // max 1 total)
                    in
                    { h = sliderH, y = min (h - 1) (((h + 1) * (c.hsize - c.scroll)) // max 1 total) }

                Nothing ->
                    meant Reason.NotOpen
                        let
                            hsize =
                                Maybe.withDefault (meant Reason.Gone 0) (withPane p.id s Vt.scrollbackRows)

                            sliderH =
                                max 1 ((h * h) // max 1 (h + hsize))
                        in
                        { h = sliderH, y = h - sliderH }

        base =
            Style.apply sb.style Style.plain

        track =
            Style.sgr base

        -- the slider the track's colors swapped, as tmux draws it
        thumb =
            Style.sgr (Style.apply "reverse" base)

        col =
            if sb.left then
                p.x - sb.width

            else
                p.x + p.w

        drawCol =
            if sb.left then
                col

            else
                col + sb.pad

        shown =
            (sb.on || (sb.modal && inMode)) && not alt
    in
    if not shown || h < 1 then
        []

    else
        Array.range 0 (h - 1)
            |> Array.map
                (\j ->
                    { row = p.y + j
                    , col = drawCol
                    , color =
                        if j >= slider.y && j < slider.y + slider.h then
                            thumb

                        else
                            track
                    , text = String.repeat (sb.width - sb.pad) " "
                    }
                )


{-| A pane with its scrollbar's columns given back: the layout's cell,
which tmux's borders are drawn around (TM53). -}
withScrollbar : State -> Layout.Pane -> Layout.Pane
withScrollbar s p =
    let
        sb =
            scrollbarOf s

        give =
            clamp 0 16 sb.width
    in
    if sb.on then
        if sb.left then
            { p | x = max 0 (p.x - give), w = min 16384 (p.w + give) }

        else
            { p | w = min 16384 (p.w + give) }

    else
        p


{-| `pane-scrollbars` as puritty draws it: whether the panes give it
columns (`on`), whether it shows only in a mode (`modal`), its side, its
width with its pad (`pane-scrollbars-style`'s `width=` and `pad=`, 1 and
0 by default), and its style. -}
scrollbarOf : State -> { on : Bool, modal : Bool, left : Bool, width : Int, pad : Int, style : String }
scrollbarOf s =
    let
        option name =
            Maybe.withDefault (meant Reason.NotSet "") (Dict.get name s.status.options)

        style =
            option "pane-scrollbars-style"

        part key fallback =
            String.split "," style
                |> Array.mapAndKeepJust
                    (\w ->
                        if String.startsWith (key ++ "=") (String.trim w) then
                            String.toInt (String.dropFirst (String.count key + 1) (String.trim w))

                        else
                            Nothing
                    )
                |> Array.first
                |> Maybe.withDefault (meant Reason.NotSet fallback)

        width =
            clamp 1 16 (part "width" 1)

        pad =
            clamp 0 16 (part "pad" 0)

        mode =
            option "pane-scrollbars"
    in
    { on = s.lookTmux && mode == "on"
    , modal = s.lookTmux && mode == "modal"
    , left = option "pane-scrollbars-position" == "left"
    , width = width + pad
    , pad = pad
    , style = style
    }


{-| A tiled pane as tmux places it inside its layout cell when
`pane-border-status` is on (measured on 3.8, where no `%layout-change`
says so): a pane on the window's top edge moves down a row for its title
(`top`), one on its bottom edge gives up its last row (`bottom`); the
others' titles are on the line between panes. A floating pane keeps its
cell. -}
fittedTitles : String -> Int -> Layout.Pane -> Layout.Pane
fittedTitles borderStatus height p =
    if p.z /= Nothing || p.h < 2 then
        p

    else if borderStatus == "top" && p.y == 0 then
        { p | y = 1, h = p.h - 1 }

    else if borderStatus == "bottom" && p.y + p.h >= height then
        { p | h = p.h - 1 }

    else
        p


{-| The layout's height: its root cell's. -}
heightOf : Layout.Cell -> Int
heightOf cell =
    when cell is
        Layout.Split c ->
            c.h

        Layout.Leaf p ->
            p.h


{-| The panes where they are drawn: placed as tmux places them for their
titles, then below the bar when it is at the top. -}
placedPanes : State -> Layout.Cell -> Array Layout.Pane -> Array Layout.Pane
placedPanes s cell panes =
    Array.map
        (\p ->
            down
                (if s.barTop then
                    statusRows s

                 else
                    0
                )
                (fittedIn s (heightOf cell) p)
        )
        panes


{-| A pane of the layout where it is drawn in puritty's window: below the
tab bar when the bar is at the top, where tmux has it when at the bottom. -}
down : Int -> Layout.Pane -> Layout.Pane
down rows p =
    { p | y = min 16384 (p.y + clamp 0 16 rows) }


{-| The size puritty's window asks tmux for its panes: the canvas, less
the status line's rows (docs/tmux-checks.md TK10.10). -}
wantedSize : State -> { cols : Int, rows : Int }
wantedSize s =
    tmuxSize (statusRows s) { cols = s.canvas.cols, rows = s.canvas.rows }


{-| The size tmux is told: puritty's window less the tab bar. -}
tmuxSize : Int -> { cols : Int, rows : Int } -> { cols : Int, rows : Int }
tmuxSize statusLines size =
    { cols = size.cols, rows = max 1 (size.rows - statusLines) }


{-| Every pane of the session, each a line starting with `P`, so that none
can read as a guard. -}
panesQuery : String
panesQuery =
    Command.listPanesSession "P #{pane_id}"


{-| A pane's state, read in the same command line as its captures, so that
no output of the pane's comes between them (tmux runs one line's commands
in turn, before it reads a pane again): a capture holds the screen at one
moment, and the cursor that goes with it is read at that moment too. -}
infoOf : Int -> String
infoOf pane =
    Command.displayAt ("%" ++ String.fromInt pane)
        "P #{pane_id} #{pane_width} #{pane_height} #{cursor_x} #{cursor_y} #{alternate_on} #{scroll_region_upper} #{scroll_region_lower} #{pane_private_modes} #{mouse_standard_flag} #{mouse_button_flag} #{mouse_all_flag} #{mouse_sgr_flag} #{mouse_utf8_flag} #{keypad_cursor_flag} #{keypad_flag} #{cursor_flag} #{wrap_flag} #{origin_flag} #{window_cell_width} #{window_cell_height}"


{-| A pane's history and screen, with its colors and attributes, wrapped
lines joined; or, with `saved`, the main screen kept while the alternate
one is up. -}
captureOf : Bool -> Int -> String
captureOf saved pane =
    Command.capture saved historyRows ("%" ++ String.fromInt pane)


{-| Commands sent on one line, `a ; b ; c`, each with what its reply is
for: tmux runs them in turn with nothing between, and answers each. -}
askLine : Array { command : String, expect : Expect } -> (taken acc : Acc) -> Acc
askLine asked acc =
    let
        st =
            acc.state
    in
    { acc
        | state = expectedLine asked st
        , commands = Array.pushLast (String.join " ; " (Array.map .command asked)) acc.commands
    }


{-| Commands sent, each with what its reply is for. -}
ask : Array { command : String, expect : Expect } -> (taken acc : Acc) -> Acc
ask asked acc =
    let
        st =
            acc.state
    in
    { acc
        | state = expected asked st
        , commands = acc.commands ++ Array.map .command asked
    }


event : { cols : Int, rows : Int } -> Event -> (taken acc : Acc) -> Acc
event size e acc =
    let
        starting =
            acc.state.starting
    in
    when e is
        Outside b ->
            { acc | outside = Array.pushLast b acc.outside }

        Entered ->
            -- nothing is asked until tmux's reply to the command it was
            -- started with ends well: a mistyped command or a session that
            -- is not there ends control mode instead, and what was asked
            -- would reach the shell after it (TM70)
            let
                st =
                    acc.state
            in
            { acc | state = { st | on = True, starting = Just [], window = -1, sessionId = -1, ids = [], panes = Builder.empty 0, layout = Nothing, active = -1, canvas = blank size.cols size.rows, expecting = [], info = Dict.empty, status = noStatus, rawStatus = noStatus, capsKnown = False } }

        Exited ->
            let
                st =
                    acc.state

                -- control mode ended before it attached: what tmux said,
                -- on the terminal, as tmux without -CC says it
                said =
                    when starting is
                        Just lines ->
                            Array.map (\l -> Bytes.fromString (l ++ "\r\n")) lines

                        Nothing ->
                            meant Reason.NotOpen []
            in
            -- everything of the session that ended goes: puritty's own
            -- views (the tree, a list, customize), copy mode's view, the
            -- panes' modes, a selection; the next `tmux -CC` in this shell
            -- starts as the first did (TM102). Kept: the settings, the
            -- prompts' history, the clock, and the bells already rung,
            -- which the window counts on
            { acc
                | state =
                    let
                        fresh =
                            idle {}
                    in
                    barPlaced
                        { fresh
                            | reader = st.reader
                            , lookTmux = st.lookTmux
                            , startAlways = st.startAlways
                            , barTopConfig = st.barTopConfig
                            , lightBackground = st.lightBackground
                            , history = st.history
                            , clock = st.clock
                            , serial = st.serial
                            , audible = st.audible
                            , paneCell = st.paneCell
                            , paneEmbedder = st.paneEmbedder
                        }
                , outside = acc.outside ++ said
                , commands = []
            }

        Asked ->
            -- the user is asked (TM108); `answerEntry` goes on
            acc

        Stray ->
            -- tmux asked something it answers at once, and given up on if
            -- it does not (TK14)
            let
                st =
                    acc.state
            in
            ask [ { command = Command.probe, expect = ForNothing } ] { acc | state = { st | strayUntil = -2 } }

        Foreign b ->
            -- another program wrote into the terminal tmux runs in, as
            -- `wall` does: said on the status line, as a message
            let
                st =
                    acc.state

                text =
                    Bytes.toStringLossy b
                        |> String.lines
                        |> Array.map (\l -> String.trim (String.fromArray (Array.keepIf (\c -> Char.toCode c >= 0x20) (String.toArray l))))
                        |> Array.keepIf (\l -> l /= "")
                        |> String.join " · "
            in
            { acc | state = { st | strayUntil = -1, said = "Written to the terminal: " ++ text } }

        Reply r ->
            when starting is
                Just lines ->
                    if r.flags /= 0 then
                        acc

                    else
                        let
                            st =
                                acc.state
                        in
                        if r.ok then
                            attachQueries { acc | state = { st | starting = Nothing } }

                        else
                            { acc | state = { st | starting = Just (lines ++ Array.map Bytes.toStringLossy r.lines) } }

                Nothing ->
                    meant Reason.NotOpen reply r acc

        Notice n ->
            when { starting = starting, n = n } is
                { starting = Just lines, n = Unknown line } ->
                    let
                        st =
                            acc.state
                    in
                    { acc | state = { st | starting = Just (Array.pushLast line lines) } }

                _ ->
                    notice n acc


{-| What puritty asks when tmux has attached: the client's flags and size,
the commands, the window, its panes, the keys and the rest. -}
attachQueries : (taken acc : Acc) -> Acc
attachQueries acc =
    ask
        [ -- what this tmux takes first: the client's flags, its size and
          -- the subscriptions are asked as it takes them (TM72)
          { command = Command.listCommands, expect = ForCaps }
        , { command = windowQuery, expect = ForWindow }
        , { command = tabsQuery, expect = ForTabs }
        , { command = panesQuery, expect = ForPanes }
        , { command = Command.listKeys, expect = ForKeys }
        , { command = Command.display "#{prefix} #{prefix2} #{repeat-time} #{version}", expect = ForPrefixes }
        , { command = Command.listPanesSession modeFormat, expect = ForModes }
        , { command = Command.display "#{display-panes-time}", expect = ForPanesTime }
        , { command = Command.display "#{client_name}", expect = ForClientName }
        , { command = Command.globalValue "command-alias", expect = ForAliases }
        ]
        acc


{-| Whether a question waiting is the panes' (`panesQuery`). -}
isPanesAsk : Expect -> Bool
isPanesAsk e =
    when e is
        ForPanes ->
            True

        _ ->
            False


{-| A reply block: one of puritty's questions answered, or a command not
this client's. -}
reply : { number : Int, flags : Int, ok : Bool, lines : Array Bytes } -> (taken acc : Acc) -> Acc
reply r acc =
    if r.flags == 0 then
        -- a binding's command, run by `send-keys -K` (or a hook): the
        -- window asked again after it, outside a mode, whose every key is
        -- a binding (TK12)
        let
            asks =
                acc.state.on && acc.state.starting == Nothing && not (inCopy acc.state.active acc.state) && Dict.get acc.state.active acc.state.paneModes /= Just "tree-mode"
        in
        notOurs r acc
            |> rereadAfter
            |> (\done ->
                    if asks then
                        ask [ { command = windowQuery, expect = ForWindow } ] done
                            |> settleOn (\at -> AwaitingWindow at)

                    else
                        -- nothing asked: keys held behind the binding go
                        -- (TM109)
                        settleOn (\_ -> Settled) done
               )

    else
        ours r acc


{-| A binding's block that may have bound keys: the key tables asked
again (TA12, TM114). -}
rereadAfter : (taken acc : Acc) -> Acc
rereadAfter acc =
    if acc.state.rereadKeys then
        let
            st =
                acc.state
        in
        ask keysQueries { acc | state = { st | rereadKeys = False } }

    else
        acc


{-| A binding's block read (TM109): one awaited moves on, by `next` from
the time it began; `Settled` sends the keys held. -}
settleOn : (Int -> Settling) -> (taken acc : Acc) -> Acc
settleOn next acc =
    when settlingSince acc.state.settling is
        Just at ->
            moveSettling (next at) acc

        Nothing ->
            meant Reason.NotOpen acc


settlingSince : Settling -> Maybe Int
settlingSince settling =
    when settling is
        Settled ->
            Nothing

        AwaitingBlock at ->
            Just at

        AwaitingWindow at ->
            Just at


moveSettling : Settling -> (taken acc : Acc) -> Acc
moveSettling to acc =
    let
        st =
            acc.state
    in
    when to is
        Settled ->
            let
                r =
                    sendHeld { st | settling = Settled }
            in
            { acc | state = r.state, commands = acc.commands ++ r.commands }

        _ ->
            { acc | state = { st | settling = to } }


{-| A block not this client's: the one it was started with, a hook's, or
a key binding's (TM24). -}
notOurs : { number : Int, flags : Int, ok : Bool, lines : Array Bytes } -> (taken acc : Acc) -> Acc
notOurs r acc =
    -- a command not this client's: the one it was started
    -- with, a hook's, or a key binding's, in whose block tmux
    -- writes what `display-message` says to this client (TM24)
    when Array.findLast (\line -> String.startsWith "%message " (Bytes.toStringLossy line)) r.lines is
        Nothing ->
            meant Reason.NoMore
                if r.ok then
                    -- what a binding printed (`list-keys -N`,
                    -- `list-buffers`, `show-messages`), which a
                    -- terminal client shows in view mode (TM26)
                    if Array.isEmpty r.lines then
                        acc

                    else
                        let
                            st =
                                acc.state
                        in
                        { acc | state = { st | view = Just (viewOf (ownCommandsOut st r.lines)) } }

                else
                    -- a binding's error, as tmux's status line would
                    -- show it (TM24)
                    let
                        st =
                            acc.state
                    in
                    { acc | state = { st | said = Array.first r.lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside st.said) } }

        Just m ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | said = String.dropFirst 9 (Bytes.toStringLossy m.value) } }


{-| A block of this client's: the question that asked it answered. -}
ours : { number : Int, flags : Int, ok : Bool, lines : Array Bytes } -> (taken acc : Acc) -> Acc
ours r acc =
    let
        head =
            Array.first acc.state.expecting

        expect =
            Maybe.map .expect head |> Maybe.withDefault (meant Reason.FromOutside ForNothing)
    in
    if not (Maybe.isJust head) then
        -- a reply no question waited for: counted, and read as nothing
        let
            st =
                acc.state
        in
        { acc | state = { st | unasked = st.unasked + 1 } }

    else if expect == ForFence && Array.map Bytes.toStringLossy r.lines /= [ fenceWord ] then
        -- a block of the commands a command ran, before the fence after
        -- it (TK10): shown as the command's own
        replied ForRan r.ok r.lines acc

    else if expect == ForRan && Array.map Bytes.toStringLossy r.lines == [ fenceWord ] && Maybe.map .expect (Array.get 1 acc.state.expecting) == Just ForFence then
        -- the fence's reply where a typed line's was waited for: the line
        -- made no command (an assignment, a comment, a `%` line), and
        -- tmux sent no block for it; it is answered with nothing, and the
        -- fence then takes its own (review TA1)
        let
            st =
                acc.state
        in
        ours r (replied ForRan True [] { acc | state = { st | expecting = Array.dropFirst 1 st.expecting } })

    else
        let
            st =
                acc.state

            rest =
                Array.dropFirst 1 st.expecting

            -- a command that failed ends its line: the commands after
            -- it there are not run, and answered as failed with nothing
            -- said (TK10)
            line =
                Maybe.map .line head |> Maybe.withDefault -1

            dropped =
                if r.ok then
                    []

                else
                    Array.takeFirst (Array.findFirst (\a -> a.line /= line) rest |> Maybe.map .index |> Maybe.withDefault (meant Reason.NoMore (Array.length rest))) rest

            after =
                Array.dropFirst (Array.length dropped) rest

            -- the line that would detach this client failed: nothing
            -- detached it, and what is sent goes again (review TA2)
            ending =
                if not r.ok && st.ending >= 1 && (Maybe.map (\h -> endsClient st.clientName h.command) head |> Maybe.withDefault False) then
                    0

                else
                    st.ending

            popped =
                { acc | state = { st | expecting = after, ending = ending } }
        in
        Array.foldl (\a acc2 -> replied a.expect False [] acc2) (replied expect r.ok r.lines popped) dropped


{-| What the fence after a command that runs commands prints (TK10). -}
fenceWord : String
fenceWord =
    "puritty-fence"


{-| The bytes of the events that are a terminal's own, outside control
mode. -}
outsideOf : Array Event -> Bytes
outsideOf events =
    Array.mapAndKeepJust
        (\e ->
            when e is
                Outside b ->
                    Just b

                _ ->
                    Nothing
        )
        events
        |> Bytes.flatten


{-| A reply, by what its command was for. -}
replied : Expect -> Bool -> Array Bytes -> (taken acc : Acc) -> Acc
replied expect ok lines acc =
    when expect is
        ForDropFolder asked ->
            let
                st =
                    acc.state

                line =
                    Array.first lines |> Maybe.withDefault (meant Reason.FromOutside Bytes.empty)

                -- each part in turn, the folder read once the last has come
                next d =
                    if not ok then
                        { d | folder = NoFolder ("tmux said: " ++ Bytes.toStringLossy line), parts = [], inFlight = False }

                    else if asked.part == Array.length dropParts - 1 then
                        { d | folder = dropFolderOf (Array.pushLast line d.parts), parts = [], inFlight = False }

                    else
                        { d | parts = Array.pushLast line d.parts }

                mark =
                    when st.dropMark is
                        Just d ->
                            -- the drag may have gone to another pane meanwhile
                            if d.pane == asked.pane && d.inFlight then
                                Just (next d)

                            else
                                Just d

                        Nothing ->
                            meant Reason.NotOpen Nothing
            in
            { acc | state = { st | dropMark = mark } }

        ForWindow ->
            let
                st =
                    Array.foldl replyLine acc.state lines
            in
            -- the window answered after a binding, and no other asked
            -- behind it: the keys held go, to the pane now active (TM109)
            when st.settling is
                AwaitingWindow _ ->
                    if Array.any (\a -> a.expect == ForWindow) st.expecting then
                        { acc | state = st }

                    else
                        settleOn (\_ -> Settled) { acc | state = st }

                _ ->
                    { acc | state = st }

        ForTabs ->
            let
                st =
                    acc.state

                tabs =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split " " (Bytes.toStringLossy line) |> Array.popFirst is
                                Just { first = "T", rest = rest } ->
                                    Just
                                        { id = idOf (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 0 rest))
                                        , index = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 1 rest)))
                                        , name = String.join " " (Array.dropFirst 2 rest)
                                        }

                                _ ->
                                    meant Reason.FromOutside Nothing
                        )
                        lines
            in
            { acc | state = { st | tabs = tabs } }

        ForPanes ->
            -- each pane's state and both its captures on one line: three
            -- replies, in turn; a pane not listed is forgotten (TM110)
            let
                asked =
                    Array.foldl
                        (\line a ->
                            when String.split " " (Bytes.toStringLossy line) is
                                [ "P", id ] ->
                                    askLine (recapture (idOf id)) a

                                _ ->
                                    a
                        )
                        acc
                        lines
            in
            { asked | state = forgetGone (listedPanes lines) asked.state }

        ForLiving ->
            -- the session's panes, after one may have gone: those not
            -- listed forgotten, nothing captured (TM110)
            { acc | state = forgetGone (listedPanes lines) acc.state }

        ForInfo pane ->
            let
                st =
                    acc.state
            in
            when Array.first lines |> Maybe.andThen paneLine is
                Just d ->
                    { acc | state = { st | info = Dict.set pane d.info st.info } }

                Nothing ->
                    meant Reason.FromOutside { acc | state = st }

        ForSaved pane ->
            let
                st =
                    acc.state
            in
            { acc
                | state =
                    { st
                        | info =
                            Dict.update pane
                                (Maybe.map
                                    (\i ->
                                        { i
                                            | saved =
                                                if ok then
                                                    lines

                                                else
                                                    []
                                        }
                                    )
                                )
                                st.info
                    }
            }

        ForKeys ->
            let
                st =
                    acc.state

                tables =
                    st.keys
            in
            if ok then
                { acc | state = { st | keys = { tables | bindings = Array.foldl (\line d -> Bindings.bindingOf (Bytes.toStringLossy line) d) Dict.empty lines } } }

            else
                { acc | state = st }

        ForPrefixes ->
            let
                st =
                    acc.state

                got =
                    Bindings.prefixesOf (Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside ""))

                tables =
                    st.keys
            in
            if ok then
                { acc | state = { st | keys = { tables | prefixes = got.prefixes, repeatMs = got.repeatMs }, version = versionFrom st.caps (Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside "") |> lastPiece " ") } }

            else
                { acc | state = st }

        ForModes ->
            let
                st =
                    acc.state

                moded =
                    Array.foldl (\line m -> modeLine (Bytes.toStringLossy line) m) st lines

                -- a pane out of copy mode is drawn as it is again; one in it
                -- is asked where it is (TM31)
                left =
                    Dict.keys moded.copy |> Array.keepIf (\pane -> not (inCopy pane moded))

                cleared =
                    { moded | copy = Array.foldl Dict.remove moded.copy left, back = Array.foldl Dict.remove moded.back left }

                entered =
                    Dict.keys cleared.modes |> Array.keepIf (\pane -> inCopy pane cleared)

                clocked =
                    Dict.values cleared.paneModes |> Array.any (\m -> m == "clock-mode")

                asked =
                    Array.foldl (\pane a -> askCopy pane a) { acc | state = cleared } entered
            in
            if clocked && asked.state.dayAt == Nothing then
                -- the time of day, for the clock (TM32)
                ask [ { command = Command.display "D %H %M %S", expect = ForDayTime } ] asked

            else if not clocked then
                -- asked again when a clock is shown again, since the
                -- loop's clock starts over (RE11)
                let
                    without =
                        asked.state
                in
                { asked | state = { without | dayAt = Nothing } }

            else
                asked

        ForLabel ->
            let
                st =
                    acc.state

                text =
                    Array.first lines |> Maybe.map Bytes.toStringLossy
            in
            when { asking = st.asking, text = text, ok = ok } is
                { asking = Just a, text = Just t, ok = True } ->
                    { acc | state = { st | asking = Just { a | label = t } } }

                _ ->
                    { acc | state = st }

        ForInput ->
            let
                st =
                    acc.state

                text =
                    Array.first lines |> Maybe.map Bytes.toStringLossy
            in
            when { asking = st.asking, text = text, ok = ok } is
                { asking = Just a, text = Just t, ok = True } ->
                    if isIncremental a then
                        { acc | state = { st | asking = Just { a | recall = t } } }

                    else if a.edited then
                        { acc | state = st }

                    else
                        { acc | state = { st | asking = Just { a | chars = String.toArray t, caret = String.count t } } }

                _ ->
                    { acc | state = st }

        ForRan ->
            -- what a command run from a prompt said: its error, or its
            -- output's first line, at the bar's right (TM25)
            let
                st =
                    acc.state

                first =
                    Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside "") |> asTmuxSays

                more =
                    Array.length lines - 1
            in
            if Array.isEmpty lines then
                { acc | state = st }

            else if ok then
                -- printed: in a view, as tmux shows a command's output
                -- (TM26); `display-message`'s own words at the bar
                when Array.findLast (\line -> String.startsWith "%message " (Bytes.toStringLossy line)) lines is
                    Just m ->
                        { acc | state = { st | said = String.dropFirst 9 (Bytes.toStringLossy m.value) } }

                    Nothing ->
                        meant Reason.NoMore { acc | state = { st | view = Just (viewOf lines) } }

            else
                { acc
                    | state =
                        { st
                            | said =
                                if more > 0 then
                                    first ++ " (" ++ String.fromInt more ++ " more lines)"

                                else
                                    first
                        }
                }

        ForCondition c ->
            -- `if-shell -F`'s format answered: its branch run, then the
            -- commands after it (TM27)
            let
                value =
                    Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside "")

                ctx =
                    { pane = c.pane, mouse = c.mouse }

                branch =
                    if ok && value /= "" && value /= "0" then
                        c.yes

                    else
                        c.no

                ran =
                    runLine ctx branch acc.state

                more =
                    runLine ctx c.after ran.state
            in
            { state = more.state, outside = acc.outside, commands = acc.commands ++ ran.commands ++ more.commands, trace = acc.trace, run = acc.run }

        ForTreeSessions ->
            let
                st =
                    acc.state

                sessions =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split "\t" (Bytes.toStringLossy line) is
                                [ "S", id, attached, count, activity, name, text ] ->
                                    Just { id = idOf id, attached = attached /= "0", windows = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt count), activity = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt activity), name = name, text = text }

                                _ ->
                                    Nothing
                        )
                        lines
            in
            previewAcc { acc | state = { st | tree = Maybe.map (\t -> treeLoaded st.window st.active { t | sessions = sessions, loaded = t.loaded + 1 }) st.tree } }

        ForTreeWindows ->
            let
                st =
                    acc.state

                windows =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split "\t" (Bytes.toStringLossy line) is
                                [ "W", session, id, index, active, panes, activity, name, text ] ->
                                    Just
                                        { session = idOf session
                                        , id = idOf id
                                        , index = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt index)
                                        , active = active == "1"
                                        , panes = Maybe.withDefault (meant Reason.FromOutside 1) (String.toInt panes)
                                        , activity = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt activity)
                                        , name = name
                                        , text = text
                                        }

                                _ ->
                                    Nothing
                        )
                        lines
            in
            previewAcc { acc | state = { st | tree = Maybe.map (\t -> treeLoaded st.window st.active { t | windows = windows, loaded = t.loaded + 1 }) st.tree } }

        ForRunExpanded ctx ->
            -- run -C's string as tmux expanded it, run here (TM58)
            let
                expanded =
                    String.join "\n" (Array.map Bytes.toStringLossy lines)

                r =
                    if ok then
                        runLine ctx expanded acc.state

                    else
                        { state = acc.state, commands = [] }
            in
            { acc | state = r.state, commands = acc.commands ++ r.commands }

        ForCaps ->
            let
                st =
                    acc.state

                caps =
                    if ok then
                        Caps.fromUsage (Array.map Bytes.toStringLossy lines)

                    else
                        -- an answer tmux refused: as the newest tmux
                        Caps.assumed

                tables =
                    st.keys

                known =
                    { st
                        | caps = caps
                        , capsKnown = True
                        -- the names only: tmux completes no alias
                        -- (measured, `sel` gives `select-`)
                        , commandNames =
                            if ok then
                                Array.mapAndKeepJust (\line -> String.split " " (Bytes.toStringLossy line) |> Array.first) lines

                            else
                                st.commandNames
                        -- a usage line's `(alias)` after its name (TM96)
                        , shortNames =
                            if ok then
                                Array.mapAndKeepJust
                                    (\line ->
                                        when String.split " " (Bytes.toStringLossy line) |> Array.get 1 is
                                            Just w ->
                                                if String.startsWith "(" w && String.endsWith ")" w then
                                                    Just (String.dropFirst 1 (String.dropLast 1 w))

                                                else
                                                    Nothing

                                            Nothing ->
                                                -- a usage line with only its name
                                                meant Reason.NoMore Nothing
                                    )
                                    lines

                            else
                                st.shortNames
                        , keys = { tables | byTable = Caps.has "send-keys" "K" caps }
                    }

                flags =
                    if Caps.has "refresh-client" "f" caps then
                        [ { command = Command.clientFlags, expect = ForNothing } ]

                    else
                        []

                subscriptions =
                    if Caps.has "refresh-client" "B" caps then
                        Array.map (\sub -> { command = Command.subscribe sub, expect = ForNothing }) statusSubscriptions

                    else
                        -- before 3.2: asked, not told (TM72), once it is
                        -- known whether `#{T:…}` is (`ForTimeProbe`), which
                        -- starts the timer
                        [ { command = Command.display "#{T:version}", expect = ForTimeProbe } ]
            in
            -- the size the window has now, which a resize while this was
            -- asked has changed (TK10.10)
            ask (flags ++ [ { command = sizeCommand caps (wantedSize known), expect = ForNothing } ] ++ subscriptions) { acc | state = known }

        ForTimeProbe ->
            let
                st =
                    acc.state

                -- the timer started only now: one that fired before the
                -- answer would ask 2.7 or 2.8 for `#{T:…}`, which they
                -- answer empty (docs/tmux-checks.md TK10.9)
                known =
                    { st
                        | timeFormats = ok && (Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside "")) /= ""
                        , pollAt = Clock.after st.clock pollMs
                    }
            in
            ask (pollsFor known) { acc | state = known }

        ForRawOptions r ->
            -- the options' own text put where `#{T:option}` was, and the
            -- format asked so (TM72)
            let
                values =
                    String.split "\t" (Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside ""))

                format =
                    Array.foldl
                        (\i f ->
                            Maybe.map2 (\option value -> String.replace ("#{T:" ++ option ++ "}") value f) (Array.get i r.options) (Array.get i values)
                                |> Maybe.withDefault (meant Reason.FromOutside f)
                        )
                        r.format
                        (Array.range 0 (Array.length r.options - 1))
            in
            if ok then
                ask [ pollOf r.name r.target format ] acc

            else
                acc

        ForPoll p ->
            -- each line as the subscription would have told it
            Array.foldl
                (\line a ->
                    let
                        text =
                            Bytes.toStringLossy line

                        parts =
                            String.split "\t" text
                    in
                    if p.scope == 0 then
                        notice (SubscriptionChanged { name = p.name, window = -1, pane = -1, value = text }) a

                    else if p.scope == 1 then
                        notice (SubscriptionChanged { name = p.name, window = idOf (Array.getProven 0 parts), pane = -1, value = String.join "\t" (Array.dropFirst 1 parts) }) a

                    else
                        notice (SubscriptionChanged { name = p.name, window = idOf (Array.getProven 0 parts), pane = idOf (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 1 parts)), value = String.join "\t" (Array.dropFirst 2 parts) }) a
                )
                acc
                (if ok then
                    lines

                 else
                    []
                )

        ForCommandNames ->
            let
                st =
                    acc.state
            in
            if ok then
                -- the names only: tmux completes no alias (measured, `sel`
                -- gives `select-`)
                { acc | state = { st | commandNames = Array.mapAndKeepJust (\line -> String.split " " (Bytes.toStringLossy line) |> Array.first) lines } }

            else
                { acc | state = st }

        ForPromptPaste ->
            -- the newest buffer's first line put in at the prompt's caret,
            -- if the prompt is still up; no buffer, nothing (TM80)
            let
                st =
                    acc.state
            in
            when { asking = st.asking, line = Array.first lines } is
                { asking = Just a, line = Just line } ->
                    if ok then
                        { acc | state = { st | asking = Just (insert (promptPasted st.version (Bytes.toStringLossy line)) a) } }

                    else
                        { acc | state = st }

                _ ->
                    { acc | state = st }

        ForListRows ->
            let
                st =
                    acc.state

                -- `seq`: the place in tmux's answer, which lists buffers
                -- newest first, by tmux's own order of making
                rows =
                    Array.indexedMap
                        (\i line ->
                            when String.split "\t" (Bytes.toStringLossy line) is
                                [ "L", name, created, size, activity, text, control ] ->
                                    Just { name = name, text = text, created = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt created), size = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt size), activity = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt activity), control = control == "1", seq = i }

                                _ ->
                                    Nothing
                        )
                        lines
                        |> Array.mapAndKeepJust identity

                chosen =
                    Maybe.andThen (\l -> Array.get l.selected (listRows l) |> Maybe.map .name) st.listing
            in
            if Array.isEmpty rows then
                -- nothing to list: closed, as tmux's mode closes
                { acc | state = { st | listing = Nothing } }

            else
                let
                    updated =
                        Maybe.map
                            (\l ->
                                let
                                    next =
                                        { l | rows = rows, loaded = True, selected = 0, contents = Dict.empty }

                                    -- the row chosen before, where it is now, or the
                                    -- same place; inside the rows, or 0 when there
                                    -- are none (it was -1 then)
                                    found =
                                        Array.findFirst (\r -> Just r.name == chosen) (listRows next) |> Maybe.map .index |> Maybe.withDefault (meant Reason.Gone l.selected)
                                in
                                { next | selected = clamp 0 (max 0 (Array.length next.rows - 1)) found }
                            )
                            st.listing

                    asked =
                        listPreviewAsk { st | listing = updated }
                in
                { acc | state = asked.state, commands = acc.commands ++ asked.commands }

        ForListFilter ->
            let
                st =
                    acc.state

                names =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split "\t" (Bytes.toStringLossy line) is
                                [ "F", name, value ] ->
                                    if filterTrue value then
                                        Just name

                                    else
                                        Nothing

                                _ ->
                                    Nothing
                        )
                        lines

                none =
                    not ok || Array.isEmpty names
            in
            { acc
                | state =
                    { st
                        | listing =
                            Maybe.map
                                (\l ->
                                    { l
                                        | passing =
                                            if none then
                                                Nothing

                                            else
                                                Just names
                                        , noMatches = none
                                        , selected = 0
                                    }
                                )
                                st.listing
                    }
            }

        ForCustomize part ->
            let
                got =
                    customizeGot part
                        (if ok then
                            Array.map Bytes.toStringLossy lines

                         else
                            []
                        )
                        acc.state
            in
            { acc | state = got.state, commands = acc.commands ++ got.commands }

        ForCustomizeNotes tableName ->
            let
                got =
                    customizeNotes tableName
                        (if ok then
                            Array.map Bytes.toStringLossy lines

                         else
                            []
                        )
                        acc.state
            in
            { acc | state = got.state, commands = acc.commands ++ got.commands }

        ForCustomizeFilter f ->
            let
                got =
                    customizeFiltered f ok (Array.map Bytes.toStringLossy lines) acc.state
            in
            { acc | state = got.state, commands = acc.commands ++ got.commands }

        ForCustomizeDetail asked ->
            { acc | state = customizeDetailGot asked ok (Array.map Bytes.toStringLossy lines) acc.state }

        ForListPreview name ->
            let
                st =
                    acc.state
            in
            { acc
                | state =
                    { st
                        | listing =
                            Maybe.map
                                (\l ->
                                    if l.preview.name == name then
                                        { l | preview = { name = name, lines = Array.takeFirst 200 (Array.map Bytes.toStringLossy lines) } }

                                    else
                                        l
                                )
                                st.listing
                    }
            }

        ForBellWindow ->
            -- `Bell in window N`, as tmux says a bell in another window
            -- with `visual-bell` (`alerts_set_message`, TM99)
            when Array.first lines is
                Just line ->
                    if ok then
                        let
                            st =
                                acc.state
                        in
                        { acc | state = { st | said = "Bell in window " ++ Bytes.toStringLossy line } }

                    else
                        acc

                Nothing ->
                    meant Reason.FromOutside acc

        ForTargetSession ->
            -- the client's session, which `:…` completes a window of (TM97)
            let
                st =
                    acc.state
            in
            { acc | state = { st | targetSession = Maybe.withDefault (meant Reason.FromOutside "") (Array.first lines |> Maybe.map Bytes.toStringLossy) } }

        ForTargets at ->
            -- every session's windows, `session<TAB>index<TAB>name`: a -t
            -- or -s word completed with them, if the line is as it was
            -- when Tab asked (TM97)
            let
                rows =
                    lines
                        |> Array.mapAndKeepJust
                            (\line ->
                                when String.split "\t" (Bytes.toStringLossy line) is
                                    [ session, index, name ] ->
                                        Just { session = session, index = index, name = name }

                                    _ ->
                                        Nothing
                            )
            in
            when acc.state.asking is
                Just a ->
                    if ok && String.fromArray a.chars == at.line && a.caret == at.caret then
                        let
                            st =
                                acc.state
                        in
                        -- the client's own session, asked just before
                        if st.version >= 32 then
                            { acc | state = targetMenu rows st.targetSession a st }

                        else
                            { acc | state = { st | asking = Just (targetCompleted rows st.targetSession a) } }

                    else
                        acc

                Nothing ->
                    meant Reason.NotOpen acc

        ForAliases ->
            -- `command-alias`'s items, `name=command` a line (an array, 3.0
            -- on) or with commas between (2.x's string): the names (TM96)
            let
                names =
                    lines
                        |> Array.mapAndFlatten (\line -> String.split "," (Bytes.toStringLossy line))
                        |> Array.mapAndKeepJust
                            (\item ->
                                when String.split "=" (String.trim item) is
                                    [ name, _ ] ->
                                        Just name

                                    _ ->
                                        Nothing
                            )
            in
            if ok then
                let
                    st =
                        acc.state
                in
                { acc | state = { st | aliasNames = names } }

            else
                acc

        ForPromptHistory kind ->
            -- `History for TYPE:`, then `N: line` oldest first (TM89); an
            -- error leaves what was had
            if ok then
                let
                    st =
                        acc.state

                    entries =
                        lines
                            |> Array.map Bytes.toStringLossy
                            |> Array.mapAndKeepJust
                                (\line ->
                                    let
                                        pieces =
                                            String.split ": " line

                                        rest =
                                            Array.dropFirst 1 pieces
                                    in
                                    if rest /= [] && String.toInt (Array.getProven 0 pieces) /= Nothing then
                                        Just (String.join ": " rest)

                                    else
                                        Nothing
                                )
                in
                { acc | state = { st | tmuxHistory = Dict.set kind entries st.tmuxHistory } }

            else
                acc

        ForListContent name ->
            -- a buffer's text kept; once every buffer's is in, the search
            -- that asked for them is made (TM81)
            let
                st =
                    acc.state
            in
            when st.listing is
                Just l ->
                    let
                        withText =
                            { l | contents = Dict.set name (String.join "\n" (Array.map Bytes.toStringLossy lines)) l.contents }
                    in
                    if l.search /= "" && missingContents withText == [] then
                        let
                            searched =
                                listPreviewAsk { st | listing = Just (searchListing st.version True withText) }
                        in
                        { acc | state = searched.state, commands = acc.commands ++ searched.commands }

                    else
                        { acc | state = { st | listing = Just withText } }

                Nothing ->
                    meant Reason.NotOpen { acc | state = st }

        ForTreeFilter ->
            -- the panes the filter keeps; with none, or a filter tmux could
            -- not read, every row stays and the tree says so (TM45)
            let
                st =
                    acc.state

                ids =
                    Array.mapAndKeepJust
                        (\line ->
                            let
                                words =
                                    String.split " " (Bytes.toStringLossy line)
                            in
                            when Array.slice 0 2 words is
                                [ "F", id ] ->
                                    -- the value may hold spaces
                                    if filterTrue (String.join " " (Array.dropFirst 2 words)) then
                                        Just (idOf id)

                                    else
                                        Nothing

                                _ ->
                                    Nothing
                        )
                        lines

                none =
                    not ok || Array.isEmpty ids
            in
            previewAcc
                { acc
                    | state =
                        { st
                            | tree =
                                Maybe.map
                                    (\t ->
                                        refiltered
                                            (if none then
                                                Nothing

                                             else
                                                Just ids
                                            )
                                            { t | noMatches = none }
                                    )
                                    st.tree
                        }
                }

        ForTreePanes ->
            let
                st =
                    acc.state

                panes =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split "\t" (Bytes.toStringLossy line) is
                                [ "P", window, id, index, cmd, text ] ->
                                    Just { window = idOf window, id = idOf id, index = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt index), command = cmd, text = text }

                                _ ->
                                    Nothing
                        )
                        lines

                -- before 3.6 a window's only pane is no row of its own, and
                -- the window has nothing to open (`window_tree_build_window`,
                -- TM77)
                shown =
                    if st.version > 0 && st.version < 36 then
                        Array.keepIf (\p -> Array.length (Array.keepIf (\q -> q.window == p.window) panes) > 1) panes

                    else
                        panes
            in
            previewAcc { acc | state = { st | tree = Maybe.map (\t -> treeLoaded st.window st.active { t | panes = shown, loaded = t.loaded + 1 }) st.tree } }

        ForPreviewList serial ->
            -- the panes or windows of the row previewed, each then captured
            let
                items =
                    Array.mapAndKeepJust previewItem lines |> Array.takeFirst 12

                current =
                    Maybe.map (\t -> t.preview.serial) acc.state.tree
            in
            if current /= Just serial || not ok then
                acc

            else
                let
                    st =
                        acc.state
                in
                when st.tree is
                    Just t ->
                        let
                            pv =
                                t.preview
                        in
                        ask
                            (Array.indexedMap (\i item -> { command = Command.captureTarget item.id, expect = ForPreviewCapture { serial = serial, index = i } }) items)
                            { acc | state = { st | tree = Just { t | preview = { pv | items = items } } } }

                    Nothing ->
                        meant Reason.NotOpen { acc | state = st }

        ForTreeInfo serial ->
            let
                st =
                    acc.state
            in
            when st.tree is
                Just t ->
                    if t.preview.serial /= serial || not ok then
                        { acc | state = st }

                    else
                        let
                            pv =
                                t.preview

                            info =
                                Array.first lines |> Maybe.map (\l -> String.split "\t" (Bytes.toStringLossy l)) |> Maybe.withDefault (meant Reason.FromOutside [])
                        in
                        { acc | state = { st | tree = Just { t | preview = { pv | info = info } } } }

                Nothing ->
                    meant Reason.NotOpen { acc | state = st }

        ForPreviewCapture c ->
            let
                shown =
                    Array.map Bytes.toStringLossy lines |> trimBlank

                current =
                    Maybe.map (\t -> t.preview.serial) acc.state.tree
            in
            if current /= Just c.serial || not ok then
                acc

            else
                let
                    st =
                        acc.state
                in
                when st.tree is
                    Just t ->
                        let
                            pv =
                                t.preview
                        in
                        { acc | state = { st | tree = Just { t | preview = { pv | items = Array.update c.index (\item -> { item | lines = shown }) pv.items } } } }

                    Nothing ->
                        meant Reason.NotOpen { acc | state = st }

        ForClientName ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | clientName = Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside "") } }

        ForTheme ->
            let
                st =
                    acc.state

                -- what tmux would not take as a color, or another theme
                -- name, is the default color (`server_client_update_theme_colours`)
                colors =
                    when Array.first lines is
                        Just l ->
                            String.split "\t" (Bytes.toStringLossy l)
                                |> Array.map
                                    (\v ->
                                        if Style.isColor v && not (String.startsWith "theme" (String.toLower v)) then
                                            v

                                        else
                                            "default"
                                    )

                        Nothing ->
                            meant Reason.FromOutside []
            in
            if Array.length colors == 20 then
                let
                    next =
                        { st | themes = { dark = Array.takeFirst 10 colors, light = Array.dropFirst 10 colors } }
                in
                { acc | state = withStatus next.rawStatus next }

            else
                { acc | state = st }

        ForDayTime ->
            let
                st =
                    acc.state

                seconds =
                    when Array.first lines |> Maybe.map (\l -> String.split " " (Bytes.toStringLossy l) |> Array.map String.toInt) is
                        Just [ _, Just h, Just m, Just sec ] ->
                            Just ((h * 60 + m) * 60 + sec)

                        _ ->
                            meant Reason.FromOutside Nothing
            in
            { acc | state = { st | dayAt = Maybe.map (\day -> { clock = st.clock, ms = day * 1000 }) seconds } }

        ForCopy asked ->
            let
                -- a pane that closed in copy mode, which tmux says nothing
                -- of, answers with every field empty: forgotten, so it is
                -- not asked about again with each modes answer (TM103)
                -- Before 3.2 the question about a pane that is gone is
                -- an %error instead (TK10.1): forgotten too (the code
                -- review's TA17)
                gone =
                    not ok || (Array.first lines |> Maybe.map (\l -> String.split " " (Bytes.toStringLossy l)) |> Maybe.andThen (Array.get 1)) == Just ""

                st =
                    if gone then
                        forgetPane asked acc.state

                    else
                        acc.state

                again =
                    Dict.foldl
                        (\pane stale list ->
                            if stale then
                                Array.pushLast pane list

                            else
                                list
                        )
                        []
                        st.copyAsked

                answered =
                    Array.foldl copyLine st lines
            in
            -- a pane changed since it was asked is asked again
            Array.foldl
                (\pane a ->
                    if inCopy pane a.state then
                        askCopy pane a

                    else
                        a
                )
                { acc | state = { answered | copyAsked = Array.foldl Dict.remove answered.copyAsked again } }
                again

        ForNumbers ->
            let
                st =
                    acc.state

                indexes =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split " " (Bytes.toStringLossy line) is
                                [ "N", id, index ] ->
                                    Maybe.map (\i -> { id = idOf id, index = i }) (String.toInt index)

                                _ ->
                                    Nothing
                        )
                        lines
            in
            { acc | state = { st | numbers = Maybe.map (\n -> { n | indexes = indexes }) st.numbers } }

        ForPanesTime ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | panesMs = Array.first lines |> Maybe.andThen (\l -> String.toInt (Bytes.toStringLossy l)) |> Maybe.withDefault (meant Reason.FromOutside st.panesMs) } }

        ForMenuTitle serial ->
            { acc | state = menuPart serial (\m -> { m | title = firstLine ok lines m.title }) acc.state }

        ForMenuName part ->
            { acc | state = menuPart part.serial (\m -> { m | items = Array.update part.item (\it -> { it | name = firstLine ok lines it.name }) m.items }) acc.state }

        ForMenuCommand part ->
            { acc | state = menuPart part.serial (\m -> { m | items = Array.update part.item (\it -> { it | command = firstLine ok lines it.command }) m.items }) acc.state }

        ForCapture pane ->
            if ok then
                { acc | state = rebuild pane lines acc.state }

            else
                acc

        ForNothing ->
            acc

        ForFence ->
            acc


{-| A pane's state and both its captures, for one line: made again from
one moment (TM15). -}
recapture : Int -> Array { command : String, expect : Expect }
recapture pane =
    [ { command = infoOf pane, expect = ForInfo pane }
    , { command = captureOf True pane, expect = ForSaved pane }
    , { command = captureOf False pane, expect = ForCapture pane }
    ]


{-| A line of `panesQuery`'s answer. -}
paneLine : Bytes -> Maybe { id : Int, info : PaneInfo }
paneLine bytes =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)

        int i =
            Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt (Maybe.withDefault (meant Reason.FromOutside "") (Array.get i words)))
    in
    if Array.get 0 words /= Just "P" then
        Nothing

    else
        Just
            { id = idOf (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 1 words))
            , info =
                { w = int 2
                , h = int 3
                , x = int 4
                , y = int 5
                , alt = int 6 == 1
                , top = int 7
                , bottom = int 8
                , modes =
                    let
                        private =
                            String.split "," (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 9 words)) |> Array.mapAndKeepJust String.toInt

                        -- before 3.8 `pane_private_modes` is empty: the
                        -- modes from tmux's older flags (TM61; measured on
                        -- 3.6a), bracketed paste having none; the cursor
                        -- shown, wrapping and origin mode too (TM71,
                        -- measured on 3.4), or every pane's cursor was
                        -- hidden
                        flag i mode =
                            if int i == 1 then
                                [ mode ]

                            else
                                []
                    in
                    if not (Array.isEmpty private) then
                        private

                    else
                        flag 10 1000 ++ flag 11 1002 ++ flag 12 1003 ++ flag 13 1006 ++ flag 14 1005 ++ flag 15 1 ++ flag 16 66 ++ flag 17 25 ++ flag 18 7 ++ flag 19 6
                , saved = []
                -- empty before tmux 3.1 (recorded on 3.0 and 2.7): 0, the
                -- window's own cell kept
                , cellW = Array.get 20 words |> Maybe.andThen String.toInt |> Maybe.withDefault (meant Reason.FromOutside 0)
                , cellH = Array.get 21 words |> Maybe.andThen String.toInt |> Maybe.withDefault (meant Reason.FromOutside 0)
                }
            }


{-| A pane's terminal made again from its capture: the main screen's lines,
then, with the alternate screen up, that screen's; the private modes that
are on; the scroll region; the cursor. Whatever the pane printed before
the capture's reply is in the capture, so what its terminal held is
dropped (TM5.8). -}
rebuild : Int -> Array Bytes -> (taken s : State) -> State
rebuild pane lines s =
    when Dict.get pane s.info is
        Nothing ->
            meant Reason.NotYet s

        Just i ->
            let
                screen ls =
                    Bytes.flatten (Array.intersperse (Bytes.fromString "\u{001B}[0m\r\n") ls)

                modes =
                    Array.map (\m -> "\u{001B}[?" ++ String.fromInt m ++ "h") i.modes
                        ++ (if Array.member 25 i.modes then
                                []

                            else
                                [ "\u{001B}[?25l" ]
                           )
                        ++ (if Array.member 7 i.modes then
                                []

                            else
                                [ "\u{001B}[?7l" ]
                           )

                region =
                    if i.top > 0 || i.bottom < i.h - 1 then
                        "\u{001B}[" ++ String.fromInt (i.top + 1) ++ ";" ++ String.fromInt (i.bottom + 1) ++ "r"

                    else
                        ""

                cursor =
                    "\u{001B}[" ++ String.fromInt (i.y + 1) ++ ";" ++ String.fromInt (i.x + 1) ++ "H"

                made =
                    blank i.w i.h
                        |> Vt.feed
                            (screen
                                (if i.alt then
                                    i.saved

                                 else
                                    lines
                                )
                            )
                        |> Vt.feed
                            (Bytes.fromString
                                (if i.alt then
                                    "\u{001B}[0m\u{001B}[?1049h\u{001B}[H"

                                 else
                                    "\u{001B}[0m"
                                )
                            )
                        |> (\t ->
                                if i.alt then
                                    Vt.feed (screen lines) t

                                else
                                    t
                           )
                        |> Vt.feed (Bytes.fromString ("\u{001B}[0m" ++ String.join "" modes ++ region ++ cursor))

                term =
                    (Vt.takeReplies made).term
            in
            when Array.findFirst (\x -> x == pane) s.ids is
                Just found ->
                    { s | panes = Builder.set found.index term s.panes }

                Nothing ->
                    meant Reason.NotYet { s | ids = Array.pushLast pane s.ids, panes = Builder.pushLast term s.panes }


{-| A line of `modeFormat`: the pane's mode's key table kept, copy mode's
and view mode's by `mode-keys` (`window_copy_key_table`); the other modes
take keys without a table (TM25). -}
modeLine : String -> (taken s : State) -> State
modeLine line s =
    when String.split " " line is
        [ "M", id, mode, modeKeys ] ->
            let
                table =
                    if mode == "copy-mode" || mode == "view-mode" then
                        if modeKeys == "vi" then
                            "copy-mode-vi"

                        else
                            "copy-mode"

                    else
                        ""
            in
            { s
                | modes = Dict.set (idOf id) table s.modes
                , paneModes = Dict.set (idOf id) mode s.paneModes
                , modeKeys =
                    if modeKeys == "" then
                        s.modeKeys

                    else
                        modeKeys
            }

        _ ->
            s


{-| A line of `windowQuery`'s answer: `W @window %pane layout name`. -}
replyLine : Bytes -> (taken s : State) -> State
replyLine bytes s =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)
    in
    when Array.get 0 words is
        Just "W" ->
            -- the active pane asked with the window: a layout before 3.4's
            -- new-layouts does not mark it, and keys go nowhere without it
            -- (TM24)
            let
                shown =
                    showWindow (idOf (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 1 words))) (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 3 words)) (String.join " " (Array.dropFirst 4 words)) s

                pane =
                    idOf (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 2 words))
            in
            if pane >= 0 then
                { shown | active = pane }

            else
                shown

        _ ->
            meant Reason.FromOutside s


idOf : String -> Int
idOf w =
    Maybe.withDefault (meant Reason.FromOutside -1) (String.toInt (String.dropFirst 1 w))


showWindow : Int -> String -> String -> (taken s : State) -> State
showWindow window layoutText name s =
    if window < 0 then
        s

    else
        applyLayout layoutText
            { s
                | window = window
                , name =
                    if name == "" then
                        s.name

                    else
                        name
            }


notice : Notice -> (taken acc : Acc) -> Acc
notice n acc =
    let
        st =
            acc.state
    in
    when n is
        Output o ->
            when Dict.get o.pane st.nested is
                Just inner ->
                    -- a nested client's control mode, dropped until it ends
                    let
                        fed =
                            nestedFeed o.bytes inner

                        nested =
                            if Control.isInside fed.reader then
                                Dict.set o.pane fed.reader st.nested

                            else
                                Dict.remove o.pane st.nested
                    in
                    { acc | state = feedPane o.pane (outsideOf fed.events) { st | nested = nested } }

                Nothing ->
                    meant Reason.NotOpen
                        (outputOutside o.pane o.bytes { acc | state = st })

        LayoutChange l ->
            if l.window == st.window || st.window < 0 then
                let
                    placed =
                        layoutIds st.layout

                    next =
                        applyLayout l.visible { st | window = l.window, modal = String.contains "O" l.flags }
                in
                -- a pane the layout no longer has closed, or moved to
                -- another window: which, asked (TM110)
                if Array.any (\i -> not (Array.member i (layoutIds next.layout))) placed then
                    ask [ { command = panesQuery, expect = ForLiving } ] { acc | state = next }

                else
                    { acc | state = next }

            else
                -- another window's, as a resize sends for each (TK10.10):
                -- its panes' terminals sized now, so that what their
                -- programs draw for the new size has room (the code
                -- review's TA13, TM115)
                { acc | state = sizeHidden l.visible st }

        WindowPaneChanged p ->
            if p.window == st.window then
                { acc | state = { st | active = p.pane } }

            else
                { acc | state = st }

        SessionWindowChanged _ ->
            -- another window of the session shown: ask for its layout
            ask [ { command = windowQuery, expect = ForWindow } ] { acc | state = st }

        SessionChanged c ->
            -- the session tmux attached for, said right after the attach,
            -- while the attach's own questions about it wait: nothing more
            -- to ask, or each pane would be captured twice (TA9, TM124)
            if (st.sessionId == -1 || st.sessionId == c.session) && Array.any (\a -> isPanesAsk a.expect) st.expecting then
                { acc | state = { st | sessionId = c.session } }

            else
                -- another session's panes, and their modes, which are asked
                -- when tmux attaches for that session's only: one already in
                -- copy mode is shown so (TM102)
                ask
                    [ { command = windowQuery, expect = ForWindow }
                    , { command = tabsQuery, expect = ForTabs }
                    , { command = panesQuery, expect = ForPanes }
                    , { command = Command.listPanesSession modeFormat, expect = ForModes }
                    ]
                    { acc | state = { st | sessionId = c.session } }

        Pause pane ->
            -- puritty fell behind on the pane and tmux dropped what was
            -- queued (TM19): continue it, and on the same line make it
            -- again from one moment, so nothing between is lost
            askLine ([ { command = Command.continuePane pane, expect = ForNothing } ] ++ recapture pane) { acc | state = st }

        Exit reason ->
            -- control mode ends here, however it was ended: nothing asked
            -- earlier in the read, or after it before tmux's `ESC \`, is
            -- written, which would be typed into the shell it leaves (the
            -- code review's TA14; TM92 for the user's own detach)
            let
                ended =
                    { st | ending = 2 }
            in
            -- why the panes go: said on the terminal they leave behind
            if reason == "" then
                { acc | state = ended, commands = [] }

            else
                { acc | state = ended, commands = [], outside = Array.pushLast (Bytes.fromString ("\r\npuritty: tmux control mode ended: " ++ reason ++ "\r\n")) acc.outside }

        WindowAdd _ ->
            ask [ { command = tabsQuery, expect = ForTabs } ] { acc | state = st }

        WindowClose _ ->
            -- its panes went with it: forgotten (TM110)
            ask [ { command = tabsQuery, expect = ForTabs }, { command = panesQuery, expect = ForLiving } ] { acc | state = st }

        UnlinkedWindowClose w ->
            -- before tmux 3.8 a window of this session closing is said so
            -- too, its last pane's program ended or killed (measured,
            -- docs/tmux-checks.md TK11); another session's is not a tab
            if Array.any (\t -> t.id == w) st.tabs then
                ask [ { command = tabsQuery, expect = ForTabs }, { command = panesQuery, expect = ForLiving } ] { acc | state = st }

            else
                { acc | state = st }

        UnlinkedWindowRenamed r ->
            -- a window of this session is named so while it is made (TK11)
            { acc
                | state =
                    { st
                        | tabs =
                            Array.map
                                (\t ->
                                    if t.id == r.window then
                                        { t | name = r.name }

                                    else
                                        t
                                )
                                st.tabs
                    }
            }

        Message text ->
            { acc | state = { st | said = text } }

        PaneModeChanged pane ->
            ask [ { command = Command.displayAt ("%" ++ String.fromInt pane) modeFormat, expect = ForModes } ] { acc | state = st }

        SubscriptionChanged sub ->
            if sub.name == "puritty-theme" then
                themeAsked sub.value { acc | state = st }

            else
                let
                    was =
                        windowBorderStatus st

                    barWas =
                        scrollbarOf st

                    rowsWas =
                        statusRows st

                    next =
                        barPlaced (withStatus (subscribed sub.name sub.window sub.pane sub.value st.rawStatus) st)

                    barNow =
                        scrollbarOf next

                    -- `status` changed how many rows tmux's panes have: tmux
                    -- told the new size (TM54)
                    resize =
                        if statusRows next /= rowsWas then
                            [ sizeCommand next.caps (tmuxSize (statusRows next) { cols = next.canvas.cols, rows = next.canvas.rows }) ]

                        else
                            []

                    -- sent as every command is, its reply waited for: sent
                    -- bare, its empty reply took the next question's place
                    -- (the code review's TA5, TB3)
                    asked =
                        Array.map (\c -> { command = c, expect = ForNothing }) resize
                in
                if windowBorderStatus next /= was || barNow.on /= barWas.on || barNow.width /= barWas.width || barNow.left /= barWas.left then
                    -- the panes' sizes change with their titles' rows, and
                    -- tmux sends no layout for it
                    ask asked { acc | state = refit next }

                else
                    ask asked { acc | state = next }

        WindowRenamed r ->
            let
                tabs =
                    Array.map
                        (\t ->
                            if t.id == r.window then
                                { t | name = r.name }

                            else
                                t
                        )
                        st.tabs
            in
            if r.window == st.window then
                { acc | state = { st | name = r.name, tabs = tabs } }

            else
                { acc | state = { st | tabs = tabs } }

        _ ->
            { acc | state = st }


{-| A pane's output where no nested client's control mode is open: the
start of `ESC P 1000 p` it ends with is held to be joined to the pane's
next output, since tmux cuts a pane's output anywhere (the code review's
TP13), and a nested `tmux -CC` is found in the whole of it. -}
outputOutside : Int -> Bytes -> (taken acc : Acc) -> Acc
outputOutside pane more acc =
    let
        prior =
            acc.state

        carried =
            Control.carryEntry (Maybe.withDefault (meant Reason.NotSet Bytes.empty) (Dict.get pane prior.entryHeld)) more

        bytes =
            carried.bytes

        st =
            { prior
                | entryHeld =
                    if Bytes.isEmpty carried.held then
                        Dict.remove pane prior.entryHeld

                    else
                        Dict.set pane carried.held prior.entryHeld
            }
    in
    if Bytes.isEmpty bytes then
        { acc | state = st }

    else if Control.startsControl bytes then
        -- `tmux -CC` run inside a pane (TM19): what it sends in
        -- control mode is dropped and the pane says why; no
        -- key is sent for it, since the bytes may be any
        -- program's (the code review's TA15), and a line
        -- that is not tmux's ends it
        let
            fed =
                nestedFeed bytes (Control.strict (Control.expect True Control.reader))

            said =
                feedPane pane
                    (Bytes.flatten
                        [ outsideOf fed.events
                        , if Control.isInside fed.reader then
                            Bytes.fromString "\r\npuritty: tmux -CC inside a tmux pane is not shown; an empty line (Enter) detaches it.\r\n"

                          else
                            Bytes.empty
                        ]
                    )
                    { st
                        | nested =
                            if Control.isInside fed.reader then
                                Dict.set pane fed.reader st.nested

                            else
                                st.nested
                    }
        in
        { acc | state = said }

    else
        let
            copying =
                inCopy pane st

            caps =
                st.caps

            -- what a program asked past tmux, answered
            -- into its pane (IM33)
            out =
                feedOutput pane bytes st

            answered =
                if Array.isEmpty out.replies then
                    { state = out.state, commands = [] }

                else
                    sent (bytesTo caps pane (Bytes.flatten out.replies)) out.state

            next =
                { acc | state = answered.state, commands = acc.commands ++ answered.commands }
        in
        if copying then
            -- tmux keeps a copy mode's view where it was as
            -- lines arrive: asked again (TM31)
            askCopy pane next

        else
            next


{-| A hash of each of a selection's rows on the pane's screen, by row,
as `Main.rowHashes` (TM91). -}
selRowHashes : Sel -> Vt.Term -> Dict Int Int
selRowHashes sel t =
    let
        pushed =
            Vt.rowsPushed t

        lo =
            max pushed (min sel.anchor.row sel.head.row)

        hi =
            min (pushed + t.rows - 1) (max sel.anchor.row sel.head.row)
    in
    Array.foldl (\r d -> Dict.set r (Vt.rowsHash r r t) d) Dict.empty (Array.range lo hi)


{-| Whether a selection stays after its pane's output, as `Main.kept`: while
the pane shows the screen it was made on and none of its rows still on the
screen changed (TM91). -}
selKept : Sel -> Vt.Term -> Bool
selKept sel t =
    if sel.alt /= t.alt then
        False

    else if not sel.made then
        True

    else
        let
            pushed =
                Vt.rowsPushed t
        in
        Dict.foldl (\r h ok -> ok && (r < pushed || Vt.rowsHash r r t == h)) True sel.hashes


{-| A pane's output fed to its terminal, made at a guessed size if tmux
has not yet said where it goes; its replies dropped. -}
feedPane : Int -> Bytes -> (taken s : State) -> State
feedPane id bytes s =
    let
        -- the pane's place among `ids`, which is its terminal's in `panes`
        -- (`State`'s rule)
        at =
            Array.findIndex (\i -> i == id) s.ids
    in
    if at >= 0 then
        let
            back =
                backOf id s

            pushedBefore =
                if back > 0 then
                    Vt.rowsPushed (Builder.getProven at s.panes)

                else
                    0

            fed0 =
                { s | panes = Builder.update at (\t -> (Vt.takeReplies (Vt.feed bytes t)).term) s.panes }

            -- a selection in the pane goes when its screen or rows change
            -- (TM91)
            fed =
                when fed0.selection is
                    Just sel ->
                        if sel.pane == id && not (selKept sel (Builder.getProven at fed0.panes)) then
                            { fed0 | selection = Nothing }

                        else
                            fed0

                    Nothing ->
                        meant Reason.NotOpen fed0
        in
        if back > 0 then
            -- a view scrolled back stays on its rows as more come in
            let
                t =
                    Builder.getProven at fed.panes

                after =
                    { pushed = Vt.rowsPushed t, most = Vt.scrollbackRows t }
            in
            { fed | back = Dict.set id (min after.most (back + after.pushed - pushedBefore)) fed.back }

        else
            fed

    else
        { s | ids = Array.pushLast id s.ids, panes = Builder.pushLast (Vt.takeReplies (Vt.feed bytes (blank 80 24))).term s.panes }


{-| A pane's output fed to its terminal as `feedPane` feeds it, but for
the sequences a program wrapped in tmux's passthrough envelope
(`Tmux.Passthrough`): tmux reads those to no terminal of a control
client's, so they are fed unwrapped and what the pane's terminal answers
is kept, for the pane (`docs/images.md` IM33). Outside an envelope the
replies are dropped, as tmux has answered them. -}
feedOutput : Int -> Bytes -> (taken s : State) -> { state : State, replies : Array Bytes }
feedOutput id bytes s =
    let
        got =
            Passthrough.split bytes (Maybe.withDefault (meant Reason.NotYet Passthrough.idle) (Dict.get id s.scans))

        scanned =
            if got.scan == Passthrough.idle then
                { s | scans = Dict.remove id s.scans }

            else
                { s | scans = Dict.set id got.scan s.scans }
    in
    Array.foldl
        (\part acc ->
            if part.inside then
                let
                    r =
                        feedAnswering id part.bytes acc.state
                in
                { state = r.state, replies = acc.replies ++ r.replies }

            else
                { state = feedPane id part.bytes acc.state, replies = acc.replies }
        )
        { state = scanned, replies = [] }
        got.parts


{-| A pane's terminal fed, what it answers kept: taken out of `panes` and
set back, so that it is fed in place. The view scrolled back and the
selection are left as they were: an envelope's sequence is a question or
a picture. -}
feedAnswering : Int -> Bytes -> (taken s : State) -> { state : State, replies : Array Bytes }
feedAnswering id bytes s =
    let
        at =
            Array.findIndex (\i -> i == id) s.ids
    in
    if at < 0 then
        { state = feedPane id bytes s, replies = [] }

    else
        let
            out =
                Builder.swap at (blank 1 1) s.panes
        in
        when out.old is
            Just t ->
                let
                    r =
                        Vt.takeReplies (Vt.feed bytes t)
                in
                { state = { s | panes = Builder.set at r.term out.builder }, replies = r.replies }

            Nothing ->
                meant Reason.NotYet { state = { s | panes = out.builder }, replies = [] }


{-| A layout: its panes' terminals made or sized to their boxes. -}
applyLayout : String -> (taken s : State) -> State
applyLayout text s =
    withoutOrphans (laidOut text s)


{-| The modes puritty draws for a pane that is no longer in the layout
shown closed: the tree, a list, customize mode, a menu, the panes'
numbers. Not drawn, they still took every key, so typing did nothing
seen until q or Escape happened to be pressed; zoomed, one stayed over
another window shown (the code review's TB14). -}
withoutOrphans : (taken s : State) -> State
withoutOrphans s =
    let
        here =
            layoutIds s.layout

        inLayout pane =
            Array.member pane here
    in
    { s
        | tree =
            Maybe.andThen
                (\t ->
                    if inLayout t.pane then
                        Just t

                    else
                        Nothing
                )
                s.tree
        , listing =
            Maybe.andThen
                (\l ->
                    if inLayout l.pane then
                        Just l

                    else
                        Nothing
                )
                s.listing
        , customizing =
            Maybe.andThen
                (\c ->
                    if inLayout c.pane then
                        Just c

                    else
                        Nothing
                )
                s.customizing
        , menu =
            Maybe.andThen
                (\m ->
                    if inLayout m.pane then
                        Just m

                    else
                        Nothing
                )
                s.menu
        , numbers =
            Maybe.andThen
                (\n ->
                    if inLayout n.pane then
                        Just n

                    else
                        Nothing
                )
                s.numbers
    }


laidOut : String -> (taken s : State) -> State
laidOut text s =
    when Layout.parse text is
        Ok cell ->
            let
                active =
                    when Array.findFirst .active (Layout.panes cell) is
                        Just a ->
                            a.value.id

                        Nothing ->
                            meant Reason.FromOutside s.active
            in
            -- each pane sized as it is drawn, `fittedIn` the new layout:
            -- its title's row and its scrollbar's columns (TM53, the code
            -- review's TA11)
            refit { s | layout = Just cell, active = active }

        Err _ ->
            meant Reason.FromOutside s


{-| The panes of a window not shown sized to its layout, the shown one's
left as it is (TM115). -}
sizeHidden : String -> (taken s : State) -> State
sizeHidden text s =
    when Layout.parse text is
        Ok cell ->
            let
                boxes =
                    Array.map (fittedIn s (heightOf cell)) (Layout.panes cell)

                sized =
                    sizeAll { ids = s.ids, panes = s.panes } boxes
            in
            { s | ids = sized.ids, panes = sized.panes }

        Err _ ->
            meant Reason.FromOutside s


{-| Every pane sized again to the layout as it is placed now. -}
refit : (taken s : State) -> State
refit s =
    when s.layout is
        Just cell ->
            let
                boxes =
                    Array.map (fittedIn s (heightOf cell)) (Layout.panes cell)

                sized =
                    sizeAll { ids = s.ids, panes = s.panes } boxes
            in
            { s | ids = sized.ids, panes = sized.panes }

        Nothing ->
            meant Reason.NotYet s


{-| Every pane of the layout sized, or made, in turn: a loop rather than a
fold, so that the compiler sees each step keep the ids and the terminals
as many as each other (TM34). -}
sizeAll : (taken acc : { ids : Array Int, panes : Builder Vt.Term } where Array.length acc.ids == Builder.length acc.panes) -> Array Layout.Pane -> (r : { ids : Array Int, panes : Builder Vt.Term } where Array.length r.ids == Builder.length r.panes)
sizeAll acc boxes =
    when Array.popFirst boxes is
        Just { first, rest } ->
            sizeAll (sizePane first acc) rest

        Nothing ->
            meant Reason.NoMore acc


sizePane : Layout.Pane -> (taken acc : { ids : Array Int, panes : Builder Vt.Term } where Array.length acc.ids == Builder.length acc.panes) -> (r : { ids : Array Int, panes : Builder Vt.Term } where Array.length r.ids == Builder.length r.panes)
sizePane place acc =
    when Array.findFirst (\i -> i == place.id) acc.ids is
        Just found ->
            { ids = acc.ids
            , panes =
                Builder.update found.index
                    (\t ->
                        if t.cols /= place.w || t.rows /= place.h then
                            Vt.resize (max 1 place.w) (max 1 place.h) t

                        else
                            t
                    )
                    acc.panes
            }

        Nothing ->
            meant Reason.NotYet { ids = Array.pushLast place.id acc.ids, panes = Builder.pushLast (blank place.w place.h) acc.panes }


{-| The window's picture made again: the tiled panes with lines between,
the floating ones over them in boxes, the bottom first, and the cursor at
the active pane's. -}
paint : (taken s : State) -> State
paint s0 =
    let
        s =
            celled s0
    in
    when s.layout is
        Nothing ->
            meant Reason.NotYet s

        Just cell ->
            let
                tiled =
                    placedPanes s cell (Layout.tiled cell)

                floating =
                    placedPanes s cell (Layout.floating cell)

                -- the status line's first row; with `status off` the last
                -- row, where tmux's prompts and messages go over the panes
                barRow =
                    if s.barTop then
                        0

                    else
                        s.canvas.rows - max 1 (statusRows s)

                -- tmux's colors and bar, made once a frame (review TB10)
                colors =
                    colorsOf s.status

                tmuxBarNow =
                    if s.lookTmux then
                        tmuxBar cols barRow s

                    else
                        { pieces = [], hits = [] }

                tabBar =
                    if s.lookTmux then
                        { text = "", active = [], alerted = [], busy = [], hits = tmuxBarNow.hits }

                    else
                        tabsOf cols barRow s

                -- in tmux's look, a prompt or a message over the whole bar, as
                -- tmux shows them on its status line (TM25)
                -- where a prompt is asked: the status line, or the active
                -- pane's last row for `command-prompt -P`, as 3.8's copy
                -- mode asks its searches (TM42)
                -- a mode tree's own questions (3.8's tree, lists and
                -- customize-mode) on the mode's last row, or its first with
                -- the status line at the top (`mode_tree_draw_prompt`, TM66)
                modeOpen =
                    when { tree = s.tree, listing = s.listing, customizing = s.customizing } is
                        { tree = Just t, listing = _, customizing = _ } ->
                            Just { zoom = t.zoom, pane = t.pane }

                        { tree = Nothing, listing = Just l, customizing = _ } ->
                            Just { zoom = l.zoom, pane = l.pane }

                        { tree = Nothing, listing = Nothing, customizing = Just c } ->
                            Just { zoom = c.zoom, pane = c.pane }

                        _ ->
                            Nothing

                promptAt =
                    when { asking = s.asking, mode = Maybe.andThen (modePlace s cols rows (tiled ++ floating)) modeOpen, place = Array.findFirst (\p -> p.id == s.active) (tiled ++ floating) |> Maybe.map .value } is
                        { asking = Just a, mode = Just place, place = _ } ->
                            if askedInPane a then
                                { row =
                                    if Dict.get "status-position" s.status.options == Just "top" then
                                        place.y

                                    else
                                        place.y + place.h - 1
                                , col = place.x
                                , width = place.w
                                }

                            else
                                { row = barRow, col = 0, width = cols }

                        { asking = Just a, mode = Nothing, place = Just place } ->
                            if askedInPane a then
                                { row = place.y + place.h - 1, col = place.x, width = place.w }

                            else
                                { row = barRow, col = 0, width = cols }

                        _ ->
                            { row = barRow, col = 0, width = cols }

                promptClear =
                    when s.asking is
                        Just a ->
                            -- a mode tree's questions leave the row's rest as it
                            -- is (`mode_tree_draw_prompt`, measured on 3.8's
                            -- customize-mode, TM62); `command-prompt -P`
                            -- clears it
                            if s.lookTmux && askedInPane a && modeOpen == Nothing then
                                [ { row = promptAt.row, col = promptAt.col, text = String.repeat promptAt.width " " } ]

                            else
                                []

                        Nothing ->
                            meant Reason.NotOpen []

                tmuxLine =
                    if not s.lookTmux then
                        []

                    else
                        when s.asking is
                            Just a ->
                                if askedInPane a then
                                    -- in the pane, only the prompt's text
                                    -- and a cell after it are colored, the
                                    -- rest of the row blank (promptClear)
                                    [ { row = promptAt.row, col = promptAt.col, text = String.takeFirst promptAt.width (a.label ++ String.fromArray a.chars ++ " ") } ]

                                else
                                    [ { row = promptAt.row, col = promptAt.col, text = String.padRight promptAt.width ' ' (String.takeFirst promptAt.width (a.label ++ String.fromArray a.chars)) } ]

                            Nothing ->
                                meant Reason.NotOpen
                                    if s.said == "" then
                                        []

                                    else
                                        [ { row = barRow, col = 0, text = String.padRight cols ' ' (String.takeFirst cols s.said) } ]

                -- the matches Tab could not choose between, after the line,
                -- underlined, while the caret is at its end, as far as the
                -- row goes (3.8's `prompt_draw_complete`, TM96)
                matchesPiece =
                    when s.asking is
                        Just a ->
                            if s.lookTmux && not (Array.isEmpty a.matches) && a.caret == Array.length a.chars then
                                let
                                    used =
                                        textCells (a.label ++ String.fromArray a.chars)

                                    room =
                                        promptAt.width - used
                                in
                                if room > 0 then
                                    [ { row = promptAt.row, col = promptAt.col + used, text = takeCells room (String.join "" (Array.map (\m -> " " ++ m) a.matches)) } ]

                                else
                                    []

                            else
                                []

                        Nothing ->
                            meant Reason.NotOpen []

                -- the caret of a prompt in tmux's look: the text before it
                -- written again leaves the cursor after it, wide characters
                -- counted by the core; none while puritty's box asks, which
                -- draws its own
                caretPiece =
                    when s.asking is
                        Just a ->
                            if s.lookTmux then
                                [ { row = promptAt.row, col = promptAt.col, text = String.takeFirst promptAt.width (a.label ++ String.fromArray (Array.slice 0 a.caret a.chars)) } ]

                            else
                                []

                        Nothing ->
                            meant Reason.NotOpen []

                shownCursor =
                    when { asking = s.asking
                         , view = s.view
                         , menu =
                            if s.menu /= Nothing || s.tree /= Nothing || s.listing /= Nothing || s.customizing /= Nothing then
                                Just {}

                            else
                                Nothing
                         } is
                        { asking = Just _, view = _, menu = _ } ->
                            if s.lookTmux then
                                "\u{001B}[?25h"

                            else
                                "\u{001B}[?25l"

                        { asking = Nothing, view = Just _, menu = _ } ->
                            "\u{001B}[?25l"

                        { asking = Nothing, view = Nothing, menu = Just _ } ->
                            "\u{001B}[?25l"

                        _ ->
                            cursor

                -- tmux's other modes (TM32): the clock drawn, the others
                -- said; and the tree puritty shows for `choose-tree`
                modesDrawn =
                    Array.mapAndFlatten (\p -> modeOverlay colors s.lookTmux (p.id == active) (Maybe.withDefault (meant Reason.NotYet "") (Dict.get p.id s.paneModes)) (clockText s) p) (tiled ++ floating)

                treeDrawn =
                    when s.tree is
                        Just t ->
                            if t.loaded < 3 then
                                []

                            else
                                let
                                    area =
                                        modePlace s cols rows (tiled ++ floating) { zoom = t.zoom, pane = t.pane }
                                in
                                when area is
                                    Just place ->
                                        drawTree (themeOf s) colors s.lookTmux s.version place t

                                    Nothing ->
                                        meant Reason.Gone []

                        Nothing ->
                            meant Reason.NotOpen []

                -- choose-buffer's or choose-client's list (TM55)
                listingDrawn =
                    when s.listing is
                        Just l ->
                            if not l.loaded then
                                []

                            else
                                let
                                    area =
                                        modePlace s cols rows (tiled ++ floating) { zoom = l.zoom, pane = l.pane }
                                in
                                when area is
                                    Just place ->
                                        drawListing colors s.lookTmux s.version place l

                                    Nothing ->
                                        meant Reason.Gone []

                        Nothing ->
                            meant Reason.NotOpen []

                -- customize-mode (TM62)
                customizeDrawn =
                    when s.customizing is
                        Just c ->
                            if c.loaded < c.asked && Array.isEmpty c.data.keys then
                                []

                            else
                                let
                                    area =
                                        modePlace s cols rows (tiled ++ floating) { zoom = c.zoom, pane = c.pane }
                                in
                                when area is
                                    Just place ->
                                        drawCustomize (themeOf s) s.lookTmux place c

                                    Nothing ->
                                        meant Reason.Gone []

                        Nothing ->
                            meant Reason.NotOpen []

                -- the panes' numbers (TM28)
                numbersDrawn =
                    when s.numbers is
                        Just n ->
                            Array.mapAndFlatten (\p -> paneNumber s.version colors s.lookTmux (p.id == active) n p) (tiled ++ floating)

                        Nothing ->
                            meant Reason.NotOpen []

                -- the bar in tmux's look, tmux's status line (TM29)
                tmuxLook =
                    s.lookTmux

                statusBar =
                    if s.lookTmux && statusRows s > 0 then
                        tmuxBarNow.pieces ++ extraStatus cols barRow s

                    else
                        []

                -- a menu of tmux's (TM27), once tmux has answered its
                -- formats
                menuDrawn =
                    when s.menu is
                        Just m ->
                            if m.pending > 0 then
                                []

                            else
                                drawMenu colors s.lookTmux (menuPlace cols rows s m) m

                        Nothing ->
                            meant Reason.NotOpen []

                -- a view of what tmux printed (TM26): over the active pane
                -- in tmux's look, in a box over the panes in puritty's
                viewDrawn =
                    when s.view is
                        Just v ->
                            if s.lookTmux then
                                when Array.findFirst (\p -> p.id == active) (tiled ++ floating) is
                                    Just place ->
                                        tmuxView colors place.value v

                                    Nothing ->
                                        meant Reason.Gone boxView cols rows s.barTop v

                            else
                                boxView cols rows s.barTop v

                        Nothing ->
                            meant Reason.NotOpen { rows = 0, pieces = [] }

                -- what tmux or puritty said, at the bar's right (TM24)
                saidPiece =
                    let
                        room =
                            max 0 (cols - String.count tabBar.text - 2)

                        -- what was said, else tmux's `status-right` without
                        -- its styles (TM29)
                        shown =
                            String.takeFirst room
                                (if s.said == "" then
                                    Style.strip s.status.right

                                 else
                                    s.said
                                )
                    in
                    if shown == "" then
                        []

                    else
                        [ { row = barRow, col = cols - String.count shown - 1, text = shown } ]

                active =
                    s.active

                -- where each pane goes, and how far back its view is, read
                -- before the canvas is written
                tiledPlaces =
                    placesOf tiled s

                floatPlaces =
                    Array.map (\p -> { id = p.id, places = [] }) floating |> eachPlaces floating s

                cols =
                    s.canvas.cols

                rows =
                    s.canvas.rows

                -- the selection's cells, read before the canvas is written
                tiledSpans =
                    spansAll tiled s

                floatSpans =
                    Array.map (\p -> { id = p.id, spans = [] }) floating
                        |> withSpans floating s

                -- the dividers right of and below each tiled pane
                lines =
                    Array.mapAndFlatten (divider cols rows) tiled

                -- in tmux's look the lines in `pane-border-style`, the
                -- active pane's framed in its own; the marked pane framed
                -- in either look; each pane's `pane-border-format` on its
                -- border when `pane-border-status` asks (TM30)
                -- while 3.8 shows the panes' numbers, its mode draws every
                -- border in display-panes-border-style (`window-panes.c`,
                -- TM66), and no pane titles
                panesBorder =
                    if s.lookTmux && s.numbers /= Nothing && (s.version == 0 || s.version >= 38) then
                        Maybe.andThen
                            (\v ->
                                if String.trim v == "" then
                                    Nothing

                                else
                                    Just (Style.sgr (Style.apply v Style.plain))
                            )
                            (Dict.get "display-panes-border-style" s.status.options)

                    else
                        Nothing

                borders =
                    let
                        drawn =
                            paneBorders s.lookTmux cols rows active (Array.map (withScrollbar s) tiled) tiled floating s.status
                    in
                    when panesBorder is
                        Just ink ->
                            { drawn
                                | tiled = Array.keepIf (\piece -> String.all isBoxDrawing piece.text) drawn.tiled |> Array.map (\piece -> { piece | color = ink })
                                , floating = []
                            }

                        Nothing ->
                            meant Reason.NotSet drawn

                cursor =
                    when { copying = Dict.get s.active s.copy, place = Array.findFirst (\p -> p.id == s.active) (tiled ++ floating) } is
                        { copying = Just c, place = Just place } ->
                            -- copy mode's cursor, where tmux has it (TM31),
                            -- or none where tmux does not say (before 3.1)
                            if not c.located then
                                "\u{001B}[?25l"

                            else
                                "\u{001B}[" ++ String.fromInt (place.value.y + c.cy + 1) ++ ";" ++ String.fromInt (place.value.x + c.cx + 1) ++ "H\u{001B}[?25h"

                        _ ->
                            if not (String.startsWith "copy-mode" (Maybe.withDefault (meant Reason.NotYet "") (Dict.get s.active s.paneModes)) || Maybe.withDefault (meant Reason.NotYet "") (Dict.get s.active s.paneModes) == "") then
                                -- the clock and the modes puritty does not
                                -- draw show no cursor, as in tmux (TM32)
                                "\u{001B}[?25l"

                            else
                                cursorOf s.active (backOf s.active s) (tiled ++ floating) s.ids s.panes

                -- copy mode's position at a pane's top right, as tmux shows
                -- it (TM31)
                copyMarks =
                    Array.mapAndKeepJust
                        (\p ->
                            Dict.get p.id s.copy
                                |> Maybe.map
                                    (\c ->
                                        let
                                            position =
                                                "[" ++ String.fromInt c.scroll ++ "/" ++ String.fromInt c.hsize ++ "]"

                                            -- the search's count, or that it
                                            -- timed out (TM41)
                                            said =
                                                if c.timedOut then
                                                    "(timed out)"

                                                else if c.count > 0 then
                                                    "("
                                                        ++ String.fromInt c.count
                                                        ++ (if c.partial then
                                                                "+"

                                                            else
                                                                ""
                                                           )
                                                        ++ " results)"

                                                else
                                                    ""

                                            -- from 3.6 as copy-mode-position-format's
                                            -- default says it, the top line's
                                            -- time first and the search's
                                            -- count after (TM41, TM103);
                                            -- before, tmux writes the count
                                            -- first (`window_copy_write_line`;
                                            -- only 3.5 tells it)
                                            text =
                                                if s.version == 0 || s.version >= 36 then
                                                    (if c.lineTime == "" then
                                                        ""

                                                     else
                                                        c.lineTime ++ " "
                                                    )
                                                        ++ position
                                                        ++ (if said == "" then
                                                                ""

                                                            else
                                                                " " ++ said
                                                           )

                                                else if said == "" then
                                                    position

                                                else
                                                    said ++ " " ++ position
                                        in
                                        { row = p.y
                                        , col = p.x + max 0 (p.w - String.count text)
                                        , color =
                                            if s.lookTmux then
                                                colors.mode

                                            else
                                                activeTabColor
                                        , text = String.takeFirst p.w text
                                        }
                                    )
                        )
                        (tiled ++ floating)

                -- the message's and the prompt's color, as message-style
                -- says (TM47)
                messageInk =
                    colors.message

                -- the prompt in vi's command mode in message-command-style
                -- (TM100)
                promptInk =
                    when s.asking is
                        Just a ->
                            if a.commandMode then
                                colors.messageCommand

                            else
                                messageInk

                        Nothing ->
                            meant Reason.NotOpen messageInk

                -- each pane's scrollbar (TM53)
                scrollbars =
                    Array.mapAndFlatten (\p -> scrollbarPieces s p) (tiled ++ floating)

                -- a copy-mode search's matches (TM41)
                tiledMarks =
                    searchMarks colors tiled s

                floatMarks =
                    searchMarks colors floating s

                -- each floating pane's frame color, read before the canvas
                -- is drawn on
                frameColors =
                    Array.foldl (\p d -> Dict.set p.id (Maybe.withDefault (meant Reason.NotSet floatFrameColor s active p) panesBorder) d) Dict.empty floating

                -- the tiled panes and their dividers, then each floating
                -- pane in its box, the bottom one first
                composed =
                    s.canvas
                        |> Vt.withoutComposed
                        -- the window's cell, which the panes' pictures are
                        -- scaled to (IM32)
                        |> Vt.withCellSize { width = s.paneCell.width, height = s.paneCell.height }
                        |> Vt.feed (Bytes.fromString "\u{001B}[?7l\u{001B}[0m\u{001B}[H\u{001B}[2J")
                        |> Vt.composeStyled s.panes tiledPlaces
                        |> Vt.invert tiledSpans
                        |> drawText
                            borders.lineColor
                            (if s.lookTmux then
                                []

                             else
                                lines
                            )
                        |> drawPieces borders.tiled
                        |> drawPieces tiledMarks
                        |> (\c -> Array.foldl (\p acc -> acc |> drawText (Maybe.withDefault (meant Reason.NotSet boxColor) (Dict.get p.id frameColors)) (boxAround cols rows p) |> Vt.composeStyled s.panes (placesIn p.id floatPlaces) |> Vt.invert (spansIn p.id floatSpans)) c floating)
                        |> drawPieces floatMarks
                        |> drawPieces borders.floating
                        |> drawPieces scrollbars
                        |> drawPieces copyMarks
                        |> drawPieces modesDrawn
                        |> drawPieces treeDrawn
                        |> drawPieces listingDrawn
                        |> drawPieces customizeDrawn
                        |> dropMarked (tiled ++ floating) s.dropMark
                        |> (\c ->
                                if tmuxLook then
                                    drawPieces statusBar c

                                else
                                    c
                                        |> drawText barColor [ { row = barRow, col = 0, text = String.padRight cols ' ' tabBar.text } ]
                                        |> drawText activeTabColor tabBar.active
                                        |> drawText alertTabColor tabBar.alerted
                                        |> drawText busyTabColor tabBar.busy
                                        |> drawText barColor saidPiece
                           )
                        |> drawText "\u{001B}[0m" promptClear
                        |> drawText promptInk tmuxLine
                        |> drawText (promptInk ++ "\u{001B}[4m") matchesPiece
                        |> drawText promptInk caretPiece
                        |> (\c -> Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) c viewDrawn.pieces)
                        |> (\c -> Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) c numbersDrawn)
                        |> (\c -> Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) c menuDrawn)
                        |> Vt.feed (Bytes.fromString shownCursor)
            in
            { s | canvas = (Vt.takeReplies composed).term, view = Maybe.map (\v -> { v | rows = max 1 viewDrawn.rows }) s.view }


{-| CUP to the active pane's cursor in the window, and DECTCEM as the
pane has it. -}
cursorOf : Int -> Int -> Array Layout.Pane -> (ids : Array Int) -> (panes : Builder Vt.Term where Array.length ids == Builder.length panes) -> String
cursorOf active back boxes ids panes =
    let
        -- the pane's place among `ids` is its terminal's in `panes`
        index =
            Array.findIndex (\i -> i == active) ids
    in
    when Array.findFirst (\b -> b.id == active) boxes is
        Just place ->
            if index >= 0 then
                let
                    at =
                        Vt.cursorOf (Builder.getProven index panes)
                in
                if at.y + back >= place.value.h then
                    -- scrolled back past it
                    "\u{001B}[?25l"

                else
                    "\u{001B}["
                        ++ String.fromInt (place.value.y + at.y + back + 1)
                        ++ ";"
                        ++ String.fromInt (place.value.x + at.x + 1)
                        ++ "H"
                        ++ (if at.visible then
                                "\u{001B}[?25h"

                            else
                                "\u{001B}[?25l"
                           )

            else
                -- no terminal for it yet
                "\u{001B}[?25l"

        Nothing ->
            -- before the first layout names the active pane's box
            meant Reason.NotYet "\u{001B}[?25l"


divider : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
divider cols rows p =
    let
        right =
            if p.x + p.w < cols then
                Array.range p.y (min rows (p.y + p.h) - 1) |> Array.map (\r -> { row = r, col = p.x + p.w, text = "│" })

            else
                []

        below =
            if p.y + p.h < rows then
                [ { row = p.y + p.h, col = p.x, text = String.repeat (min p.w (cols - p.x)) "─" } ]

            else
                []
    in
    right ++ below


{-| Whether a character draws a line (U+2500 to U+257F, and the ASCII
ones some `pane-border-lines` use). -}
isBoxDrawing : Char -> Bool
isBoxDrawing c =
    let
        code =
            Char.toCode c
    in
    (code >= 0x2500 && code <= 0x257F) || c == '|' || c == '-' || c == '+' || c == ' '


{-| A floating pane's frame color: in tmux's look the pane's own border
style, as tmux 3.8 draws a floating pane's border (a popup's is
popup-border-style, TM66); in puritty's, amber for the active one. -}
floatFrameColor : State -> Int -> Layout.Pane -> String
floatFrameColor s active p =
    if s.lookTmux then
        when Dict.get p.id s.status.panes is
            Just own ->
                Style.sgr (Style.apply own.border (Style.apply s.status.borderStyle Style.plain))

            Nothing ->
                meant Reason.NotYet
                    if p.id == active then
                        activeColor

                    else
                        boxColor

    else if p.id == active then
        activeColor

    else
        boxColor


boxAround : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
boxAround cols rows p =
    let
        left =
            p.x - 1

        right =
            p.x + p.w

        top =
            p.y - 1

        bottom =
            p.y + p.h

        inside =
            max 0 (min p.w (cols - p.x))

        edge l mid r =
            (if left >= 0 then
                l

             else
                ""
            )
                ++ String.repeat inside mid
                ++ (if right < cols then
                        r

                    else
                        ""
                   )

        from =
            if left >= 0 then
                left

            else
                p.x
    in
    (if top >= 0 then
        [ { row = top, col = from, text = edge "┌" "─" "┐" } ]

     else
        []
    )
        ++ (Array.range p.y (min rows bottom - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        (if left >= 0 then
                            [ { row = r, col = left, text = "│" } ]

                         else
                            []
                        )
                            ++ (if right < cols then
                                    [ { row = r, col = right, text = "│" } ]

                                else
                                    []
                               )
                    )
           )
        ++ (if bottom < rows then
                [ { row = bottom, col = from, text = edge "└" "─" "┘" } ]

            else
                []
           )


{-| What a key or a paste sends, as commands to the active pane. -}
keys : Bytes -> (taken s : State) -> { state : State, commands : Array String }
keys bytes s =
    if s.active < 0 then
        { state = s, commands = [] }

    else
        -- a key the pane's program gets brings its view to the bottom, not
        -- one copy mode takes (TM67)
        sent (bytesTo s.caps s.active bytes)
            { s
                | back =
                    if Bytes.isEmpty bytes || inCopy s.active s then
                        s.back

                    else
                        Dict.remove s.active s.back
            }


{-| A paste, or a piece of one, to the active pane by tmux's own paste
(TM64): tmux brackets it where the program asked, which on 3.6 puritty
cannot know for a program that asked before it attached. -}
paste : { first : Bool, last : Bool } -> Bytes -> (taken s : State) -> { state : State, commands : Array String }
paste piece bytes s =
    if s.active < 0 then
        { state = s, commands = [] }

    else
        let
            pane =
                s.active
        in
        sendAsking
            (Array.map (\command -> { command = command, expect = ForNothing }) (Command.pasteBytes (not (Caps.has "send-keys" "H" s.caps)) pane piece bytes))
            { s | back = Dict.remove pane s.back }


{-| What a typed key sends: through the client's key table, as a key
typed at a terminal attached to tmux is, so that the prefix and bindings
work (TM23): a named key or one with Ctrl or Alt by its tmux name, other
text as its bytes. `bytes` is what the pane's modes make of the key; a key
that makes none (a release) sends nothing, and one tmux has no name for (a
Super chord) still sends them to the pane. -}
typed : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
typed k bytes ms s =
    let
        wasAsking =
            Maybe.map .ask s.asking
    in
    historyAsked wasAsking (typedCopy k bytes ms s)


{-| `typed`'s key, then copy mode asked where it is. -}
typedCopy : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
typedCopy k bytes ms s =
    let
        r =
            typedHere k bytes ms s

        pane =
            r.state.active
    in
    if inCopy pane r.state then
        -- where copy mode is after the key, asked behind it (TM31)
        let
            asked =
                askCopy pane { state = r.state, outside = [], commands = [], trace = [], run = Nothing }
        in
        { state = asked.state, commands = r.commands ++ asked.commands }

    else
        r


{-| A prompt that has just opened asks tmux its type's history, from 3.3
(`show-prompt-history -T`, TM89), so that Up and Down go through what
tmux's own prompts have had typed, by any client and from its
`history-file`, then what was typed here. -}
historyAsked : Maybe Syntax.Ask -> (taken r : { state : State, commands : Array String }) -> { state : State, commands : Array String }
historyAsked wasAsking r =
    when r.state.asking is
        Just a ->
            -- a new prompt, not the one open before (its next step
            -- keeps the history it had); one opened from another's
            -- answer is new
            if wasAsking /= Just a.ask && Command.promptHistoryKept r.state.caps then
                let
                    kind =
                        promptKind r.state a

                    asked =
                        sendAsking [ { command = Command.promptHistory kind, expect = ForPromptHistory kind } ] r.state
                in
                { state = asked.state, commands = r.commands ++ asked.commands }

            else
                r

        Nothing ->
            meant Reason.NotOpen r


{-| The history a prompt keeps, as tmux types them (TM89): `-T`'s for
command-prompt, `command` for confirm-before and the modes' own value
prompts, `search` for their searches and filters (`mode_tree_set_prompt`);
before 3.3, which keeps one list for them all, `all`. -}
promptKind : State -> Asking -> String
promptKind s a =
    if not (Command.promptHistoryKept s.caps) then
        "all"

    else if Array.member a.purpose [ 1, 2, 11, 12, 23, 24 ] then
        "search"

    else if a.purpose /= 0 then
        "command"

    else
        when a.ask is
            Syntax.Prompt p ->
                p.kind

            Syntax.Confirm _ ->
                "command"


{-| A prompt type's history, oldest first: tmux's, then what was typed
here, which tmux has no command to be given. -}
historyFor : String -> State -> Array String
historyFor kind s =
    Maybe.withDefault (meant Reason.NotSet []) (Dict.get kind s.tmuxHistory) ++ Maybe.withDefault (meant Reason.NotSet []) (Dict.get kind s.history)


typedHere : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
typedHere k bytes ms s =
    if s.active < 0 || Bytes.isEmpty bytes then
        { state = s, commands = [] }

    else
        when { asking = s.asking, menu = s.menu, numbers = s.numbers, view = s.view } is
            { asking = Just asked, menu = Just m, numbers = _, view = _ } ->
                -- the prompt's menu of matches takes the keys over the
                -- prompt (TM98); another menu waits
                if m.completes then
                    menuKey k m { s | clock = ms }

                else
                    promptKey k bytes ms asked { s | clock = ms }

            { asking = Just a, menu = _, numbers = _, view = _ } ->
                promptKey k bytes ms a { s | clock = ms }

            { asking = Nothing, menu = Just m, numbers = _, view = _ } ->
                menuKey k m { s | clock = ms }

            { asking = Nothing, menu = Nothing, numbers = Just n, view = _ } ->
                numberKey k n { s | clock = ms }

            { asking = Nothing, menu = Nothing, numbers = Nothing, view = Just v } ->
                { state = { s | view = viewKey k v, clock = ms }, commands = [] }

            { asking = Nothing, menu = Nothing, numbers = Nothing, view = Nothing } ->
                when { tree = s.tree, listing = s.listing, customizing = s.customizing } is
                    { tree = Just t, listing = _, customizing = _ } ->
                        previewAfter (treeKey k t { s | clock = ms })

                    { tree = Nothing, listing = Just l, customizing = _ } ->
                        listPreviewAfter (listKey k l { s | clock = ms })

                    { tree = Nothing, listing = Nothing, customizing = Just c } ->
                        customizeKey k c { s | clock = ms }

                    { tree = Nothing, listing = Nothing, customizing = Nothing } ->
                        keyByTable k bytes ms { s | clock = ms }


{-| Where a binding that may move the active pane is (TM109): sent, its
block (from 3.4, tmux runs it) not yet come; its block come, the window
asked again and not yet answered; each since a time on the key clock. -}
type Settling
    = Settled
    | AwaitingBlock Int
    | AwaitingWindow Int


{-| How long keys wait for a binding to settle, in ms: past it, the next
key sends those held, as before TM109. -}
settleMost : Int
settleMost =
    2000


{-| A typed key with no prompt open: held while a binding settles
(TM109), else `keyRouted`'s. -}
keyByTable : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
keyByTable k bytes ms s =
    when settlingSince s.settling is
        Nothing ->
            meant Reason.NotOpen keyRouted k bytes ms s

        Just at ->
            if ms - at < settleMost then
                { state = { s | heldKeys = Array.pushLast { k = k, bytes = bytes, ms = ms } s.heldKeys }, commands = [] }

            else
                -- tmux has not answered in time: what was held goes, then
                -- this key
                let
                    r =
                        sendHeld { s | settling = Settled }

                    next =
                        keyByTable k bytes ms r.state
                in
                { state = next.state, commands = r.commands ++ next.commands }


{-| The keys held while a binding settled, sent in order, now that it
has (TM109); one of them that is a binding itself holds those after it
again. -}
sendHeld : (taken s : State) -> { state : State, commands : Array String }
sendHeld s =
    Array.foldl
        (\h acc ->
            let
                next =
                    keyByTable h.k h.bytes h.ms acc.state
            in
            { state = next.state, commands = acc.commands ++ next.commands }
        )
        { state = { s | heldKeys = [] }, commands = [] }
        s.heldKeys


{-| A typed key: by the tables (TM24), a binding whose prompt puritty can
ask opening it (TM25). -}
keyRouted : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
keyRouted k bytes ms s =
    let
        -- a key no binding can take goes straight to the pane: through
        -- the client (`-K`) tmux loses escape-sequence keys, and Enter
        -- under extended keys (TM50)
        nobodyBinds =
            when keyName k is
                Just name ->
                    s.keys.table == "root"
                        && Maybe.withDefault (meant Reason.NotYet "") (Dict.get s.active s.modes) == ""
                        && not (Array.member name s.keys.prefixes)
                        && Dict.get ("root " ++ name) s.keys.bindings == Nothing

                Nothing ->
                    meant Reason.NotKnown False

        commands =
            if s.keys.byTable && nobodyBinds then
                when keyName k is
                    Just name ->
                        -- keypad Enter as Enter: through a client attached
                        -- in puritty, tmux is sent `\r` for it and gives the
                        -- program `\r`; by its name it would give `\n`, or
                        -- `\eOM` in keypad mode (measured, TM61)
                        [ Command.sendKeyTo s.active
                            (if name == "KPEnter" then
                                "Enter"

                             else
                                name
                            )
                        ]

                    Nothing ->
                        meant Reason.NotKnown byName k bytes s.active

            else if s.keys.byTable then
                byName k bytes s.active

            else if way.ran /= "" then
                -- a tmux before 3.4 has no `send-keys -K`: puritty follows
                -- its tables, and the binding's command is sent as tmux
                -- would have run it for the key (TM72)
                [ Command.bindingLine way.ran ]

            else if Bindings.tableAt ms s.keys /= "root" || modeTable /= "" || way.table /= "root" then
                -- the prefix itself, or a key after it or in a mode that no
                -- binding takes, which tmux drops
                []

            else
                bytesTo s.caps s.active bytes

        modeTable =
            Maybe.withDefault (meant Reason.NotYet "") (Dict.get s.active s.modes)

        way =
            Bindings.route (lookupName k) ms modeTable s.keys

        tables =
            s.keys

        followed =
            { tables | table = way.table, repeatUntil = way.repeatUntil }

        -- copy mode entered by a binding is known before tmux says so, so
        -- that a quick `/` after it is looked up in copy mode's table
        modes =
            if String.startsWith "copy-mode" way.ran then
                Dict.set s.active
                    (if s.modeKeys == "vi" then
                        "copy-mode-vi"

                     else
                        "copy-mode"
                    )
                    s.modes

            else
                s.modes

        reset =
            if way.reset then
                [ Command.rootTable ]

            else
                []
    in
    if way.send then
        -- a key the pane's program gets brings its view to the bottom; in
        -- copy mode the key is the mode's, and tmux's answer moves the
        -- view (TM31), so it stays: brought down here, each key showed
        -- the live screen until that answer came, a ghost behind a held
        -- `k` (TM67)
        let
            -- a binding's command sent by puritty (before 3.4): each of its
            -- commands answered on its one line, and a fence after one that
            -- runs others (the code review's TA6, TM116)
            sender =
                if way.ran /= "" && not s.keys.byTable && modeTable == "" then
                    sentBinding (Command.bindingLine way.ran)

                else
                    sent commands

            keyed =
                sender
                    { s
                        | back =
                            if inCopy s.active s then
                                s.back

                            else
                                Dict.remove s.active s.back
                        , keys = followed
                        , said = way.said
                        , modes = modes
                    }
        in
        if endsClient s.clientName way.ran then
            -- the key detaches this client: its own commands go, nothing
            -- after them (TM92)
            let
                st =
                    keyed.state
            in
            { state = { st | ending = 1 }, commands = keyed.commands }

        else if way.ran /= "" && modeTable == "" && not s.keys.byTable then
            -- a binding of tmux's, sent as its command (before 3.4): the
            -- window asked again after it, since tmux does not tell every
            -- change to its panes' places (`rotate-window` none on any
            -- tmux, `swap-pane` none before 3.0; docs/tmux-checks.md TK12).
            -- With `send-keys -K` tmux may run the binding after the next
            -- line, so the window is asked when its block comes (`reply`)
            let
                asked =
                    sendAsking
                        ([ { command = windowQuery, expect = ForWindow } ]
                            ++ (if changesKeys way.ran then
                                    keysQueries

                                else
                                    []
                               )
                        )
                        keyed.state

                st =
                    asked.state
            in
            -- keys after it wait for the window's answer (TM109)
            { state = { st | settling = AwaitingWindow ms }, commands = keyed.commands ++ asked.commands }

        else if way.ran /= "" && modeTable == "" && s.keys.byTable then
            -- tmux runs the binding; keys after it wait for its block and
            -- the window asked after it (TM109)
            let
                st =
                    keyed.state
            in
            { state = { st | settling = AwaitingBlock ms, rereadKeys = st.rereadKeys || changesKeys way.ran }, commands = keyed.commands }

        else
            keyed

    else if runsHere way.held then
        -- a prompt, a menu, or an `if-shell -F` around one: puritty runs
        -- the binding (TM25, TM27)
        let
            ctx =
                { pane = s.active, mouse = Nothing }

            back =
                sent reset { s | keys = followed, said = "" }

            ran =
                runHeld ctx "" "" way.held back.state
        in
        { state = ran.state, commands = back.commands ++ ran.commands }

    else
        sent reset { s | keys = followed, said = way.said }


{-| A prompt opened at its first question: the question and first text as
written, and the `display-message`s that expand them where they hold a
format (`#W`, `#{…}`). -}
opening : Syntax.Ask -> String -> { asking : Asking, expand : Array { command : String, expect : Expect } }
opening question after =
    let
        start =
            { ask = question, after = after, step = 0, answers = [], label = "", chars = [], caret = 0, edited = False, recall = "", purpose = 0, cut = "", matches = [], commandMode = False }

        opened =
            stepTo 0 [] start
    in
    -- an incremental prompt runs its command as it opens, with the empty
    -- line, as tmux's does
    { opened | expand = opened.expand ++ incrementally '=' opened.asking }


{-| A prompt at question `step`, with the answers before it. -}
stepTo : Int -> Array String -> Asking -> { asking : Asking, expand : Array { command : String, expect : Expect } }
stepTo step answers a =
    let
        q =
            when a.ask is
                Syntax.Confirm c ->
                    { label = c.prompt, input = "" }

                Syntax.Prompt p ->
                    { label = Maybe.withDefault (meant Reason.OutOfRange "") (Array.get step p.prompts), input = Maybe.withDefault (meant Reason.NotSet "") (Array.get step p.inputs) }

        expand text expect =
            if String.contains "#" text then
                [ { command = Command.display (noTime text), expect = expect } ]

            else
                []
    in
    if isIncremental a then
        -- the first text is not on the line but recalled by C-r or C-s on
        -- an empty one, as tmux keeps it
        { asking = { a | step = step, answers = answers, label = q.label, chars = [], caret = 0, edited = False, recall = q.input }
        , expand = expand q.label ForLabel ++ expand q.input ForInput
        }

    else
        { asking = { a | step = step, answers = answers, label = q.label, chars = String.toArray q.input, caret = String.count q.input, edited = False }
        , expand = expand q.label ForLabel ++ expand q.input ForInput
        }


{-| A `#{version}` in tenths: `3.6a` 36, `3.8` 38, `next-3.9` 39; 0 for
what is not a version. -}
versionFrom : Caps -> String -> Int
versionFrom caps text =
    let
        parsed =
            versionOf text
    in
    if parsed > 0 || not caps.known then
        parsed

    else
        estimated caps


{-| A tmux whose `#{version}` is not one (OpenBSD's says `openbsd-7.6`),
taken as the oldest that has what it says it takes (the code review's
TB7, docs/tmux.md TM111): each mark the first recorded tmux to have it
(`list-commands` of 2.7, 3.0, 3.2a, 3.4, 3.6a and 3.8, and 3.7's
`list-keys -F`); what has none of them is 2.7. Not the newest, which
0 was taken as by most tests and the oldest by others. -}
estimated : Caps -> Int
estimated caps =
    [ { at = 38, has = Caps.known "new-pane" caps }
    , { at = 37, has = Caps.has "list-keys" "F" caps }
    , { at = 36, has = Caps.has "copy-mode" "d" caps }
    , { at = 34, has = Caps.has "send-keys" "K" caps }
    , { at = 32, has = Caps.known "display-popup" caps }
    , { at = 30, has = Caps.known "display-menu" caps }
    ]
        |> Array.findFirst .has
        |> Maybe.map (\found -> found.value.at)
        |> Maybe.withDefault (meant Reason.NotKnown 27)


versionOf : String -> Int
versionOf text =
    let
        bare =
            if String.startsWith "next-" text then
                String.dropFirst 5 text

            else
                text

        digits part =
            let
                chars =
                    String.toArray part

                upTo =
                    Array.findFirst (\c -> not (Char.isDigit c)) chars |> Maybe.map .index |> Maybe.withDefault (meant Reason.NoMore Array.length chars)
            in
            String.toInt (String.fromArray (Array.takeFirst upTo chars))
    in
    when String.split "." bare is
        [ major, minor ] ->
            when { a = digits major, b = digits minor } is
                { a = Just a, b = Just b } ->
                    a * 10 + min 9 b

                _ ->
                    0

        _ ->
            0


{-| Where a mode puritty draws (the tree, a list, customize-mode) is: the
window less the status line when zoomed (`-Z`), else its pane. -}
modePlace : State -> Int -> Int -> Array Layout.Pane -> { zoom : Bool, pane : Int } -> Maybe Layout.Pane
modePlace s cols rows places m =
    if m.zoom then
        let
            statusLines =
                clamp 0 5 (statusRows s)
        in
        Just
            { id = -1
            , x = 0
            , y =
                if s.barTop then
                    statusLines

                else
                    0
            , w = clamp 0 16384 cols
            , h = max 0 (clamp 0 16384 rows - statusLines)
            , active = True
            , z = Nothing
            }

    else
        Array.findFirst (\p -> p.id == m.pane) places |> Maybe.map .value


{-| Whether a prompt is asked in the pane (`command-prompt -P`). -}
askedInPane : Asking -> Bool
askedInPane a =
    when a.ask is
        Syntax.Prompt p ->
            p.inPane

        Syntax.Confirm _ ->
            False


{-| Whether a prompt is incremental (`command-prompt -i`, copy mode's
emacs C-r and C-s). -}
isIncremental : Asking -> Bool
isIncremental a =
    when a.ask is
        Syntax.Prompt p ->
            p.incremental

        Syntax.Confirm _ ->
            False


{-| An incremental prompt's command, run with the line and `prefix`
before it: `=` for the line as it now is, `-` and `+` for the next match
up or down (C-r, C-s). tmux's copy mode reads the first character as
which; with none, it searched for nothing (TM39). -}
incrementally : Char -> Asking -> Array { command : String, expect : Expect }
incrementally prefix a =
    when a.ask is
        Syntax.Prompt p ->
            when p.template is
                Just t ->
                    if p.incremental then
                        [ { command = Syntax.fill t [ String.fromChar prefix ++ String.fromArray a.chars ], expect = ForNothing } ]

                    else
                        []

                Nothing ->
                    meant Reason.NotSet []

        Syntax.Confirm _ ->
            []


{-| A key while a prompt is open (TM25). A confirmation takes its key, or
Enter where `-y` says so, and runs its command; any other key says no. A
command prompt edits its line as tmux's emacs keys do (Left, Right, Home,
End, C-a, C-e, C-b, C-f, BSpace, DC, C-d, C-u (the whole line), C-k, C-w,
M-b and M-f (words), C-t, Up or C-p and Down or C-n for
earlier answers), Enter answers and Escape, C-c or C-g closes it; `-1`
takes one key's text, `-k` a key's name, `-N` digits, any other key
answering and then going on as typed. The commands after the prompt run
when it closes, answered or not, as tmux runs them. -}
promptKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> Asking -> (taken s : State) -> { state : State, commands : Array String }
promptKey k bytes ms a0 s =
    if Dict.get "status-keys" s.status.options == Just "vi" then
        viKey k bytes ms a0 s

    else
        emacsKey k bytes ms a0 s


{-| A key at the prompt as `status-keys vi` takes it (`prompt_translate_key`,
`status_prompt_translate_key` before 3.8; TM100): in insert mode the
editing keys this tmux passes go as emacs takes them, Escape enters
command mode (the caret one left), and any other key is typed; in command
mode a letter is an editing key (`h`, `l`, `0`, `$`, `x`, `X`, `D`, `d`,
`p`, `j`, `k`, `b`), a vi word motion (`w`, `W`, `e`, `E`, `B`), or goes
back to insert mode (`i`, `a`, `A`, `I`, `s`, `S`, `C`); `q` cancels from
3.2; anything else does nothing. -}
viKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> Asking -> (taken s : State) -> { state : State, commands : Array String }
viKey k bytes ms a s =
    let
        name =
            Maybe.withDefault (meant Reason.NotKnown "") (lookupName k)

        v =
            s.version

        newer n =
            v == 0 || v >= n

        -- what insert mode passes to the editing keys
        passed =
            [ "C-c", "C-h", "Tab", "C-u", "C-w", "Enter", "C-m", "C-j", "BSpace", "DC", "Down", "End", "Home", "Left", "Right", "Up" ]
                ++ (if newer 32 then
                        [ "C-g" ]

                    else
                        []
                   )
                ++ (if newer 33 then
                        [ "C-a", "C-e", "C-k", "C-n", "C-p", "C-t", "C-y", "C-Left", "C-Right" ]

                    else
                        []
                   )
                ++ (if newer 37 then
                        [ "C-v" ]

                    else
                        []
                   )

        escape =
            name == "Escape" || (newer 37 && name == "C-[")

        separators =
            (wordRules s).separators

        editAs other st =
            emacsKey (keyNamed other) bytes ms a st

        editIn other st =
            emacsKey (keyNamed other) bytes ms { a | commandMode = False } st

        moved caret st =
            { state = { st | asking = Just { a | caret = caret } }, commands = [] }

        mode inCommand st =
            { state = { st | asking = Just { a | commandMode = inCommand } }, commands = [] }
    in
    if not a.commandMode then
        if escape then
            { state = { s | asking = Just { a | commandMode = True, caret = max 0 (a.caret - 1) } }, commands = [] }

        else if
            -- an editing key, or text typed; a key with Ctrl or Alt that
            -- this tmux does not pass is not typed
            Array.member name passed || Bitwise.and k.mods 6 == 0
        then
            emacsKey k bytes ms a s

        else
            { state = s, commands = [] }

    else if escape then
        -- in command mode Escape goes back to insert mode up to 3.6, and
        -- from 3.7 does nothing
        if newer 37 then
            { state = s, commands = [] }

        else
            mode False s

    else if name == "BSpace" then
        editAs "Left" s

    else if name == "i" then
        mode False s

    else if name == "S" then
        editIn "C-u" s

    else if name == "A" then
        editIn "End" s

    else if name == "I" then
        editIn "Home" s

    else if name == "C" then
        editIn "C-k" s

    else if name == "s" then
        editIn "DC" s

    else if name == "a" then
        editIn "Right" s

    else if name == "$" then
        editAs "End" s

    else if name == "0" || name == "^" then
        editAs "Home" s

    else if name == "D" then
        editAs "C-k" s

    else if name == "X" then
        editAs "BSpace" s

    else if name == "x" || name == "DC" then
        editAs "DC" s

    else if name == "b" || (name == "B" && not (newer 33)) then
        -- before 3.3 both b and B go back a word by the separators
        -- (`M-b`); from 3.3 b does, as `prompt_backward_word`
        if newer 33 then
            moved (viBackward separators a) s

        else
            moved (oldBackward separators a) s

    else if not (newer 33) && Array.member name [ "w", "W", "e", "E" ] then
        -- before 3.3 each is `M-f`: to the next separator, then back one
        moved (oldForward True separators a) s

    else if name == "d" then
        editAs "C-u" s

    else if name == "p" then
        editAs "C-y" s

    else if name == "q" && newer 32 then
        editAs "C-c" s

    else if name == "j" || name == "Down" then
        editAs "Down" s

    else if name == "k" || name == "Up" then
        editAs "Up" s

    else if name == "h" || name == "Left" then
        editAs "Left" s

    else if name == "l" || name == "Right" then
        editAs "Right" s

    else if name == "C-h" || name == "C-c" || name == "Enter" || name == "C-m" || name == "C-j" then
        emacsKey k bytes ms a s

    else if name == "w" then
        moved (viForward True separators a) s

    else if name == "W" then
        moved (viForward True "" a) s

    else if name == "e" then
        moved (viEnd separators a) s

    else if name == "E" then
        moved (viEnd "" a) s

    else if name == "B" then
        moved (viBackward "" a) s

    else
        { state = s, commands = [] }


{-| `prompt_forward_word` (vi): from the caret over its class (separators
or not), then over spaces to the next word. -}
viForward : Bool -> String -> Asking -> Int
viForward vi separators a =
    let
        n =
            Array.length a.chars

        at i =
            Maybe.withDefault (meant Reason.OutOfRange ' ') (Array.get i a.chars)

        space i =
            at i == ' '

        isSep i =
            String.contains (String.fromChar (at i)) separators && not (space i)

        skipSpaces i =
            if i < n && space i then
                skipSpaces (i + 1)

            else
                i

        start =
            if vi then
                a.caret

            else
                skipSpaces a.caret

        cls =
            isSep start

        go i =
            let
                next =
                    i + 1
            in
            if next >= n then
                n

            else if space next then
                if vi then
                    skipSpaces next

                else
                    next

            else if isSep next /= cls then
                next

            else
                go next
    in
    if start >= n then
        n

    else
        go start


{-| Before 3.3, `M-f` (`status_prompt_key`): past the separators after
the caret, on to the next separator or the end; with `status-keys vi`
then back one. -}
oldForward : Bool -> String -> Asking -> Int
oldForward vi separators a =
    let
        n =
            Array.length a.chars

        sep i =
            i < n && String.contains (String.fromChar (Maybe.withDefault (meant Reason.OutOfRange ' ') (Array.get i a.chars))) separators

        pastSeparators i =
            if i >= n then
                n

            else if not (sep (i + 1)) then
                i + 1

            else
                pastSeparators (i + 1)

        toSeparator i =
            if i >= n then
                n

            else if sep (i + 1) then
                i + 1

            else
                toSeparator (i + 1)

        found =
            toSeparator (pastSeparators a.caret)
    in
    if vi && found > 0 then
        found - 1

    else
        found


{-| Before 3.3, `M-b` (`status_prompt_key`): back over separators, then to
the start of the word. -}
oldBackward : String -> Asking -> Int
oldBackward separators a =
    let
        sep i =
            String.contains (String.fromChar (Maybe.withDefault (meant Reason.OutOfRange ' ') (Array.get i a.chars))) separators

        pastSeparators i =
            if i <= 0 then
                0

            else if not (sep (i - 1)) then
                i - 1

            else
                pastSeparators (i - 1)

        toStart i =
            if i <= 0 then
                0

            else if sep (i - 1) then
                i

            else
                toStart (i - 1)
    in
    toStart (pastSeparators a.caret)


{-| `prompt_end_word`: to the last character of the next word. -}
viEnd : String -> Asking -> Int
viEnd separators a =
    let
        n =
            Array.length a.chars

        at i =
            Maybe.withDefault (meant Reason.OutOfRange ' ') (Array.get i a.chars)

        isSep i =
            String.contains (String.fromChar (at i)) separators

        next i =
            if i >= n - 1 then
                n

            else if at (i + 1) == ' ' then
                next (i + 1)

            else
                i + 1

        found =
            next a.caret

        last i =
            if i + 1 >= n then
                n - 1

            else if at (i + 1) == ' ' || isSep (i + 1) /= isSep found then
                i

            else
                last (i + 1)
    in
    if a.caret >= n then
        a.caret

    else if found >= n then
        n

    else
        last found


{-| `prompt_backward_word`: to the start of the word before the caret. -}
viBackward : String -> Asking -> Int
viBackward separators a =
    let
        at i =
            Maybe.withDefault (meant Reason.OutOfRange ' ') (Array.get i a.chars)

        isSep i =
            String.contains (String.fromChar (at i)) separators

        nonSpace i =
            if i <= 0 then
                0

            else if at (i - 1) /= ' ' then
                i - 1

            else
                nonSpace (i - 1)

        found =
            nonSpace a.caret

        cls =
            isSep found

        start i =
            if i <= 0 then
                0

            else if at (i - 1) == ' ' || isSep (i - 1) /= cls then
                i

            else
                start (i - 1)
    in
    start found


emacsKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> Asking -> (taken s : State) -> { state : State, commands : Array String }
emacsKey k bytes ms a0 s =
    let
        -- the matches Tab listed go with the next key, as 3.8's
        -- `prompt_clear_complete` (TM96); Tab lists them again
        a =
            { a0 | matches = [] }

        name =
            Maybe.withDefault (meant Reason.NotKnown "") (lookupName k)

        text =
            Bytes.toStringLossy k.text

        plainText =
            Bitwise.and k.mods 6 == 0 && text /= "" && Maybe.withDefault (meant Reason.NoMore False) (Maybe.map (\c -> Char.toCode c.first >= 0x20 && Char.toCode c.first /= 0x7F) (String.popFirst text))

        enter =
            name == "Enter" || name == "KPEnter" || name == "C-m" || name == "C-j"

        cancel =
            name == "Escape" || name == "C-c" || name == "C-g"
    in
    when a.ask is
        Syntax.Confirm c ->
            closePrompt
                (if text == c.key || (enter && c.enterYes) then
                    [ c.run ]

                 else
                    []
                )
                a
                s

        Syntax.Prompt p ->
            when p.entry is
                Syntax.Single ->
                    if cancel then
                        closePrompt [] a s

                    else
                        answer
                            (if plainText then
                                text

                             else
                                name
                            )
                            a
                            s

                Syntax.KeyName ->
                    answer name a s

                Syntax.Numeric ->
                    if plainText && String.all Char.isDigit text then
                        { state = { s | asking = Just (insert text a) }, commands = [] }

                    else if enter then
                        answer (String.fromArray a.chars) a s

                    else if cancel then
                        closePrompt [] a s

                    else if name == "BSpace" || name == "C-h" then
                        { state = { s | asking = Just (editLine name a (historyFor (promptKind s a) s) (wordRules s)) }, commands = [] }

                    else
                        -- the count answered, and the key goes on as typed
                        let
                            counted =
                                answer (String.fromArray a.chars) a s

                            next =
                                typed k bytes ms counted.state
                        in
                        { state = next.state, commands = counted.commands ++ next.commands }

                Syntax.Text ->
                    if p.incremental then
                        incrementalKey name text plainText enter cancel a s

                    else if name == "Tab" && p.template == Nothing && s.version > 0 && s.version < 38 && targetWord a then
                        -- before 3.8 a -t or -s word is a session or a
                        -- window, which tmux is asked for (TM97, TM98)
                        sendAsking [ { command = Command.display "#{session_name}", expect = ForTargetSession }, { command = Command.listWindowsAll "#{session_name}\t#{window_index}\t#{window_name}", expect = ForTargets { line = String.fromArray a.chars, caret = a.caret } } ] s

                    else if name == "Tab" && p.template == Nothing then
                        -- the colon prompt: a word completed as this tmux
                        -- completes it (TM57, TM96); 3.2 to 3.7 show what
                        -- they cannot choose between in a menu (TM98)
                        let
                            done =
                                completed (completions s) s.version a
                        in
                        if s.version >= 32 && s.version < 38 && done.chars == a.chars && Array.length (completionMatches (completions s) a) > 1 then
                            { state = completionMenu 0 (Array.map (\m -> { shown = m, text = m }) (Array.takeLast 10 (completionMatches (completions s) a))) a s, commands = [] }

                        else
                            { state = { s | asking = Just done }, commands = [] }

                    else if enter then
                        answer (String.fromArray a.chars) a s

                    else if cancel then
                        closePrompt [] a s

                    else if plainText then
                        { state = { s | asking = Just (insert text a) }, commands = [] }

                    else if name == "C-y" then
                        pasteInPrompt a s

                    else
                        { state = { s | asking = Just (editLine name a (historyFor (promptKind s a) s) (wordRules s)) }, commands = [] }


{-| A key in an incremental prompt (`-i`), as tmux's: each change to the
line runs the command with `=`; C-r and C-s run it with `-` and `+`, or
on an empty line bring back the first text with `=`; Enter closes it
with nothing more run, the line kept for Up, and Escape, C-c or C-g
closes it. Keys that move the caret run nothing, since the same line
again would go on to the next match. -}
incrementalKey : String -> String -> Bool -> Bool -> Bool -> Asking -> (taken s : State) -> { state : State, commands : Array String }
incrementalKey name text plainText enter cancel a s =
    let
        line =
            String.fromArray a.chars

        recalled =
            { a | chars = String.toArray a.recall, caret = String.count a.recall, edited = True }

        b =
            if plainText then
                insert text a

            else
                editLine name a (historyFor (promptKind s a) s) (wordRules s)
    in
    if enter then
        closePrompt []
            a
            (let
                kind =
                    promptKind s a

                own =
                    Maybe.withDefault (meant Reason.NotSet []) (Dict.get kind s.history)
             in
             { s
                | history =
                    if line == "" || Array.last own == Just line then
                        s.history

                    else
                        Dict.set kind (Array.pushLast line own) s.history
             }
            )

    else if cancel then
        closePrompt [] a s

    else if (name == "C-r" || name == "C-s") && Array.isEmpty a.chars then
        runIncremental '=' recalled s

    else if name == "C-r" then
        runIncremental '-' a s

    else if name == "C-s" then
        runIncremental '+' a s

    else if b.chars == a.chars then
        { state = { s | asking = Just b }, commands = [] }

    else
        runIncremental '=' b s


{-| The incremental prompt `a` on screen, its command run with `prefix`. -}
runIncremental : Char -> Asking -> (taken s : State) -> { state : State, commands : Array String }
runIncremental prefix a s =
    sendAsking (incrementally prefix a) { s | asking = Just a }


{-| The names Tab completes a word to, as this tmux's prompt has them
(`status_prompt_complete_list`; 3.8's `prompt_complete_commands`; TM96):
a first word and any other. 3.8: a first word only, the commands and the
`command-alias` names. 3.2 to 3.7: a first word the commands, their short
aliases and the `command-alias` names; another, those and the options and
the layouts (`-mirrored` from 3.5). Before 3.2 every word the commands,
the options and the layouts, the `command-alias` names from 2.9. -}
completions : State -> { first : Array String, other : Array String }
completions s =
    let
        v =
            s.version

        mirrored =
            v == 0 || v >= 35

        layouts =
            [ "even-horizontal", "even-vertical", "main-horizontal" ]
                ++ (if mirrored then
                        [ "main-horizontal-mirrored" ]

                    else
                        []
                   )
                ++ [ "main-vertical" ]
                ++ (if mirrored then
                        [ "main-vertical-mirrored" ]

                    else
                        []
                   )
                ++ [ "tiled" ]

        options =
            Dict.keys (Customize.table v).infos

        aliases =
            if v == 0 || v >= 29 then
                s.aliasNames

            else
                []
    in
    if v == 0 || v >= 38 then
        { first = s.commandNames ++ aliases, other = [] }

    else if v >= 32 then
        { first = s.commandNames ++ s.shortNames ++ aliases, other = s.commandNames ++ s.shortNames ++ aliases ++ options ++ layouts }

    else
        { first = s.commandNames ++ aliases ++ options ++ layouts, other = s.commandNames ++ aliases ++ options ++ layouts }


{-| The word before the caret completed from `lists`, as tmux's prompt
does (`prompt_replace_complete`, TM57, TM96): one match written whole with
a space after it, more as far as they agree; when they agree no further
than what is typed, 3.8 lists them after the line (`matches`). An empty
word completes to nothing. -}
completed : { first : Array String, other : Array String } -> Int -> Asking -> Asking
completed lists version a =
    let
        soFar =
            Array.takeFirst a.caret a.chars

        -- where the word at the caret begins: after the last space
        start =
            Array.findLast (\c -> c == ' ') soFar
                -- an index clamped to 2,000,000,000, far past any line typed,
                -- which says to the compiler that the sum cannot wrap
                |> Maybe.map (\found -> clamp 0 2000000000 found.index + 1)
                -- no space before it: the first word
                |> Maybe.withDefault (meant Reason.NoMore 0)

        word =
            String.fromArray (Array.dropFirst start soFar)

        pool =
            if start == 0 then
                lists.first

            else
                lists.other

        matches =
            pool
                |> Array.keepIf (\c -> String.startsWith word c)
                |> Array.foldl
                    (\m acc ->
                        if Array.member m acc then
                            acc

                        else
                            Array.pushLast m acc
                    )
                    []
                |> Array.sort

        common =
            when Array.first matches is
                Just first ->
                    Array.foldl
                        (\m acc ->
                            let
                                shared =
                                    Array.range 0 (min (String.count m) (String.count acc))
                                        |> Array.findLast (\k -> String.takeFirst k m == String.takeFirst k acc)
                                        |> Maybe.map .value
                                        |> Maybe.withDefault (meant Reason.NoMore 0)
                            in
                            String.takeFirst shared acc
                        )
                        first
                        matches

                Nothing ->
                    meant Reason.NoMore word

        replaced text =
            let
                added =
                    String.toArray text
            in
            { a | chars = Array.takeFirst start a.chars ++ added ++ Array.dropFirst a.caret a.chars, caret = start + Array.length added, edited = True }
    in
    if word == "" || Array.isEmpty matches then
        a

    else
        when matches is
            [ only ] ->
                replaced (only ++ " ")

            _ ->
                if common /= word then
                    replaced common

                else if version == 0 || version >= 38 then
                    { a | matches = matches }

                else
                    a


{-| The word at the caret: from the last space before it to it. -}
caretWord : Asking -> { start : Int, word : String }
caretWord a =
    let
        soFar =
            Array.takeFirst a.caret a.chars

        start =
            Array.findLast (\c -> c == ' ') soFar
                -- an index clamped to 2,000,000,000, far past any line typed,
                -- which says to the compiler that the sum cannot wrap
                |> Maybe.map (\found -> clamp 0 2000000000 found.index + 1)
                -- no space before it: the first word
                |> Maybe.withDefault (meant Reason.NoMore 0)
    in
    { start = start, word = String.fromArray (Array.dropFirst start soFar) }


{-| Whether the word at the caret is a target, `-t…` or `-s…` (TM97). -}
targetWord : Asking -> Bool
targetWord a =
    let
        w =
            (caretWord a).word
    in
    String.startsWith "-t" w || String.startsWith "-s" w


{-| A `-t` or `-s` word completed as tmux before 3.2 completes one
(`status_prompt_complete`, 2.7 to 3.1, TM97): a session's name, with `:`
after one alone (a word ending `:` matched without it); failing that a
window, of the current session for `:…` and of any for `session:…`, by
name or else by index, with a space after one alone; more matches as far
as they agree. -}
targetCompleted : Array { session : String, index : String, name : String } -> String -> Asking -> Asking
targetCompleted rows current a =
    let
        at =
            caretWord a

        flag =
            String.slice 1 2 at.word

        endsColon =
            String.endsWith ":" at.word

        wanted =
            if endsColon then
                String.dropLast 1 (String.dropFirst 2 at.word)

            else
                String.dropFirst 2 at.word

        unique items =
            Array.foldl
                (\m acc ->
                    if Array.member m acc then
                        acc

                    else
                        Array.pushLast m acc
                )
                []
                items

        prefixOf items =
            let
                -- `more`: two or more, so a first
                first =
                    Array.getProven 0 items
            in
            Array.foldl
                (\m acc ->
                    let
                        shared =
                            Array.range 0 (min (String.count m) (String.count acc))
                                |> Array.findLast (\k -> String.takeFirst k m == String.takeFirst k acc)
                                |> Maybe.map .value
                                -- nothing in common
                                |> Maybe.withDefault (meant Reason.NoMore 0)
                    in
                    String.takeFirst shared acc
                )
                first
                items

        sessions =
            rows |> Array.map .session |> unique |> Array.sort |> Array.keepIf (\name -> String.startsWith wanted name)

        -- a window by its name, or else by its index
        windowsOf candidates =
            candidates
                |> Array.mapAndKeepJust
                    (\c ->
                        if String.startsWith wanted c.byName then
                            Just c.byName

                        else if String.startsWith wanted c.byIndex then
                            Just c.byIndex

                        else
                            Nothing
                    )

        windows =
            if String.startsWith ":" wanted then
                rows
                    |> Array.keepIf (\r -> r.session == current)
                    |> Array.map (\r -> { byName = ":" ++ r.name, byIndex = ":" ++ r.index })
                    |> windowsOf

            else
                rows
                    |> Array.map (\r -> { byName = r.session ++ ":" ++ r.name, byIndex = r.session ++ ":" ++ r.index })
                    |> windowsOf

        replaced text =
            let
                added =
                    String.toArray text
            in
            { a | chars = Array.takeFirst at.start a.chars ++ added ++ Array.dropFirst a.caret a.chars, caret = at.start + Array.length added, edited = True }
    in
    when sessions is
        [ only ] ->
            replaced ("-" ++ flag ++ only ++ ":")

        [] ->
            when windows is
                [ only ] ->
                    replaced ("-" ++ flag ++ only ++ " ")

                [] ->
                    a

                more ->
                    replaced ("-" ++ flag ++ prefixOf more)

        more ->
            replaced
                ("-"
                    ++ flag
                    ++ prefixOf more
                    ++ (if endsColon then
                            ":"

                        else
                            ""
                       )
                )


{-| The word at the caret made `text` (`status_prompt_replace_complete`). -}
wordReplaced : String -> Asking -> Asking
wordReplaced text a =
    let
        at =
            caretWord a

        added =
            String.toArray text
    in
    { a | chars = Array.takeFirst at.start a.chars ++ added ++ Array.dropFirst a.caret a.chars, caret = at.start + Array.length added, edited = True }


{-| What the word at the caret matches, sorted, each once (TM96). -}
completionMatches : { first : Array String, other : Array String } -> Asking -> Array String
completionMatches lists a =
    let
        at =
            caretWord a

        pool =
            if at.start == 0 then
                lists.first

            else
                lists.other
    in
    if at.word == "" then
        []

    else
        pool
            |> Array.keepIf (\c -> String.startsWith at.word c)
            |> Array.foldl
                (\m acc ->
                    if Array.member m acc then
                        acc

                    else
                        Array.pushLast m acc
                )
                []
            |> Array.sort


{-| The prompt's menu of matches (3.2 to 3.7's
`status_prompt_complete_list_menu` and `_window_menu`, TM98): its items
numbered from 0, each standing for the text that takes the word's place;
over the status line's row, its left edge two cells left of the word, as
tmux places it. -}
completionMenu : Int -> Array { shown : String, text : String } -> Asking -> (taken s : State) -> State
completionMenu shift items a s =
    let
        at =
            caretWord a

        lines =
            max 1 (statusRows s)

        height =
            Array.length items

        -- a target's menu from after its `-t` (`offset += 2`)
        x =
            max 0 (textCells a.label + at.start + shift - 2)

        y =
            if s.barTop then
                lines

            else
                s.canvas.rows - 3 - height
    in
    { s
        | serial = s.serial + 1
        , menu =
            Just
                { serial = s.serial + 1
                , title = ""
                , items = Array.indexedMap (\i item -> { name = item.shown, key = String.fromInt i, command = item.text }) items
                , pending = 0
                -- the first item chosen, as the keyboard opens a menu
                , selected = 0
                , pane = s.active
                , mouse = Nothing
                , x = String.fromInt x
                , y = String.fromInt y
                , armed = False
                , stayOpen = False
                , start = Nothing
                , forMode = False
                , completes = True
                }
    }


{-| A `-t` or `-s` word on 3.2 to 3.7 (`status_prompt_complete`, TM98):
with no `:` a session, `name:`, the matches as far as they agree and a
menu of them when that is no further; with one, a window of that session
(of the client's for `:…`) by its index, one alone written, more in a
menu, `session:index (name)` each. -}
targetMenu : Array { session : String, index : String, name : String } -> String -> Asking -> (taken s : State) -> State
targetMenu rows current a s =
    let
        at =
            caretWord a

        flag =
            String.slice 1 2 at.word

        wanted =
            String.dropFirst 2 at.word

        dash text =
            "-" ++ flag ++ text

        unique items =
            Array.foldl
                (\m acc ->
                    if Array.member m acc then
                        acc

                    else
                        Array.pushLast m acc
                )
                []
                items
    in
    when String.indices ":" wanted |> Array.first is
        Nothing ->
            -- no `:`: a session
            meant Reason.NoMore
                let
                    sessions =
                        rows |> Array.map .session |> unique |> Array.sort |> Array.keepIf (\n -> String.startsWith wanted n) |> Array.map (\n -> n ++ ":")

                    common =
                        commonPrefix sessions
                in
                when sessions is
                    [] ->
                        s

                    [ only ] ->
                        { s | asking = Just (wordReplaced (dash only) a) }

                    _ ->
                        if dash common /= at.word then
                            { s | asking = Just (wordReplaced (dash common) a) }

                        else
                            completionMenu 2 (Array.map (\m -> { shown = m, text = dash m }) (Array.takeLast 10 sessions)) a s

        Just colon ->
            let
                named =
                    String.slice 0 colon wanted

                session =
                    if named == "" then
                        current

                    else
                        named

                index =
                    String.dropFirst (colon + 1) wanted

                windows =
                    rows
                        |> Array.keepIf (\r -> r.session == session && String.startsWith index r.index)
                        |> Array.takeFirst 10
            in
            if String.contains "." index then
                s

            else
                when windows is
                    [] ->
                        s

                    [ only ] ->
                        { s | asking = Just (wordReplaced (dash (session ++ ":" ++ only.index)) a) }

                    _ ->
                        completionMenu 2 (Array.map (\w -> { shown = session ++ ":" ++ w.index ++ " (" ++ w.name ++ ")", text = dash (session ++ ":" ++ w.index) }) windows) a s


{-| The longest start all of `items` share. -}
commonPrefix : Array String -> String
commonPrefix items =
    when Array.first items is
        Just first ->
            Array.foldl
                (\m acc ->
                    let
                        shared =
                            Array.range 0 (min (String.count m) (String.count acc))
                                |> Array.findLast (\k -> String.takeFirst k m == String.takeFirst k acc)
                                |> Maybe.map .value
                                -- nothing in common
                                |> Maybe.withDefault (meant Reason.NoMore 0)
                    in
                    String.takeFirst shared acc
                )
                first
                items

        Nothing ->
            meant Reason.NoMore ""


{-| Text typed at the caret. -}
insert : String -> Asking -> Asking
insert text a =
    let
        added =
            String.toArray text
    in
    { a | chars = Array.slice 0 a.caret a.chars ++ added ++ Array.dropFirst a.caret a.chars, caret = a.caret + Array.length added, edited = True }


{-| C-y at tmux's prompt, as tmux's (`status_prompt_paste`, TM80): from
3.0 what C-w last cut, if anything; else the newest buffer, asked of tmux,
put in when it answers (`ForPromptPaste`). -}
pasteInPrompt : Asking -> (taken s : State) -> { state : State, commands : Array String }
pasteInPrompt a s =
    if a.cut /= "" && (s.version == 0 || s.version >= 30) then
        { state = { s | asking = Just (insert a.cut a) }, commands = [] }

    else
        sendAsking [ { command = Command.showTopBuffer, expect = ForPromptPaste } ] s


{-| A buffer's text as the prompt's C-y takes it: up to its first control
character; before 3.0 only up to its first byte that is not printable
ASCII, as 2.x reads it a byte at a time (TM80). -}
promptPasted : Int -> String -> String
promptPasted version text =
    String.toArray text
        |> Array.foldl
            (\c acc ->
                if acc.stopped then
                    acc

                else
                    let
                        code =
                            Char.toCode c
                    in
                    if code < 32 || code == 127 || (version > 0 && version < 30 && code > 127) then
                        { acc | stopped = True }

                    else
                        { acc | chars = Array.pushLast c acc.chars }
            )
            { chars = [], stopped = False }
        |> .chars
        |> String.fromArray


{-| What the prompt's word keys go by: this tmux and the session's
`word-separators` (RV2). -}
wordRules : State -> { version : Int, separators : String }
wordRules s =
    { version = s.version
    , separators =
        when Dict.get "word-separators" s.status.options is
            Just ws ->
                ws

            Nothing ->
                -- not asked yet: this tmux's default (`options-table.c`)
                meant Reason.NotSet
                    (if s.version > 0 && s.version < 30 then
                        " -_@"

                     else if s.version > 0 && s.version < 33 then
                        " "

                     else
                        "!\"#$%&'()*+,-./:;<=>?@[\\]^`{|}~"
                    )
    }


{-| An editing key, by its tmux name, on the line. The word keys (M-b,
M-f, C-w, and Ctrl+Left and Ctrl+Right from 3.0) stop at the session's
`word-separators` as tmux's do (docs/review.md RV2): before 3.3 a word
is the run between separators (`status_prompt_key`), from 3.3 a run of
separators is a word of its own and spaces part words
(`prompt_forward_word`, `prompt_backward_word`). -}
editLine : String -> Asking -> Array String -> { version : Int, separators : String } -> Asking
editLine name a history rules =
    let
        n =
            Array.length a.chars

        newer =
            rules.version == 0 || rules.version >= 33

        wordStart =
            if newer then
                viBackward rules.separators a

            else
                oldBackward rules.separators a

        wordEnd =
            if newer then
                viForward False rules.separators a

            else
                oldForward False rules.separators a

        -- Ctrl+Left and Ctrl+Right move by words from 3.0
        ctrlArrows =
            rules.version == 0 || rules.version >= 30

        recalled step =
            -- Up goes back through earlier answers, Down forward
            let
                current =
                    String.fromArray a.chars

                at =
                    clamp 0 (Array.length history) (Array.findLast (\h -> h == current) history |> Maybe.map .index |> Maybe.withDefault (meant Reason.NotKnown Array.length history))

                -- one back or one on, written so that neither can wrap
                to =
                    if step < 0 then
                        if at > 0 then
                            at - 1

                        else
                            -1

                    else if at < Array.length history then
                        at + 1

                    else
                        Array.length history
            in
            when Array.get to history is
                Just h ->
                    { a | chars = String.toArray h, caret = String.count h, edited = True }

                Nothing ->
                    meant Reason.OutOfRange
                        if to >= Array.length history then
                            { a | chars = [], caret = 0, edited = True }

                        else
                            a
    in
    if name == "Left" || name == "C-b" then
        { a | caret = max 0 (a.caret - 1) }

    else if name == "Right" || name == "C-f" then
        { a | caret = min n (a.caret + 1) }

    else if name == "Home" || name == "C-a" then
        { a | caret = 0 }

    else if name == "End" || name == "C-e" then
        { a | caret = n }

    else if name == "BSpace" || name == "C-h" then
        if a.caret == 0 then
            a

        else
            { a | chars = Array.slice 0 (a.caret - 1) a.chars ++ Array.dropFirst a.caret a.chars, caret = a.caret - 1, edited = True }

    else if name == "DC" || name == "C-d" then
        { a | chars = Array.slice 0 a.caret a.chars ++ Array.dropFirst (a.caret + 1) a.chars, edited = True }

    else if name == "C-u" then
        -- the whole line, as tmux's (3.6a, 3.8)
        { a | chars = [], caret = 0, edited = True }

    else if name == "M-b" || (name == "C-Left" && ctrlArrows) then
        { a | caret = wordStart }

    else if name == "M-f" || (name == "C-Right" && ctrlArrows) then
        { a | caret = wordEnd }

    else if name == "C-t" then
        -- the characters before the caret swapped, the caret after them
        let
            at =
                min n
                    (a.caret
                        + (if a.caret < n then
                            1

                           else
                            0
                          )
                    )
        in
        if at >= 2 then
            { a | chars = Array.slice 0 (at - 2) a.chars ++ Array.slice (at - 1) at a.chars ++ Array.slice (at - 2) (at - 1) a.chars ++ Array.dropFirst at a.chars, caret = at, edited = True }

        else
            a

    else if name == "C-k" then
        { a | chars = Array.slice 0 a.caret a.chars, edited = True }

    else if name == "C-w" then
        { a | chars = Array.slice 0 wordStart a.chars ++ Array.dropFirst a.caret a.chars, caret = wordStart, edited = True, cut = String.fromArray (Array.slice wordStart a.caret a.chars) }

    else if name == "Up" || name == "C-p" then
        recalled -1

    else if name == "Down" || name == "C-n" then
        recalled 1

    else
        a


{-| An answer to the question asked: the next question, or the command
run with every answer, then the commands after the prompt. A typed line
is kept for Up. -}
answer : String -> Asking -> (taken s : State) -> { state : State, commands : Array String }
answer given a s =
    let
        answers =
            Array.pushLast given a.answers

        -- kept in its type's list (TM89)
        kind =
            promptKind s a

        own =
            Maybe.withDefault (meant Reason.NotSet []) (Dict.get kind s.history)

        history =
            if given == "" || Array.last own == Just given then
                s.history

            else
                Dict.set kind (Array.pushLast given own) s.history
    in
    if a.purpose >= 21 then
        -- customize-mode's own question (TM62); a yes or no is not kept
        customizeAnswered a.purpose
            given
            { s
                | asking = Nothing
                , history =
                    if a.purpose == 22 then
                        s.history

                    else
                        history
            }

    else if a.purpose >= 11 then
        -- a list's own question (TM55)
        listAnswered a.purpose given { s | asking = Nothing, history = history }

    else if a.purpose /= 0 then
        -- the tree's own question (TM45); a kill's y is not kept for Up
        treeAnswered a.purpose
            given
            { s
                | asking = Nothing
                , history =
                    if a.purpose == 3 || a.purpose == 4 then
                        s.history

                    else
                        history
            }

    else
        when a.ask is
            Syntax.Prompt p ->
                if a.step + 1 < Array.length p.prompts then
                    let
                        next =
                            stepTo (a.step + 1) answers a
                    in
                    sendAsking next.expand { s | asking = Just next.asking, history = history }

                else
                    let
                        line =
                            when p.template is
                                Just t ->
                                    Syntax.fill t answers

                                Nothing ->
                                    meant Reason.NotSet given
                    in
                    closePrompt
                        (if String.trim line == "" then
                            []

                         else
                            [ line ]
                        )
                        a
                        { s | history = history }

            Syntax.Confirm _ ->
                closePrompt [] a s


{-| The prompt closed: `run`, then the commands after it, each said at the
bar if it says anything; one puritty runs itself (`runsHere`: a tree, as
`find-window` from `prefix f` opens, a menu, another prompt) run here
(TM45). -}
closePrompt : Array String -> Asking -> (taken s : State) -> { state : State, commands : Array String }
closePrompt run a s =
    let
        lines =
            run
                ++ (if a.after == "" then
                        []

                    else
                        [ a.after ]
                   )
    in
    Array.foldl
        (\line acc ->
            let
                r =
                    if runsHere line then
                        runLine { pane = acc.state.active, mouse = Nothing } line acc.state

                    else if endsClient acc.state.clientName line then
                        -- a typed line that detaches this client: nothing
                        -- after it goes (TM92)
                        let
                            st =
                                acc.state
                        in
                        sendAsking [ { command = line, expect = ForRan } ] { st | ending = 1 }

                    else if runsCommands line then
                        sendAsking [ { command = line, expect = ForRan } ] acc.state

                    else
                        -- a fence after every line typed, so that one tmux
                        -- makes no command of, and answers with no block,
                        -- does not leave the replies one behind (review TA1)
                        sendAsking [ { command = line, expect = ForRan }, { command = Command.display fenceWord, expect = ForFence } ] acc.state
            in
            { state = r.state, commands = acc.commands ++ r.commands }
        )
        { state = { s | asking = Nothing }, commands = [] }
        (Array.mapAndFlatten Syntax.lines lines)


{-| An error as tmux shows it to a client: a control client is sent
`parse error: unknown command: x` (`control.c`), a client's status line
shows `Unknown command: x`, its first letter made a capital
(`cmd-queue.c`, TM59). -}
asTmuxSays : String -> String
asTmuxSays text =
    let
        bare =
            if String.startsWith "parse error: " text then
                String.dropFirst 13 text

            else
                text
    in
    when String.popFirst bare is
        Just { first, rest } ->
            String.toUpper (String.fromChar first) ++ rest

        Nothing ->
            meant Reason.FromOutside bare


{-| Commands sent, each with what its reply is for; after one the user
runs that runs commands itself (`source-file`, `if-shell`, `run-shell -C`),
a fence, whose reply ends theirs (TK10). -}
sendAsking : Array { command : String, expect : Expect } -> (taken s : State) -> { state : State, commands : Array String }
sendAsking list s =
    let
        fenced =
            Array.mapAndFlatten
                (\c ->
                    if c.expect == ForRan && runsCommands c.command then
                        [ c, { command = Command.display fenceWord, expect = ForFence } ]

                    else
                        [ c ]
                )
                list
                -- after the user's commands, the window asked again: tmux
                -- does not tell every change to its panes' places (TK12)
                |> (\l ->
                        if Array.any (\c -> c.expect == ForRan) l then
                            Array.pushLast { command = windowQuery, expect = ForWindow } l

                        else
                            l
                   )
                -- after one that may bind keys or set the prefix, the key
                -- tables read again (TA12, TM114)
                |> (\l ->
                        if Array.any (\c -> c.expect == ForRan && changesKeys c.command) list then
                            l ++ keysQueries

                        else
                            l
                   )
    in
    { state = expected fenced s, commands = Array.map .command fenced }


{-| What puritty reads of tmux's keys: the tables, and the prefixes with
the repeat time (TM24). -}
keysQueries : Array { command : String, expect : Expect }
keysQueries =
    [ { command = Command.listKeys, expect = ForKeys }
    , { command = Command.display "#{prefix} #{prefix2} #{repeat-time} #{version}", expect = ForPrefixes }
    ]


{-| Whether a command line may change the keys puritty routes by (TA12,
TM114): `bind-key`, `unbind-key`, `source-file`, a command that runs
others (`if-shell`, `run-shell -C`), or a `set-option` of `prefix`,
`prefix2` or `repeat-time`, by name or alias. -}
changesKeys : String -> Bool
changesKeys line =
    runsCommands line
        || (Syntax.commands (Syntax.tokens line)
                |> Array.any
                    (\words ->
                        let
                            values =
                                Array.map .value words
                        in
                        when Array.popFirst values is
                            Just { first, rest } ->
                                Array.member first [ "bind-key", "bind", "unbind-key", "unbind", "source-file", "source" ]
                                    || (Array.member first [ "set-option", "set" ] && Array.any (\w -> Array.member w [ "prefix", "prefix2", "repeat-time" ]) rest)

                            Nothing ->
                                meant Reason.FromOutside False
                    )
           )


{-| Whether a command line runs tmux commands of its own, each answered
with a block (from 3.2 as this client's): `source-file`, `if-shell`, and
`run-shell -C` (TK10). -}
runsCommands : String -> Bool
runsCommands line =
    Syntax.commands (Syntax.tokens line)
        |> Array.any
            (\words ->
                when Array.map .value words |> Array.popFirst is
                    Just { first, rest } ->
                        Command.runsOthers first (Array.keepIf (\w -> String.startsWith "-" w) rest |> String.join "")

                    Nothing ->
                        meant Reason.FromOutside False
            )


{-| Commands sent on one line, `a ; b`: one line's number for all, since
a failing one ends it (TK10). -}
expectedLine : Array { command : String, expect : Expect } -> (taken s : State) -> State
expectedLine list s =
    awaited (Array.map (\c -> { expect = c.expect, command = c.command, line = s.linesSent }) list) 1 s


{-| Commands' replies waited for, each sent on its own line, in order. -}
expected : Array { command : String, expect : Expect } -> (taken s : State) -> State
expected list s =
    awaited (Array.indexedMap (\i c -> { expect = c.expect, command = c.command, line = s.linesSent + i }) list) (Array.length list) s


{-| Commands waited for, on `lines` more lines; the user's own commands
(`ForRan`) remembered, the last 50, so that tmux's message log can show
them and not puritty's others (TM65). -}
awaited : Array Asked -> Int -> (taken s : State) -> State
awaited asked lines s =
    let
        mine =
            Array.keepIf (\a -> a.expect == ForRan) asked |> Array.map .command
    in
    if Array.isEmpty mine then
        { s | expecting = s.expecting ++ asked, linesSent = s.linesSent + lines }

    else
        { s | expecting = s.expecting ++ asked, linesSent = s.linesSent + lines, userRan = Array.takeLast 50 (s.userRan ++ mine) }


{-| A key as `send-keys -K` takes it (TM23): by its tmux name where it has
one, other text as its bytes, a Super chord as the pane's bytes. -}
byName : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> Array String
byName k bytes pane =
    when keyName k is
        Just name ->
            [ Command.sendKey name ]

        Nothing ->
            meant Reason.NotKnown
                if Bitwise.and (Bitwise.and k.mods 15) 14 == 0 && not (Bytes.isEmpty k.text) then
                    Command.typeText k.text

                else
                    Command.sendBytes pane bytes


{-| A key's name as `list-keys` gives it: `keyName`'s, or a character
typed alone, a space as `Space`. -}
lookupName : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe String
lookupName k =
    when keyName k is
        Just name ->
            Just name

        Nothing ->
            meant Reason.NotKnown
                let
                    text =
                        Bytes.toStringLossy k.text
                in
                if text == " " then
                    Just "Space"

                else if String.count text == 1 then
                    Just text

                else
                    Nothing


{-| A key's tmux name (tmux(1) KEY BINDINGS): a named key (`Up`, `F5`,
`BSpace`), or a character with Ctrl or Alt, with `C-`, `M-` and, for a
named key or a Ctrl letter, `S-`. `Nothing` for plain text, which goes as
its bytes, and for a chord with Super. -}
keyName : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe String
keyName k =
    let
        mods =
            Bitwise.and k.mods 15

        shift =
            Bitwise.and mods 1 /= 0

        ctrl =
            Bitwise.and mods 2 /= 0

        alt =
            Bitwise.and mods 4 /= 0

        lead =
            (if ctrl then
                "C-"

             else
                ""
            )
                ++ (if alt then
                        "M-"

                    else
                        ""
                   )

        text =
            Bytes.toStringLossy k.text

        printable str =
            String.count str == 1 && Maybe.withDefault (meant Reason.NoMore False) (Maybe.map (\c -> Char.toCode c >= 0x20 && Char.toCode c /= 0x7F) (Maybe.map .first (String.popFirst str)))
    in
    if Bitwise.and mods 8 /= 0 then
        Nothing

    else
        when namedKey k.sym is
            Just "BTab" ->
                Just (lead ++ "BTab")

            Just name ->
                Just
                    (lead
                        ++ (if shift then
                                "S-"

                            else
                                ""
                           )
                        ++ name
                    )

            Nothing ->
                meant Reason.NotKnown
                    if ctrl then
                        when Char.fromCode k.unshifted is
                            Just c ->
                                if k.unshifted > 0x20 && k.unshifted < 0x7F then
                                    Just
                                        (lead
                                            ++ (if shift && Char.isAlpha c then
                                                    "S-"

                                                else
                                                    ""
                                               )
                                            ++ String.toLower (String.fromChar c)
                                        )

                                else if k.unshifted == 0x20 then
                                    Just (lead ++ "Space")

                                else
                                    Nothing

                            Nothing ->
                                meant Reason.FromOutside Nothing

                    else if alt then
                        if text == " " then
                            Just "M-Space"

                        else if printable text then
                            Just ("M-" ++ text)

                        else
                            Nothing

                    else
                        Nothing


{-| tmux's name for a key by its X keysym, as both platforms' windows give
it. -}
namedKey : Int -> Maybe String
namedKey sym =
    if sym >= 0xFFBE && sym <= 0xFFC9 then
        Just ("F" ++ String.fromInt (sym - 0xFFBE + 1))

    else
        when sym is
            0xFF52 ->
                Just "Up"

            0xFF54 ->
                Just "Down"

            0xFF51 ->
                Just "Left"

            0xFF53 ->
                Just "Right"

            0xFF50 ->
                Just "Home"

            0xFF57 ->
                Just "End"

            0xFF55 ->
                Just "PPage"

            0xFF56 ->
                Just "NPage"

            0xFF63 ->
                Just "IC"

            0xFFFF ->
                Just "DC"

            0xFF09 ->
                Just "Tab"

            0xFE20 ->
                Just "BTab"

            0xFF0D ->
                Just "Enter"

            0xFF8D ->
                Just "KPEnter"

            0xFF1B ->
                Just "Escape"

            0xFF08 ->
                Just "BSpace"

            _ ->
                Nothing


{-| Commands sent whose replies are read and dropped. -}
waitingFor : Array String -> (taken s : State) -> State
waitingFor commands s =
    expected (Array.map (\c -> { command = c, expect = ForNothing }) commands) s


{-| Commands whose replies say nothing puritty reads, sent. -}
sent : Array String -> (taken s : State) -> { state : State, commands : Array String }
sent commands s =
    { state = expected (Array.map (\c -> { command = c, expect = ForNothing }) commands) s, commands = commands }


{-| A binding's commands on one line (before 3.4, TM72): a reply waited
for for each, on the line's one number, since tmux answers each and a
failing one ends the line (TK10), and after one that runs commands of
its own, a fence (TM116). -}
sentBinding : String -> (taken s : State) -> { state : State, commands : Array String }
sentBinding line s =
    let
        each =
            Syntax.commands (Syntax.tokens line)
                |> Array.map (\words -> { command = String.join " " (Array.map .value words), expect = ForNothing })

        fence =
            if runsCommands line then
                [ { command = Command.display fenceWord, expect = ForFence } ]

            else
                []
    in
    { state = expected fence (expectedLine each s), commands = [ line ] ++ Array.map .command fence }


{-| What a key sends the active pane's program, by that pane's modes
(DECCKM, keypad, the kitty flags, modifyOtherKeys); `Nothing` when no pane
is active yet. -}
encodeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> State -> Maybe Bytes
encodeKey k s =
    withPane s.active s (\t -> Keys.encode t k)


{-| Whether a private mode is set in the active pane, as bracketed paste
(2004) and focus reports (1004) are asked. -}
activeMode : Int -> State -> Maybe Bool
activeMode mode s =
    withPane s.active s (\t -> Dict.get mode t.modes == Just True)


{-| What a pane's terminal answers, looked at in place. -}
withPane : Int -> State -> (Vt.Term -> a) -> Maybe a
withPane pane s f =
    let
        -- `ids` and `panes` are one length (`State`'s rule), so an id's
        -- place is its terminal's
        at =
            Array.findIndex (\i -> i == pane) s.ids
    in
    if at >= 0 then
        Just (f (Builder.getProven at s.panes))

    else
        Nothing


{-| How far back a pane's view is scrolled. -}
backOf : Int -> State -> Int
backOf pane s =
    Maybe.withDefault (meant Reason.NotOpen 0) (Dict.get pane s.back)


{-| The cells of the canvas a pane's part of the selection covers, row by
row, where they show: its rows are absolute (pushed rows and the screen's),
drawn at the pane's place less how far it is scrolled back. -}
spans : Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
spans q s =
    when Dict.get q.id s.copy |> Maybe.andThen .selection is
        Just sel ->
            copySpans q (Maybe.withDefault (meant Reason.NotOpen { scroll = 0, hsize = 0, located = False, cx = 0, cy = 0, selection = Nothing, rectangle = False, marked = False, count = 0, partial = False, timedOut = False, lineTime = "", search = "" }) (Dict.get q.id s.copy)) sel

        Nothing ->
            meant Reason.NotOpen ownSpans q s


{-| Copy mode's selection on the canvas (TM31): tmux's lines made the view's
rows by the view's top (`history_size` less `scroll_position`), each end's
cell included, by cells or, as a rectangle, the same columns on every row. -}
copySpans : Layout.Pane -> Copying -> { sx : Int, sy : Int, ex : Int, ey : Int } -> Array { row : Int, from : Int, to : Int }
copySpans q c sel =
    let
        top =
            c.hsize - c.scroll

        ordered =
            if sel.sy < sel.ey || (sel.sy == sel.ey && sel.sx <= sel.ex) then
                { fx = sel.sx, fy = sel.sy, tx = sel.ex, ty = sel.ey }

            else
                { fx = sel.ex, fy = sel.ey, tx = sel.sx, ty = sel.sy }

        left =
            min sel.sx sel.ex

        right =
            max sel.sx sel.ex
    in
    Array.range (max ordered.fy top) (min ordered.ty (top + q.h - 1))
        |> Array.map
            (\r ->
                if c.rectangle then
                    { row = q.y + r - top, from = q.x + left, to = q.x + min (q.w - 1) right }

                else
                    { row = q.y + r - top
                    , from =
                        q.x
                            + (if r == ordered.fy then
                                ordered.fx

                               else
                                0
                              )
                    , to =
                        q.x + min (q.w - 1)
                                (if r == ordered.ty then
                                    ordered.tx

                                 else
                                    q.w - 1
                                )
                    }
            )


ownSpans : Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
ownSpans q s =
    when s.selection is
        Just sel ->
            if sel.pane /= q.id then
                []

            else
                Maybe.withDefault (meant Reason.Gone [])
                    (withPane q.id
                        s
                        (\t ->
                            let
                                top =
                                    Vt.rowsPushed t - backOf q.id s

                                ordered =
                                    if before sel.head sel.anchor then
                                        { from = sel.head, to = sel.anchor }

                                    else
                                        { from = sel.anchor, to = sel.head }
                            in
                            Array.range (max ordered.from.row top) (min ordered.to.row (top + q.h - 1))
                                |> Array.map
                                    (\r ->
                                        { row = q.y + r - top
                                        , from =
                                            q.x
                                                + (if r == ordered.from.row then
                                                    ordered.from.col

                                                   else
                                                    0
                                                  )
                                        , to =
                                            q.x
                                                + (if r == ordered.to.row then
                                                    ordered.to.col

                                                   else
                                                    q.w - 1
                                                  )
                                        }
                                    )
                        )
                    )

        Nothing ->
            meant Reason.NotOpen []


placesOf : Array Layout.Pane -> State -> Array { index : Int, x : Int, y : Int, back : Int, fg : Int, bg : Int }
placesOf panes s =
    let
        -- window-style for every pane, window-active-style over it for
        -- the active one, as tmux gives a pane its default colors (TM52);
        -- the pane's own where it has them (a popup's, TM66), as tmux
        -- looks a pane option up from the pane first
        styleFor id active =
            let
                own =
                    Dict.get id s.status.panes |> Maybe.map (\q -> String.split "\t" q.style) |> Maybe.withDefault (meant Reason.NotYet [])

                option index name =
                    when Array.get index own is
                        Just v ->
                            if v == "" then
                                Maybe.withDefault (meant Reason.NotSet "default") (Dict.get name s.status.options)

                            else
                                v

                        Nothing ->
                            meant Reason.NotSet (Maybe.withDefault (meant Reason.NotSet "default") (Dict.get name s.status.options))

                base =
                    Style.apply (option 0 "window-style") Style.plain

                st =
                    if active then
                        Style.apply (option 1 "window-active-style") base

                    else
                        base
            in
            if s.lookTmux then
                { fg = vtColor st.fg, bg = vtColor st.bg }

            else
                { fg = 0, bg = 0 }
    in
    Array.mapAndKeepJust
        (\p ->
            Array.findFirst (\i -> i == p.id) s.ids
                |> Maybe.map
                    (\found ->
                        let
                            colors =
                                styleFor p.id (p.id == s.active)
                        in
                        { index = found.index, x = p.x, y = p.y, back = backOf p.id s, fg = colors.fg, bg = colors.bg }
                    )
        )
        panes


{-| A style's color as SGR writes it (`34`, `94`, `38;5;236`,
`48;2;0;0;0`, and the backgrounds' `4x`, `10x`) as the terminal core
holds one: 0 none, 1 to 256 a palette index and one more, `0x1000000` and
the RGB value. -}
vtColor : String -> Int
vtColor sgr =
    let
        nums =
            String.split ";" sgr |> Array.mapAndKeepJust String.toInt
    in
    when nums is
        [ n ] ->
            if (n >= 30 && n <= 37) || (n >= 40 && n <= 47) then
                modBy 10 n + 1

            else if (n >= 90 && n <= 97) || (n >= 100 && n <= 107) then
                modBy 10 n + 9

            else
                0

        [ _, 5, i ] ->
            clamp 0 255 i + 1

        [ _, 2, r, g, b ] ->
            0x1000000 + clamp 0 255 r * 65536 + clamp 0 255 g * 256 + clamp 0 255 b

        _ ->
            0


eachPlaces : Array Layout.Pane -> State -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int, fg : Int, bg : Int } } -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int, fg : Int, bg : Int } }
eachPlaces panes s _ =
    Array.map (\p -> { id = p.id, places = placesOf [ p ] s }) panes


placesIn : Int -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int, fg : Int, bg : Int } } -> Array { index : Int, x : Int, y : Int, back : Int, fg : Int, bg : Int }
placesIn id all =
    Array.findFirst (\e -> e.id == id) all |> Maybe.map (\e -> e.value.places) |> Maybe.withDefault (meant Reason.NotKnown [])


spansAll : Array Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
spansAll panes s =
    Array.mapAndFlatten (\p -> spans p s) panes


withSpans : Array Layout.Pane -> State -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } } -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } }
withSpans panes s _ =
    Array.map (\p -> { id = p.id, spans = spans p s }) panes


spansIn : Int -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } } -> Array { row : Int, from : Int, to : Int }
spansIn id all =
    Array.findFirst (\e -> e.id == id) all |> Maybe.map (\e -> e.value.spans) |> Maybe.withDefault (meant Reason.NotKnown [])


before : Vt.Point -> Vt.Point -> Bool
before a b =
    a.row < b.row || (a.row == b.row && a.col < b.col)


{-| A pointer event in the window (docs/tmux.md TM16, TM17): a press on a
floating pane's top edge moves it and on its bottom or right edge resizes
it, tmux told as the pointer reaches each new cell; a press elsewhere makes
the pane under it active. A pane whose program asked for the mouse gets the
event as its own, in its own cells; the pane a press began in keeps the
mouse until it is let go. Otherwise, or with Shift (`select`), the left
button selects within the pane (a click, a double click for a word, a
triple for a line), the paste button asks for a paste, and the wheel
scrolls the pane's view, or on its alternate screen sends three arrow
keys. `held` is the buttons held after the event; `own` is a selection's
text when it is made, for PRIMARY. -}
pointer : { ms : Int, held : Int, select : Bool, boundaries : Array Int, pasteButton : Int } -> Window.PointerEvent -> (taken s : State) -> { state : State, commands : Array String, own : Maybe String, paste : Bool }
pointer how p s =
    let
        wasAsking =
            Maybe.map .ask s.asking

        r =
            pointerHere how p s

        -- a prompt the press opened (a menu's item) asks its history (TM89)
        asked =
            historyAsked wasAsking { state = r.state, commands = r.commands }
    in
    { state = asked.state, commands = asked.commands, own = r.own, paste = r.paste }


{-| The OSC 8 link under the pointer, in the topmost pane there (puritty
`docs/claude-code.md` CL9): its URI. -}
linkAt : Window.PointerEvent -> State -> Maybe String
linkAt p s =
    when s.layout is
        Just cell ->
            let
                col =
                    p.x // max 1 p.cellWidth

                row =
                    p.y // max 1 p.cellHeight
            in
            when placedPanes s cell (Array.reverse (Layout.floating cell) ++ Layout.tiled cell) |> Array.findFirst (\q -> col >= q.x && col < q.x + q.w && row >= q.y && row < q.y + q.h) is
                Just f ->
                    let
                        -- read before the pane's terminal is
                        back =
                            backOf f.value.id s

                        place =
                            { row = row - f.value.y, col = col - f.value.x }
                    in
                    when Array.findFirst (\i -> i == f.value.id) s.ids is
                        Just found ->
                            Vt.linkAt back place (Builder.getProven found.index s.panes)

                        Nothing ->
                            meant Reason.Gone Nothing

                Nothing ->
                    -- not over a pane
                    meant Reason.OutOfRange Nothing

        Nothing ->
            meant Reason.NotYet Nothing


{-| `pointer`'s press, release or motion. -}
pointerHere : { ms : Int, held : Int, select : Bool, boundaries : Array Int, pasteButton : Int } -> Window.PointerEvent -> (taken s : State) -> { state : State, commands : Array String, own : Maybe String, paste : Bool }
pointerHere how p s0 =
    let
        -- a grab, or a drag, whose pane has left the layout (it closed while
        -- a button was down) let go: kept, every press over a pane or a tab
        -- found nothing until the next attach (the code review's TA7)
        s =
            when s0.layout is
                Just cell ->
                    let
                        ids =
                            Array.map .id (Layout.floating cell ++ Layout.tiled cell)

                        grabGone =
                            when s0.grab is
                                Just g ->
                                    not (Array.member g ids)

                                Nothing ->
                                    meant Reason.NotOpen False

                        dragGone =
                            when s0.drag is
                                Just d ->
                                    d.pane >= 0 && not (Array.member d.pane ids)

                                Nothing ->
                                    meant Reason.NotOpen False
                    in
                    if grabGone && dragGone then
                        { s0 | grab = Nothing, drag = Nothing }

                    else if grabGone then
                        { s0 | grab = Nothing }

                    else if dragGone then
                        { s0 | drag = Nothing }

                    else
                        s0

                Nothing ->
                    meant Reason.NotYet s0
    in
    when s.layout is
        Nothing ->
            meant Reason.NotYet { state = s, commands = [], own = Nothing, paste = False }

        Just cell ->
            let
                col =
                    p.x // max 1 p.cellWidth

                row =
                    p.y // max 1 p.cellHeight

                -- the topmost pane first: floating ones top down, then tiled
                order =
                    placedPanes s cell (Array.reverse (Layout.floating cell) ++ Layout.tiled cell)

                inside q =
                    col >= q.x && col < q.x + q.w && row >= q.y && row < q.y + q.h

                onBox q =
                    q.z /= Nothing && col >= q.x - 1 && col <= q.x + q.w && row >= q.y - 1 && row <= q.y + q.h && not (inside q)

                under =
                    Array.findFirst (\q -> inside q || onBox q) order |> Maybe.map .value

                -- a press on the line right of or below a tiled pane, outside
                -- every pane and box: that pane resized (TM20)
                lineHit =
                    if p.action == 0 && p.button == 1 && under == Nothing && s.drag == Nothing then
                        Array.findFirst
                            (\q -> q.z == Nothing && ((q.x + q.w == col && row >= q.y && row < q.y + q.h) || (q.y + q.h == row && col >= q.x && col < q.x + q.w)))
                            order
                            |> Maybe.map
                                (\found ->
                                    let
                                        q =
                                            found.value
                                    in
                                    { pane = q.id
                                    , kind =
                                        if q.x + q.w == col then
                                            2

                                        else
                                            3
                                    , col = col
                                    , row = row
                                    , x = q.x
                                    , y = q.y
                                    , w = q.w
                                    , h = q.h
                                    , sent = { col = col, row = row }
                                    }
                                )

                    else
                        Nothing

                barRow =
                    if statusRows s == 0 then
                        -1

                    else if s.barTop then
                        0

                    else
                        max 0 (p.height // max 1 p.cellHeight) - statusRows s

                tabHit =
                    if row == barRow && p.action == 0 && p.button == 1 && s.drag == Nothing && s.grab == Nothing then
                        Array.findFirst (\h -> col >= h.from && col <= h.to) (tabsOf (p.width // max 1 p.cellWidth) barRow s).hits |> Maybe.map .value

                    else
                        Nothing

                -- the pane a press began in, while a button is held
                target =
                    when s.grab is
                        Just g ->
                            Array.findFirst (\q -> q.id == g) order |> Maybe.map .value

                        Nothing ->
                            meant Reason.NotOpen under

                plain r =
                    { state = r.state, commands = r.commands, own = Nothing, paste = False }

                -- whether the pane under the pointer, or the one that has it,
                -- has a program that takes the mouse
                takesMouse =
                    not how.select && paneTakesMouse target s

                -- a press on a `#[range=control|N]` part of a pane's title,
                -- 3.8's `[f]`, `[z]` and `[x]`: its binding, and the pane
                -- (TM83)
                controlClick =
                    if p.action == 0 && p.button == 1 && s.drag == Nothing then
                        order
                            |> Array.mapAndKeepJust
                                (\q ->
                                    titleControls s q
                                        |> Array.findFirst (\c -> c.row == row && col >= c.from && col <= c.to)
                                        |> Maybe.andThen (\found -> Dict.get ("root MouseDown1Control" ++ String.fromInt found.value.n) s.keys.bindings)
                                        |> Maybe.map (\b -> { pane = q.id, binding = b.command })
                                )
                            |> Array.first

                    else
                        Nothing

                -- the right button on tmux's status line: its window menu over
                -- a window, its session menu over status-left, as tmux's
                -- MouseDown3Status and MouseDown3StatusLeft (TM58)
                statusMenu =
                    if s.lookTmux && row == barRow && p.action == 0 && p.button == 2 && s.menu == Nothing && s.drag == Nothing then
                        let
                            hits =
                                (tabsOf (p.width // max 1 p.cellWidth) barRow s).hits

                            firstCol =
                                Array.first hits |> Maybe.map .from |> Maybe.withDefault (meant Reason.NoMore 0)
                        in
                        when Array.findFirst (\h -> col >= h.from && col <= h.to) hits is
                            Just h ->
                                Dict.get "root MouseDown3Status" s.keys.bindings |> Maybe.map (\b -> Syntax.retarget ("@" ++ String.fromInt h.value.window) b.command)

                            Nothing ->
                                meant Reason.OutOfRange
                                    if col < firstCol then
                                        Dict.get "root MouseDown3StatusLeft" s.keys.bindings |> Maybe.map .command

                                    else
                                        Dict.get "root MouseDown3StatusRight" s.keys.bindings |> Maybe.map .command

                    else
                        Nothing

                -- a press in a mode puritty draws (TM86)
                inMode =
                    if s.drag == Nothing then
                        modeClick p how.ms col row (p.width // max 1 p.cellWidth) (p.height // max 1 p.cellHeight) order s

                    else
                        Nothing
            in
            when { drag = s.drag, tab = tabHit, menu = s.menu, status = statusMenu, mode = inMode } is
                { drag = _, tab = _, menu = Just m, status = _, mode = _ } ->
                    plain (menuPointer p col row m s)

                { drag = Nothing, tab = _, menu = Nothing, status = _, mode = Just click } ->
                    plain (modeClicked click how.ms col row s)

                { drag = Just d, tab = _, menu = Nothing, status = _, mode = _ } ->
                    plain (dragged col row (p.action == 1) d s)

                { drag = Nothing, tab = Nothing, menu = Nothing, status = Just binding, mode = Nothing } ->
                    plain (runHeld { pane = s.active, mouse = Just { col = col, row = row } } "" "" binding s)

                { drag = Nothing, tab = Just hit, menu = Nothing, status = _, mode = Nothing } ->
                    -- a tab selects its window; `+` makes one
                    plain
                        (sent
                            [ if hit.window < 0 then
                                Command.newWindow

                              else
                                Command.selectWindow ("@" ++ String.fromInt hit.window)
                            ]
                            s
                        )

                _ ->
                    when controlClick is
                        Just c ->
                            -- a button in a pane's title, tmux's
                            -- MouseDown1ControlN with the pane under the
                            -- mouse (TM83)
                            plain (runLine { pane = c.pane, mouse = Just { col = col, row = row } } c.binding s)

                        Nothing ->
                            meant Reason.OutOfRange
                                when lineHit is
                                    Just d ->
                                        plain { state = { s | drag = Just d }, commands = [] }

                                    Nothing ->
                                        meant Reason.OutOfRange
                                            when target is
                                                Nothing ->
                                                    meant Reason.OutOfRange { state = s, commands = [], own = Nothing, paste = False }

                                                Just q ->
                                                    if p.action == 0 && p.button == 1 && onBox q then
                                                        -- the top edge moves the box; the others resize it
                                                        let
                                                            select =
                                                                selected q.id s
                                                        in
                                                        plain (sent select { s | drag = Just { pane = q.id, kind = boxEdge q col row, col = col, row = row, x = q.x, y = q.y, w = q.w, h = q.h, sent = { col = col, row = row } } })

                                                    else if inCopy q.id s && not how.select then
                                                        -- a pane in copy mode: what is sent to it goes
                                                        -- through copy mode's keys, so no mouse report
                                                        -- does, and the wheel is copy mode's own scroll,
                                                        -- as tmux binds it (review TB1, TM107)
                                                        if p.action == 0 && (p.button == 4 || p.button == 5) then
                                                            let
                                                                r =
                                                                    sent (selected q.id s ++ [ Command.copyScroll q.id (p.button == 4) ]) s

                                                                asked =
                                                                    askCopy q.id { state = r.state, outside = [], commands = [], trace = [], run = Nothing }
                                                            in
                                                            plain { state = asked.state, commands = r.commands ++ asked.commands }

                                                        else
                                                            selecting how p col row q s

                                                    else if takesMouse then
                                                        let
                                                            select =
                                                                if p.action == 0 then
                                                                    selected q.id s

                                                                else
                                                                    []

                                                            grabbed =
                                                                if p.action == 0 then
                                                                    { s | grab = Just q.id }

                                                                else if how.held == 0 then
                                                                    { s | grab = Nothing }

                                                                else
                                                                    s

                                                            reported =
                                                                report how.held p q grabbed
                                                        in
                                                        plain { state = waitingFor select reported.state, commands = select ++ reported.commands }

                                                    else
                                                        selecting how p col row q s


{-| What a press in a mode puritty draws (the tree, choose-buffer's and
choose-client's lists, customize-mode) does, as `mode_tree_key` takes the
mouse (TM86): a row pressed, and whether it is the second press of a
double click; the wheel, up or down; in the tree's preview, a window or a
pane pressed, or its `<` or `>`; or nothing, a press the mode keeps. -}
type ModeClick
    = OnRow { row : Int, double : Bool, right : Bool }
    | OnWheel Bool
    | OnPreview String
    | OnPreviewMark String
    | OnMenu { outside : Bool }
    | ClickKept


{-| A press in the mode open, `Nothing` when none is open, the press is
outside it, or something over it (a prompt, a menu, printed lines, the
panes' numbers) has the mouse. The left button and the wheel from 2.7;
the right button selects a row from 3.0, which opens the mode's menu
there (`mode_tree_display_menu`). -}
modeClick : Window.PointerEvent -> Int -> Int -> Int -> Int -> Int -> Array Layout.Pane -> State -> Maybe ModeClick
modeClick p ms col row cols rows places s =
    let
        open =
            when { tree = s.tree, listing = s.listing, customizing = s.customizing } is
                { tree = Just t, listing = _, customizing = _ } ->
                    Just { zoom = t.zoom, pane = t.pane }

                { tree = Nothing, listing = Just l, customizing = _ } ->
                    Just { zoom = l.zoom, pane = l.pane }

                { tree = Nothing, listing = Nothing, customizing = Just c } ->
                    Just { zoom = c.zoom, pane = c.pane }

                _ ->
                    Nothing

        rightTaken =
            s.version == 0 || s.version >= 30

        press =
            p.action == 0 && (p.button == 1 || p.button == 4 || p.button == 5 || (p.button == 2 && rightTaken))

        -- cells and areas held to a window's (16384, as `modePlace`), so
        -- that the sums below stay inside `Int`
        cell n =
            clamp 0 16384 n

        bounded a =
            { x = cell a.x, y = cell a.y, w = clamp 0 16384 a.w, h = clamp 0 16384 a.h }

        within a0 =
            let
                a =
                    bounded a0
            in
            cell col >= a.x && cell col < a.x + a.w && cell row >= a.y && cell row < a.y + a.h

        -- the second press on the same row within half a second
        double i =
            p.button == 1 && s.clicks.count > 0 && s.clicks.pane == -2 && Clock.since s.clicks.at ms <= 500 && s.clicks.point.row == i

        offList button =
            if button == 2 then
                OnMenu { outside = True }

            else
                ClickKept

        onList a0 top0 shown0 count =
            let
                a =
                    bounded a0

                shown =
                    clamp 0 16384 shown0

                top =
                    clamp 0 (max 0 count) top0
            in
            if cell col >= a.x && cell col < a.x + a.w && cell row >= a.y && cell row < a.y + shown then
                let
                    i =
                        top + (cell row - a.y)
                in
                if i < count then
                    Just (OnRow { row = i, double = double i, right = p.button == 2 })

                else if p.button == 2 then
                    -- below the last row: the menu of the row chosen
                    Just (OnMenu { outside = False })

                else
                    Just ClickKept

            else
                Nothing
    in
    if not press || s.asking /= Nothing || s.view /= Nothing || s.numbers /= Nothing || s.menu /= Nothing then
        Nothing

    else
        when Maybe.andThen (modePlace s cols rows places) open is
            Nothing ->
                meant Reason.NotOpen Nothing

            Just place ->
                if not (within place) then
                    Nothing

                else if p.button == 4 || p.button == 5 then
                    Just (OnWheel (p.button == 4))

                else
                    when { tree = s.tree, listing = s.listing, customizing = s.customizing } is
                        { tree = Just t, listing = _, customizing = _ } ->
                            let
                                f =
                                    treeFrame s.lookTmux place t

                                a =
                                    f.previewArea

                                -- a press in the preview, the left button only
                                -- (`window_tree_mouse`); not over 3.8's
                                -- information
                                inPreview =
                                    if p.button == 1 && f.withPreview && a.h > 0 && not t.info && within a then
                                        let
                                            placed =
                                                previewRects s.lookTmux a t.preview
                                        in
                                        if placed.left && col < a.x + 3 then
                                            OnPreviewMark "<"

                                        else if placed.right && col >= a.x + a.w - 3 then
                                            OnPreviewMark ">"

                                        else
                                            when Array.findFirst (\r -> col >= r.x && col < r.x + r.w && row >= r.y && row < r.y + r.h) placed.rects is
                                                Just found ->
                                                    OnPreview found.value.item.id

                                                Nothing ->
                                                    meant Reason.OutOfRange ClickKept

                                    else if p.button == 2 then
                                        OnMenu { outside = True }

                                    else
                                        ClickKept
                            in
                            -- off the list: the preview, or nothing
                            Just (Maybe.withDefault (meant Reason.OutOfRange inPreview) (onList f.list f.top f.shown (Array.length (treeRows t))))

                        { tree = Nothing, listing = Just l, customizing = _ } ->
                            let
                                count =
                                    Array.length (listRows l)

                                height =
                                    clamp 0 16384 (modeListHeight l.previewMode place.h count)

                                top =
                                    if l.selected < height then
                                        0

                                    else
                                        l.selected - height + 1
                            in
                            -- off the list: the preview, which keeps a press and
                            -- opens the outside menu for the right button
                            Just (Maybe.withDefault (meant Reason.OutOfRange (offList p.button)) (onList place top height count))

                        { tree = Nothing, listing = Nothing, customizing = Just c } ->
                            let
                                a =
                                    if s.lookTmux then
                                        { x = place.x, y = place.y, w = place.w, h = place.h }

                                    else
                                        { x = place.x + 2, y = place.y + 1, w = max 0 (place.w - 4), h = max 0 (place.h - 2) }

                                count =
                                    Array.length (customizeShown c).shown

                                height =
                                    customizeListHeight c.view.preview a.h

                                top =
                                    clamp 0 (max 0 (count - height)) c.view.offset
                            in
                            -- off the list: the detail below it, as the preview
                            Just (Maybe.withDefault (meant Reason.OutOfRange (offList p.button)) (onList a top height count))

                        _ ->
                            Nothing


{-| A press in a mode done (TM86): a row chosen, and on a double click
Enter as well, as `mode_tree_key` makes `KEYC_DOUBLECLICK1_PANE` `\r`; the
wheel a row up or down; a window or a pane in the tree's preview made the
row and chosen, as `window_tree_mouse` does; `<` and `>` as their keys. -}
modeClicked : ModeClick -> Int -> Int -> Int -> (taken s : State) -> { state : State, commands : Array String }
modeClicked click ms col row s =
    when click is
        OnMenu on ->
            modeMenuOpen on.outside col row { state = s, commands = [] }

        ClickKept ->
            { state = s, commands = [] }

        OnWheel up ->
            modeKeyed
                (symKey
                    (if up then
                        0xFF52

                     else
                        0xFF54
                    )
                )
                s

        OnPreviewMark mark ->
            modeKeyed (textKey mark) s

        OnRow on ->
            let
                i =
                    on.row

                double =
                    on.double

                clicks =
                    if double then
                        { at = -1000, count = 0, pane = -1, point = { row = 0, col = 0 } }

                    else
                        { at = ms, count = 1, pane = -2, point = { row = i, col = 0 } }

                chosen =
                    modeRowChosen i { s | clicks = clicks }
            in
            if on.right then
                modeMenuOpen False col row chosen

            else if double then
                modeKeyedAfter (symKey 0xFF0D) chosen

            else
                chosen

        OnPreview id ->
            when s.tree is
                Just t ->
                    let
                        windowOf =
                            Array.findFirst (\w -> "@" ++ String.fromInt w.id == id) t.windows |> Maybe.map .value

                        paneOf =
                            Array.findFirst (\q -> "%" ++ String.fromInt q.id == id) t.panes |> Maybe.map .value

                        -- the window the item is or is in, and its session
                        window =
                            when paneOf is
                                Just q ->
                                    Array.findFirst (\w -> w.id == q.window) t.windows |> Maybe.map .value

                                Nothing ->
                                    meant Reason.NotKnown windowOf

                        opened =
                            when window is
                                Just w ->
                                    { t
                                        | open = Dict.set w.session True t.open
                                        , openWindows =
                                            if paneOf /= Nothing then
                                                Dict.set w.id True t.openWindows

                                            else
                                                t.openWindows
                                    }

                                Nothing ->
                                    meant Reason.Gone t
                    in
                    when Array.findFirst (\r -> rowTarget r == id) (treeRows opened) is
                        Just found ->
                            modeKeyed (symKey 0xFF0D) { s | tree = Just { opened | selected = found.index } }

                        Nothing ->
                            meant Reason.Gone { state = s, commands = [] }

                Nothing ->
                    meant Reason.NotOpen { state = s, commands = [] }


{-| The mode's menu opened at the pointer after what `r` did (TM87), as
`mode_tree_display_menu`: on a row, the mode's own items under the row's
name; outside the list, Scroll Left, Scroll Right and Cancel; centred on
the pointer's column, its top on the pointer's row. -}
modeMenuOpen : Bool -> Int -> Int -> (taken r : { state : State, commands : Array String }) -> { state : State, commands : Array String }
modeMenuOpen outside col row r =
    let
        s =
            r.state

        found =
            when { tree = s.tree, listing = s.listing, customizing = s.customizing } is
                { tree = Just t, listing = _, customizing = _ } ->
                    Just { kind = "tree", pane = t.pane, name = Array.get t.selected (treeRows t) |> Maybe.map .name |> Maybe.withDefault (meant Reason.OutOfRange "") }

                { tree = Nothing, listing = Just l, customizing = _ } ->
                    Just { kind = l.kind, pane = l.pane, name = Array.get l.selected (listRows l) |> Maybe.map .name |> Maybe.withDefault (meant Reason.OutOfRange "") }

                { tree = Nothing, listing = Nothing, customizing = Just c } ->
                    Just { kind = "customize", pane = c.pane, name = Array.get c.at (customizeShown c).shown |> Maybe.map (\l -> l.entry.name) |> Maybe.withDefault (meant Reason.OutOfRange "") }

                _ ->
                    Nothing
    in
    when found is
        Just f ->
            let
                menu0 =
                    { serial = s.serial + 1
                    , title =
                        if outside then
                            ""

                        else
                            f.name
                    , items = modeMenuItems outside f.kind s.version
                    , pending = 0
                    , selected = -1
                    , pane = f.pane
                    , mouse = Just { col = col, row = row }
                    , x = "M"
                    , y = String.fromInt row
                    , armed = False
                    , stayOpen = False
                    , start = Nothing
                    , forMode = True
                    , completes = False
                    }

                -- centred on the pointer: half its width to the left
                width =
                    (menuPlace s.canvas.cols s.canvas.rows s menu0).w
            in
            { state = { s | serial = s.serial + 1, menu = Just { menu0 | x = String.fromInt (max 0 (col - width // 2)) } }, commands = r.commands }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = r.commands }


{-| A mode's menu items as each tmux has them (`mode_tree_menu_items`,
`window_tree_menu_items` and the others): the command is the key the mode
is given, and the key shown. 3.0 and 3.1's tree sends `E` and `R` for Select and Expand,
which its mode takes for nothing; 3.2 Enter and Right, and adds Mark;
3.8's customize-mode adds Edit and Changed Only. -}
modeMenuItems : Bool -> String -> Int -> Array Syntax.MenuItem
modeMenuItems outside kind version =
    let
        item name key =
            { name = name, key = key, command = key }

        line =
            { name = "", key = "", command = "" }

        -- Ctrl-T, which tmux shows as `C-t` before 3.5 and by its C0
        -- name, `[DC4]`, from 3.5 (`key_string_lookup_key`)
        tagAll =
            { name = "Tag All"
            , key =
                if version == 0 || version >= 35 then
                    "[DC4]"

                else
                    "C-t"
            , command = "C-t"
            }

        tags =
            [ item "Tag" "t", tagAll, item "Tag None" "T" ]

        newer =
            version == 0 || version >= 32
    in
    if outside then
        [ item "Scroll Left" "<", item "Scroll Right" ">", line, item "Cancel" "q" ]

    else if kind == "tree" then
        (if newer then
            [ item "Select" "Enter", item "Expand" "Right", item "Mark" "m" ]

         else
            [ item "Select" "E", item "Expand" "R" ]
        )
            ++ [ line ]
            ++ tags
            ++ [ line, item "Kill" "x", item "Kill Tagged" "X", line, item "Cancel" "q" ]

    else if kind == "buffer" then
        [ item "Paste" "p", item "Paste Tagged" "P", line ] ++ tags ++ [ line, item "Delete" "d", item "Delete Tagged" "D", line, item "Cancel" "q" ]

    else if kind == "client" then
        [ item "Detach" "d", item "Detach Tagged" "D", line ] ++ tags ++ [ line, item "Cancel" "q" ]

    else if version == 0 || version >= 38 then
        [ item "Select" "Enter", item "Edit" "e", item "Expand" "Right", line ] ++ tags ++ [ line, item "Changed Only" "C", line, item "Cancel" "q" ]

    else
        [ item "Select" "Enter", item "Expand" "Right", line ] ++ tags ++ [ line, item "Cancel" "q" ]


{-| The key a mode's menu item names, as the window would give it. -}
keyNamed : String -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes }
keyNamed name =
    when name is
        "Enter" ->
            symKey 0xFF0D

        "Right" ->
            symKey 0xFF53

        "Left" ->
            symKey 0xFF51

        "Up" ->
            symKey 0xFF52

        "Down" ->
            symKey 0xFF54

        "Home" ->
            symKey 0xFF50

        "End" ->
            symKey 0xFF57

        "BSpace" ->
            symKey 0xFF08

        "DC" ->
            symKey 0xFFFF

        "M-b" ->
            { action = 0, keycode = 0, mods = 4, consumed = 0, unshifted = 0x62, sym = 0x62, text = Bytes.fromString "b" }

        _ ->
            if String.startsWith "C-" name && String.count name == 3 then
                -- a Ctrl letter, its control character the text
                let
                    letter =
                        String.dropFirst 2 name

                    code =
                        String.toArray letter |> Array.first |> Maybe.map Char.toCode |> Maybe.withDefault (meant Reason.NotKnown 0x61) |> clamp 0x61 0x7A
                in
                { action = 0, keycode = 0, mods = 2, consumed = 0, unshifted = code, sym = code, text = Bytes.fromString (String.fromChar (Char.fromCodeProven (code - 0x60))) }

            else
                textKey name


{-| The mode's row `i` made the chosen one, its preview or detail asked
again, as the keys that move it do. -}
modeRowChosen : Int -> (taken s : State) -> { state : State, commands : Array String }
modeRowChosen i s =
    when { tree = s.tree, listing = s.listing, customizing = s.customizing } is
        { tree = Just t, listing = _, customizing = _ } ->
            previewAfter { state = { s | tree = Just { t | selected = clamp 0 (max 0 (Array.length (treeRows t) - 1)) i } }, commands = [] }

        { tree = Nothing, listing = Just l, customizing = _ } ->
            listPreviewAfter { state = { s | listing = Just { l | selected = clamp 0 (max 0 (Array.length (listRows l) - 1)) i } }, commands = [] }

        { tree = Nothing, listing = Nothing, customizing = Just c } ->
            customizeDetailAsk { s | customizing = Just (customizeAt (customizeHeight s c) i c.view.offset c) }

        _ ->
            { state = s, commands = [] }


{-| A key given to the mode open, as typed (`keyed`'s modes). -}
modeKeyed : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken s : State) -> { state : State, commands : Array String }
modeKeyed k s =
    when { tree = s.tree, listing = s.listing, customizing = s.customizing } is
        { tree = Just t, listing = _, customizing = _ } ->
            previewAfter (treeKey k t s)

        { tree = Nothing, listing = Just l, customizing = _ } ->
            listPreviewAfter (listKey k l s)

        { tree = Nothing, listing = Nothing, customizing = Just c } ->
            customizeKey k c s

        _ ->
            { state = s, commands = [] }


{-| A key given to the mode after what `r` did, its commands first. -}
modeKeyedAfter : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken r : { state : State, commands : Array String }) -> { state : State, commands : Array String }
modeKeyedAfter k r =
    let
        next =
            modeKeyed k r.state
    in
    { state = next.state, commands = r.commands ++ next.commands }


{-| A named key as the window gives it, by its X keysym, made for a mode
from the mouse. -}
symKey : Int -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes }
symKey sym =
    { action = 0, keycode = 0, mods = 0, consumed = 0, unshifted = 0, sym = sym, text = Bytes.empty }


{-| A typed character as the window gives it, made for a mode from the
mouse. -}
textKey : String -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes }
textKey text =
    { action = 0, keycode = 0, mods = 0, consumed = 0, unshifted = 0, sym = 0, text = Bytes.fromString text }


{-| Which edge of a floating pane's box a cell on it is, as a drag's
`kind`: the top edge, its corners too, moves the box (0); the bottom right
corner (1), the right edge (4), the bottom (5), the left (6) and the
bottom left corner (7) resize it from there. -}
boxEdge : Layout.Pane -> Int -> Int -> Int
boxEdge q col row =
    let
        bottom =
            row == q.y + q.h

        left =
            col == q.x - 1

        right =
            col == q.x + q.w
    in
    if row == q.y - 1 then
        0

    else if bottom && right then
        1

    else if bottom && left then
        7

    else if bottom then
        5

    else if right then
        4

    else
        6


{-| The pointer's shape for a drag's kind: a move, a width (the line right
of a pane, a box's left or right edge), a height, or both. -}
dragShape : Int -> Window.Pointer
dragShape kind =
    when kind is
        0 ->
            Window.MovePointer

        1 ->
            Window.ResizeDownRightPointer

        7 ->
            Window.ResizeDownLeftPointer

        3 ->
            Window.ResizeHeightPointer

        5 ->
            Window.ResizeHeightPointer

        _ ->
            Window.ResizeWidthPointer


{-| The pointer's shape over the window under tmux control mode (TM38), the
pointer at `p`, `Nothing` when it is not on: during a drag, the drag's; over
what a press would drag (a floating pane's box, the line right of or below
a tiled pane), that drag's; the arrow over tmux's tab bar, a menu, the tree
and a pane whose program takes the mouse (unless `select`, Shift held);
the I-beam over the rest of a pane, where a press selects. -}
pointerShape : Bool -> Window.PointerEvent -> State -> Maybe Window.Pointer
pointerShape select p s =
    when s.layout is
        Nothing ->
            meant Reason.NotYet Nothing

        Just cell ->
            let
                col =
                    p.x // max 1 p.cellWidth

                row =
                    p.y // max 1 p.cellHeight

                order =
                    placedPanes s cell (Array.reverse (Layout.floating cell) ++ Layout.tiled cell)

                inside q =
                    col >= q.x && col < q.x + q.w && row >= q.y && row < q.y + q.h

                onBox q =
                    q.z /= Nothing && col >= q.x - 1 && col <= q.x + q.w && row >= q.y - 1 && row <= q.y + q.h && not (inside q)

                barRow =
                    if statusRows s == 0 then
                        -1

                    else if s.barTop then
                        0

                    else
                        max 0 (p.height // max 1 p.cellHeight) - statusRows s

                line =
                    Array.findFirst
                        (\q -> q.z == Nothing && ((q.x + q.w == col && row >= q.y && row < q.y + q.h) || (q.y + q.h == row && col >= q.x && col < q.x + q.w)))
                        order
                        |> Maybe.map
                            (\found ->
                                if found.value.x + found.value.w == col then
                                    2

                                else
                                    3
                            )
            in
            Just
                (when s.drag is
                    Just d ->
                        dragShape d.kind

                    Nothing ->
                        meant Reason.NotOpen
                            if s.menu /= Nothing || s.tree /= Nothing || s.listing /= Nothing || s.customizing /= Nothing || row == barRow then
                                Window.ArrowPointer

                            else
                                when Array.findFirst (\q -> inside q || onBox q) order |> Maybe.map .value is
                                    Just q ->
                                        if onBox q then
                                            dragShape (boxEdge q col row)

                                        else if not select && paneTakesMouse (Just q) s then
                                            Window.ArrowPointer

                                        else
                                            Window.TextPointer

                                    Nothing ->
                                        meant Reason.OutOfRange
                                            when line is
                                                Just kind ->
                                                    dragShape kind

                                                Nothing ->
                                                    meant Reason.OutOfRange Window.TextPointer
                )


paneTakesMouse : Maybe Layout.Pane -> State -> Bool
paneTakesMouse target s =
    when target is
        Just q ->
            withPane q.id s (\t -> (Vt.mouseModes t).tracking /= Mouse.none) == Just True

        Nothing ->
            meant Reason.OutOfRange False


{-| The pointer over a pane whose program does not take the mouse, or with
Shift: selection, paste and the wheel, as puritty does without tmux
(`Main.selecting`, `wheelStep`), in the pane's own terminal. -}
selecting : { ms : Int, held : Int, select : Bool, boundaries : Array Int, pasteButton : Int } -> Window.PointerEvent -> Int -> Int -> Layout.Pane -> (taken s : State) -> { state : State, commands : Array String, own : Maybe String, paste : Bool }
selecting how p col row q s =
    let
        at =
            Maybe.withDefault (meant Reason.Gone { row = 0, col = 0 })
                (withPane q.id s (\t -> { row = Vt.rowsPushed t + clamp 0 (q.h - 1) (row - q.y) - backOf q.id s, col = clamp 0 (q.w - 1) (col - q.x) }))

        none r =
            { state = r, commands = [], own = Nothing, paste = False }

        wheel =
            p.button == 4 || p.button == 5
    in
    if p.action == 0 && p.button == 2 && how.pasteButton /= 2 && not how.select && Dict.get "root MouseDown3Pane" s.keys.bindings /= Nothing then
        -- the right button: tmux's own binding for it, its menu by default,
        -- when tmux has the mouse on (TM27)
        let
            word =
                withPane q.id s (\t -> Vt.wordAt how.boundaries at t |> Maybe.map (\w -> Vt.selectionText w.start w.end t)) |> Maybe.andThen identity |> Maybe.withDefault (meant Reason.OutOfRange "")

            line =
                withPane q.id s (\t -> Vt.lineAt at t |> Maybe.map (\w -> Vt.selectionText w.start w.end t)) |> Maybe.andThen identity |> Maybe.withDefault (meant Reason.OutOfRange "")

            binding =
                Dict.get "root MouseDown3Pane" s.keys.bindings |> Maybe.map .command |> Maybe.withDefault (meant Reason.NotSet "")

            r =
                runHeld { pane = q.id, mouse = Just { col = col, row = row } } word line (Command.ifShellMouse (paneName q.id) "#{mouse}" binding) s
        in
        { state = r.state, commands = r.commands, own = Nothing, paste = False }

    else if p.action == 0 && p.button == how.pasteButton then
        { state = s, commands = [], own = Nothing, paste = True }

    else if p.action == 0 && wheel then
        let
            up =
                p.button == 4

            -- on the alternate screen, three arrow keys, as without tmux
            arrows =
                withPane q.id
                    s
                    (\t ->
                        if t.alt && Dict.get 1007 t.modes /= Just False then
                            let
                                arrow =
                                    (if Dict.get 1 t.modes == Just True then
                                        "\u{001B}O"

                                     else
                                        "\u{001B}["
                                    )
                                        ++ (if up then
                                                "A"

                                            else
                                                "B"
                                           )
                            in
                            Just (arrow ++ arrow ++ arrow)

                        else
                            Nothing
                    )
                    |> Maybe.andThen identity

            most =
                Maybe.withDefault (meant Reason.Gone 0) (withPane q.id s Vt.scrollbackRows)
        in
        when arrows is
            Just keyed ->
                let
                    r =
                        sent (bytesTo s.caps q.id (Bytes.fromString keyed)) s
                in
                { state = r.state, commands = r.commands, own = Nothing, paste = False }

            Nothing ->
                meant Reason.NotOpen
                    let
                        now =
                            backOf q.id s

                        next =
                            if up then
                                min most (now + 3)

                            else
                                max 0 (now - 3)
                    in
                    none { s | back = Dict.set q.id next s.back }

    else if p.action == 0 && p.button == 1 then
        let
            count =
                if s.clicks.count > 0 && Clock.since s.clicks.at how.ms <= 500 && s.clicks.pane == q.id && s.clicks.point == at then
                    modBy 3 s.clicks.count + 1

                else
                    1

            span =
                withPane q.id
                    s
                    (\t ->
                        if count == 2 then
                            Vt.wordAt how.boundaries at t

                        else if count == 3 then
                            Vt.lineAt at t

                        else
                            Just { start = at, end = at }
                    )
                    |> Maybe.andThen identity

            sel =
                Maybe.map (\w -> { pane = q.id, anchor = w.start, head = w.end, first = w.start, last = w.end, mode = count - 1, moved = count > 1, made = False, text = "", alt = Maybe.withDefault (meant Reason.Gone False) (withPane q.id s .alt), hashes = Dict.empty }) span

            select =
                selected q.id s

            r =
                sent select { s | selection = sel, grab = Just q.id, clicks = { at = how.ms, count = count, pane = q.id, point = at } }
        in
        { state = r.state, commands = r.commands, own = Nothing, paste = False }

    else if p.action == 2 && Bitwise.and how.held 2 /= 0 then
        when s.selection is
            Just sel ->
                if sel.made || sel.pane /= q.id then
                    none s

                else
                    none { s | selection = Just (extended how.boundaries at sel s) }

            Nothing ->
                meant Reason.NotOpen none s

    else if p.action == 1 && p.button == 1 then
        when s.selection is
            Just sel ->
                if sel.made then
                    none { s | grab = Nothing }

                else if sel.mode == 0 && not sel.moved then
                    -- a click: no selection
                    none { s | grab = Nothing, selection = Nothing }

                else
                    let
                        text =
                            Maybe.withDefault (meant Reason.Gone "") (withPane sel.pane s (Vt.selectionText sel.anchor sel.head))
                    in
                    { state = { s | grab = Nothing, selection = Just { sel | made = True, text = text, hashes = Maybe.withDefault (meant Reason.Gone Dict.empty) (withPane sel.pane s (selRowHashes sel)) } }, commands = [], own = Just text, paste = False }

            Nothing ->
                meant Reason.NotOpen none { s | grab = Nothing }

    else
        none
            (if how.held == 0 then
                { s | grab = Nothing }

             else
                s
            )


{-| A selection being dragged, its head at `at`: by cells, at it; by words
or lines, the word or line there, the first one kept on the far side. -}
extended : Array Int -> Vt.Point -> Sel -> State -> Sel
extended boundaries at sel s =
    if sel.mode == 0 then
        { sel | head = at, moved = True }

    else
        let
            w =
                withPane sel.pane
                    s
                    (\t ->
                        if sel.mode == 1 then
                            Vt.wordAt boundaries at t

                        else
                            Vt.lineAt at t
                    )
                    |> Maybe.andThen identity
                    |> Maybe.withDefault (meant Reason.Gone { start = at, end = at })
        in
        if before w.start sel.first then
            { sel | anchor = sel.last, head = w.start }

        else
            { sel | anchor = sel.first, head = w.end }


{-| The tab bar's text and where its tabs are: in puritty's look a tab
for each window, ` 1:name `, between `│`s, the active one inverse, then
` + `, cut at the window's width, and which columns each tab and the `+`
cover, `-1` for the `+`; in tmux's look no text, which `tmuxBar` draws,
and its hits alone. -}
tabsOf : Int -> Int -> State -> { text : String, active : Array { row : Int, col : Int, text : String }, alerted : Array { row : Int, col : Int, text : String }, busy : Array { row : Int, col : Int, text : String }, hits : Array { from : Int, to : Int, window : Int } }
tabsOf cols row s =
    if s.lookTmux then
        { text = "", active = [], alerted = [], busy = [], hits = (tmuxBar cols row s).hits }

    else
        puritySTabs cols row s


puritySTabs : Int -> Int -> State -> { text : String, active : Array { row : Int, col : Int, text : String }, alerted : Array { row : Int, col : Int, text : String }, busy : Array { row : Int, col : Int, text : String }, hits : Array { from : Int, to : Int, window : Int } }
puritySTabs cols row s =
    let
        -- tmux's alerts and marks on a tab (TM30): `!` a bell, `#`
        -- activity, `~` silence, `M` the marked pane, `Z` zoomed
        marksOf t =
            Dict.get t.id s.status.windows
                |> Maybe.map (\w -> String.toArray w.flags |> Array.keepIf (\c -> c == '!' || c == '#' || c == '~' || c == 'M' || c == 'Z') |> String.fromArray)
                |> Maybe.withDefault (meant Reason.NotYet "")

        labels =
            Array.map
                (\t ->
                    { window = t.id
                    , marks = marksOf t
                    , text =
                        " "
                            ++ String.fromInt t.index
                            ++ ":"
                            ++ t.name
                            ++ (if marksOf t == "" then
                                    ""

                                else
                                    " " ++ marksOf t
                               )
                            ++ " "
                    }
                )
                s.tabs
                ++ [ { window = -1, marks = "", text = " + " } ]

        laid =
            Array.foldl
                (\l acc ->
                    let
                        width =
                            String.count l.text
                    in
                    { at = acc.at + width + 1
                    , text = acc.text ++ l.text ++ "│"
                    , hits = Array.pushLast { from = acc.at, to = acc.at + width - 1, window = l.window } acc.hits
                    , alerts =
                        if String.contains "!" l.marks then
                            Array.pushLast { from = acc.at, to = acc.at + width - 1, window = l.window } acc.alerts

                        else
                            acc.alerts
                    , busy =
                        if String.contains "#" l.marks || String.contains "~" l.marks then
                            Array.pushLast { from = acc.at, to = acc.at + width - 1, window = l.window } acc.busy

                        else
                            acc.busy
                    }
                )
                { at = 0, text = "", hits = [], alerts = [], busy = [] }
                labels

        place hits =
            hits
                |> Array.keepIf (\h -> h.window /= s.window && h.from < cols)
                |> Array.map (\h -> { row = row, col = h.from, text = String.slice h.from (min cols (h.to + 1)) laid.text })
    in
    { text = String.takeFirst cols laid.text
    , active =
        laid.hits
            |> Array.keepIf (\h -> h.window == s.window && h.window >= 0 && h.from < cols)
            |> Array.map (\h -> { row = row, col = h.from, text = String.slice h.from (min cols (h.to + 1)) laid.text })
    , alerted = place laid.alerts
    , busy = place laid.busy
    , hits = laid.hits
    }


-- THE PANES' BORDERS (TM30)


{-| What is drawn on the panes' borders (TM30): the lines' color, then
over the tiled panes' lines, in tmux's look, the active pane's frame in
its `pane-active-border-style`, the marked pane's frame, and each pane's
`pane-border-format` where `pane-border-status` puts it (`top`: the row
above the pane, which tmux leaves for it; `bottom`: the row below), from
two cells in, as tmux draws it (`screen_redraw_make_pane_status`), the
part after `#[align=right]` at the right; the floating panes' titles, over
their boxes, apart. -}
paneBorders : Bool -> Int -> Int -> Int -> Array Layout.Pane -> Array Layout.Pane -> Array Layout.Pane -> StatusLine -> { lineColor : String, tiled : Array { row : Int, col : Int, color : String, text : String }, floating : Array { row : Int, col : Int, color : String, text : String } }
paneBorders tmuxLook cols rows active cells tiled floating status =
    let
        base =
            Style.apply status.borderStyle Style.plain

        own p =
            Maybe.withDefault (meant Reason.NotYet { title = "", border = "", marked = False, style = "", paneStatus = "" }) (Dict.get p.id status.panes)

        frameColor p =
            if (own p).marked then
                if tmuxLook then
                    Style.sgr (Style.apply "fg=magenta" base)

                else
                    markedColor

            else if tmuxLook && p.id == active then
                Style.sgr (Style.apply (own p).border base)

            else
                ""

        frames =
            Array.mapAndFlatten
                (\p ->
                    let
                        color =
                            frameColor p
                    in
                    if color == "" || p.z /= Nothing then
                        []

                    else
                        Array.map (\piece -> { row = piece.row, col = piece.col, color = color, text = piece.text }) (frameOf cols rows p)
                )
                tiled

        -- a pane's own pane-border-status where it has one, as tmux
        -- takes the pane's option over the window's (TM82)
        statusOf p =
            if (own p).paneStatus == "" then
                tiledBorderStatus status (Array.map .id tiled)

            else
                (own p).paneStatus

        titleOf p =
            if statusOf p /= "top" && statusOf p /= "bottom" then
                []

            else
                let
                    row =
                        if statusOf p == "top" then
                            p.y - 1

                        else
                            p.y + p.h

                    style =
                        if tmuxLook then
                            Style.apply (own p).border base

                        else
                            Style.apply
                                (if p.id == active then
                                    "fg=color214"

                                 else
                                    "fg=color245"
                                )
                                Style.plain

                    parts =
                        String.split "#[align=right]" (own p).title

                    -- two cells in, to the pane's right edge, as
                    -- screen_redraw_make_pane_status's `sx - 2` (TM59)
                    room =
                        max 0 (p.w - 2)

                    leftRuns =
                        takeRuns room (Style.runs style (Array.getProven 0 parts))

                    rightRuns =
                        Style.runs style (String.join "" (Array.dropFirst 1 parts))

                    used =
                        Array.foldl (\r n -> n + String.count r.text) 0 leftRuns

                    rightWidth =
                        Array.foldl (\r n -> n + String.count r.text) 0 rightRuns

                    lineIn =
                        if frameColor p /= "" then
                            frameColor p

                        else if tmuxLook then
                            Style.sgr base

                        else
                            lineColor
                in
                if row < 0 || row >= rows || (own p).title == "" then
                    []

                else
                    -- the border's line along the row, the title over it,
                    -- as tmux draws it; in tmux's look the line is the
                    -- border's own cells (TM48)
                    (if tmuxLook then
                        []

                     else
                        [ { row = row, col = p.x, color = lineIn, text = String.repeat (max 0 (min p.w (cols - p.x))) "─" } ]
                    )
                        ++ (laidRuns row (p.x + 2) leftRuns).pieces
                        ++ (if used + 1 + rightWidth <= room then
                                (laidRuns row (p.x + 2 + room - rightWidth) rightRuns).pieces

                            else
                                []
                           )
    in
    { lineColor =
        if tmuxLook then
            Style.sgr base

        else
            lineColor
    , tiled =
        if tmuxLook then
            Borders.cells
                -- tmux's window: the layout's size, not puritty's canvas
                { cols = Array.foldl (\p m -> max m (p.x + p.w)) 0 cells
                , rows = Array.foldl (\p m -> max m (p.y + p.h)) 0 cells
                , active = active
                , marked = Array.findFirst (\p -> (own p).marked) tiled |> Maybe.map (\f -> f.value.id) |> Maybe.withDefault (meant Reason.NotSet -1)
                , paneStatus =
                    if tiledBorderStatus status (Array.map .id tiled) == "" then
                        "off"

                    else
                        tiledBorderStatus status (Array.map .id tiled)
                , lines = Maybe.withDefault (meant Reason.NotSet "single") (Dict.get "pane-border-lines" status.options)
                , indicators = Maybe.withDefault (meant Reason.NotSet "colour") (Dict.get "pane-border-indicators" status.options)
                , borderStyle = status.borderStyle
                , activeStyle = Array.findFirst (\p -> p.id == active) tiled |> Maybe.map (\f -> (own f.value).border) |> Maybe.withDefault (meant Reason.NotKnown "fg=green")
                }
                (Array.keepIf (\p -> p.z == Nothing) cells)
                ++ Array.mapAndFlatten titleOf tiled

        else
            frames ++ Array.mapAndFlatten titleOf tiled
    , floating = Array.mapAndFlatten titleOf floating
    }


{-| The lines around a tiled pane that are its border: beside and above
and below it, inside the window. -}
frameOf : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
frameOf cols rows p =
    let
        sides =
            Array.range p.y (min rows (p.y + p.h) - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        (if p.x > 0 then
                            [ { row = r, col = p.x - 1, text = "│" } ]

                         else
                            []
                        )
                            ++ (if p.x + p.w < cols then
                                    [ { row = r, col = p.x + p.w, text = "│" } ]

                                else
                                    []
                               )
                    )

        across r =
            if r >= 0 && r < rows then
                [ { row = r, col = p.x, text = String.repeat (max 0 (min p.w (cols - p.x))) "─" } ]

            else
                []
    in
    sides
        ++ (if p.y > 0 then
                across (p.y - 1)

            else
                []
           )
        ++ across (p.y + p.h)


-- WHAT THIS TMUX TAKES (TM72)


{-| The client's size as this tmux takes it: `80x24` from 3.0, `80,24`
before. -}
sizeCommand : Caps -> { cols : Int, rows : Int } -> String
sizeCommand caps size =
    if Caps.sizeByX caps then
        Command.size size

    else
        Command.sizeComma size


{-| Bytes to a pane as this tmux takes them: `send-keys -H` from 3.0, text
and key names before. -}
bytesTo : Caps -> Int -> Bytes -> Array String
bytesTo caps pane bytes =
    if Caps.has "send-keys" "H" caps then
        Command.sendBytes pane bytes

    else
        Command.sendBytesPlain pane bytes


-- THE STATUS LINE (TM29)


{-| What puritty subscribes to (`refresh-client -B`, tmux 3.2 on): tmux
sends each when it changes, at most once a second; the formats that hold
the time (the status line's, the windows' and the panes' titles) are
asked with `T:`, so that it is expanded. -}
statusSubscriptions : Array String
statusSubscriptions =
    [ "puritty-left::#{T:status-left}"
    , "puritty-right::#{T:status-right}"
    , "puritty-style::#{status-style}"
    , "puritty-sep::#{window-status-separator}"
    , "puritty-lengths::#{status-left-length} #{status-right-length}"
    , "puritty-wtext:@*:#{?#{window_active},#{T:window-status-current-format},#{T:window-status-format}}"
    , "puritty-wstyle:@*:#{?#{window_active},#{window-status-current-style},#{window-status-style}} #{?#{window_bell_flag},#{window-status-bell-style},} #{?#{window_activity_flag},#{window-status-activity-style},}"
    , "puritty-wflags:@*:#{window_flags}"
    , "puritty-borders::#{pane-border-status} #{pane-border-style}"
    , "puritty-ptitle:%*:#{T:pane-border-format}"
    , "puritty-pborder:%*:#{?#{pane_active},#{E:pane-active-border-style},#{E:pane-border-style}}"
    , "puritty-pmarked:%*:#{pane_marked}"
    -- a pane's own pane-border-status, which a popup's title sets (TM82)
    , "puritty-pstatus:%*:#{pane-border-status}"
    , "puritty-pwstyle:%*:#{window-style}\t#{window-active-style}"
    , "puritty-opts::" ++ String.join "\t" (Array.map (\o -> "#{" ++ o ++ "}") optionNames)
    , "puritty-status1::#{T:status-format[1]}"
    , "puritty-status2::#{T:status-format[2]}"
    , "puritty-status3::#{T:status-format[3]}"
    , "puritty-status4::#{T:status-format[4]}"
    , "puritty-theme::" ++ String.join "\t" ([ "#{theme}" ] ++ Array.map (\n -> "#{dark-theme-" ++ n ++ "}") Style.themeNames ++ Array.map (\n -> "#{light-theme-" ++ n ++ "}") Style.themeNames)
    ]


{-| The status line asked rather than told, before tmux 3.2 (TM72): each
subscription's format, for the session by `display-message`, for each
window or pane by `list-windows` or `list-panes`, its id first. Before 2.9
tmux has no `#{T:…}`: the options it names are asked first, and their text
put in its place (`ForRawOptions`), which `display-message` expands, the
time too. -}
pollsFor : State -> Array { command : String, expect : Expect }
pollsFor s =
    Array.map
        (\sub ->
            let
                parts =
                    String.split ":" sub

                name =
                    Array.getProven 0 parts

                target =
                    Maybe.withDefault (meant Reason.FromOutside "") (Array.get 1 parts)

                format =
                    String.join ":" (Array.dropFirst 2 parts)

                options =
                    timeOptions format
            in
            if s.timeFormats || Array.isEmpty options then
                pollOf name target format

            else
                { command = Command.display (String.join "\t" (Array.map (\o -> "#{" ++ o ++ "}") options))
                , expect = ForRawOptions { name = name, target = target, format = format, options = options }
                }
        )
        statusSubscriptions


pollOf : String -> String -> String -> { command : String, expect : Expect }
pollOf name target format =
    if target == "@*" then
        { command = Command.listWindows ("#{window_id}\t" ++ format), expect = ForPoll { name = name, scope = 1 } }

    else if target == "%*" then
        { command = Command.listPanesSession ("#{window_id}\t#{pane_id}\t" ++ format), expect = ForPoll { name = name, scope = 2 } }

    else
        { command = Command.display format, expect = ForPoll { name = name, scope = 0 } }


{-| The options a format names by `#{T:option}`, in order. -}
timeOptions : String -> Array String
timeOptions format =
    String.split "#{T:" format
        |> Array.dropFirst 1
        |> Array.mapAndKeepJust (\rest -> String.split "}" rest |> Array.first)


pollMs : Int
pollMs =
    1000


{-| The theme colors in force (TM65): `theme`'s choice, `detect` taken
from puritty's background as tmux takes it from a terminal's
(`colour_totheme`). -}
themeOf : State -> Array String
themeOf s =
    when s.themeChoice is
        "terminal" ->
            Style.terminalTheme

        "light" ->
            s.themes.light

        "dark" ->
            s.themes.dark

        _ ->
            if s.lightBackground then
                s.themes.light

            else
                s.themes.dark


{-| The status line as tmux sent it, kept, and drawn with the theme's
colors (TM65). -}
withStatus : StatusLine -> (taken s : State) -> State
withStatus raw s =
    let
        theme =
            themeOf s
    in
    { s | rawStatus = raw, status = themedStatus theme raw }


themedStatus : Array String -> StatusLine -> StatusLine
themedStatus theme raw =
    let
        t =
            Style.themed theme

        -- expanded text: theme names only inside its #[…] (review TP14)
        tx =
            Style.themedText theme
    in
    { raw
        | left = tx raw.left
        , right = tx raw.right
        , style = t raw.style
        , separator = tx raw.separator
        , windows = Dict.map (\_ w -> { w | text = tx w.text, style = t w.style }) raw.windows
        , borderStyle = t raw.borderStyle
        , panes = Dict.map (\_ q -> { q | title = tx q.title, border = t q.border, style = t q.style }) raw.panes
        , options = Dict.map (\_ v -> t v) raw.options
        , extra = Dict.map (\_ v -> tx v) raw.extra
    }


{-| tmux 3.8's `theme` and its twenty colors' options, as sent (TM65):
the colors are formats, `#{client_colours}` choosing a name by the
client's colors, which a control client has none of; tmux is asked to
expand them as for a client of 24-bit color, as puritty is. 3.6 sends
nothing. -}
themeAsked : String -> (taken acc : Acc) -> Acc
themeAsked value acc =
    let
        fields =
            String.split "\t" value

        first =
            Array.getProven 0 fields

        rest =
            Array.dropFirst 1 fields
    in
    if first == "" || Array.length rest /= 20 then
        acc

    else
        let
            st =
                acc.state

            format =
                Array.map (\v -> String.replace "#{client_colours}" "16777216" v |> String.replace "%" "%%") rest
                    |> String.join "\t"
        in
        ask [ { command = Command.display format, expect = ForTheme } ] { acc | state = withStatus st.rawStatus { st | themeChoice = first } }


{-| The bells tmux's panes have rung, added up (docs/sounds.md SN6). -}
bells : State -> Int
bells s =
    s.audible


{-| Each pane's bells so far, by its id. -}
paneBells : State -> Dict Int Int
paneBells s =
    paneBellsFrom 0 s.ids s.panes Dict.empty


paneBellsFrom : (i : Int where 0 <= i) -> Array Int -> Builder Vt.Term -> Dict Int Int -> Dict Int Int
paneBellsFrom i ids panes acc =
    if i < Builder.length panes then
        paneBellsFrom (i + 1)
            ids
            panes
            (Dict.set (Array.getProven i ids) (0 + (Builder.getProven i panes).bells) acc)

    else
        acc


{-| A bell rung in a pane since `before`, taken as tmux takes one
(`alerts_check_bell`, `alerts_action_applies`, `alerts_set_message`;
the same from 2.7 to 3.8, TM99): nothing with `monitor-bell` off;
`bell-action` any, none, current (the window shown) or other; then by
`visual-bell` the sound (off), a message (on), or both: `Bell in current
window`, or for another `Bell in window N`, its number asked of tmux.
Once a read, as tmux alerts a session once. -}
bellsRung : Dict Int Int -> (taken acc : Acc) -> Acc
bellsRung rangBefore acc =
    let
        after =
            paneBells acc.state

        rung =
            Dict.foldl
                (\id n found ->
                    if n > Maybe.withDefault (meant Reason.NotSet 0) (Dict.get id rangBefore) then
                        Array.pushLast id found

                    else
                        found
                )
                []
                after

        option name default =
            when Dict.get name acc.state.status.options is
                Just "" ->
                    default

                Just v ->
                    v

                Nothing ->
                    meant Reason.NotSet default

        shown =
            when acc.state.layout is
                Just cell ->
                    Layout.panes cell |> Array.map .id

                Nothing ->
                    meant Reason.NotYet []

        action =
            option "bell-action" "any"

        applies id =
            if action == "any" then
                True

            else if action == "current" then
                Array.member id shown

            else if action == "other" then
                not (Array.member id shown)

            else
                False

        monitored =
            not (Array.member (option "monitor-bell" "on") [ "off", "0" ])

        visual =
            option "visual-bell" "off"
    in
    when Array.findFirst applies rung |> Maybe.map .value is
        Just id ->
            if not monitored then
                acc

            else
                let
                    st =
                        acc.state

                    sounded =
                        if visual == "on" || visual == "1" then
                            st

                        else
                            { st | audible = st.audible + 1 }
                in
                if visual == "off" || visual == "0" then
                    { acc | state = sounded }

                else if Array.member id shown then
                    { acc | state = { sounded | said = "Bell in current window" } }

                else
                    ask [ { command = Command.displayAt ("%" ++ String.fromInt id) "#{window_index}", expect = ForBellWindow } ] { acc | state = sounded }

        Nothing ->
            -- no pane rang, or none whose bell counts
            meant Reason.NoMore acc


bellsFrom : (i : Int where 0 <= i) -> Int -> Builder Vt.Term -> Int
bellsFrom i n panes =
    if i < Builder.length panes then
        bellsFrom (i + 1) (n + (Builder.getProven i panes).bells) panes

    else
        n


{-| puritty's background (`0xRRGGBB`), which `theme detect` follows:
light when its red, green and blue add to more than 382, as tmux reads a
terminal's (TM65). -}
setBackground : Int -> (taken s : State) -> State
setBackground rgb s =
    let
        light =
            (rgb // 0x10000) + modBy 0x100 (rgb // 0x100) + modBy 0x100 rgb > 382
    in
    if light == s.lightBackground then
        s

    else
        let
            next =
                { s | lightBackground = light }
        in
        withStatus next.rawStatus next


subscribed : String -> Int -> Int -> String -> StatusLine -> StatusLine
subscribed name window pane value status =
    let
        perPane change =
            { status
                | panes =
                    Dict.set pane
                        (change (Maybe.withDefault (meant Reason.NotYet { title = "", border = "", marked = False, style = "", paneStatus = "" }) (Dict.get pane status.panes)))
                        status.panes
            }

        perWindow change =
            { status
                | windows =
                    Dict.set window
                        (change (Maybe.withDefault (meant Reason.NotYet { text = "", style = "", flags = "" }) (Dict.get window status.windows)))
                        status.windows
            }
    in
    when name is
        "puritty-left" ->
            { status | left = value }

        "puritty-right" ->
            { status | right = value }

        "puritty-style" ->
            { status | style = value }

        "puritty-sep" ->
            { status | separator = value }

        "puritty-lengths" ->
            when String.split " " value |> Array.map String.toInt is
                [ Just l, Just r ] ->
                    { status | leftLength = l, rightLength = r }

                _ ->
                    status

        "puritty-wtext" ->
            perWindow (\w -> { w | text = value })

        "puritty-wstyle" ->
            perWindow (\w -> { w | style = value })

        "puritty-wflags" ->
            perWindow (\w -> { w | flags = value })

        "puritty-borders" ->
            let
                words =
                    String.split " " value
            in
            { status | borderStatus = Array.getProven 0 words, borderStyle = String.join " " (Array.dropFirst 1 words) }

        "puritty-ptitle" ->
            perPane (\q -> { q | title = value })

        "puritty-pborder" ->
            perPane (\q -> { q | border = value })

        "puritty-pmarked" ->
            perPane (\q -> { q | marked = value == "1" })

        "puritty-pstatus" ->
            perPane (\q -> { q | paneStatus = value })

        "puritty-pwstyle" ->
            perPane (\q -> { q | style = value })

        "puritty-status1" ->
            { status | extra = Dict.set 1 value status.extra }

        "puritty-status2" ->
            { status | extra = Dict.set 2 value status.extra }

        "puritty-status3" ->
            { status | extra = Dict.set 3 value status.extra }

        "puritty-status4" ->
            { status | extra = Dict.set 4 value status.extra }

        "puritty-opts" ->
            { status | options = Array.foldl (\pair d -> Dict.set pair.name pair.value d) Dict.empty (Array.map2 (\option v -> { name = option, value = v }) optionNames (String.split "\t" value)) }

        _ ->
            status


{-| The first `n` characters of styled runs. -}
takeRuns : Int -> Array { style : Style.Style, text : String } -> Array { style : Style.Style, text : String }
takeRuns n all =
    Array.foldl
        (\r acc ->
            let
                room =
                    n - acc.used

                piece =
                    String.takeFirst (max 0 room) r.text
            in
            if room <= 0 then
                acc

            else
                { used = acc.used + String.count piece, out = Array.pushLast { r | text = piece } acc.out }
        )
        { used = 0, out = [] }
        all
        |> .out


{-| Styled runs laid from column `col` on row `row`. -}
laidRuns : Int -> Int -> Array { style : Style.Style, text : String } -> { pieces : Array { row : Int, col : Int, color : String, text : String }, end : Int }
laidRuns row col all =
    Array.foldl
        (\r acc -> { end = acc.end + String.count r.text, pieces = Array.pushLast { row = row, col = acc.end, color = Style.sgr r.style, text = r.text } acc.pieces })
        { end = col, pieces = [] }
        all


{-| The status lines after the first, for `status 2` to `5` (TM54): each
`status-format[n]` as tmux expands it, in its styles, from the left; the
list's `<` and `>` markers left out, and the list not trimmed. -}
extraStatus : Int -> Int -> State -> Array { row : Int, col : Int, color : String, text : String }
extraStatus cols barRow s =
    let
        -- on the terminal's own colors, as 3.8 draws the second line
        -- (measured); its styles come in its text
        base =
            Style.plain
    in
    Array.range 1 (statusRows s - 1)
        |> Array.mapAndFlatten
            (\i ->
                let
                    row =
                        barRow + i

                    text =
                        Maybe.withDefault (meant Reason.NotYet "") (Dict.get i s.status.extra)
                            |> String.replace "#[list=left-marker]<" "#[list=left-marker]"
                            |> String.replace "#[list=right-marker]>" "#[list=right-marker]"
                in
                [ { row = row, col = 0, color = Style.sgr base, text = String.repeat cols " " } ]
                    ++ (laidRuns row 0 (Style.runs base text)).pieces
                    |> Array.mapAndKeepJust (\piece -> clipPiece 0 cols 0 piece)
            )


{-| The bar in tmux's look (TM29): tmux's status line as tmux 3.8 draws it
by default, measured in a tmux client inside another tmux: `status-style`
across the row, `status-left` cut to its length, the windows' own texts
in their styles with the separator between, `status-right` cut to its
length at the right; and where each window's text is, for a click.

When it does not all fit, as tmux's `format_draw_left` and
`format_draw_put_list` (TM43): the window list gives way first, then
status-right (its end kept), then status-left; a list cut short is
shown around the current window, with `<` or `>` where windows are
hidden. -}
tmuxBar : Int -> Int -> State -> { pieces : Array { row : Int, col : Int, color : String, text : String }, hits : Array { from : Int, to : Int, window : Int } }
tmuxBar cols row s =
    let
        base =
            Style.apply s.status.style Style.plain

        leftRuns =
            takeRuns s.status.leftLength (Style.runs base s.status.left)

        leftFull =
            Array.foldl (\r n -> n + String.count r.text) 0 leftRuns

        -- the list laid out from column 0
        windows =
            Array.foldl
                (\t acc ->
                    let
                        own =
                            Maybe.withDefault (meant Reason.NotYet { text = "", style = "", flags = "" }) (Dict.get t.id s.status.windows)

                        text =
                            if own.text == "" then
                                String.fromInt t.index
                                    ++ ":"
                                    ++ t.name
                                    ++ (if t.id == s.window then
                                            "*"

                                        else
                                            own.flags
                                       )

                            else
                                own.text

                        sep =
                            if Array.isEmpty acc.hits then
                                []

                            else
                                Style.runs base s.status.separator

                        gap =
                            laidRuns row acc.end sep

                        entry =
                            laidRuns row gap.end (Style.runs (Style.apply own.style base) text)
                    in
                    { end = entry.end
                    , pieces = acc.pieces ++ gap.pieces ++ entry.pieces
                    , hits = Array.pushLast { from = gap.end, to = entry.end - 1, window = t.id } acc.hits
                    }
                )
                { end = 0, pieces = [], hits = [] }
                s.tabs

        listFull =
            windows.end

        rightRuns =
            takeRuns s.status.rightLength (Style.runs base s.status.right)

        rightFull =
            Array.foldl (\r n -> n + String.count r.text) 0 rightRuns

        -- trimmed in tmux's order: the list, then the right, then the left
        over0 =
            max 0 (leftFull + listFull + rightFull - cols)

        listW =
            listFull - min over0 listFull

        over1 =
            over0 - (listFull - listW)

        rightW =
            rightFull - min over1 rightFull

        leftW =
            leftFull - min (over1 - (rightFull - rightW)) leftFull

        -- which part of the list shows, around the current window
        focus =
            Array.findFirst (\h -> h.window == s.window) windows.hits
                -- columns clamped to 1,000,000, far past any bar, which says
                -- to the compiler that the midpoint's sums cannot wrap
                |> Maybe.map (\f -> clamp 0 1000000 f.value.from + (clamp 0 1000000 f.value.to + 1 - clamp 0 1000000 f.value.from) // 2)
                |> Maybe.withDefault (meant Reason.NotKnown 0)

        start0 =
            if listW >= listFull then
                0

            else if focus < listW // 2 then
                0

            else
                min (focus - listW // 2) (listFull - listW)

        leftMark =
            start0 /= 0 && listW > 1

        -- where the list goes, by status-justify, as tmux 3.8 draws it
        -- (measured, TM49): after status-left, centered between the two
        -- sides, against status-right, or centered on the whole row
        justify =
            Maybe.withDefault (meant Reason.NotSet "left") (Dict.get "status-justify" s.status.options)

        listAt =
            if justify == "right" then
                -- against status-right, which stays at the edge (measured)
                max leftW (cols - rightW - listW)

            else if justify == "centre" then
                max leftW (leftW + ((cols - rightW) - leftW) // 2 - listW // 2)

            else if justify == "absolute-centre" then
                max 0 ((cols - listW) // 2)

            else
                leftW

        rightAt =
            cols - rightW

        afterLeft =
            { at =
                listAt
                    + (if leftMark then
                        1

                       else
                        0
                      )
            , start =
                start0
                    + (if leftMark then
                        1

                       else
                        0
                      )
            , width =
                listW
                    - (if leftMark then
                        1

                       else
                        0
                      )
            }

        rightMark =
            listW < listFull && afterLeft.start + afterLeft.width < listFull && afterLeft.width > 1

        shown =
            { afterLeft
                | width =
                    afterLeft.width
                        - (if rightMark then
                            1

                           else
                            0
                          )
            }

        marks =
            (if leftMark then
                [ { row = row, col = listAt, color = Style.sgr base, text = "<" } ]

             else
                []
            )
                ++ (if rightMark then
                        [ { row = row, col = shown.at + shown.width, color = Style.sgr base, text = ">" } ]

                    else
                        []
                   )

        listPieces =
            windows.pieces
                |> Array.mapAndKeepJust (\piece -> clipPiece shown.start (shown.start + shown.width) (shown.at - shown.start) piece)

        hits =
            windows.hits
                |> Array.mapAndKeepJust
                    (\h ->
                        let
                            from =
                                max h.from shown.start

                            to =
                                min h.to (shown.start + shown.width - 1)
                        in
                        if from > to then
                            Nothing

                        else
                            Just { from = from + shown.at - shown.start, to = to + shown.at - shown.start, window = h.window }
                    )
    in
    { pieces =
        [ { row = row, col = 0, color = Style.sgr base, text = String.repeat cols " " } ]
            ++ Array.mapAndKeepJust (\piece -> clipPiece 0 leftW 0 piece) (laidRuns row 0 leftRuns).pieces
            ++ listPieces
            ++ marks
            ++ Array.mapAndKeepJust (\piece -> clipPiece (rightFull - rightW) rightFull (rightAt - (rightFull - rightW)) piece) (laidRuns row 0 rightRuns).pieces
    , hits = hits
    }


{-| The part of a piece between columns `from` and `to` (not included),
moved by `shift`, if any of it is there. -}
clipPiece : Int -> Int -> Int -> { row : Int, col : Int, color : String, text : String } -> Maybe { row : Int, col : Int, color : String, text : String }
clipPiece from to shift piece =
    let
        first =
            max from piece.col

        last =
            min to (piece.col + String.count piece.text)
    in
    if first >= last then
        Nothing

    else
        Just { piece | col = first + shift, text = String.slice (first - piece.col) (last - piece.col) piece.text }


{-| Pieces of text, each in its own color, in order. -}
drawPieces : Array { row : Int, col : Int, color : String, text : String } -> (taken t : Vt.Term) -> Vt.Term
drawPieces pieces t =
    Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) t pieces


-- RUNNING tmux's COMMANDS, AND MENUS (TM27)


{-| A format for `display-message -p` to expand as tmux expands one in a
menu or a prompt: `display-message` also gives `%` to strftime, which
would make a template's `%%` one `%` (measured: a menu's Rename named the
window `%`), so each `%` is written `%%`, which strftime gives back. -}
noTime : String -> String
noTime text =
    String.replace "%" "%%" text


paneName : Int -> String
paneName pane =
    "%" ++ String.fromInt pane


{-| Whether puritty runs a held binding itself: a prompt, a menu, or an
`if-shell -F` that chooses between commands. -}
runsHere : String -> Bool
runsHere line =
    when { ask = Syntax.askOf line, menu = Syntax.menuOf line, test = Syntax.ifFormatOf line, panes = Syntax.panesOf line, tree = Syntax.treeOf line, list = Syntax.listOf line, popup = Syntax.popupOf line, custom = Syntax.customizeOf line } is
        { ask = Nothing, menu = Nothing, test = Nothing, panes = Nothing, tree = Nothing, list = Nothing, popup = Nothing, custom = Nothing } ->
            False

        _ ->
            True


{-| A binding run by puritty, from a key or a click (TM27): where it
names the mouse's word or line (`mouse_word`, `mouse_line`), those are
set first as the pane's options it is read with instead, since tmux has
no mouse event of this client's to find them in. -}
runHeld : Context -> String -> String -> String -> (taken s : State) -> { state : State, commands : Array String }
runHeld ctx word line command s =
    let
        options =
            if String.contains "mouse_" command then
                [ { command = Command.setPaneOption (paneName ctx.pane) "@puritty_mouse_word" word, expect = ForNothing }
                , { command = Command.setPaneOption (paneName ctx.pane) "@puritty_mouse_line" line, expect = ForNothing }
                ]

            else
                []

        set =
            sendAsking options
                (if Array.isEmpty options then
                    s

                 else
                    { s | mouseOptions = Just ctx.pane }
                )

        ran =
            runLine ctx command set.state
    in
    { state = ran.state, commands = set.commands ++ ran.commands }


{-| The mouse's formats as the options `runHeld` sets: written once, so
that a line made from one already changed changes no further. -}
mouseNames : String -> String
mouseNames line =
    line
        |> String.replace "@puritty_mouse_word" "mouse_word"
        |> String.replace "@puritty_mouse_line" "mouse_line"
        |> String.replace "mouse_word" "@puritty_mouse_word"
        |> String.replace "mouse_line" "@puritty_mouse_line"


{-| A command line run by puritty for tmux (TM27), as tmux would run it: a
prompt opens puritty's (TM25), a menu puritty's, an `if-shell -F` asks tmux
the format and runs the branch it gives; other commands are sent, each on
a line of its own, the mouse's pane named where `-t =` names it, and
`send-keys -M` left out, since puritty gives a pane the mouse itself.
Anything held for another reason (`suspend-client`) is said, not run. -}
runLine : Context -> String -> (taken s : State) -> { state : State, commands : Array String }
runLine ctx line s =
    let
        fixed =
            Syntax.retarget (paneName ctx.pane) (mouseNames line)
    in
    if String.trim fixed == "" then
        { state = s, commands = [] }

    else if String.startsWith "run -C " fixed || String.startsWith "run-shell -C " fixed then
        -- `run -C` runs its string as tmux's commands, as tmux's session
        -- menu binding does (TM58): run here, so that a menu in it shows
        -- its string is a format, expanded before it runs: tmux expands
        -- it for puritty first
        when Syntax.commands (Syntax.tokens fixed) |> Array.first |> Maybe.map (Array.dropFirst 2) |> Maybe.andThen Array.first is
            Just inner ->
                if String.contains "#{" inner.value then
                    sendAsking [ { command = Command.displayAt (paneName ctx.pane) (noTime inner.value), expect = ForRunExpanded ctx } ] s

                else
                    runLine ctx inner.value s

            Nothing ->
                meant Reason.FromOutside plainLines ctx fixed s

    else
        when Syntax.askOf fixed is
            Just found ->
                let
                    opened =
                        opening found.ask found.after
                in
                sendAsking opened.expand { s | said = "", asking = Just opened.asking }

            Nothing ->
                meant Reason.NotKnown
                    when { menu = Syntax.menuOf fixed, panes = Syntax.panesOf fixed } is
                        { menu = Just m, panes = _ } ->
                            openMenu ctx m.menu m.after s

                        { menu = Nothing, panes = Nothing } ->
                            when { tree = Syntax.treeOf fixed, list = Syntax.listOf fixed, popup = Syntax.popupOf fixed, custom = Syntax.customizeOf fixed } is
                                { tree = Nothing, list = Nothing, popup = Nothing, custom = Just cust } ->
                                    openCustomize ctx cust s

                                { tree = Nothing, list = Nothing, popup = Just pop, custom = _ } ->
                                    openPopup ctx pop s

                                { tree = Nothing, list = Just l, popup = _, custom = _ } ->
                                    listPreviewAfter (openListing ctx l s)

                                { tree = Just t, list = _, popup = _, custom = _ } ->
                                    let
                                        opened =
                                            sendAsking
                                                (treeQueries s.version
                                                    ++ (if t.filter == "" then
                                                            []

                                                        else
                                                            [ filterQuery t.filter ]
                                                       )
                                                )
                                                { s | said = "", tree = Just { sessions = [], windows = [], panes = [], loaded = 0, open = Dict.empty, openWindows = Dict.empty, selected = 0, start = t.start, filter = t.filter, passing = Nothing, noMatches = False, search = "", previewMode = 1, info = False, sort = 0, reversed = False, tagged = [], reload = Nothing, template = t.template, pane = ctx.pane, zoom = t.zoom, preview = noPreview } }

                                        ran =
                                            runLine ctx t.after opened.state
                                    in
                                    { state = ran.state, commands = opened.commands ++ ran.commands }

                                { tree = Nothing, list = Nothing, popup = Nothing, custom = Nothing } ->
                                    plainLines ctx fixed s

                        { menu = Nothing, panes = Just d } ->
                            let
                                opened =
                                    sendAsking
                                        [ { command = Command.listPanesOf "N #{pane_id} #{pane_index}", expect = ForNumbers } ]
                                        { s | said = "", numbers = Just { indexes = [], until = Clock.after s.clock (Maybe.withDefault (meant Reason.NotSet s.panesMs) d.duration), template = d.template, keys = d.keys, pane = ctx.pane } }

                                ran =
                                    runLine ctx d.after opened.state
                            in
                            { state = ran.state, commands = opened.commands ++ ran.commands }


{-| `runLine`'s commands that are not a prompt, a menu, the panes' numbers
or a tree. -}
plainLines : Context -> String -> (taken s : State) -> { state : State, commands : Array String }
plainLines ctx fixed s0 =
    let
        -- a line that detaches this client sends nothing after it (TM92)
        s =
            if endsClient s0.clientName fixed then
                { s0 | ending = 1 }

            else
                s0
    in
    when Syntax.ifFormatOf fixed is
        Just f ->
            sendAsking
                [ { command =
                        Command.displayLiteral
                            (if f.target == "" then
                                paneName ctx.pane

                             else
                                f.target
                            )
                            (noTime f.condition)
                  , expect = ForCondition { pane = ctx.pane, mouse = ctx.mouse, yes = f.yes, no = f.no, after = f.after }
                  }
                ]
                s

        Nothing ->
            meant Reason.NotKnown
                when Array.popFirst (Syntax.lines fixed) is
                    Just { first, rest } ->
                        let
                            one =
                                runOne first s

                            others =
                                runLine ctx (String.join " ; " rest) one.state
                        in
                        { state = others.state, commands = one.commands ++ others.commands }

                    Nothing ->
                        meant Reason.NoMore { state = s, commands = [] }


{-| One plain command of `runLine`'s. -}
runOne : String -> (taken s : State) -> { state : State, commands : Array String }
runOne command s =
    let
        words =
            String.split " " command |> Array.keepIf (\w -> w /= "")

        name =
            Maybe.withDefault (meant Reason.FromOutside "") (Array.first words)

        mouseKeys =
            (name == "send-keys" || name == "send") && Array.any (\w -> String.startsWith "-" w && not (String.startsWith "--" w) && String.contains "M" w) words
    in
    if mouseKeys then
        { state = s, commands = [] }

    else
        when Bindings.held command is
            Just why ->
                { state = { s | said = "puritty: " ++ why }, commands = [] }

            Nothing ->
                meant Reason.NotKnown sendAsking [ { command = command, expect = ForRan } ] s


{-| A menu opened (TM27): its title, names and commands that hold a
format asked of tmux in the menu's pane, as tmux expands them when it
shows a menu, and the commands after it run at once, as tmux runs them. -}
openMenu : Context -> Syntax.Menu -> String -> (taken s : State) -> { state : State, commands : Array String }
openMenu ctx menu after s =
    let
        serial =
            s.serial + 1

        expand text expect =
            if String.contains "#" text then
                [ { command = Command.displayLiteral (paneName ctx.pane) (noTime text), expect = expect } ]

            else
                []

        asks =
            expand menu.title (ForMenuTitle serial)
                ++ (menu.items
                        |> Array.indexedMap (\i it -> expand it.name (ForMenuName { serial = serial, item = i }) ++ expand it.command (ForMenuCommand { serial = serial, item = i }))
                        |> Array.flatten
                   )

        shown =
            readied
                { serial = serial
                , title = menu.title
                , items = menu.items
                , pending = Array.length asks
                , selected = -1
                , pane = ctx.pane
                , mouse = ctx.mouse
                , x = menu.x
                , y = menu.y
                , armed = False
                , stayOpen = menu.stayOpen
                , start = menu.start
                , forMode = False
                , completes = False
                }

        opened =
            sendAsking asks { s | serial = serial, said = "", menu = Just shown }

        ran =
            runLine ctx after opened.state
    in
    { state = ran.state, commands = opened.commands ++ ran.commands }


{-| A menu whose formats have all been answered: from the keyboard, the
item `-C` names is chosen, or the next that can be, going round; past the
last, the last that can be; `-` none; without `-C` the first that can be,
as tmux's `menu_display` (TM84). From a click, none. -}
readied : Menuing -> Menuing
readied m =
    if m.pending > 0 || m.mouse /= Nothing then
        m

    else
        let
            rows =
                menuRows m

            count =
                Array.length rows

            enabledAt i =
                Array.get i rows |> Maybe.map .enabled |> Maybe.withDefault (meant Reason.OutOfRange False)

            -- from `from`, one way round, the first that can be chosen
            around from step =
                Array.range 0 (count - 1)
                    |> Array.map (\k -> modBy (max 1 count) (from + step * k + count * count))
                    |> Array.findFirst enabledAt
                    |> Maybe.map (\found -> found.value)
                    |> Maybe.withDefault (meant Reason.NoMore -1)

            chosen =
                when m.start is
                    Just "-" ->
                        -1

                    Just given ->
                        when String.toInt given is
                            Just n ->
                                if n >= count then
                                    around (count - 1) -1

                                else
                                    around (max 0 n) 1

                            Nothing ->
                                meant Reason.FromOutside (around 0 1)

                    Nothing ->
                        -- no -C: the first that can be chosen
                        meant Reason.NotSet (around 0 1)
        in
        -- none when no item can be chosen, or -C -
        { m | selected = Array.get chosen rows |> Maybe.map .index |> Maybe.withDefault (meant Reason.NoMore -1) }


{-| One of a menu's formats answered: its first line, or what was written
when tmux could not expand it. -}
firstLine : Bool -> Array Bytes -> String -> String
firstLine ok lines written =
    if ok then
        Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault (meant Reason.FromOutside "")

    else
        written


menuPart : Int -> (Menuing -> Menuing) -> (taken s : State) -> State
menuPart serial change s =
    when s.menu is
        Just m ->
            if m.serial == serial then
                { s | menu = Just (readied (change { m | pending = m.pending - 1 })) }

            else
                s

        Nothing ->
            meant Reason.NotOpen s


{-| Text without tmux's styles (`#[align=centre]`), and `##` as `#`. -}
unstyled : String -> String
unstyled text =
    String.toArray text
        |> Array.foldl
            (\c acc ->
                if acc.inStyle then
                    { acc | inStyle = c /= ']', prev = ' ' }

                else if c == '[' && acc.prev == '#' then
                    { acc | inStyle = True, out = Array.dropLast 1 acc.out, prev = ' ' }

                else if c == '#' && acc.prev == '#' then
                    { acc | prev = ' ' }

                else
                    { acc | out = Array.pushLast c acc.out, prev = c }
            )
            { inStyle = False, out = [], prev = ' ' }
        |> .out
        |> String.fromArray


{-| A menu's rows as tmux shows them (`menu_add_item`): a name expanded
to nothing is a line, never two together and none first or last; a name
that begins with `-` is shown without it and cannot be chosen, and has no
key shown. -}
menuRows : Menuing -> Array MenuRow
menuRows m =
    let
        rows =
            m.items
                |> Array.indexedMap (\i it -> { i = i, it = it })
                |> Array.foldl
                    (\x acc ->
                        let
                            i =
                                x.i

                            it =
                                x.it

                            name =
                                unstyled it.name
                        in
                        if String.trim name == "" then
                            when Array.last acc is
                                Just last ->
                                    if last.line then
                                        acc

                                    else
                                        Array.pushLast { index = i, line = True, text = "", key = "", enabled = False } acc

                                Nothing ->
                                    meant Reason.OutOfRange acc

                        else if String.startsWith "-" name then
                            Array.pushLast { index = i, line = False, text = String.dropFirst 1 name, key = "", enabled = False } acc

                        else
                            Array.pushLast { index = i, line = False, text = name, key = it.key, enabled = True } acc
                    )
                    []
    in
    when Array.last rows is
        Just last ->
            if last.line then
                Array.dropLast 1 rows

            else
                rows

        Nothing ->
            meant Reason.NoMore rows


{-| Where a menu goes and its size (TM27): as wide as its widest item and
its key, `(k)`, with a space either side, or its title; `-x` and `-y` as
tmux(1) has them, measured on 3.8: `P` the pane's left and its bottom row
as the menu's last, `W` the window's tab and the row beside the bar, `M`
the mouse's cell, `C` the middle, `R` the right; a number as it is; kept
inside the panes' rows. -}
menuPlace : (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> State -> Menuing -> (r : { x : Int, y : Int, w : Int, h : Int, rows : Array MenuRow, title : String } where 0 <= r.x && r.x <= 1000 && 0 <= r.y && r.y <= 1000 && 0 <= r.w && r.w <= 1000 && 0 <= r.h && r.h <= 1000)
menuPlace cols rows s m =
    let
        shown =
            menuRows m

        keyText r =
            if r.enabled && r.key /= "" then
                "(" ++ r.key ++ ")"

            else
                ""

        widest =
            Array.foldl
                (\r acc ->
                    max acc
                        (String.count r.text
                            + (if keyText r == "" then
                                0

                               else
                                1 + String.count (keyText r)
                              )
                        )
                )
                0
                shown

        heading =
            unstyled m.title

        w =
            clamp 0 cols (max (min 1000 widest + 4) (min 1000 (String.count heading) + 4))

        statusLines =
            statusRows s

        areaTop =
            if s.barTop then
                statusLines

            else
                0

        areaH =
            rows - statusLines

        h =
            clamp 0 (max 0 areaH) (min 1000 (Array.length shown) + 2)

        pane =
            when s.layout is
                Just cell ->
                    Array.findFirst (\q -> q.id == m.pane) (placedPanes s cell (Layout.tiled cell ++ Layout.floating cell)) |> Maybe.map .value

                Nothing ->
                    meant Reason.NotYet Nothing

        barRow =
            if s.barTop then
                0

            else
                rows - max 1 (statusRows s)

        tab =
            Array.findFirst (\hit -> hit.window == s.window) (tabsOf cols barRow s).hits |> Maybe.map (\f -> f.value.from) |> Maybe.withDefault (meant Reason.NotKnown 0)

        mouse =
            Maybe.withDefault (meant Reason.NotSet { col = (cols - w) // 2, row = areaTop + (areaH - h) // 2 }) m.mouse

        x =
            when m.x is
                "R" ->
                    cols - w

                "P" ->
                    Maybe.withDefault (meant Reason.Gone 0) (Maybe.map .x pane)

                "M" ->
                    mouse.col

                "W" ->
                    tab

                other ->
                    Maybe.withDefault (meant Reason.FromOutside (cols - w) // 2) (String.toInt other)

        y =
            when m.y is
                "P" ->
                    Maybe.withDefault (meant Reason.Gone areaTop) (Maybe.map (\q -> q.y + q.h - h) pane)

                "M" ->
                    mouse.row

                "W" ->
                    if s.barTop then
                        areaTop

                    else
                        areaTop + areaH - h

                "S" ->
                    if s.barTop then
                        areaTop

                    else
                        areaTop + areaH - h

                other ->
                    Maybe.withDefault (meant Reason.FromOutside areaTop + (areaH - h) // 2) (String.toInt other)
    in
    { x = clamp 0 (max 0 (cols - w)) x
    , y = clamp areaTop (max areaTop (areaTop + areaH - h)) y
    , w = w
    , h = h
    , rows = shown
    , title = heading
    }


{-| A menu's cells: in tmux's look as tmux draws one, measured on 3.8
(single lines, the title in the middle of the top edge, the chosen item
in `menu-selected-style`, black on yellow, one that cannot be chosen
dim); in puritty's, in the view's box with the chosen item amber. -}
drawMenu : Colors -> Bool -> { x : Int, y : Int, w : Int, h : Int, rows : Array MenuRow, title : String } -> Menuing -> Array { row : Int, col : Int, color : String, text : String }
drawMenu colors tmuxLook place m =
    let
        inner =
            place.w - 2

        -- menu-style and menu-border-style (TM65), a disabled item dim
        edge =
            if tmuxLook then
                colors.menuBorder

            else
                viewEdgeColor

        plainColor =
            if tmuxLook then
                colors.menu

            else
                viewTextColor

        dimColor =
            if tmuxLook then
                String.replace "\u{001B}[0" "\u{001B}[0;2" colors.menu

            else
                "\u{001B}[0;38;5;243;48;5;236m"

        chosenColor =
            if tmuxLook then
                colors.menuSelected

            else
                activeTabColor

        heading =
            String.takeFirst inner place.title

        top =
            if tmuxLook then
                let
                    left =
                        (inner - String.count heading) // 2
                in
                "┌" ++ String.repeat left "─" ++ heading ++ String.repeat (inner - left - String.count heading) "─" ++ "┐"

            else
                let
                    label =
                        if heading == "" then
                            ""

                        else
                            " " ++ String.takeFirst (inner - 2) heading ++ " "
                in
                "╭" ++ label ++ String.repeat (inner - String.count label) "─" ++ "╮"

        bottom =
            (if tmuxLook then
                "└"

             else
                "╰"
            )
                ++ String.repeat inner "─"
                ++ (if tmuxLook then
                        "┘"

                    else
                        "╯"
                   )

        body =
            -- `max 2`: the same rows for every height, and no difference
            -- that can wrap
            Array.range 0 (max 2 place.h - 3)
                |> Array.mapAndFlatten
                    (\i ->
                        when Array.get i place.rows is
                            Just r ->
                                if r.line then
                                    [ { row = place.y + 1 + i, col = place.x, color = edge, text = "├" ++ String.repeat inner "─" ++ "┤" } ]

                                else
                                    let
                                        key =
                                            if r.enabled && r.key /= "" then
                                                "(" ++ r.key ++ ")"

                                            else
                                                ""

                                        text =
                                            " " ++ String.padRight (inner - 2 - String.count key) ' ' (String.takeFirst (inner - 2) r.text) ++ key ++ " "

                                        color =
                                            if r.index == m.selected && r.enabled then
                                                chosenColor

                                            else if r.enabled then
                                                plainColor

                                            else
                                                dimColor
                                    in
                                    [ { row = place.y + 1 + i
                                      , col = place.x
                                      , color = edge
                                      , text =
                                            (if tmuxLook then
                                                "│"

                                             else
                                                "│"
                                            )
                                                ++ String.repeat inner " "
                                                ++ "│"
                                      }
                                    , { row = place.y + 1 + i, col = place.x + 1, color = color, text = text }
                                    , { row = place.y + 1 + i, col = place.x + place.w - 1, color = edge, text = "│" }
                                    ]

                            Nothing ->
                                meant Reason.OutOfRange []
                    )
    in
    [ { row = place.y, col = place.x, color = edge, text = top } ]
        ++ body
        ++ [ { row = place.y + place.h - 1, col = place.x, color = edge, text = bottom } ]


{-| A key while a menu is open (TM27), as tmux's menu takes it: an item's
own key chooses it; Up, k, Down and j move among those that can be
chosen; Home and g the first, End and G the last; Enter or Space chooses
the one moved to; Escape, q and C-c close it. -}
menuKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Menuing -> (taken s : State) -> { state : State, commands : Array String }
menuKey k m s =
    let
        name =
            Maybe.withDefault (meant Reason.NotKnown "") (lookupName k)

        choosable =
            Array.keepIf .enabled (menuRows m)

        at =
            Array.findFirst (\r -> r.index == m.selected) choosable |> Maybe.map .index

        count =
            Array.length choosable

        moveTo i st =
            { state = { st | menu = Just { m | selected = Array.get (modBy (max 1 count) i) choosable |> Maybe.map .index |> Maybe.withDefault (meant Reason.NoMore -1) } }, commands = [] }
    in
    if m.pending > 0 then
        if name == "Escape" || name == "q" || name == "C-c" then
            { state = { s | menu = Nothing }, commands = [] }

        else
            { state = s, commands = [] }

    else
        -- a mode's menu also by its item's key as the mode takes it, where
        -- tmux 3.5 on shows a control key by its C0 name (TM87)
        when Array.findFirst (\r -> name /= "" && (r.key == name || (m.forMode && Maybe.map .command (Array.get r.index m.items) == Just name))) choosable is
            Just r ->
                chooseItem r.value.index m s

            Nothing ->
                meant Reason.NotKnown
                    if name == "Escape" || name == "q" || name == "C-c" then
                        { state = { s | menu = Nothing }, commands = [] }

                    else if name == "Up" || name == "k" || name == "BTab" then
                        moveTo (Maybe.withDefault (meant Reason.NotYet 0) at - 1) s

                    else if name == "Down" || name == "j" || name == "Tab" then
                        moveTo (min 2000000000 (Maybe.withDefault (meant Reason.NotYet -1) at) + 1) s

                    else if name == "Home" || name == "g" then
                        moveTo 0 s

                    else if name == "End" || name == "G" then
                        moveTo (count - 1) s

                    else if name == "Enter" || name == "KPEnter" || name == "Space" || name == "C-m" then
                        if m.selected >= 0 then
                            chooseItem m.selected m s

                        else
                            { state = { s | menu = Nothing }, commands = [] }

                    else
                        { state = s, commands = [] }


{-| An item chosen: the menu closed and its command run in its pane. -}
chooseItem : Int -> Menuing -> (taken s : State) -> { state : State, commands : Array String }
chooseItem index m s =
    let
        command =
            Array.get index m.items |> Maybe.map .command |> Maybe.withDefault (meant Reason.OutOfRange "")
    in
    if m.completes then
        -- the prompt's word made the item (`status_prompt_menu_callback`,
        -- TM98)
        { state = { s | menu = Nothing, asking = Maybe.map (wordReplaced command) s.asking }, commands = [] }

    else if m.forMode then
        -- a mode's menu: its key given to the mode (TM87)
        modeKeyed (keyNamed command) { s | menu = Nothing }

    else
        runLine { pane = m.pane, mouse = m.mouse } command { s | menu = Nothing }


{-| The pointer while a menu is open (TM27): over an item it is chosen;
a press outside closes the menu; letting a button go over an item runs it,
once the pointer has moved or been pressed since the menu opened, so that
letting go of the click that opened it does not. -}
menuPointer : Window.PointerEvent -> Int -> Int -> Menuing -> (taken s : State) -> { state : State, commands : Array String }
menuPointer p col row m s =
    let
        place =
            menuPlace s.canvas.cols s.canvas.rows s m

        inside =
            col >= place.x && col < place.x + place.w && row >= place.y && row < place.y + place.h

        under =
            if inside then
                Array.get (row - place.y - 1) place.rows
                    |> Maybe.andThen
                        (\r ->
                            if r.enabled then
                                Just r.index

                            else
                                Nothing
                        )

            else
                Nothing

        moved =
            m.mouse /= Just { col = col, row = row }
    in
    if p.button == 4 || p.button == 5 then
        { state = s, commands = [] }

    else if p.action == 0 then
        if inside && m.stayOpen then
            -- `-O`: a press chooses; on a line or a name that cannot be
            -- chosen, the menu stays (TM84)
            when under is
                Just i ->
                    chooseItem i m s

                Nothing ->
                    meant Reason.OutOfRange { state = s, commands = [] }

        else if inside then
            { state = { s | menu = Just { m | armed = True, selected = Maybe.withDefault (meant Reason.OutOfRange m.selected) under } }, commands = [] }

        else
            { state = { s | menu = Nothing }, commands = [] }

    else if p.action == 1 && m.stayOpen then
        -- `-O`: letting go chooses nothing and closes nothing
        { state = { s | menu = Just { m | selected = Maybe.withDefault (meant Reason.OutOfRange m.selected) under } }, commands = [] }

    else if p.action == 1 then
        when under is
            Just i ->
                if m.armed || moved then
                    chooseItem i m s

                else
                    { state = s, commands = [] }

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else
        { state = { s | menu = Just { m | armed = m.armed || moved, selected = Maybe.withDefault (meant Reason.OutOfRange m.selected) under } }, commands = [] }


-- THE PANES' NUMBERS (TM28)


{-| A key while the panes' numbers are shown, as tmux's `display-panes`
takes it: a digit that is a pane's index runs the command with it and
closes them, and from 3.2 a letter `a` to `z` for panes 10 to 35, as
tmux's key handler takes them (`cmd-display-panes.c`, TM79; before 3.2
they cannot be chosen), though its labels letter only 10 to 34; any other
key closes them and goes no further. -}
numberKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Numbering -> (taken s : State) -> { state : State, commands : Array String }
numberKey k n s =
    let
        text =
            Bytes.toStringLossy k.text

        letters =
            s.version == 0 || s.version >= 32

        keyIndex =
            when String.toArray text is
                [ c ] ->
                    if Char.isDigit c then
                        String.toInt text

                    else if letters && c >= 'a' && c <= 'z' then
                        Just (10 + Char.toCode c - 0x61)

                    else
                        Nothing

                _ ->
                    Nothing

        chosen =
            if n.keys && Bitwise.and k.mods 6 == 0 then
                keyIndex |> Maybe.andThen (\d -> Array.findFirst (\e -> e.index == d) n.indexes)

            else
                Nothing
    in
    when chosen is
        Just found ->
            -- `%%` is the pane's id, `%5`, as every tmux fills it
            -- (`cmd-display-panes.c`, TM79)
            runLine { pane = n.pane, mouse = Nothing } (Syntax.fill (Syntax.tokens n.template) [ "%" ++ String.fromInt found.value.id ]) { s | numbers = Nothing }

        Nothing ->
            meant Reason.NotKnown { state = { s | numbers = Nothing }, commands = [] }


{-| When puritty's loop should next wake for tmux, -1 for none: the
soonest of the panes' numbers closing (TM28), the status line's poll
before 3.2 (TM29), a stray wait, and a clock shown (`clockAt`). -}
dueAt : State -> Int
dueAt s =
    let
        clockDue =
            clockAt s
    in
    Clock.soonest
        (Clock.soonest
            (if mouseOptionsDone s then
                -- at once: the mouse's options unset (TB15)
                s.clock

             else
                s.pollAt
            )
            (if s.strayUntil == -2 then
                -- at once: the wait starts from the next tick's time
                s.clock

             else
                s.strayUntil
            )
        )
        (when s.numbers is
            Just n ->
                if clockDue >= 0 then
                    Clock.earlier n.until clockDue

                else
                    n.until

            Nothing ->
                meant Reason.NotOpen clockDue
        )


{-| The loop's time now, given before a read, a pointer's event or a
drag: what is stamped on those paths (the time of day's answer, the
panes' numbers' end, the next poll) is stamped with it, where it was
the last tick's, 0 before the first (the code review's TB12). -}
clockedAt : Int -> (taken s : State) -> State
clockedAt ms s =
    { s | clock = ms }


{-| The time, from the loop: the panes' numbers closed once it is past
their time, and the status line asked when it is due (TM72). -}
tick : Int -> (taken s : State) -> { state : State, commands : Array String }
tick ms s0 =
    let
        -- the time of day carried forward to now, since the loop's clock
        -- starts over (RE11)
        s1 =
            { s0 | dayAt = Maybe.map (\d -> { clock = ms, ms = modBy 86400000 (d.ms + Clock.since d.clock ms) }) s0.dayAt }

        s2 =
            when s1.numbers is
                Just n ->
                    if Clock.reached n.until ms then
                        { s1 | numbers = Nothing, clock = ms }

                    else
                        { s1 | clock = ms }

                Nothing ->
                    meant Reason.NotOpen { s1 | clock = ms }

        -- the wait after a line that was not tmux's starts now, and when it
        -- is over with no answer, its client is gone: the next read ends
        -- control mode (TK14)
        s =
            if s2.strayUntil == -2 then
                { s2 | strayUntil = Clock.after ms strayMs }

            else if s2.strayUntil >= 0 && Clock.reached s2.strayUntil ms then
                { s2 | reader = Control.giveUp s2.reader, strayUntil = -1 }

            else
                s2
    in
    if s.on && mouseOptionsDone s then
        -- the mouse's word and line unset from the pane (the code
        -- review's TB15): what read them has been sent
        let
            pane =
                Maybe.withDefault (meant Reason.NotOpen -1) s.mouseOptions
        in
        { state = { s | mouseOptions = Nothing }
        , commands =
            [ Command.unsetOption 6 (paneName pane) "@puritty_mouse_word"
            , Command.unsetOption 6 (paneName pane) "@puritty_mouse_line"
            ]
        }

    else if s.on && s.pollAt >= 0 && Clock.reached s.pollAt ms && pollWaited s then
        -- the last poll not all answered (a stalled link, tmux blocked
        -- behind wait-for): none asked again until it is, where twenty a
        -- second piled up (the code review's TA16, TB9)
        { state = { s | pollAt = Clock.after ms pollMs }, commands = [] }

    else if s.on && s.pollAt >= 0 && Clock.reached s.pollAt ms then
        let
            asked =
                pollsFor s
        in
        { state = expected asked { s | pollAt = Clock.after ms pollMs }, commands = Array.map .command asked }

    else
        { state = s, commands = [] }


{-| Whether the mouse's word and line set on a pane are to be unset:
nothing that may read them is open, a menu, a prompt, the tree, a list,
customize mode, or a question asked for a binding's branch. -}
mouseOptionsDone : State -> Bool
mouseOptionsDone s =
    s.mouseOptions /= Nothing
        && s.menu == Nothing
        && s.asking == Nothing
        && s.tree == Nothing
        && s.listing == Nothing
        && s.customizing == Nothing
        && not
            (Array.any
                (\a ->
                    when a.expect is
                        ForCondition _ ->
                            True

                        ForRunExpanded _ ->
                            True

                        _ ->
                            False
                )
                s.expecting
            )


{-| Whether an answer to the status line's last poll is still awaited. -}
pollWaited : State -> Bool
pollWaited s =
    Array.any
        (\a ->
            when a.expect is
                ForPoll _ ->
                    True

                ForRawOptions _ ->
                    True

                _ ->
                    False
        )
        s.expecting


{-| How long tmux is given to answer after a line that was not its own
(TK14): it answers a command at once, and a client killed with no `%exit`
waits this long before what was typed reaches the shell. -}
strayMs : Int
strayMs =
    1500


{-| The last piece of `s` cut at `sep`: a separator that is not empty cuts
at least one piece, so the last is always there. -}
lastPiece : (sep : String where 1 <= String.count sep) -> String -> String
lastPiece sep s =
    let
        parts =
            String.split sep s
    in
    Array.getProven (Array.length parts - 1) parts


{-| Whether control mode is to end at the next read, which may be an empty
one: tmux did not answer after a line that was not its own (TK14). -}
givingUp : State -> Bool
givingUp s =
    Control.isGivingUp s.reader


{-| A pane's number as tmux draws it (`window_clock_table`'s digits, five
cells square, a cell apart, in the middle of the pane, in
`display-panes-color`, blue, or `display-panes-active-color`, red, for
the active pane, with the pane's size at its top right), or as text where
the pane is too small; in puritty's look in gray and amber, without the
size. -}
paneNumber : Int -> Colors -> Bool -> Bool -> Numbering -> Layout.Pane -> Array { row : Int, col : Int, color : String, text : String }
paneNumber version colors tmuxLook isActive n p =
    when Array.findFirst (\e -> e.id == p.id) n.indexes is
        Nothing ->
            meant Reason.NotYet []

        Just found ->
            let
                index =
                    found.value.index

                digits =
                    String.fromInt index

                len =
                    String.count digits

                -- panes 10 to 34 are labelled by a letter too, from 3.2,
                -- as tmux draws them (`pane < 35`); its keys take a to z,
                -- 10 to 35 (TM79)
                letter =
                    if index > 9 && index < 35 && (version == 0 || version >= 32) then
                        String.fromChar (Char.fromCodeProven (0x61 + index - 10))

                    else
                        ""

                -- 3.8 draws them in its own mode (`window-panes.c`), 3.6
                -- on the client (`cmd-display-panes.c`), and centers them
                -- each its own way: a cell apart on odd widths and even
                -- heights
                newer =
                    version == 0 || version >= 38

                -- display-panes-colour and -active-colour (TM51)
                block =
                    if tmuxLook then
                        Style.sgr
                            (Style.apply
                                ("bg="
                                    ++ (if isActive then
                                            colors.panesActive

                                        else
                                            colors.panes
                                       )
                                )
                                Style.plain
                            )

                    else if isActive then
                        "\u{001B}[0;48;5;214m"

                    else
                        "\u{001B}[0;48;5;242m"

                ink =
                    if tmuxLook then
                        Style.sgr
                            (Style.apply
                                ("fg="
                                    ++ (if isActive then
                                            colors.panesActive

                                        else
                                            colors.panes
                                       )
                                )
                                Style.plain
                            )

                    else if isActive then
                        "\u{001B}[0;1;38;5;214m"

                    else
                        "\u{001B}[0;1;38;5;250m"

                -- the pane's size at its top right: 3.6's, and 3.8's
                -- display-panes-format by default
                size =
                    let
                        text =
                            String.fromInt p.w ++ "x" ++ String.fromInt p.h
                    in
                    if tmuxLook && String.count text <= p.w then
                        [ { row = p.y, col = p.x + p.w - String.count text, color = ink, text = text } ]

                    else
                        []

                small =
                    if newer then
                        p.w < len * 6 - 1 || p.h < 7

                    else
                        p.w < len * 6 || p.h < 5
            in
            if p.w < len then
                []

            else if small then
                let
                    text =
                        if letter /= "" && p.w >= len + 2 then
                            digits ++ " " ++ letter

                        else
                            digits

                    col =
                        if newer then
                            p.x + (p.w - String.count text) // 2

                        else
                            p.x + p.w // 2 - String.count text // 2
                in
                [ { row = p.y + p.h // 2, col = col, color = ink, text = text } ]
                    ++ (if newer && p.h > 1 then
                            size

                        else
                            []
                       )

            else
                let
                    px =
                        if newer then
                            p.x + (p.w - (len * 6 - 1)) // 2

                        else
                            p.x + p.w // 2 - len * 3

                    py =
                        if newer then
                            p.y + (p.h - 5) // 2

                        else
                            p.y + p.h // 2 - 2

                    cells =
                        String.toArray digits
                            |> Array.indexedMap
                                (\i c ->
                                    bigDigit c
                                        |> Array.indexedMap
                                            (\r line ->
                                                String.toArray line
                                                    |> Array.indexedMap (\col bit -> { row = py + r, col = px + i * 6 + col, on = bit == '1' })
                                                    |> Array.keepIf .on
                                            )
                                        |> Array.flatten
                                )
                            |> Array.flatten
                            |> Array.map (\cell -> { row = cell.row, col = cell.col, color = block, text = " " })

                    letterCell =
                        if letter == "" || p.h <= 6 then
                            []

                        else
                            [ { row = py + 5, col = px + len * 6 - 2, color = ink, text = letter } ]
                in
                cells
                    ++ (if p.h > 6 then
                            size

                        else
                            []
                       )
                    ++ (if tmuxLook then
                            letterCell

                        else
                            []
                       )


{-| tmux's digits, five rows of five (`window-clock.c`). -}
bigDigit : Char -> Array String
bigDigit c =
    when c is
        '0' ->
            [ "11111", "10001", "10001", "10001", "11111" ]

        '1' ->
            [ "00001", "00001", "00001", "00001", "00001" ]

        '2' ->
            [ "11111", "00001", "11111", "10000", "11111" ]

        '3' ->
            [ "11111", "00001", "11111", "00001", "11111" ]

        '4' ->
            [ "10001", "10001", "11111", "00001", "00001" ]

        '5' ->
            [ "11111", "10000", "11111", "00001", "11111" ]

        '6' ->
            [ "11111", "10000", "11111", "10001", "11111" ]

        '7' ->
            [ "11111", "00001", "00001", "00001", "00001" ]

        '8' ->
            [ "11111", "10001", "11111", "10001", "11111" ]

        '9' ->
            [ "11111", "10001", "11111", "00001", "11111" ]

        ':' ->
            [ "00000", "00100", "00000", "00100", "00000" ]

        'A' ->
            [ "11111", "10001", "11111", "10001", "10001" ]

        'P' ->
            [ "11111", "10001", "11111", "10000", "10000" ]

        'M' ->
            [ "10001", "11011", "10101", "10001", "10001" ]

        _ ->
            []


-- DISPLAY-POPUP (TM56)


{-| A `display-popup` binding, which a control client is not shown: on
tmux 3.8, a modal floating pane in its place (`new-pane -O`), its size,
place, directory and command, and its title (`-T`) as the pane's own
border format, drawn on its box (TM82; not its pane title, which the
status line shows); kept after its command ends, until a key, unless `-E`
says to close (`-k`). Before 3.8 there are no floating
panes, and puritty says so. -}
openPopup : Context -> { width : String, height : String, x : String, y : String, title : String, dir : String, close : Bool, command : String, after : String } -> (taken s : State) -> { state : State, commands : Array String }
openPopup ctx pop s =
    let
        winW =
            s.canvas.cols

        winH =
            max 1 (s.canvas.rows - statusRows s)

        -- a size as new-pane takes it, and in cells for placing it
        cells size whole =
            if String.endsWith "%" size then
                Maybe.withDefault (meant Reason.FromOutside 50) (String.toInt (String.dropLast 1 size)) * whole // 100

            else
                Maybe.withDefault (meant Reason.FromOutside whole // 2) (String.toInt size)

        -- `C` (the middle) or anything puritty does not place: centered
        place given size whole =
            if String.endsWith "%" given || String.toInt given /= Nothing then
                given

            else if String.endsWith "%" size then
                String.fromInt ((100 - Maybe.withDefault (meant Reason.FromOutside 50) (String.toInt (String.dropLast 1 size))) // 2) ++ "%"

            else
                String.fromInt (max 0 ((whole - cells size whole) // 2))

        command =
            Command.popup
                { keep = not pop.close
                , pane = "%" ++ String.fromInt ctx.pane
                , width = pop.width
                , height = pop.height
                , x = place pop.x pop.width winW
                , y = place pop.y pop.height winH
                , dir = pop.dir
                , command = pop.command
                }

        -- the popup's colors given to its pane as its own options, which
        -- tmux and puritty both draw it by (popup-style and
        -- popup-border-style, 3.8's defaults dark grey, TM66): the new
        -- pane is the current one for the commands after it on the line
        styled =
            [ Command.setPaneFormat "window-style" "#{popup-style}"
            , Command.setPaneFormat "window-active-style" "#{popup-style}"
            , Command.setPaneFormat "pane-border-style" "#{popup-border-style}"
            , Command.setPaneFormat "pane-active-border-style" "#{popup-border-style}"
            ]
                ++ (if pop.title == "" then
                        []

                    else
                        -- `-T`: the title on the box's top line, as tmux 3.8
                        -- draws a floating pane's with these set on it, a
                        -- cell further in than a popup's (TM82); kept as a
                        -- format, expanded once as tmux draws it, not
                        -- expanded here and again there (TM121)
                        [ Command.setPaneFormatUnexpanded "pane-border-format" pop.title
                        , Command.setPaneFormat "pane-border-status" "top"
                        ]
                   )

        opened =
            if s.version == 0 || s.version >= 38 then
                let
                    asked =
                        expectedLine (Array.pushFirst { command = command, expect = ForRan } (Array.map (\c -> { command = c, expect = ForNothing }) styled)) { s | said = "" }
                in
                { state = asked, commands = [ String.join " ; " (Array.pushFirst command styled) ] }

            else
                { state = { s | said = "puritty: display-popup under tmux -CC needs tmux 3.8's floating panes" }, commands = [] }

        ran =
            runLine ctx pop.after opened.state
    in
    { state = ran.state, commands = opened.commands ++ ran.commands }


-- CHOOSE-BUFFER AND CHOOSE-CLIENT (TM55)


{-| A list opened for a `choose-buffer` or `choose-client` binding. -}
openListing : Context -> { kind : String, filter : String, zoom : Bool, template : String, after : String } -> (taken s : State) -> { state : State, commands : Array String }
openListing ctx l s =
    let
        opened =
            sendAsking
                ([ listQuery s.version l.kind ]
                    ++ (if l.filter == "" then
                            []

                        else
                            [ listFilterQuery l.kind l.filter ]
                       )
                )
                { s
                    | said = ""
                    , listing =
                        Just
                            { kind = l.kind
                            , rows = []
                            , loaded = False
                            , selected = 0
                            , tagged = []
                            , sort = 0
                            , reversed = False
                            , previewMode = 1
                            , preview = { name = "", lines = [] }
                            , filter = l.filter
                            , passing = Nothing
                            , noMatches = False
                            , search = ""
                            , template = l.template
                            , zoom = l.zoom
                            , pane = ctx.pane
                            , contents = Dict.empty
                            }
                }

        ran =
            runLine ctx l.after opened.state
    in
    { state = ran.state, commands = opened.commands ++ ran.commands }


{-| The list's rows asked of tmux, with tmux's own text for each
(`window-buffer.c`, `window-client.c`); fields split at tabs. -}
listQuery : Int -> String -> { command : String, expect : Expect }
listQuery version kind =
    let
        -- each row's text as this tmux's own list words it
        -- (`WINDOW_BUFFER_DEFAULT_FORMAT`, `WINDOW_CLIENT_DEFAULT_FORMAT`):
        -- `t/p:` is from 3.2, and before it a row is its size and its whole
        -- time (2.7's and 3.0's window-buffer.c and window-client.c; the
        -- code review's TB8)
        since32 =
            version == 0 || version >= 32
    in
    if kind == "buffer" then
        { command =
            Command.listBuffers
                ("L\t#{buffer_name}\t#{buffer_created}\t#{buffer_size}\t0\t"
                    ++ (if since32 then
                            "#{t/p:buffer_created}: #{buffer_sample}"

                        else
                            "#{buffer_size} bytes (#{t:buffer_created})"
                       )
                    ++ "\t0"
                )
        , expect = ForListRows
        }

    else
        { command =
            Command.listClients
                ("L\t#{client_name}\t#{client_created}\t#{client_width}\t#{client_activity}\t"
                    ++ (if since32 then
                            "#{t/p:client_activity}: session #{session_name}"

                        else
                            "session #{session_name} (#{client_width}x#{client_height}, #{t:client_activity})"
                       )
                    ++ "\t#{client_control_mode}"
                )
        , expect = ForListRows
        }


listFilterQuery : String -> String -> { command : String, expect : Expect }
listFilterQuery kind filter =
    if kind == "buffer" then
        { command = Command.listBuffers ("F\t#{buffer_name}\t" ++ filter), expect = ForListFilter }

    else
        { command = Command.listClients ("F\t#{client_name}\t" ++ filter), expect = ForListFilter }


{-| The rows the filter keeps, in the list's order: buffers newest first,
by name or largest first (`window_buffer_cmp`), the name breaking ties;
clients by name, width, when made or most recently active
(`window_client_sort_list`). -}
listRows : (l : Listing) -> (r : Array ListRow where Array.length r <= Array.length l.rows)
listRows l =
    let
        keptRows =
            when l.passing is
                Just names ->
                    Array.keepIf (\r -> Array.member r.name names) l.rows

                Nothing ->
                    meant Reason.NotOpen l.rows

        flip o =
            if l.reversed then
                when o is
                    LT ->
                        GT

                    GT ->
                        LT

                    EQ ->
                        EQ

            else
                o

        thenName o a b =
            if o == EQ then
                compare a.name b.name

            else
                o

        order a b =
            if l.kind == "buffer" then
                if l.sort == 1 then
                    compare a.name b.name

                else if l.sort == 2 then
                    thenName (compare b.size a.size) a b

                else
                    compare a.seq b.seq

            else if l.sort == 1 then
                thenName (compare b.size a.size) a b

            else if l.sort == 2 then
                thenName (compare a.created b.created) a b

            else if l.sort == 3 then
                thenName (compare b.activity a.activity) a b

            else
                compare a.name b.name
    in
    Array.sortWith (\a b -> flip (order a b)) keptRows


listSortNames : Int -> String -> (r : Array String where 3 <= Array.length r)
listSortNames version kind =
    if kind == "buffer" then
        [ if version >= 38 then
            "creation"

          else
            "time"
        , "name"
        , "size"
        ]

    else
        [ "name", "size", "creation", "activity" ]


{-| The chosen row's buffer asked for the preview, when it is not the one
shown; a client's list has none. -}
listPreviewAsk : (taken s : State) -> { state : State, commands : Array String }
listPreviewAsk s =
    when s.listing is
        Just l ->
            when Array.get l.selected (listRows l) is
                Just r ->
                    if l.kind == "buffer" && r.name /= l.preview.name then
                        sendAsking [ { command = Command.showBuffer r.name, expect = ForListPreview r.name } ] { s | listing = Just { l | preview = { name = r.name, lines = [] } } }

                    else
                        { state = s, commands = [] }

                Nothing ->
                    meant Reason.OutOfRange { state = s, commands = [] }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


listPreviewAfter : (taken r0 : { state : State, commands : Array String }) -> { state : State, commands : Array String }
listPreviewAfter r0 =
    let
        r =
            listPreviewAsk r0.state
    in
    { state = r.state, commands = r0.commands ++ r.commands }


{-| Commands run on the list's rows, and the rows asked again, the chosen
name kept where it still is. -}
listRun : Array String -> Listing -> (taken s : State) -> { state : State, commands : Array String }
listRun commands l s =
    sendAsking
        (Array.map (\c -> { command = c, expect = ForRan }) commands
            ++ [ listQuery s.version l.kind ]
            ++ (if l.filter == "" then
                    []

                else
                    [ listFilterQuery l.kind l.filter ]
               )
        )
        { s | listing = Just { l | tagged = [] } }


{-| A key while a list is shown, as `mode_tree_key`, `window_buffer_key`
and `window_client_key` take it (TM55). -}
listKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Listing -> (taken s : State) -> { state : State, commands : Array String }
listKey k l s =
    let
        name =
            Maybe.withDefault (meant Reason.NotKnown "") (lookupName k)

        rows =
            listRows l

        count =
            Array.length rows

        at =
            Array.get l.selected rows

        moved i st =
            { state = { st | listing = Just { l | selected = clamp 0 (max 0 (count - 1)) i } }, commands = [] }

        targets =
            l.tagged

        buffer =
            l.kind == "buffer"

        chosen r st =
            runLine { pane = l.pane, mouse = Nothing } (Syntax.fill (Syntax.tokens l.template) [ r.name ]) { st | listing = Nothing }
    in
    if name == "q" || name == "Escape" || name == "C-g" then
        { state = { s | listing = Nothing }, commands = [] }

    else if name == "Up" || name == "k" || name == "C-p" then
        moved
            (if l.selected == 0 then
                count - 1

             else
                l.selected - 1
            )
            s

    else if name == "Down" || name == "j" || name == "C-n" then
        moved
            (if l.selected >= count - 1 then
                0

             else
                l.selected + 1
            )
            s

    else if name == "PPage" || name == "C-b" then
        moved (l.selected - 10) s

    else if name == "NPage" || name == "C-f" then
        moved
            (if l.selected >= count - 10 then
                count - 1

             else
                l.selected + 10
            )
            s

    else if name == "Home" || name == "g" then
        moved 0 s

    else if name == "End" || name == "G" then
        moved (count - 1) s

    else if name == "t" then
        when at is
            Just r ->
                { state =
                    { s
                        | listing =
                            Just
                                { l
                                    | tagged =
                                        if Array.member r.name l.tagged then
                                            Array.keepIf (\x -> x /= r.name) l.tagged

                                        else
                                            Array.pushLast r.name l.tagged
                                    , selected = min (count - 1) (l.selected + 1)
                                }
                    }
                , commands = []
                }

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if name == "T" then
        { state = { s | listing = Just { l | tagged = [] } }, commands = [] }

    else if name == "C-t" then
        { state = { s | listing = Just { l | tagged = Array.map .name rows } }, commands = [] }

    else if name == "O" then
        { state = { s | listing = Just { l | sort = modBy (Array.length (listSortNames s.version l.kind)) (l.sort + 1) } }, commands = [] }

    else if name == "r" then
        { state = { s | listing = Just { l | reversed = not l.reversed } }, commands = [] }

    else if name == "v" then
        { state =
            { s
                | listing =
                    Just
                        { l
                            | previewMode =
                                if l.previewMode == 0 then
                                    2

                                else if l.previewMode == 1 then
                                    0

                                else
                                    1
                        }
            }
        , commands = []
        }

    else if name == "/" || name == "?" || name == "C-s" then
        { state = { s | asking = Just (treePrompt s.version 11 "(search) " "") }, commands = [] }

    else if name == "n" then
        searchOrAsk True l s

    else if name == "N" then
        searchOrAsk False l s

    else if name == "f" then
        { state = { s | asking = Just (treePrompt s.version 12 "(filter) " l.filter) }, commands = [] }

    else if name == "Enter" || name == "KPEnter" || name == "C-m" || (buffer && name == "p") then
        when at is
            Just r ->
                chosen r s

            Nothing ->
                meant Reason.OutOfRange { state = { s | listing = Nothing }, commands = [] }

    else if buffer && name == "P" then
        listRun (Array.map (\t -> Syntax.fill (Syntax.tokens l.template) [ t ]) targets) l s

    else if buffer && name == "e" then
        -- tmux edits a buffer in an editor popup on its client's terminal,
        -- which a control client has not (Gilbert, 2026-11-15: no editor
        -- of puritty's own for now, TM80)
        { state = { s | said = "puritty: e (edit in an editor) is not done under tmux -CC" }, commands = [] }

    else if buffer && name == "d" then
        when at is
            Just r ->
                listRun [ Command.deleteBuffer r.name ] l s

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if buffer && name == "D" then
        listRun (Array.map Command.deleteBuffer targets) l s

    else if not buffer && (name == "d" || name == "x" || name == "z") then
        when at is
            Just r ->
                -- a control client suspended takes no key again (TM24):
                -- puritty's own among them
                if name == "z" && r.control then
                    { state = { s | said = "puritty: a control-mode client is not suspended" }, commands = [] }

                else
                    listRun [ clientCommand name r.name ] l s

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if not buffer && (name == "D" || name == "X" || name == "Z") then
        listRun
            (Array.map (\t -> clientCommand (String.toLower name) t)
                (if name == "Z" then
                    Array.keepIf (\t -> not (Array.any (\r -> r.name == t && r.control) rows)) targets

                 else
                    targets
                )
            )
            l
            s

    else
        when Array.findFirst (\i -> treeRowKey i == Just name) (Array.range 0 (min count 36 - 1)) is
            Just found ->
                chosen (Array.getProven found.value rows) s

            Nothing ->
                meant Reason.NotKnown { state = s, commands = [] }


{-| A client's key's command, as `window_client_do_detach`: `d` detach, `x`
detach and kill its shell (`-P`), `z` suspend. -}
clientCommand : String -> String -> String
clientCommand key client =
    if key == "x" then
        Command.detachClient True client

    else if key == "z" then
        Command.suspendClient client

    else
        Command.detachClient False client


{-| The next row whose name or text holds the search, from the one after
the chosen round: a buffer's name or its whole text, as tmux's
`window_buffer_search` (TM81), a client's name or text; from 3.6 case
ignored when the search has no capitals, before it never (`mode-tree.c`'s
`search_icase`). -}
searchListing : Int -> Bool -> Listing -> Listing
searchListing version forward l =
    let
        rows =
            listRows l

        n =
            Array.length rows

        caseless =
            (version == 0 || version >= 36) && String.toLower l.search == l.search

        holds hay =
            if caseless then
                String.contains l.search (String.toLower hay)

            else
                String.contains l.search hay

        matches r =
            holds r.name
                || (if l.kind == "buffer" then
                        holds (Maybe.withDefault (meant Reason.NotYet r.text) (Dict.get r.name l.contents))

                    else
                        holds r.text
                   )

        order =
            Array.range 1 n
                |> Array.map
                    (\k ->
                        if forward then
                            modBy n (l.selected + k)

                        else
                            modBy n (l.selected - k + n)
                    )
    in
    if l.search == "" || n == 0 then
        l

    else
        when Array.findFirst (\i -> Maybe.map matches (Array.get i rows) == Just True) order is
            Just found ->
                -- a row of the rows shown, which are no more than the rows
                { l | selected = clamp 0 (max 0 (Array.length l.rows - 1)) found.value }

            Nothing ->
                meant Reason.NoMore l


{-| The buffers whose whole text is not yet in (TM81). -}
missingContents : Listing -> Array String
missingContents l =
    if l.kind == "buffer" then
        l.rows |> Array.map .name |> Array.keepIf (\name -> not (Dict.member name l.contents))

    else
        []


{-| A search made, a buffer list's after asking tmux for the text of each
buffer not yet in, as tmux searches it (TM81). -}
searchOrAsk : Bool -> Listing -> (taken s : State) -> { state : State, commands : Array String }
searchOrAsk forward l s =
    when missingContents l is
        [] ->
            listPreviewAsk { s | listing = Just (searchListing s.version forward l) }

        missing ->
            sendAsking (Array.map (\name -> { command = Command.showBuffer name, expect = ForListContent name }) missing) { s | listing = Just l }


{-| The list's own questions answered: a search (11) or a filter (12). -}
listAnswered : Int -> String -> (taken s : State) -> { state : State, commands : Array String }
listAnswered purpose given s =
    when s.listing is
        Just l ->
            if purpose == 11 then
                searchOrAsk True { l | search = given } s

            else if given == "" then
                { state = { s | listing = Just { l | filter = "", passing = Nothing, noMatches = False } }, commands = [] }

            else
                sendAsking [ listFilterQuery l.kind given ] { s | listing = Just { l | filter = given } }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


{-| The list's cells, as tmux's mode tree draws a flat list (TM55): each
row's key, name and text, the chosen one in mode-style, tagged ones with a
`*`; below, the preview's box with the chosen name and order, and a
buffer's first lines. -}
drawListing : Colors -> Bool -> Int -> Layout.Pane -> Listing -> Array { row : Int, col : Int, color : String, text : String }
drawListing colors tmuxLook version place l =
    let
        rows =
            listRows l

        sy =
            place.h

        lineCount =
            Array.length rows

        listHeight =
            modeListHeight l.previewMode sy lineCount

        keyWidth =
            if lineCount > 10 then
                3

            else
                1

        -- the selection and the height clamped to what a screen can show,
        -- which says to the compiler that the sums cannot wrap
        selectedAt =
            clamp 0 2000000000 l.selected

        shownHeight =
            clamp 0 1000000 listHeight

        top =
            if selectedAt < shownHeight then
                0

            else
                selectedAt - shownHeight + 1

        chosenName =
            Array.get l.selected rows |> Maybe.map .name |> Maybe.withDefault (meant Reason.OutOfRange "")

        -- the order's name; read around, as the key steps it, should
        -- tmux's version change its list (TM77)
        sortName =
            let
                names =
                    listSortNames version l.kind
            in
            Array.getProven (modBy (Array.length names) l.sort) names

        plainInk =
            if tmuxLook then
                "\u{001B}[0m"

            else
                viewTextColor

        listed =
            Array.dropFirst top rows
                |> Array.takeFirst listHeight
                |> Array.indexedMap
                    (\j r ->
                        let
                            i =
                                top + j

                            key =
                                when treeRowKey i is
                                    Just k ->
                                        String.padRight (keyWidth + 2) ' ' ("(" ++ k ++ ")") ++ " "

                                    Nothing ->
                                        meant Reason.OutOfRange String.repeat (keyWidth + 3) " "

                            tag =
                                if Array.member r.name l.tagged then
                                    "*"

                                else
                                    ""
                        in
                        { row = place.y + j
                        , col = place.x
                        , color =
                            if i == l.selected then
                                (if tmuxLook then
                                    colors.mode

                                 else
                                    activeTabColor
                                )

                            else
                                plainInk
                        , text = String.padRight place.w ' ' (String.takeFirst place.w (key ++ r.name ++ tag ++ ": " ++ r.text))
                        }
                    )

        boxRow =
            place.y + listHeight

        boxH =
            sy - listHeight

        inner =
            place.w - 2

        heading =
            let
                t =
                    " "
                        ++ chosenName
                        ++ " (sort: "
                        ++ sortName
                        ++ (if l.reversed then
                                ", reversed"

                            else
                                ""
                           )
                        ++ ")"

                note =
                    if l.filter /= "" then
                        " (filter: "
                            ++ (if l.noMatches then
                                    "no matches"

                                else
                                    "active"
                               )
                            ++ ") "

                    else
                        " "
            in
            if String.count t <= inner then
                String.takeFirst inner (t ++ note)

            else
                ""

        box =
            if boxH < 3 || listHeight >= sy then
                []

            else
                [ { row = boxRow, col = place.x, color = plainInk, text = "┌" ++ String.repeat inner "─" ++ "┐" }
                , { row = boxRow, col = place.x + 1, color = plainInk, text = heading }
                ]
                    ++ (Array.range 1 (boxH - 2) |> Array.map (\r -> { row = boxRow + r, col = place.x, color = plainInk, text = "│" ++ String.repeat inner " " ++ "│" }))
                    ++ [ { row = boxRow + boxH - 1, col = place.x, color = plainInk, text = "└" ++ String.repeat inner "─" ++ "┘" } ]
                    ++ (Array.takeFirst (boxH - 2) l.preview.lines
                            |> Array.indexedMap (\j line -> { row = boxRow + 1 + j, col = place.x + 2, color = plainInk, text = clipCells (max 0 (place.w - 4)) (shownLine (aboutCells (max 0 (place.w - 4)) line)) })
                       )
    in
    (Array.range 0 (place.h - 1) |> Array.map (\r -> { row = place.y + r, col = place.x, color = plainInk, text = String.repeat place.w " " }))
        ++ listed
        ++ box


-- CUSTOMIZE-MODE (TM62)


{-| customize-mode shown by puritty (TM62): the version's table (what no
command reports), what tmux said and how many of the answers asked for are
in, the raw answers 3.6's keys and the environment are read from together,
what is shown, the chosen row's place, its details, the question asked,
whether yes-or-no questions are answered yes at once (`-y`), the pane it
was opened in and whether it covers every pane (`-Z`). -}
type alias Customizing =
    { table : Customize.Table
    , data : Customize.Data
    , loaded : Int
    , asked : Int
    , envRaw : Dict Int (Array String)
    , keysRaw : Array String
    , notesRaw : Dict String (Array String)
    , view : Customize.View
    , at : Int
    , detail : Maybe Customize.Detail
    , prompt : Maybe Customize.Prompt
    , yes : Bool
    , pane : Int
    , zoom : Bool
    }


{-| customize-mode opened, from a binding, the command prompt or
puritty's menu: everything asked of tmux, then the commands after it. -}
openCustomize : Context -> { filter : String, zoom : Bool, noPreview : Bool, yes : Bool, after : String } -> (taken s : State) -> { state : State, commands : Array String }
openCustomize ctx o s =
    let
        start =
            Customize.startView

        data0 =
            Customize.emptyData

        c =
            { table = Customize.table s.version
            , data = { data0 | paneId = "%" ++ String.fromInt ctx.pane }
            , loaded = 0
            , asked = 0
            , envRaw = Dict.empty
            , keysRaw = []
            , notesRaw = Dict.empty
            , view =
                { start
                    | preview =
                        if o.noPreview then
                            0

                        else
                            1
                    , filter = o.filter
                }
            , at = 0
            , detail = Nothing
            , prompt = Nothing
            , yes = o.yes
            , pane = ctx.pane
            , zoom = o.zoom
            }

        opened =
            customizeAsk [] c { s | said = "" }

        ran =
            runLine ctx o.after opened.state
    in
    { state = ran.state, commands = opened.commands ++ ran.commands }


{-| customize-mode opened from puritty's menu (TM62): on the active pane,
over every pane, as `prefix C` opens it. -}
customize : (taken s : State) -> { state : State, commands : Array String }
customize s =
    let
        pane =
            s.active
    in
    openCustomize { pane = pane, mouse = Nothing } { filter = "", zoom = True, noPreview = False, yes = False, after = "" } s


{-| Commands sent, then everything asked of tmux again: where the pane
is, each level's options and hooks (`-H`), the environment and its
hidden variables, and the keys (3.7's `list-keys -F`, 3.6's text). A
filter is asked again when the answers are in. -}
customizeAsk : Array String -> Customizing -> (taken s : State) -> { state : State, commands : Array String }
customizeAsk commands c s =
    let
        p =
            c.data.paneId

        -- whether list-keys gives its format (3.7), from what tmux takes
        newer =
            Caps.has "list-keys" "F" s.caps

        queries =
            [ { command = Command.displayAt p "#{pane_index}\t#{window_index}\t#{session_name}", expect = ForCustomize 0 }
            , { command = Command.showOptions "s" p, expect = ForCustomize 1 }
            , { command = Command.showOptions "g" p, expect = ForCustomize 2 }
            , { command = Command.showOptions "t" p, expect = ForCustomize 3 }
            , { command = Command.showOptions "gw" p, expect = ForCustomize 4 }
            , { command = Command.showOptions "wt" p, expect = ForCustomize 5 }
            , { command = Command.showOptions "pt" p, expect = ForCustomize 6 }
            , { command = Command.showEnvironment "g" p, expect = ForCustomize 7 }
            , { command = Command.showEnvironment "gh" p, expect = ForCustomize 8 }
            , { command = Command.showEnvironment "t" p, expect = ForCustomize 9 }
            , { command = Command.showEnvironment "th" p, expect = ForCustomize 10 }
            , { command =
                    if newer then
                        Command.listKeysFormat Customize.keyFormat

                    else
                        Command.listKeys
              , expect = ForCustomize 11
              }
            ]
    in
    sendAsking
        (Array.map (\command -> { command = command, expect = ForRan }) commands ++ queries)
        { s
            | customizing =
                Just
                    { c
                        | loaded = 0
                        , asked = Array.length queries
                        , notesRaw =
                            if newer then
                                c.notesRaw

                            else
                                Dict.empty
                    }
        }


{-| An answer about the mode's rows taken in: where the pane is, a level's
options, the environment, the keys; 3.6's keys ask for each table's notes.
When all are in, the chosen row is found again and its details asked. -}
customizeGot : Int -> Array String -> (taken s : State) -> { state : State, commands : Array String }
customizeGot part text s =
    when s.customizing is
        Just c ->
            let
                d =
                    c.data

                -- as `customizeAsk` asked: by what tmux takes (TB7)
                newer =
                    Caps.has "list-keys" "F" s.caps

                envRaw =
                    if part >= 7 && part <= 10 then
                        Dict.set part text c.envRaw

                    else
                        c.envRaw

                envOf a b =
                    Customize.envOf (Maybe.withDefault (meant Reason.NotYet []) (Dict.get a envRaw)) (Maybe.withDefault (meant Reason.NotYet []) (Dict.get b envRaw))

                data =
                    if part == 0 then
                        when Array.first text |> Maybe.map (String.split "\t") is
                            Just [ paneIndex, windowIndex, sessionName ] ->
                                { d | paneIndex = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt paneIndex), windowIndex = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt windowIndex), sessionName = sessionName }

                            _ ->
                                meant Reason.FromOutside d

                    else if part == 1 then
                        { d | server = Customize.optionsOf text }

                    else if part == 2 then
                        { d | globalSession = Customize.optionsOf text }

                    else if part == 3 then
                        { d | session = Customize.optionsOf text }

                    else if part == 4 then
                        { d | globalWindow = Customize.optionsOf text }

                    else if part == 5 then
                        { d | window = Customize.optionsOf text }

                    else if part == 6 then
                        { d | pane = Customize.optionsOf text }

                    else if part >= 7 && part <= 10 then
                        { d | globalEnv = envOf 7 8, sessionEnv = envOf 9 10 }

                    else if part == 11 && newer then
                        { d | keys = Customize.bindingsOfFormat text }

                    else if part == 11 then
                        { d | keys = Customize.bindingsOfText text c.notesRaw }

                    else
                        d

                -- 3.6's notes, a table at a time
                tables =
                    if part == 11 && not newer then
                        Array.foldl
                            (\b acc ->
                                if Array.member b.table acc then
                                    acc

                                else
                                    Array.pushLast b.table acc
                            )
                            []
                            data.keys

                    else
                        []

                updated =
                    { c
                        | data = data
                        , envRaw = envRaw
                        , keysRaw =
                            if part == 11 then
                                text

                            else
                                c.keysRaw
                        , loaded = c.loaded + 1
                        , asked = c.asked + Array.length tables
                    }

                notes =
                    sendAsking
                        (Array.map (\t -> { command = Command.listKeysNotes t, expect = ForCustomizeNotes t }) tables)
                        { s | customizing = Just updated }
            in
            customizeSettled notes

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


{-| 3.6's notes for a table taken in, its keys read again with them. -}
customizeNotes : String -> Array String -> (taken s : State) -> { state : State, commands : Array String }
customizeNotes tableName text s =
    when s.customizing is
        Just c ->
            let
                notesRaw =
                    Dict.set tableName text c.notesRaw

                d =
                    c.data
            in
            customizeSettled { state = { s | customizing = Just { c | notesRaw = notesRaw, data = { d | keys = Customize.bindingsOfText c.keysRaw notesRaw }, loaded = c.loaded + 1 } }, commands = [] }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


{-| Once every answer is in: the filter asked again if there is one, the
chosen row found again by its id, or the row at its place
(`mode_tree_set_current`), and its details asked. -}
customizeSettled : (taken r0 : { state : State, commands : Array String }) -> { state : State, commands : Array String }
customizeSettled r0 =
    let
        s =
            r0.state
    in
    when s.customizing is
        Just c ->
            if c.loaded < c.asked then
                { state = s, commands = r0.commands }

            else if c.view.filter /= "" && c.view.passing == Nothing && not c.view.noMatches then
                let
                    asked =
                        customizeFilterAsk c s
                in
                { state = asked.state, commands = r0.commands ++ asked.commands }

            else
                let
                    placed =
                        customizePlaced (customizeHeight s c) c

                    detailed =
                        customizeDetailAsk { s | customizing = Just placed }
                in
                { state = detailed.state, commands = r0.commands ++ detailed.commands }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = r0.commands }


{-| The rows of the tree, and those shown. -}
customizeShown : Customizing -> { all : Array Customize.Entry, shown : Array Customize.Line }
customizeShown c =
    let
        all =
            Customize.entries c.table c.data { hideGlobal = c.view.hideGlobal, changedOnly = c.view.changedOnly, passing = c.view.passing }
    in
    { all = all, shown = Customize.lines c.view all }


{-| The chosen row kept: by its id where it still is, else at its place
(`mode_tree_set_current`). -}
customizePlaced : Int -> Customizing -> Customizing
customizePlaced height c =
    let
        shown =
            (customizeShown c).shown

        count =
            Array.length shown

        at =
            when Array.findFirst (\l -> l.entry.id == c.view.current) shown is
                Just found ->
                    found.index

                Nothing ->
                    meant Reason.NotKnown clamp 0 (max 0 (count - 1)) c.at
    in
    customizeAt height at c.view.offset c


{-| The row at a place chosen, and the top row shown moved only as far as
it must be for the row to be shown (`mode_tree_check_selected`). -}
customizeAt : Int -> Int -> Int -> Customizing -> Customizing
customizeAt height at offset0 c =
    let
        shown =
            (customizeShown c).shown

        count =
            Array.length shown

        h =
            max 1 height

        bounded =
            if count <= h then
                0

            else
                min offset0 (count - h)

        offset =
            if at < bounded then
                at

            else if at > bounded + h - 1 then
                at - h + 1

            else
                bounded

        v =
            c.view
    in
    { c | at = at, view = { v | current = Array.get at shown |> Maybe.map (\l -> l.entry.id) |> Maybe.withDefault (meant Reason.OutOfRange ""), offset = max 0 offset } }


{-| The list's height where customize-mode is drawn, for its scrolling. -}
customizeHeight : State -> Customizing -> Int
customizeHeight s c =
    customizeArea s c
        |> Maybe.map
            (\a ->
                customizeListHeight c.view.preview
                    (if s.lookTmux then
                        max 0 a.h

                     else if a.h > 2 then
                        a.h - 2

                     else
                        0
                    )
            )
        |> Maybe.withDefault (meant Reason.Gone 10)


{-| The filter asked of tmux (`f`): each option's, key's and variable's
row answered `1` or `0` by one `list-panes` (TM122). -}
customizeFilterAsk : Customizing -> (taken s : State) -> { state : State, commands : Array String }
customizeFilterAsk c s =
    let
        rows =
            Customize.entries c.table c.data { hideGlobal = c.view.hideGlobal, changedOnly = c.view.changedOnly, passing = Nothing }
                |> Array.keepIf
                    (\e ->
                        when e.target is
                            Customize.Option o ->
                                o.key == Nothing

                            Customize.Key k ->
                                k.part == ""

                            Customize.Variable _ ->
                                True

                            Customize.Section _ ->
                                False
                    )
    in
    sendAsking
        [ { command = Customize.filterQuery c.table c.data c.view.filter rows
          , expect = ForCustomizeFilter { filter = c.view.filter, ids = Array.map .id rows }
          }
        ]
        { s | customizing = Just c }


{-| The filter's answers: the rows it keeps, or that it keeps none, when
tmux shows every row and says so (`mode_tree_build`). -}
customizeFiltered : { filter : String, ids : Array String } -> Bool -> Array String -> (taken s : State) -> { state : State, commands : Array String }
customizeFiltered f ok text s =
    when s.customizing is
        Just c ->
            if c.view.filter /= f.filter then
                { state = s, commands = [] }

            else
                let
                    answers =
                        Customize.filterAnswers text |> String.toArray

                    keptIds =
                        Array.indexedMap
                            (\i id ->
                                if Array.get i answers == Just '1' then
                                    Just id

                                else
                                    Nothing
                            )
                            f.ids
                            |> Array.mapAndKeepJust identity

                    none =
                        not ok || Array.isEmpty keptIds

                    v =
                        c.view
                in
                customizeSettled
                    { state =
                        { s
                            | customizing =
                                Just
                                    { c
                                        | view =
                                            { v
                                                | passing =
                                                    if none then
                                                        Nothing

                                                    else
                                                        Just keptIds
                                                , noMatches = none
                                            }
                                    }
                        }
                    , commands = []
                    }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


{-| The chosen row's details asked of tmux, when it is not the row they are
for: what an option's value expands to (a string's with `#`), and a hook's
fires (3.8). -}
customizeDetailAsk : (taken s : State) -> { state : State, commands : Array String }
customizeDetailAsk s =
    when s.customizing is
        Just c ->
            let
                shown =
                    (customizeShown c).shown

                chosen =
                    Array.get c.at shown |> Maybe.map .entry

                same =
                    Maybe.map .id c.detail == Maybe.map .id chosen
            in
            when chosen is
                Just e ->
                    if same then
                        { state = s, commands = [] }

                    else
                        let
                            fresh =
                                { id = e.id, expanded = Nothing, fires = Nothing }
                        in
                        when e.target is
                            Customize.Option o ->
                                let
                                    info =
                                        Dict.get o.name c.table.infos

                                    held =
                                        Customize.optionValue c.data o

                                    expand =
                                        if (info == Nothing || Maybe.map .kind info == Just "string") && String.contains "#" held then
                                            [ { command = Command.displayAt c.data.paneId (String.replace "%" "%%" held), expect = ForCustomizeDetail { id = e.id, part = 0 } } ]

                                        else
                                            []

                                    fires =
                                        if Maybe.map .hook info == Just True && (s.version == 0 || s.version >= 38) && o.key == Nothing then
                                            [ { command = Command.showHooks o.scope c.data.paneId "#{hook_fire_count}\t#{hook_fire_time}\t#{t/p:hook_fire_time}" o.name, expect = ForCustomizeDetail { id = e.id, part = 1 } } ]

                                        else
                                            []
                                in
                                sendAsking (expand ++ fires) { s | customizing = Just { c | detail = Just fresh } }

                            _ ->
                                { state = { s | customizing = Just { c | detail = Just fresh } }, commands = [] }

                Nothing ->
                    meant Reason.OutOfRange { state = s, commands = [] }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


customizeDetailGot : { id : String, part : Int } -> Bool -> Array String -> (taken s : State) -> State
customizeDetailGot asked ok text s =
    when s.customizing is
        Just c ->
            when c.detail is
                Just d ->
                    if d.id /= asked.id || not ok then
                        s

                    else if asked.part == 0 then
                        { s | customizing = Just { c | detail = Just { d | expanded = Just (String.join "\n" text) } } }

                    else
                        when Array.first text |> Maybe.map (String.split "\t") is
                            Just [ count, when_, pretty ] ->
                                { s
                                    | customizing =
                                        Just
                                            { c
                                                | detail =
                                                    Just
                                                        { d
                                                            | fires =
                                                                Just
                                                                    { count = Maybe.withDefault (meant Reason.FromOutside 0) (String.toInt count)
                                                                    , last =
                                                                        if when_ == "" || when_ == "0" then
                                                                            ""

                                                                        else
                                                                            pretty
                                                                    }
                                                        }
                                            }
                                }

                            _ ->
                                meant Reason.FromOutside s

                Nothing ->
                    meant Reason.NotOpen s

        Nothing ->
            meant Reason.NotOpen s


{-| The list's height in the pane: all of it, or less the twelve rows of
the description (`window_customize_height`, `mode_tree_set_height`). -}
customizeListHeight : Int -> (sy : Int where 0 <= sy) -> (r : Int where 0 <= r && r <= sy)
customizeListHeight preview sy =
    let
        h =
            if preview == 0 then
                sy

            else if sy > 12 then
                sy - 12

            else
                sy
    in
    if sy - h < 2 then
        sy

    else
        h


{-| Where the mode is drawn: over every pane but the status line (`-Z`),
or in its pane. -}
customizeArea : State -> Customizing -> Maybe { x : Int, y : Int, w : Int, h : Int }
customizeArea s c =
    let
        statusLines =
            clamp 0 5 (statusRows s)

        cols =
            s.canvas.cols

        rows =
            s.canvas.rows
    in
    if c.zoom then
        Just
            { x = 0
            , y =
                if s.barTop then
                    statusLines

                else
                    0
            , w = cols
            , h = max 0 (rows - statusLines)
            }

    else
        when s.layout is
            Just cell ->
                placedPanes s cell (Layout.tiled cell ++ Layout.floating cell)
                    |> Array.findFirst (\p -> p.id == c.pane)
                    |> Maybe.map (\found -> { x = found.value.x, y = found.value.y, w = found.value.w, h = found.value.h })

            Nothing ->
                meant Reason.NotYet Nothing


{-| A key while customize-mode is shown, as `mode_tree_key` then
`window_customize_key` take it (TM62). -}
customizeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Customizing -> (taken s : State) -> { state : State, commands : Array String }
customizeKey k c s =
    let
        name =
            Maybe.withDefault (meant Reason.NotKnown "") (lookupName k)

        both =
            customizeShown c

        shown =
            both.shown

        count =
            Array.length shown

        listHeight =
            customizeHeight s c

        v =
            c.view

        line =
            Array.get c.at shown

        -- the row chosen, the top row kept so that it is shown
        moved at offset st =
            customizeDetailAsk { st | customizing = Just (customizeAt listHeight at offset c) }

        rebuilt c2 st =
            customizeDetailAsk { st | customizing = Just (customizePlaced listHeight c2) }

        withView v2 =
            { c | view = v2 }

        newer =
            s.version == 0 || s.version >= 38

        chosenKey =
            Array.findFirst (\i -> Customize.rowKey i == Just name) (Array.range 0 (min count 36 - 1))

        taggedTargets =
            Customize.visibleTagged v shown |> Array.map (\l -> l.entry.target)

        ancestorsOf id =
            let
                up current acc =
                    when Array.findFirst (\e -> e.id == current) both.all |> Maybe.map .value is
                        Just e ->
                            if e.parent == "" then
                                acc

                            else
                                up e.parent (Array.pushLast e.parent acc)

                        Nothing ->
                            meant Reason.NotKnown acc
            in
            up id []

        descendantsOf id =
            Array.keepIf (\e -> Array.member id (ancestorsOf e.id)) both.all |> Array.map .id
    in
    if c.loaded < c.asked && count == 0 then
        if name == "q" || name == "Escape" || name == "C-g" then
            { state = { s | customizing = Nothing }, commands = [] }

        else
            { state = s, commands = [] }

    else
        when chosenKey is
            Just found ->
                customizeAct "Enter" (customizeAt listHeight found.value v.offset c) s

            Nothing ->
                meant Reason.NotKnown
                    if name == "q" || name == "Escape" || name == "C-[" || name == "C-g" then
                        { state = { s | customizing = Nothing }, commands = [] }

                    else if name == "C-h" || name == "F1" then
                        { state = { s | view = Just (viewOf (Array.map Bytes.fromString Customize.help)) }, commands = [] }

                    else if name == "Up" || name == "k" || name == "C-p" then
                        if c.at == 0 then
                            moved (count - 1)
                                (if count >= listHeight then
                                    count - listHeight

                                 else
                                    0
                                )
                                s

                        else
                            moved (c.at - 1) v.offset s

                    else if name == "Down" || name == "j" || name == "C-n" then
                        if c.at >= count - 1 then
                            moved 0 0 s

                        else
                            moved (c.at + 1) v.offset s

                    else if name == "PPage" || name == "C-b" then
                        moved (max 0 (c.at - listHeight)) v.offset s

                    else if name == "NPage" || name == "C-f" then
                        moved (min (count - 1) (c.at + listHeight)) v.offset s

                    else if name == "g" || name == "Home" then
                        moved 0 0 s

                    else if name == "G" || name == "End" then
                        moved (count - 1)
                            (if count - 1 > listHeight - 1 then
                                count - listHeight

                             else
                                0
                            )
                            s

                    else if name == "t" then
                        when line is
                            Just l ->
                                if l.entry.noTag then
                                    { state = s, commands = [] }

                                else if Array.member l.entry.id v.tagged then
                                    { state = { s | customizing = Just (withView { v | tagged = Array.keepIf (\x -> x /= l.entry.id) v.tagged }) }, commands = [] }

                                else
                                    let
                                        linked =
                                            ancestorsOf l.entry.id ++ descendantsOf l.entry.id
                                    in
                                    { state = { s | customizing = Just (withView { v | tagged = Array.pushLast l.entry.id (Array.keepIf (\x -> not (Array.member x linked)) v.tagged) }) }, commands = [] }

                            Nothing ->
                                meant Reason.OutOfRange { state = s, commands = [] }

                    else if name == "T" then
                        { state = { s | customizing = Just (withView { v | tagged = [] }) }, commands = [] }

                    else if name == "C-t" then
                        let
                            noTagIds =
                                Array.keepIf .noTag both.all |> Array.map .id

                            all =
                                shown
                                    |> Array.keepIf (\l -> (l.entry.parent == "" && not l.entry.noTag) || (l.entry.parent /= "" && Array.member l.entry.parent noTagIds))
                                    |> Array.map (\l -> l.entry.id)
                        in
                        { state = { s | customizing = Just (withView { v | tagged = all }) }, commands = [] }

                    else if name == "Left" || name == "h" || name == "-" then
                        when line is
                            Just l ->
                                if l.entry.flat || not l.expanded then
                                    if l.entry.parent == "" then
                                        if c.at == 0 then
                                            { state = s, commands = [] }

                                        else
                                            moved (c.at - 1) v.offset s

                                    else
                                        rebuilt (withView { v | open = Dict.set l.entry.parent False v.open, current = l.entry.parent }) s

                                else
                                    rebuilt (withView { v | open = Dict.set l.entry.id False v.open }) s

                            Nothing ->
                                meant Reason.OutOfRange { state = s, commands = [] }

                    else if name == "Right" || name == "l" || name == "+" then
                        when line is
                            Just l ->
                                if l.entry.flat || l.expanded then
                                    if c.at >= count - 1 then
                                        { state = s, commands = [] }

                                    else
                                        moved (c.at + 1) v.offset s

                                else
                                    rebuilt (withView { v | open = Dict.set l.entry.id True v.open }) s

                            Nothing ->
                                meant Reason.OutOfRange { state = s, commands = [] }

                    else if name == "M--" || name == "M-+" then
                        let
                            tops =
                                Array.keepIf (\e -> e.depth == 0) both.all
                        in
                        rebuilt (withView { v | open = Array.foldl (\e acc -> Dict.set e.id (name == "M-+") acc) v.open tops }) s

                    else if name == "/" || name == "?" || name == "C-s" then
                        { state = { s | asking = Just (customizePrompt newer 23 "(search) " "" False) }, commands = [] }

                    else if name == "n" || name == "N" then
                        customizeSearch (name == "n") c s

                    else if name == "f" then
                        { state = { s | asking = Just (customizePrompt newer 24 "(filter) " v.filter False) }, commands = [] }

                    else if name == "c" then
                        rebuilt (withView { v | filter = "", passing = Nothing, noMatches = False }) s

                    else if name == "v" then
                        rebuilt
                            (withView
                                { v
                                    | preview =
                                        if v.preview == 0 then
                                            2

                                        else if v.preview == 1 then
                                            0

                                        else
                                            1
                                }
                            )
                            s

                    else if name == "H" then
                        rebuilt (withView { v | hideGlobal = not v.hideGlobal, passing = Nothing, noMatches = False }) s

                    else if name == "C" && newer then
                        rebuilt (withView { v | changedOnly = not v.changedOnly, passing = Nothing, noMatches = False }) s

                    else if name == "e" then
                        { state = { s | said = "puritty: e (edit in an editor) is not done under tmux -CC; Enter sets the value" }, commands = [] }

                    else
                        customizeActWith name taggedTargets c s


customizeAct : String -> Customizing -> (taken s : State) -> { state : State, commands : Array String }
customizeAct name c s =
    customizeActWith name [] c s


{-| What `window_customize_key` does for a key: commands sent and the
tree asked again, a question asked (at once answered yes with `-y`), or
something said. -}
customizeActWith : String -> Array Customize.Target -> Customizing -> (taken s : State) -> { state : State, commands : Array String }
customizeActWith name tagged c s =
    let
        chosen =
            Array.get c.at (customizeShown c).shown |> Maybe.map .entry

        newer =
            s.version == 0 || s.version >= 38
    in
    when Customize.act c.table c.data name tagged chosen is
        Customize.Run commands ->
            customizeAsk commands c s

        Customize.Ask p ->
            if p.single && c.yes then
                customizeOutcome (Customize.confirmed c.table c.data p "y") c s

            else
                { state =
                    { s
                        | customizing = Just { c | prompt = Just p }
                        , asking =
                            Just
                                (customizePrompt newer
                                    (if p.single then
                                        22

                                     else
                                        21
                                    )
                                    p.label
                                    p.first
                                    p.single
                                )
                    }
                , commands = []
                }

        Customize.Say text ->
            { state = { s | said = text, customizing = Just c }, commands = [] }

        Customize.Stay ->
            { state = { s | customizing = Just c }, commands = [] }


customizeOutcome : Customize.Act -> Customizing -> (taken s : State) -> { state : State, commands : Array String }
customizeOutcome a c s =
    when a is
        Customize.Run commands ->
            customizeAsk commands { c | prompt = Nothing } s

        Customize.Say text ->
            { state = { s | said = text, customizing = Just { c | prompt = Nothing } }, commands = [] }

        _ ->
            { state = { s | customizing = Just { c | prompt = Nothing } }, commands = [] }


{-| A question of customize-mode's (TM62): asked in the pane's last row on
3.8 (`mode_tree_set_prompt`), at the status line on 3.6; a yes-or-no one
answered by a key. -}
customizePrompt : Bool -> Int -> String -> String -> Bool -> Asking
customizePrompt inPane purpose label first single =
    let
        q =
            treePrompt 0 purpose label first
    in
    { q
        | ask =
            Syntax.Prompt
                { prompts = [ label ]
                , inputs = [ first ]
                , entry =
                    if single then
                        Syntax.Single

                    else
                        Syntax.Text
                , template = Nothing
                , incremental = False
                , inPane = inPane
                , kind = ""
                }
    }


{-| customize-mode's questions answered: a value (21), a yes or no (22),
a search (23), a filter (24). -}
customizeAnswered : Int -> String -> (taken s : State) -> { state : State, commands : Array String }
customizeAnswered purpose given s =
    when s.customizing is
        Just c ->
            let
                v =
                    c.view
            in
            if purpose == 21 || purpose == 22 then
                when c.prompt is
                    Just p ->
                        customizeOutcome
                            (if purpose == 22 then
                                Customize.confirmed c.table c.data p given

                             else
                                Customize.answered c.table c.data p given
                            )
                            c
                            s

                    Nothing ->
                        meant Reason.NotOpen { state = s, commands = [] }

            else if purpose == 23 then
                if given == "" then
                    { state = { s | customizing = Just { c | view = { v | search = "" } } }, commands = [] }

                else
                    customizeSearch True { c | view = { v | search = given } } s

            else if given == "" then
                customizeDetailAsk { s | customizing = Just (customizePlaced (customizeHeight s c) { c | view = { v | filter = "", passing = Nothing, noMatches = False } }) }

            else
                customizeFilterAsk { c | view = { v | filter = given, passing = Nothing, noMatches = False } } s

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


{-| The next row whose name holds the search, through every row, folded
or not, from the chosen one round (`mode_tree_search_forward`), case
ignored when the search has no capitals; its parents opened. -}
customizeSearch : Bool -> Customizing -> (taken s : State) -> { state : State, commands : Array String }
customizeSearch forward c s =
    let
        both =
            customizeShown c

        all =
            both.all

        n =
            Array.length all

        v =
            c.view

        -- from 3.6 case ignored when the search has no capitals (TM81)
        caseless =
            (s.version == 0 || s.version >= 36) && String.toLower v.search == v.search

        matches e =
            if caseless then
                String.contains v.search (String.toLower e.name)

            else
                String.contains v.search e.name

        from =
            Array.findFirst (\e -> e.id == v.current) all |> Maybe.map .index |> Maybe.withDefault (meant Reason.NotKnown 0)

        order =
            Array.range 1 (n - 1)
                |> Array.map
                    (\k ->
                        if forward then
                            modBy n (from + k)

                        else
                            modBy n (from - k + n)
                    )

        parentsOf id =
            let
                up current acc =
                    when Array.findFirst (\e -> e.id == current) all |> Maybe.map .value is
                        Just e ->
                            if e.parent == "" then
                                acc

                            else
                                up e.parent (Array.pushLast e.parent acc)

                        Nothing ->
                            meant Reason.NotKnown acc
            in
            up id []
    in
    if v.search == "" || n == 0 then
        { state = { s | customizing = Just c }, commands = [] }

    else
        when Array.findFirst (\i -> Maybe.map matches (Array.get i all) == Just True) order |> Maybe.andThen (\found -> Array.get found.value all) is
            Just e ->
                customizeDetailAsk { s | customizing = Just (customizePlaced (customizeHeight s c) { c | view = { v | current = e.id, open = Array.foldl (\p acc -> Dict.set p True acc) v.open (parentsOf e.id) } }) }

            Nothing ->
                meant Reason.NoMore { state = { s | customizing = Just c }, commands = [] }


{-| customize-mode's cells (TM62), as tmux's mode tree draws it: each row's
key, its branch, `+` or `-` for a row folded or open, its name and text,
the chosen row in mode-style (3.8's tree-mode-selection-style), the tagged
in cyan; below, in a box under the chosen row's name, its description. In
puritty's look, the view's colors in a box of its own. -}
drawCustomize : Array String -> Bool -> Layout.Pane -> Customizing -> Array { row : Int, col : Int, color : String, text : String }
drawCustomize theme tmuxLook place c =
    let
        themed =
            Style.themed theme

        version =
            c.table.version

        newer =
            version == 0 || version >= 38

        both =
            customizeShown c

        shown =
            both.shown

        area =
            if tmuxLook then
                { x = place.x, y = place.y, w = place.w, h = place.h }

            else
                { x = place.x + 2, y = place.y + 1, w = max 0 (place.w - 4), h = max 0 (place.h - 2) }

        sy =
            area.h

        width =
            area.w

        listHeight =
            customizeListHeight c.view.preview sy

        withBox =
            c.view.preview /= 0 && sy > 4 && listHeight >= 2 && sy - listHeight > 4 && width > 4

        count =
            Array.length shown

        keyLen =
            if count > 10 then
                6

            else
                4

        -- mode-style as the pane sees it, tmux's default when unset
        modeSpec =
            Customize.effectiveValue c.data
                6
                (if newer then
                    "tree-mode-selection-style"

                 else
                    "mode-style"
                )
                |> Maybe.map
                    (\x ->
                        if String.contains "#{E:mode-style}" x then
                            Maybe.withDefault (meant Reason.NotSet "") (Customize.effectiveValue c.data 6 "mode-style")

                        else
                            x
                    )
                |> Maybe.withDefault (meant Reason.NotSet (Maybe.withDefault (meant Reason.NotKnown "bg=yellow,fg=black") (Dict.get "mode-style" c.table.defaults)))

        borderSpec =
            if newer then
                Customize.effectiveValue c.data 6 "tree-mode-border-style" |> Maybe.withDefault (meant Reason.NotSet "")

            else
                ""

        -- the chosen row is all mode-style, its pieces' own colors not
        -- drawn but the level's reverse (measured, 3.8)
        ink isChosen spec =
            if tmuxLook then
                Style.sgr
                    (if isChosen then
                        Style.apply
                            (if String.contains "reverse" spec then
                                "reverse"

                             else
                                ""
                            )
                            (Style.apply (themed modeSpec) Style.plain)

                     else
                        Style.apply (themed spec) Style.plain
                    )

            else if isChosen then
                activeTabColor

            else if String.contains "reverse" spec then
                viewEdgeColor

            else if spec /= "" then
                "\u{001B}[0;38;5;246;48;5;236m"

            else
                viewTextColor

        grey =
            if newer then
                "fg=themelightgrey"

            else
                ""

        arrow =
            if newer then
                "→"

            else
                ">"

        top =
            clamp 0 (max 0 (count - listHeight)) c.view.offset

        -- a row's pieces: its text and style, one after another
        piecesOf i l =
            let
                e =
                    l.entry

                key =
                    when Customize.rowKey i is
                        Just k ->
                            String.padRight keyLen ' ' ("(" ++ k ++ ")")

                        Nothing ->
                            meant Reason.OutOfRange String.repeat keyLen " "

                lead =
                    if e.depth == 0 then
                        ""

                    else
                        String.repeat (e.depth - 1)
                            (if e.parentLast then
                                "    "

                             else
                                "│   "
                            )
                            ++ (if e.last then
                                    "└─"

                                else
                                    "├─"
                               )
                            ++ arrow
                            ++ " "

                symbol =
                    if e.children then
                        [ { text =
                                if l.expanded then
                                    "-"

                                else
                                    "+"
                          , style =
                                if newer then
                                    (if l.expanded then
                                        "fg=themered"

                                     else
                                        "fg=themegreen"
                                    )

                                else
                                    ""
                          }
                        , { text = " ", style = grey }
                        ]

                    else if e.flat then
                        []

                    else
                        [ { text = "  ", style = grey } ]

                tagged =
                    Array.member e.id c.view.tagged

                text =
                    when e.text is
                        Just t ->
                            [ { text = ": ", style = grey } ]
                                ++ (if e.scope == "" then
                                        []

                                    else
                                        [ { text = "(" ++ e.scope ++ ")", style = "reverse" }, { text = " ", style = "" } ]
                                   )
                                ++ [ { text = t
                                     , style =
                                        if e.grey then
                                            grey

                                        else
                                            ""
                                     }
                                   ]

                        Nothing ->
                            meant Reason.NotSet []
            in
            [ { text = key ++ lead, style = grey } ]
                ++ symbol
                ++ [ { text =
                        e.name
                            ++ (if tagged then
                                    "*"

                                else
                                    ""
                               )
                     , style =
                        if tagged then
                            "fg=themecyan"

                        else
                            ""
                     }
                   ]
                ++ text

        -- the pieces placed along the row, cut at its end
        placed row isChosen pieces =
            Array.foldl
                (\p acc ->
                    let
                        room =
                            width - acc.col

                        shownText =
                            shownLine p.text

                        used =
                            min (max 0 room) (cellCount shownText)

                        cut =
                            clipCells used shownText
                    in
                    if used <= 0 then
                        acc

                    else
                        { col = acc.col + used, out = Array.pushLast { row = row, col = area.x + acc.col, color = ink isChosen p.style, text = cut } acc.out }
                )
                { col = 0, out = [] }
                pieces
                |> .out

        listed =
            Array.slice top (top + listHeight) shown
                |> Array.indexedMap
                    (\j l ->
                        let
                            i =
                                top + j

                            isChosen =
                                i == c.at
                        in
                        Array.pushFirst { row = area.y + j, col = area.x, color = ink isChosen "", text = String.repeat width " " } (placed (area.y + j) isChosen (piecesOf i l))
                    )
                |> Array.flatten

        chosen =
            Array.get c.at shown |> Maybe.map .entry

        box =
            if not withBox then
                []

            else
                let
                    boxRow =
                        area.y + listHeight

                    boxH =
                        sy - listHeight

                    inner =
                        width - 2

                    edge =
                        ink False borderSpec

                    boxName =
                        " " ++ (Maybe.map (Customize.previewTitle shown) chosen |> Maybe.withDefault (meant Reason.OutOfRange ""))

                    note =
                        if
                            c.view.filter /= ""
                                && inner >= String.count boxName + 10 + (if c.view.noMatches then
                                                                            10

                                                                         else
                                                                            6
                                                                        ) + 2
                        then
                            " (filter: "
                                ++ (if c.view.noMatches then
                                        "no matches"

                                    else
                                        "active"
                                   )
                                ++ ") "

                        else
                            " "

                    heading =
                        if String.count boxName <= inner then
                            [ { row = boxRow, col = area.x + 1, color = edge, text = boxName ++ note } ]

                        else
                            []

                    described =
                        when chosen is
                            Just e ->
                                Customize.preview c.table
                                    c.data
                                    (if Maybe.map .id c.detail == Just e.id then
                                        c.detail

                                     else
                                        Nothing
                                    )
                                    (if e.asParent then
                                        Array.findFirst (\l -> l.entry.id == e.parent) shown |> Maybe.map (\found -> found.value.entry) |> Maybe.withDefault (meant Reason.NotKnown e)

                                     else
                                        e
                                    )
                                    { width = width - 4, height = boxH - 2 }
                                    |> Array.map
                                        (\p ->
                                            let
                                                room =
                                                    max 0 (width - 4 - p.col)

                                                -- its start only, made once (review TB10)
                                                lineStart =
                                                    shownLine (aboutCells room p.text)
                                            in
                                            { row = boxRow + 1 + p.row, col = area.x + 2 + p.col, color = ink False p.style, text = clipCells (min room (cellCount lineStart)) lineStart }
                                        )

                            Nothing ->
                                meant Reason.OutOfRange []
                in
                [ { row = boxRow, col = area.x, color = edge, text = "┌" ++ String.repeat inner "─" ++ "┐" } ]
                    ++ (Array.range 1 (boxH - 2) |> Array.mapAndFlatten (\r -> [ { row = boxRow + r, col = area.x, color = edge, text = "│" }, { row = boxRow + r, col = area.x + 1, color = ink False "", text = String.repeat inner " " }, { row = boxRow + r, col = area.x + width - 1, color = edge, text = "│" } ]))
                    ++ [ { row = boxRow + boxH - 1, col = area.x, color = edge, text = "└" ++ String.repeat inner "─" ++ "┘" } ]
                    ++ heading
                    ++ described

        cleared =
            Array.range 0 (sy - 1) |> Array.map (\r -> { row = area.y + r, col = area.x, color = ink False "", text = String.repeat width " " })
    in
    if tmuxLook then
        cleared ++ listed ++ box

    else
        let
            inner =
                place.w - 2

            label =
                " customize tmux "

            foot =
                " Enter: set  d: default  u: unset  C-h: keys  q: close "
        in
        [ { row = place.y, col = place.x, color = viewEdgeColor, text = "╭" ++ String.takeFirst inner (label ++ String.repeat inner "─") ++ "╮" } ]
            ++ (Array.range 1 (place.h - 2) |> Array.mapAndFlatten (\r -> [ { row = place.y + r, col = place.x, color = viewEdgeColor, text = "│" ++ String.repeat inner " " ++ "│" } ]))
            ++ cleared
            ++ listed
            ++ box
            ++ [ { row = place.y + place.h - 1, col = place.x, color = viewEdgeColor, text = "╰" ++ String.takeFirst inner (foot ++ String.repeat inner "─") ++ "╯" } ]


{-| How many cells a line of text takes. -}
cellCount : String -> Int
cellCount text =
    String.foldl
        (\ch n ->
            let
                cp =
                    Char.toCode ch
            in
            n
                + (if cp < 0x20 || cp == 0x7F then
                    0

                   else if cp < 0x80 then
                    1

                   else
                    Width.width cp
                  )
        )
        0
        text


-- TREE MODE, THE CLOCK AND THE OTHER MODES (TM32)


{-| A tree whose lists are in, opened as tmux opens it (TM45): `-s`
(start 0) every session folded on the current one; `-w` (1) the sessions
open on the current window; neither (2) all open on the active pane, or
its window when it is the only pane. -}
treeLoaded : Int -> Int -> Tree -> Tree
treeLoaded shown active t =
    if t.loaded < 3 then
        t

    else
        when t.reload is
            Just r ->
                -- asked again after a kill or a command: the rows open as
                -- they were, the same row chosen where it still is
                let
                    again =
                        { t | reload = Nothing }
                in
                when Array.findFirst (\x -> x.session == r.session && x.window == r.window && x.pane == r.pane) (treeRows again) is
                    Just found ->
                        { again | selected = found.index }

                    Nothing ->
                        meant Reason.Gone keepSelected again

            Nothing ->
                meant Reason.NotOpen treeOpened shown active t


treeOpened : Int -> Int -> Tree -> Tree
treeOpened shown active t =
    let
        current =
            Array.findFirst (\w -> w.id == shown) t.windows |> Maybe.map (\w -> w.value.session) |> Maybe.withDefault (meant Reason.Gone -1)

        open =
            if t.start == 0 then
                Dict.empty

            else
                Array.foldl (\x d -> Dict.set x.id True d) Dict.empty t.sessions

        openWindows =
            if t.start == 2 then
                Array.foldl (\w d -> Dict.set w.id True d) Dict.empty t.windows

            else
                Dict.empty

        opened =
            { t | open = open, openWindows = openWindows }

        rows =
            treeRows opened

        alone =
            Array.length (Array.keepIf (\p -> p.window == shown) t.panes) <= 1

        found =
            if t.start == 0 then
                Array.findFirst (\r -> r.window < 0 && r.session == current) rows

            else if t.start == 1 || alone then
                Array.findFirst (\r -> r.window == shown && r.pane < 0) rows

            else
                Array.findFirst (\r -> r.pane == active) rows
    in
    { opened | selected = found |> Maybe.map .index |> Maybe.withDefault (meant Reason.NotKnown 0) }


{-| The tree's filter asked of tmux: each pane and the filter's value for
it, kept where tmux's `-f` would keep it (`filterTrue`). The filter is in
the format, not `-f`, which tmux has only from 3.2 (TM72). -}
filterQuery : String -> { command : String, expect : Expect }
filterQuery filter =
    { command = Command.listPanesAll ("F #{pane_id} " ++ filter), expect = ForTreeFilter }


{-| Whether a filter's value keeps its row, as tmux's `-f` decides:
neither empty nor `0`. -}
filterTrue : String -> Bool
filterTrue value =
    value /= "" && value /= "0"


{-| The tree's own questions answered (TM45): a search (1) goes to the
next row that matches; a filter (2) is asked of tmux. -}
treeAnswered : Int -> String -> (taken s : State) -> { state : State, commands : Array String }
treeAnswered purpose given s =
    when s.tree is
        Just t ->
            if purpose == 3 then
                -- kill the chosen row, on `y`
                when Array.get t.selected (treeRows t) is
                    Just r ->
                        if given == "y" then
                            reloadTree [ killOf (rowTarget r) ] t s

                        else
                            { state = s, commands = [] }

                    Nothing ->
                        meant Reason.OutOfRange { state = s, commands = [] }

            else if purpose == 4 then
                if given == "y" then
                    reloadTree (Array.map killOf t.tagged) t s

                else
                    { state = s, commands = [] }

            else if purpose == 5 then
                -- the command for each tagged row, or the chosen one, `%%`
                -- its target
                let
                    targets =
                        if Array.isEmpty t.tagged then
                            Array.get t.selected (treeRows t) |> Maybe.map (\r -> [ rowTarget r ]) |> Maybe.withDefault (meant Reason.OutOfRange [])

                        else
                            t.tagged
                in
                if String.trim given == "" then
                    { state = s, commands = [] }

                else
                    reloadTree (Array.map (\target -> Syntax.fill (Syntax.tokens given) [ target ]) targets) t s

            else if purpose == 1 then
                { state = { s | tree = Just (searchTree s.version True { t | search = given }) }, commands = [] }

            else if given == "" then
                { state = { s | tree = Just (refiltered Nothing { t | filter = "", noMatches = False }) }, commands = [] }

            else
                sendAsking [ filterQuery given ] { s | tree = Just { t | filter = given } }

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


{-| The tree with the panes a filter keeps, as tmux rebuilds it (TM45,
measured on 3.8): the chosen row stays where it is, or the first row is
chosen when it is filtered out, and a session or a window that comes
back is open. -}
refiltered : Maybe (Array Int) -> Tree -> Tree
refiltered passing t =
    let
        earlier =
            kept t

        chosen =
            Array.get t.selected (treeRows t)

        after =
            kept { t | passing = passing }

        opened =
            { t
                | passing = passing
                , open =
                    Array.foldl
                        (\x d ->
                            if Array.any (\y -> y.id == x.id) earlier.sessions then
                                d

                            else
                                Dict.set x.id True d
                        )
                        t.open
                        after.sessions
                , openWindows =
                    Array.foldl
                        (\w d ->
                            if Array.any (\v -> v.id == w.id) earlier.windows then
                                d

                            else
                                Dict.set w.id True d
                        )
                        t.openWindows
                        after.windows
            }
    in
    when chosen is
        Just r ->
            when Array.findFirst (\x -> x.session == r.session && x.window == r.window && x.pane == r.pane) (treeRows opened) is
                Just found ->
                    { opened | selected = found.index }

                Nothing ->
                    -- gone: the first row, as tmux's
                    meant Reason.Gone { opened | selected = 0 }

        Nothing ->
            meant Reason.OutOfRange { opened | selected = 0 }


{-| The tree's orders as tmux names them: 3.6's `window_tree_sort_list`,
3.8's `window_tree_order_seq` (`activity` is 3.6's `time`; `z`, the
floating panes' order, sorts as index here). -}
sortNames : Int -> (r : Array String where 3 <= Array.length r)
sortNames version =
    if version >= 38 then
        [ "index", "name", "activity", "z" ]

    else
        [ "index", "name", "time" ]


{-| The command that kills a target, as `window_tree_kill_each`. -}
killOf : String -> String
killOf target =
    if String.startsWith "%" target then
        Command.killPane target

    else if String.startsWith "@" target then
        Command.killWindow target

    else
        Command.killSession target


{-| The chosen row kept within the rows there are. -}
keepSelected : Tree -> Tree
keepSelected t =
    { t | selected = clamp 0 (max 0 (Array.length (treeRows t) - 1)) t.selected }


{-| The next row whose name holds the search, after the chosen one or
before it (`forward`), going round, as `mode_tree_search_forward`: every
session, window and pane, folded or not, a pane by its command; case
ignored, from 3.6, when the search has no capitals. The rows above it are
opened. -}
searchTree : Int -> Bool -> Tree -> Tree
searchTree version forward t =
    if t.search == "" then
        t

    else
        let
            -- from 3.6 only: before it tmux's search minds case (TM81)
            caseless =
                (version == 0 || version >= 36) && String.toLower t.search == t.search

            matches name =
                if caseless then
                    String.contains t.search (String.toLower name)

                else
                    String.contains t.search name

            -- every item, in the tree's order, as `{ session, window, pane, name }`
            items =
                treeOrder t
                    |> (\k ->
                            k.sessions
                                |> Array.mapAndFlatten
                                    (\x ->
                                        Array.pushFirst { session = x.id, window = -1, pane = -1, name = x.name }
                                            (Array.keepIf (\w -> w.session == x.id) k.windows
                                                |> Array.mapAndFlatten
                                                    (\w ->
                                                        Array.pushFirst { session = x.id, window = w.id, pane = -1, name = w.name }
                                                            (Array.keepIf (\p -> p.window == w.id) k.panes |> Array.map (\p -> { session = x.id, window = w.id, pane = p.id, name = p.command }))
                                                    )
                                            )
                                    )
                       )

            n =
                Array.length items

            here =
                Array.get t.selected (treeRows t)
                    |> Maybe.andThen (\r -> Array.findFirst (\i -> i.session == r.session && i.window == r.window && i.pane == r.pane) items)
                    |> Maybe.map .index
                    |> Maybe.withDefault (meant Reason.NotKnown 0)

            order =
                Array.range 1 n
                    |> Array.map
                        (\k ->
                            if forward then
                                modBy n (here + k)

                            else
                                modBy n (here - k + n)
                        )

            found =
                Array.findFirst (\i -> Maybe.map (\it -> matches it.name) (Array.get i items) == Just True) order
                    |> Maybe.andThen (\f -> Array.get f.value items)
        in
        when found is
            Just it ->
                let
                    opened =
                        { t
                            | open = Dict.set it.session True t.open
                            , openWindows =
                                if it.pane >= 0 then
                                    Dict.set it.window True t.openWindows

                                else
                                    t.openWindows
                        }
                in
                { opened
                    | selected =
                        Array.findFirst (\r -> r.session == it.session && r.window == it.window && r.pane == it.pane) (treeRows opened)
                            |> Maybe.map .index
                            |> Maybe.withDefault (meant Reason.NotKnown t.selected)
                }

            Nothing ->
                meant Reason.NoMore t


{-| The rows the filter keeps, in the tree's order (`O`, `r`), as
`window_tree_cmp_session` and `_window` sort them: by index (a session's
id), by name, or by time, the most recent first and then by name; panes
by their number whatever the order, as tmux's are but for time, which
tmux sorts by a pane's last use and does not say. -}
treeOrder : Tree -> { sessions : Array { id : Int, name : String, attached : Bool, windows : Int, activity : Int, text : String }, windows : Array { session : Int, id : Int, index : Int, name : String, active : Bool, panes : Int, activity : Int, text : String }, panes : Array { window : Int, id : Int, index : Int, command : String, text : String } }
treeOrder t =
    let
        k =
            kept t

        flip o =
            if t.reversed then
                when o is
                    LT ->
                        GT

                    GT ->
                        LT

                    EQ ->
                        EQ

            else
                o

        byTime a b nameA nameB =
            if a > b then
                LT

            else if a < b then
                GT

            else
                compare nameA nameB
    in
    { sessions =
        Array.sortWith
            (\a b ->
                flip
                    (if t.sort == 0 || t.sort == 3 then
                        compare a.id b.id

                     else if t.sort == 1 then
                        compare a.name b.name

                     else
                        byTime a.activity b.activity a.name b.name
                    )
            )
            k.sessions
    , windows =
        Array.sortWith
            (\a b ->
                flip
                    (if t.sort == 0 || t.sort == 3 then
                        compare a.index b.index

                     else if t.sort == 1 then
                        compare a.name b.name

                     else
                        byTime a.activity b.activity a.name b.name
                    )
            )
            k.windows
    , panes = Array.sortWith (\a b -> flip (compare a.index b.index)) k.panes
    }


{-| The sessions, windows and panes the filter keeps: a pane tmux said
passes, a window with such a pane, a session with such a window; all of
them when there is no filter or nothing passes. -}
kept : Tree -> { sessions : Array { id : Int, name : String, attached : Bool, windows : Int, activity : Int, text : String }, windows : Array { session : Int, id : Int, index : Int, name : String, active : Bool, panes : Int, activity : Int, text : String }, panes : Array { window : Int, id : Int, index : Int, command : String, text : String } }
kept t =
    when t.passing is
        Just ids ->
            let
                panes =
                    Array.keepIf (\p -> Array.member p.id ids) t.panes

                windows =
                    Array.keepIf (\w -> Array.any (\p -> p.window == w.id) panes) t.windows

                sessions =
                    Array.keepIf (\x -> Array.any (\w -> w.session == x.id) windows) t.sessions
            in
            { sessions = sessions, windows = windows, panes = panes }

        Nothing ->
            meant Reason.NotOpen { sessions = t.sessions, windows = t.windows, panes = t.panes }


{-| The preview asked for in a reply's turn. -}
previewAcc : (taken acc : Acc) -> Acc
previewAcc acc =
    let
        r =
            askPreview acc.state
    in
    { acc | state = r.state, commands = acc.commands ++ r.commands }


{-| The preview asked for after a key in the tree. -}
previewAfter : (taken r0 : { state : State, commands : Array String }) -> { state : State, commands : Array String }
previewAfter r0 =
    let
        r =
            askPreview r0.state
    in
    { state = r.state, commands = r0.commands ++ r.commands }


{-| tmux asked what the tree's chosen row shows (TM35), when that row is
not the one already previewed: a window's panes with where they are, or a
session's windows; each is captured when the answer comes. -}
askPreview : (taken s : State) -> { state : State, commands : Array String }
askPreview s =
    when s.tree is
        Just t ->
            if t.loaded < 3 then
                { state = s, commands = [] }

            else
                let
                    row =
                        Array.get t.selected (treeRows t)

                    target =
                        when row is
                            Just r ->
                                rowTarget r

                            Nothing ->
                                meant Reason.OutOfRange ""

                    isSession =
                        String.startsWith "$" target

                    serial =
                        t.preview.serial + 1

                    formatted =
                        s.version == 0 || s.version >= 37

                    command =
                        -- the label: from 3.7 tree-mode-preview-format as tmux
                        -- expands it for the window or pane (TM88)
                        if isSession then
                            Command.listWindowsTarget target
                                ("Q #{window_id} 0 0 #{window_width} #{window_height} #{window_active} "
                                    ++ (if formatted then
                                            "#{E:tree-mode-preview-format}"

                                        else
                                            "#{window_index}:#{window_name}"
                                       )
                                    ++ "\t#{E:tree-mode-preview-style}"
                                )

                        else if String.startsWith "%" target then
                            -- a pane's row: that pane alone, filling the area,
                            -- asked of the pane itself rather than by
                            -- `list-panes -f`, which tmux has from 3.2 (TK7)
                            Command.displayAt target "Q #{pane_id} 0 0 #{pane_width} #{pane_height} 1 #{pane_index}\t#{E:tree-mode-preview-style}"

                        else
                            Command.listPanesTarget target
                                ("Q #{pane_id} #{pane_left} #{pane_top} #{pane_width} #{pane_height} #{pane_active} "
                                    ++ (if formatted then
                                            "#{E:tree-mode-preview-format}"

                                        else
                                            "#{pane_index}"
                                       )
                                    ++ "\t#{E:tree-mode-preview-style}"
                                )
                in
                if target == "" || target == t.preview.target then
                    { state = s, commands = [] }

                else
                    sendAsking [ { command = command, expect = ForPreviewList serial } ]
                        { s | tree = Just { t | preview = { serial = serial, target = target, session = isSession, items = [], offset = 0, info = [] } } }
                        |> (\r ->
                                if t.info then
                                    infoAsked r

                                else
                                    r
                           )

        Nothing ->
            meant Reason.NotOpen { state = s, commands = [] }


{-| Which of a session's windows the preview shows, as tmux's
`window_tree_draw_session` picks them (TM65): all when each has 24 cells,
else as many as have, the current one among them, moved by `offset` no
further than the first and the last; the offset as far as it went. -}
sessionSpan : Int -> Int -> Int -> Int -> { start : Int, end : Int, offset : Int, visible : Int }
sessionSpan width total current offset0 =
    if total <= 0 then
        { start = 0, end = 0, offset = 0, visible = 0 }

    else
        let
            visible =
                if width // total < 24 then
                    max 1 (width // 24)

                else
                    total

            start0 =
                if current < visible then
                    0

                else if current >= total - visible then
                    total - visible

                else
                    current - visible // 2

            end0 =
                start0 + visible

            offset =
                clamp (negate start0) (total - end0) offset0
        in
        { start = start0 + offset, end = end0 + offset, offset = offset, visible = visible }


{-| The index of the active item, 0 when none is. -}
activeIndex : Array PreviewItem -> Int
activeIndex items =
    Array.findFirst .active items |> Maybe.map .index |> Maybe.withDefault (meant Reason.FromOutside 0)


{-| The preview's width in cells, as `drawTree` gives it, where the tree
is shown. -}
treePreviewWidth : State -> Tree -> Maybe Int
treePreviewWidth s t =
    let
        placeWidth =
            if t.zoom then
                Just s.canvas.cols

            else
                when s.layout is
                    Just cell ->
                        Array.findFirst (\p -> p.id == t.pane) (placedPanes s cell (Layout.tiled cell) ++ placedPanes s cell (Layout.floating cell))
                            |> Maybe.map (\found -> found.value.w)

                    Nothing ->
                        meant Reason.NotYet Nothing
    in
    Maybe.map
        (\w ->
            (if s.lookTmux then
                w

             else
                w - 4
            )
                - 4
        )
        placeWidth


{-| tmux 3.8's information lines (`window-tree.c`): a pane's, its
window's, its session's, as many as the row has; `│` where tmux draws its
`acs` line. -}
infoLines : { pane : Array String, window : Array String, session : Array String }
infoLines =
    let
        label name =
            "#[fg=themelightgrey]" ++ String.padRight 14 ' ' name ++ "#[#{E:tree-mode-border-style}]│#[default] "

        flag name cond =
            "#{?#{" ++ cond ++ "},#[fg=themegreen],#[fg=themelightgrey]}" ++ name ++ "#[default]"
    in
    { pane =
        [ label "Pane" ++ "#{pane_index} #[fg=themelightgrey](#{pane_id})#[default]"
        , label "Title" ++ "#{pane_title}"
        , label "Command" ++ "#{pane_current_command} #[fg=themelightgrey](PID #{pane_pid})#[default]"
        , label "Path" ++ "#{pane_current_path}"
        , label "TTY" ++ "#{pane_tty}"
        , label "Position" ++ "#{pane_x},#{pane_y} #{pane_width}x#{pane_height}"
        , label "Mode" ++ "#{?#{pane_in_mode},#{pane_mode},none}"
        , label "Flags" ++ String.join " " [ flag "active" "pane_active", flag "zoomed" "window_zoomed_flag", flag "marked" "pane_marked", flag "sync" "pane_synchronized", flag "dead" "pane_dead", flag "piped" "pane_pipe" ]
        ]
    , window =
        [ label "Window" ++ "#{window_index}: #{window_name} #[fg=themelightgrey](#{window_id})#[default]"
        , label "Size" ++ "#{window_width}x#{window_height}"
        , label "Panes" ++ "#{window_panes}"
        , label "Activity Time" ++ "#{t:window_activity} #[fg=themelightgrey](#{t/r:window_activity})#[default]"
        , label "Sessions" ++ "#{s/,/ /:window_linked_sessions_list}"
        , label "Flags" ++ String.join " " [ flag "active" "window_active", flag "last" "window_last_flag", flag "bell" "window_bell_flag", flag "activity" "window_activity_flag", flag "silence" "window_silence_flag", flag "zoomed" "window_zoomed_flag", flag "marked" "window_marked_flag" ]
        ]
    , session =
        [ label "Session" ++ "#{session_name} #[fg=themelightgrey](#{session_id})#[default]"
        , label "Created Time" ++ "#{t:session_created} #[fg=themelightgrey](#{t/r:session_created})#[default]"
        , label "Activity Time" ++ "#{t:session_activity} #[fg=themelightgrey](#{t/r:session_activity})#[default]"
        , label "Attached Time" ++ "#{?#{t:session_last_attached},#{t:session_last_attached} #[fg=themelightgrey](#{t/r:session_last_attached})#[default],never}"
        , label "Clients" ++ "#{s/,/ /:session_attached_list}"
        , label "Windows" ++ "#{session_windows}"
        , label "Path" ++ "#{session_path}"
        , label "Group" ++ "#{?#{session_grouped},#{session_group} (#{session_group_size}),none}"
        , label "Flags" ++ String.join " " [ flag "attached" "session_attached", flag "grouped" "session_grouped", flag "marked" "session_marked", flag "bell" "session_bell_flag", flag "activity" "session_activity_flag", flag "silence" "session_silence_flag" ]
        ]
    }


{-| tmux asked for the information on the row previewed (TM65): one
`display-message`, its lines a tab apart, an empty line between a pane's,
its window's and its session's. -}
infoAsked : (taken r : { state : State, commands : Array String }) -> { state : State, commands : Array String }
infoAsked r =
    when r.state.tree is
        Just t ->
            if t.preview.target == "" then
                r

            else
                let
                    target =
                        t.preview.target

                    groups =
                        if String.startsWith "%" target then
                            [ infoLines.pane, infoLines.window, infoLines.session ]

                        else if String.startsWith "@" target then
                            [ infoLines.window, infoLines.session ]

                        else
                            [ infoLines.session ]

                    format =
                        String.join "\t\t" (Array.map (String.join "\t") groups)

                    asked =
                        sendAsking [ { command = Command.displayAt target format, expect = ForTreeInfo t.preview.serial } ] r.state
                in
                { state = asked.state, commands = r.commands ++ asked.commands }

        Nothing ->
            meant Reason.NotOpen r


{-| A line of the preview's list: `Q id x y w h active label`, a tab,
the label's style. -}
previewItem : Bytes -> Maybe PreviewItem
previewItem line =
    let
        parts =
            String.split "\t" (Bytes.toStringLossy line)

        style =
            String.join "\t" (Array.dropFirst 1 parts)
    in
    when String.split " " (Array.getProven 0 parts) |> Array.popFirst is
        Just { first = "Q", rest = rest } ->
            let
                num i =
                    Maybe.withDefault (meant Reason.FromOutside 0) (Maybe.andThen String.toInt (Array.get i rest))
            in
            Just
                { id = Maybe.withDefault (meant Reason.FromOutside "") (Array.get 0 rest)
                , x = num 1
                , y = num 2
                , w = max 1 (num 3)
                , h = max 1 (num 4)
                , active = Array.get 5 rest == Just "1"
                , label = String.join " " (Array.dropFirst 6 rest)
                , lines = []
                , style = style
                }

        _ ->
            meant Reason.FromOutside Nothing


{-| A capture's lines without the blank ones at its end, so that the
preview shows where the text is, as tmux's shows around the cursor. -}
trimBlank : Array String -> Array String
trimBlank lines =
    when Array.last lines is
        Just l ->
            if String.trim l == "" then
                trimBlank (Array.dropLast 1 lines)

            else
                lines

        Nothing ->
            meant Reason.NoMore []


{-| A line cut to `n` cells and padded to them: a wide character (Hangul,
Han) takes two, a control character none. -}
clipCells : Int -> String -> String
clipCells n text =
    let
        step c acc =
            if acc.full then
                acc

            else
                let
                    cp =
                        Char.toCode c

                    w =
                        if cp < 0x20 || cp == 0x7F then
                            0

                        else if cp < 0x80 then
                            1

                        else
                            Width.width cp
                in
                if acc.used + w > n then
                    { acc | full = True }

                else
                    { acc | used = acc.used + w, text = acc.text ++ String.fromChar c }

        done =
            String.foldl step { used = 0, text = "", full = False } text
    in
    done.text ++ String.repeat (max 0 (n - done.used)) " "


{-| tmux's questions for the tree's three lists (TM44): each row's text
expanded by tmux with its tree's own default format (`window-tree.c`,
`WINDOW_TREE_DEFAULT_FORMAT`), which has four forms (TM77): before 3.2 a
window `name flags (N panes)` and a pane `command "title"`; from 3.2 the
flags and a title other than the host's, a marked row reversed; 3.7 a
pane's flags as `pane_flags` and a floating pane in italics; 3.8 its
theme's colors. Its conditions are written `#{?#{name},…}` (TM76). Fields
are split at tabs, so a name with spaces stays whole. -}
treeQueries : Int -> Array { command : String, expect : Expect }
treeQueries version =
    let
        paneTitle =
            "#{?#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}},: \"#{pane_title}\",}"

        -- 3.8's formats carry its colors (TM66): the flags and a
        -- session's text light grey, a marked row magenta
        newer =
            version == 0 || version >= 38

        -- before 3.2: no flags after a pane's command, every pane's title
        oldest =
            version > 0 && version < 32

        windowTitle =
            "#{?#{&&:#{==:#{window_panes},1},#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}}},: \"#{pane_title}\",}"

        sessionText =
            (if newer then
                "#[fg=themelightgrey]"

             else
                ""
            )
                ++ "#{session_windows} windows#{?#{session_grouped}, (group #{session_group}: #{session_group_list}),}#{?#{session_attached}, (attached),}"

        windowText =
            if newer then
                "#{?#{window_marked_flag},#[fg=thememagenta],}#{window_name}#[fg=themelightgrey]#{window_flags}" ++ windowTitle

            else if oldest then
                "#{window_name}#{window_flags} (#{window_panes} panes)#{?#{==:#{window_panes},1}, \"#{pane_title}\",}"

            else
                "#{?#{window_marked_flag},#[reverse],}#{window_name}#{window_flags}" ++ windowTitle

        paneText =
            if newer then
                "#{?#{pane_marked},#[fg=thememagenta],}#{?#{pane_floating_flag},#[underscore],}#{pane_current_command}#[fg=themelightgrey]#{pane_flags}" ++ paneTitle

            else if oldest then
                "#{pane_current_command} \"#{pane_title}\""

            else if version >= 37 then
                "#{?#{pane_marked},#[reverse],}#{?#{pane_floating_flag},#[italics],}#{pane_current_command}#{pane_flags}" ++ paneTitle

            else
                "#{?#{pane_marked},#[reverse],}#{pane_current_command}#{?#{pane_active},*,}#{?#{pane_marked},M,}" ++ paneTitle
    in
    [ { command = Command.listSessions ("S\t#{session_id}\t#{session_attached}\t#{session_windows}\t#{session_activity}\t#{session_name}\t" ++ sessionText), expect = ForTreeSessions }
    , { command = Command.listWindowsAll ("W\t#{session_id}\t#{window_id}\t#{window_index}\t#{window_active}\t#{window_panes}\t#{window_activity}\t#{window_name}\t" ++ windowText), expect = ForTreeWindows }
    , { command = Command.listPanesAll ("P\t#{window_id}\t#{pane_id}\t#{pane_index}\t#{pane_current_command}\t" ++ paneText), expect = ForTreePanes }
    ]


{-| What a row names as a target: a pane's id, a window's or a session's
(`%3`, `@2`, `$1`), which tmux takes. -}
rowTarget : TreeRow -> String
rowTarget r =
    if r.pane >= 0 then
        "%" ++ String.fromInt r.pane

    else if r.window >= 0 then
        "@" ++ String.fromInt r.window

    else
        "$" ++ String.fromInt r.session


{-| The tree's rows, as tmux's tree mode lists them (TM44): each session,
an open one's windows under it, an open window's panes under that; a
window always has its panes to open, as in tmux. -}
treeRows : Tree -> Array TreeRow
treeRows t0 =
    let
        t =
            treeOrder t0

        sessionCount =
            Array.length t.sessions
    in
    Array.indexedMap
        (\si x ->
            let
                own =
                    Array.keepIf (\w -> w.session == x.id) t.windows

                count =
                    Array.length own

                open =
                    Dict.get x.id t0.open == Just True

                windowRows =
                    if open then
                        Array.indexedMap
                            (\i w ->
                                let
                                    lastWindow =
                                        i == count - 1

                                    panes =
                                        Array.keepIf (\p -> p.window == w.id) t.panes

                                    paneCount =
                                        Array.length panes

                                    windowOpen =
                                        Dict.get w.id t0.openWindows == Just True
                                in
                                Array.pushFirst
                                    { session = x.id, window = w.id, pane = -1, depth = 1, name = String.fromInt w.index, text = w.text, last = lastWindow, parentLast = si == sessionCount - 1, children = paneCount > 0, expanded = windowOpen }
                                    (if windowOpen then
                                        Array.indexedMap
                                            (\j p -> { session = x.id, window = w.id, pane = p.id, depth = 2, name = String.fromInt p.index, text = p.text, last = j == paneCount - 1, parentLast = lastWindow, children = False, expanded = False })
                                            panes

                                     else
                                        []
                                    )
                            )
                            own
                            |> Array.flatten

                    else
                        []
            in
            Array.pushFirst
                { session = x.id, window = -1, pane = -1, depth = 0, name = x.name, text = x.text, last = si == sessionCount - 1, parentLast = False, children = count > 0, expanded = open }
                windowRows
        )
        t.sessions
        |> Array.flatten


{-| A key while the tree is shown, as tmux's tree mode takes it: Up, k,
C-p and Down, j, C-n move; PPage, NPage, Home, g, End, G; Right, l, `+`
open a session or a window, or go down from an open one; Left, h, `-`
close it, or close its parent and go there (TM44); M-+ and M-- open and
close every session; `/`, `?` and C-s search, n and N search again, f
filters (TM45); Enter chooses; a row's key (`treeRowKey`: a
digit, or `M-a` to `M-z`) chooses that row; q, Escape and C-g close it,
as in tmux (C-c does not, TM45). -}
treeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Tree -> (taken s : State) -> { state : State, commands : Array String }
treeKey k t s =
    let
        name =
            Maybe.withDefault (meant Reason.NotKnown "") (lookupName k)

        rows =
            treeRows t

        count =
            Array.length rows

        at =
            Array.get t.selected rows

        moved i st =
            { state = { st | tree = Just { t | selected = clamp 0 (max 0 (count - 1)) i } }, commands = [] }

        page =
            10
    in
    if name == "q" || name == "Escape" || name == "C-g" then
        { state = { s | tree = Nothing }, commands = [] }

    else if name == "Up" || name == "k" || name == "C-p" then
        moved
            (if t.selected == 0 then
                count - 1

             else
                t.selected - 1
            )
            s

    else if name == "Down" || name == "j" || name == "C-n" then
        moved
            (if t.selected >= count - 1 then
                0

             else
                t.selected + 1
            )
            s

    else if name == "PPage" || name == "C-b" then
        moved (t.selected - page) s

    else if name == "NPage" || name == "C-f" then
        moved (t.selected + page) s

    else if name == "Home" || name == "g" then
        moved 0 s

    else if name == "End" || name == "G" then
        moved (count - 1) s

    else if name == "Right" || name == "l" || name == "+" then
        -- an open row, or one with nothing to open, goes down a row
        when at is
            Just r ->
                if r.expanded || not r.children then
                    moved (min (count - 1) (t.selected + 1)) s

                else
                    { state = { s | tree = Just (setOpen True r t) }, commands = [] }

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if name == "Left" || name == "h" || name == "-" then
        -- an open row closes; any other closes its parent and goes to it,
        -- or, at the top, goes up a row
        when at is
            Just r ->
                if r.expanded then
                    { state = { s | tree = Just (setOpen False r t) }, commands = [] }

                else if r.depth == 0 then
                    moved (max 0 (t.selected - 1)) s

                else
                    let
                        parent =
                            if r.depth == 2 then
                                { r | pane = -1, depth = 1 }

                            else
                                { r | window = -1, pane = -1, depth = 0 }

                        closed =
                            setOpen False parent t
                    in
                    { state = { s | tree = Just { closed | selected = rowIndex parent closed } }, commands = [] }

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if name == "M-+" then
        { state = { s | tree = Just { t | open = Array.foldl (\x d -> Dict.set x.id True d) Dict.empty t.sessions } }, commands = [] }

    else if name == "M--" then
        let
            closed =
                { t | open = Dict.empty }

            session =
                Maybe.map .session at
        in
        { state = { s | tree = Just { closed | selected = Array.findFirst (\x -> Just x.session == session) (treeRows closed) |> Maybe.map .index |> Maybe.withDefault (meant Reason.OutOfRange 0) } }, commands = [] }

    else if name == "t" then
        -- tag the row, its parents and children untagged, and go down;
        -- or untag it (mode_tree_key)
        when at is
            Just r ->
                let
                    target =
                        rowTarget r

                    others =
                        Array.keepIf (\x -> not (related r x t)) t.tagged

                    tagged =
                        if Array.member target t.tagged then
                            Array.keepIf (\x -> x /= target) t.tagged

                        else
                            Array.pushLast target others
                in
                { state = { s | tree = Just { t | tagged = tagged, selected = min (count - 1) (t.selected + 1) } }, commands = [] }

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if name == "T" then
        { state = { s | tree = Just { t | tagged = [] } }, commands = [] }

    else if name == "C-t" then
        { state = { s | tree = Just { t | tagged = Array.keepIf (\r -> r.depth == 0) rows |> Array.map rowTarget } }, commands = [] }

    else if name == "x" then
        when at is
            Just r ->
                let
                    question =
                        if r.pane >= 0 then
                            "Kill pane " ++ r.name ++ "? "

                        else if r.window >= 0 then
                            "Kill window " ++ r.name ++ "? "

                        else
                            "Kill session " ++ r.name ++ "? "
                in
                { state = { s | asking = Just (treeQuestion s.version 3 question Syntax.Single) }, commands = [] }

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if name == "X" then
        if Array.isEmpty t.tagged then
            { state = s, commands = [] }

        else
            { state = { s | asking = Just (treeQuestion s.version 4 ("Kill " ++ String.fromInt (Array.length t.tagged) ++ " tagged? ") Syntax.Single) }, commands = [] }

    else if name == ":" then
        { state =
            { s
                | asking =
                    Just
                        (treeQuestion s.version
                            5
                            (if Array.isEmpty t.tagged then
                                "(current) "

                             else
                                "(" ++ String.fromInt (Array.length t.tagged) ++ " tagged) "
                            )
                            Syntax.Text
                        )
            }
        , commands = []
        }

    else if name == "m" then
        when at is
            Just r ->
                reloadTree [ Command.markPane (rowTarget r) ] t s

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if name == "M" then
        reloadTree [ Command.unmarkPanes ] t s

    else if name == "H" then
        -- back to the active pane's row, opened to it
        let
            window =
                Array.findFirst (\w -> w.id == s.window) t.windows |> Maybe.map .value

            opened =
                when window is
                    Just w ->
                        { t | open = Dict.set w.session True t.open, openWindows = Dict.set w.id True t.openWindows }

                    Nothing ->
                        meant Reason.NotKnown t

            found =
                Array.findFirst (\r -> r.pane == s.active) (treeRows opened)
                    |> Maybe.map .index
                    |> Maybe.withDefault (meant Reason.NotKnown opened.selected)
        in
        { state = { s | tree = Just { opened | selected = found } }, commands = [] }

    else if name == "v" then
        { state =
            { s
                | tree =
                    Just
                        { t
                            | previewMode =
                                if t.previewMode == 0 then
                                    2

                                else if t.previewMode == 1 then
                                    0

                                else
                                    1
                        }
            }
        , commands = []
        }

    else if name == "<" || name == ">" then
        -- a session's windows in the preview moved along by one, no
        -- further than its first and last (TM65)
        let
            pv =
                t.preview

            stepped =
                pv.offset
                    + (if name == "<" then
                        -1

                       else
                        1
                      )

            offset =
                when treePreviewWidth s t is
                    Just w ->
                        if previewSideBySide s.lookTmux pv then
                            (sessionSpan w (Array.length pv.items) (activeIndex pv.items) stepped).offset

                        else
                            0

                    Nothing ->
                        meant Reason.NotOpen stepped
        in
        { state = { s | tree = Just { t | preview = { pv | offset = offset } } }, commands = [] }

    else if name == "i" && (s.version == 0 || s.version >= 38) then
        -- 3.8's information on the row in place of its preview (TM65)
        let
            shown =
                { t | info = not t.info }
        in
        if shown.info then
            infoAsked { state = { s | tree = Just shown }, commands = [] }

        else
            { state = { s | tree = Just shown }, commands = [] }

    else if name == "O" then
        { state = { s | tree = Just (keepChosen at { t | sort = modBy (Array.length (sortNames s.version)) (t.sort + 1) }) }, commands = [] }

    else if name == "r" then
        { state = { s | tree = Just (keepChosen at { t | reversed = not t.reversed }) }, commands = [] }

    else if name == "S-Up" || name == "S-Down" then
        -- the window swapped with its neighbor in its session, sorted by
        -- index only, as window_tree_swap (TM60); the chosen row follows it
        when at is
            Just r ->
                let
                    step =
                        if name == "S-Up" then
                            -1

                        else
                            1

                    neighbor =
                        Array.get (t.selected + step) rows
                in
                when neighbor is
                    Just o ->
                        if r.depth == 1 && o.depth == 1 && o.session == r.session && t.sort == 0 then
                            reloadTree [ Command.swapWindow (rowTarget r) (rowTarget o) ] t s

                        else
                            { state = s, commands = [] }

                    Nothing ->
                        meant Reason.OutOfRange { state = s, commands = [] }

            Nothing ->
                meant Reason.OutOfRange { state = s, commands = [] }

    else if name == "C-h" && (s.version == 0 || s.version >= 37) then
        -- the keys, as mode_tree's help lists them (3.7 on)
        { state = { s | view = Just (viewOf (Array.map Bytes.fromString (treeHelp s.version))) }, commands = [] }

    else if name == "/" || name == "?" || name == "C-s" then
        { state = { s | asking = Just (treePrompt s.version 1 "(search) " "") }, commands = [] }

    else if name == "n" then
        { state = { s | tree = Just (searchTree s.version True t) }, commands = [] }

    else if name == "N" then
        { state = { s | tree = Just (searchTree s.version False t) }, commands = [] }

    else if name == "f" then
        { state = { s | asking = Just (treePrompt s.version 2 "(filter) " t.filter) }, commands = [] }

    else if name == "Enter" || name == "KPEnter" || name == "C-m" then
        chooseRow at t s

    else
        when Array.findFirst (\i -> treeRowKey i == Just name) (Array.range 0 (min count 36 - 1)) is
            Just found ->
                chooseRow (Array.get found.value rows) t s

            Nothing ->
                meant Reason.NotKnown { state = s, commands = [] }


{-| The tree's keys as tmux's help shows them (`mode_tree_help_start`,
`window_tree_help_lines`, `mode_tree_help_end`, 3.8). -}
treeHelp : Int -> Array String
treeHelp version =
    let
        info =
            if version == 0 || version >= 38 then
                [ "          i │ Toggle session, window and pane information" ]

            else
                []
    in
    [ "      Up, k │ Move cursor up"
    , "    Down, j │ Move cursor down"
    , "          g │ Go to top"
    , "          G │ Go to bottom"
    , " PPage, C-b │ Page up"
    , " NPage, C-f │ Page down"
    , "    Left, h │ Collapse item"
    , "   Right, l │ Expand item"
    , "        M-- │ Collapse all items"
    , "        M-+ │ Expand all items"
    , "          t │ Toggle item tag"
    , "          T │ Untag all items"
    , "        C-t │ Tag all items"
    , "        C-s │ Search forward"
    , "          n │ Repeat search forward"
    , "          N │ Repeat search backward"
    , "          f │ Filter items"
    , "          O │ Change sort order"
    , "          r │ Reverse sort order"
    , "          v │ Toggle preview"
    , "      Enter │ Choose selected item"
    , "       S-Up │ Swap current and previous window"
    , "     S-Down │ Swap current and next window"
    , "          x │ Kill selected item"
    , "          X │ Kill tagged items"
    , "          < │ Scroll previews left"
    , "          > │ Scroll previews right"
    , "          m │ Set the marked pane"
    , "          M │ Clear the marked pane"
    ]
        ++ info
        ++ [ "          : │ Run a command for each tagged item"
           , "          H │ Jump to the starting pane"
           , "  q, Escape │ Exit mode"
           ]


{-| A question of the tree's own, asked at the status line as tmux asks
it (TM45): a search (1) or a filter (2), with its first text. -}
treePrompt : Int -> Int -> String -> String -> Asking
treePrompt version purpose label first =
    { ask = Syntax.Prompt { prompts = [ label ], inputs = [ first ], entry = Syntax.Text, template = Nothing, incremental = False, inPane = modeAsksInPane version, kind = "" }
    , after = ""
    , step = 0
    , answers = []
    , label = label
    , chars = String.toArray first
    , caret = String.count first
    , edited = False
    , recall = ""
    , cut = ""
    , matches = []
    , commandMode = False
    , purpose = purpose
    }


{-| A question the tree asks (TM46): kill the row (3), kill the tagged
rows (4), or a command for them (5); at the status line before 3.8, in the
mode on 3.8 (TM66). -}
treeQuestion : Int -> Int -> String -> Syntax.Entry -> Asking
treeQuestion version purpose label entry =
    let
        q =
            treePrompt version purpose label ""
    in
    { q | ask = Syntax.Prompt { prompts = [ label ], inputs = [ "" ], entry = entry, template = Nothing, incremental = False, inPane = modeAsksInPane version, kind = "" } }


{-| Whether a mode tree's questions are asked in the mode (3.8's
`mode_tree_set_prompt`) rather than at the status line (3.7 and before). -}
modeAsksInPane : Int -> Bool
modeAsksInPane version =
    version == 0 || version >= 38


{-| Whether a tagged target is the row's parent or child, which tagging the
row untags. -}
related : TreeRow -> String -> Tree -> Bool
related r target t =
    let
        session =
            "$" ++ String.fromInt r.session

        window =
            "@" ++ String.fromInt r.window

        isWindowOf w =
            Array.any (\x -> "@" ++ String.fromInt x.id == w && x.session == r.session) t.windows

        isPaneOf w p =
            Array.any (\x -> "%" ++ String.fromInt x.id == p && "@" ++ String.fromInt x.window == w) t.panes

        isPaneInSession p =
            Array.any (\x -> "%" ++ String.fromInt x.id == p && Array.any (\w -> w.id == x.window && w.session == r.session) t.windows) t.panes
    in
    if r.pane >= 0 then
        target == session || target == window

    else if r.window >= 0 then
        target == session || isPaneOf window target

    else
        isWindowOf target || isPaneInSession target


{-| The tree re-sorted, the same row chosen. -}
keepChosen : Maybe TreeRow -> Tree -> Tree
keepChosen at t =
    when at is
        Just r ->
            { t | selected = rowIndex r t }

        Nothing ->
            meant Reason.OutOfRange keepSelected t


{-| Commands run, and the tree's lists asked again, its rows kept open and
the chosen one kept, as tmux rebuilds the tree after a kill or a mark. -}
reloadTree : Array String -> Tree -> (taken s : State) -> { state : State, commands : Array String }
reloadTree commands t s =
    let
        chosen =
            Array.get t.selected (treeRows t) |> Maybe.map (\r -> { session = r.session, window = r.window, pane = r.pane })
    in
    sendAsking
        (Array.map (\c -> { command = c, expect = ForRan }) commands
            ++ treeQueries s.version
            ++ (if t.filter == "" then
                    []

                else
                    [ filterQuery t.filter ]
               )
        )
        { s | tree = Just { t | loaded = 0, reload = chosen, tagged = [] } }


{-| A session or a window opened or closed. -}
setOpen : Bool -> TreeRow -> Tree -> Tree
setOpen on r t =
    if r.window < 0 then
        { t
            | open =
                if on then
                    Dict.set r.session True t.open

                else
                    Dict.remove r.session t.open
        }

    else
        { t
            | openWindows =
                if on then
                    Dict.set r.window True t.openWindows

                else
                    Dict.remove r.window t.openWindows
        }


{-| Where a session's or a window's row is now. -}
rowIndex : TreeRow -> Tree -> Int
rowIndex r t =
    Array.findFirst (\x -> x.session == r.session && x.window == r.window && x.pane == r.pane) (treeRows t)
        |> Maybe.map .index
        |> Maybe.withDefault (meant Reason.Gone 0)


{-| A row's key, as tmux's tree mode numbers its rows: `0` to `9`, then
`M-a` to `M-z`; the rows after the 36th have none (TM37). -}
treeRowKey : Int -> Maybe String
treeRowKey i =
    if i < 10 then
        Just (String.fromInt i)

    else if i < 36 then
        Maybe.map (\c -> "M-" ++ String.fromChar c) (Char.fromCode (0x61 + i - 10))

    else
        Nothing


{-| A row chosen: the tree closed and its command run with the session's
or the window's id (`$1`, `@2`), which tmux takes as a target. -}
chooseRow : Maybe TreeRow -> Tree -> (taken s : State) -> { state : State, commands : Array String }
chooseRow row t s =
    when row is
        Just r ->
            runLine { pane = t.pane, mouse = Nothing } (Syntax.fill (Syntax.tokens t.template) [ rowTarget r ]) { s | tree = Nothing }

        Nothing ->
            meant Reason.OutOfRange { state = { s | tree = Nothing }, commands = [] }


{-| Where the tree is drawn in its place (TM86): the list's area (the
place in tmux's look, inset in puritty's), its rows shown and the first
of them, and the preview's area below it when there is one, as
`drawTree` draws them and a press on them is read. -}
treeFrame : Bool -> Layout.Pane -> Tree -> { list : { x : Int, y : Int, w : Int, h : Int }, shown : Int, top : Int, withPreview : Bool, previewArea : { x : Int, y : Int, w : Int, h : Int } }
treeFrame tmuxLook place t =
    let
        listArea =
            if tmuxLook then
                { x = place.x, y = place.y, w = place.w, h = place.h }

            else
                { x = place.x + 2, y = place.y + 1, w = place.w - 4, h = place.h - 2 }

        count =
            Array.length (treeRows t)

        listHeight =
            modeListHeight t.previewMode listArea.h count

        -- at most a window's rows (`Vt.Term`'s 1000), so the rows read
        -- from `top` on stay inside `Int`
        shownRows =
            clamp 1 1000 listHeight

        -- the first row shown, from the selection held to the rows, so
        -- that `top + shownRows` is at most the rows' count or 1000
        held =
            clamp 0 (max 0 (count - 1)) t.selected

        boxRow =
            listArea.y + shownRows
    in
    { list = listArea
    , shown = shownRows
    , top =
        if held < shownRows then
            0

        else
            held - shownRows + 1
    , withPreview = t.preview.target /= "" && listHeight < listArea.h && listArea.w > 4
    , previewArea = { x = listArea.x + 2, y = boxRow + 1, w = listArea.w - 4, h = listArea.h - shownRows - 2 }
    }


{-| A mode's list's height as `mode_tree_set_height` (TM46): two thirds
with the preview, half when the rows are fewer, all when that leaves less
than ten; a quarter with the big preview; all without; and all when the
preview would have less than two rows. -}
modeListHeight : Int -> Int -> Int -> Int
modeListHeight previewMode sy lineCount =
    let
        h0 =
            if previewMode == 1 then
                let
                    twoThirds =
                        (sy // 3) * 2

                    h =
                        if twoThirds > lineCount then
                            sy // 2

                        else
                            twoThirds
                in
                if h < 10 then
                    sy

                else
                    h

            else if previewMode == 2 then
                max 2 (min lineCount (sy // 4))

            else
                sy
    in
    if sy - h0 < 2 then
        sy

    else
        h0


{-| The tree's cells (TM32): in tmux's look as tmux's tree mode lists it,
each row's key in brackets, `+` or `-` for a session folded or open, the
windows under it joined by `├─>` and `└─>`, the chosen row in
`mode-style`; in puritty's, the view's box. Below the list, when there is
room, the chosen row's preview, as tmux draws it (TM35): the list takes a
third of the height, or less with fewer rows. -}
drawTree : Array String -> Colors -> Bool -> Int -> Layout.Pane -> Tree -> Array { row : Int, col : Int, color : String, text : String }
drawTree theme colors tmuxLook version place t =
    let
        rows =
            treeRows t

        frame =
            treeFrame tmuxLook place t

        listArea =
            frame.list

        sy =
            clamp 0 16384 listArea.h

        withPreview =
            frame.withPreview

        -- at most a window's rows (`Vt.Term`'s 1000), so the rows read
        -- from `top` on stay inside `Int`
        shownRows =
            clamp 1 1000 frame.shown

        chosenName =
            Array.get t.selected rows |> Maybe.map .name |> Maybe.withDefault (meant Reason.OutOfRange "")

        -- the order's name, read around as the key steps it (TM77)
        sortName =
            let
                names =
                    sortNames version
            in
            Array.getProven (modBy (Array.length names) t.sort) names

        previewDrawn =
            if withPreview then
                let
                    boxRow =
                        listArea.y + shownRows

                    boxH =
                        sy - shownRows

                    inner =
                        listArea.w - 2

                    -- the box's top line: its name and sort, and the
                    -- filter's state when there is one (`mode_tree_draw`)
                    -- 3.8 names the preview's view (TM46)
                    boxTitle =
                        " "
                            ++ chosenName
                            ++ " (sort: "
                            ++ sortName
                            ++ (if t.reversed then
                                    ", reversed"

                                else
                                    ""
                               )
                            ++ ")"
                            ++ (if version >= 38 then
                                    (if t.info then
                                        " (view: info)"

                                     else
                                        " (view: preview)"
                                    )

                                else
                                    ""
                               )

                    note =
                        if t.filter /= "" then
                            " (filter: "
                                ++ (if t.noMatches then
                                        "no matches"

                                    else
                                        "active"
                                   )
                                ++ ") "

                        else
                            " "

                    heading =
                        if String.count boxTitle <= inner then
                            String.takeFirst inner (boxTitle ++ note)

                        else
                            ""

                    -- tree-mode-border-style (3.8, TM65)
                    edge =
                        if tmuxLook then
                            colors.treeBorder

                        else
                            viewEdgeColor

                    inside =
                        if tmuxLook then
                            "\u{001B}[0m"

                        else
                            viewTextColor

                    box =
                        [ { row = boxRow, col = listArea.x, color = edge, text = "┌" ++ String.repeat inner "─" ++ "┐" }
                        , { row = boxRow, col = listArea.x + 1, color = edge, text = heading }
                        ]
                            ++ (Array.range 1 (boxH - 2)
                                    |> Array.mapAndFlatten
                                        (\r ->
                                            [ { row = boxRow + r, col = listArea.x, color = edge, text = "│" }
                                            , { row = boxRow + r, col = listArea.x + 1, color = inside, text = String.repeat inner " " }
                                            , { row = boxRow + r, col = listArea.x + inner + 1, color = edge, text = "│" }
                                            ]
                                        )
                               )
                            ++ [ { row = boxRow + boxH - 1, col = listArea.x, color = edge, text = "└" ++ String.repeat inner "─" ++ "┘" } ]

                    area =
                        frame.previewArea
                in
                if boxH < 3 then
                    []

                else if t.info && (version == 0 || version >= 38) then
                    box ++ drawInfo theme colors tmuxLook area t.preview

                else
                    box ++ drawPreview theme colors tmuxLook version area t.preview

            else
                []

        -- the first row shown, from the selection held to the rows, so
        -- that `top + shownRows` is at most the rows' count or 1000 (the
        -- frame's `top`, worked out where the checker sees its bounds)
        top =
            let
                held =
                    clamp 0 (max 0 (Array.length rows - 1)) t.selected
            in
            if held < shownRows then
                0

            else
                held - shownRows + 1

        keyWidth =
            if Array.length rows > 10 then
                3

            else
                1

        -- a window's and a pane's number are right-aligned to the widest
        -- at their depth, as tmux's `mode_tree_align` (TM44)
        alignTo depth =
            Array.keepIf (\r -> r.depth == depth) rows |> Array.foldl (\r n -> max n (String.count r.name)) 0

        windowAlign =
            alignTo 1

        paneAlign =
            alignTo 2

        -- a tagged row's name has a `*` after it (TM46)
        tagMark r =
            if Array.member (rowTarget r) t.tagged then
                "*"

            else
                ""

        -- 3.8 draws the branch's arrow as `→`, 3.6 as `>` (measured)
        arrow =
            if version >= 38 then
                "→"

            else
                ">"

        lineOf i r =
            let
                -- tmux pads each key to the longest one shown, and one
                -- space after (measured on 3.4 and 3.8, TM37)
                key =
                    when treeRowKey i is
                        Just k ->
                            if tmuxLook && version > 0 && version < 32 then
                                -- before 3.2: `(0)  ` or `(M-a)`, padded to
                                -- four, or six with more than ten rows
                                -- (`mode_tree_draw`, TM77)
                                String.padRight
                                    (if Array.length rows > 10 then
                                        6

                                     else
                                        4
                                    )
                                    ' '
                                    (if String.count k == 1 then
                                        "(" ++ k ++ ")  "

                                     else
                                        "(" ++ k ++ ")"
                                    )

                            else if tmuxLook then
                                String.padRight (keyWidth + 2) ' ' ("(" ++ k ++ ")") ++ " "

                            else
                                String.padRight keyWidth ' ' k ++ "  "

                        Nothing ->
                            meant Reason.OutOfRange
                                String.repeat
                                    (if tmuxLook then
                                        keyWidth + 3

                                     else
                                        keyWidth + 2
                                    )
                                    " "

                symbol =
                    if not r.children then
                        if r.depth == 0 then
                            "  "

                        else
                            ""

                    else if r.expanded then
                        "- "

                    else
                        "+ "

                branch =
                    if r.depth == 0 then
                        ""

                    else
                        (if r.depth == 2 then
                            (if r.parentLast then
                                "    "

                             else
                                "│   "
                            )

                         else
                            ""
                        )
                            ++ (if r.last then
                                    "└─"

                                else
                                    "├─"
                               )
                            ++ arrow
                            ++ " "

                name =
                    if r.depth == 1 then
                        String.padLeft windowAlign ' ' r.name

                    else if r.depth == 2 then
                        String.padLeft paneAlign ' ' r.name

                    else
                        r.name

                ownSymbol =
                    if not r.children then
                        "  "

                    else if r.expanded then
                        "▾ "

                    else
                        "▸ "
            in
            if tmuxLook then
                { key = key, branch = branch, symbol = symbol, name = name ++ tagMark r, text = r.text, plain = key ++ branch ++ symbol ++ name ++ tagMark r ++ ": " ++ Style.strip r.text }

            else
                { key = key, branch = branch, symbol = symbol, name = name ++ tagMark r, text = r.text, plain = key ++ String.repeat (2 * r.depth) " " ++ ownSymbol ++ name ++ tagMark r ++ ": " ++ Style.strip r.text }

        newer =
            version == 0 || version >= 38

        ink spec =
            Style.sgr (Style.apply (Style.themed theme spec) Style.plain)

        -- a row as 3.8 draws it (`mode_tree_draw`, MODE_TREE_PREFIX_FORMAT,
        -- TM66): the key and branch light grey, `-` red and `+` green, the
        -- name and text in the row's color (cyan when tagged) with the
        -- text's own styles, `: ` light grey; the chosen row all in
        -- mode-style across the pane (`screen_write_clearendofline` with
        -- its background: a real client's screen, since `capture-pane`
        -- leaves out a line's cleared end, color and all)
        piecesOf j i r =
            let
                l =
                    lineOf i r

                rowAt =
                    place.y + j

                base =
                    if tagMark r /= "" then
                        "fg=themecyan"

                    else
                        ""

                symbolPieces =
                    when l.symbol is
                        "- " ->
                            [ { text = "-", color = ink "fg=themered" }, { text = " ", color = ink "fg=themelightgrey" } ]

                        "+ " ->
                            [ { text = "+", color = ink "fg=themegreen" }, { text = " ", color = ink "fg=themelightgrey" } ]

                        other ->
                            [ { text = other, color = ink "fg=themelightgrey" } ]

                pieces =
                    [ { text = l.key ++ l.branch, color = ink "fg=themelightgrey" } ]
                        ++ symbolPieces
                        ++ [ { text = l.name, color = ink base }, { text = ": ", color = ink "fg=themelightgrey" } ]
                        ++ (Style.runs (Style.apply (Style.themed theme base) Style.plain) (Style.themedText theme l.text) |> Array.map (\run -> { text = run.text, color = Style.sgr run.style }))
            in
            if i == t.selected then
                [ { row = rowAt, col = place.x, color = colors.mode, text = clipCells place.w l.plain } ]

            else
                (Array.foldl
                    (\piece acc ->
                        let
                            room =
                                place.w - acc.col
                        in
                        if room <= 0 || piece.text == "" then
                            acc

                        else
                            let
                                cut =
                                    clipCells (min room (cellCount piece.text)) piece.text
                            in
                            { col = acc.col + cellCount cut, out = Array.pushLast { row = rowAt, col = place.x + acc.col, color = piece.color, text = cut } acc.out }
                    )
                    { col = 0, out = [] }
                    pieces
                ).out

        width =
            if tmuxLook then
                place.w

            else
                place.w - 4

        listed =
            Array.slice top (top + shownRows) rows
                |> Array.indexedMap
                    (\j r ->
                        let
                            i =
                                top + j

                            chosen =
                                i == t.selected
                        in
                        { row =
                            (if tmuxLook then
                                place.y

                             else
                                place.y + 1
                            )
                                + j
                        , col =
                            if tmuxLook then
                                place.x

                            else
                                place.x + 2
                        , color =
                            if chosen then
                                if tmuxLook then
                                    colors.mode

                                else
                                    activeTabColor

                            else if tmuxLook then
                                "\u{001B}[0m"

                            else
                                viewTextColor
                        , text = String.padRight width ' ' (String.takeFirst width (lineOf i r).plain)
                        }
                    )

        listed38 =
            Array.slice top (top + shownRows) rows
                |> Array.indexedMap (\j r -> piecesOf j (top + j) r)
                |> Array.flatten
    in
    if tmuxLook then
        Array.range 0 (place.h - 1)
            |> Array.map (\r -> { row = place.y + r, col = place.x, color = "\u{001B}[0m", text = String.repeat place.w " " })
            |> (\cleared ->
                    cleared
                        ++ (if newer then
                                listed38

                            else
                                listed
                           )
                        ++ previewDrawn
               )

    else
        let
            inner =
                place.w - 2

            label =
                " choose "
                    ++ (if t.start == 0 then
                            "a session "

                        else
                            "a window "
                       )

            foot =
                " Enter or a row's key: go  ←→: fold  q: close "
        in
        [ { row = place.y, col = place.x, color = viewEdgeColor, text = "╭" ++ String.takeFirst inner (label ++ String.repeat inner "─") ++ "╮" } ]
            ++ (Array.range 1 (place.h - 2) |> Array.mapAndFlatten (\r -> [ { row = place.y + r, col = place.x, color = viewEdgeColor, text = "│" ++ String.repeat inner " " ++ "│" } ]))
            ++ listed
            ++ previewDrawn
            ++ [ { row = place.y + place.h - 1, col = place.x, color = viewEdgeColor, text = "╰" ++ String.takeFirst inner (foot ++ String.repeat inner "─") ++ "╯" } ]


{-| Where the tree's preview puts each item in its area (TM86): a
session's windows side by side, `<` and `>` marks where there are more; a
window's panes side by side too in tmux's look, as tmux draws them, and
where they are in the window in puritty's; a pane's row its pane alone,
filling the area, in tmux's look (TM88). `each` is the width each item is
given, which tmux before 3.7 centres a pane's label in. As `drawPreview`
draws them and a press on them is read. -}
previewRects : Bool -> { x : Int, y : Int, w : Int, h : Int } -> Preview -> { left : Bool, right : Bool, each : Int, rects : Array { item : PreviewItem, x : Int, y : Int, w : Int, h : Int } }
previewRects tmuxLook area pv =
    let
        paneRow =
            tmuxLook && String.startsWith "%" pv.target

        side =
            previewSideBySide tmuxLook pv

        -- a session's windows as tmux picks them, `<` and `>` where there
        -- are more (TM65)
        span =
            sessionSpan area.w (Array.length pv.items) (activeIndex pv.items) pv.offset

        leftMark =
            side && span.start /= 0 && area.w > 6

        rightMark =
            side && span.end /= Array.length pv.items && area.w > 6

        eachOf =
            (area.w
                - (if leftMark then
                    3

                   else
                    0
                  )
                - (if rightMark then
                    3

                   else
                    0
                  )
            )
                // max 1 (span.end - span.start)

        rects =
            if paneRow then
                Array.takeFirst 1 pv.items |> Array.map (\item -> { item = item, x = area.x, y = area.y, w = area.w, h = area.h })

            else if side then
                let
                    room =
                        area.w
                            - (if leftMark then
                                3

                               else
                                0
                              )
                            - (if rightMark then
                                3

                               else
                                0
                              )

                    visible =
                        max 1 (span.end - span.start)

                    each =
                        room // visible

                    remaining =
                        room - visible * each

                    shown =
                        Array.slice span.start span.end pv.items
                in
                if each <= 0 then
                    []

                else
                    Array.indexedMap
                        (\i item ->
                            { item = item
                            , x =
                                area.x
                                    + (if leftMark then
                                        3

                                       else
                                        0
                                      )
                                    + i * each
                            , y = area.y
                            , w =
                                if i == Array.length shown - 1 then
                                    each + remaining

                                else
                                    max 1 (each - 1)
                            , h = area.h
                            }
                        )
                        shown

            else
                let
                    totalW =
                        max 1 (Array.foldl (\i m -> max m (i.x + i.w)) 1 pv.items)

                    totalH =
                        max 1 (Array.foldl (\i m -> max m (i.y + i.h)) 1 pv.items)
                in
                Array.map
                    (\item ->
                        let
                            x0 =
                                item.x * area.w // totalW

                            x1 =
                                (item.x + item.w) * area.w // totalW

                            y0 =
                                item.y * area.h // totalH

                            y1 =
                                (item.y + item.h) * area.h // totalH
                        in
                        { item = item, x = area.x + x0, y = area.y + y0, w = max 1 (x1 - x0), h = max 2 (y1 - y0) }
                    )
                    pv.items
    in
    { left = leftMark, right = rightMark, each = eachOf, rects = rects }


{-| Whether the preview's items are side by side: a session's windows
always; a window's panes in tmux's look, as tmux draws them (TM88). -}
previewSideBySide : Bool -> Preview -> Bool
previewSideBySide tmuxLook pv =
    pv.session || (tmuxLook && not (String.startsWith "%" pv.target))


{-| The preview in its area (TM35): a session's windows side by side, as
many as fit at ten cells or more; a window's panes where they are in it,
scaled to the area. Each has a top line with its label, the active one's
in the active color, and below it the last lines it shows, cut to its
width by cells. -}
drawPreview : Array String -> Colors -> Bool -> Int -> { x : Int, y : Int, w : Int, h : Int } -> Preview -> Array { row : Int, col : Int, color : String, text : String }
drawPreview theme colors tmuxLook version area pv =
    let
        text =
            if tmuxLook then
                "\u{001B}[0m"

            else
                viewTextColor

        -- an item's label: tree-mode-preview-style on 3.8 (the active one
        -- red, the others blue), display-panes' colors before it, as
        -- tmux 3.6 draws them (TM65)
        edge item =
            if tmuxLook then
                if item.style /= "" then
                    Style.sgr (Style.apply (Style.themed theme item.style) Style.plain)

                else
                    Style.sgr
                        (Style.apply
                            ("fg="
                                ++ (if item.active then
                                        colors.panesActive

                                    else
                                        colors.panes
                                   )
                            )
                            Style.plain
                        )

            else if item.active then
                viewEdgeColor

            else
                "\u{001B}[0;38;5;240;48;5;236m"

        border =
            if tmuxLook then
                colors.treeBorder

            else
                "\u{001B}[0;38;5;240;48;5;236m"

        placed =
            previewRects tmuxLook area pv

        leftMark =
            placed.left

        rightMark =
            placed.right

        marks =
            (if leftMark then
                [ { row = area.y + area.h // 2, col = area.x, color = border, text = "<" } ]
                    ++ (Array.range 0 (area.h - 1) |> Array.map (\j -> { row = area.y + j, col = area.x + 2, color = border, text = "│" }))

             else
                []
            )
                ++ (if rightMark then
                        [ { row = area.y + area.h // 2, col = area.x + area.w - 1, color = border, text = ">" } ]
                            ++ (Array.range 0 (area.h - 1) |> Array.map (\j -> { row = area.y + j, col = area.x + area.w - 3, color = border, text = "│" }))

                    else
                        []
                   )

        rects =
            placed.rects

        -- tmux's look: each item's screen over its whole height, a line
        -- between side-by-side items, and its label boxed in its middle
        -- (`window_tree_draw_session`, `_window`, `_label`, TM88); a
        -- pane's row has no label
        paneRow =
            String.startsWith "%" pv.target

        drawn r =
            if tmuxLook then
                let
                    shown =
                        Array.takeLast r.h r.item.lines

                    padded =
                        shown ++ Array.repeat (max 0 (r.h - Array.length shown)) ""
                in
                Array.indexedMap (\j line -> { row = r.y + j, col = r.x, color = text, text = clipCells r.w line }) padded

            else
                let
                    label =
                        " " ++ r.item.label ++ " "

                    top =
                        clipCells r.w (String.repeat (max 0 ((r.w - String.count label) // 2)) "─" ++ label ++ String.repeat r.w "─")

                    body =
                        r.h - 1

                    shown =
                        Array.takeLast body r.item.lines

                    padded =
                        shown ++ Array.repeat (max 0 (body - Array.length shown)) ""
                in
                Array.pushFirst { row = r.y, col = r.x, color = edge r.item, text = top }
                    (Array.indexedMap (\j line -> { row = r.y + 1 + j, col = r.x, color = text, text = clipCells r.w line }) padded)

        count =
            Array.length rects

        -- the line right of each side-by-side item but the last
        between =
            if tmuxLook && previewSideBySide tmuxLook pv then
                rects
                    |> Array.indexedMap
                        (\i r ->
                            if i < count - 1 then
                                Array.range 0 (area.h - 1) |> Array.map (\j -> { row = area.y + j, col = r.x + r.w, color = border, text = "│" })

                            else
                                []
                        )
                    |> Array.flatten

            else
                []

        labels =
            if tmuxLook && not paneRow then
                Array.mapAndFlatten
                    (\r ->
                        previewLabel version
                            { x = r.x
                            , y = r.y
                            , sx =
                                -- before 3.7 a pane's label is centred in the
                                -- width each pane is given, a window's in its own
                                if version > 0 && version < 37 && not pv.session then
                                    placed.each

                                else
                                    r.w
                            , sy = r.h
                            }
                            pv.session
                            border
                            (edge r.item)
                            r.item.label
                    )
                    rects

            else
                []
    in
    Array.range 0 (area.h - 1)
        |> Array.map (\j -> { row = area.y + j, col = area.x, color = text, text = String.repeat area.w " " })
        |> (\cleared -> cleared ++ Array.mapAndFlatten drawn rects ++ between ++ marks ++ labels)


{-| An item's label in the tree's preview, boxed in its middle as tmux's
`window_tree_draw_label` (TM88). Before 3.7: ` text ` (a window's
` index ` when ` index:name ` is wider than it), the box drawn only with
room on both sides, the label in display-panes' colors. From 3.7: the
label as `tree-mode-preview-format` made it, cut to the width less four,
in a box two cells wider each side, its inside cleared. -}
previewLabel : Int -> { x : Int, y : Int, sx : Int, sy : Int } -> Bool -> String -> String -> String -> Array { row : Int, col : Int, color : String, text : String }
previewLabel version at session borderColor labelColor label =
    let
        sx =
            clamp 0 16384 at.sx

        sy =
            clamp 0 16384 at.sy

        x =
            clamp 0 16384 at.x

        y =
            clamp 0 16384 at.y

        plain =
            "\u{001B}[0m"
    in
    if version > 0 && version < 37 then
        let
            whole =
                " " ++ label ++ " "

            shown =
                if session && textCells whole > sx then
                    " " ++ (Array.getProven 0 (String.split ":" label)) ++ " "

                else
                    whole

            len =
                clamp 0 16384 (textCells shown)

            ox =
                (sx - len + 1) // 2

            oy =
                (sy + 1) // 2

            box =
                if ox > 1 && ox + len < sx - 1 && sy >= 3 then
                    [ { row = y + oy - 1, col = x + ox - 1, color = plain, text = "┌" ++ String.repeat len "─" ++ "┐" }
                    , { row = y + oy, col = x + ox - 1, color = plain, text = "│" }
                    , { row = y + oy, col = x + ox + len, color = plain, text = "│" }
                    , { row = y + oy + 1, col = x + ox - 1, color = plain, text = "└" ++ String.repeat len "─" ++ "┘" }
                    ]

                else
                    []
        in
        if sx == 0 || sy == 1 || len > sx then
            []

        else
            box ++ [ { row = y + oy, col = x + ox, color = labelColor, text = shown } ]

    else if sx < 5 || sy < 3 then
        []

    else
        let
            cut =
                takeCells (sx - 4) label

            width =
                clamp 0 16384 (textCells cut)

            ox =
                (sx - width + 1) // 2

            oy =
                (sy + 1) // 2

            -- 3.8's box takes tree-mode-border-style; 3.7's the default
            edgeColor =
                if version == 0 || version >= 38 then
                    borderColor

                else
                    plain
        in
        if width == 0 then
            []

        else
            [ { row = y + oy - 1, col = x + ox - 2, color = edgeColor, text = "┌" ++ String.repeat (width + 2) "─" ++ "┐" }
            , { row = y + oy, col = x + ox - 2, color = edgeColor, text = "│" ++ String.repeat (width + 2) " " ++ "│" }
            , { row = y + oy + 1, col = x + ox - 2, color = edgeColor, text = "└" ++ String.repeat (width + 2) "─" ++ "┘" }
            , { row = y + oy, col = x + ox, color = labelColor, text = cut }
            ]


{-| The characters of `text` that fit in `n` cells, unpadded. -}
takeCells : Int -> String -> String
takeCells n text =
    String.foldl
        (\c acc ->
            let
                w =
                    textCells (String.fromChar c)
            in
            if acc.full || acc.used + w > n then
                { acc | full = True }

            else
                { acc | used = acc.used + w, text = acc.text ++ String.fromChar c }
        )
        { used = 0, full = False, text = "" }
        text
        |> .text


{-| The cells a string takes: wide characters two, controls none. -}
textCells : String -> Int
textCells text =
    String.foldl
        (\c n ->
            let
                cp =
                    Char.toCode c
            in
            n
                + (if cp < 0x20 || cp == 0x7F then
                    0

                   else if cp < 0x80 then
                    1

                   else
                    Width.width cp
                  )
        )
        0
        text


{-| tmux 3.8's information on the row (`i`, TM65), in the preview's
place: its lines as tmux expanded them, a line across between a pane's,
its window's and its session's with `┼` where the labels' line meets it,
and that line down to the foot, as `window_tree_draw_info` draws them. -}
drawInfo : Array String -> Colors -> Bool -> { x : Int, y : Int, w : Int, h : Int } -> Preview -> Array { row : Int, col : Int, color : String, text : String }
drawInfo theme colors tmuxLook area pv =
    let
        border =
            if tmuxLook then
                colors.treeBorder

            else
                "\u{001B}[0;38;5;240;48;5;236m"

        plain =
            if tmuxLook then
                "\u{001B}[0m"

            else
                viewTextColor

        lines =
            Array.takeFirst area.h pv.info

        drawnLine j line =
            if line == "" then
                [ { row = area.y + j
                  , col = area.x
                  , color = border
                  , text =
                        clipCells area.w
                            (String.repeat 14 "─"
                                ++ (if area.w > 14 then
                                        "┼"

                                    else
                                        ""
                                   )
                                ++ String.repeat area.w "─"
                            )
                  }
                ]

            else if tmuxLook then
                (Array.foldl
                    (\r acc ->
                        let
                            room =
                                area.w - acc.col

                            cut =
                                clipCells (min room (cellCount r.text)) r.text
                        in
                        if room <= 0 then
                            acc

                        else
                            { col = acc.col + cellCount cut, out = Array.pushLast { row = area.y + j, col = area.x + acc.col, color = Style.sgr r.style, text = cut } acc.out }
                    )
                    { col = 0, out = [] }
                    (Style.runs Style.plain (Style.themedText theme line))
                ).out

            else
                [ { row = area.y + j, col = area.x, color = plain, text = clipCells area.w (Style.strip line) } ]

        foot =
            if area.w > 14 then
                Array.range (Array.length lines) (area.h - 1) |> Array.map (\j -> { row = area.y + j, col = area.x + 14, color = border, text = "│" })

            else
                []
    in
    (Array.range 0 (area.h - 1) |> Array.map (\j -> { row = area.y + j, col = area.x, color = plain, text = String.repeat area.w " " }))
        ++ Array.flatten (Array.indexedMap drawnLine lines)
        ++ foot


{-| The time of day in milliseconds at the loop's last reading (`clock`),
from the time tmux gave and the loop's clock since. -}
dayNow : State -> Maybe Int
dayNow s =
    Maybe.map (\d -> modBy 86400000 (d.ms + Clock.since d.clock s.clock)) s.dayAt


{-| The time of day for the clock, `HH:MM`, from the loop's clock and the
offset tmux's own time gave; empty until it is known. -}
clockText : State -> String
clockText s =
    when dayNow s is
        Just day ->
            let
                seconds =
                    day // 1000

                hour =
                    seconds // 3600

                minute =
                    modBy 60 (seconds // 60)

                two n =
                    String.padLeft 2 '0' (String.fromInt n)

                -- clock-mode-style as window-clock.c writes it (TM51):
                -- `24` HH:MM, `12` with `%l` (a space before one digit)
                -- and AM or PM, either `-with-seconds`
                style =
                    Maybe.withDefault (meant Reason.NotSet "24") (Dict.get "clock-mode-style" s.status.options)

                withSeconds =
                    String.endsWith "-with-seconds" style

                secs =
                    if withSeconds then
                        ":" ++ two (modBy 60 seconds)

                    else
                        ""
            in
            if String.startsWith "12" style then
                String.padLeft 2
                    ' '
                    (String.fromInt
                        (if modBy 12 hour == 0 then
                            12

                         else
                            modBy 12 hour
                        )
                    )
                    ++ ":"
                    ++ two minute
                    ++ secs
                    ++ " "
                    ++ (if hour >= 12 then
                            "PM"

                        else
                            "AM"
                       )

            else
                two hour ++ ":" ++ two minute ++ secs

        Nothing ->
            meant Reason.NotYet ""


{-| What a pane in one of tmux's modes shows (TM32): the clock (`clock-mode`)
as tmux draws it, its digits five cells square in `clock-mode-color`
(blue) in the pane's middle, amber in puritty's look; for a mode puritty
does not draw (`tree-mode` entered otherwise than by a binding,
`buffer-mode`, `client-mode`, `options-mode`), a line in the pane's middle
that says so and how to leave it, since tmux has the pane's keys. Copy and
view mode are drawn elsewhere (TM31). -}
modeOverlay : Colors -> Bool -> Bool -> String -> String -> Layout.Pane -> Array { row : Int, col : Int, color : String, text : String }
modeOverlay colors tmuxLook isActive mode time p =
    if mode == "" || mode == "copy-mode" || mode == "view-mode" then
        []

    else if mode == "clock-mode" then
        let
            -- clock-mode-colour (TM51)
            block =
                if tmuxLook then
                    Style.sgr (Style.apply ("bg=" ++ colors.clock) Style.plain)

                else
                    "\u{001B}[0;48;5;214m"

            ink =
                if tmuxLook then
                    Style.sgr (Style.apply ("fg=" ++ colors.clock) Style.plain)

                else
                    "\u{001B}[0;1;38;5;214m"

            len =
                String.count time

            emptied =
                Array.range 0 (p.h - 1) |> Array.map (\r -> { row = p.y + r, col = p.x, color = "\u{001B}[0m", text = String.repeat p.w " " })
        in
        if time == "" then
            emptied

        else if p.w < len * 6 || p.h < 5 then
            emptied ++ [ { row = p.y + p.h // 2, col = p.x + max 0 ((p.w - len) // 2), color = ink, text = String.takeFirst p.w time } ]

        else
            let
                px =
                    p.x + p.w // 2 - len * 3

                py =
                    p.y + p.h // 2 - 2
            in
            emptied
                ++ (String.toArray time
                        |> Array.indexedMap
                            (\i c ->
                                (if c == ':' then
                                    [ "00000", "00100", "00000", "00100", "00000" ]

                                 else
                                    bigDigit c
                                )
                                    |> Array.indexedMap
                                        (\r line ->
                                            String.toArray line
                                                |> Array.indexedMap (\col bit -> { row = py + r, col = px + i * 6 + col, on = bit == '1' })
                                                |> Array.keepIf .on
                                        )
                                    |> Array.flatten
                            )
                        |> Array.flatten
                        |> Array.map (\cell -> { row = cell.row, col = cell.col, color = block, text = " " })
                   )

    else
        let
            text =
                String.takeFirst p.w (" tmux's " ++ mode ++ " is not drawn under -CC; q leaves it ")
        in
        [ { row = p.y + p.h // 2
          , col = p.x + max 0 ((p.w - String.count text) // 2)
          , color =
                if tmuxLook then
                    colors.mode

                else
                    activeTabColor
          , text = text
          }
        ]


-- COPY MODE (TM31)


{-| What puritty asks of a pane in copy mode, one line: `C %pane` then
`scroll_position`, `history_size`, the cursor, whether there is a
selection and its ends, `rectangle_toggle`, the search's state, the top
line's time (from 3.6, `top_line_time`; an empty word before, TM103) and
the search string. -}
copyFormat : Int -> String
copyFormat version =
    if version == 0 || version >= 36 then
        "C #{pane_id} #{scroll_position} #{history_size} #{copy_cursor_x} #{copy_cursor_y} #{selection_present} #{selection_start_x} #{selection_start_y} #{selection_end_x} #{selection_end_y} #{rectangle_toggle} #{search_present} #{search_count} #{search_count_partial} #{search_timed_out} #{t/p:top_line_time} #{pane_search_string}"

    else
        "C #{pane_id} #{scroll_position} #{history_size} #{copy_cursor_x} #{copy_cursor_y} #{selection_present} #{selection_start_x} #{selection_start_y} #{selection_end_x} #{selection_end_y} #{rectangle_toggle} #{search_present} #{search_count} #{search_count_partial} #{search_timed_out}  #{pane_search_string}"


inCopy : Int -> State -> Bool
inCopy pane s =
    String.startsWith "copy-mode" (Maybe.withDefault (meant Reason.NotYet "") (Dict.get pane s.modes))


{-| A pane in copy mode asked where it is; if a question is out already,
asked again once it is answered, so that the last answer is after the
last key. -}
askCopy : Int -> (taken acc : Acc) -> Acc
askCopy pane acc =
    let
        st =
            acc.state
    in
    if Dict.get pane st.copyAsked /= Nothing then
        -- asked and not yet answered: asked again when it is
        { acc | state = { st | copyAsked = Dict.set pane True st.copyAsked } }

    else
        ask [ { command = Command.displayAt (paneName pane) (copyFormat st.version), expect = ForCopy pane } ] { acc | state = { st | copyAsked = Dict.set pane False st.copyAsked } }


{-| A search's matches in the panes in copy mode, where they show, as
tmux marks them (TM41): each in copy-mode-match-style, the one at the
cursor in copy-mode-current-match-style. tmux searches with a regular
expression for `/` and `?`, which puritty does not have: a search with
any of a regular expression's special characters is not marked, its
count still said. -}
searchMarks : Colors -> Array Layout.Pane -> State -> Array { row : Int, col : Int, color : String, text : String }
searchMarks colors panes s =
    Array.mapAndFlatten
        (\p ->
            when Dict.get p.id s.copy is
                Just c ->
                    if c.marked && c.search /= "" && not (String.any (\ch -> String.contains (String.fromChar ch) ".[]()*+?{}|^$\\") c.search) then
                        withPane p.id
                            s
                            (\t ->
                                let
                                    top =
                                        Vt.rowsPushed t - backOf p.id s

                                    cursorRow =
                                        top + c.cy
                                in
                                Search.matchesIn c.search top (top + p.h - 1) t
                                    |> Array.keepIf (\m -> m.start.col < p.w)
                                    |> Array.map
                                        (\m ->
                                            { row = p.y + m.start.row - top
                                            , col = p.x + m.start.col
                                            , color =
                                                if m.start.row == cursorRow && m.start.col <= c.cx && c.cx <= m.end.col then
                                                    colors.currentMatch

                                                else
                                                    colors.match
                                            , text = Vt.selectionText m.start m.end t
                                            }
                                        )
                            )
                            |> Maybe.withDefault (meant Reason.Gone [])

                    else
                        []

                Nothing ->
                    meant Reason.NotOpen []
        )
        panes


{-| The panes a layout places. -}
layoutIds : Maybe Layout.Cell -> Array Int
layoutIds layout =
    when layout is
        Just cell ->
            Array.map .id (Layout.panes cell)

        Nothing ->
            meant Reason.NotYet []


{-| The ids `panesQuery`'s answer lists. -}
listedPanes : Array Bytes -> Array Int
listedPanes lines =
    Array.mapAndKeepJust
        (\line ->
            when String.split " " (Bytes.toStringLossy line) is
                [ "P", id ] ->
                    Just (idOf id)

                _ ->
                    Nothing
        )
        lines


{-| Every pane the session's answer does not list forgotten (TM110, the
code review's TA8): its terminal, and all puritty kept of it. -}
forgetGone : Array Int -> (taken s : State) -> State
forgetGone listed s =
    let
        gone =
            Array.keepIf (\i -> not (Array.member i listed)) s.ids

        stay =
            keepPanes listed s.ids 0 s.panes { ids = [], panes = Builder.empty 0 }

        status =
            s.status
    in
    Array.foldl forgetPane
        { s
            | ids = stay.ids
            , panes = stay.panes
            , info = Dict.keepIf (\i _ -> Array.member i listed) s.info
            , nested = Dict.keepIf (\i _ -> Array.member i listed) s.nested
            , entryHeld = Dict.keepIf (\i _ -> Array.member i listed) s.entryHeld
            , scans = Dict.keepIf (\i _ -> Array.member i listed) s.scans
            , status = { status | panes = Dict.keepIf (\i _ -> Array.member i listed) status.panes }
        }
        gone


{-| The terminals of the listed panes, with their ids, each moved out of
the old builder in turn: a loop, so that the compiler sees the ids and the
terminals kept as many as each other (TM34). -}
keepPanes : Array Int -> Array Int -> Int -> (taken old : Builder Vt.Term) -> (taken acc : { ids : Array Int, panes : Builder Vt.Term } where Array.length acc.ids == Builder.length acc.panes) -> (r : { ids : Array Int, panes : Builder Vt.Term } where Array.length r.ids == Builder.length r.panes)
keepPanes listed ids i old acc =
    when Array.get i ids is
        Just id ->
            if Array.member id listed then
                let
                    out =
                        Builder.swap i (blank 1 1) old
                in
                when out.old is
                    Just term ->
                        keepPanes listed ids (i + 1) out.builder { ids = Array.pushLast id acc.ids, panes = Builder.pushLast term acc.panes }

                    Nothing ->
                        meant Reason.OutOfRange keepPanes listed ids (i + 1) out.builder acc

            else
                keepPanes listed ids (i + 1) old acc

        Nothing ->
            meant Reason.NoMore acc


{-| Whether anything of copy mode is kept for a pane: its state, or a
question about it (for the tests; the code review's TA17). -}
copyKept : Int -> State -> Bool
copyKept pane s =
    Dict.member pane s.copy || Dict.member pane s.copyAsked


{-| When a clock a pane shows is next drawn again, as the minute turns or
the second when it shows seconds; -1 for none. Only the panes of the
window shown: a clock in a window not shown, or in a pane gone that tmux
said nothing of, does not wake the loop (the code review's TB13). -}
clockAt : State -> Int
clockAt s =
    if s.dayAt /= Nothing && Array.any (\id -> Dict.get id s.paneModes == Just "clock-mode") (layoutIds s.layout) then
        let
            step =
                if String.endsWith "-with-seconds" (Maybe.withDefault (meant Reason.NotSet "") (Dict.get "clock-mode-style" s.status.options)) then
                    1000

                else
                    60000
        in
        Clock.after s.clock (step - modBy step (Maybe.withDefault (meant Reason.NotSet 0) (dayNow s)))

    else
        -1


{-| A pane that is gone, out of every map kept by pane (TM103). -}
forgetPane : Int -> (taken s : State) -> State
forgetPane pane s =
    { s
        | copy = Dict.remove pane s.copy
        , copyAsked = Dict.remove pane s.copyAsked
        , back = Dict.remove pane s.back
        , modes = Dict.remove pane s.modes
        , paneModes = Dict.remove pane s.paneModes
    }


{-| An answer to `copyFormat`: the pane's copy mode kept, and its view
scrolled back as far as tmux's, as far as puritty's own history goes. -}
copyLine : Bytes -> (taken s : State) -> State
copyLine bytes s =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)

        num i =
            Maybe.withDefault (meant Reason.FromOutside 0) (Maybe.andThen String.toInt (Array.get i words))
    in
    when Array.get 0 words is
        Just "C" ->
            let
                pane =
                    idOf (Maybe.withDefault (meant Reason.FromOutside "") (Array.get 1 words))

                answered =
                    { s | copyAsked = Dict.remove pane s.copyAsked }
            in
            if Maybe.andThen String.toInt (Array.get 2 words) == Nothing || not (inCopy pane answered) then
                -- not in copy mode (any more): its view is the live screen
                -- again; this answer can come before `pane-mode-changed`'s,
                -- which then finds no copy mode to clear (TM101)
                { answered | copy = Dict.remove pane answered.copy, back = Dict.remove pane answered.back }

            else
                let
                    -- empty before 3.1, which does not say (TK8)
                    located =
                        Maybe.andThen String.toInt (Array.get 4 words) /= Nothing

                    c =
                        { scroll = num 2
                        , hsize = num 3
                        , located = located
                        , cx = num 4
                        , cy = num 5
                        , selection =
                            if located && num 6 == 1 then
                                Just { sx = num 7, sy = num 8, ex = num 9, ey = num 10 }

                            else
                                Nothing
                        , rectangle = num 11 == 1
                        , marked = num 12 == 1
                        , count = num 13
                        , partial = num 14 == 1
                        , timedOut = num 15 == 1
                        , lineTime = Maybe.withDefault (meant Reason.FromOutside "") (Array.get 16 words)
                        , search = String.join " " (Array.dropFirst 17 words)
                        }

                    most =
                        Maybe.withDefault (meant Reason.Gone 0) (withPane pane answered Vt.scrollbackRows)
                in
                { answered | copy = Dict.set pane c answered.copy, back = Dict.set pane (min most c.scroll) answered.back }

        _ ->
            meant Reason.FromOutside s


-- VIEWS (TM26)


{-| tmux's message log (`show-messages`) as a terminal client's would
read (TM65): tmux logs every command a client sends, and most of
puritty's are its own (the keys sent on, its questions, its
subscriptions), which a terminal client does not send. A line
`TIME: NAME command: COMMAND` of this client's is left out unless the
user ran the command; its keys' lines (`NAME key C-a: …`) stay. Other
output has no such line and is left as it is. -}
ownCommandsOut : State -> Array Bytes -> Array Bytes
ownCommandsOut s lines =
    if s.clientName == "" then
        lines

    else
        let
            marker =
                ": " ++ s.clientName ++ " command: "

            -- quotes and spacing as tmux prints a command, not as sent
            plain text =
                String.toArray text
                    |> Array.keepIf (\c -> c /= '"' && c /= '\'' && c /= '\\')
                    |> String.fromArray
                    |> String.words
                    |> String.join " "

            ran =
                Array.map plain s.userRan

            keep line =
                let
                    text =
                        Bytes.toStringLossy line
                in
                when String.firstIndexOf marker text is
                    Just at ->
                        if at > 20 then
                            True

                        else
                            let
                                command =
                                    plain (String.dropFirst (at + String.count marker) text)
                            in
                            Array.any (\r -> String.contains command r) ran

                    Nothing ->
                        meant Reason.NotKnown True
        in
        Array.keepIf keep lines


{-| A view of lines tmux printed, at its first line: tabs to the next
column of eight, other control characters as spaces, so that nothing
printed is read as a terminal's sequence when it is drawn. -}
viewOf : Array Bytes -> View
viewOf lines =
    let
        all =
            Array.map (\line -> shownLine (Bytes.toStringLossy line)) lines
    in
    { lines = all, top = 0, rows = 1, all = all, filter = "", filtering = False }


{-| The view's lines with `filter` in them, its case aside (TM36), from
the top. -}
filtered : String -> View -> View
filtered text v =
    let
        lower =
            String.toLower text
    in
    { v
        | filter = text
        , lines =
            if text == "" then
                v.all

            else
                Array.keepIf (\line -> String.contains lower (String.toLower line)) v.all
        , top = 0
    }


{-| Text with its control characters (C0, DEL, C1) as spaces, one for
one, so that its width is as drawn (TM118). -}
inert : String -> String
inert text =
    if String.any (\c -> Char.toCode c < 0x20 || Char.toCode c == 0x7F || (Char.toCode c >= 0x80 && Char.toCode c < 0xA0)) text then
        String.map
            (\c ->
                if Char.toCode c < 0x20 || Char.toCode c == 0x7F || (Char.toCode c >= 0x80 && Char.toCode c < 0xA0) then
                    ' '

                else
                    c
            )
            text

    else
        text


{-| A line's start, enough of it for `n` cells (review TB10): a tab is
eight at most, and a character no cell only where most are combining
marks, so `4 n + 64` characters, cut before a long line, a buffer's
copied minified file, is walked whole at every frame. -}
aboutCells : Int -> String -> String
aboutCells n text =
    String.takeFirst (4 * max 0 n + 64) text


shownLine : String -> String
shownLine text =
    String.toArray text
        |> Array.foldl
            (\c acc ->
                if c == '\t' then
                    acc ++ String.toArray (String.repeat (8 - modBy 8 (Array.length acc)) " ")

                else if Char.toCode c < 0x20 || Char.toCode c == 0x7F || (Char.toCode c >= 0x80 && Char.toCode c < 0xA0) then
                    Array.pushLast ' ' acc

                else
                    Array.pushLast c acc
            )
            []
        |> String.fromArray


{-| A key while a view is open: q, Escape or C-c closes it; the rest move
it as copy mode's keys do, vi's and emacs's both: a line (Up, Down, k, j,
C-p, C-n, C-y, C-e, Enter), a page (PPage, NPage, C-b, C-f, Space), half
a page (C-u, C-d), the top (g, Home, M-<) and the bottom (G, End, M->).
`/` filters it (TM36): what is typed keeps the lines with it in them,
Backspace takes a character back and C-u all of them, Enter keeps the
filter and gives the keys back to moving, Escape clears it; Escape with a
filter kept clears it before it closes the view. -}
viewKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> View -> Maybe View
viewKey k v =
    let
        name =
            Maybe.withDefault (meant Reason.NotKnown "") (lookupName k)
    in
    if v.filtering then
        if name == "Escape" || name == "C-c" then
            Just (filtered "" { v | filtering = False })

        else if name == "Enter" || name == "KPEnter" || name == "C-m" then
            Just { v | filtering = False }

        else if name == "BSpace" || name == "C-h" then
            Just (filtered (String.dropLast 1 v.filter) v)

        else if name == "C-u" then
            Just (filtered "" v)

        else
            let
                added =
                    viewText (Bytes.toStringLossy k.text)
            in
            if added /= "" && Bitwise.and k.mods 6 == 0 then
                Just (filtered (v.filter ++ added) v)

            else
                Just v

    else if name == "/" then
        Just { v | filtering = True }

    else if name == "Escape" && v.filter /= "" then
        Just (filtered "" v)

    else
        moveView name v


{-| Text for the filter: printable characters only. -}
viewText : String -> String
viewText text =
    String.toArray text
        |> Array.keepIf (\c -> Char.toCode c >= 0x20 && Char.toCode c /= 0x7F)
        |> String.fromArray


moveView : String -> View -> Maybe View
moveView name v =
    let
        page =
            max 1 (v.rows - 2)

        half =
            max 1 (v.rows // 2)

        last =
            max 0 (Array.length v.lines - v.rows)

        to n =
            Just { v | top = max 0 (min last n) }
    in
    if name == "q" || name == "Escape" || name == "C-c" then
        Nothing

    else if Array.member name [ "Up", "k", "C-p", "C-y" ] then
        to (v.top - 1)

    else if Array.member name [ "Down", "j", "C-n", "C-e", "Enter" ] then
        to (v.top + 1)

    else if Array.member name [ "PPage", "C-b", "b" ] then
        to (v.top - page)

    else if Array.member name [ "NPage", "C-f", "Space", "f" ] then
        to (v.top + page)

    else if name == "C-u" then
        to (v.top - half)

    else if name == "C-d" then
        to (v.top + half)

    else if Array.member name [ "g", "Home", "M-<" ] then
        to 0

    else if Array.member name [ "G", "End", "M->" ] then
        to last

    else
        Just v


{-| The view in tmux's look: over the active pane, its lines from the
pane's top and tmux's position, `[N/M]` in `mode-style` at the top right,
N the lines below the view and M those that do not fit, as tmux counts
them (measured on 3.8: `prefix ?` opens at `[70/70]` in a pane of 23 rows
over 93 lines). -}
tmuxView : Colors -> Layout.Pane -> View -> { rows : Int, pieces : Array { row : Int, col : Int, color : String, text : String } }
tmuxView colors p v =
    let
        hidden =
            max 0 (Array.length v.lines - p.h)

        top =
            clamp 0 hidden v.top

        -- the lines in view, taken without adding to `top`
        inView =
            Array.dropFirst top v.lines

        position =
            "[" ++ String.fromInt (hidden - top) ++ "/" ++ String.fromInt hidden ++ "]"

        rowsOf =
            Array.range 0 (p.h - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        [ { row = p.y + r, col = p.x, color = "\u{001B}[0m", text = String.repeat p.w " " }
                        , { row = p.y + r, col = p.x, color = "\u{001B}[0m", text = String.takeFirst p.w (Maybe.withDefault (meant Reason.OutOfRange "") (Array.get r inView)) }
                        ]
                    )
    in
    { rows = p.h
    , pieces =
        rowsOf
            ++ (if String.count position <= p.w then
                    [ { row = p.y, col = p.x + p.w - String.count position, color = colors.mode, text = position } ]

                else
                    []
               )
            ++ (if v.filtering || v.filter /= "" then
                    [ { row = p.y + p.h - 1, col = p.x, color = colors.mode, text = String.takeFirst p.w (String.padRight p.w ' ' (filterLine v)) } ]

                else
                    []
               )
    }


{-| The filter as the view shows it: what is typed, and how many lines
have it. -}
filterLine : View -> String
filterLine v =
    "/"
        ++ v.filter
        ++ (if v.filtering then
                "▏"

            else
                ""
           )
        ++ "  "
        ++ String.fromInt (Array.length v.lines)
        ++ " of "
        ++ String.fromInt (Array.length v.all)
        ++ (if v.filtering then
                "  Enter: keep  Esc: clear"

            else
                "  Esc: clear"
           )


{-| The view in puritty's look: a box over the panes, as wide as its
longest line allows, its keys and where it is on the bottom edge. -}
boxView : (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> Bool -> View -> { rows : Int, pieces : Array { row : Int, col : Int, color : String, text : String } }
boxView cols rows barTop v =
    let
        areaTop =
            if barTop then
                bar

            else
                0

        areaH =
            rows - bar

        -- sized by every line, so that the box stays where it is as the
        -- filter keeps fewer
        longest =
            Array.foldl (\line m -> max m (String.count line)) 0 v.all

        w =
            max 4 (min cols (max 40 (longest + 4)))

        h =
            max 3 (min areaH (min 1000 (Array.length v.all) + 2))

        inner =
            h - 2

        x0 =
            (cols - w) // 2

        y0 =
            areaTop + (areaH - h) // 2

        last =
            max 0 (Array.length v.lines - inner)

        top =
            clamp 0 last v.top

        -- the lines in view, taken without adding to `top`
        inView =
            Array.dropFirst top v.lines

        shown =
            if Array.length v.lines > inner then
                " " ++ String.fromInt (top + 1) ++ "-" ++ String.fromInt (top + inner) ++ " of " ++ String.fromInt (Array.length v.lines) ++ " "

            else
                ""

        foot =
            String.takeFirst (w - 2)
                (if v.filtering || v.filter /= "" then
                    " " ++ filterLine v ++ " "

                 else
                    " q: close  /: filter "
                        ++ (if shown == "" then
                                ""

                            else
                                "─" ++ shown
                           )
                )

        edge left mid right label =
            left ++ label ++ String.repeat (max 0 (w - 2 - String.count label)) mid ++ right

        body =
            Array.range 0 (inner - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        [ { row = y0 + 1 + r, col = x0, color = viewEdgeColor, text = "│" ++ String.repeat (w - 2) " " }
                        , { row = y0 + 1 + r, col = x0 + 2, color = viewTextColor, text = String.takeFirst (w - 4) (Maybe.withDefault (meant Reason.OutOfRange "") (Array.get r inView)) }
                        , { row = y0 + 1 + r, col = x0 + w - 1, color = viewEdgeColor, text = "│" }
                        ]
                    )
    in
    { rows = inner
    , pieces =
        [ { row = y0, col = x0, color = viewEdgeColor, text = edge "╭" "─" "╮" " tmux " } ]
            ++ body
            ++ [ { row = y0 + h - 1, col = x0, color = viewEdgeColor, text = edge "╰" "─" "╯" foot } ]
    }


{-| A view's box in puritty's look: amber edges, on the tab bar's dark
band. -}
viewEdgeColor : String
viewEdgeColor =
    "\u{001B}[0;38;5;214;48;5;236m"


viewTextColor : String
viewTextColor =
    "\u{001B}[0;38;5;252;48;5;236m"


{-| Text written in the canvas in a color (TM21): each piece at its row
and column, with autowrap off (`paint` turns it off), so nothing moves.
A piece's text is what tmux sent (a status line's part, a tree's or a
list's row, a menu item, a message), and its control characters (C0, DEL,
C1) are written as spaces, so that one in a directory's or a program's
name does not run in the canvas (the code review's TB6, TM118). -}
drawText : String -> Array { row : Int, col : Int, text : String } -> (taken t : Vt.Term) -> Vt.Term
drawText color pieces t =
    if Array.isEmpty pieces then
        t

    else
        Vt.feed
            (Bytes.fromString
                (String.join ""
                    (Array.map
                        (\p -> "\u{001B}[" ++ String.fromInt (p.row + 1) ++ ";" ++ String.fromInt (p.col + 1) ++ "H" ++ color ++ inert p.text ++ "\u{001B}[0m")
                        pieces
                    )
                )
            )
            t


{-| The colors of what puritty draws around tmux's panes, from the 256
colors: the lines between tiled panes a quiet gray, a floating pane's box
gray and the active pane's in puritty's amber, the tab bar a dark band and
its active tab amber with dark text. -}
lineColor : String
lineColor =
    "\u{001B}[0;38;5;240m"


boxColor : String
boxColor =
    "\u{001B}[0;38;5;245m"


activeColor : String
activeColor =
    "\u{001B}[0;38;5;214m"


{-| copy-mode-match-style's default, and copy-mode-current-match-style's
(TM41). -}
matchColor : String
matchColor =
    "\u{001B}[0;30;46m"


currentMatchColor : String
currentMatchColor =
    "\u{001B}[0;30;45m"


{-| tmux's `message-style` by default, black on yellow: a prompt or a
message in tmux's look (TM25). -}
messageColor : String
messageColor =
    "\u{001B}[0;30;43m"


barColor : String
barColor =
    "\u{001B}[0;38;5;250;48;5;236m"


activeTabColor : String
activeTabColor =
    "\u{001B}[0;1;38;5;234;48;5;214m"


{-| A tab whose window rang its bell, white on red, and one with activity
or silence, amber on the bar (TM30). -}
alertTabColor : String
alertTabColor =
    "\u{001B}[0;1;38;5;231;48;5;160m"


busyTabColor : String
busyTabColor =
    "\u{001B}[0;38;5;214;48;5;236m"


{-| The marked pane's frame in puritty's look, magenta, as tmux 3.8 draws
the marked pane's border (TM30). -}
markedColor : String
markedColor =
    "\u{001B}[0;38;5;170m"


{-| A drag of files over the window (docs/sftp.md FT23): the pane under
the cell is marked, and when the drag comes to a pane it was not over,
tmux is asked where its folder is. Off every pane, no mark. -}
dragOver : { col : Int, row : Int, ms : Int } -> (taken s : State) -> { state : State, commands : Array String, changed : Bool }
dragOver at s =
    let
        under =
            when s.layout is
                Just cell ->
                    placedPanes s cell (Array.reverse (Layout.floating cell) ++ Layout.tiled cell)
                        |> Array.findFirst (\q -> at.col >= q.x && at.col < q.x + q.w && at.row >= q.y && at.row < q.y + q.h)
                        |> Maybe.map (\f -> f.value.id)

                Nothing ->
                    meant Reason.NotYet Nothing

        was =
            Maybe.map .pane s.dropMark

        askFolder id mark st =
            askLine
                (Array.indexedMap (\i format -> { command = Command.displayAt ("%" ++ String.fromInt id) format, expect = ForDropFolder { pane = id, part = i } }) dropParts)
                { state = { st | dropMark = Just mark }, outside = [], commands = [], trace = [], run = Nothing }
    in
    when under is
        Just id ->
            when s.dropMark is
                Just d ->
                    if d.pane == id then
                        -- the same pane, asked over a second ago, its answer in:
                        -- asked again, the folder shown kept till it is answered
                        if not d.inFlight && Clock.since d.askedAt at.ms >= 1000 then
                            let
                                r =
                                    askFolder id { d | parts = [], inFlight = True, askedAt = at.ms } s
                            in
                            { state = r.state, commands = r.commands, changed = False }

                        else
                            { state = s, commands = [], changed = False }

                    else
                        let
                            r =
                                askFolder id { pane = id, folder = Asking [], parts = [], inFlight = True, askedAt = at.ms } s
                        in
                        { state = r.state, commands = r.commands, changed = True }

                Nothing ->
                    -- no pane marked yet
                    meant Reason.NotOpen
                        (let
                            r =
                                askFolder id { pane = id, folder = Asking [], parts = [], inFlight = True, askedAt = at.ms } s
                         in
                         { state = r.state, commands = r.commands, changed = True }
                        )

        Nothing ->
            -- not over a pane: a divider, the tab bar
            meant Reason.OutOfRange { state = { s | dropMark = Nothing }, commands = [], changed = was /= Nothing }


{-| The pane a drag is over marked (docs/sftp.md FT6, FT23): its first row
a label saying where the files would go, the rest of it drawn inverse. -}
dropMarked : Array Layout.Pane -> Maybe DropMark -> (taken t : Vt.Term) -> Vt.Term
dropMarked placed mark t =
    when mark |> Maybe.andThen (\d -> Array.findFirst (\p -> p.id == d.pane) placed |> Maybe.map (\f -> { folder = d.folder, at = f.value })) is
        Just m ->
            t
                |> Vt.invert (Array.map (\r -> { row = r, from = m.at.x, to = m.at.x + m.at.w - 1 }) (Array.range (m.at.y + 1) (m.at.y + m.at.h - 1)))
                |> drawText "\u{001B}[1;30;43m" [ { row = m.at.y, col = m.at.x, text = takeCells m.at.w (dropLabel m.at.w m.folder ++ String.repeat m.at.w " ") } ]

        Nothing ->
            -- no drag over a pane
            meant Reason.NotOpen t


{-| The mark's label, in `width` cells: a folder too long for it keeps as
many of its last names as fit after `/…/`, and a last name too long by
itself loses its middle, as the folder picker's paths do (docs/sftp.md
FT32). -}
dropLabel : Int -> DropFolder -> String
dropLabel width folder =
    when folder is
        Asking _ ->
            " Drop here: asking tmux for the folder "

        Folder path ->
            let
                whole =
                    Bytes.toStringLossy path

                fits text =
                    textCells (" Drop into " ++ text ++ " ") <= width
            in
            if fits whole then
                " Drop into " ++ whole ++ " "

            else
                " Drop into " ++ pathFitting fits whole ++ " "

        NoFolder why ->
            " Drop here: " ++ why ++ "; a folder will be asked "


{-| A path that does not fit, as `/…/` and the most of its last names
that do; the last name's middle left out when it alone does not. -}
pathFitting : (String -> Bool) -> String -> String
pathFitting fits whole =
    let
        names =
            String.split "/" whole |> Array.keepIf (\n -> n /= "")

        lastNames n =
            "/…/" ++ String.join "/" (Array.takeLast n names)

        -- the most last names that fit, by halves (review PS8); a path of
        -- one name has that one to cut
        most =
            mostFitting (\n -> fits (lastNames n)) 1 (max 1 (Array.length names - 1))

        name =
            String.join "" (Array.takeLast 1 names)
    in
    if most > 1 || fits (lastNames 1) then
        lastNames most

    else
        middleFitting fits name


{-| A name too long, as `/…/`, its start, `…` and its end, the longest that
fits; its end kept the longer, where dates and versions are. -}
middleFitting : (String -> Bool) -> String -> String
middleFitting fits name =
    let
        tried keep =
            let
                start =
                    keep // 5 * 2
            in
            "/…/" ++ String.takeFirst start name ++ "…" ++ String.takeLast (keep - start) name
    in
    tried (mostFitting (\keep -> fits (tried keep)) 2 (String.count name))


{-| The most, from `lo` to `hi`, for which `fits` holds, by halves: a few
measures, not one for each name or character dropped; `lo` when none
does. -}
mostFitting : (Int -> Bool) -> Int -> Int -> Int
mostFitting fits lo hi =
    if lo >= hi then
        lo

    else
        let
            mid =
                (lo + hi + 1) // 2
        in
        if fits mid then
            mostFitting fits mid hi

        else
            mostFitting fits lo (mid - 1)


{-| The drag left the window, or was dropped: no mark. -}
dragLeft : (taken s : State) -> State
dragLeft s =
    { s | dropMark = Nothing }


{-| Where a drop would go: the pane marked and its folder. -}
dropTarget : State -> Maybe { pane : Int, folder : DropFolder }
dropTarget s =
    Maybe.map (\d -> { pane = d.pane, folder = d.folder }) s.dropMark


{-| What tmux is asked of a pane for a drop, a command each, since tmux's
answer makes a control character such as a tab `_`: the folder tmux reads
for its foreground process, that process's name, the shell's own word by
OSC 7 (`pane_path`, a `file://` URI with its host), and the host's name,
long and short. -}
dropParts : Array String
dropParts =
    [ "#{pane_current_path}", "#{pane_current_command}", "#{pane_path}", "#{host}", "#{host_short}" ]


{-| The folder from tmux's answer (docs/sftp.md FT11's rule): the shell's
own by OSC 7 when its host is tmux's; else the foreground process's, unless
that is a program that goes to another host or user, whose folder tmux
can't see (it reads `/proc`, and a root process's is closed to it); else
none. -}
dropFolderOf : Array Bytes -> DropFolder
dropFolderOf parts =
    let
        part n =
            Array.get n parts |> Maybe.withDefault (meant Reason.FromOutside Bytes.empty)

        command =
            Bytes.toStringLossy (part 1)

        host =
            part 3

        short =
            part 4

        -- a pane running ssh or the like: an OSC 7 with no host or
        -- `localhost` may be the far host's prompt, and its folder is
        -- not on tmux's host; only tmux's own host spelled out is taken
        -- (the code review's TB16)
        blind =
            Array.member command blindCommands

        shellSaid =
            Drop.fileUri (part 2)
                |> Maybe.andThen
                    (\u ->
                        let
                            tmuxHost =
                                u.host == host || u.host == short

                            unnamed =
                                Bytes.isEmpty u.host || u.host == Bytes.fromString "localhost"
                        in
                        if (tmuxHost || (unnamed && not blind)) && not (Bytes.isEmpty u.path) then
                            Just u.path

                        else
                            Nothing
                    )
    in
    when shellSaid is
        Just path ->
            Folder path

        Nothing ->
            -- the shell sent no OSC 7, or one of another host
            meant Reason.FromOutside
                (if blind then
                    NoFolder ("the pane runs " ++ command ++ ", whose folder tmux can't see")

                 else if Bytes.isEmpty (part 0) then
                    NoFolder "tmux doesn't know the pane's folder"

                 else
                    Folder (part 0)
                )


{-| Programs that take a pane to another host or user: what tmux reads
of their folder is where they were started (docs/sftp.md FT11). -}
blindCommands : Array String
blindCommands =
    [ "ssh", "mosh", "mosh-client", "telnet", "su", "sudo", "doas", "pkexec", "machinectl", "docker", "podman", "kubectl", "lxc", "incus", "nsenter", "chroot", "et", "sshpass", "autossh" ]


{-| A new tab under `-CC`: tmux's new window, as Ctrl+Shift+T makes one,
for the menu's "New tab". -}
newWindow : (taken s : State) -> { state : State, commands : Array String }
newWindow s =
    sent [ Command.newWindow ] s


{-| The keys of the tabs: Ctrl+Shift+T a new window, Ctrl+PgUp and
Ctrl+PgDn the previous and next. -}
tabKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken s : State) -> { state : State, commands : Array String, used : Bool }
tabKey k s =
    let
        command =
            if k.action == 1 && Bitwise.and k.mods 15 == 3 && (k.sym == 0x54 || k.sym == 0x74) then
                Just Command.newWindow

            else if k.action /= 0 && Bitwise.and k.mods 15 == 2 && k.sym == 0xFF55 then
                Just Command.previousWindow

            else if k.action /= 0 && Bitwise.and k.mods 15 == 2 && k.sym == 0xFF56 then
                Just Command.nextWindow

            else
                Nothing
    in
    when command is
        Just c ->
            let
                r =
                    sent [ c ] s
            in
            { state = r.state, commands = r.commands, used = True }

        Nothing ->
            meant Reason.NotKnown { state = s, commands = [], used = False }


{-| The selection's text, for Ctrl+Shift+C. -}
selectedText : State -> Maybe String
selectedText s =
    s.selection
        |> Maybe.andThen
            (\sel ->
                if sel.made then
                    Just sel.text

                else
                    Nothing
            )


{-| Shift+PgUp, PgDn, Home and End scroll the active pane's view, a page
or to the end, as without tmux, unless the pane is in copy mode, whose
view is tmux's (TM117); not used for any other key. -}
scrollKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken s : State) -> { state : State, used : Bool }
scrollKey k s =
    let
        sizes =
            withPane s.active s (\t -> { most = Vt.scrollbackRows t, page = t.rows })
                |> Maybe.withDefault (meant Reason.Gone { most = 0, page = 0 })

        now =
            backOf s.active s

        next =
            if k.action == 0 || sizes.most == 0 || Bitwise.and k.mods 15 /= 1 then
                Nothing

            else if inCopy s.active s then
                -- copy mode's view is tmux's, which the cursor, the mark
                -- and the selection are drawn from: the key is copy mode's
                -- (the code review's TB2, TM117)
                Nothing

            else if k.sym == 0xFF55 then
                Just (min sizes.most (now + sizes.page))

            else if k.sym == 0xFF56 then
                Just (max 0 (now - sizes.page))

            else if k.sym == 0xFF50 then
                Just sizes.most

            else if k.sym == 0xFF57 then
                Just 0

            else
                Nothing
    in
    when next is
        Just b ->
            { state = { s | back = Dict.set s.active b s.back }, used = True }

        Nothing ->
            meant Reason.NotKnown { state = s, used = False }


{-| `select-pane` when the pane is not already the active one. -}
selected : Int -> State -> Array String
selected pane s =
    if pane == s.active then
        []

    else
        [ Command.selectPane ("%" ++ String.fromInt pane) ]


{-| A drag of a box going on: `move-pane -X -Y`, the box's new top left (its
border's, as tmux takes it with the border's lines), or `resize-pane -x -y`,
each time the pointer reaches a new cell. -}
dragged : Int -> Int -> Bool -> Drag -> (taken s : State) -> { state : State, commands : Array String }
dragged col row released d s =
    let
        top =
            s.barTop

        dx =
            col - d.col

        dy =
            row - d.row

        moved =
            col /= d.sent.col || row /= d.sent.row

        target =
            "%" ++ String.fromInt d.pane

        -- the commands of one line
        line =
            if d.kind == 2 then
                -- a tiled pane's width; tmux takes the room from its neighbor
                [ Command.resizePane target (Just (max 1 (d.w + dx))) Nothing ]

            else if d.kind == 3 then
                [ Command.resizePane target Nothing (Just (max 1 (d.h + dy))) ]

            else if d.kind == 0 then
                -- `d.y` is where it is drawn, below the tab bar; tmux's rows
                -- start under it
                [ Command.movePane target (d.x - 1 + dx) (boxTop + dy) ]

            else if d.kind == 4 then
                -- a floating pane's size, as resize-pane takes it, counts its
                -- border's lines: `new-pane -x 30 -y 6` makes a 28 by 4 pane
                [ Command.resizePane target (Just (max 4 (d.w + 2 + dx))) Nothing ]

            else if d.kind == 5 then
                [ Command.resizePane target Nothing (Just (max 3 (d.h + 2 + dy))) ]

            else if d.kind == 6 || d.kind == 7 then
                -- the left edge: the box's left moves with the pointer and
                -- its right stays, so it moves and resizes together, on one
                -- line, a reply each (TK10)
                [ Command.movePane target (d.x - 1 + leftDx) boxTop
                , Command.resizePane target
                    (Just (d.w + 2 - leftDx))
                    (if d.kind == 7 then
                        Just (max 3 (d.h + 2 + dy))

                     else
                        Nothing
                    )
                ]

            else
                [ Command.resizePane target (Just (max 4 (d.w + 2 + dx))) (Just (max 3 (d.h + 2 + dy))) ]

        boxTop =
            d.y
                - (if top then
                    statusRows s

                   else
                    0
                  )
                - 1

        -- the left edge goes no further right than leaves the box 4 wide
        leftDx =
            min dx (d.w + 2 - 4)

        after =
            if released then
                Nothing

            else
                Just { d | sent = { col = col, row = row } }

        s2 =
            { s | drag = after }
    in
    if moved then
        { state = expectedLine (Array.map (\c -> { command = c, expect = ForNothing }) line) s2, commands = [ String.join " ; " line ] }

    else
        { state = s2, commands = [] }


{-| The lowest-numbered button held, from `i` (0 for none), as Main's. -}
lowestHeld : Int -> Int -> Int
lowestHeld held i =
    if i > 11 then
        0

    else if Bitwise.and held (Bitwise.shiftLeftBy i 1) /= 0 then
        i

    else
        lowestHeld held (i + 1)


{-| Whether a pane's program asks for every motion (mode 1003), so that the
pointer's motions with no button held are its (TM61). -}
anyMotion : State -> Bool
anyMotion s =
    Array.any (\id -> withPane id s (\t -> (Vt.mouseModes t).tracking == Mouse.any) == Just True) s.ids


{-| A pointer event as the pane's program asked for it, if it did: encoded
by the pane's mouse modes, at the pane's own cells, sent as its keys. -}
report : Int -> Window.PointerEvent -> Layout.Pane -> (taken s : State) -> { state : State, commands : Array String }
report held p q s =
    let
        encoded =
            withPane q.id
                s
                (\t ->
                    let
                        modes =
                            Vt.mouseModes t
                    in
                    if modes.tracking == Mouse.none then
                        Nothing

                    else
                        Just
                            (Mouse.encode
                                { tracking = modes.tracking
                                , format = modes.format
                                , size =
                                    { screenWidth = q.w * p.cellWidth
                                    , screenHeight = q.h * p.cellHeight
                                    , cellWidth = p.cellWidth
                                    , cellHeight = p.cellHeight
                                    , padTop = 0
                                    , padBottom = 0
                                    , padRight = 0
                                    , padLeft = 0
                                    }
                                , anyButtonPressed = held /= 0
                                , track = True
                                , last = s.mouseLast
                                }
                                { action = p.action
                                -- a motion with its lowest button held, as
                                -- puritty reports one without tmux (TM61)
                                , button =
                                    if p.action == 2 then
                                        lowestHeld held 1

                                    else
                                        p.button
                                , mods = p.mods
                                , x = p.x - q.x * p.cellWidth
                                , y = p.y - q.y * p.cellHeight
                                }
                            )
                )
                |> Maybe.andThen identity
    in
    when encoded is
        Just r ->
            if Bytes.isEmpty r.bytes then
                { state = { s | mouseLast = r.last }, commands = [] }

            else
                sent (bytesTo s.caps q.id r.bytes) { s | mouseLast = r.last }

        Nothing ->
            meant Reason.NotKnown { state = s, commands = [] }


{-| The window at a new size: the canvas, and tmux told. -}
resized : { cols : Int, rows : Int } -> (taken s : State) -> { state : State, commands : Array String }
resized size s =
    if s.on && not s.capsKnown then
        -- the size is sent once this tmux's form is known (`ForCaps`)
        { state = { s | canvas = Vt.resize (max 1 size.cols) (max 1 size.rows) s.canvas }, commands = [] }

    else if s.on then
        sent [ sizeCommand s.caps (tmuxSize (statusRows s) size) ] { s | canvas = Vt.resize (max 1 size.cols) (max 1 size.rows) s.canvas }

    else
        { state = s, commands = [] }


{-| A nested client's control mode read (TM19): a line that is not tmux's
ends it at once, its bytes the pane's, as there is no client to ask
whether tmux is there (the code review's TA15). -}
nestedFeed : Bytes -> Control.Reader -> { reader : Control.Reader, events : Array Event }
nestedFeed bytes inner =
    let
        fed =
            Control.feed bytes inner
    in
    if Array.any (\e -> e == Stray) fed.events then
        let
            ended =
                Control.feed Bytes.empty (Control.giveUp fed.reader)
        in
        { reader = ended.reader, events = fed.events ++ ended.events }

    else
        fed
