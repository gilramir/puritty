    )

{-| tmux control mode in puritty's window (`docs/tmux.md` TM13 step 3,
TM14): when `tmux -CC` starts on the terminal, the window shows the tmux
window's panes, each a terminal of its own fed its `%output`; tiled panes
where tmux puts them with a line between, floating panes over them in a
box; the active pane's cursor. Keys go to the active pane, the window's
size to tmux. `%exit` gives the terminal back.

The panes' terminals answer nothing: tmux answered their programs already.
-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Keys
import Tmux.Bindings as Bindings
import Tmux.Command as Command
import Tmux.Style as Style
import Tmux.Syntax as Syntax
import Tmux.Control as Control exposing (Event(..), Notice(..))
import Tmux.Layout as Layout
import Vt
import Vt.Width as Width
import Vt.Mouse as Mouse
import Window


type alias State =
    { reader : Control.Reader
    , on : Bool
      -- the tmux window shown, -1 until tmux says which
    , window : Int
    , name : String
      -- each pane's terminal, and its id at the same index: as many of
      -- one as of the other, which the compiler holds every update to
      -- (TM34)
    , ids : Array Int
    , panes : Builder Vt.Term where Array.length ids == Builder.length panes
    , layout : Maybe Layout.Cell
    , active : Int
      -- whether the window has a modal pane, which takes every key
    , modal : Bool
      -- the window's picture, made of the panes (`Vt.compose`)
    , canvas : Vt.Term
      -- what each command sent waits for in its reply, in the order sent:
      -- tmux answers a client's commands in turn (docs/tmux.md TM5.2)
    , expecting : Array Expect
      -- what tmux said of each pane on attach, for its capture
    , info : Dict Int PaneInfo
      -- a floating pane being moved or resized by its box, and the pane a
      -- press began in, which keeps the mouse until it is let go
    , drag : Maybe Drag
    , grab : Maybe Int
    , mouseLast : Maybe Mouse.Cell
      -- how far back each pane's view is scrolled, 0 or missing at the
      -- bottom; a selection, in one pane's rows (absolute, as the core's
      -- `Point`s are); the last press of the left button, for double and
      -- triple clicks (docs/tmux.md TM17)
    , back : Dict Int Int
    , selection : Maybe Sel
    , clicks : { at : Int, count : Int, pane : Int, point : Vt.Point }
      -- the session's windows, shown as tabs on the window's first row
      -- (docs/tmux.md TM18)
    , tabs : Array { id : Int, index : Int, name : String }
      -- panes in which a `tmux -CC` was started, each read as control mode
      -- so that its lines are dropped until it ends (TM19)
    , nested : Dict Int Control.Reader
      -- the tab bar at the window's top, or at its bottom where tmux's
      -- status line was (`[tmux] tabs`, TM22)
    , barTop : Bool
      -- tmux's key bindings, by table and key, and the prefix keys, read
      -- on attach; the table the client is in as puritty follows it, and
      -- until when a repeatable binding keeps it there, -1 when none does
      -- (TM24)
    , keys : Bindings.Follow
      -- what tmux said (`%message`) or puritty says of a key, shown at the
      -- tab bar's right until the next key (TM24)
    , said : String
      -- each pane's mode's key table (`copy-mode-vi` in copy mode), and
      -- `mode-keys`; a prompt puritty asks for tmux, the answers given
      -- before, and whether it is drawn in tmux's look (TM25)
    , modes : Dict Int String
    , modeKeys : String
    , asking : Maybe Asking
    , history : Array String
    , lookTmux : Bool
      -- what a binding or a command printed, shown in a view that takes
      -- the keys until it is closed (TM26)
    , view : Maybe View
      -- a menu of tmux's shown by puritty, and a count that tells its
      -- formats' answers from an earlier menu's (TM27)
    , menu : Maybe Menuing
    , serial : Int
      -- the panes' numbers shown (`display-panes`, TM28), the time as the
      -- last key or tick said, and `display-panes-time`
    , numbers : Maybe Numbering
    , clock : Int
    , panesMs : Int
      -- tmux's status line as it subscribes to it (TM29)
    , status : StatusLine
      -- each pane in copy mode as tmux last said it, and the panes asked
      -- about and not yet answered: `True` once something has changed
      -- since the question was sent, to ask again (TM31)
    , copy : Dict Int Copying
    , copyAsked : Dict Int Bool
      -- each pane's mode by tmux's name for it (`clock-mode`), the time
      -- of day less the loop's clock for the clock (TM32), and the tree
      -- puritty shows for `choose-tree`
    , paneModes : Dict Int String
    , dayOffset : Maybe Int
    , tree : Maybe Tree
    }


{-| `choose-tree` shown by puritty (TM32): the sessions and windows tmux
listed, `loaded` once both lists are in, which sessions are open, the row
chosen, the command a choice runs, the pane it was run in, and whether
it covers every pane (`-Z`). -}
type alias Tree =
    { sessions : Array { id : Int, name : String, attached : Bool, windows : Int }
    , windows : Array { session : Int, id : Int, index : Int, name : String, active : Bool, panes : Int }
    , loaded : Int
    , open : Dict Int Bool
    , selected : Int
    , startSessions : Bool
    , template : String
    , pane : Int
    , zoom : Bool
    , preview : Preview
    }


{-| The tree's preview of its chosen row, as tmux draws it below the list
(TM35): a window's panes where they are in it, or a session's windows side
by side, each with what it shows. `serial` counts the questions asked, so
that a reply to one for a row since left is dropped; `target` is the row
asked about (`@2`, `$1`, empty for none). -}
type alias Preview =
    { serial : Int
    , target : String
    , session : Bool
    , items : Array PreviewItem
    }


{-| A pane of the window previewed, or a window of the session: tmux's id
for it, its label, where it is in the window (a session's windows are each
at 0, 0), whether it is the active one, and the lines it shows. -}
type alias PreviewItem =
    { id : String
    , label : String
    , x : Int
    , y : Int
    , w : Int
    , h : Int
    , active : Bool
    , lines : Array String
    }


noPreview : Preview
noPreview =
    { serial = 0, target = "", session = False, items = [] }


{-| A row of the tree: a session (its id) or a window (its id and its
session's), with what it says and whether it is its session's last. -}
type alias TreeRow =
    { session : Int, window : Int, text : String, last : Bool }


{-| A pane in copy mode as tmux describes it (TM31): how far back it is
(`scroll_position`), its history's lines (`history_size`), the cursor in
the pane, and the selection's ends, in tmux's lines (0 the history's
first), and whether it is a rectangle. -}
type alias Copying =
    { scroll : Int
    , hsize : Int
    , cx : Int
    , cy : Int
    , selection : Maybe { sx : Int, sy : Int, ex : Int, ey : Int }
    , rectangle : Bool
    }


{-| tmux's status line, as `refresh-client -B` tells puritty of it (TM29):
`status-left` and `status-right` expanded (strftime too), `status-style`,
`window-status-separator`, the two lengths, and each window's
`window-status-format` (its current one for the active window) expanded,
its style and its flags, by window id; and the panes' borders (TM30):
`pane-border-status`, `pane-border-style`, and each pane's
`pane-border-format` expanded, its border's style (the active one's for
the active pane) and whether it is marked, by pane id. -}
type alias StatusLine =
    { left : String
    , right : String
    , style : String
    , separator : String
    , leftLength : Int
    , rightLength : Int
    , windows : Dict Int { text : String, style : String, flags : String }
    , borderStatus : String
    , borderStyle : String
    , panes : Dict Int { title : String, border : String, marked : Bool }
    }


noStatus : StatusLine
noStatus =
    { left = "", right = "", style = "bg=green,fg=black", separator = " ", leftLength = 10, rightLength = 40, windows = Dict.empty, borderStatus = "off", borderStyle = "", panes = Dict.empty }


{-| `display-panes` shown by puritty (TM28): each pane's index by its id,
as tmux answers, until when they are shown, the command a digit runs and
whether digits are taken, and the pane it was run in. -}
type alias Numbering =
    { indexes : Array { id : Int, index : Int }
    , until : Int
    , template : String
    , keys : Bool
    , pane : Int
    }


{-| A menu of tmux's (`display-menu`) shown by puritty (TM27): its title and
items, their formats answered by tmux as they come (`pending` still to
come), the item chosen (an index into `items`, -1 for none), the pane it
was opened for and the mouse's cell when a click opened it, where it goes
(`-x`, `-y`), and whether the pointer has been pressed or moved since it
opened, so that the release of the click that opened it chooses nothing. -}
type alias Menuing =
    { serial : Int
    , title : String
    , items : Array Syntax.MenuItem
    , pending : Int
    , selected : Int
    , pane : Int
    , mouse : Maybe { col : Int, row : Int }
    , x : String
    , y : String
    , armed : Bool
    }


{-| What a command puritty runs for tmux runs in (TM27): the pane, and the
mouse's cell when a click began it. -}
type alias Context =
    { pane : Int, mouse : Maybe { col : Int, row : Int } }


{-| A menu's row as shown: a line, or an item (its index in the menu) with
its name, its key and whether it can be chosen. -}
type alias MenuRow =
    { index : Int, line : Bool, text : String, key : String, enabled : Bool }


{-| What tmux printed for this client (TM26): its lines, the first shown,
and how many rows the view had when it was last drawn, a page. -}
type alias View =
    { lines : Array String
    , top : Int
    , rows : Int
    , all : Array String
    , filter : String
    , filtering : Bool
    }


{-| A prompt of tmux's, asked by puritty (TM25): what the binding asks,
the commands after it, which of its questions is asked and the answers to
those before, the question as tmux would show it, and what is typed with
the caret. `edited` once a key has changed the text, so that a first text
tmux expands late does not replace it. -}
type alias Asking =
    { ask : Syntax.Ask
    , after : String
    , step : Int
    , answers : Array String
    , label : String
    , chars : Array Char
    , caret : Int
    , edited : Bool
    }


{-| A selection within a pane: from `anchor` to `head`, by cells (mode 0),
words (1) or lines (2), the first word or line kept as `first` to `last`;
`made` once the button is let go, with its text. -}
type alias Sel =
    { pane : Int
    , anchor : Vt.Point
    , head : Vt.Point
    , first : Vt.Point
    , last : Vt.Point
    , mode : Int
    , moved : Bool
    , made : Bool
    , text : String
    }


{-| A drag of a floating pane's box, or of the line beside or below a
tiled pane (TM20): from where, the pane as it was, and what was last sent,
so that a motion within a cell sends nothing. `kind`: 0 the box moved, 1
the box resized, 2 the line right of the pane, 3 the line below it. -}
type alias Drag =
    { pane : Int
    , kind : Int
    , col : Int
    , row : Int
    , x : Int
    , y : Int
    , w : Int
    , h : Int
    , sent : { col : Int, row : Int }
    }


{-| What a command's reply is for. -}
type Expect
    = ForWindow
    | ForTabs
    | ForPanes
    | ForInfo Int
    | ForSaved Int
    | ForCapture Int
    | ForKeys
    | ForPrefixes
    | ForModes
    | ForLabel
    | ForInput
    | ForRan
    | ForCondition { pane : Int, mouse : Maybe { col : Int, row : Int }, yes : String, no : String, after : String }
    | ForNumbers
    | ForCopy
    | ForTreeSessions
    | ForTreeWindows
    | ForPreviewList Int
    | ForPreviewCapture { serial : Int, index : Int }
    | ForDayTime
    | ForPanesTime
    | ForMenuTitle Int
    | ForMenuName { serial : Int, item : Int }
    | ForMenuCommand { serial : Int, item : Int }
    | ForNothing


{-| A pane as `list-panes` describes it on attach (TM5.8), and the main
screen's lines a capture of its saved grid gave while the alternate screen
was up. -}
type alias PaneInfo =
    { w : Int
    , h : Int
    , x : Int
    , y : Int
    , alt : Bool
    , top : Int
    , bottom : Int
    , modes : Array Int
    , saved : Array Bytes
    }


idle : {} -> State
idle _ =
    { reader = Control.reader
    , on = False
    , window = -1
    , name = ""
    , ids = []
    , panes = Builder.empty 0
    , layout = Nothing
    , active = -1
    , modal = False
    , canvas = blank 1 1
    , expecting = []
    , info = Dict.empty
    , drag = Nothing
    , grab = Nothing
    , mouseLast = Nothing
    , back = Dict.empty
    , selection = Nothing
    , clicks = { at = -1000, count = 0, pane = -1, point = { row = 0, col = 0 } }
    , tabs = []
    , nested = Dict.empty
    , barTop = False
    , keys = Bindings.follow
    , said = ""
    , modes = Dict.empty
    , modeKeys = "emacs"
    , asking = Nothing
    , history = []
    , lookTmux = False
    , view = Nothing
    , menu = Nothing
    , serial = 0
    , numbers = Nothing
    , clock = 0
    , panesMs = 1000
    , status = noStatus
    , copy = Dict.empty
    , copyAsked = Dict.empty
    , paneModes = Dict.empty
    , dayOffset = Nothing
    , tree = Nothing
    }


blank : Int -> Int -> Vt.Term
blank cols rows =
    Vt.new
        { cols = max 1 cols
        , rows = max 1 rows
        , scrollbackBytes = Vt.scrollbackBytesFor { cols = max 1 cols, rows = 1000 }
        , pageRows = Vt.defaultPageRows
        , checksums = False
        , cellWidth = 0
        , cellHeight = 0
        }


isOn : State -> Bool
isOn s =
    s.on


title : State -> String
title s =
    "tmux: " ++ s.name


{-| A read's bytes: the terminal's own (`outside`, for its core), and
what tmux said, done to the panes. `commands` are tmux commands to write,
each a line; `trace` is what tmux said, for the diagnostic log
(`docs/diagnostics.md` DG2): each notification and reply a line, a pane's
output counted, never shown. -}
read : { cols : Int, rows : Int } -> Bytes -> (taken s : State) -> { state : State, outside : Bytes, commands : Array String, trace : Array String }
read size bytes s =
    let
        fed =
            Control.feed bytes s.reader

        done =
            Array.foldl (\e a -> event size e (traced e a)) { state = { s | reader = fed.reader }, outside = [], commands = [], trace = [], run = Nothing } fed.events
                |> endRun
    in
    { state = done.state, outside = Bytes.flatten done.outside, commands = done.commands, trace = done.trace }


{-| What a read did: the state, the terminal's own bytes, the commands to
write, and the log's lines with a run of one pane's output being counted. -}
type alias Acc =
    { state : State, outside : Array Bytes, commands : Array String, trace : Array String, run : Maybe { pane : Int, count : Int, bytes : Int } }


{-| An event's line in the log, before the event is done: a reply is
named by what puritty waits for from it, the first of `expecting`. -}
traced : Event -> (taken acc : Acc) -> Acc
traced e acc =
    when e is
        Notice (Output o) ->
            let
                n =
                    Bytes.length o.bytes
            in
            when acc.run is
                Just r ->
                    if r.pane == o.pane then
                        { acc | run = Just { r | count = r.count + 1, bytes = r.bytes + n } }

                    else
                        { (endRun acc) | run = Just { pane = o.pane, count = 1, bytes = n } }

                Nothing ->
                    { acc | run = Just { pane = o.pane, count = 1, bytes = n } }

        _ ->
            let
                next =
                    Array.first acc.state.expecting

                line =
                    describe next e
            in
            { (endRun acc) | trace = acc.trace ++ line }


{-| A run of output counted into the log, and ended. -}
endRun : (taken acc : Acc) -> Acc
endRun acc =
    when acc.run is
        Just r ->
            { acc | trace = Array.pushLast ("output %" ++ String.fromInt r.pane ++ " " ++ String.fromInt r.bytes ++ " bytes" ++ (if r.count > 1 then " in " ++ String.fromInt r.count ++ " lines" else "")) acc.trace, run = Nothing }

        Nothing ->
            acc


{-| An event other than a pane's output, as the log says it. -}
describe : Maybe Expect -> Event -> Array String
describe next e =
    let
        cut n text =
            if String.count text > n then
                String.takeFirst n text ++ "…"

            else
                text
    in
    when e is
        Outside b ->
            if Bytes.isEmpty b then [] else [ "outside control mode " ++ String.fromInt (Bytes.length b) ++ " bytes" ]

        Entered ->
            [ "control mode began" ]

        Exited ->
            [ "control mode ended" ]

        Notice n ->
            [ noticeLine n ]

        Reply r ->
            let
                total =
                    Array.foldl (\l t -> t + Bytes.length l) 0 r.lines

                whose =
                    if r.flags == 0 then
                        "not puritty's command"

                    else
                        "for " ++ Maybe.withDefault "nothing waited for" (Maybe.map expectName next)

                head =
                    "reply #" ++ String.fromInt r.number ++ (if r.ok then " ok" else " ERROR") ++ ", " ++ String.fromInt (Array.length r.lines) ++ " lines, " ++ String.fromInt total ++ " bytes, " ++ whose

                -- the lines of puritty's own questions, which say nothing
                -- typed or shown; an error's first line, which is tmux's
                shown =
                    if not r.ok then
                        Array.takeFirst 1 r.lines

                    else
                        when next is
                            Just ForWindow -> Array.takeFirst 3 r.lines
                            Just ForPrefixes -> Array.takeFirst 3 r.lines
                            Just ForModes -> Array.takeFirst 8 r.lines
                            Just ForCopy -> Array.takeFirst 3 r.lines
                            Just ForPanesTime -> Array.takeFirst 1 r.lines
                            Just ForDayTime -> Array.takeFirst 1 r.lines
                            _ -> []
            in
            Array.pushFirst head (Array.map (\l -> "  | " ++ cut 160 (Bytes.toStringLossy l)) shown)


noticeLine : Notice -> String
noticeLine n =
    let
        pane p =
            "%" ++ String.fromInt p

        window w =
            "@" ++ String.fromInt w

        session x =
            "$" ++ String.fromInt x

        cut text =
            if String.count text > 120 then String.takeFirst 120 text ++ "…" else text
    in
    when n is
        Output o ->
            "output " ++ pane o.pane ++ " " ++ String.fromInt (Bytes.length o.bytes) ++ " bytes"

        Pause p ->
            "pause " ++ pane p

        Continue p ->
            "continue " ++ pane p

        LayoutChange l ->
            "layout-change " ++ window l.window ++ (if l.flags == "" then "" else " flags " ++ l.flags)

        WindowAdd w ->
            "window-add " ++ window w

        WindowClose w ->
            "window-close " ++ window w

        WindowRenamed r ->
            "window-renamed " ++ window r.window

        UnlinkedWindowAdd w ->
            "unlinked-window-add " ++ window w

        UnlinkedWindowClose w ->
            "unlinked-window-close " ++ window w

        UnlinkedWindowRenamed r ->
            "unlinked-window-renamed " ++ window r.window

        WindowPaneChanged c ->
            "window-pane-changed " ++ window c.window ++ " " ++ pane c.pane

        SessionChanged c ->
            "session-changed " ++ session c.session

        ClientSessionChanged c ->
            "client-session-changed " ++ session c.session

        SessionRenamed r ->
            "session-renamed " ++ session r.session

        SessionsChanged ->
            "sessions-changed"

        SessionWindowChanged c ->
            "session-window-changed " ++ session c.session ++ " " ++ window c.window

        PaneModeChanged p ->
            "pane-mode-changed " ++ pane p

        ClientDetached _ ->
            "client-detached"

        SubscriptionChanged c ->
            "subscription-changed " ++ c.name

        PasteBufferChanged _ ->
            "paste-buffer-changed"

        PasteBufferDeleted _ ->
            "paste-buffer-deleted"

        Message m ->
            "message " ++ cut m

        ConfigError m ->
            "config-error " ++ cut m

        Exit m ->
            "exit " ++ cut m

        Unknown m ->
            "unknown notification " ++ cut (String.takeFirst 40 m)


expectName : Expect -> String
expectName x =
    when x is
        ForWindow -> "the window"
        ForTabs -> "the tabs"
        ForPanes -> "the panes"
        ForInfo p -> "pane %" ++ String.fromInt p ++ "'s info"
        ForSaved p -> "pane %" ++ String.fromInt p ++ "'s saved screen"
        ForCapture p -> "pane %" ++ String.fromInt p ++ "'s capture"
        ForKeys -> "the key bindings"
        ForPrefixes -> "the prefixes"
        ForModes -> "the panes' modes"
        ForLabel -> "a prompt's label"
        ForInput -> "a prompt's answer"
        ForRan -> "a command run"
        ForCondition c -> "a condition in pane %" ++ String.fromInt c.pane
        ForNumbers -> "the panes' numbers"
        ForCopy -> "copy mode's state"
        ForTreeSessions -> "the tree's sessions"
        ForTreeWindows -> "the tree's windows"
        ForPreviewList _ -> "the tree preview's panes or windows"
        ForPreviewCapture c -> "the tree preview's capture " ++ String.fromInt c.index
        ForDayTime -> "the time of day"
        ForPanesTime -> "display-panes-time"
        ForMenuTitle _ -> "a menu's title"
        ForMenuName _ -> "a menu item's name"
        ForMenuCommand _ -> "a menu item's command"
        ForNothing -> "nothing (a reply not read)"


{-| A pane's line in a mark. -}
paneSaid : State -> Int -> String
paneSaid s id =
    let
        yes b =
            if b then "on" else "off"

        term =
            withPane id s
                (\t ->
                    "paste-brackets "
                        ++ yes (Dict.get 2004 t.modes == Just True)
                        ++ ", focus-reports "
                        ++ yes (Dict.get 1004 t.modes == Just True)
                        ++ ", mouse "
                        ++ yes ((Vt.mouseModes t).tracking /= Mouse.none)
                        ++ ", alt-screen "
                        ++ yes t.alt
                        ++ ", app-cursor "
                        ++ yes (Dict.get 1 t.modes == Just True)
                        ++ ", size "
                        ++ String.fromInt t.cols
                        ++ "x"
                        ++ String.fromInt t.rows
                )
                |> Maybe.withDefault "no terminal"

        extra =
            [ when Dict.get id s.paneModes is
                Just mode -> if mode == "" then "" else ", mode " ++ mode
                Nothing -> ""
            , when Dict.get id s.modes is
                Just table -> if table == "" then "" else ", key table " ++ table
                Nothing -> ""
            , when Dict.get id s.back is
                Just b -> if b == 0 then "" else ", view scrolled back " ++ String.fromInt b
                Nothing -> ""
            , if Dict.member id s.copy then ", copy mode" else ""
            , if Dict.member id s.nested then ", NESTED control mode (output dropped)" else ""
            ]
    in
    "  pane %" ++ String.fromInt id ++ (if id == s.active then " (active)" else "") ++ ": " ++ term ++ String.join "" extra


{-| Each pane's line in a mark, walked so that nothing captures the state. -}
panesSaid : Array Int -> State -> Array String
panesSaid ids s =
    when Array.first ids is
        Just id ->
            Array.pushFirst (paneSaid s id) (panesSaid (Array.dropFirst 1 ids) s)

        Nothing ->
            []


{-| What the diagnostic log's mark says of control mode
(`docs/diagnostics.md` DG3): the panes, each with the modes that decide
where keys, pastes and the mouse go, and what puritty waits for. -}
diagnose : State -> Array String
diagnose s =
    let
        yes b =
            if b then "on" else "off"

        open =
            [ if s.asking /= Nothing then "a prompt" else ""
            , if s.menu /= Nothing then "a menu" else ""
            , if s.numbers /= Nothing then "pane numbers" else ""
            , if s.view /= Nothing then "a view" else ""
            , if s.tree /= Nothing then "the tree" else ""
            , if s.drag /= Nothing then "a drag" else ""
            ]
                |> Array.keepIf (\x -> x /= "")
    in
    if not s.on then
        [ "tmux control mode: off" ]

    else
        [ "tmux control mode: on, window @" ++ String.fromInt s.window ++ ", active pane %" ++ String.fromInt s.active ++ (if s.modal then ", a modal pane" else "")
        , "  key table " ++ s.keys.table ++ (if s.keys.byTable then ", keys by table (send-keys -K)" else ", keys as bytes (tmux before 3.4)")
        , "  waiting for " ++ String.fromInt (Array.length s.expecting) ++ " replies" ++ (if Array.isEmpty s.expecting then "" else ": " ++ String.join "; " (Array.map expectName (Array.takeFirst 6 s.expecting)))
        , "  open: " ++ (if Array.isEmpty open then "nothing" else String.join ", " open)
        , "  selection " ++ (when s.selection is
                Just sel -> "made in pane %" ++ String.fromInt sel.pane
                Nothing -> "none") ++ (when s.grab is
                Just g -> ", pointer held by pane %" ++ String.fromInt g
                Nothing -> "")
        ]
            ++ panesSaid s.ids s


windowQuery : String
windowQuery =
    "display-message -p " ++ Command.quote "W #{window_id} #{pane_id} #{window_visible_layout} #{window_name}"


{-| A pane's mode and `mode-keys`, a line starting with `M`. -}
modeFormat : String
modeFormat =
    "M #{pane_id} #{pane_mode} #{mode-keys}"


{-| The session's windows, each a line starting with `T`. -}
tabsQuery : String
tabsQuery =
    "list-windows -F " ++ Command.quote "T #{window_id} #{window_index} #{window_name}"


{-| The tab bar at the top (`True`) or the bottom of the window. -}
setBar : Bool -> (taken s : State) -> State
setBar top s =
    { s | barTop = top }


{-| The prompt puritty asks for tmux, in puritty's look, for the window's
box (`Dialog`): the question, what is typed and where the caret is, and the
keys that answer (TM25). -}
promptBox : State -> Maybe { title : String, typed : String, caret : Int, field : Bool, hint : String }
promptBox s =
    if s.lookTmux then
        Nothing

    else
        Maybe.map
            (\a ->
                when a.ask is
                    Syntax.Confirm c ->
                        { title = String.trim a.label, typed = "", caret = 0, field = False, hint = c.key ++ ": yes    any other key: no" }

                    Syntax.Prompt p ->
                        { title = String.trim a.label
                        , typed = String.fromArray a.chars
                        , caret = a.caret
                        , field = True
                        , hint =
                            when p.entry is
                                Syntax.Single ->
                                    "a key answers    Esc: cancel"

                                Syntax.KeyName ->
                                    "a key answers"

                                _ ->
                                    "Enter: run    Esc: cancel    Up, Down: earlier answers"
                        }
            )
            s.asking


{-| Whether puritty asks one of tmux's prompts, which then takes what an
input method commits and what is pasted, or shows a view (TM26), which
drops them. -}
isAsking : State -> Bool
isAsking s =
    s.asking /= Nothing || s.view /= Nothing || s.menu /= Nothing || s.numbers /= Nothing || s.tree /= Nothing


{-| Text from an input method or a paste, typed into the prompt: a line
end as a space, other control characters left out; a prompt that takes a
key or digits takes none of it. -}
typeInto : String -> (taken s : State) -> State
typeInto text s =
    when s.view is
        Just v ->
            if v.filtering then
                { s | view = Just (filtered (v.filter ++ viewText (String.replace "\n" " " text)) v) }

            else
                s

        Nothing ->
            typeIntoPrompt text s


typeIntoPrompt : String -> (taken s : State) -> State
typeIntoPrompt text s =
    when s.asking is
        Just a ->
            when a.ask is
                Syntax.Prompt p ->
                    if p.entry == Syntax.Text then
                        let
                            clean =
                                String.toArray text
                                    |> Array.map (\c -> if c == '\n' || c == '\r' || c == '\t' then ' ' else c)
                                    |> Array.keepIf (\c -> Char.toCode c >= 0x20 && Char.toCode c /= 0x7F)
                                    |> String.fromArray
                        in
                        { s | asking = Just (insert clean a) }

                    else
                        s

                Syntax.Confirm _ ->
                    s

        Nothing ->
            s


{-| tmux's prompts and messages in tmux's look (`True`) or puritty's. -}
setLook : Bool -> (taken s : State) -> State
setLook tmuxLook s =
    { s | lookTmux = tmuxLook }


{-| The rows of puritty's window that are not tmux's: the tab bar. -}
bar : Int
bar =
    1


{-| A tiled pane as tmux places it inside its layout cell when
`pane-border-status` is on (measured on 3.8, where no `%layout-change`
says so): a pane on the window's top edge moves down a row for its title
(`top`), one on its bottom edge gives up its last row (`bottom`); the
others' titles are on the line between panes. A floating pane keeps its
cell. -}
fitted : String -> Int -> Layout.Pane -> Layout.Pane
fitted borderStatus height p =
    if p.z /= Nothing || p.h < 2 then
        p

    else if borderStatus == "top" && p.y == 0 then
        { p | y = 1, h = p.h - 1 }

    else if borderStatus == "bottom" && p.y + p.h >= height then
        { p | h = p.h - 1 }

    else
        p


{-| The layout's height: its root cell's. -}
heightOf : Layout.Cell -> Int
heightOf cell =
    when cell is
        Layout.Split c ->
            c.h

        Layout.Leaf p ->
            p.h


{-| The panes where they are drawn: placed as tmux places them for their
titles, then below the bar when it is at the top. -}
placedPanes : State -> Layout.Cell -> Array Layout.Pane -> Array Layout.Pane
placedPanes s cell panes =
    Array.map (\p -> down s.barTop (fitted s.status.borderStatus (heightOf cell) p)) panes


{-| A pane of the layout where it is drawn in puritty's window: below the
tab bar when the bar is at the top, where tmux has it when at the bottom. -}
down : Bool -> Layout.Pane -> Layout.Pane
down top p =
    if top then
        { p | y = min 16384 (p.y + bar) }

    else
        p


{-| The size tmux is told: puritty's window less the tab bar. -}
tmuxSize : { cols : Int, rows : Int } -> { cols : Int, rows : Int }
tmuxSize size =
    { cols = size.cols, rows = max 1 (size.rows - bar) }


{-| Every pane of the session, each a line starting with `P`, so that none
can read as a guard. -}
panesQuery : String
panesQuery =
    "list-panes -s -F " ++ Command.quote "P #{pane_id}"


{-| A pane's state, read in the same command line as its captures, so that
no output of the pane's comes between them (tmux runs one line's commands
in turn, before it reads a pane again): a capture holds the screen at one
moment, and the cursor that goes with it is read at that moment too. -}
infoOf : Int -> String
infoOf pane =
    "display-message -p -t "
        ++ Command.quote ("%" ++ String.fromInt pane)
        ++ " "
        ++ Command.quote "P #{pane_id} #{pane_width} #{pane_height} #{cursor_x} #{cursor_y} #{alternate_on} #{scroll_region_upper} #{scroll_region_lower} #{pane_private_modes}"


{-| A pane's history and screen, with its colors and attributes, wrapped
lines joined; or, with `saved`, the main screen kept while the alternate
one is up. -}
captureOf : Bool -> Int -> String
captureOf saved pane =
    "capture-pane -p -e -J -S - -E -"
        ++ (if saved then " -a -q" else "")
        ++ " -t "
        ++ Command.quote ("%" ++ String.fromInt pane)


{-| Commands sent on one line, `a ; b ; c`, each with what its reply is
for: tmux runs them in turn with nothing between, and answers each. -}
askLine : Array { command : String, expect : Expect } -> (taken acc : Acc) -> Acc
askLine asked acc =
    let
        st =
            acc.state
    in
    { acc
        | state = { st | expecting = st.expecting ++ Array.map .expect asked }
        , commands = Array.pushLast (String.join " ; " (Array.map .command asked)) acc.commands
    }


{-| Commands sent, each with what its reply is for. -}
ask : Array { command : String, expect : Expect } -> (taken acc : Acc) -> Acc
ask asked acc =
    let
        st =
            acc.state
    in
    { acc
        | state = { st | expecting = st.expecting ++ Array.map .expect asked }
        , commands = acc.commands ++ Array.map .command asked
    }


event : { cols : Int, rows : Int } -> Event -> (taken acc : Acc) -> Acc
event size e acc =
    when e is
        Outside b ->
            { acc | outside = Array.pushLast b acc.outside }

        Entered ->
            let
                st =
                    acc.state
            in
            ask
                [ { command = Command.clientFlags, expect = ForNothing }
                , { command = Command.size (tmuxSize size), expect = ForNothing }
                , { command = windowQuery, expect = ForWindow }
                , { command = tabsQuery, expect = ForTabs }
                , { command = panesQuery, expect = ForPanes }
                , { command = "list-keys", expect = ForKeys }
                , { command = "display-message -p " ++ Command.quote "#{prefix} #{prefix2} #{repeat-time} #{version}", expect = ForPrefixes }
                , { command = "list-panes -s -F " ++ Command.quote modeFormat, expect = ForModes }
                , { command = "display-message -p " ++ Command.quote "#{display-panes-time}", expect = ForPanesTime }
                ]
                { acc | state = { st | on = True, window = -1, ids = [], panes = Builder.empty 0, layout = Nothing, active = -1, canvas = blank size.cols size.rows, expecting = [], info = Dict.empty, status = noStatus } }
                |> ask (Array.map (\sub -> { command = "refresh-client -B " ++ Command.quote sub, expect = ForNothing }) statusSubscriptions)

        Exited ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | on = False, ids = [], panes = Builder.empty 0, layout = Nothing, canvas = blank 1 1, expecting = [], info = Dict.empty, view = Nothing, asking = Nothing, menu = Nothing, numbers = Nothing } }

        Reply r ->
            if r.flags == 0 then
                -- a command not this client's: the one it was started
                -- with, a hook's, or a key binding's, in whose block tmux
                -- writes what `display-message` says to this client (TM24)
                when Array.findLast (\line -> String.startsWith "%message " (Bytes.toStringLossy line)) r.lines is
                    Nothing ->
                        if r.ok then
                            -- what a binding printed (`list-keys -N`,
                            -- `list-buffers`, `show-messages`), which a
                            -- terminal client shows in view mode (TM26)
                            if Array.isEmpty r.lines then
                                acc

                            else
                                let
                                    st =
                                        acc.state
                                in
                                { acc | state = { st | view = Just (viewOf r.lines) } }

                        else
                            -- a binding's error, as tmux's status line would
                            -- show it (TM24)
                            let
                                st =
                                    acc.state
                            in
                            { acc | state = { st | said = Array.first r.lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault st.said } }

                    Just m ->
                        let
                            st =
                                acc.state
                        in
                        { acc | state = { st | said = String.dropFirst 9 (Bytes.toStringLossy m.value) } }

            else
                let
                    st =
                        acc.state

                    expect =
                        Maybe.withDefault ForNothing (Array.first st.expecting)

                    popped =
                        { acc | state = { st | expecting = Array.dropFirst 1 st.expecting } }
                in
                replied expect r.ok r.lines popped

        Notice n ->
            notice n acc


{-| The bytes of the events that are a terminal's own, outside control
mode. -}
outsideOf : Array Event -> Bytes
outsideOf events =
    Array.mapAndKeepJust
        (\e ->
            when e is
                Outside b ->
                    Just b

                _ ->
                    Nothing
        )
        events
        |> Bytes.flatten


{-| A reply, by what its command was for. -}
replied : Expect -> Bool -> Array Bytes -> (taken acc : Acc) -> Acc
replied expect ok lines acc =
    when expect is
        ForWindow ->
            { acc | state = Array.foldl replyLine acc.state lines }

        ForTabs ->
            let
                st =
                    acc.state

                tabs =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split " " (Bytes.toStringLossy line) |> Array.popFirst is
                                Just { first = "T", rest = rest } ->
                                    Just
                                        { id = idOf (Maybe.withDefault "" (Array.get 0 rest))
                                        , index = Maybe.withDefault 0 (String.toInt (Maybe.withDefault "" (Array.get 1 rest)))
                                        , name = String.join " " (Array.dropFirst 2 rest)
                                        }

                                _ ->
                                    Nothing
                        )
                        lines
            in
            { acc | state = { st | tabs = tabs } }

        ForPanes ->
            -- each pane's state and both its captures on one line: three
            -- replies, in turn
            Array.foldl
                (\line a ->
                    when String.split " " (Bytes.toStringLossy line) is
                        [ "P", id ] ->
                            askLine (recapture (idOf id)) a

                        _ ->
                            a
                )
                acc
                lines

        ForInfo pane ->
            let
                st =
                    acc.state
            in
            when Array.first lines |> Maybe.andThen paneLine is
                Just d ->
                    { acc | state = { st | info = Dict.set pane d.info st.info } }

                Nothing ->
                    { acc | state = st }

        ForSaved pane ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | info = Dict.update pane (Maybe.map (\i -> { i | saved = if ok then lines else [] })) st.info } }

        ForKeys ->
            let
                st =
                    acc.state

                tables =
                    st.keys
            in
            if ok then
                { acc | state = { st | keys = { tables | bindings = Array.foldl (\line d -> Bindings.bindingOf (Bytes.toStringLossy line) d) Dict.empty lines } } }

            else
                { acc | state = st }

        ForPrefixes ->
            let
                st =
                    acc.state

                got =
                    Bindings.prefixesOf (Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault "")

                tables =
                    st.keys
            in
            if ok then
                { acc | state = { st | keys = { tables | prefixes = got.prefixes, repeatMs = got.repeatMs, byTable = got.byTable } } }

            else
                { acc | state = st }

        ForModes ->
            let
                st =
                    acc.state

                moded =
                    Array.foldl (\line m -> modeLine (Bytes.toStringLossy line) m) st lines

                -- a pane out of copy mode is drawn as it is again; one in it
                -- is asked where it is (TM31)
                left =
                    Dict.keys moded.copy |> Array.keepIf (\pane -> not (inCopy pane moded))

                cleared =
                    { moded | copy = Array.foldl Dict.remove moded.copy left, back = Array.foldl Dict.remove moded.back left }

                entered =
                    Dict.keys cleared.modes |> Array.keepIf (\pane -> inCopy pane cleared)

                clocked =
                    Dict.values cleared.paneModes |> Array.any (\m -> m == "clock-mode")

                asked =
                    Array.foldl (\pane a -> askCopy pane a) { acc | state = cleared } entered
            in
            if clocked && asked.state.dayOffset == Nothing then
                -- the time of day, for the clock (TM32)
                ask [ { command = "display-message -p " ++ Command.quote "D %H %M %S", expect = ForDayTime } ] asked

            else
                asked

        ForLabel ->
            let
                st =
                    acc.state

                text =
                    Array.first lines |> Maybe.map Bytes.toStringLossy
            in
            when { asking = st.asking, text = text, ok = ok } is
                { asking = Just a, text = Just t, ok = True } ->
                    { acc | state = { st | asking = Just { a | label = t } } }

                _ ->
                    { acc | state = st }

        ForInput ->
            let
                st =
                    acc.state

                text =
                    Array.first lines |> Maybe.map Bytes.toStringLossy
            in
            when { asking = st.asking, text = text, ok = ok } is
                { asking = Just a, text = Just t, ok = True } ->
                    if a.edited then
                        { acc | state = st }

                    else
                        { acc | state = { st | asking = Just { a | chars = String.toArray t, caret = String.count t } } }

                _ ->
                    { acc | state = st }

        ForRan ->
            -- what a command run from a prompt said: its error, or its
            -- output's first line, at the bar's right (TM25)
            let
                st =
                    acc.state

                first =
                    Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault ""

                more =
                    Array.length lines - 1
            in
            if Array.isEmpty lines then
                { acc | state = st }

            else if ok then
                -- printed: in a view, as tmux shows a command's output
                -- (TM26); `display-message`'s own words at the bar
                when Array.findLast (\line -> String.startsWith "%message " (Bytes.toStringLossy line)) lines is
                    Just m ->
                        { acc | state = { st | said = String.dropFirst 9 (Bytes.toStringLossy m.value) } }

                    Nothing ->
                        { acc | state = { st | view = Just (viewOf lines) } }

            else
                { acc | state = { st | said = if more > 0 then first ++ " (" ++ String.fromInt more ++ " more lines)" else first } }

        ForCondition c ->
            -- `if-shell -F`'s format answered: its branch run, then the
            -- commands after it (TM27)
            let
                value =
                    Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault ""

                ctx =
                    { pane = c.pane, mouse = c.mouse }

                branch =
                    if ok && value /= "" && value /= "0" then c.yes else c.no

                ran =
                    runLine ctx branch acc.state

                more =
                    runLine ctx c.after ran.state
            in
            { state = more.state, outside = acc.outside, commands = acc.commands ++ ran.commands ++ more.commands, trace = acc.trace, run = acc.run }

        ForTreeSessions ->
            let
                st =
                    acc.state

                sessions =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split " " (Bytes.toStringLossy line) is
                                [ "S", id, attached, count, first ] ->
                                    Just { id = idOf id, attached = attached /= "0", windows = Maybe.withDefault 0 (String.toInt count), name = first }

                                _ ->
                                    when String.split " " (Bytes.toStringLossy line) |> Array.popFirst is
                                        Just { first = "S", rest = rest } ->
                                            Just
                                                { id = idOf (Maybe.withDefault "" (Array.get 0 rest))
                                                , attached = Array.get 1 rest /= Just "0"
                                                , windows = Maybe.withDefault 0 (Maybe.andThen String.toInt (Array.get 2 rest))
                                                , name = String.join " " (Array.dropFirst 3 rest)
                                                }

                                        _ ->
                                            Nothing
                        )
                        lines
            in
            previewAcc { acc | state = { st | tree = Maybe.map (\t -> treeLoaded st.window { t | sessions = sessions, loaded = t.loaded + 1 }) st.tree } }

        ForTreeWindows ->
            let
                st =
                    acc.state

                windows =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split " " (Bytes.toStringLossy line) |> Array.popFirst is
                                Just { first = "W", rest = rest } ->
                                    Just
                                        { session = idOf (Maybe.withDefault "" (Array.get 0 rest))
                                        , id = idOf (Maybe.withDefault "" (Array.get 1 rest))
                                        , index = Maybe.withDefault 0 (Maybe.andThen String.toInt (Array.get 2 rest))
                                        , active = Array.get 3 rest == Just "1"
                                        , panes = Maybe.withDefault 1 (Maybe.andThen String.toInt (Array.get 4 rest))
                                        , name = String.join " " (Array.dropFirst 5 rest)
                                        }

                                _ ->
                                    Nothing
                        )
                        lines
            in
            previewAcc { acc | state = { st | tree = Maybe.map (\t -> treeLoaded st.window { t | windows = windows, loaded = t.loaded + 1 }) st.tree } }

        ForPreviewList serial ->
            -- the panes or windows of the row previewed, each then captured
            let
                items =
                    Array.mapAndKeepJust previewItem lines |> Array.takeFirst 12

                current =
                    Maybe.map (\t -> t.preview.serial) acc.state.tree
            in
            if current /= Just serial || not ok then
                acc

            else
                let
                    st =
                        acc.state
                in
                when st.tree is
                    Just t ->
                        let
                            pv =
                                t.preview
                        in
                        ask
                            (Array.indexedMap (\i item -> { command = "capture-pane -p -t " ++ Command.quote item.id, expect = ForPreviewCapture { serial = serial, index = i } }) items)
                            { acc | state = { st | tree = Just { t | preview = { pv | items = items } } } }

                    Nothing ->
                        { acc | state = st }

        ForPreviewCapture c ->
            let
                shown =
                    Array.map Bytes.toStringLossy lines |> trimBlank

                current =
                    Maybe.map (\t -> t.preview.serial) acc.state.tree
            in
            if current /= Just c.serial || not ok then
                acc

            else
                let
                    st =
                        acc.state
                in
                when st.tree is
                    Just t ->
                        let
                            pv =
                                t.preview
                        in
                        { acc | state = { st | tree = Just { t | preview = { pv | items = Array.update c.index (\item -> { item | lines = shown }) pv.items } } } }

                    Nothing ->
                        { acc | state = st }

        ForDayTime ->
            let
                st =
                    acc.state

                seconds =
                    when Array.first lines |> Maybe.map (\l -> String.split " " (Bytes.toStringLossy l) |> Array.map String.toInt) is
                        Just [ _, Just h, Just m, Just sec ] ->
                            Just ((h * 60 + m) * 60 + sec)

                        _ ->
                            Nothing
            in
            { acc | state = { st | dayOffset = Maybe.map (\day -> day * 1000 - modBy 86400000 st.clock) seconds } }

        ForCopy ->
            let
                st =
                    acc.state

                again =
                    Dict.foldl (\pane stale list -> if stale then Array.pushLast pane list else list) [] st.copyAsked

                answered =
                    Array.foldl copyLine st lines
            in
            -- a pane changed since it was asked is asked again
            Array.foldl (\pane a -> if inCopy pane a.state then askCopy pane a else a)
                { acc | state = { answered | copyAsked = Array.foldl Dict.remove answered.copyAsked again } }
                again

        ForNumbers ->
            let
                st =
                    acc.state

                indexes =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split " " (Bytes.toStringLossy line) is
                                [ "N", id, index ] ->
                                    Maybe.map (\i -> { id = idOf id, index = i }) (String.toInt index)

                                _ ->
                                    Nothing
                        )
                        lines
            in
            { acc | state = { st | numbers = Maybe.map (\n -> { n | indexes = indexes }) st.numbers } }

        ForPanesTime ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | panesMs = Array.first lines |> Maybe.andThen (\l -> String.toInt (Bytes.toStringLossy l)) |> Maybe.withDefault st.panesMs } }

        ForMenuTitle serial ->
            { acc | state = menuPart serial (\m -> { m | title = firstLine ok lines m.title }) acc.state }

        ForMenuName part ->
            { acc | state = menuPart part.serial (\m -> { m | items = Array.update part.item (\it -> { it | name = firstLine ok lines it.name }) m.items }) acc.state }

        ForMenuCommand part ->
            { acc | state = menuPart part.serial (\m -> { m | items = Array.update part.item (\it -> { it | command = firstLine ok lines it.command }) m.items }) acc.state }

        ForCapture pane ->
            if ok then
                { acc | state = rebuild pane lines acc.state }

            else
                acc

        ForNothing ->
            acc


{-| A pane's state and both its captures, for one line: made again from
one moment (TM15). -}
recapture : Int -> Array { command : String, expect : Expect }
recapture pane =
    [ { command = infoOf pane, expect = ForInfo pane }
    , { command = captureOf True pane, expect = ForSaved pane }
    , { command = captureOf False pane, expect = ForCapture pane }
    ]


{-| A line of `panesQuery`'s answer. -}
paneLine : Bytes -> Maybe { id : Int, info : PaneInfo }
paneLine bytes =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)

        int i =
            Maybe.withDefault 0 (String.toInt (Maybe.withDefault "" (Array.get i words)))
    in
    if Array.get 0 words /= Just "P" then
        Nothing

    else
        Just
            { id = idOf (Maybe.withDefault "" (Array.get 1 words))
            , info =
                { w = int 2
                , h = int 3
                , x = int 4
                , y = int 5
                , alt = int 6 == 1
                , top = int 7
                , bottom = int 8
                , modes = String.split "," (Maybe.withDefault "" (Array.get 9 words)) |> Array.mapAndKeepJust String.toInt
                , saved = []
                }
            }


{-| A pane's terminal made again from its capture: the main screen's lines,
then, with the alternate screen up, that screen's; the private modes that
are on; the scroll region; the cursor. Whatever the pane printed before
the capture's reply is in the capture, so what its terminal held is
dropped (TM5.8). -}
rebuild : Int -> Array Bytes -> (taken s : State) -> State
rebuild pane lines s =
    when Dict.get pane s.info is
        Nothing ->
            s

        Just i ->
            let
                screen ls =
                    Bytes.flatten (Array.intersperse (Bytes.fromString "\u{001B}[0m\r\n") ls)

                modes =
                    Array.map (\m -> "\u{001B}[?" ++ String.fromInt m ++ "h") i.modes
                        ++ (if Array.member 25 i.modes then [] else [ "\u{001B}[?25l" ])
                        ++ (if Array.member 7 i.modes then [] else [ "\u{001B}[?7l" ])

                region =
                    if i.top > 0 || i.bottom < i.h - 1 then
                        "\u{001B}[" ++ String.fromInt (i.top + 1) ++ ";" ++ String.fromInt (i.bottom + 1) ++ "r"

                    else
                        ""

                cursor =
                    "\u{001B}[" ++ String.fromInt (i.y + 1) ++ ";" ++ String.fromInt (i.x + 1) ++ "H"

                made =
                    blank i.w i.h
                        |> Vt.feed (screen (if i.alt then i.saved else lines))
                        |> Vt.feed (Bytes.fromString (if i.alt then "\u{001B}[0m\u{001B}[?1049h\u{001B}[H" else "\u{001B}[0m"))
                        |> (\t -> if i.alt then Vt.feed (screen lines) t else t)
                        |> Vt.feed (Bytes.fromString ("\u{001B}[0m" ++ String.join "" modes ++ region ++ cursor))

                term =
                    (Vt.takeReplies made).term
            in
            when Array.findFirst (\x -> x == pane) s.ids is
                Just found ->
                    { s | panes = Builder.set found.index term s.panes }

                Nothing ->
                    { s | ids = Array.pushLast pane s.ids, panes = Builder.pushLast term s.panes }


{-| A line of `modeFormat`: the pane's mode's key table kept, copy mode's
and view mode's by `mode-keys` (`window_copy_key_table`); the other modes
take keys without a table (TM25). -}
modeLine : String -> (taken s : State) -> State
modeLine line s =
    when String.split " " line is
        [ "M", id, mode, modeKeys ] ->
            let
                table =
                    if mode == "copy-mode" || mode == "view-mode" then
                        if modeKeys == "vi" then "copy-mode-vi" else "copy-mode"

                    else
                        ""
            in
            { s | modes = Dict.set (idOf id) table s.modes, paneModes = Dict.set (idOf id) mode s.paneModes, modeKeys = if modeKeys == "" then s.modeKeys else modeKeys }

        _ ->
            s


{-| A line of `windowQuery`'s answer: `W @window %pane layout name`. -}
replyLine : Bytes -> (taken s : State) -> State
replyLine bytes s =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)
    in
    when Array.get 0 words is
        Just "W" ->
            -- the active pane asked with the window: a layout before 3.4's
            -- new-layouts does not mark it, and keys go nowhere without it
            -- (TM24)
            let
                shown =
                    showWindow (idOf (Maybe.withDefault "" (Array.get 1 words))) (Maybe.withDefault "" (Array.get 3 words)) (String.join " " (Array.dropFirst 4 words)) s

                pane =
                    idOf (Maybe.withDefault "" (Array.get 2 words))
            in
            if pane >= 0 then
                { shown | active = pane }

            else
                shown

        _ ->
            s


idOf : String -> Int
idOf w =
    Maybe.withDefault -1 (String.toInt (String.dropFirst 1 w))


showWindow : Int -> String -> String -> (taken s : State) -> State
showWindow window layoutText name s =
    if window < 0 then
        s

    else
        applyLayout layoutText { s | window = window, name = if name == "" then s.name else name }


notice : Notice -> (taken acc : Acc) -> Acc
notice n acc =
    let
        st =
            acc.state
    in
    when n is
        Output o ->
            when Dict.get o.pane st.nested is
                Just inner ->
                    -- a nested client's control mode, dropped until it ends
                    let
                        fed =
                            Control.feed o.bytes inner

                        nested =
                            if Control.isInside fed.reader then
                                Dict.set o.pane fed.reader st.nested

                            else
                                Dict.remove o.pane st.nested
                    in
                    { acc | state = feedPane o.pane (outsideOf fed.events) { st | nested = nested } }

                Nothing ->
                    if Control.startsControl o.bytes then
                        -- `tmux -CC` run inside a pane (TM19): an empty line
                        -- detaches that client, what it sends in control mode
                        -- is dropped, and the pane says why
                        let
                            fed =
                                Control.feed o.bytes Control.reader

                            said =
                                feedPane o.pane
                                    (Bytes.flatten [ outsideOf fed.events, Bytes.fromString "\r\npuritty: tmux -CC inside a tmux pane is not shown; it was detached.\r\n" ])
                                    { st | nested = if Control.isInside fed.reader then Dict.set o.pane fed.reader st.nested else st.nested }

                            detached =
                                sent (Command.sendBytes o.pane (Bytes.fromString "\n")) said
                        in
                        { acc | state = detached.state, commands = acc.commands ++ detached.commands }

                    else if inCopy o.pane st then
                        -- tmux keeps a copy mode's view where it was as lines
                        -- arrive: asked again (TM31)
                        askCopy o.pane { acc | state = feedPane o.pane o.bytes st }

                    else
                        { acc | state = feedPane o.pane o.bytes st }

        LayoutChange l ->
            if l.window == st.window || st.window < 0 then
                { acc | state = applyLayout l.visible { st | window = l.window, modal = String.contains "O" l.flags } }

            else
                { acc | state = st }

        WindowPaneChanged p ->
            if p.window == st.window then
                { acc | state = { st | active = p.pane } }

            else
                { acc | state = st }

        SessionWindowChanged _ ->
            -- another window of the session shown: ask for its layout
            ask [ { command = windowQuery, expect = ForWindow } ] { acc | state = st }

        SessionChanged _ ->
            ask [ { command = windowQuery, expect = ForWindow }, { command = tabsQuery, expect = ForTabs }, { command = panesQuery, expect = ForPanes } ] { acc | state = st }

        Pause pane ->
            -- puritty fell behind on the pane and tmux dropped what was
            -- queued (TM19): continue it, and on the same line make it
            -- again from one moment, so nothing between is lost
            askLine ([ { command = Command.continuePane pane, expect = ForNothing } ] ++ recapture pane) { acc | state = st }

        Exit reason ->
            -- why the panes go: said on the terminal they leave behind
            if reason == "" then
                { acc | state = st }

            else
                { acc | state = st, outside = Array.pushLast (Bytes.fromString ("\r\npuritty: tmux control mode ended: " ++ reason ++ "\r\n")) acc.outside }

        WindowAdd _ ->
            ask [ { command = tabsQuery, expect = ForTabs } ] { acc | state = st }

        WindowClose _ ->
            ask [ { command = tabsQuery, expect = ForTabs } ] { acc | state = st }

        Message text ->
            { acc | state = { st | said = text } }

        PaneModeChanged pane ->
            ask [ { command = "display-message -p -t " ++ Command.quote ("%" ++ String.fromInt pane) ++ " " ++ Command.quote modeFormat, expect = ForModes } ] { acc | state = st }

        SubscriptionChanged sub ->
            let
                was =
                    st.status.borderStatus

                next =
                    { st | status = subscribed sub.name sub.window sub.pane sub.value st.status }
            in
            if next.status.borderStatus /= was then
                -- the panes' sizes change with their titles' rows, and
                -- tmux sends no layout for it
                { acc | state = refit next }

            else
                { acc | state = next }

        WindowRenamed r ->
            let
                tabs =
                    Array.map (\t -> if t.id == r.window then { t | name = r.name } else t) st.tabs
            in
            if r.window == st.window then
                { acc | state = { st | name = r.name, tabs = tabs } }

            else
                { acc | state = { st | tabs = tabs } }

        _ ->
            { acc | state = st }


{-| A pane's output fed to its terminal, made at a guessed size if tmux
has not yet said where it goes; its replies dropped. -}
feedPane : Int -> Bytes -> (taken s : State) -> State
feedPane id bytes s =
    when Array.findFirst (\i -> i == id) s.ids is
        Just found ->
            let
                back =
                    backOf id s

                pushedBefore =
                    if back > 0 then
                        Maybe.withDefault 0 (withPane id s Vt.rowsPushed)

                    else
                        0

                fed =
                    { s | panes = Builder.update found.index (\t -> (Vt.takeReplies (Vt.feed bytes t)).term) s.panes }
            in
            if back > 0 then
                -- a view scrolled back stays on its rows as more come in
                let
                    after =
                        withPane id fed (\t -> { pushed = Vt.rowsPushed t, most = Vt.scrollbackRows t })
                            |> Maybe.withDefault { pushed = pushedBefore, most = back }
                in
                { fed | back = Dict.set id (min after.most (back + after.pushed - pushedBefore)) fed.back }

            else
                fed

        Nothing ->
            { s | ids = Array.pushLast id s.ids, panes = Builder.pushLast (Vt.takeReplies (Vt.feed bytes (blank 80 24))).term s.panes }


{-| A layout: its panes' terminals made or sized to their boxes. -}
applyLayout : String -> (taken s : State) -> State
applyLayout text s =
    when Layout.parse text is
        Ok cell ->
            let
                boxes =
                    Array.map (fitted s.status.borderStatus (heightOf cell)) (Layout.panes cell)

                sized =
                    sizeAll { ids = s.ids, panes = s.panes } boxes

                active =
                    when Array.findFirst .active boxes is
                        Just a ->
                            a.value.id

                        Nothing ->
                            s.active
            in
            { s | layout = Just cell, ids = sized.ids, panes = sized.panes, active = active }

        Err _ ->
            s


{-| Every pane sized again to the layout as it is placed now. -}
refit : (taken s : State) -> State
refit s =
    when s.layout is
        Just cell ->
            let
                sized =
                    sizeAll { ids = s.ids, panes = s.panes } (Array.map (fitted s.status.borderStatus (heightOf cell)) (Layout.panes cell))
            in
            { s | ids = sized.ids, panes = sized.panes }

        Nothing ->
            s


{-| Every pane of the layout sized, or made, in turn: a loop rather than a
fold, so that the compiler sees each step keep the ids and the terminals
as many as each other (TM34). -}
sizeAll : (taken acc : { ids : Array Int, panes : Builder Vt.Term } where Array.length acc.ids == Builder.length acc.panes) -> Array Layout.Pane -> (r : { ids : Array Int, panes : Builder Vt.Term } where Array.length r.ids == Builder.length r.panes)
sizeAll acc boxes =
    when Array.popFirst boxes is
        Just { first, rest } ->
            sizeAll (sizePane first acc) rest

        Nothing ->
            acc


sizePane : Layout.Pane -> (taken acc : { ids : Array Int, panes : Builder Vt.Term } where Array.length acc.ids == Builder.length acc.panes) -> (r : { ids : Array Int, panes : Builder Vt.Term } where Array.length r.ids == Builder.length r.panes)
sizePane place acc =
    when Array.findFirst (\i -> i == place.id) acc.ids is
        Just found ->
            { ids = acc.ids
            , panes =
                Builder.update found.index
                    (\t ->
                        if t.cols /= place.w || t.rows /= place.h then
                            Vt.resize (max 1 place.w) (max 1 place.h) t

                        else
                            t
                    )
                    acc.panes
            }

        Nothing ->
            { ids = Array.pushLast place.id acc.ids, panes = Builder.pushLast (blank place.w place.h) acc.panes }


{-| The window's picture made again: the tiled panes with lines between,
the floating ones over them in boxes, the bottom first, and the cursor at
the active pane's. -}
paint : (taken s : State) -> State
paint s =
    when s.layout is
        Nothing ->
            s

        Just cell ->
            let
                tiled =
                    placedPanes s cell (Layout.tiled cell)

                floating =
                    placedPanes s cell (Layout.floating cell)

                barRow =
                    if s.barTop then 0 else s.canvas.rows - 1

                tabBar =
                    tabsOf cols barRow s

                -- in tmux's look, a prompt or a message over the whole bar, as
                -- tmux shows them on its status line (TM25)
                tmuxLine =
                    if not s.lookTmux then
                        []

                    else
                        when s.asking is
                            Just a ->
                                [ { row = barRow, col = 0, text = String.padRight cols ' ' (String.takeFirst cols (a.label ++ String.fromArray a.chars)) } ]

                            Nothing ->
                                if s.said == "" then
                                    []

                                else
                                    [ { row = barRow, col = 0, text = String.padRight cols ' ' (String.takeFirst cols s.said) } ]

                -- the caret of a prompt in tmux's look: the text before it
                -- written again leaves the cursor after it, wide characters
                -- counted by the core; none while puritty's box asks, which
                -- draws its own
                caretPiece =
                    when s.asking is
                        Just a ->
                            if s.lookTmux then
                                [ { row = barRow, col = 0, text = String.takeFirst cols (a.label ++ String.fromArray (Array.slice 0 a.caret a.chars)) } ]

                            else
                                []

                        Nothing ->
                            []

                shownCursor =
                    when { asking = s.asking, view = s.view, menu = if s.menu /= Nothing || s.tree /= Nothing then Just {} else Nothing } is
                        { asking = Just _, view = _, menu = _ } ->
                            if s.lookTmux then "\u{001B}[?25h" else "\u{001B}[?25l"

                        { asking = Nothing, view = Just _, menu = _ } ->
                            "\u{001B}[?25l"

                        { asking = Nothing, view = Nothing, menu = Just _ } ->
                            "\u{001B}[?25l"

                        _ ->
                            cursor

                -- tmux's other modes (TM32): the clock drawn, the others
                -- said; and the tree puritty shows for `choose-tree`
                modesDrawn =
                    Array.mapAndFlatten (\p -> modeOverlay s.lookTmux (p.id == active) (Maybe.withDefault "" (Dict.get p.id s.paneModes)) (clockText s) p) (tiled ++ floating)

                treeDrawn =
                    when s.tree is
                        Just t ->
                            if t.loaded < 2 then
                                []

                            else
                                let
                                    area =
                                        if t.zoom then
                                            Just { id = -1, x = 0, y = if s.barTop then bar else 0, w = cols, h = rows - bar, active = True, z = Nothing }

                                        else
                                            Array.findFirst (\p -> p.id == t.pane) (tiled ++ floating) |> Maybe.map .value
                                in
                                when area is
                                    Just place ->
                                        drawTree s.lookTmux place t

                                    Nothing ->
                                        []

                        Nothing ->
                            []

                -- the panes' numbers (TM28)
                numbersDrawn =
                    when s.numbers is
                        Just n ->
                            Array.mapAndFlatten (\p -> paneNumber s.lookTmux (p.id == active) n p) (tiled ++ floating)

                        Nothing ->
                            []

                -- the bar in tmux's look, tmux's status line (TM29)
                tmuxLook =
                    s.lookTmux

                statusBar =
                    if s.lookTmux then (tmuxBar cols barRow s).pieces else []

                -- a menu of tmux's (TM27), once tmux has answered its
                -- formats
                menuDrawn =
                    when s.menu is
                        Just m ->
                            if m.pending > 0 then
                                []

                            else
                                drawMenu s.lookTmux (menuPlace cols rows s m) m

                        Nothing ->
                            []

                -- a view of what tmux printed (TM26): over the active pane
                -- in tmux's look, in a box over the panes in puritty's
                viewDrawn =
                    when s.view is
                        Just v ->
                            if s.lookTmux then
                                when Array.findFirst (\p -> p.id == active) (tiled ++ floating) is
                                    Just place ->
                                        tmuxView place.value v

                                    Nothing ->
                                        boxView cols rows s.barTop v

                            else
                                boxView cols rows s.barTop v

                        Nothing ->
                            { rows = 0, pieces = [] }

                -- what tmux or puritty said, at the bar's right (TM24)
                saidPiece =
                    let
                        room =
                            max 0 (cols - String.count tabBar.text - 2)

                        -- what was said, else tmux's `status-right` without
                        -- its styles (TM29)
                        shown =
                            String.takeFirst room (if s.said == "" then Style.strip s.status.right else s.said)
                    in
                    if shown == "" then
                        []

                    else
                        [ { row = barRow, col = cols - String.count shown - 1, text = shown } ]

                active =
                    s.active

                -- where each pane goes, and how far back its view is, read
                -- before the canvas is written
                tiledPlaces =
                    placesOf tiled s

                floatPlaces =
                    Array.map (\p -> { id = p.id, places = [] }) floating |> eachPlaces floating s

                cols =
                    s.canvas.cols

                rows =
                    s.canvas.rows

                -- the selection's cells, read before the canvas is written
                tiledSpans =
                    spansAll tiled s

                floatSpans =
                    Array.map (\p -> { id = p.id, spans = [] }) floating
                        |> withSpans floating s

                -- the dividers right of and below each tiled pane
                lines =
                    Array.mapAndFlatten (divider cols rows) tiled

                -- in tmux's look the lines in `pane-border-style`, the
                -- active pane's framed in its own; the marked pane framed
                -- in either look; each pane's `pane-border-format` on its
                -- border when `pane-border-status` asks (TM30)
                borders =
                    paneBorders s.lookTmux cols rows active tiled floating s.status

                cursor =
                    when { copying = Dict.get s.active s.copy, place = Array.findFirst (\p -> p.id == s.active) (tiled ++ floating) } is
                        { copying = Just c, place = Just place } ->
                            -- copy mode's cursor, where tmux has it (TM31)
                            "\u{001B}[" ++ String.fromInt (place.value.y + c.cy + 1) ++ ";" ++ String.fromInt (place.value.x + c.cx + 1) ++ "H\u{001B}[?25h"

                        _ ->
                            if not (String.startsWith "copy-mode" (Maybe.withDefault "" (Dict.get s.active s.paneModes)) || Maybe.withDefault "" (Dict.get s.active s.paneModes) == "") then
                                -- the clock and the modes puritty does not
                                -- draw show no cursor, as in tmux (TM32)
                                "\u{001B}[?25l"

                            else
                                cursorOf s.active (backOf s.active s) (tiled ++ floating) s.ids s.panes

                -- copy mode's position at a pane's top right, as tmux shows
                -- it (TM31)
                copyMarks =
                    Array.mapAndKeepJust
                        (\p ->
                            Dict.get p.id s.copy
                                |> Maybe.map
                                    (\c ->
                                        let
                                            text =
                                                "[" ++ String.fromInt c.scroll ++ "/" ++ String.fromInt c.hsize ++ "]"
                                        in
                                        { row = p.y, col = p.x + max 0 (p.w - String.count text), color = if s.lookTmux then messageColor else activeTabColor, text = String.takeFirst p.w text }
                                    )
                        )
                        (tiled ++ floating)

                -- the tiled panes and their dividers, then each floating
                -- pane in its box, the bottom one first
                composed =
                    s.canvas
                        |> Vt.feed (Bytes.fromString "\u{001B}[?7l\u{001B}[0m\u{001B}[H\u{001B}[2J")
                        |> Vt.compose s.panes tiledPlaces
                        |> Vt.invert tiledSpans
                        |> drawText borders.lineColor lines
                        |> drawPieces borders.tiled
                        |> (\c -> Array.foldl (\p acc -> acc |> drawText (if p.id == active then activeColor else boxColor) (boxAround cols rows p) |> Vt.compose s.panes (placesIn p.id floatPlaces) |> Vt.invert (spansIn p.id floatSpans)) c floating)
                        |> drawPieces borders.floating
                        |> drawPieces copyMarks
                        |> drawPieces modesDrawn
                        |> drawPieces treeDrawn
                        |> (\c ->
                                if tmuxLook then
                                    drawPieces statusBar c

                                else
                                    c
                                        |> drawText barColor [ { row = barRow, col = 0, text = String.padRight cols ' ' tabBar.text } ]
                                        |> drawText activeTabColor tabBar.active
                                        |> drawText alertTabColor tabBar.alerted
                                        |> drawText busyTabColor tabBar.busy
                                        |> drawText barColor saidPiece
                           )
                        |> drawText messageColor tmuxLine
                        |> drawText messageColor caretPiece
                        |> (\c -> Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) c viewDrawn.pieces)
                        |> (\c -> Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) c numbersDrawn)
                        |> (\c -> Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) c menuDrawn)
                        |> Vt.feed (Bytes.fromString shownCursor)
            in
            { s | canvas = (Vt.takeReplies composed).term, view = Maybe.map (\v -> { v | rows = max 1 viewDrawn.rows }) s.view }


{-| CUP to the active pane's cursor in the window, and DECTCEM as the
pane has it. -}
cursorOf : Int -> Int -> Array Layout.Pane -> Array Int -> Builder Vt.Term -> String
cursorOf active back boxes ids panes =
    when { place = Array.findFirst (\b -> b.id == active) boxes, index = Array.findFirst (\i -> i == active) ids } is
        { place = Just place, index = Just index } ->
            when Builder.get index.index panes is
                Just t ->
                    let
                        at =
                            Vt.cursorOf t
                    in
                    if at.y + back >= place.value.h then
                        -- scrolled back past it
                        "\u{001B}[?25l"

                    else
                        "\u{001B}["
                            ++ String.fromInt (place.value.y + at.y + back + 1)
                            ++ ";"
                            ++ String.fromInt (place.value.x + at.x + 1)
                            ++ "H"
                            ++ (if at.visible then "\u{001B}[?25h" else "\u{001B}[?25l")

                Nothing ->
                    "\u{001B}[?25l"

        _ ->
            "\u{001B}[?25l"


divider : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
divider cols rows p =
    let
        right =
            if p.x + p.w < cols then
                Array.range p.y (min rows (p.y + p.h) - 1) |> Array.map (\r -> { row = r, col = p.x + p.w, text = "│" })

            else
                []

        below =
            if p.y + p.h < rows then
                [ { row = p.y + p.h, col = p.x, text = String.repeat (min p.w (cols - p.x)) "─" } ]

            else
                []
    in
    right ++ below


boxAround : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
boxAround cols rows p =
    let
        left =
            p.x - 1

        right =
            p.x + p.w

        top =
            p.y - 1

        bottom =
            p.y + p.h

        inside =
            max 0 (min p.w (cols - p.x))

        edge l mid r =
            (if left >= 0 then l else "") ++ String.repeat inside mid ++ (if right < cols then r else "")

        from =
            if left >= 0 then left else p.x
    in
    (if top >= 0 then [ { row = top, col = from, text = edge "┌" "─" "┐" } ] else [])
        ++ (Array.range p.y (min rows bottom - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        (if left >= 0 then [ { row = r, col = left, text = "│" } ] else [])
                            ++ (if right < cols then [ { row = r, col = right, text = "│" } ] else [])
                    )
           )
        ++ (if bottom < rows then [ { row = bottom, col = from, text = edge "└" "─" "┘" } ] else [])


{-| What a key or a paste sends, as commands to the active pane. -}
keys : Bytes -> (taken s : State) -> { state : State, commands : Array String }
keys bytes s =
    if s.active < 0 then
        { state = s, commands = [] }

    else
        -- a key the pane's program gets brings its view to the bottom
        sent (Command.sendBytes s.active bytes) { s | back = if Bytes.isEmpty bytes then s.back else Dict.remove s.active s.back }


{-| What a typed key sends: through the client's key table, as a key
typed at a terminal attached to tmux is, so that the prefix and bindings
work (TM23): a named key or one with Ctrl or Alt by its tmux name, other
text as its bytes. `bytes` is what the pane's modes make of the key; a key
that makes none (a release) sends nothing, and one tmux has no name for (a
Super chord) still sends them to the pane. -}
typed : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
typed k bytes ms s =
    let
        r =
            typedHere k bytes ms s

        pane =
            r.state.active
    in
    if inCopy pane r.state then
        -- where copy mode is after the key, asked behind it (TM31)
        let
            asked =
                askCopy pane { state = r.state, outside = [], commands = [], trace = [], run = Nothing }
        in
        { state = asked.state, commands = r.commands ++ asked.commands }

    else
        r


typedHere : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
typedHere k bytes ms s =
    if s.active < 0 || Bytes.isEmpty bytes then
        { state = s, commands = [] }

    else
        when { asking = s.asking, menu = s.menu, numbers = s.numbers, view = s.view } is
            { asking = Just a, menu = _, numbers = _, view = _ } ->
                promptKey k bytes ms a { s | clock = ms }

            { asking = Nothing, menu = Just m, numbers = _, view = _ } ->
                menuKey k m { s | clock = ms }

            { asking = Nothing, menu = Nothing, numbers = Just n, view = _ } ->
                numberKey k n { s | clock = ms }

            { asking = Nothing, menu = Nothing, numbers = Nothing, view = Just v } ->
                { state = { s | view = viewKey k v, clock = ms }, commands = [] }

            { asking = Nothing, menu = Nothing, numbers = Nothing, view = Nothing } ->
                when s.tree is
                    Just t ->
                        previewAfter (treeKey k t { s | clock = ms })

                    Nothing ->
                        keyByTable k bytes ms { s | clock = ms }


{-| A typed key with no prompt open: by the tables (TM24), a binding
whose prompt puritty can ask opening it (TM25). -}
keyByTable : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken s : State) -> { state : State, commands : Array String }
keyByTable k bytes ms s =
    let
        commands =
            if s.keys.byTable then
                byName k bytes s.active

            else
                -- a tmux before 3.4 has no `send-keys -K`: the bytes to
                -- the pane, its bindings out of reach (TM24)
                Command.sendBytes s.active bytes

        modeTable =
            Maybe.withDefault "" (Dict.get s.active s.modes)

        way =
            if s.keys.byTable then
                Bindings.route (lookupName k) ms modeTable s.keys

            else
                -- said at the prefix, and kept through the key after it
                let
                    isPrefix =
                        Maybe.map (\key -> Array.member key s.keys.prefixes) (lookupName k) == Just True
                in
                { send = True
                , reset = False
                , table = if isPrefix then "prefix" else "root"
                , repeatUntil = -1
                , said =
                    if isPrefix then
                        "puritty: tmux's key bindings under -CC need tmux 3.4 (send-keys -K)"

                    else if s.keys.table == "prefix" then
                        s.said

                    else
                        ""
                , held = ""
                , ran = ""
                }

        tables =
            s.keys

        followed =
            { tables | table = way.table, repeatUntil = way.repeatUntil }

        -- copy mode entered by a binding is known before tmux says so, so
        -- that a quick `/` after it is looked up in copy mode's table
        modes =
            if String.startsWith "copy-mode" way.ran then
                Dict.set s.active (if s.modeKeys == "vi" then "copy-mode-vi" else "copy-mode") s.modes

            else
                s.modes

        reset =
            if way.reset then [ "switch-client -T root" ] else []
    in
    if way.send then
        -- a key the pane's program gets brings its view to the bottom
        sent commands { s | back = Dict.remove s.active s.back, keys = followed, said = way.said, modes = modes }

    else if runsHere way.held then
        -- a prompt, a menu, or an `if-shell -F` around one: puritty runs
        -- the binding (TM25, TM27)
        let
            ctx =
                { pane = s.active, mouse = Nothing }

            back =
                sent reset { s | keys = followed, said = "" }

            ran =
                runHeld ctx "" "" way.held back.state
        in
        { state = ran.state, commands = back.commands ++ ran.commands }

    else
        sent reset { s | keys = followed, said = way.said }


{-| A prompt opened at its first question: the question and first text as
written, and the `display-message`s that expand them where they hold a
format (`#W`, `#{…}`). -}
opening : Syntax.Ask -> String -> { asking : Asking, expand : Array { command : String, expect : Expect } }
opening question after =
    let
        start =
            { ask = question, after = after, step = 0, answers = [], label = "", chars = [], caret = 0, edited = False }
    in
    stepTo 0 [] start


{-| A prompt at question `step`, with the answers before it. -}
stepTo : Int -> Array String -> Asking -> { asking : Asking, expand : Array { command : String, expect : Expect } }
stepTo step answers a =
    let
        q =
            when a.ask is
                Syntax.Confirm c ->
                    { label = c.prompt, input = "" }

                Syntax.Prompt p ->
                    { label = Maybe.withDefault "" (Array.get step p.prompts), input = Maybe.withDefault "" (Array.get step p.inputs) }

        expand text expect =
            if String.contains "#" text then
                [ { command = "display-message -p " ++ Command.quote (noTime text), expect = expect } ]

            else
                []
    in
    { asking = { a | step = step, answers = answers, label = q.label, chars = String.toArray q.input, caret = String.count q.input, edited = False }
    , expand = expand q.label ForLabel ++ expand q.input ForInput
    }


{-| A key while a prompt is open (TM25). A confirmation takes its key, or
Enter where `-y` says so, and runs its command; any other key says no. A
command prompt edits its line as tmux's emacs keys do (Left, Right, Home,
End, C-a, C-e, C-b, C-f, BSpace, DC, C-d, C-u, C-k, C-w, Up and Down for
earlier answers), Enter answers and Escape, C-c or C-g closes it; `-1`
takes one key's text, `-k` a key's name, `-N` digits, any other key
answering and then going on as typed. The commands after the prompt run
when it closes, answered or not, as tmux runs them. -}
promptKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> Asking -> (taken s : State) -> { state : State, commands : Array String }
promptKey k bytes ms a s =
    let
        name =
            Maybe.withDefault "" (lookupName k)

        text =
            Bytes.toStringLossy k.text

        plainText =
            Bitwise.and k.mods 6 == 0 && text /= "" && Maybe.withDefault False (Maybe.map (\c -> Char.toCode c.first >= 0x20 && Char.toCode c.first /= 0x7F) (String.popFirst text))

        enter =
            name == "Enter" || name == "KPEnter" || name == "C-m" || name == "C-j"

        cancel =
            name == "Escape" || name == "C-c" || name == "C-g"
    in
    when a.ask is
        Syntax.Confirm c ->
            closePrompt (if text == c.key || (enter && c.enterYes) then [ c.run ] else []) a s

        Syntax.Prompt p ->
            when p.entry is
                Syntax.Single ->
                    if cancel then
                        closePrompt [] a s

                    else
                        answer (if plainText then text else name) a s

                Syntax.KeyName ->
                    answer name a s

                Syntax.Numeric ->
                    if plainText && String.all Char.isDigit text then
                        { state = { s | asking = Just (insert text a) }, commands = [] }

                    else if enter then
                        answer (String.fromArray a.chars) a s

                    else if cancel then
                        closePrompt [] a s

                    else if name == "BSpace" || name == "C-h" then
                        { state = { s | asking = Just (editLine name a s.history) }, commands = [] }

                    else
                        -- the count answered, and the key goes on as typed
                        let
                            counted =
                                answer (String.fromArray a.chars) a s

                            next =
                                typed k bytes ms counted.state
                        in
                        { state = next.state, commands = counted.commands ++ next.commands }

                Syntax.Text ->
                    if enter then
                        answer (String.fromArray a.chars) a s

                    else if cancel then
                        closePrompt [] a s

                    else if plainText then
                        { state = { s | asking = Just (insert text a) }, commands = [] }

                    else
                        { state = { s | asking = Just (editLine name a s.history) }, commands = [] }


{-| Text typed at the caret. -}
insert : String -> Asking -> Asking
insert text a =
    let
        added =
            String.toArray text
    in
    { a | chars = Array.slice 0 a.caret a.chars ++ added ++ Array.dropFirst a.caret a.chars, caret = a.caret + Array.length added, edited = True }


{-| An editing key, by its tmux name, on the line. -}
editLine : String -> Asking -> Array String -> Asking
editLine name a history =
    let
        n =
            Array.length a.chars

        wordStart =
            -- the start of the word before the caret, spaces before it too
            let
                back i skipping =
                    if i <= 0 then
                        0

                    else
                        let
                            space =
                                Array.get (i - 1) a.chars == Just ' '
                        in
                        if skipping && space then
                            back (i - 1) True

                        else if space then
                            i

                        else
                            back (i - 1) False
            in
            back a.caret True

        recalled step =
            -- Up goes back through earlier answers, Down forward
            let
                current =
                    String.fromArray a.chars

                at =
                    clamp 0 (Array.length history) (Array.findLast (\h -> h == current) history |> Maybe.map .index |> Maybe.withDefault (Array.length history))

                -- one back or one on, written so that neither can wrap
                to =
                    if step < 0 then
                        if at > 0 then at - 1 else -1

                    else if at < Array.length history then
                        at + 1

                    else
                        Array.length history
            in
            when Array.get to history is
                Just h ->
                    { a | chars = String.toArray h, caret = String.count h, edited = True }

                Nothing ->
                    if to >= Array.length history then
                        { a | chars = [], caret = 0, edited = True }

                    else
                        a
    in
    if name == "Left" || name == "C-b" then
        { a | caret = max 0 (a.caret - 1) }

    else if name == "Right" || name == "C-f" then
        { a | caret = min n (a.caret + 1) }

    else if name == "Home" || name == "C-a" then
        { a | caret = 0 }

    else if name == "End" || name == "C-e" then
        { a | caret = n }

    else if name == "BSpace" || name == "C-h" then
        if a.caret == 0 then
            a

        else
            { a | chars = Array.slice 0 (a.caret - 1) a.chars ++ Array.dropFirst a.caret a.chars, caret = a.caret - 1, edited = True }

    else if name == "DC" || name == "C-d" then
        { a | chars = Array.slice 0 a.caret a.chars ++ Array.dropFirst (a.caret + 1) a.chars, edited = True }

    else if name == "C-u" then
        { a | chars = Array.dropFirst a.caret a.chars, caret = 0, edited = True }

    else if name == "C-k" then
        { a | chars = Array.slice 0 a.caret a.chars, edited = True }

    else if name == "C-w" then
        { a | chars = Array.slice 0 wordStart a.chars ++ Array.dropFirst a.caret a.chars, caret = wordStart, edited = True }

    else if name == "Up" then
        recalled -1

    else if name == "Down" then
        recalled 1

    else
        a


{-| An answer to the question asked: the next question, or the command
run with every answer, then the commands after the prompt. A typed line
is kept for Up. -}
answer : String -> Asking -> (taken s : State) -> { state : State, commands : Array String }
answer given a s =
    let
        answers =
            Array.pushLast given a.answers

        history =
            if given == "" || Array.last s.history == Just given then s.history else Array.pushLast given s.history
    in
    when a.ask is
        Syntax.Prompt p ->
            if a.step + 1 < Array.length p.prompts then
                let
                    next =
                        stepTo (a.step + 1) answers a
                in
                sendAsking next.expand { s | asking = Just next.asking, history = history }

            else
                let
                    line =
                        when p.template is
                            Just t ->
                                Syntax.fill t answers

                            Nothing ->
                                given
                in
                closePrompt (if String.trim line == "" then [] else [ line ]) a { s | history = history }

        Syntax.Confirm _ ->
            closePrompt [] a s


{-| The prompt closed: `run`, then the commands after it, each said at the
bar if it says anything. -}
closePrompt : Array String -> Asking -> (taken s : State) -> { state : State, commands : Array String }
closePrompt run a s =
    let
        lines =
            run ++ (if a.after == "" then [] else [ a.after ])
    in
    sendAsking (Array.map (\c -> { command = c, expect = ForRan }) (Array.mapAndFlatten Syntax.lines lines)) { s | asking = Nothing }


{-| Commands sent, each with what its reply is for. -}
sendAsking : Array { command : String, expect : Expect } -> (taken s : State) -> { state : State, commands : Array String }
sendAsking list s =
    { state = { s | expecting = s.expecting ++ Array.map .expect list }, commands = Array.map .command list }


{-| A key as `send-keys -K` takes it (TM23): by its tmux name where it has
one, other text as its bytes, a Super chord as the pane's bytes. -}
byName : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> Array String
byName k bytes pane =
    when keyName k is
        Just name ->
            [ Command.sendKey name ]

        Nothing ->
            if Bitwise.and (Bitwise.and k.mods 15) 14 == 0 && not (Bytes.isEmpty k.text) then
                Command.typeText k.text

            else
                Command.sendBytes pane bytes


{-| A key's name as `list-keys` gives it: `keyName`'s, or a character
typed alone, a space as `Space`. -}
lookupName : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe String
lookupName k =
    when keyName k is
        Just name ->
            Just name

        Nothing ->
            let
                text =
                    Bytes.toStringLossy k.text
            in
            if text == " " then
                Just "Space"

            else if String.count text == 1 then
                Just text

            else
                Nothing


{-| A key's tmux name (tmux(1) KEY BINDINGS): a named key (`Up`, `F5`,
`BSpace`), or a character with Ctrl or Alt, with `C-`, `M-` and, for a
named key or a Ctrl letter, `S-`. `Nothing` for plain text, which goes as
its bytes, and for a chord with Super. -}
keyName : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe String
keyName k =
    let
        mods =
            Bitwise.and k.mods 15

        shift =
            Bitwise.and mods 1 /= 0

        ctrl =
            Bitwise.and mods 2 /= 0

        alt =
            Bitwise.and mods 4 /= 0

        lead =
            (if ctrl then "C-" else "") ++ (if alt then "M-" else "")

        text =
            Bytes.toStringLossy k.text

        printable str =
            String.count str == 1 && Maybe.withDefault False (Maybe.map (\c -> Char.toCode c >= 0x20 && Char.toCode c /= 0x7F) (Maybe.map .first (String.popFirst str)))
    in
    if Bitwise.and mods 8 /= 0 then
        Nothing

    else
        when namedKey k.sym is
            Just "BTab" ->
                Just (lead ++ "BTab")

            Just name ->
                Just (lead ++ (if shift then "S-" else "") ++ name)

            Nothing ->
                if ctrl then
                    when Char.fromCode k.unshifted is
                        Just c ->
                            if k.unshifted > 0x20 && k.unshifted < 0x7F then
                                Just (lead ++ (if shift && Char.isAlpha c then "S-" else "") ++ String.toLower (String.fromChar c))

                            else if k.unshifted == 0x20 then
                                Just (lead ++ "Space")

                            else
                                Nothing

                        Nothing ->
                            Nothing

                else if alt then
                    if text == " " then
                        Just "M-Space"

                    else if printable text then
                        Just ("M-" ++ text)

                    else
                        Nothing

                else
                    Nothing


{-| tmux's name for a key by its X keysym, as both platforms' windows give
it. -}
namedKey : Int -> Maybe String
namedKey sym =
    if sym >= 0xFFBE && sym <= 0xFFC9 then
        Just ("F" ++ String.fromInt (sym - 0xFFBE + 1))

    else
        when sym is
            0xFF52 ->
                Just "Up"

            0xFF54 ->
                Just "Down"

            0xFF51 ->
                Just "Left"

            0xFF53 ->
                Just "Right"

            0xFF50 ->
                Just "Home"

            0xFF57 ->
                Just "End"

            0xFF55 ->
                Just "PPage"

            0xFF56 ->
                Just "NPage"

            0xFF63 ->
                Just "IC"

            0xFFFF ->
                Just "DC"

            0xFF09 ->
                Just "Tab"

            0xFE20 ->
                Just "BTab"

            0xFF0D ->
                Just "Enter"

            0xFF8D ->
                Just "KPEnter"

            0xFF1B ->
                Just "Escape"

            0xFF08 ->
                Just "BSpace"

            _ ->
                Nothing


{-| `n` more replies to read and drop. -}
waitingFor : Int -> (taken s : State) -> State
waitingFor n s =
    { s | expecting = s.expecting ++ Array.repeat n ForNothing }


{-| Commands whose replies say nothing puritty reads, sent. -}
sent : Array String -> (taken s : State) -> { state : State, commands : Array String }
sent commands s =
    { state = { s | expecting = s.expecting ++ Array.map (\_ -> ForNothing) commands }, commands = commands }


{-| What a key sends the active pane's program, by that pane's modes
(DECCKM, keypad, the kitty flags, modifyOtherKeys); `Nothing` when no pane
is active yet. -}
encodeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> State -> Maybe Bytes
encodeKey k s =
    withPane s.active s (\t -> Keys.encode t k)


{-| Whether a private mode is set in the active pane, as bracketed paste
(2004) and focus reports (1004) are asked. -}
activeMode : Int -> State -> Maybe Bool
activeMode mode s =
    withPane s.active s (\t -> Dict.get mode t.modes == Just True)


{-| What a pane's terminal answers, looked at in place. -}
withPane : Int -> State -> (Vt.Term -> a) -> Maybe a
withPane pane s f =
    when Array.findFirst (\i -> i == pane) s.ids is
        Just found ->
            when Builder.get found.index s.panes is
                Just t ->
                    Just (f t)

                Nothing ->
                    Nothing

        Nothing ->
            Nothing


{-| How far back a pane's view is scrolled. -}
backOf : Int -> State -> Int
backOf pane s =
    Maybe.withDefault 0 (Dict.get pane s.back)


{-| The cells of the canvas a pane's part of the selection covers, row by
row, where they show: its rows are absolute (pushed rows and the screen's),
drawn at the pane's place less how far it is scrolled back. -}
spans : Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
spans q s =
    when Dict.get q.id s.copy |> Maybe.andThen .selection is
        Just sel ->
            copySpans q (Maybe.withDefault { scroll = 0, hsize = 0, cx = 0, cy = 0, selection = Nothing, rectangle = False } (Dict.get q.id s.copy)) sel

        Nothing ->
            ownSpans q s


{-| Copy mode's selection on the canvas (TM31): tmux's lines made the view's
rows by the view's top (`history_size` less `scroll_position`), each end's
cell included, by cells or, as a rectangle, the same columns on every row. -}
copySpans : Layout.Pane -> Copying -> { sx : Int, sy : Int, ex : Int, ey : Int } -> Array { row : Int, from : Int, to : Int }
copySpans q c sel =
    let
        top =
            c.hsize - c.scroll

        ordered =
            if sel.sy < sel.ey || (sel.sy == sel.ey && sel.sx <= sel.ex) then
                { fx = sel.sx, fy = sel.sy, tx = sel.ex, ty = sel.ey }

            else
                { fx = sel.ex, fy = sel.ey, tx = sel.sx, ty = sel.sy }

        left =
            min sel.sx sel.ex

        right =
            max sel.sx sel.ex
    in
    Array.range (max ordered.fy top) (min ordered.ty (top + q.h - 1))
        |> Array.map
            (\r ->
                if c.rectangle then
                    { row = q.y + r - top, from = q.x + left, to = q.x + min (q.w - 1) right }

                else
                    { row = q.y + r - top
                    , from = q.x + (if r == ordered.fy then ordered.fx else 0)
                    , to = q.x + min (q.w - 1) (if r == ordered.ty then ordered.tx else q.w - 1)
                    }
            )


ownSpans : Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
ownSpans q s =
    when s.selection is
        Just sel ->
            if sel.pane /= q.id then
                []

            else
                Maybe.withDefault []
                    (withPane q.id s
                        (\t ->
                            let
                                top =
                                    Vt.rowsPushed t - backOf q.id s

                                ordered =
                                    if before sel.head sel.anchor then
                                        { from = sel.head, to = sel.anchor }

                                    else
                                        { from = sel.anchor, to = sel.head }
                            in
                            Array.range (max ordered.from.row top) (min ordered.to.row (top + q.h - 1))
                                |> Array.map
                                    (\r ->
                                        { row = q.y + r - top
                                        , from = q.x + (if r == ordered.from.row then ordered.from.col else 0)
                                        , to = q.x + (if r == ordered.to.row then ordered.to.col else q.w - 1)
                                        }
                                    )
                        )
                    )

        Nothing ->
            []


placesOf : Array Layout.Pane -> State -> Array { index : Int, x : Int, y : Int, back : Int }
placesOf panes s =
    Array.mapAndKeepJust (\p -> Array.findFirst (\i -> i == p.id) s.ids |> Maybe.map (\found -> { index = found.index, x = p.x, y = p.y, back = backOf p.id s })) panes


eachPlaces : Array Layout.Pane -> State -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int } } -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int } }
eachPlaces panes s _ =
    Array.map (\p -> { id = p.id, places = placesOf [ p ] s }) panes


placesIn : Int -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int } } -> Array { index : Int, x : Int, y : Int, back : Int }
placesIn id all =
    Array.findFirst (\e -> e.id == id) all |> Maybe.map (\e -> e.value.places) |> Maybe.withDefault []


spansAll : Array Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
spansAll panes s =
    Array.mapAndFlatten (\p -> spans p s) panes


withSpans : Array Layout.Pane -> State -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } } -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } }
withSpans panes s _ =
    Array.map (\p -> { id = p.id, spans = spans p s }) panes


spansIn : Int -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } } -> Array { row : Int, from : Int, to : Int }
spansIn id all =
    Array.findFirst (\e -> e.id == id) all |> Maybe.map (\e -> e.value.spans) |> Maybe.withDefault []


before : Vt.Point -> Vt.Point -> Bool
before a b =
    a.row < b.row || (a.row == b.row && a.col < b.col)


{-| A pointer event in the window (docs/tmux.md TM16, TM17): a press on a
floating pane's top edge moves it and on its bottom or right edge resizes
it, tmux told as the pointer reaches each new cell; a press elsewhere makes
the pane under it active. A pane whose program asked for the mouse gets the
event as its own, in its own cells; the pane a press began in keeps the
mouse until it is let go. Otherwise, or with Shift (`select`), the left
button selects within the pane (a click, a double click for a word, a
triple for a line), the paste button asks for a paste, and the wheel
scrolls the pane's view, or on its alternate screen sends three arrow
keys. `held` is the buttons held after the event; `own` is a selection's
text when it is made, for PRIMARY. -}
pointer : { ms : Int, held : Int, select : Bool, boundaries : Array Int, pasteButton : Int } -> Window.PointerEvent -> (taken s : State) -> { state : State, commands : Array String, own : Maybe String, paste : Bool }
pointer how p s =
    when s.layout is
        Nothing ->
            { state = s, commands = [], own = Nothing, paste = False }

        Just cell ->
            let
                col =
                    p.x // max 1 p.cellWidth

                row =
                    p.y // max 1 p.cellHeight

                -- the topmost pane first: floating ones top down, then tiled
                order =
                    placedPanes s cell (Array.reverse (Layout.floating cell) ++ Layout.tiled cell)

                inside q =
                    col >= q.x && col < q.x + q.w && row >= q.y && row < q.y + q.h

                onBox q =
                    q.z /= Nothing && col >= q.x - 1 && col <= q.x + q.w && row >= q.y - 1 && row <= q.y + q.h && not (inside q)

                under =
                    Array.findFirst (\q -> inside q || onBox q) order |> Maybe.map .value

                -- a press on the line right of or below a tiled pane, outside
                -- every pane and box: that pane resized (TM20)
                lineHit =
                    if p.action == 0 && p.button == 1 && under == Nothing && s.drag == Nothing then
                        Array.findFirst
                            (\q -> q.z == Nothing && ((q.x + q.w == col && row >= q.y && row < q.y + q.h) || (q.y + q.h == row && col >= q.x && col < q.x + q.w)))
                            order
                            |> Maybe.map
                                (\found ->
                                    let
                                        q =
                                            found.value
                                    in
                                    { pane = q.id, kind = if q.x + q.w == col then 2 else 3, col = col, row = row, x = q.x, y = q.y, w = q.w, h = q.h, sent = { col = col, row = row } }
                                )

                    else
                        Nothing

                barRow =
                    if s.barTop then 0 else max 0 (p.height // max 1 p.cellHeight) - 1

                tabHit =
                    if row == barRow && p.action == 0 && p.button == 1 && s.drag == Nothing && s.grab == Nothing then
                        Array.findFirst (\h -> col >= h.from && col <= h.to) (tabsOf (p.width // max 1 p.cellWidth) barRow s).hits |> Maybe.map .value

                    else
                        Nothing

                -- the pane a press began in, while a button is held
                target =
                    when s.grab is
                        Just g ->
                            Array.findFirst (\q -> q.id == g) order |> Maybe.map .value

                        Nothing ->
                            under

                plain r =
                    { state = r.state, commands = r.commands, own = Nothing, paste = False }

                -- whether the pane under the pointer, or the one that has it,
                -- has a program that takes the mouse
                takesMouse =
                    not how.select && paneTakesMouse target s
            in
            when { drag = s.drag, tab = tabHit, menu = s.menu } is
                { drag = _, tab = _, menu = Just m } ->
                    plain (menuPointer p col row m s)

                { drag = Just d, tab = _, menu = Nothing } ->
                    plain (dragged col row (p.action == 1) d s)

                { drag = Nothing, tab = Just hit, menu = Nothing } ->
                    -- a tab selects its window; `+` makes one
                    plain (sent [ if hit.window < 0 then "new-window" else "select-window -t " ++ Command.quote ("@" ++ String.fromInt hit.window) ] s)

                _ ->
                    when lineHit is
                        Just d ->
                            plain { state = { s | drag = Just d }, commands = [] }

                        Nothing ->
                            when target is
                                Nothing ->
                                    { state = s, commands = [], own = Nothing, paste = False }

                                Just q ->
                                    if p.action == 0 && p.button == 1 && onBox q then
                                        -- the top edge moves the box; the others resize it
                                        let
                                            select =
                                                selected q.id s
                                        in
                                        plain (sent select { s | drag = Just { pane = q.id, kind = if row == q.y - 1 then 0 else 1, col = col, row = row, x = q.x, y = q.y, w = q.w, h = q.h, sent = { col = col, row = row } } })

                                    else if takesMouse then
                                        let
                                            select =
                                                if p.action == 0 then
                                                    selected q.id s

                                                else
                                                    []

                                            grabbed =
                                                if p.action == 0 then
                                                    { s | grab = Just q.id }

                                                else if how.held == 0 then
                                                    { s | grab = Nothing }

                                                else
                                                    s

                                            reported =
                                                report how.held p q grabbed
                                        in
                                        plain { state = waitingFor (Array.length select) reported.state, commands = select ++ reported.commands }

                                    else
                                        selecting how p col row q s


paneTakesMouse : Maybe Layout.Pane -> State -> Bool
paneTakesMouse target s =
    when target is
        Just q ->
            withPane q.id s (\t -> (Vt.mouseModes t).tracking /= Mouse.none) == Just True

        Nothing ->
            False


{-| The pointer over a pane whose program does not take the mouse, or with
Shift: selection, paste and the wheel, as puritty does without tmux
(`Main.selecting`, `wheelStep`), in the pane's own terminal. -}
selecting : { ms : Int, held : Int, select : Bool, boundaries : Array Int, pasteButton : Int } -> Window.PointerEvent -> Int -> Int -> Layout.Pane -> (taken s : State) -> { state : State, commands : Array String, own : Maybe String, paste : Bool }
selecting how p col row q s =
    let
        at =
            Maybe.withDefault { row = 0, col = 0 }
                (withPane q.id s (\t -> { row = Vt.rowsPushed t + clamp 0 (q.h - 1) (row - q.y) - backOf q.id s, col = clamp 0 (q.w - 1) (col - q.x) }))

        none r =
            { state = r, commands = [], own = Nothing, paste = False }

        wheel =
            p.button == 4 || p.button == 5
    in
    if p.action == 0 && p.button == 2 && how.pasteButton /= 2 && not how.select && Dict.get "root MouseDown3Pane" s.keys.bindings /= Nothing then
        -- the right button: tmux's own binding for it, its menu by default,
        -- when tmux has the mouse on (TM27)
        let
            word =
                withPane q.id s (\t -> Vt.wordAt how.boundaries at t |> Maybe.map (\w -> Vt.selectionText w.start w.end t)) |> Maybe.andThen identity |> Maybe.withDefault ""

            line =
                withPane q.id s (\t -> Vt.lineAt at t |> Maybe.map (\w -> Vt.selectionText w.start w.end t)) |> Maybe.andThen identity |> Maybe.withDefault ""

            binding =
                Dict.get "root MouseDown3Pane" s.keys.bindings |> Maybe.map .command |> Maybe.withDefault ""

            r =
                runHeld { pane = q.id, mouse = Just { col = col, row = row } } word line ("if-shell -F -t " ++ paneName q.id ++ " '#{mouse}' { " ++ binding ++ " }") s
        in
        { state = r.state, commands = r.commands, own = Nothing, paste = False }

    else if p.action == 0 && p.button == how.pasteButton then
        { state = s, commands = [], own = Nothing, paste = True }

    else if p.action == 0 && wheel then
        let
            up =
                p.button == 4

            -- on the alternate screen, three arrow keys, as without tmux
            arrows =
                withPane q.id s
                    (\t ->
                        if t.alt && Dict.get 1007 t.modes /= Just False then
                            let
                                arrow =
                                    (if Dict.get 1 t.modes == Just True then "\u{001B}O" else "\u{001B}[") ++ (if up then "A" else "B")
                            in
                            Just (arrow ++ arrow ++ arrow)

                        else
                            Nothing
                    )
                    |> Maybe.andThen identity

            most =
                Maybe.withDefault 0 (withPane q.id s Vt.scrollbackRows)
        in
        when arrows is
            Just keyed ->
                let
                    r =
                        sent (Command.sendBytes q.id (Bytes.fromString keyed)) s
                in
                { state = r.state, commands = r.commands, own = Nothing, paste = False }

            Nothing ->
                let
                    now =
                        backOf q.id s

                    next =
                        if up then min most (now + 3) else max 0 (now - 3)
                in
                none { s | back = Dict.set q.id next s.back }

    else if p.action == 0 && p.button == 1 then
        let
            count =
                if how.ms - s.clicks.at <= 500 && s.clicks.pane == q.id && s.clicks.point == at then
                    modBy 3 s.clicks.count + 1

                else
                    1

            span =
                withPane q.id s
                    (\t ->
                        if count == 2 then
                            Vt.wordAt how.boundaries at t

                        else if count == 3 then
                            Vt.lineAt at t

                        else
                            Just { start = at, end = at }
                    )
                    |> Maybe.andThen identity

            sel =
                Maybe.map (\w -> { pane = q.id, anchor = w.start, head = w.end, first = w.start, last = w.end, mode = count - 1, moved = count > 1, made = False, text = "" }) span

            select =
                selected q.id s

            r =
                sent select { s | selection = sel, grab = Just q.id, clicks = { at = how.ms, count = count, pane = q.id, point = at } }
        in
        { state = r.state, commands = r.commands, own = Nothing, paste = False }

    else if p.action == 2 && Bitwise.and how.held 2 /= 0 then
        when s.selection is
            Just sel ->
                if sel.made || sel.pane /= q.id then
                    none s

                else
                    none { s | selection = Just (extended how.boundaries at sel s) }

            Nothing ->
                none s

    else if p.action == 1 && p.button == 1 then
        when s.selection is
            Just sel ->
                if sel.made then
                    none { s | grab = Nothing }

                else if sel.mode == 0 && not sel.moved then
                    -- a click: no selection
                    none { s | grab = Nothing, selection = Nothing }

                else
                    let
                        text =
                            Maybe.withDefault "" (withPane sel.pane s (Vt.selectionText sel.anchor sel.head))
                    in
                    { state = { s | grab = Nothing, selection = Just { sel | made = True, text = text } }, commands = [], own = Just text, paste = False }

            Nothing ->
                none { s | grab = Nothing }

    else
        none
            (if how.held == 0 then
                { s | grab = Nothing }

             else
                s
            )


{-| A selection being dragged, its head at `at`: by cells, at it; by words
or lines, the word or line there, the first one kept on the far side. -}
extended : Array Int -> Vt.Point -> Sel -> State -> Sel
extended boundaries at sel s =
    if sel.mode == 0 then
        { sel | head = at, moved = True }

    else
        let
            w =
                withPane sel.pane s
                    (\t ->
                        if sel.mode == 1 then
                            Vt.wordAt boundaries at t

                        else
                            Vt.lineAt at t
                    )
                    |> Maybe.andThen identity
                    |> Maybe.withDefault { start = at, end = at }
        in
        if before w.start sel.first then
            { sel | anchor = sel.last, head = w.start }

        else
            { sel | anchor = sel.first, head = w.end }


{-| The tab bar: a tab for each window, ` 1:name `, between `│`s, the
active one inverse, then ` + `, cut at the window's width; and which
columns each tab and the `+` cover, `-1` for the `+`. -}
tabsOf : Int -> Int -> State -> { text : String, active : Array { row : Int, col : Int, text : String }, alerted : Array { row : Int, col : Int, text : String }, busy : Array { row : Int, col : Int, text : String }, hits : Array { from : Int, to : Int, window : Int } }
tabsOf cols row s =
    if s.lookTmux then
        { text = "", active = [], alerted = [], busy = [], hits = (tmuxBar cols row s).hits }

    else
        puritySTabs cols row s


puritySTabs : Int -> Int -> State -> { text : String, active : Array { row : Int, col : Int, text : String }, alerted : Array { row : Int, col : Int, text : String }, busy : Array { row : Int, col : Int, text : String }, hits : Array { from : Int, to : Int, window : Int } }
puritySTabs cols row s =
    let
        -- tmux's alerts and marks on a tab (TM30): `!` a bell, `#`
        -- activity, `~` silence, `M` the marked pane, `Z` zoomed
        marksOf t =
            Dict.get t.id s.status.windows
                |> Maybe.map (\w -> String.toArray w.flags |> Array.keepIf (\c -> c == '!' || c == '#' || c == '~' || c == 'M' || c == 'Z') |> String.fromArray)
                |> Maybe.withDefault ""

        labels =
            Array.map (\t -> { window = t.id, marks = marksOf t, text = " " ++ String.fromInt t.index ++ ":" ++ t.name ++ (if marksOf t == "" then "" else " " ++ marksOf t) ++ " " }) s.tabs
                ++ [ { window = -1, marks = "", text = " + " } ]

        laid =
            Array.foldl
                (\l acc ->
                    let
                        width =
                            String.count l.text
                    in
                    { at = acc.at + width + 1
                    , text = acc.text ++ l.text ++ "│"
                    , hits = Array.pushLast { from = acc.at, to = acc.at + width - 1, window = l.window } acc.hits
                    , alerts = if String.contains "!" l.marks then Array.pushLast { from = acc.at, to = acc.at + width - 1, window = l.window } acc.alerts else acc.alerts
                    , busy = if String.contains "#" l.marks || String.contains "~" l.marks then Array.pushLast { from = acc.at, to = acc.at + width - 1, window = l.window } acc.busy else acc.busy
                    }
                )
                { at = 0, text = "", hits = [], alerts = [], busy = [] }
                labels

        place hits =
            hits
                |> Array.keepIf (\h -> h.window /= s.window && h.from < cols)
                |> Array.map (\h -> { row = row, col = h.from, text = String.slice h.from (min cols (h.to + 1)) laid.text })
    in
    { text = String.takeFirst cols laid.text
    , active =
        laid.hits
            |> Array.keepIf (\h -> h.window == s.window && h.window >= 0 && h.from < cols)
            |> Array.map (\h -> { row = row, col = h.from, text = String.slice h.from (min cols (h.to + 1)) laid.text })
    , alerted = place laid.alerts
    , busy = place laid.busy
    , hits = laid.hits
    }


-- THE PANES' BORDERS (TM30)


{-| What is drawn on the panes' borders (TM30): the lines' color, then
over the tiled panes' lines, in tmux's look, the active pane's frame in
its `pane-active-border-style`, the marked pane's frame, and each pane's
`pane-border-format` where `pane-border-status` puts it (`top`: the row
above the pane, which tmux leaves for it; `bottom`: the row below), from
two cells in, as tmux draws it (`screen_redraw_make_pane_status`), the
part after `#[align=right]` at the right; the floating panes' titles, over
their boxes, apart. -}
paneBorders : Bool -> Int -> Int -> Int -> Array Layout.Pane -> Array Layout.Pane -> StatusLine -> { lineColor : String, tiled : Array { row : Int, col : Int, color : String, text : String }, floating : Array { row : Int, col : Int, color : String, text : String } }
paneBorders tmuxLook cols rows active tiled floating status =
    let
        base =
            Style.apply status.borderStyle Style.plain

        own p =
            Maybe.withDefault { title = "", border = "", marked = False } (Dict.get p.id status.panes)

        frameColor p =
            if (own p).marked then
                if tmuxLook then Style.sgr (Style.apply "fg=magenta" base) else markedColor

            else if tmuxLook && p.id == active then
                Style.sgr (Style.apply (own p).border base)

            else
                ""

        frames =
            Array.mapAndFlatten
                (\p ->
                    let
                        color =
                            frameColor p
                    in
                    if color == "" || p.z /= Nothing then
                        []

                    else
                        Array.map (\piece -> { row = piece.row, col = piece.col, color = color, text = piece.text }) (frameOf cols rows p)
                )
                tiled

        titleOf p =
            if status.borderStatus /= "top" && status.borderStatus /= "bottom" then
                []

            else
                let
                    row =
                        if status.borderStatus == "top" then p.y - 1 else p.y + p.h

                    style =
                        if tmuxLook then
                            Style.apply (own p).border base

                        else
                            Style.apply (if p.id == active then "fg=color214" else "fg=color245") Style.plain

                    parts =
                        String.split "#[align=right]" (own p).title

                    room =
                        max 0 (p.w - 4)

                    leftRuns =
                        takeRuns room (Style.runs style (Maybe.withDefault "" (Array.first parts)))

                    rightRuns =
                        Style.runs style (String.join "" (Array.dropFirst 1 parts))

                    used =
                        Array.foldl (\r n -> n + String.count r.text) 0 leftRuns

                    rightWidth =
                        Array.foldl (\r n -> n + String.count r.text) 0 rightRuns

                    lineIn =
                        if frameColor p /= "" then frameColor p else if tmuxLook then Style.sgr base else lineColor
                in
                if row < 0 || row >= rows || (own p).title == "" then
                    []

                else
                    -- the border's line along the row, the title over it,
                    -- as tmux draws it
                    [ { row = row, col = p.x, color = lineIn, text = String.repeat (max 0 (min p.w (cols - p.x))) "─" } ]
                        ++ (laidRuns row (p.x + 2) leftRuns).pieces
                        ++ (if used + 1 + rightWidth <= room then (laidRuns row (p.x + 2 + room - rightWidth) rightRuns).pieces else [])
    in
    { lineColor = if tmuxLook then Style.sgr base else lineColor
    , tiled = frames ++ Array.mapAndFlatten titleOf tiled
    , floating = Array.mapAndFlatten titleOf floating
    }


{-| The lines around a tiled pane that are its border: beside and above
and below it, inside the window. -}
frameOf : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
frameOf cols rows p =
    let
        sides =
            Array.range p.y (min rows (p.y + p.h) - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        (if p.x > 0 then [ { row = r, col = p.x - 1, text = "│" } ] else [])
                            ++ (if p.x + p.w < cols then [ { row = r, col = p.x + p.w, text = "│" } ] else [])
                    )

        across r =
            if r >= 0 && r < rows then
                [ { row = r, col = p.x, text = String.repeat (max 0 (min p.w (cols - p.x))) "─" } ]

            else
                []
    in
    sides ++ (if p.y > 0 then across (p.y - 1) else []) ++ across (p.y + p.h)


-- THE STATUS LINE (TM29)


{-| What puritty subscribes to (`refresh-client -B`, tmux 3.2 on): tmux
sends each when it changes, at most once a second, the time in it
expanded (`T:`). -}
statusSubscriptions : Array String
statusSubscriptions =
    [ "puritty-left::#{T:status-left}"
    , "puritty-right::#{T:status-right}"
    , "puritty-style::#{status-style}"
    , "puritty-sep::#{window-status-separator}"
    , "puritty-lengths::#{status-left-length} #{status-right-length}"
    , "puritty-wtext:@*:#{?window_active,#{T:window-status-current-format},#{T:window-status-format}}"
    , "puritty-wstyle:@*:#{?window_active,#{window-status-current-style},#{window-status-style}} #{?window_bell_flag,#{window-status-bell-style},} #{?window_activity_flag,#{window-status-activity-style},}"
    , "puritty-wflags:@*:#{window_flags}"
    , "puritty-borders::#{pane-border-status} #{pane-border-style}"
    , "puritty-ptitle:%*:#{T:pane-border-format}"
    , "puritty-pborder:%*:#{?pane_active,#{E:pane-active-border-style},#{E:pane-border-style}}"
    , "puritty-pmarked:%*:#{pane_marked}"
    ]


subscribed : String -> Int -> Int -> String -> StatusLine -> StatusLine
subscribed name window pane value status =
    let
        perPane change =
            { status
                | panes =
                    Dict.set pane
                        (change (Maybe.withDefault { title = "", border = "", marked = False } (Dict.get pane status.panes)))
                        status.panes
            }

        perWindow change =
            { status
                | windows =
                    Dict.set window
                        (change (Maybe.withDefault { text = "", style = "", flags = "" } (Dict.get window status.windows)))
                        status.windows
            }
    in
    when name is
        "puritty-left" ->
            { status | left = value }

        "puritty-right" ->
            { status | right = value }

        "puritty-style" ->
            { status | style = value }

        "puritty-sep" ->
            { status | separator = value }

        "puritty-lengths" ->
            when String.split " " value |> Array.map String.toInt is
                [ Just l, Just r ] ->
                    { status | leftLength = l, rightLength = r }

                _ ->
                    status

        "puritty-wtext" ->
            perWindow (\w -> { w | text = value })

        "puritty-wstyle" ->
            perWindow (\w -> { w | style = value })

        "puritty-wflags" ->
            perWindow (\w -> { w | flags = value })

        "puritty-borders" ->
            when String.split " " value |> Array.popFirst is
                Just { first, rest } ->
                    { status | borderStatus = first, borderStyle = String.join " " rest }

                Nothing ->
                    status

        "puritty-ptitle" ->
            perPane (\q -> { q | title = value })

        "puritty-pborder" ->
            perPane (\q -> { q | border = value })

        "puritty-pmarked" ->
            perPane (\q -> { q | marked = value == "1" })

        _ ->
            status


{-| The first `n` characters of styled runs. -}
takeRuns : Int -> Array { style : Style.Style, text : String } -> Array { style : Style.Style, text : String }
takeRuns n all =
    Array.foldl
        (\r acc ->
            let
                room =
                    n - acc.used

                piece =
                    String.takeFirst (max 0 room) r.text
            in
            if room <= 0 then
                acc

            else
                { used = acc.used + String.count piece, out = Array.pushLast { r | text = piece } acc.out }
        )
        { used = 0, out = [] }
        all
        |> .out


{-| Styled runs laid from column `col` on row `row`. -}
laidRuns : Int -> Int -> Array { style : Style.Style, text : String } -> { pieces : Array { row : Int, col : Int, color : String, text : String }, end : Int }
laidRuns row col all =
    Array.foldl
        (\r acc -> { end = acc.end + String.count r.text, pieces = Array.pushLast { row = row, col = acc.end, color = Style.sgr r.style, text = r.text } acc.pieces })
        { end = col, pieces = [] }
        all


{-| The bar in tmux's look (TM29): tmux's status line as tmux 3.8 draws it
by default, measured in a tmux client inside another tmux: `status-style`
across the row, `status-left` cut to its length, the windows' own texts
in their styles with the separator between, `status-right` cut to its
length at the right; and where each window's text is, for a click. -}
tmuxBar : Int -> Int -> State -> { pieces : Array { row : Int, col : Int, color : String, text : String }, hits : Array { from : Int, to : Int, window : Int } }
tmuxBar cols row s =
    let
        base =
            Style.apply s.status.style Style.plain

        left =
            laidRuns row 0 (takeRuns s.status.leftLength (Style.runs base s.status.left))

        windows =
            Array.foldl
                (\t acc ->
                    let
                        own =
                            Maybe.withDefault { text = "", style = "", flags = "" } (Dict.get t.id s.status.windows)

                        text =
                            if own.text == "" then
                                String.fromInt t.index ++ ":" ++ t.name ++ (if t.id == s.window then "*" else own.flags)

                            else
                                own.text

                        sep =
                            if Array.isEmpty acc.hits then [] else Style.runs base s.status.separator

                        gap =
                            laidRuns row acc.end sep

                        entry =
                            laidRuns row gap.end (Style.runs (Style.apply own.style base) text)
                    in
                    { end = entry.end
                    , pieces = acc.pieces ++ gap.pieces ++ entry.pieces
                    , hits = Array.pushLast { from = gap.end, to = entry.end - 1, window = t.id } acc.hits
                    }
                )
                { end = left.end, pieces = [], hits = [] }
                s.tabs

        rightRuns =
            takeRuns s.status.rightLength (Style.runs base s.status.right)

        rightWidth =
            Array.foldl (\r n -> n + String.count r.text) 0 rightRuns

        right =
            if windows.end + rightWidth <= cols then
                (laidRuns row (cols - rightWidth) rightRuns).pieces

            else
                []
    in
    { pieces =
        [ { row = row, col = 0, color = Style.sgr base, text = String.repeat cols " " } ]
            ++ left.pieces
            ++ Array.keepIf (\p -> p.col < cols) windows.pieces
            ++ right
    , hits = windows.hits
    }


{-| Pieces of text, each in its own color, in order. -}
drawPieces : Array { row : Int, col : Int, color : String, text : String } -> (taken t : Vt.Term) -> Vt.Term
drawPieces pieces t =
    Array.foldl (\piece acc -> drawText piece.color [ { row = piece.row, col = piece.col, text = piece.text } ] acc) t pieces


-- RUNNING tmux's COMMANDS, AND MENUS (TM27)


{-| A format for `display-message -p` to expand as tmux expands one in a
menu or a prompt: `display-message` also gives `%` to strftime, which
would make a template's `%%` one `%` (measured: a menu's Rename named the
window `%`), so each `%` is written `%%`, which strftime gives back. -}
noTime : String -> String
noTime text =
    String.replace "%" "%%" text


paneName : Int -> String
paneName pane =
    "%" ++ String.fromInt pane


{-| Whether puritty runs a held binding itself: a prompt, a menu, or an
`if-shell -F` that chooses between commands. -}
runsHere : String -> Bool
runsHere line =
    when { ask = Syntax.askOf line, menu = Syntax.menuOf line, test = Syntax.ifFormatOf line, panes = Syntax.panesOf line, tree = Syntax.treeOf line } is
        { ask = Nothing, menu = Nothing, test = Nothing, panes = Nothing, tree = Nothing } ->
            False

        _ ->
            True


{-| A binding run by puritty, from a key or a click (TM27): where it
names the mouse's word or line (`mouse_word`, `mouse_line`), those are
set first as the pane's options it is read with instead, since tmux has
no mouse event of this client's to find them in. -}
runHeld : Context -> String -> String -> String -> (taken s : State) -> { state : State, commands : Array String }
runHeld ctx word line command s =
    let
        options =
            if String.contains "mouse_" command then
                [ { command = "set-option -p -t " ++ paneName ctx.pane ++ " @puritty_mouse_word " ++ Command.quote word, expect = ForNothing }
                , { command = "set-option -p -t " ++ paneName ctx.pane ++ " @puritty_mouse_line " ++ Command.quote line, expect = ForNothing }
                ]

            else
                []

        set =
            sendAsking options s

        ran =
            runLine ctx command set.state
    in
    { state = ran.state, commands = set.commands ++ ran.commands }


{-| The mouse's formats as the options `runHeld` sets: written once, so
that a line made from one already changed changes no further. -}
mouseNames : String -> String
mouseNames line =
    line
        |> String.replace "@puritty_mouse_word" "mouse_word"
        |> String.replace "@puritty_mouse_line" "mouse_line"
        |> String.replace "mouse_word" "@puritty_mouse_word"
        |> String.replace "mouse_line" "@puritty_mouse_line"


{-| A command line run by puritty for tmux (TM27), as tmux would run it: a
prompt opens puritty's (TM25), a menu puritty's, an `if-shell -F` asks tmux
the format and runs the branch it gives; other commands are sent, each on
a line of its own, the mouse's pane named where `-t =` names it, and
`send-keys -M` left out, since puritty gives a pane the mouse itself.
Anything held for another reason (`suspend-client`) is said, not run. -}
runLine : Context -> String -> (taken s : State) -> { state : State, commands : Array String }
runLine ctx line s =
    let
        fixed =
            Syntax.retarget (paneName ctx.pane) (mouseNames line)
    in
    if String.trim fixed == "" then
        { state = s, commands = [] }

    else
        when Syntax.askOf fixed is
            Just found ->
                let
                    opened =
                        opening found.ask found.after
                in
                sendAsking opened.expand { s | said = "", asking = Just opened.asking }

            Nothing ->
                when { menu = Syntax.menuOf fixed, panes = Syntax.panesOf fixed } is
                    { menu = Just m, panes = _ } ->
                        openMenu ctx m.menu m.after s

                    { menu = Nothing, panes = Nothing } ->
                        when Syntax.treeOf fixed is
                            Just t ->
                                let
                                    opened =
                                        sendAsking
                                            [ { command = "list-sessions -F " ++ Command.quote "S #{session_id} #{session_attached} #{session_windows} #{session_name}", expect = ForTreeSessions }
                                            , { command = "list-windows -a -F " ++ Command.quote "W #{session_id} #{window_id} #{window_index} #{window_active} #{window_panes} #{window_name}", expect = ForTreeWindows }
                                            ]
                                            { s | said = "", tree = Just { sessions = [], windows = [], loaded = 0, open = Dict.empty, selected = 0, startSessions = t.sessions, template = t.template, pane = ctx.pane, zoom = t.zoom, preview = noPreview } }

                                    ran =
                                        runLine ctx t.after opened.state
                                in
                                { state = ran.state, commands = opened.commands ++ ran.commands }

                            Nothing ->
                                plainLines ctx fixed s

                    { menu = Nothing, panes = Just d } ->
                        let
                            opened =
                                sendAsking
                                    [ { command = "list-panes -F " ++ Command.quote "N #{pane_id} #{pane_index}", expect = ForNumbers } ]
                                    { s | said = "", numbers = Just { indexes = [], until = s.clock + Maybe.withDefault s.panesMs d.duration, template = d.template, keys = d.keys, pane = ctx.pane } }

                            ran =
                                runLine ctx d.after opened.state
                        in
                        { state = ran.state, commands = opened.commands ++ ran.commands }


{-| `runLine`'s commands that are not a prompt, a menu, the panes' numbers
or a tree. -}
plainLines : Context -> String -> (taken s : State) -> { state : State, commands : Array String }
plainLines ctx fixed s =
                        when Syntax.ifFormatOf fixed is
                            Just f ->
                                sendAsking
                                    [ { command = "display-message -p -t " ++ Command.quote (if f.target == "" then paneName ctx.pane else f.target) ++ " -- " ++ Command.quote (noTime f.condition)
                                      , expect = ForCondition { pane = ctx.pane, mouse = ctx.mouse, yes = f.yes, no = f.no, after = f.after }
                                      }
                                    ]
                                    s

                            Nothing ->
                                when Array.popFirst (Syntax.lines fixed) is
                                    Just { first, rest } ->
                                        let
                                            one =
                                                runOne first s

                                            others =
                                                runLine ctx (String.join " ; " rest) one.state
                                        in
                                        { state = others.state, commands = one.commands ++ others.commands }

                                    Nothing ->
                                        { state = s, commands = [] }


{-| One plain command of `runLine`'s. -}
runOne : String -> (taken s : State) -> { state : State, commands : Array String }
runOne command s =
    let
        words =
            String.split " " command |> Array.keepIf (\w -> w /= "")

        name =
            Maybe.withDefault "" (Array.first words)

        mouseKeys =
            (name == "send-keys" || name == "send") && Array.any (\w -> String.startsWith "-" w && not (String.startsWith "--" w) && String.contains "M" w) words
    in
    if mouseKeys then
        { state = s, commands = [] }

    else
        when Bindings.held command is
            Just why ->
                { state = { s | said = "puritty: " ++ why }, commands = [] }

            Nothing ->
                sendAsking [ { command = command, expect = ForRan } ] s


{-| A menu opened (TM27): its title, names and commands that hold a
format asked of tmux in the menu's pane, as tmux expands them when it
shows a menu, and the commands after it run at once, as tmux runs them. -}
openMenu : Context -> Syntax.Menu -> String -> (taken s : State) -> { state : State, commands : Array String }
openMenu ctx menu after s =
    let
        serial =
            s.serial + 1

        expand text expect =
            if String.contains "#" text then
                [ { command = "display-message -p -t " ++ paneName ctx.pane ++ " -- " ++ Command.quote (noTime text), expect = expect } ]

            else
                []

        asks =
            expand menu.title (ForMenuTitle serial)
                ++ (Array.range 0 (Array.length menu.items - 1)
                        |> Array.mapAndFlatten
                            (\i ->
                                when Array.get i menu.items is
                                    Just it ->
                                        expand it.name (ForMenuName { serial = serial, item = i }) ++ expand it.command (ForMenuCommand { serial = serial, item = i })

                                    Nothing ->
                                        []
                            )
                   )

        shown =
            readied
                { serial = serial
                , title = menu.title
                , items = menu.items
                , pending = Array.length asks
                , selected = -1
                , pane = ctx.pane
                , mouse = ctx.mouse
                , x = menu.x
                , y = menu.y
                , armed = False
                }

        opened =
            sendAsking asks { s | serial = serial, said = "", menu = Just shown }

        ran =
            runLine ctx after opened.state
    in
    { state = ran.state, commands = opened.commands ++ ran.commands }


{-| A menu whose formats have all been answered: from the keyboard, its
first item that can be chosen is chosen, as tmux does; from a click,
none. -}
readied : Menuing -> Menuing
readied m =
    if m.pending > 0 || m.mouse /= Nothing then
        m

    else
        { m | selected = Array.findFirst .enabled (menuRows m) |> Maybe.map (\r -> r.value.index) |> Maybe.withDefault -1 }


{-| One of a menu's formats answered: its first line, or what was written
when tmux could not expand it. -}
firstLine : Bool -> Array Bytes -> String -> String
firstLine ok lines written =
    if ok then
        Array.first lines |> Maybe.map Bytes.toStringLossy |> Maybe.withDefault ""

    else
        written


menuPart : Int -> (Menuing -> Menuing) -> (taken s : State) -> State
menuPart serial change s =
    when s.menu is
        Just m ->
            if m.serial == serial then
                { s | menu = Just (readied (change { m | pending = m.pending - 1 })) }

            else
                s

        Nothing ->
            s


{-| Text without tmux's styles (`#[align=centre]`), and `##` as `#`. -}
unstyled : String -> String
unstyled text =
    String.toArray text
        |> Array.foldl
            (\c acc ->
                if acc.inStyle then
                    { acc | inStyle = c /= ']', prev = ' ' }

                else if c == '[' && acc.prev == '#' then
                    { acc | inStyle = True, out = Array.dropLast 1 acc.out, prev = ' ' }

                else if c == '#' && acc.prev == '#' then
                    { acc | prev = ' ' }

                else
                    { acc | out = Array.pushLast c acc.out, prev = c }
            )
            { inStyle = False, out = [], prev = ' ' }
        |> .out
        |> String.fromArray


{-| A menu's rows as tmux shows them (`menu_add_item`): a name expanded
to nothing is a line, never two together and none first or last; a name
that begins with `-` is shown without it and cannot be chosen, and has no
key shown. -}
menuRows : Menuing -> Array MenuRow
menuRows m =
    let
        rows =
            Array.range 0 (Array.length m.items - 1)
                |> Array.foldl
                    (\i acc ->
                        when Array.get i m.items is
                            Just it ->
                                let
                                    name =
                                        unstyled it.name
                                in
                                if String.trim name == "" then
                                    when Array.last acc is
                                        Just last ->
                                            if last.line then acc else Array.pushLast { index = i, line = True, text = "", key = "", enabled = False } acc

                                        Nothing ->
                                            acc

                                else if String.startsWith "-" name then
                                    Array.pushLast { index = i, line = False, text = String.dropFirst 1 name, key = "", enabled = False } acc

                                else
                                    Array.pushLast { index = i, line = False, text = name, key = it.key, enabled = True } acc

                            Nothing ->
                                acc
                    )
                    []
    in
    when Array.last rows is
        Just last ->
            if last.line then Array.dropLast 1 rows else rows

        Nothing ->
            rows


{-| Where a menu goes and its size (TM27): as wide as its widest item and
its key, `(k)`, with a space either side, or its title; `-x` and `-y` as
tmux(1) has them, measured on 3.8: `P` the pane's left and its bottom row
as the menu's last, `W` the window's tab and the row beside the bar, `M`
the mouse's cell, `C` the middle, `R` the right; a number as it is; kept
inside the panes' rows. -}
menuPlace : (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> State -> Menuing -> (r : { x : Int, y : Int, w : Int, h : Int, rows : Array MenuRow, title : String } where 0 <= r.x && r.x <= 1000 && 0 <= r.y && r.y <= 1000 && 0 <= r.w && r.w <= 1000 && 0 <= r.h && r.h <= 1000)
menuPlace cols rows s m =
    let
        shown =
            menuRows m

        keyText r =
            if r.enabled && r.key /= "" then "(" ++ r.key ++ ")" else ""

        widest =
            Array.foldl (\r acc -> max acc (String.count r.text + (if keyText r == "" then 0 else 1 + String.count (keyText r)))) 0 shown

        heading =
            unstyled m.title

        w =
            clamp 0 cols (max (min 1000 widest + 4) (min 1000 (String.count heading) + 4))

        areaTop =
            if s.barTop then bar else 0

        areaH =
            rows - bar

        h =
            clamp 0 (max 0 areaH) (min 1000 (Array.length shown) + 2)

        pane =
            when s.layout is
                Just cell ->
                    Array.findFirst (\q -> q.id == m.pane) (placedPanes s cell (Layout.tiled cell ++ Layout.floating cell)) |> Maybe.map .value

                Nothing ->
                    Nothing

        barRow =
            if s.barTop then 0 else rows - 1

        tab =
            Array.findFirst (\hit -> hit.window == s.window) (tabsOf cols barRow s).hits |> Maybe.map (\f -> f.value.from) |> Maybe.withDefault 0

        mouse =
            Maybe.withDefault { col = (cols - w) // 2, row = areaTop + (areaH - h) // 2 } m.mouse

        x =
            when m.x is
                "R" ->
                    cols - w

                "P" ->
                    Maybe.withDefault 0 (Maybe.map .x pane)

                "M" ->
                    mouse.col

                "W" ->
                    tab

                other ->
                    Maybe.withDefault ((cols - w) // 2) (String.toInt other)

        y =
            when m.y is
                "P" ->
                    Maybe.withDefault areaTop (Maybe.map (\q -> q.y + q.h - h) pane)

                "M" ->
                    mouse.row

                "W" ->
                    if s.barTop then areaTop else areaTop + areaH - h

                "S" ->
                    if s.barTop then areaTop else areaTop + areaH - h

                other ->
                    Maybe.withDefault (areaTop + (areaH - h) // 2) (String.toInt other)
    in
    { x = clamp 0 (max 0 (cols - w)) x
    , y = clamp areaTop (max areaTop (areaTop + areaH - h)) y
    , w = w
    , h = h
    , rows = shown
    , title = heading
    }


{-| A menu's cells: in tmux's look as tmux draws one, measured on 3.8
(single lines, the title in the middle of the top edge, the chosen item
in `menu-selected-style`, black on yellow, one that cannot be chosen
dim); in puritty's, in the view's box with the chosen item amber. -}
drawMenu : Bool -> { x : Int, y : Int, w : Int, h : Int, rows : Array MenuRow, title : String } -> Menuing -> Array { row : Int, col : Int, color : String, text : String }
drawMenu tmuxLook place m =
    let
        inner =
            place.w - 2

        edge =
            if tmuxLook then "\u{001B}[0;38;5;249;48;5;235m" else viewEdgeColor

        plainColor =
            if tmuxLook then "\u{001B}[0;38;5;254;48;5;235m" else viewTextColor

        dimColor =
            if tmuxLook then "\u{001B}[0;2;38;5;254;48;5;235m" else "\u{001B}[0;38;5;243;48;5;236m"

        chosenColor =
            if tmuxLook then messageColor else activeTabColor

        heading =
            String.takeFirst inner place.title

        top =
            if tmuxLook then
                let
                    left =
                        (inner - String.count heading) // 2
                in
                "┌" ++ String.repeat left "─" ++ heading ++ String.repeat (inner - left - String.count heading) "─" ++ "┐"

            else
                let
                    label =
                        if heading == "" then "" else " " ++ String.takeFirst (inner - 2) heading ++ " "
                in
                "╭" ++ label ++ String.repeat (inner - String.count label) "─" ++ "╮"

        bottom =
            (if tmuxLook then "└" else "╰") ++ String.repeat inner "─" ++ (if tmuxLook then "┘" else "╯")

        body =
            Array.range 0 (place.h - 3)
                |> Array.mapAndFlatten
                    (\i ->
                        when Array.get i place.rows is
                            Just r ->
                                if r.line then
                                    [ { row = place.y + 1 + i, col = place.x, color = edge, text = "├" ++ String.repeat inner "─" ++ "┤" } ]

                                else
                                    let
                                        key =
                                            if r.enabled && r.key /= "" then "(" ++ r.key ++ ")" else ""

                                        text =
                                            " " ++ String.padRight (inner - 2 - String.count key) ' ' (String.takeFirst (inner - 2) r.text) ++ key ++ " "

                                        color =
                                            if r.index == m.selected && r.enabled then chosenColor else if r.enabled then plainColor else dimColor
                                    in
                                    [ { row = place.y + 1 + i, col = place.x, color = edge, text = (if tmuxLook then "│" else "│") ++ String.repeat inner " " ++ "│" }
                                    , { row = place.y + 1 + i, col = place.x + 1, color = color, text = text }
                                    , { row = place.y + 1 + i, col = place.x + place.w - 1, color = edge, text = "│" }
                                    ]

                            Nothing ->
                                []
                    )
    in
    [ { row = place.y, col = place.x, color = edge, text = top } ]
        ++ body
        ++ [ { row = place.y + place.h - 1, col = place.x, color = edge, text = bottom } ]


{-| A key while a menu is open (TM27), as tmux's menu takes it: an item's
own key chooses it; Up, k, Down and j move among those that can be
chosen; Home and g the first, End and G the last; Enter or Space chooses
the one moved to; Escape, q and C-c close it. -}
menuKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Menuing -> (taken s : State) -> { state : State, commands : Array String }
menuKey k m s =
    let
        name =
            Maybe.withDefault "" (lookupName k)

        choosable =
            Array.keepIf .enabled (menuRows m)

        at =
            Array.findFirst (\r -> r.index == m.selected) choosable |> Maybe.map .index

        count =
            Array.length choosable

        moveTo i st =
            { state = { st | menu = Just { m | selected = Array.get (modBy (max 1 count) i) choosable |> Maybe.map .index |> Maybe.withDefault -1 } }, commands = [] }
    in
    if m.pending > 0 then
        if name == "Escape" || name == "q" || name == "C-c" then
            { state = { s | menu = Nothing }, commands = [] }

        else
            { state = s, commands = [] }

    else
        when Array.findFirst (\r -> r.key == name && name /= "") choosable is
            Just r ->
                chooseItem r.value.index m s

            Nothing ->
                if name == "Escape" || name == "q" || name == "C-c" then
                    { state = { s | menu = Nothing }, commands = [] }

                else if name == "Up" || name == "k" || name == "BTab" then
                    moveTo (Maybe.withDefault 0 at - 1) s

                else if name == "Down" || name == "j" || name == "Tab" then
                    moveTo (Maybe.withDefault -1 at + 1) s

                else if name == "Home" || name == "g" then
                    moveTo 0 s

                else if name == "End" || name == "G" then
                    moveTo (count - 1) s

                else if name == "Enter" || name == "KPEnter" || name == "Space" || name == "C-m" then
                    if m.selected >= 0 then chooseItem m.selected m s else { state = { s | menu = Nothing }, commands = [] }

                else
                    { state = s, commands = [] }


{-| An item chosen: the menu closed and its command run in its pane. -}
chooseItem : Int -> Menuing -> (taken s : State) -> { state : State, commands : Array String }
chooseItem index m s =
    let
        command =
            Array.get index m.items |> Maybe.map .command |> Maybe.withDefault ""
    in
    runLine { pane = m.pane, mouse = m.mouse } command { s | menu = Nothing }


{-| The pointer while a menu is open (TM27): over an item it is chosen;
a press outside closes the menu; letting a button go over an item runs it,
once the pointer has moved or been pressed since the menu opened, so that
letting go of the click that opened it does not. -}
menuPointer : Window.PointerEvent -> Int -> Int -> Menuing -> (taken s : State) -> { state : State, commands : Array String }
menuPointer p col row m s =
    let
        place =
            menuPlace s.canvas.cols s.canvas.rows s m

        inside =
            col >= place.x && col < place.x + place.w && row >= place.y && row < place.y + place.h

        under =
            if inside then
                Array.get (row - place.y - 1) place.rows |> Maybe.andThen (\r -> if r.enabled then Just r.index else Nothing)

            else
                Nothing

        moved =
            m.mouse /= Just { col = col, row = row }
    in
    if p.button == 4 || p.button == 5 then
        { state = s, commands = [] }

    else if p.action == 0 then
        if inside then
            { state = { s | menu = Just { m | armed = True, selected = Maybe.withDefault m.selected under } }, commands = [] }

        else
            { state = { s | menu = Nothing }, commands = [] }

    else if p.action == 1 then
        when under is
            Just i ->
                if m.armed || moved then
                    chooseItem i m s

                else
                    { state = s, commands = [] }

            Nothing ->
                { state = s, commands = [] }

    else
        { state = { s | menu = Just { m | armed = m.armed || moved, selected = Maybe.withDefault m.selected under } }, commands = [] }


-- THE PANES' NUMBERS (TM28)


{-| A key while the panes' numbers are shown, as tmux's `display-panes`
takes it: a digit that is a pane's index runs the command with it and
closes them; any other key closes them and goes no further. -}
numberKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Numbering -> (taken s : State) -> { state : State, commands : Array String }
numberKey k n s =
    let
        text =
            Bytes.toStringLossy k.text

        chosen =
            if n.keys && Bitwise.and k.mods 6 == 0 then
                String.toInt text |> Maybe.andThen (\d -> Array.findFirst (\e -> e.index == d) n.indexes)

            else
                Nothing
    in
    when chosen is
        Just _ ->
            runLine { pane = n.pane, mouse = Nothing } (Syntax.fill (Syntax.tokens n.template) [ text ]) { s | numbers = Nothing }

        Nothing ->
            { state = { s | numbers = Nothing }, commands = [] }


{-| The time puritty's loop should wake to close the panes' numbers, -1
for none (TM28). -}
dueAt : State -> Int
dueAt s =
    let
        clockDue =
            if s.dayOffset /= Nothing && Array.any (\m -> m == "clock-mode") (Dict.values s.paneModes) then
                -- the clock drawn again as the minute turns
                s.clock + 60000 - modBy 60000 (s.clock + Maybe.withDefault 0 s.dayOffset)

            else
                -1
    in
    when s.numbers is
        Just n ->
            if clockDue >= 0 then min n.until clockDue else n.until

        Nothing ->
            clockDue


{-| The time, from the loop: the panes' numbers closed once it is past
their time. -}
tick : Int -> (taken s : State) -> State
tick ms s =
    when s.numbers is
        Just n ->
            if ms >= n.until then { s | numbers = Nothing, clock = ms } else { s | clock = ms }

        Nothing ->
            { s | clock = ms }


{-| A pane's number as tmux draws it (`window_clock_table`'s digits, five
cells square, a cell apart, in the middle of the pane, in
`display-panes-color`, blue, or `display-panes-active-color`, red, for
the active pane, with the pane's size at its top right), or as text where
the pane is too small; in puritty's look in gray and amber, without the
size. -}
paneNumber : Bool -> Bool -> Numbering -> Layout.Pane -> Array { row : Int, col : Int, color : String, text : String }
paneNumber tmuxLook isActive n p =
    when Array.findFirst (\e -> e.id == p.id) n.indexes is
        Nothing ->
            []

        Just found ->
            let
                digits =
                    String.fromInt found.value.index

                len =
                    String.count digits

                block =
                    if tmuxLook then
                        if isActive then "\u{001B}[0;41m" else "\u{001B}[0;44m"

                    else if isActive then
                        "\u{001B}[0;48;5;214m"

                    else
                        "\u{001B}[0;48;5;242m"

                ink =
                    if tmuxLook then
                        if isActive then "\u{001B}[0;31m" else "\u{001B}[0;34m"

                    else if isActive then
                        "\u{001B}[0;1;38;5;214m"

                    else
                        "\u{001B}[0;1;38;5;250m"

                size =
                    String.fromInt p.w ++ "x" ++ String.fromInt p.h
            in
            if p.w < len * 6 || p.h < 5 then
                [ { row = p.y + p.h // 2, col = p.x + max 0 ((p.w - len) // 2), color = ink, text = String.takeFirst p.w digits } ]

            else
                let
                    px =
                        p.x + p.w // 2 - len * 3

                    py =
                        p.y + p.h // 2 - 2

                    cells =
                        String.toArray digits
                            |> Array.indexedMap
                                (\i c ->
                                    bigDigit c
                                        |> Array.indexedMap
                                            (\r line ->
                                                String.toArray line
                                                    |> Array.indexedMap (\col bit -> { row = py + r, col = px + i * 6 + col, on = bit == '1' })
                                                    |> Array.keepIf .on
                                            )
                                        |> Array.flatten
                                )
                            |> Array.flatten
                            |> Array.map (\cell -> { row = cell.row, col = cell.col, color = block, text = " " })
                in
                cells
                    ++ (if tmuxLook && String.count size <= p.w then
                            [ { row = p.y, col = p.x + p.w - String.count size, color = ink, text = size } ]

                        else
                            []
                       )


{-| tmux's digits, five rows of five (`window-clock.c`). -}
bigDigit : Char -> Array String
bigDigit c =
    when c is
        '0' ->
            [ "11111", "10001", "10001", "10001", "11111" ]

        '1' ->
            [ "00001", "00001", "00001", "00001", "00001" ]

        '2' ->
            [ "11111", "00001", "11111", "10000", "11111" ]

        '3' ->
            [ "11111", "00001", "11111", "00001", "11111" ]

        '4' ->
            [ "10001", "10001", "11111", "00001", "00001" ]

        '5' ->
            [ "11111", "10000", "11111", "00001", "11111" ]

        '6' ->
            [ "11111", "10000", "11111", "10001", "11111" ]

        '7' ->
            [ "11111", "00001", "00001", "00001", "00001" ]

        '8' ->
            [ "11111", "10001", "11111", "10001", "11111" ]

        '9' ->
            [ "11111", "10001", "11111", "00001", "11111" ]

        _ ->
            []


-- TREE MODE, THE CLOCK AND THE OTHER MODES (TM32)


{-| A tree whose lists are in: the sessions open as `-w` asks (all) or
`-s` (none), and the row of the window shown, or of its session, chosen. -}
treeLoaded : Int -> Tree -> Tree
treeLoaded shown t =
    if t.loaded < 2 then
        t

    else
        let
            current =
                Array.findFirst (\w -> w.id == shown) t.windows |> Maybe.map (\w -> w.value.session) |> Maybe.withDefault -1

            open =
                if t.startSessions then
                    Dict.empty

                else
                    Array.foldl (\x d -> Dict.set x.id True d) Dict.empty t.sessions

            opened =
                { t | open = open }

            rows =
                treeRows opened
        in
        { opened
            | selected =
                Array.findFirst (\r -> if t.startSessions then r.window < 0 && r.session == current else r.window == shown) rows
                    |> Maybe.map .index
                    |> Maybe.withDefault 0
        }


{-| The preview asked for in a reply's turn. -}
previewAcc : (taken acc : Acc) -> Acc
previewAcc acc =
    let
        r =
            askPreview acc.state
    in
    { acc | state = r.state, commands = acc.commands ++ r.commands }


{-| The preview asked for after a key in the tree. -}
previewAfter : (taken r0 : { state : State, commands : Array String }) -> { state : State, commands : Array String }
previewAfter r0 =
    let
        r =
            askPreview r0.state
    in
    { state = r.state, commands = r0.commands ++ r.commands }


{-| tmux asked what the tree's chosen row shows (TM35), when that row is
not the one already previewed: a window's panes with where they are, or a
session's windows; each is captured when the answer comes. -}
askPreview : (taken s : State) -> { state : State, commands : Array String }
askPreview s =
    when s.tree is
        Just t ->
            if t.loaded < 2 then
                { state = s, commands = [] }

            else
                let
                    row =
                        Array.get t.selected (treeRows t)

                    target =
                        when row is
                            Just r ->
                                if r.window >= 0 then "@" ++ String.fromInt r.window else "$" ++ String.fromInt r.session

                            Nothing ->
                                ""

                    isSession =
                        String.startsWith "$" target

                    serial =
                        t.preview.serial + 1

                    command =
                        if isSession then
                            "list-windows -t " ++ Command.quote target ++ " -F " ++ Command.quote "Q #{window_id} 0 0 #{window_width} #{window_height} #{window_active} #{window_index}:#{window_name}"

                        else
                            "list-panes -t " ++ Command.quote target ++ " -F " ++ Command.quote "Q #{pane_id} #{pane_left} #{pane_top} #{pane_width} #{pane_height} #{pane_active} #{pane_index}"
                in
                if target == "" || target == t.preview.target then
                    { state = s, commands = [] }

                else
                    sendAsking [ { command = command, expect = ForPreviewList serial } ]
                        { s | tree = Just { t | preview = { serial = serial, target = target, session = isSession, items = [] } } }

        Nothing ->
            { state = s, commands = [] }


{-| A line of the preview's list: `Q id x y w h active label`. -}
previewItem : Bytes -> Maybe PreviewItem
previewItem line =
    when String.split " " (Bytes.toStringLossy line) |> Array.popFirst is
        Just { first = "Q", rest = rest } ->
            let
                num i =
                    Maybe.withDefault 0 (Maybe.andThen String.toInt (Array.get i rest))
            in
            Just
                { id = Maybe.withDefault "" (Array.get 0 rest)
                , x = num 1
                , y = num 2
                , w = max 1 (num 3)
                , h = max 1 (num 4)
                , active = Array.get 5 rest == Just "1"
                , label = String.join " " (Array.dropFirst 6 rest)
                , lines = []
                }

        _ ->
            Nothing


{-| A capture's lines without the blank ones at its end, so that the
preview shows where the text is, as tmux's shows around the cursor. -}
trimBlank : Array String -> Array String
trimBlank lines =
    when Array.last lines is
        Just l ->
            if String.trim l == "" then trimBlank (Array.dropLast 1 lines) else lines

        Nothing ->
            []


{-| A line cut to `n` cells and padded to them: a wide character (Hangul,
Han) takes two, a control character none. -}
clipCells : Int -> String -> String
clipCells n text =
    let
        step c acc =
            if acc.full then
                acc

            else
                let
                    cp =
                        Char.toCode c

                    w =
                        if cp < 0x20 || cp == 0x7F then 0 else if cp < 0x80 then 1 else Width.width cp
                in
                if acc.used + w > n then
                    { acc | full = True }

                else
                    { acc | used = acc.used + w, text = acc.text ++ String.fromChar c }

        done =
            String.foldl step { used = 0, text = "", full = False } text
    in
    done.text ++ String.repeat (max 0 (n - done.used)) " "


{-| The tree's rows: each session, and an open one's windows under it. -}
treeRows : Tree -> Array TreeRow
treeRows t =
    Array.mapAndFlatten
        (\x ->
            let
                own =
                    Array.keepIf (\w -> w.session == x.id) t.windows

                count =
                    Array.length own
            in
            Array.pushFirst
                { session = x.id, window = -1, text = x.name ++ ": " ++ String.fromInt x.windows ++ " windows" ++ (if x.attached then " (attached)" else ""), last = False }
                (if Dict.get x.id t.open == Just True then
                    Array.indexedMap (\i w -> { session = x.id, window = w.id, text = String.fromInt w.index ++ ": " ++ w.name ++ (if w.active then "*" else "") ++ " (" ++ String.fromInt w.panes ++ " panes)", last = i == count - 1 }) own

                 else
                    []
                )
        )
        t.sessions


{-| A key while the tree is shown, as tmux's tree mode takes it: Up, k,
C-p and Down, j, C-n move; PPage, NPage, Home, g, End, G; Right, l opens
a session, Left, h closes it or goes to it from a window; `+` and `-`
open and close every one; Enter chooses; a row's key (`treeRowKey`: a
digit, or `M-a` to `M-z`) chooses that row; q, Escape and C-c close it. -}
treeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Tree -> (taken s : State) -> { state : State, commands : Array String }
treeKey k t s =
    let
        name =
            Maybe.withDefault "" (lookupName k)

        rows =
            treeRows t

        count =
            Array.length rows

        at =
            Array.get t.selected rows

        moved i st =
            { state = { st | tree = Just { t | selected = clamp 0 (max 0 (count - 1)) i } }, commands = [] }

        page =
            10
    in
    if name == "q" || name == "Escape" || name == "C-c" then
        { state = { s | tree = Nothing }, commands = [] }

    else if name == "Up" || name == "k" || name == "C-p" then
        moved (if t.selected == 0 then count - 1 else t.selected - 1) s

    else if name == "Down" || name == "j" || name == "C-n" then
        moved (if t.selected >= count - 1 then 0 else t.selected + 1) s

    else if name == "PPage" || name == "C-b" then
        moved (t.selected - page) s

    else if name == "NPage" || name == "C-f" then
        moved (t.selected + page) s

    else if name == "Home" || name == "g" then
        moved 0 s

    else if name == "End" || name == "G" then
        moved (count - 1) s

    else if name == "Right" || name == "l" then
        when at is
            Just r ->
                { state = { s | tree = Just { t | open = Dict.set r.session True t.open } }, commands = [] }

            Nothing ->
                { state = s, commands = [] }

    else if name == "Left" || name == "h" then
        when at is
            Just r ->
                let
                    closed =
                        { t | open = Dict.remove r.session t.open }
                in
                { state = { s | tree = Just { closed | selected = Array.findFirst (\x -> x.window < 0 && x.session == r.session) (treeRows closed) |> Maybe.map .index |> Maybe.withDefault 0 } }, commands = [] }

            Nothing ->
                { state = s, commands = [] }

    else if name == "+" then
        { state = { s | tree = Just { t | open = Array.foldl (\x d -> Dict.set x.id True d) Dict.empty t.sessions } }, commands = [] }

    else if name == "-" then
        let
            closed =
                { t | open = Dict.empty }

            session =
                Maybe.map .session at
        in
        { state = { s | tree = Just { closed | selected = Array.findFirst (\x -> Just x.session == session) (treeRows closed) |> Maybe.map .index |> Maybe.withDefault 0 } }, commands = [] }

    else if name == "Enter" || name == "KPEnter" || name == "C-m" then
        chooseRow at t s

    else
        when Array.findFirst (\i -> treeRowKey i == Just name) (Array.range 0 (min count 36 - 1)) is
            Just found ->
                chooseRow (Array.get found.value rows) t s

            Nothing ->
                { state = s, commands = [] }


{-| A row's key, as tmux's tree mode numbers its rows: `0` to `9`, then
`M-a` to `M-z`; the rows after the 36th have none (TM37). -}
treeRowKey : Int -> Maybe String
treeRowKey i =
    if i < 10 then
        Just (String.fromInt i)

    else if i < 36 then
        Maybe.map (\c -> "M-" ++ String.fromChar c) (Char.fromCode (0x61 + i - 10))

    else
        Nothing


{-| A row chosen: the tree closed and its command run with the session's
or the window's id (`$1`, `@2`), which tmux takes as a target. -}
chooseRow : Maybe TreeRow -> Tree -> (taken s : State) -> { state : State, commands : Array String }
chooseRow row t s =
    when row is
        Just r ->
            let
                target =
                    if r.window >= 0 then "@" ++ String.fromInt r.window else "$" ++ String.fromInt r.session
            in
            runLine { pane = t.pane, mouse = Nothing } (Syntax.fill (Syntax.tokens t.template) [ target ]) { s | tree = Nothing }

        Nothing ->
            { state = { s | tree = Nothing }, commands = [] }


{-| The tree's cells (TM32): in tmux's look as tmux's tree mode lists it,
each row's key in brackets, `+` or `-` for a session folded or open, the
windows under it joined by `├─>` and `└─>`, the chosen row in
`mode-style`; in puritty's, the view's box. Below the list, when there is
room, the chosen row's preview, as tmux draws it (TM35): the list takes a
third of the height, or less with fewer rows. -}
drawTree : Bool -> Layout.Pane -> Tree -> Array { row : Int, col : Int, color : String, text : String }
drawTree tmuxLook place t =
    let
        rows =
            treeRows t

        listArea =
            if tmuxLook then
                { x = place.x, y = place.y, w = place.w, h = place.h }

            else
                { x = place.x + 2, y = place.y + 1, w = place.w - 4, h = place.h - 2 }

        withPreview =
            t.preview.target /= "" && listArea.h >= 8 && listArea.w >= 12

        shownRows =
            if withPreview then
                max 1 (min (Array.length rows) (max 3 (listArea.h // 3)))

            else
                max 1 listArea.h

        previewDrawn =
            if withPreview then
                let
                    sepRow =
                        listArea.y + shownRows

                    separator =
                        if tmuxLook then
                            { row = sepRow, col = place.x, color = lineColor, text = String.repeat place.w "─" }

                        else
                            { row = sepRow, col = place.x, color = viewEdgeColor, text = "├" ++ String.repeat (place.w - 2) "─" ++ "┤" }
                in
                Array.pushFirst separator (drawPreview tmuxLook { x = listArea.x, y = sepRow + 1, w = listArea.w, h = listArea.h - shownRows - 1 } t.preview)

            else
                []

        top =
            if t.selected < shownRows then 0 else t.selected - shownRows + 1

        keyWidth =
            if Array.length rows > 10 then 3 else 1

        lineOf i r =
            let
                -- tmux pads each key to the longest one shown, and one
                -- space after (measured on 3.4 and 3.8, TM37)
                key =
                    when treeRowKey i is
                        Just k ->
                            if tmuxLook then
                                String.padRight (keyWidth + 2) ' ' ("(" ++ k ++ ")") ++ " "

                            else
                                String.padRight keyWidth ' ' k ++ "  "

                        Nothing ->
                            String.repeat (if tmuxLook then keyWidth + 3 else keyWidth + 2) " "

                shape =
                    if r.window < 0 then
                        (if Dict.get r.session t.open == Just True then "- " else "+ ")

                    else if r.last then
                        "└─> "

                    else
                        "├─> "
            in
            if tmuxLook then key ++ shape ++ r.text else key ++ (if r.window < 0 then (if Dict.get r.session t.open == Just True then "▾ " else "▸ ") else "    ") ++ r.text

        width =
            if tmuxLook then place.w else place.w - 4

        listed =
            Array.slice top (top + shownRows) rows
                |> Array.indexedMap
                    (\j r ->
                        let
                            i =
                                top + j

                            chosen =
                                i == t.selected
                        in
                        { row = (if tmuxLook then place.y else place.y + 1) + j
                        , col = if tmuxLook then place.x else place.x + 2
                        , color =
                            if chosen then
                                if tmuxLook then messageColor else activeTabColor

                            else if tmuxLook then
                                "\u{001B}[0m"

                            else
                                viewTextColor
                        , text = String.padRight width ' ' (String.takeFirst width (lineOf i r))
                        }
                    )
    in
    if tmuxLook then
        Array.range 0 (place.h - 1) |> Array.map (\r -> { row = place.y + r, col = place.x, color = "\u{001B}[0m", text = String.repeat place.w " " })
            |> (\cleared -> cleared ++ listed ++ previewDrawn)

    else
        let
            inner =
                place.w - 2

            label =
                " choose " ++ (if t.startSessions then "a session " else "a window ")

            foot =
                " Enter or a row's key: go  ←→: fold  q: close "
        in
        [ { row = place.y, col = place.x, color = viewEdgeColor, text = "╭" ++ String.takeFirst inner (label ++ String.repeat inner "─") ++ "╮" } ]
            ++ (Array.range 1 (place.h - 2) |> Array.mapAndFlatten (\r -> [ { row = place.y + r, col = place.x, color = viewEdgeColor, text = "│" ++ String.repeat inner " " ++ "│" } ]))
            ++ listed
            ++ previewDrawn
            ++ [ { row = place.y + place.h - 1, col = place.x, color = viewEdgeColor, text = "╰" ++ String.takeFirst inner (foot ++ String.repeat inner "─") ++ "╯" } ]


{-| The preview in its area (TM35): a session's windows side by side, as
many as fit at ten cells or more; a window's panes where they are in it,
scaled to the area. Each has a top line with its label, the active one's
in the active color, and below it the last lines it shows, cut to its
width by cells. -}
drawPreview : Bool -> { x : Int, y : Int, w : Int, h : Int } -> Preview -> Array { row : Int, col : Int, color : String, text : String }
drawPreview tmuxLook area pv =
    let
        text =
            if tmuxLook then "\u{001B}[0m" else viewTextColor

        edge active =
            if tmuxLook then
                if active then "\u{001B}[0;32m" else "\u{001B}[0m"

            else if active then
                viewEdgeColor

            else
                "\u{001B}[0;38;5;240;48;5;236m"

        rects =
            if pv.session then
                let
                    fit =
                        max 1 ((area.w + 1) // 11)

                    shown =
                        Array.takeFirst fit pv.items

                    n =
                        max 1 (Array.length shown)

                    cw =
                        max 1 ((area.w - (n - 1)) // n)
                in
                Array.indexedMap (\i item -> { item = item, x = area.x + i * (cw + 1), y = area.y, w = cw, h = area.h }) shown

            else
                let
                    totalW =
                        max 1 (Array.foldl (\i m -> max m (i.x + i.w)) 1 pv.items)

                    totalH =
                        max 1 (Array.foldl (\i m -> max m (i.y + i.h)) 1 pv.items)
                in
                Array.map
                    (\item ->
                        let
                            x0 =
                                item.x * area.w // totalW

                            x1 =
                                (item.x + item.w) * area.w // totalW

                            y0 =
                                item.y * area.h // totalH

                            y1 =
                                (item.y + item.h) * area.h // totalH
                        in
                        { item = item, x = area.x + x0, y = area.y + y0, w = max 1 (x1 - x0), h = max 2 (y1 - y0) }
                    )
                    pv.items

        drawn r =
            let
                label =
                    " " ++ r.item.label ++ " "

                top =
                    clipCells r.w (String.repeat (max 0 ((r.w - String.count label) // 2)) "─" ++ label ++ String.repeat r.w "─")

                body =
                    r.h - 1

                shown =
                    Array.takeLast body r.item.lines

                padded =
                    shown ++ Array.repeat (max 0 (body - Array.length shown)) ""
            in
            Array.pushFirst { row = r.y, col = r.x, color = edge r.item.active, text = top }
                (Array.indexedMap (\j line -> { row = r.y + 1 + j, col = r.x, color = text, text = clipCells r.w line }) padded)
    in
    Array.range 0 (area.h - 1)
        |> Array.map (\j -> { row = area.y + j, col = area.x, color = text, text = String.repeat area.w " " })
        |> (\cleared -> cleared ++ Array.mapAndFlatten drawn rects)


{-| The time of day for the clock, `HH:MM`, from the loop's clock and the
offset tmux's own time gave; empty until it is known. -}
clockText : State -> String
clockText s =
    when s.dayOffset is
        Just offset ->
            let
                minutes =
                    modBy 1440 ((s.clock + offset) // 60000)

                two n =
                    String.padLeft 2 '0' (String.fromInt n)
            in
            two (minutes // 60) ++ ":" ++ two (modBy 60 minutes)

        Nothing ->
            ""


{-| What a pane in one of tmux's modes shows (TM32): the clock (`clock-mode`)
as tmux draws it, its digits five cells square in `clock-mode-color`
(blue) in the pane's middle, amber in puritty's look; for a mode puritty
does not draw (`tree-mode` entered otherwise than by a binding,
`buffer-mode`, `client-mode`, `options-mode`), a line in the pane's middle
that says so and how to leave it, since tmux has the pane's keys. Copy and
view mode are drawn elsewhere (TM31). -}
modeOverlay : Bool -> Bool -> String -> String -> Layout.Pane -> Array { row : Int, col : Int, color : String, text : String }
modeOverlay tmuxLook isActive mode time p =
    if mode == "" || mode == "copy-mode" || mode == "view-mode" then
        []

    else if mode == "clock-mode" then
        let
            block =
                if tmuxLook then "\u{001B}[0;44m" else "\u{001B}[0;48;5;214m"

            ink =
                if tmuxLook then "\u{001B}[0;34m" else "\u{001B}[0;1;38;5;214m"

            len =
                String.count time

            emptied =
                Array.range 0 (p.h - 1) |> Array.map (\r -> { row = p.y + r, col = p.x, color = "\u{001B}[0m", text = String.repeat p.w " " })
        in
        if time == "" then
            emptied

        else if p.w < len * 6 || p.h < 5 then
            emptied ++ [ { row = p.y + p.h // 2, col = p.x + max 0 ((p.w - len) // 2), color = ink, text = String.takeFirst p.w time } ]

        else
            let
                px =
                    p.x + p.w // 2 - len * 3

                py =
                    p.y + p.h // 2 - 2
            in
            emptied
                ++ (String.toArray time
                        |> Array.indexedMap
                            (\i c ->
                                (if c == ':' then [ "00000", "00100", "00000", "00100", "00000" ] else bigDigit c)
                                    |> Array.indexedMap
                                        (\r line ->
                                            String.toArray line
                                                |> Array.indexedMap (\col bit -> { row = py + r, col = px + i * 6 + col, on = bit == '1' })
                                                |> Array.keepIf .on
                                        )
                                    |> Array.flatten
                            )
                        |> Array.flatten
                        |> Array.map (\cell -> { row = cell.row, col = cell.col, color = block, text = " " })
                   )

    else
        let
            text =
                String.takeFirst p.w (" tmux's " ++ mode ++ " is not drawn under -CC; q leaves it ")
        in
        [ { row = p.y + p.h // 2, col = p.x + max 0 ((p.w - String.count text) // 2), color = if tmuxLook then messageColor else activeTabColor, text = text } ]


-- COPY MODE (TM31)


{-| What puritty asks of a pane in copy mode, one line: `C %pane` then
`scroll_position`, `history_size`, the cursor, whether there is a
selection and its ends, and `rectangle_toggle`. -}
copyFormat : String
copyFormat =
    "C #{pane_id} #{scroll_position} #{history_size} #{copy_cursor_x} #{copy_cursor_y} #{selection_present} #{selection_start_x} #{selection_start_y} #{selection_end_x} #{selection_end_y} #{rectangle_toggle}"


inCopy : Int -> State -> Bool
inCopy pane s =
    String.startsWith "copy-mode" (Maybe.withDefault "" (Dict.get pane s.modes))


{-| A pane in copy mode asked where it is; if a question is out already,
asked again once it is answered, so that the last answer is after the
last key. -}
askCopy : Int -> (taken acc : Acc) -> Acc
askCopy pane acc =
    let
        st =
            acc.state
    in
    if Dict.get pane st.copyAsked /= Nothing then
        -- asked and not yet answered: asked again when it is
        { acc | state = { st | copyAsked = Dict.set pane True st.copyAsked } }

    else
        ask [ { command = "display-message -p -t " ++ paneName pane ++ " " ++ Command.quote copyFormat, expect = ForCopy } ] { acc | state = { st | copyAsked = Dict.set pane False st.copyAsked } }


{-| An answer to `copyFormat`: the pane's copy mode kept, and its view
scrolled back as far as tmux's, as far as puritty's own history goes. -}
copyLine : Bytes -> (taken s : State) -> State
copyLine bytes s =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)

        num i =
            Maybe.withDefault 0 (Maybe.andThen String.toInt (Array.get i words))
    in
    when Array.get 0 words is
        Just "C" ->
            let
                pane =
                    idOf (Maybe.withDefault "" (Array.get 1 words))

                answered =
                    { s | copyAsked = Dict.remove pane s.copyAsked }
            in
            if Maybe.andThen String.toInt (Array.get 2 words) == Nothing || not (inCopy pane answered) then
                -- not in copy mode (any more)
                { answered | copy = Dict.remove pane answered.copy }

            else
                let
                    c =
                        { scroll = num 2
                        , hsize = num 3
                        , cx = num 4
                        , cy = num 5
                        , selection = if num 6 == 1 then Just { sx = num 7, sy = num 8, ex = num 9, ey = num 10 } else Nothing
                        , rectangle = num 11 == 1
                        }

                    most =
                        Maybe.withDefault 0 (withPane pane answered Vt.scrollbackRows)
                in
                { answered | copy = Dict.set pane c answered.copy, back = Dict.set pane (min most c.scroll) answered.back }

        _ ->
            s


-- VIEWS (TM26)


{-| A view of lines tmux printed, at its first line: tabs to the next
column of eight, other control characters as spaces, so that nothing
printed is read as a terminal's sequence when it is drawn. -}
viewOf : Array Bytes -> View
viewOf lines =
    let
        all =
            Array.map (\line -> shownLine (Bytes.toStringLossy line)) lines
    in
    { lines = all, top = 0, rows = 1, all = all, filter = "", filtering = False }


{-| The view's lines with `filter` in them, its case aside (TM36), from
the top. -}
filtered : String -> View -> View
filtered text v =
    let
        lower =
            String.toLower text
    in
    { v
        | filter = text
        , lines = if text == "" then v.all else Array.keepIf (\line -> String.contains lower (String.toLower line)) v.all
        , top = 0
    }


shownLine : String -> String
shownLine text =
    String.toArray text
        |> Array.foldl
            (\c acc ->
                if c == '\t' then
                    acc ++ String.toArray (String.repeat (8 - modBy 8 (Array.length acc)) " ")

                else if Char.toCode c < 0x20 || Char.toCode c == 0x7F || (Char.toCode c >= 0x80 && Char.toCode c < 0xA0) then
                    Array.pushLast ' ' acc

                else
                    Array.pushLast c acc
            )
            []
        |> String.fromArray


{-| A key while a view is open: q, Escape or C-c closes it; the rest move
it as copy mode's keys do, vi's and emacs's both: a line (Up, Down, k, j,
C-p, C-n, C-y, C-e, Enter), a page (PPage, NPage, C-b, C-f, Space), half
a page (C-u, C-d), the top (g, Home, M-<) and the bottom (G, End, M->).
`/` filters it (TM36): what is typed keeps the lines with it in them,
Backspace takes a character back and C-u all of them, Enter keeps the
filter and gives the keys back to moving, Escape clears it; Escape with a
filter kept clears it before it closes the view. -}
viewKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> View -> Maybe View
viewKey k v =
    let
        name =
            Maybe.withDefault "" (lookupName k)
    in
    if v.filtering then
        if name == "Escape" || name == "C-c" then
            Just (filtered "" { v | filtering = False })

        else if name == "Enter" || name == "KPEnter" || name == "C-m" then
            Just { v | filtering = False }

        else if name == "BSpace" || name == "C-h" then
            Just (filtered (String.dropLast 1 v.filter) v)

        else if name == "C-u" then
            Just (filtered "" v)

        else
            let
                added =
                    viewText (Bytes.toStringLossy k.text)
            in
            if added /= "" && Bitwise.and k.mods 6 == 0 then
                Just (filtered (v.filter ++ added) v)

            else
                Just v

    else if name == "/" then
        Just { v | filtering = True }

    else if name == "Escape" && v.filter /= "" then
        Just (filtered "" v)

    else
        moveView name v


{-| Text for the filter: printable characters only. -}
viewText : String -> String
viewText text =
    String.toArray text
        |> Array.keepIf (\c -> Char.toCode c >= 0x20 && Char.toCode c /= 0x7F)
        |> String.fromArray


moveView : String -> View -> Maybe View
moveView name v =
    let

        page =
            max 1 (v.rows - 2)

        half =
            max 1 (v.rows // 2)

        last =
            max 0 (Array.length v.lines - v.rows)

        to n =
            Just { v | top = max 0 (min last n) }
    in
    if name == "q" || name == "Escape" || name == "C-c" then
        Nothing

    else if Array.member name [ "Up", "k", "C-p", "C-y" ] then
        to (v.top - 1)

    else if Array.member name [ "Down", "j", "C-n", "C-e", "Enter" ] then
        to (v.top + 1)

    else if Array.member name [ "PPage", "C-b", "b" ] then
        to (v.top - page)

    else if Array.member name [ "NPage", "C-f", "Space", "f" ] then
        to (v.top + page)

    else if name == "C-u" then
        to (v.top - half)

    else if name == "C-d" then
        to (v.top + half)

    else if Array.member name [ "g", "Home", "M-<" ] then
        to 0

    else if Array.member name [ "G", "End", "M->" ] then
        to last

    else
        Just v


{-| The view in tmux's look: over the active pane, its lines from the
pane's top and tmux's position, `[N/M]` in `mode-style` at the top right,
N the lines below the view and M those that do not fit, as tmux counts
them (measured on 3.8: `prefix ?` opens at `[70/70]` in a pane of 23 rows
over 93 lines). -}
tmuxView : Layout.Pane -> View -> { rows : Int, pieces : Array { row : Int, col : Int, color : String, text : String } }
tmuxView p v =
    let
        hidden =
            max 0 (Array.length v.lines - p.h)

        top =
            clamp 0 hidden v.top

        -- the lines in view, taken without adding to `top`
        inView =
            Array.dropFirst top v.lines

        position =
            "[" ++ String.fromInt (hidden - top) ++ "/" ++ String.fromInt hidden ++ "]"

        rowsOf =
            Array.range 0 (p.h - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        [ { row = p.y + r, col = p.x, color = "\u{001B}[0m", text = String.repeat p.w " " }
                        , { row = p.y + r, col = p.x, color = "\u{001B}[0m", text = String.takeFirst p.w (Maybe.withDefault "" (Array.get r inView)) }
                        ]
                    )
    in
    { rows = p.h
    , pieces =
        rowsOf
            ++ (if String.count position <= p.w then
                    [ { row = p.y, col = p.x + p.w - String.count position, color = messageColor, text = position } ]

                else
                    []
               )
            ++ (if v.filtering || v.filter /= "" then
                    [ { row = p.y + p.h - 1, col = p.x, color = messageColor, text = String.takeFirst p.w (String.padRight p.w ' ' (filterLine v)) } ]

                else
                    []
               )
    }


{-| The filter as the view shows it: what is typed, and how many lines
have it. -}
filterLine : View -> String
filterLine v =
    "/" ++ v.filter ++ (if v.filtering then "▏" else "") ++ "  " ++ String.fromInt (Array.length v.lines) ++ " of " ++ String.fromInt (Array.length v.all) ++ (if v.filtering then "  Enter: keep  Esc: clear" else "  Esc: clear")


{-| The view in puritty's look: a box over the panes, as wide as its
longest line allows, its keys and where it is on the bottom edge. -}
boxView : (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> Bool -> View -> { rows : Int, pieces : Array { row : Int, col : Int, color : String, text : String } }
boxView cols rows barTop v =
    let
        areaTop =
            if barTop then bar else 0

        areaH =
            rows - bar

        -- sized by every line, so that the box stays where it is as the
        -- filter keeps fewer
        longest =
            Array.foldl (\line m -> max m (String.count line)) 0 v.all

        w =
            max 4 (min cols (max 40 (longest + 4)))

        h =
            max 3 (min areaH (min 1000 (Array.length v.all) + 2))

        inner =
            h - 2

        x0 =
            (cols - w) // 2

        y0 =
            areaTop + (areaH - h) // 2

        last =
            max 0 (Array.length v.lines - inner)

        top =
            clamp 0 last v.top

        -- the lines in view, taken without adding to `top`
        inView =
            Array.dropFirst top v.lines

        shown =
            if Array.length v.lines > inner then
                " " ++ String.fromInt (top + 1) ++ "-" ++ String.fromInt (top + inner) ++ " of " ++ String.fromInt (Array.length v.lines) ++ " "

            else
                ""

        foot =
            String.takeFirst (w - 2)
                (if v.filtering || v.filter /= "" then
                    " " ++ filterLine v ++ " "

                 else
                    " q: close  /: filter " ++ (if shown == "" then "" else "─" ++ shown)
                )

        edge left mid right label =
            left ++ label ++ String.repeat (max 0 (w - 2 - String.count label)) mid ++ right

        body =
            Array.range 0 (inner - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        [ { row = y0 + 1 + r, col = x0, color = viewEdgeColor, text = "│" ++ String.repeat (w - 2) " " }
                        , { row = y0 + 1 + r, col = x0 + 2, color = viewTextColor, text = String.takeFirst (w - 4) (Maybe.withDefault "" (Array.get r inView)) }
                        , { row = y0 + 1 + r, col = x0 + w - 1, color = viewEdgeColor, text = "│" }
                        ]
                    )
    in
    { rows = inner
    , pieces =
        [ { row = y0, col = x0, color = viewEdgeColor, text = edge "╭" "─" "╮" " tmux " } ]
            ++ body
            ++ [ { row = y0 + h - 1, col = x0, color = viewEdgeColor, text = edge "╰" "─" "╯" foot } ]
    }


{-| A view's box in puritty's look: amber edges, on the tab bar's dark
band. -}
viewEdgeColor : String
viewEdgeColor =
    "\u{001B}[0;38;5;214;48;5;236m"


viewTextColor : String
viewTextColor =
    "\u{001B}[0;38;5;252;48;5;236m"


{-| Text written in the canvas in a color (TM21): each piece at its row
and column, with autowrap off (`paint` turns it off), so nothing moves. -}
drawText : String -> Array { row : Int, col : Int, text : String } -> (taken t : Vt.Term) -> Vt.Term
drawText color pieces t =
    if Array.isEmpty pieces then
        t

    else
        Vt.feed
            (Bytes.fromString
                (String.join ""
                    (Array.map
                        (\p -> "\u{001B}[" ++ String.fromInt (p.row + 1) ++ ";" ++ String.fromInt (p.col + 1) ++ "H" ++ color ++ p.text ++ "\u{001B}[0m")
                        pieces
                    )
                )
            )
            t


{-| The colors of what puritty draws around tmux's panes, from the 256
colors: the lines between tiled panes a quiet gray, a floating pane's box
gray and the active pane's in puritty's amber, the tab bar a dark band and
its active tab amber with dark text. -}
lineColor : String
lineColor =
    "\u{001B}[0;38;5;240m"


boxColor : String
boxColor =
    "\u{001B}[0;38;5;245m"


activeColor : String
activeColor =
    "\u{001B}[0;38;5;214m"


{-| tmux's `message-style` by default, black on yellow: a prompt or a
message in tmux's look (TM25). -}
messageColor : String
messageColor =
    "\u{001B}[0;30;43m"


barColor : String
barColor =
    "\u{001B}[0;38;5;250;48;5;236m"


activeTabColor : String
activeTabColor =
    "\u{001B}[0;1;38;5;234;48;5;214m"


{-| A tab whose window rang its bell, white on red, and one with activity
or silence, amber on the bar (TM30). -}
alertTabColor : String
alertTabColor =
    "\u{001B}[0;1;38;5;231;48;5;160m"


busyTabColor : String
busyTabColor =
    "\u{001B}[0;38;5;214;48;5;236m"


{-| The marked pane's frame in puritty's look, magenta, as tmux 3.8 draws
the marked pane's border (TM30). -}
markedColor : String
markedColor =
    "\u{001B}[0;38;5;170m"


{-| The keys of the tabs: Ctrl+Shift+T a new window, Ctrl+PgUp and
Ctrl+PgDn the previous and next. -}
tabKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken s : State) -> { state : State, commands : Array String, used : Bool }
tabKey k s =
    let
        command =
            if k.action == 1 && Bitwise.and k.mods 15 == 3 && (k.sym == 0x54 || k.sym == 0x74) then
                Just "new-window"

            else if k.action /= 0 && Bitwise.and k.mods 15 == 2 && k.sym == 0xFF55 then
                Just "previous-window"

            else if k.action /= 0 && Bitwise.and k.mods 15 == 2 && k.sym == 0xFF56 then
                Just "next-window"

            else
                Nothing
    in
    when command is
        Just c ->
            let
                r =
                    sent [ c ] s
            in
            { state = r.state, commands = r.commands, used = True }

        Nothing ->
            { state = s, commands = [], used = False }


{-| The selection's text, for Ctrl+Shift+C. -}
selectedText : State -> Maybe String
selectedText s =
    s.selection |> Maybe.andThen (\sel -> if sel.made then Just sel.text else Nothing)


{-| Shift+PgUp, PgDn, Home and End scroll the active pane's view, a page
or to the end, as without tmux; `Nothing` for any other key. -}
scrollKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken s : State) -> { state : State, used : Bool }
scrollKey k s =
    let
        sizes =
            withPane s.active s (\t -> { most = Vt.scrollbackRows t, page = t.rows })
                |> Maybe.withDefault { most = 0, page = 0 }

        now =
            backOf s.active s

        next =
            if k.action == 0 || sizes.most == 0 || Bitwise.and k.mods 15 /= 1 then
                Nothing

            else if k.sym == 0xFF55 then
                Just (min sizes.most (now + sizes.page))

            else if k.sym == 0xFF56 then
                Just (max 0 (now - sizes.page))

            else if k.sym == 0xFF50 then
                Just sizes.most

            else if k.sym == 0xFF57 then
                Just 0

            else
                Nothing
    in
    when next is
        Just b ->
            { state = { s | back = Dict.set s.active b s.back }, used = True }

        Nothing ->
            { state = s, used = False }


{-| `select-pane` when the pane is not already the active one. -}
selected : Int -> State -> Array String
selected pane s =
    if pane == s.active then
        []

    else
        [ "select-pane -t " ++ Command.quote ("%" ++ String.fromInt pane) ]


{-| A drag of a box going on: `move-pane -X -Y`, the box's new top left (its
border's, as tmux takes it with the border's lines), or `resize-pane -x -y`,
each time the pointer reaches a new cell. -}
dragged : Int -> Int -> Bool -> Drag -> (taken s : State) -> { state : State, commands : Array String }
dragged col row released d s =
    let
        top =
            s.barTop

        dx =
            col - d.col

        dy =
            row - d.row

        moved =
            col /= d.sent.col || row /= d.sent.row

        target =
            Command.quote ("%" ++ String.fromInt d.pane)

        command =
            if d.kind == 2 then
                -- a tiled pane's width; tmux takes the room from its neighbor
                "resize-pane -t " ++ target ++ " -x " ++ String.fromInt (max 1 (d.w + dx))

            else if d.kind == 3 then
                "resize-pane -t " ++ target ++ " -y " ++ String.fromInt (max 1 (d.h + dy))

            else if d.kind == 0 then
                -- `d.y` is where it is drawn, below the tab bar; tmux's rows
                -- start under it
                "move-pane -t " ++ target ++ " -X " ++ String.fromInt (d.x - 1 + dx) ++ " -Y " ++ String.fromInt (d.y - (if top then bar else 0) - 1 + dy)

            else
                -- a floating pane's size, as resize-pane takes it, counts its
                -- border's lines: `new-pane -x 30 -y 6` makes a 28 by 4 pane
                "resize-pane -t " ++ target ++ " -x " ++ String.fromInt (max 4 (d.w + 2 + dx)) ++ " -y " ++ String.fromInt (max 3 (d.h + 2 + dy))

        after =
            if released then
                Nothing

            else
                Just { d | sent = { col = col, row = row } }

        commands =
            if moved then
                [ command ]

            else
                []

        s2 =
            { s | drag = after }
    in
    if moved then
        sent commands s2

    else
        { state = s2, commands = [] }


{-| A pointer event as the pane's program asked for it, if it did: encoded
by the pane's mouse modes, at the pane's own cells, sent as its keys. -}
report : Int -> Window.PointerEvent -> Layout.Pane -> (taken s : State) -> { state : State, commands : Array String }
report held p q s =
    let
        encoded =
            withPane q.id s
                (\t ->
                    let
                        modes =
                            Vt.mouseModes t
                    in
                    if modes.tracking == Mouse.none then
                        Nothing

                    else
                        Just
                            (Mouse.encode
                                { tracking = modes.tracking
                                , format = modes.format
                                , size =
                                    { screenWidth = q.w * p.cellWidth
                                    , screenHeight = q.h * p.cellHeight
                                    , cellWidth = p.cellWidth
                                    , cellHeight = p.cellHeight
                                    , padTop = 0
                                    , padBottom = 0
                                    , padRight = 0
                                    , padLeft = 0
                                    }
                                , anyButtonPressed = held /= 0
                                , track = True
                                , last = s.mouseLast
                                }
                                { action = p.action
                                , button = p.button
                                , mods = p.mods
                                , x = p.x - q.x * p.cellWidth
                                , y = p.y - q.y * p.cellHeight
                                }
                            )
                )
                |> Maybe.andThen identity
    in
    when encoded is
        Just r ->
            if Bytes.isEmpty r.bytes then
                { state = { s | mouseLast = r.last }, commands = [] }

            else
                sent (Command.sendBytes q.id r.bytes) { s | mouseLast = r.last }

        Nothing ->
            { state = s, commands = [] }


{-| The window at a new size: the canvas, and tmux told. -}
resized : { cols : Int, rows : Int } -> (taken s : State) -> { state : State, commands : Array String }
resized size s =
    if s.on then
        sent [ Command.size (tmuxSize size) ] { s | canvas = Vt.resize (max 1 size.cols) (max 1 size.rows) s.canvas }

    else
        { state = s, commands = [] }
