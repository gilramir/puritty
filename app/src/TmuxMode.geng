module TmuxMode exposing
    ( State
    , idle
    , isOn
    , read
    , paint
    , keys
    , encodeKey
    , activeMode
    , pointer
    , scrollKey
    , tabKey
    , selectedText
    , resized
    , title
    )

{-| tmux control mode in puritty's window (`docs/tmux.md` TM13 step 3,
TM14): when `tmux -CC` starts on the terminal, the window shows the tmux
window's panes, each a terminal of its own fed its `%output`; tiled panes
where tmux puts them with a line between, floating panes over them in a
box; the active pane's cursor. Keys go to the active pane, the window's
size to tmux. `%exit` gives the terminal back.

The panes' terminals answer nothing: tmux answered their programs already.
-}

import Array.Builder as Builder exposing (Builder)
import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Keys
import Tmux.Command as Command
import Tmux.Control as Control exposing (Event(..), Notice(..))
import Tmux.Layout as Layout
import Vt
import Vt.Mouse as Mouse
import Window


type alias State =
    { reader : Control.Reader
    , on : Bool
      -- the tmux window shown, -1 until tmux says which
    , window : Int
    , name : String
      -- each pane's terminal, and its id at the same index
    , ids : Array Int
    , panes : Builder Vt.Term
    , layout : Maybe Layout.Cell
    , active : Int
      -- whether the window has a modal pane, which takes every key
    , modal : Bool
      -- the window's picture, made of the panes (`Vt.compose`)
    , canvas : Vt.Term
      -- what each command sent waits for in its reply, in the order sent:
      -- tmux answers a client's commands in turn (docs/tmux.md TM5.2)
    , expecting : Array Expect
      -- what tmux said of each pane on attach, for its capture
    , info : Dict Int PaneInfo
      -- a floating pane being moved or resized by its box, and the pane a
      -- press began in, which keeps the mouse until it is let go
    , drag : Maybe Drag
    , grab : Maybe Int
    , mouseLast : Maybe Mouse.Cell
      -- how far back each pane's view is scrolled, 0 or missing at the
      -- bottom; a selection, in one pane's rows (absolute, as the core's
      -- `Point`s are); the last press of the left button, for double and
      -- triple clicks (docs/tmux.md TM17)
    , back : Dict Int Int
    , selection : Maybe Sel
    , clicks : { at : Int, count : Int, pane : Int, point : Vt.Point }
      -- the session's windows, shown as tabs on the window's first row
      -- (docs/tmux.md TM18)
    , tabs : Array { id : Int, index : Int, name : String }
    }


{-| A selection within a pane: from `anchor` to `head`, by cells (mode 0),
words (1) or lines (2), the first word or line kept as `first` to `last`;
`made` once the button is let go, with its text. -}
type alias Sel =
    { pane : Int
    , anchor : Vt.Point
    , head : Vt.Point
    , first : Vt.Point
    , last : Vt.Point
    , mode : Int
    , moved : Bool
    , made : Bool
    , text : String
    }


{-| A drag of a floating pane's box: from where, the box as it was, and
what was last sent, so that a motion within a cell sends nothing. -}
type alias Drag =
    { pane : Int
    , move : Bool
    , col : Int
    , row : Int
    , x : Int
    , y : Int
    , w : Int
    , h : Int
    , sent : { col : Int, row : Int }
    }


{-| What a command's reply is for. -}
type Expect
    = ForWindow
    | ForTabs
    | ForPanes
    | ForInfo Int
    | ForSaved Int
    | ForCapture Int
    | ForNothing


{-| A pane as `list-panes` describes it on attach (TM5.8), and the main
screen's lines a capture of its saved grid gave while the alternate screen
was up. -}
type alias PaneInfo =
    { w : Int
    , h : Int
    , x : Int
    , y : Int
    , alt : Bool
    , top : Int
    , bottom : Int
    , modes : Array Int
    , saved : Array Bytes
    }


idle : {} -> State
idle _ =
    { reader = Control.reader
    , on = False
    , window = -1
    , name = ""
    , ids = []
    , panes = Builder.empty 0
    , layout = Nothing
    , active = -1
    , modal = False
    , canvas = blank 1 1
    , expecting = []
    , info = Dict.empty
    , drag = Nothing
    , grab = Nothing
    , mouseLast = Nothing
    , back = Dict.empty
    , selection = Nothing
    , clicks = { at = -1000, count = 0, pane = -1, point = { row = 0, col = 0 } }
    , tabs = []
    }


blank : Int -> Int -> Vt.Term
blank cols rows =
    Vt.new
        { cols = max 1 cols
        , rows = max 1 rows
        , scrollbackBytes = Vt.scrollbackBytesFor { cols = max 1 cols, rows = 1000 }
        , pageRows = Vt.defaultPageRows
        , checksums = False
        , cellWidth = 0
        , cellHeight = 0
        }


isOn : State -> Bool
isOn s =
    s.on


title : State -> String
title s =
    "tmux: " ++ s.name


{-| A read's bytes: the terminal's own (`outside`, for its core), and
what tmux said, done to the panes. `commands` are tmux commands to write,
each a line. -}
read : { cols : Int, rows : Int } -> Bytes -> (taken s : State) -> { state : State, outside : Bytes, commands : Array String }
read size bytes s =
    let
        fed =
            Control.feed bytes s.reader

        done =
            Array.foldl (event size) { state = { s | reader = fed.reader }, outside = [], commands = [] } fed.events
    in
    { state = done.state, outside = Bytes.flatten done.outside, commands = done.commands }


type alias Acc =
    { state : State, outside : Array Bytes, commands : Array String }


windowQuery : String
windowQuery =
    "display-message -p " ++ Command.quote "W #{window_id} #{window_visible_layout} #{window_name}"


{-| The session's windows, each a line starting with `T`. -}
tabsQuery : String
tabsQuery =
    "list-windows -F " ++ Command.quote "T #{window_id} #{window_index} #{window_name}"


{-| The rows of puritty's window above tmux's: the tab bar. -}
bar : Int
bar =
    1


{-| A pane of the layout where it is drawn in puritty's window: below the
tab bar. -}
down : Layout.Pane -> Layout.Pane
down p =
    { p | y = p.y + bar }


{-| The size tmux is told: puritty's window less the tab bar. -}
tmuxSize : { cols : Int, rows : Int } -> { cols : Int, rows : Int }
tmuxSize size =
    { cols = size.cols, rows = max 1 (size.rows - bar) }


{-| Every pane of the session, each a line starting with `P`, so that none
can read as a guard. -}
panesQuery : String
panesQuery =
    "list-panes -s -F " ++ Command.quote "P #{pane_id}"


{-| A pane's state, read in the same command line as its captures, so that
no output of the pane's comes between them (tmux runs one line's commands
in turn, before it reads a pane again): a capture holds the screen at one
moment, and the cursor that goes with it is read at that moment too. -}
infoOf : Int -> String
infoOf pane =
    "display-message -p -t "
        ++ Command.quote ("%" ++ String.fromInt pane)
        ++ " "
        ++ Command.quote "P #{pane_id} #{pane_width} #{pane_height} #{cursor_x} #{cursor_y} #{alternate_on} #{scroll_region_upper} #{scroll_region_lower} #{pane_private_modes}"


{-| A pane's history and screen, with its colours and attributes, wrapped
lines joined; or, with `saved`, the main screen kept while the alternate
one is up. -}
captureOf : Bool -> Int -> String
captureOf saved pane =
    "capture-pane -p -e -J -S - -E -"
        ++ (if saved then " -a -q" else "")
        ++ " -t "
        ++ Command.quote ("%" ++ String.fromInt pane)


{-| Commands sent on one line, `a ; b ; c`, each with what its reply is
for: tmux runs them in turn with nothing between, and answers each. -}
askLine : Array { command : String, expect : Expect } -> (taken acc : Acc) -> Acc
askLine asked acc =
    let
        st =
            acc.state
    in
    { acc
        | state = { st | expecting = st.expecting ++ Array.map .expect asked }
        , commands = Array.pushLast (String.join " ; " (Array.map .command asked)) acc.commands
    }


{-| Commands sent, each with what its reply is for. -}
ask : Array { command : String, expect : Expect } -> (taken acc : Acc) -> Acc
ask asked acc =
    let
        st =
            acc.state
    in
    { acc
        | state = { st | expecting = st.expecting ++ Array.map .expect asked }
        , commands = acc.commands ++ Array.map .command asked
    }


event : { cols : Int, rows : Int } -> Event -> (taken acc : Acc) -> Acc
event size e acc =
    when e is
        Outside b ->
            { acc | outside = Array.pushLast b acc.outside }

        Entered ->
            let
                st =
                    acc.state
            in
            ask
                [ { command = Command.clientFlags, expect = ForNothing }
                , { command = Command.size (tmuxSize size), expect = ForNothing }
                , { command = windowQuery, expect = ForWindow }
                , { command = tabsQuery, expect = ForTabs }
                , { command = panesQuery, expect = ForPanes }
                ]
                { acc | state = { st | on = True, window = -1, ids = [], panes = Builder.empty 0, layout = Nothing, active = -1, canvas = blank size.cols size.rows, expecting = [], info = Dict.empty } }

        Exited ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | on = False, ids = [], panes = Builder.empty 0, layout = Nothing, canvas = blank 1 1, expecting = [], info = Dict.empty } }

        Reply r ->
            if r.flags == 0 then
                -- a command not this client's: the one it was started
                -- with, or a hook's
                acc

            else
                let
                    st =
                        acc.state

                    expect =
                        Maybe.withDefault ForNothing (Array.first st.expecting)

                    popped =
                        { acc | state = { st | expecting = Array.dropFirst 1 st.expecting } }
                in
                replied expect r.ok r.lines popped

        Notice n ->
            notice n acc


{-| A reply, by what its command was for. -}
replied : Expect -> Bool -> Array Bytes -> (taken acc : Acc) -> Acc
replied expect ok lines acc =
    when expect is
        ForWindow ->
            { acc | state = Array.foldl replyLine acc.state lines }

        ForTabs ->
            let
                st =
                    acc.state

                tabs =
                    Array.mapAndKeepJust
                        (\line ->
                            when String.split " " (Bytes.toStringLossy line) |> Array.popFirst is
                                Just { first = "T", rest = rest } ->
                                    Just
                                        { id = idOf (Maybe.withDefault "" (Array.get 0 rest))
                                        , index = Maybe.withDefault 0 (String.toInt (Maybe.withDefault "" (Array.get 1 rest)))
                                        , name = String.join " " (Array.dropFirst 2 rest)
                                        }

                                _ ->
                                    Nothing
                        )
                        lines
            in
            { acc | state = { st | tabs = tabs } }

        ForPanes ->
            -- each pane's state and both its captures on one line: three
            -- replies, in turn
            Array.foldl
                (\line a ->
                    when String.split " " (Bytes.toStringLossy line) is
                        [ "P", id ] ->
                            let
                                pane =
                                    idOf id
                            in
                            askLine
                                [ { command = infoOf pane, expect = ForInfo pane }
                                , { command = captureOf True pane, expect = ForSaved pane }
                                , { command = captureOf False pane, expect = ForCapture pane }
                                ]
                                a

                        _ ->
                            a
                )
                acc
                lines

        ForInfo pane ->
            let
                st =
                    acc.state
            in
            when Array.first lines |> Maybe.andThen paneLine is
                Just d ->
                    { acc | state = { st | info = Dict.set pane d.info st.info } }

                Nothing ->
                    { acc | state = st }

        ForSaved pane ->
            let
                st =
                    acc.state
            in
            { acc | state = { st | info = Dict.update pane (Maybe.map (\i -> { i | saved = if ok then lines else [] })) st.info } }

        ForCapture pane ->
            if ok then
                { acc | state = rebuild pane lines acc.state }

            else
                acc

        ForNothing ->
            acc


{-| A line of `panesQuery`'s answer. -}
paneLine : Bytes -> Maybe { id : Int, info : PaneInfo }
paneLine bytes =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)

        int i =
            Maybe.withDefault 0 (String.toInt (Maybe.withDefault "" (Array.get i words)))
    in
    if Array.get 0 words /= Just "P" then
        Nothing

    else
        Just
            { id = idOf (Maybe.withDefault "" (Array.get 1 words))
            , info =
                { w = int 2
                , h = int 3
                , x = int 4
                , y = int 5
                , alt = int 6 == 1
                , top = int 7
                , bottom = int 8
                , modes = String.split "," (Maybe.withDefault "" (Array.get 9 words)) |> Array.mapAndKeepJust String.toInt
                , saved = []
                }
            }


{-| A pane's terminal made again from its capture: the main screen's lines,
then, with the alternate screen up, that screen's; the private modes that
are on; the scroll region; the cursor. Whatever the pane printed before
the capture's reply is in the capture, so what its terminal held is
dropped (TM5.8). -}
rebuild : Int -> Array Bytes -> (taken s : State) -> State
rebuild pane lines s =
    when Dict.get pane s.info is
        Nothing ->
            s

        Just i ->
            let
                screen ls =
                    Bytes.flatten (Array.intersperse (Bytes.fromString "\u{001B}[0m\r\n") ls)

                modes =
                    Array.map (\m -> "\u{001B}[?" ++ String.fromInt m ++ "h") i.modes
                        ++ (if Array.member 25 i.modes then [] else [ "\u{001B}[?25l" ])
                        ++ (if Array.member 7 i.modes then [] else [ "\u{001B}[?7l" ])

                region =
                    if i.top > 0 || i.bottom < i.h - 1 then
                        "\u{001B}[" ++ String.fromInt (i.top + 1) ++ ";" ++ String.fromInt (i.bottom + 1) ++ "r"

                    else
                        ""

                cursor =
                    "\u{001B}[" ++ String.fromInt (i.y + 1) ++ ";" ++ String.fromInt (i.x + 1) ++ "H"

                made =
                    blank i.w i.h
                        |> Vt.feed (screen (if i.alt then i.saved else lines))
                        |> Vt.feed (Bytes.fromString (if i.alt then "\u{001B}[0m\u{001B}[?1049h\u{001B}[H" else "\u{001B}[0m"))
                        |> (\t -> if i.alt then Vt.feed (screen lines) t else t)
                        |> Vt.feed (Bytes.fromString ("\u{001B}[0m" ++ String.join "" modes ++ region ++ cursor))

                term =
                    (Vt.takeReplies made).term
            in
            when Array.findFirst (\x -> x == pane) s.ids is
                Just found ->
                    { s | panes = Builder.set found.index term s.panes }

                Nothing ->
                    { s | ids = Array.pushLast pane s.ids, panes = Builder.pushLast term s.panes }


{-| A line of `windowQuery`'s answer: `W @id layout name`. -}
replyLine : Bytes -> (taken s : State) -> State
replyLine bytes s =
    let
        words =
            String.split " " (Bytes.toStringLossy bytes)
    in
    when words is
        [ "W", w, layoutText ] ->
            showWindow (idOf w) layoutText "" s

        _ ->
            when Array.get 0 words is
                Just "W" ->
                    showWindow (idOf (Maybe.withDefault "" (Array.get 1 words))) (Maybe.withDefault "" (Array.get 2 words)) (String.join " " (Array.dropFirst 3 words)) s

                _ ->
                    s


idOf : String -> Int
idOf w =
    Maybe.withDefault -1 (String.toInt (String.dropFirst 1 w))


showWindow : Int -> String -> String -> (taken s : State) -> State
showWindow window layoutText name s =
    if window < 0 then
        s

    else
        applyLayout layoutText { s | window = window, name = if name == "" then s.name else name }


notice : Notice -> (taken acc : Acc) -> Acc
notice n acc =
    let
        st =
            acc.state
    in
    when n is
        Output o ->
            { acc | state = feedPane o.pane o.bytes st }

        LayoutChange l ->
            if l.window == st.window || st.window < 0 then
                { acc | state = applyLayout l.visible { st | window = l.window, modal = String.contains "O" l.flags } }

            else
                { acc | state = st }

        WindowPaneChanged p ->
            if p.window == st.window then
                { acc | state = { st | active = p.pane } }

            else
                { acc | state = st }

        SessionWindowChanged _ ->
            -- another window of the session shown: ask for its layout
            ask [ { command = windowQuery, expect = ForWindow } ] { acc | state = st }

        SessionChanged _ ->
            ask [ { command = windowQuery, expect = ForWindow }, { command = tabsQuery, expect = ForTabs }, { command = panesQuery, expect = ForPanes } ] { acc | state = st }

        WindowAdd _ ->
            ask [ { command = tabsQuery, expect = ForTabs } ] { acc | state = st }

        WindowClose _ ->
            ask [ { command = tabsQuery, expect = ForTabs } ] { acc | state = st }

        WindowRenamed r ->
            let
                tabs =
                    Array.map (\t -> if t.id == r.window then { t | name = r.name } else t) st.tabs
            in
            if r.window == st.window then
                { acc | state = { st | name = r.name, tabs = tabs } }

            else
                { acc | state = { st | tabs = tabs } }

        _ ->
            { acc | state = st }


{-| A pane's output fed to its terminal, made at a guessed size if tmux
has not yet said where it goes; its replies dropped. -}
feedPane : Int -> Bytes -> (taken s : State) -> State
feedPane id bytes s =
    when Array.findFirst (\i -> i == id) s.ids is
        Just found ->
            let
                back =
                    backOf id s

                pushedBefore =
                    if back > 0 then
                        Maybe.withDefault 0 (withPane id s Vt.rowsPushed)

                    else
                        0

                fed =
                    { s | panes = Builder.update found.index (\t -> (Vt.takeReplies (Vt.feed bytes t)).term) s.panes }
            in
            if back > 0 then
                -- a view scrolled back stays on its rows as more come in
                let
                    after =
                        withPane id fed (\t -> { pushed = Vt.rowsPushed t, most = Vt.scrollbackRows t })
                            |> Maybe.withDefault { pushed = pushedBefore, most = back }
                in
                { fed | back = Dict.set id (min after.most (back + after.pushed - pushedBefore)) fed.back }

            else
                fed

        Nothing ->
            { s | ids = Array.pushLast id s.ids, panes = Builder.pushLast (Vt.takeReplies (Vt.feed bytes (blank 80 24))).term s.panes }


{-| A layout: its panes' terminals made or sized to their boxes. -}
applyLayout : String -> (taken s : State) -> State
applyLayout text s =
    when Layout.parse text is
        Ok cell ->
            let
                boxes =
                    Layout.panes cell

                sized =
                    Array.foldl sizePane { ids = s.ids, panes = s.panes } boxes

                active =
                    when Array.findFirst .active boxes is
                        Just a ->
                            a.value.id

                        Nothing ->
                            s.active
            in
            { s | layout = Just cell, ids = sized.ids, panes = sized.panes, active = active }

        Err _ ->
            s


sizePane : Layout.Pane -> (taken acc : { ids : Array Int, panes : Builder Vt.Term }) -> { ids : Array Int, panes : Builder Vt.Term }
sizePane place acc =
    when Array.findFirst (\i -> i == place.id) acc.ids is
        Just found ->
            { ids = acc.ids
            , panes =
                Builder.update found.index
                    (\t ->
                        if t.cols /= place.w || t.rows /= place.h then
                            Vt.resize (max 1 place.w) (max 1 place.h) t

                        else
                            t
                    )
                    acc.panes
            }

        Nothing ->
            { ids = Array.pushLast place.id acc.ids, panes = Builder.pushLast (blank place.w place.h) acc.panes }


{-| The window's picture made again: the tiled panes with lines between,
the floating ones over them in boxes, the bottom first, and the cursor at
the active pane's. -}
paint : (taken s : State) -> State
paint s =
    when s.layout is
        Nothing ->
            s

        Just cell ->
            let
                tiled =
                    Array.map down (Layout.tiled cell)

                floating =
                    Array.map down (Layout.floating cell)

                tabBar =
                    tabsOf cols s

                -- where each pane goes, and how far back its view is, read
                -- before the canvas is written
                tiledPlaces =
                    placesOf tiled s

                floatPlaces =
                    Array.map (\p -> { id = p.id, places = [] }) floating |> eachPlaces floating s

                cols =
                    s.canvas.cols

                rows =
                    s.canvas.rows

                -- the selection's cells, read before the canvas is written
                tiledSpans =
                    spansAll tiled s

                floatSpans =
                    Array.map (\p -> { id = p.id, spans = [] }) floating
                        |> withSpans floating s

                -- the dividers right of and below each tiled pane
                lines =
                    Array.mapAndFlatten (divider cols rows) tiled

                cursor =
                    cursorOf s.active (backOf s.active s) (tiled ++ floating) s.ids s.panes

                -- the tiled panes and their dividers, then each floating
                -- pane in its box, the bottom one first
                composed =
                    s.canvas
                        |> Vt.feed (Bytes.fromString "\u{001B}[H\u{001B}[2J")
                        |> Vt.compose s.panes tiledPlaces
                        |> Vt.invert tiledSpans
                        |> Vt.paint lines
                        |> (\c -> Array.foldl (\p acc -> acc |> Vt.paint (boxAround cols rows p) |> Vt.compose s.panes (placesIn p.id floatPlaces) |> Vt.invert (spansIn p.id floatSpans)) c floating)
                        |> Vt.paint [ { row = 0, col = 0, text = tabBar.text } ]
                        |> Vt.invert tabBar.active
                        |> Vt.feed (Bytes.fromString cursor)
            in
            { s | canvas = (Vt.takeReplies composed).term }


{-| CUP to the active pane's cursor in the window, and DECTCEM as the
pane has it. -}
cursorOf : Int -> Int -> Array Layout.Pane -> Array Int -> Builder Vt.Term -> String
cursorOf active back boxes ids panes =
    when { place = Array.findFirst (\b -> b.id == active) boxes, index = Array.findFirst (\i -> i == active) ids } is
        { place = Just place, index = Just index } ->
            when Builder.get index.index panes is
                Just t ->
                    let
                        at =
                            Vt.cursorOf t
                    in
                    if at.y + back >= place.value.h then
                        -- scrolled back past it
                        "\u{001B}[?25l"

                    else
                        "\u{001B}["
                            ++ String.fromInt (place.value.y + at.y + back + 1)
                            ++ ";"
                            ++ String.fromInt (place.value.x + at.x + 1)
                            ++ "H"
                            ++ (if at.visible then "\u{001B}[?25h" else "\u{001B}[?25l")

                Nothing ->
                    "\u{001B}[?25l"

        _ ->
            "\u{001B}[?25l"


divider : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
divider cols rows p =
    let
        right =
            if p.x + p.w < cols then
                Array.range p.y (min rows (p.y + p.h) - 1) |> Array.map (\r -> { row = r, col = p.x + p.w, text = "│" })

            else
                []

        below =
            if p.y + p.h < rows then
                [ { row = p.y + p.h, col = p.x, text = String.repeat (min p.w (cols - p.x)) "─" } ]

            else
                []
    in
    right ++ below


boxAround : Int -> Int -> Layout.Pane -> Array { row : Int, col : Int, text : String }
boxAround cols rows p =
    let
        left =
            p.x - 1

        right =
            p.x + p.w

        top =
            p.y - 1

        bottom =
            p.y + p.h

        inside =
            max 0 (min p.w (cols - p.x))

        edge l mid r =
            (if left >= 0 then l else "") ++ String.repeat inside mid ++ (if right < cols then r else "")

        from =
            if left >= 0 then left else p.x
    in
    (if top >= 0 then [ { row = top, col = from, text = edge "┌" "─" "┐" } ] else [])
        ++ (Array.range p.y (min rows bottom - 1)
                |> Array.mapAndFlatten
                    (\r ->
                        (if left >= 0 then [ { row = r, col = left, text = "│" } ] else [])
                            ++ (if right < cols then [ { row = r, col = right, text = "│" } ] else [])
                    )
           )
        ++ (if bottom < rows then [ { row = bottom, col = from, text = edge "└" "─" "┘" } ] else [])


{-| What a key or a paste sends, as commands to the active pane. -}
keys : Bytes -> (taken s : State) -> { state : State, commands : Array String }
keys bytes s =
    if s.active < 0 then
        { state = s, commands = [] }

    else
        -- a key the pane's program gets brings its view to the bottom
        sent (Command.sendBytes s.active bytes) { s | back = if Bytes.isEmpty bytes then s.back else Dict.remove s.active s.back }


{-| `n` more replies to read and drop. -}
waitingFor : Int -> (taken s : State) -> State
waitingFor n s =
    { s | expecting = s.expecting ++ Array.repeat n ForNothing }


{-| Commands whose replies say nothing puritty reads, sent. -}
sent : Array String -> (taken s : State) -> { state : State, commands : Array String }
sent commands s =
    { state = { s | expecting = s.expecting ++ Array.map (\_ -> ForNothing) commands }, commands = commands }


{-| What a key sends the active pane's program, by that pane's modes
(DECCKM, keypad, the kitty flags, modifyOtherKeys); `Nothing` when no pane
is active yet. -}
encodeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> State -> Maybe Bytes
encodeKey k s =
    withPane s.active s (\t -> Keys.encode t k)


{-| Whether a private mode is set in the active pane, as bracketed paste
(2004) and focus reports (1004) are asked. -}
activeMode : Int -> State -> Maybe Bool
activeMode mode s =
    withPane s.active s (\t -> Dict.get mode t.modes == Just True)


{-| What a pane's terminal answers, looked at in place. -}
withPane : Int -> State -> (Vt.Term -> a) -> Maybe a
withPane pane s f =
    when Array.findFirst (\i -> i == pane) s.ids is
        Just found ->
            when Builder.get found.index s.panes is
                Just t ->
                    Just (f t)

                Nothing ->
                    Nothing

        Nothing ->
            Nothing


{-| How far back a pane's view is scrolled. -}
backOf : Int -> State -> Int
backOf pane s =
    Maybe.withDefault 0 (Dict.get pane s.back)


{-| The cells of the canvas a pane's part of the selection covers, row by
row, where they show: its rows are absolute (pushed rows and the screen's),
drawn at the pane's place less how far it is scrolled back. -}
spans : Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
spans q s =
    when s.selection is
        Just sel ->
            if sel.pane /= q.id then
                []

            else
                Maybe.withDefault []
                    (withPane q.id s
                        (\t ->
                            let
                                top =
                                    Vt.rowsPushed t - backOf q.id s

                                ordered =
                                    if before sel.head sel.anchor then
                                        { from = sel.head, to = sel.anchor }

                                    else
                                        { from = sel.anchor, to = sel.head }
                            in
                            Array.range (max ordered.from.row top) (min ordered.to.row (top + q.h - 1))
                                |> Array.map
                                    (\r ->
                                        { row = q.y + r - top
                                        , from = q.x + (if r == ordered.from.row then ordered.from.col else 0)
                                        , to = q.x + (if r == ordered.to.row then ordered.to.col else q.w - 1)
                                        }
                                    )
                        )
                    )

        Nothing ->
            []


placesOf : Array Layout.Pane -> State -> Array { index : Int, x : Int, y : Int, back : Int }
placesOf panes s =
    Array.mapAndKeepJust (\p -> Array.findFirst (\i -> i == p.id) s.ids |> Maybe.map (\found -> { index = found.index, x = p.x, y = p.y, back = backOf p.id s })) panes


eachPlaces : Array Layout.Pane -> State -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int } } -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int } }
eachPlaces panes s _ =
    Array.map (\p -> { id = p.id, places = placesOf [ p ] s }) panes


placesIn : Int -> Array { id : Int, places : Array { index : Int, x : Int, y : Int, back : Int } } -> Array { index : Int, x : Int, y : Int, back : Int }
placesIn id all =
    Array.findFirst (\e -> e.id == id) all |> Maybe.map (\e -> e.value.places) |> Maybe.withDefault []


spansAll : Array Layout.Pane -> State -> Array { row : Int, from : Int, to : Int }
spansAll panes s =
    Array.mapAndFlatten (\p -> spans p s) panes


withSpans : Array Layout.Pane -> State -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } } -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } }
withSpans panes s _ =
    Array.map (\p -> { id = p.id, spans = spans p s }) panes


spansIn : Int -> Array { id : Int, spans : Array { row : Int, from : Int, to : Int } } -> Array { row : Int, from : Int, to : Int }
spansIn id all =
    Array.findFirst (\e -> e.id == id) all |> Maybe.map (\e -> e.value.spans) |> Maybe.withDefault []


before : Vt.Point -> Vt.Point -> Bool
before a b =
    a.row < b.row || (a.row == b.row && a.col < b.col)


{-| A pointer event in the window (docs/tmux.md TM16, TM17): a press on a
floating pane's top edge moves it and on its bottom or right edge resizes
it, tmux told as the pointer reaches each new cell; a press elsewhere makes
the pane under it active. A pane whose program asked for the mouse gets the
event as its own, in its own cells; the pane a press began in keeps the
mouse until it is let go. Otherwise, or with Shift (`select`), the left
button selects within the pane (a click, a double click for a word, a
triple for a line), the paste button asks for a paste, and the wheel
scrolls the pane's view, or on its alternate screen sends three arrow
keys. `held` is the buttons held after the event; `own` is a selection's
text when it is made, for PRIMARY. -}
pointer : { ms : Int, held : Int, select : Bool, boundaries : Array Int, pasteButton : Int } -> Window.PointerEvent -> (taken s : State) -> { state : State, commands : Array String, own : Maybe String, paste : Bool }
pointer how p s =
    when s.layout is
        Nothing ->
            { state = s, commands = [], own = Nothing, paste = False }

        Just cell ->
            let
                col =
                    p.x // max 1 p.cellWidth

                row =
                    p.y // max 1 p.cellHeight

                -- the topmost pane first: floating ones top down, then tiled
                order =
                    Array.map down (Array.reverse (Layout.floating cell) ++ Layout.tiled cell)

                inside q =
                    col >= q.x && col < q.x + q.w && row >= q.y && row < q.y + q.h

                onBox q =
                    q.z /= Nothing && col >= q.x - 1 && col <= q.x + q.w && row >= q.y - 1 && row <= q.y + q.h && not (inside q)

                under =
                    Array.findFirst (\q -> inside q || onBox q) order |> Maybe.map .value

                tabHit =
                    if row < bar && p.action == 0 && p.button == 1 && s.drag == Nothing && s.grab == Nothing then
                        Array.findFirst (\h -> col >= h.from && col <= h.to) (tabsOf (p.width // max 1 p.cellWidth) s).hits |> Maybe.map .value

                    else
                        Nothing

                -- the pane a press began in, while a button is held
                target =
                    when s.grab is
                        Just g ->
                            Array.findFirst (\q -> q.id == g) order |> Maybe.map .value

                        Nothing ->
                            under

                plain r =
                    { state = r.state, commands = r.commands, own = Nothing, paste = False }

                -- whether the pane under the pointer, or the one that has it,
                -- has a program that takes the mouse
                takesMouse =
                    not how.select && paneTakesMouse target s
            in
            when { drag = s.drag, tab = tabHit } is
                { drag = Just d } ->
                    plain (dragged col row (p.action == 1) d s)

                { tab = Just hit } ->
                    -- a tab selects its window; `+` makes one
                    plain (sent [ if hit.window < 0 then "new-window" else "select-window -t " ++ Command.quote ("@" ++ String.fromInt hit.window) ] s)

                _ ->
                    when target is
                        Nothing ->
                            { state = s, commands = [], own = Nothing, paste = False }

                        Just q ->
                            if p.action == 0 && p.button == 1 && onBox q then
                                -- the top edge moves the box; the others resize it
                                let
                                    select =
                                        selected q.id s
                                in
                                plain (sent select { s | drag = Just { pane = q.id, move = row == q.y - 1, col = col, row = row, x = q.x, y = q.y, w = q.w, h = q.h, sent = { col = col, row = row } } })

                            else if takesMouse then
                                let
                                    select =
                                        if p.action == 0 then
                                            selected q.id s

                                        else
                                            []

                                    grabbed =
                                        if p.action == 0 then
                                            { s | grab = Just q.id }

                                        else if how.held == 0 then
                                            { s | grab = Nothing }

                                        else
                                            s

                                    reported =
                                        report how.held p q grabbed
                                in
                                plain { state = waitingFor (Array.length select) reported.state, commands = select ++ reported.commands }

                            else
                                selecting how p col row q s


paneTakesMouse : Maybe Layout.Pane -> State -> Bool
paneTakesMouse target s =
    when target is
        Just q ->
            withPane q.id s (\t -> (Vt.mouseModes t).tracking /= Mouse.none) == Just True

        Nothing ->
            False


{-| The pointer over a pane whose program does not take the mouse, or with
Shift: selection, paste and the wheel, as puritty does without tmux
(`Main.selecting`, `wheelStep`), in the pane's own terminal. -}
selecting : { ms : Int, held : Int, select : Bool, boundaries : Array Int, pasteButton : Int } -> Window.PointerEvent -> Int -> Int -> Layout.Pane -> (taken s : State) -> { state : State, commands : Array String, own : Maybe String, paste : Bool }
selecting how p col row q s =
    let
        at =
            Maybe.withDefault { row = 0, col = 0 }
                (withPane q.id s (\t -> { row = Vt.rowsPushed t + clamp 0 (q.h - 1) (row - q.y) - backOf q.id s, col = clamp 0 (q.w - 1) (col - q.x) }))

        none r =
            { state = r, commands = [], own = Nothing, paste = False }

        wheel =
            p.button == 4 || p.button == 5
    in
    if p.action == 0 && p.button == how.pasteButton then
        { state = s, commands = [], own = Nothing, paste = True }

    else if p.action == 0 && wheel then
        let
            up =
                p.button == 4

            -- on the alternate screen, three arrow keys, as without tmux
            arrows =
                withPane q.id s
                    (\t ->
                        if t.alt && Dict.get 1007 t.modes /= Just False then
                            let
                                arrow =
                                    (if Dict.get 1 t.modes == Just True then "\u{001B}O" else "\u{001B}[") ++ (if up then "A" else "B")
                            in
                            Just (arrow ++ arrow ++ arrow)

                        else
                            Nothing
                    )
                    |> Maybe.andThen identity

            most =
                Maybe.withDefault 0 (withPane q.id s Vt.scrollbackRows)
        in
        when arrows is
            Just keyed ->
                let
                    r =
                        sent (Command.sendBytes q.id (Bytes.fromString keyed)) s
                in
                { state = r.state, commands = r.commands, own = Nothing, paste = False }

            Nothing ->
                let
                    now =
                        backOf q.id s

                    next =
                        if up then min most (now + 3) else max 0 (now - 3)
                in
                none { s | back = Dict.set q.id next s.back }

    else if p.action == 0 && p.button == 1 then
        let
            count =
                if how.ms - s.clicks.at <= 500 && s.clicks.pane == q.id && s.clicks.point == at then
                    modBy 3 s.clicks.count + 1

                else
                    1

            span =
                withPane q.id s
                    (\t ->
                        if count == 2 then
                            Vt.wordAt how.boundaries at t

                        else if count == 3 then
                            Vt.lineAt at t

                        else
                            Just { start = at, end = at }
                    )
                    |> Maybe.andThen identity

            sel =
                Maybe.map (\w -> { pane = q.id, anchor = w.start, head = w.end, first = w.start, last = w.end, mode = count - 1, moved = count > 1, made = False, text = "" }) span

            select =
                selected q.id s

            r =
                sent select { s | selection = sel, grab = Just q.id, clicks = { at = how.ms, count = count, pane = q.id, point = at } }
        in
        { state = r.state, commands = r.commands, own = Nothing, paste = False }

    else if p.action == 2 && Bitwise.and how.held 2 /= 0 then
        when s.selection is
            Just sel ->
                if sel.made || sel.pane /= q.id then
                    none s

                else
                    none { s | selection = Just (extended how.boundaries at sel s) }

            Nothing ->
                none s

    else if p.action == 1 && p.button == 1 then
        when s.selection is
            Just sel ->
                if sel.made then
                    none { s | grab = Nothing }

                else if sel.mode == 0 && not sel.moved then
                    -- a click: no selection
                    none { s | grab = Nothing, selection = Nothing }

                else
                    let
                        text =
                            Maybe.withDefault "" (withPane sel.pane s (Vt.selectionText sel.anchor sel.head))
                    in
                    { state = { s | grab = Nothing, selection = Just { sel | made = True, text = text } }, commands = [], own = Just text, paste = False }

            Nothing ->
                none { s | grab = Nothing }

    else
        none
            (if how.held == 0 then
                { s | grab = Nothing }

             else
                s
            )


{-| A selection being dragged, its head at `at`: by cells, at it; by words
or lines, the word or line there, the first one kept on the far side. -}
extended : Array Int -> Vt.Point -> Sel -> State -> Sel
extended boundaries at sel s =
    if sel.mode == 0 then
        { sel | head = at, moved = True }

    else
        let
            w =
                withPane sel.pane s
                    (\t ->
                        if sel.mode == 1 then
                            Vt.wordAt boundaries at t

                        else
                            Vt.lineAt at t
                    )
                    |> Maybe.andThen identity
                    |> Maybe.withDefault { start = at, end = at }
        in
        if before w.start sel.first then
            { sel | anchor = sel.last, head = w.start }

        else
            { sel | anchor = sel.first, head = w.end }


{-| The tab bar: a tab for each window, ` 1:name `, between `│`s, the
active one inverse, then ` + `, cut at the window's width; and which
columns each tab and the `+` cover, `-1` for the `+`. -}
tabsOf : Int -> State -> { text : String, active : Array { row : Int, from : Int, to : Int }, hits : Array { from : Int, to : Int, window : Int } }
tabsOf cols s =
    let
        labels =
            Array.map (\t -> { window = t.id, text = " " ++ String.fromInt t.index ++ ":" ++ t.name ++ " " }) s.tabs
                ++ [ { window = -1, text = " + " } ]

        laid =
            Array.foldl
                (\l acc ->
                    let
                        width =
                            String.count l.text
                    in
                    { at = acc.at + width + 1
                    , text = acc.text ++ l.text ++ "│"
                    , hits = Array.pushLast { from = acc.at, to = acc.at + width - 1, window = l.window } acc.hits
                    }
                )
                { at = 0, text = "", hits = [] }
                labels
    in
    { text = String.takeFirst cols laid.text
    , active =
        laid.hits
            |> Array.keepIf (\h -> h.window == s.window && h.window >= 0)
            |> Array.map (\h -> { row = 0, from = h.from, to = min (cols - 1) h.to })
    , hits = laid.hits
    }


{-| The keys of the tabs: Ctrl+Shift+T a new window, Ctrl+PgUp and
Ctrl+PgDn the previous and next. -}
tabKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken s : State) -> { state : State, commands : Array String, used : Bool }
tabKey k s =
    let
        command =
            if k.action == 1 && Bitwise.and k.mods 15 == 3 && (k.sym == 0x54 || k.sym == 0x74) then
                Just "new-window"

            else if k.action /= 0 && Bitwise.and k.mods 15 == 2 && k.sym == 0xFF55 then
                Just "previous-window"

            else if k.action /= 0 && Bitwise.and k.mods 15 == 2 && k.sym == 0xFF56 then
                Just "next-window"

            else
                Nothing
    in
    when command is
        Just c ->
            let
                r =
                    sent [ c ] s
            in
            { state = r.state, commands = r.commands, used = True }

        Nothing ->
            { state = s, commands = [], used = False }


{-| The selection's text, for Ctrl+Shift+C. -}
selectedText : State -> Maybe String
selectedText s =
    s.selection |> Maybe.andThen (\sel -> if sel.made then Just sel.text else Nothing)


{-| Shift+PgUp, PgDn, Home and End scroll the active pane's view, a page
or to the end, as without tmux; `Nothing` for any other key. -}
scrollKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken s : State) -> { state : State, used : Bool }
scrollKey k s =
    let
        sizes =
            withPane s.active s (\t -> { most = Vt.scrollbackRows t, page = t.rows })
                |> Maybe.withDefault { most = 0, page = 0 }

        now =
            backOf s.active s

        next =
            if k.action == 0 || sizes.most == 0 || Bitwise.and k.mods 15 /= 1 then
                Nothing

            else if k.sym == 0xFF55 then
                Just (min sizes.most (now + sizes.page))

            else if k.sym == 0xFF56 then
                Just (max 0 (now - sizes.page))

            else if k.sym == 0xFF50 then
                Just sizes.most

            else if k.sym == 0xFF57 then
                Just 0

            else
                Nothing
    in
    when next is
        Just b ->
            { state = { s | back = Dict.set s.active b s.back }, used = True }

        Nothing ->
            { state = s, used = False }


{-| `select-pane` when the pane is not already the active one. -}
selected : Int -> State -> Array String
selected pane s =
    if pane == s.active then
        []

    else
        [ "select-pane -t " ++ Command.quote ("%" ++ String.fromInt pane) ]


{-| A drag of a box going on: `move-pane -X -Y`, the box's new top left (its
border's, as tmux takes it with the border's lines), or `resize-pane -x -y`,
each time the pointer reaches a new cell. -}
dragged : Int -> Int -> Bool -> Drag -> (taken s : State) -> { state : State, commands : Array String }
dragged col row released d s =
    let
        dx =
            col - d.col

        dy =
            row - d.row

        moved =
            col /= d.sent.col || row /= d.sent.row

        target =
            Command.quote ("%" ++ String.fromInt d.pane)

        command =
            if d.move then
                -- `d.y` is where it is drawn, below the tab bar; tmux's rows
                -- start under it
                "move-pane -t " ++ target ++ " -X " ++ String.fromInt (d.x - 1 + dx) ++ " -Y " ++ String.fromInt (d.y - bar - 1 + dy)

            else
                -- a floating pane's size, as resize-pane takes it, counts its
                -- border's lines: `new-pane -x 30 -y 6` makes a 28 by 4 pane
                "resize-pane -t " ++ target ++ " -x " ++ String.fromInt (max 4 (d.w + 2 + dx)) ++ " -y " ++ String.fromInt (max 3 (d.h + 2 + dy))

        after =
            if released then
                Nothing

            else
                Just { d | sent = { col = col, row = row } }

        commands =
            if moved then
                [ command ]

            else
                []

        s2 =
            { s | drag = after }
    in
    if moved then
        sent commands s2

    else
        { state = s2, commands = [] }


{-| A pointer event as the pane's program asked for it, if it did: encoded
by the pane's mouse modes, at the pane's own cells, sent as its keys. -}
report : Int -> Window.PointerEvent -> Layout.Pane -> (taken s : State) -> { state : State, commands : Array String }
report held p q s =
    let
        encoded =
            withPane q.id s
                (\t ->
                    let
                        modes =
                            Vt.mouseModes t
                    in
                    if modes.tracking == Mouse.none then
                        Nothing

                    else
                        Just
                            (Mouse.encode
                                { tracking = modes.tracking
                                , format = modes.format
                                , size =
                                    { screenWidth = q.w * p.cellWidth
                                    , screenHeight = q.h * p.cellHeight
                                    , cellWidth = p.cellWidth
                                    , cellHeight = p.cellHeight
                                    , padTop = 0
                                    , padBottom = 0
                                    , padRight = 0
                                    , padLeft = 0
                                    }
                                , anyButtonPressed = held /= 0
                                , track = True
                                , last = s.mouseLast
                                }
                                { action = p.action
                                , button = p.button
                                , mods = p.mods
                                , x = p.x - q.x * p.cellWidth
                                , y = p.y - q.y * p.cellHeight
                                }
                            )
                )
                |> Maybe.andThen identity
    in
    when encoded is
        Just r ->
            if Bytes.isEmpty r.bytes then
                { state = { s | mouseLast = r.last }, commands = [] }

            else
                sent (Command.sendBytes q.id r.bytes) { s | mouseLast = r.last }

        Nothing ->
            { state = s, commands = [] }


{-| The window at a new size: the canvas, and tmux told. -}
resized : { cols : Int, rows : Int } -> (taken s : State) -> { state : State, commands : Array String }
resized size s =
    if s.on then
        sent [ Command.size (tmuxSize size) ] { s | canvas = Vt.resize (max 1 size.cols) (max 1 size.rows) s.canvas }

    else
        { state = s, commands = [] }
