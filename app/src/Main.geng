type alias Model =
    { config : Config
    , look : View.Look
    , term : Vt.Term
    , shadow : View.Shadow
    , focus : View.Focus
    , last : Int
    , pending : Int
    , urgent : Bool
    , blinkAt : Int
    , syncSince : Int
    , upload : Maybe Upload
    , imagePaste : ImagePaste
    , dropGather : Array Bytes
    , note : Maybe Note
    , uploads : Int
    , title : String
    , closed : Bool
    , lost : Bool
    , out : Outbox
    , preedit : { points : Array Int, feedback : Array Int, caret : Int }
    , imeLog : Bool
    , points : Int
    , charset : Charset
    , decoder : Charset.Decoder
    , replaced : Int
    -- the mouse (docs/phase3-select.md §4): the buttons held, as bits of
    -- Ghostty's numbers; the cell last reported, so a motion within it is
    -- not reported again; whether X sends every motion
    , held : Int
    , mouseLast : Maybe Mouse.Cell
    , allMotion : Bool
    -- every terminal's bells added up when the bell last sounded, so
    -- that a turn whose total rose rings it (docs/sounds.md SN6)
    , bellsHeard : Int
    -- each tab's Program Status Protocol state when last looked at, and
    -- whether the window asked for attention for one (OSC 7501,
    -- docs/claude-code.md CL7)
    , statusSeen : Dict Int String
    , attentionAsked : Bool
    -- when the next desktop notification may be shown (CL8): at most one
    -- every 3 s; -1 any time
    , noticeAt : Int
    -- an OSC 8 link Ctrl+clicked, to open in the turn's end (CL9); and a
    -- file link shown in the note bar, which a second Ctrl+click on it
    -- before `until` opens (review W1)
    , toOpen : Maybe String
    , linkAsked : Maybe { uri : String, until : Int }
    -- the pointer shown (the arrow while the program takes the mouse, a
    -- drag's shape over what is dragged, docs/tmux.md TM38), the pointer's
    -- last place over the window, and whether Shift is held, which takes
    -- the mouse back (docs/phase3-select.md §21)
    , pointerShown : Window.Pointer
    , hover : Maybe Window.PointerEvent
    , shiftHeld : Bool
    -- how many rows the view is scrolled back, 0 at the bottom
    -- (docs/phase3-select.md §11)
    , back : Int
    -- the selection (docs/phase3-select.md §14), the last press of the
    -- left button for double and triple clicks, and a selection to hand
    -- to the window when the event's model is done
    , selection : Maybe Selection
    , clicks : { at : Int, count : Int, cell : Vt.Point }
    , toOwn : Maybe { which : Window.Selection, text : String }
    , wordBoundaries : Array Int
    -- a paste to ask for when the event's model is done, and one under
    -- way: whether it is bracketed, decided by mode 2004 when its first
    -- text comes (docs/phase3-select.md §15)
    , toPaste : Maybe Window.Selection
    , pasting : Maybe Bool
    -- OSC 52 (docs/phase3-select.md §16): requests the core made, to be
    -- done by the loop, and a read under way, its text so far
    , clips : Array Vt.Clip
    , clipRead : Maybe { letter : Int, bel : Bool, text : Bytes }
    -- where the settings came from, and a change to them followed
    -- (docs/settings.md ST3)
    , settings : Settings
    -- with PURITTY_SHOT set, the file each frame's picture is written to,
    -- for the reload gate (harness/reload.py)
    , shotPath : Maybe String
    -- what was wrong in the settings file when it was last read, the
    -- first of it shown in the title (docs/settings.md ST17)
    , troubles : Array String
    -- how Ctrl+Comma starts the settings window (docs/settings.md ST9):
    -- this program's own file, with `settings`, not tied to this one
    , settingsWindow : Maybe { cp : Process.Permission, program : String, args : Array String }
    -- the menu Ctrl+right-click opens, drawn over the screen (ST26), or
    -- the items of the one the platform shows, and of its system menu
    , menu : Maybe Menu
    , shownItems : Array MenuItem
    -- the recent connections the menus offer, read again when the window
    -- gains the focus (docs/settings-gui.md SG19)
    , recents : Array Recent
    -- the folder picker's recent folders, and bookmarks of hosts the
    -- settings have no table for (docs/sftp.md FT32)
    , folders : Folders.Folders
    -- the computer's time zone, for the folder picker's times
    , zone : Time.Zone
    -- the built-in ssh client's session (docs/ssh-client.md SC18): what
    -- puritty's own screen shows until the session runs, a question it
    -- asks, how the session ended
    , ssh : Maybe SshScreen
    -- tmux control mode, when `tmux -CC` runs on the terminal
    -- (docs/tmux.md TM14)
    , tmux : TmuxMode.State
    -- whether the last frame had a question's box over it, so that the
    -- frame it comes or goes in draws every cell (docs/ssh-client.md SC23)
    , overlaid : Bool
    -- scrollback search, while its bar is open, and a drag of the
    -- scrollbar's thumb going on (docs/phase3-select.md §23)
    , search : Maybe Search.State
    , barDrag : Bool
    -- the tabs (docs/tabs.md TB2): the shown one's backend and its tab's
    -- name and marks; the other tabs, each its session's fields, in slots
    -- (`Nothing` a free one) a tab is swapped in and out of; the tabs'
    -- ids in the bar's order, and the shown one's place in it, kept
    -- rather than searched for, so that the order is never empty and a
    -- read at the place needs no default (TB15); the next tab's id; how
    -- a tab is started; and the window's rows, of which the bar takes the
    -- last while it shows
    , remote : Backend
    , tab : TabInfo
    , tabs : Builder (Maybe Tab)
    , order : Array Int
    , shown : Int where 0 <= shown && shown < Array.length order
    , nextTabId : Int
    , starter : Starter
    , windowRows : Int
    , renaming : Maybe { id : Int, typed : String }
    , coloring : Maybe Int
    , closing : Maybe { id : Int, why : String, window : Bool }
    -- a pasted picture waiting for the user's yes before it is written
    -- (docs/sftp.md FT16)
    , pasteAsk : Maybe PasteAsk
    , dropAsk : Maybe { folder : Bytes, files : Array Bytes, tab : Int }
    , choosing : Maybe Choosing
    -- the folder picker's working model, on a pretend host (docs/sftp.md
    -- FT32), and the places it keeps between openings
    , picking : Maybe Picking
    , pickerPlaces : Picker.Places
    , shellHost : Maybe Bytes
    , sending : Maybe Sending.Sending
    , pendingSend : Maybe { folder : Bytes, files : Array Bytes }
    -- why a new tab did not start, said in a box until it is
    -- dismissed (docs/tabs.md TB16)
    , startFailed : Maybe String
    , barClick : { at : Int, id : Int }
    -- the tabs kept to restore (docs/tabs.md TB10): the state directory,
    -- none for a window not kept; this window's files once made; what
    -- was last written; when to look again (-1 never); and whether the
    -- window was closed by its button, which is remembered only when
    -- no other window is open
    , saving : { dir : Maybe Path.Path, window : Maybe Restore.Window, written : String, at : Int }
    , byButton : Bool
    , quietUntil : Int
    -- tabs closed lately, to open again (docs/tabs.md TB11): five
    -- slots, each a tab as it was with where it was and when it closed
    , closedTabs : Builder (Maybe Closed)
    -- the diagnostic log (docs/diagnostics.md DG1): its lines waiting to
    -- be written, the folder its files go in, the time of the turn the
    -- lines are written at, and the tab last said to be shown
    , diag : Diag.Log
    , logDir : Maybe String
    , turnMs : Int
    , loggedTab : Int
    -- the system's clock when the window began, which every time the
    -- window keeps is counted from (`clock`)
    , clockStart : Int64
    -- whether the window is maximized, asked at each resize, and its size
    -- when it last was not, which the next window opens with
    -- (docs/window-state.md WP8)
    , maximized : Bool
    , normalSize : { columns : Int, rows : Int }
    }


{-| A tab closed, kept to open again (docs/tabs.md TB11): the tab as it
was, its program gone; the directory its shell was in, when it was read
before the close; and when it closed. -}
type alias Closed =
    { tab : Tab
    , directory : Maybe Path.Path
    , at : Int
    }


{-| A tab not shown (docs/tabs.md TB2): its backend and its session's own
fields, which `swapTab` exchanges with the model's when it is shown. -}
type alias Tab =
    { info : TabInfo
    , remote : Backend
    , term : Vt.Term
    , charset : Charset
    , decoder : Charset.Decoder
    , replaced : Int
    , out : Outbox
    , back : Int
    , selection : Maybe Selection
    , pasting : Maybe Bool
    , clips : Array Vt.Clip
    , clipRead : Maybe { letter : Int, bel : Bool, text : Bytes }
    , ssh : Maybe SshScreen
    , tmux : TmuxMode.State
    , search : Maybe Search.State
    , syncSince : Int
    , upload : Maybe Upload
    -- files dropped on the tab, on their way to its host, and the folder
    -- chooser for them (docs/sftp.md FT24, FT25, FT26): the tab's, kept
    -- with it when another is shown, since each talks to its own session
    , sending : Maybe Sending.Sending
    , choosing : Maybe Choosing
    -- the host the tab's first OSC 7 named, the login shell's: one naming
    -- another comes from a nested ssh, and its folder is not this host's
    -- (docs/sftp.md FT29)
    , shellHost : Maybe Bytes
    }


{-| A picture pasted into a tab's ssh session (`docs/sftp.md` FT13), on its
way to the host over a channel beside the session: the channel's number,
the picture's size, and what the command on the host wrote and how it
ended. -}
type alias Upload =
    { ref : Int, size : Int, out : Bytes, err : Bytes, status : Maybe Int, asking : Maybe { png : Bytes, name : String } }


{-| A pasted picture to be written once the user says yes
(`[clipboard] paste_images = "ask"`, docs/sftp.md FT16): its bytes, the
path it will have, shown in the question, where it goes, `on` that place
as the question says it, and the tab it was pasted in. -}
type alias PasteAsk =
    { png : Bytes, path : String, to : PasteTo, on : String, tab : Int }


{-| The folder picker's working model (docs/sftp.md FT32): the picker, its
pretend host, the requests not yet given to that host, and how many files
it was opened for. -}
type alias Picking =
    { picker : Picker.Picker, demo : PickerDemo.Demo, queued : Array Picker.Request, count : Int }


{-| The folder chooser for files dropped on an ssh tab (docs/sftp.md
FT24): its SFTP channel's reference, the tab it is for, whether the
channel is opened yet, and the bytes it waits to send. -}
type alias Choosing =
    { ref : Int
    , tab : Int
    , picker : Picker.Picker
    , source : PickerSftp.Source
    , files : Array Bytes
    , opened : Bool
    , toSend : Bytes
    -- a drop on it chose the folder: its channel is closed by `chooserIo`
    , ending : Bool
    -- the host its places are kept for, and its bookmarks when it opened
    , host : FolderHost
    , marks : Array Bytes
    }


{-| A host as the folder picker keeps its folders (docs/sftp.md FT32): a
saved host by its name, whose bookmarks are in its table of the settings;
another, one `puritty ssh` reached, by `user@host:port`, whose are in the
state folder. `key` is how that folder's file names it. -}
type alias FolderHost =
    { key : Folders.Host, saved : Maybe String }


{-| Where an asked-about picture goes: to the ssh host's paste folder,
by the file's name there, or to a file on this computer. -}
type PasteTo
    = ToHost String
    | ToLocal Path.Path


{-| A picture pasted from the clipboard (FT13), gathered as its pieces
come. -}
type ImagePaste
    = NoImagePaste
    | Gathering (Array Bytes)


{-| A line at the window's bottom right saying what puritty did or could
not do (FT13), until `until`, or until it is replaced when `until` is -1.
-}
type alias Note =
    { text : String, failed : Bool, until : Int }


{-| A tab's own: an id the loop's reads are told apart by, the name the
user gave it (empty for none), the host it is a session to, the bells its
terminal had rung when last looked at, and whether it rang or printed
since. -}
type alias TabInfo =
    { id : Int
    , name : String
    , host : Maybe Config.Host
    , hostName : Maybe String
    , color : TabColor
    , bells : Int
    , bell : Bool
    , activity : Bool
    }


{-| How a tab is started: a local program at a size, with the character set
of a local tab; or a session to a host, as the window's first was. -}
type alias Starter =
    { local : { columns : Int, rows : Int, widthInPixels : Int, heightInPixels : Int, directory : Maybe Path.Path } -> Task String Backend
    , ssh : Config.Host -> Task String { remote : Backend, problems : Array String }
    , charset : Charset
    }


{-| puritty's own screen for an ssh session: the host, the command run
there if one was given, what has happened,
the question asked and what has been typed for it, whether the session
runs, why it failed, and its exit status. A question that may be
remembered says whether it is to be (`remember`, the box's checkbox) and
whether a saved answer was refused; `tried` are the names answered from
the store on this connection, `changes` what the store is to get once the
session has logged in (`docs/saved-secrets.md` PW8). -}
type alias SshScreen =
    { host : String
    , command : Maybe String
    , lines : Array String
    , asking : Maybe { ask : Session.Ask, typed : String, given : Array String, offer : Bool, remember : Bool, onCheck : Bool, refused : Bool }
    , started : Bool
    , failed : Maybe String
    , exitStatus : Maybe Int
    , tried : Array String
    , changes : Array Remembered.Change
    }


{-| A menu over the screen: its items, each what this program is started
again with, where its box is, and the item marked. -}
type alias Menu =
    { items : Array MenuItem
    , row : Int
    , col : Int
    , selected : Int
    }


{-| A selection: from `anchor` to `head`, in either order, both included.
`mode` 0 by cells, 1 by words, 2 by lines; a drag by words or lines keeps
the first word or line, `first` to `last`, whichever way it goes. `made`
once the button is let go and its text is the window's PRIMARY; `hashes`
then holds each of its rows on the screen, so that a write over one takes
the highlight away. `alt` is the screen it was made on. -}
type alias Selection =
    { anchor : Vt.Point
    , head : Vt.Point
    , first : Vt.Point
    , last : Vt.Point
    , mode : Int
    , moved : Bool
    , made : Bool
    , alt : Bool
    , hashes : Dict Int Int
    }


type Turn
    = Read Incoming
    | Events Bool
    | Due
    | Writable
    | SettingsChanged (Maybe Directory.Change)
    | Behind { id : Int, incoming : Incoming }
    | BehindWritable Int


{-| The window's clock (`Clock`, RE11): milliseconds since it began
(`clockStart`), starting over every `Clock.period`, so that it never passes
the largest Int however long the machine or the window has been up (RE10).
The system's own counts from an arbitrary moment, since the machine started
on Linux and Windows. -}
clock : Int64 -> Task x Int
clock began =
    clockNow |> Task.map (\t -> Clock.fromSystem (t - began))


clockFrom : Dict String String -> Int
clockFrom vars =
    Dict.get "PURITTY_CLOCK_START" vars
        |> Maybe.andThen String.toInt
        |> Maybe.withDefault (meant Reason.NotSet 0)


clockNow : Task x Int64
clockNow =
    Time.monotonic |> Task.map Time.inMilliseconds


type Command
    = Run { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String, tryPicker : Bool }


{-| What the first word asked for (`docs/settings.md` ST11, V64): nothing
(the settings' `start`), a local shell, or a quick connect. -}
type Mode
    = Plain
    | Shell
    | Ssh String
    | HostList
    | RestoreOne


cli : Argparse.Parser.Command (Array String) { config : Maybe Path.Path, title : Maybe String, host : Maybe String, tryPicker : Bool } Command
cli =
    { word = ""
    , arguments =
        Argparse.Parser.zeroOrMoreArgs
            { value = { label = "program", fn = Just, examples = [ "htop", "vim notes.txt" ] }
            , help = "The program to run, and its arguments; $SHELL (on Windows PowerShell) when none is given"
            }
    , flags =
        Argparse.Parser.initFlags (\config title host tryPicker -> { config = config, title = title, host = host, tryPicker = tryPicker })
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "config") (Argparse.Parser.pathParser Path.fromString) "The settings file, instead of ~/.config/puritty/config.toml (on Windows %APPDATA%\\puritty\\config.toml)"
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "title") Argparse.Parser.stringParser "The window's title while the program has set none"
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "host") Argparse.Parser.stringParser "A host of the settings, connected to with ssh; a name they do not have is ssh's own (an alias of ~/.ssh/config)"
            |> Argparse.Parser.toggle (Argparse.Parser.LongOnly "try-folder-picker") "The folder picker's working model, on a pretend host: drop files on the window to open it again"
    , commonDescription = Nothing
    , summary = "Runs a program on a terminal in an X window:"
    , example = PP.words "puritty --title notes -- vim -O a.txt b.txt"
    , builder = \program flags -> Run { config = flags.config, title = flags.title, host = flags.host, program = program, tryPicker = flags.tryPicker }
    }


main : Task Never {}
main =
    Os.Env.getEnvironment
        |> Task.andThen
            (\env ->
                -- `puritty settings`: the settings window, a process of its
                -- own (docs/settings.md ST2, V57); `puritty -- settings`
                -- runs a program of that name
                when Array.first env.args is
                    Just "settings" ->
                        settingsMain { env | args = Array.dropFirst 1 env.args }

                    -- `puritty shell`: a local shell, whatever `start` says
                    Just "shell" ->
                        terminalMain Shell { env | args = Array.dropFirst 1 env.args }

                    -- `puritty restore`: one saved window opened again, or
                    -- none when none waits (docs/tabs.md TB10)
                    Just "restore" ->
                        terminalMain RestoreOne { env | args = Array.dropFirst 1 env.args }

                    -- `puritty hosts`: the host list, which a session replaces
                    Just "hosts" ->
                        terminalMain HostList { env | args = Array.dropFirst 1 env.args }

                    -- `puritty ssh user@host:port`: quick connect
                    Just "ssh" ->
                        when Array.get 1 env.args is
                            Just target ->
                                terminalMain (Ssh target) { env | args = Array.dropFirst 2 env.args }

                            Nothing ->
                                meant Reason.FromOutside
                                    Console.writeErr "puritty ssh: give where to connect, as user@host:port\n"
                                        |> Task.andThen (\_ -> Os.Env.exitWithCode 2)

                    _ ->
                        meant Reason.NotSet terminalMain Plain env
            )


{-| puritty's version: what `--version` and XTVERSION say. A release's tag
must be it (`scripts/prerelease.sh` refuses one that is not; 0.1.1 went
out saying 0.1.0, `docs/releasing.md` RL10). -}
purittyVersion : String
purittyVersion =
    "0.2.1"


settingsMain : Os.Env.Environment -> Task Never {}
settingsMain env =
    Argparse.Program.runRootWithContext env
        { name = "puritty settings"
        , version = purittyVersion
        , command = settingsCli
        , init =
            \_ ->
                Task.map3 (\cp fs more -> { cp = cp, fs = fs, vars = more.vars, self = more.self })
                    Process.initialize
                    File.initialize
                    (Task.map2 (\vars self -> { vars = vars, self = self })
                        Os.Env.getEnvironmentVariables
                        (Os.Env.executable |> Task.map Just |> Task.onError (\_ -> Task.succeed Nothing))
                    )
        , onCommand =
            \_ ctx (Settings asked) ->
                SettingsProgram.run
                    { fs = ctx.fs
                    , vars = ctx.vars
                    , config = asked
                    , launcher = False
                    , opener = Maybe.map (\self -> { cp = ctx.cp, program = Path.toString self, config = Maybe.map Path.toString asked }) ctx.self
                    }
                    |> Task.map (\_ -> {})
                    |> Task.mapError (\why -> Argparse.Program.ExitMessageValue { message = "puritty settings: " ++ why, value = 2 })
        }


type SettingsCommand
    = Settings (Maybe Path.Path)


settingsCli : Argparse.Parser.Command {} (Maybe Path.Path) SettingsCommand
settingsCli =
    { word = ""
    , arguments = Argparse.Parser.noArgs
    , flags =
        Argparse.Parser.initFlags identity
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "config") (Argparse.Parser.pathParser Path.fromString) "The settings file, instead of ~/.config/puritty/config.toml (on Windows %APPDATA%\\puritty\\config.toml)"
    , commonDescription = Nothing
    , summary = "Opens the settings window, whose changes every puritty window takes at once:"
    , example = PP.words "puritty settings"
    , builder = \_ config -> Settings config
    }


terminalMain : Mode -> Os.Env.Environment -> Task Never {}
terminalMain mode env =
    Argparse.Program.runRootWithContext env
        { name = "puritty"
        , version = purittyVersion
        , command = cli
        , init =
            \_ ->
                Task.map3 (\cp fs vars -> { cp = cp, fs = fs, vars = vars }) Process.initialize File.initialize Os.Env.getEnvironmentVariables
        , onCommand =
            \_ ctx (Run asked) ->
                let
                    given =
                        { file = settingsFile ctx.vars asked.config
                        , fs = ctx.fs
                        , title = asked.title
                        , program = asked.program
                        , tryPicker = asked.tryPicker
                        }
                in
                readSettings given
                    |> Task.andThen
                        (\read ->
                            let
                                got =
                                    when read is
                                        Gave r ->
                                            r

                                        Unread why ->
                                            { config = overridden given Config.defaults, problems = [ why ++ "; the defaults are used" ] }

                                chosen =
                                    choose mode asked got.config

                                listing =
                                    Array.isEmpty asked.program
                                        && asked.host == Nothing
                                        && (mode == HostList || (mode == Plain && got.config.start == "hosts"))

                                -- the state directory, for a window whose tabs can
                                -- be restored: not one started with a program
                                -- (docs/tabs.md TB10)
                                stateDir =
                                    if Array.isEmpty asked.program then
                                        Maybe.map Path.fromString (Platform.stateDirectory ctx.vars)

                                    else
                                        Nothing

                                -- a plain start with restoring on, or `puritty
                                -- restore`, claims a saved window
                                claiming =
                                    when stateDir is
                                        Just dir ->
                                            if asked.host == Nothing && (mode == RestoreOne || (mode == Plain && got.config.tabsRestore)) then
                                                Restore.claim ctx.fs dir

                                            else
                                                Task.succeed Nothing

                                        Nothing ->
                                            meant Reason.NotSet Task.succeed Nothing
                            in
                            claiming
                                |> Task.andThen
                                    (\claimed ->
                                        when claimed is
                                            Just c ->
                                                say got.problems
                                                    |> Task.andThen (\_ -> start ctx.cp ctx.vars given got.problems (restoredConfig c.state got.config) { dir = stateDir, claimed = Just c })

                                            Nothing ->
                                                meant Reason.NoMore
                                                    if mode == RestoreOne then
                                                        -- none waits: nothing to open
                                                        Task.succeed {}

                                                    else if listing then
                                                        hostList ctx.cp ctx.fs ctx.vars given asked got

                                                    else
                                                        when chosen.config is
                                                            Err why ->
                                                                meant Reason.FromOutside Task.fail why

                                                            Ok config ->
                                                                say (got.problems ++ chosen.problems)
                                                                    |> Task.andThen (\_ -> rememberStart ctx.fs (Maybe.map RecentFile.folder (Platform.stateDirectory ctx.vars)) config (recentOf mode asked config))
                                                                    |> Task.andThen (\_ -> start ctx.cp ctx.vars given (got.problems ++ chosen.problems) config { dir = stateDir, claimed = Nothing })
                                    )
                        )
                    |> Task.mapError (\why -> Argparse.Program.ExitMessageValue { message = "puritty: " ++ why, value = 2 })
        }


{-| How a window's tabs are kept to restore (docs/tabs.md TB10): the
state directory, none for a window that is not kept, and the saved window
this one opens again, if it does. -}
type alias Restoring =
    { dir : Maybe Path.Path
    , claimed : Maybe { window : Restore.Window, state : RestoreFile.State }
    }


{-| The settings a restored window starts with: its host's session, as
`--host` gives, and its size. -}
restoredConfig : RestoreFile.State -> Config -> Config
restoredConfig state config =
    let
        base =
            when state.host is
                Just name ->
                    Hosts.session config
                        (if Array.any (\h -> h.name == name) config.hosts then
                            Hosts.named name config

                         else
                            Hosts.quick name |> Maybe.withDefault (meant Reason.NotKnown Hosts.named name config)
                        )

                Nothing ->
                    meant Reason.NotSet config
    in
    { base | columns = clamp 10 1000 state.columns, rows = clamp 3 1000 state.rows }


{-| The connection a window starts as, kept among the recent ones the host
list offers (`docs/settings-gui.md` SG14): what `puritty ssh` was given, a
host `--host` or `start` names; none for a shell or a program. -}
recentOf : Mode -> { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String, tryPicker : Bool } -> Config -> Maybe Recent
recentOf mode asked config =
    if not (Array.isEmpty asked.program) then
        Nothing

    else
        when mode is
            Ssh target ->
                Just (Recent.Quick (String.trim target))

            Plain ->
                when asked.host is
                    Just name ->
                        Just (Recent.Saved name)

                    Nothing ->
                        meant Reason.NotSet
                            (if String.startsWith "host:" config.start then
                                Just (Recent.Saved (String.dropFirst 5 config.start))

                             else
                                Nothing
                            )

            _ ->
                Nothing


rememberStart : File.Permission -> Maybe Path.Path -> Config -> Maybe Recent -> Task x {}
rememberStart fs dir config recent =
    when { dir = dir, recent = recent } is
        { dir = Just d, recent = Just r } ->
            RecentFile.remember fs d config.recentConnections r

        _ ->
            Task.succeed {}


{-| What the window runs (`docs/settings.md` ST11, V64): a program on the
command line, else what the first word or `--host` asked, else what
`start` says. A host's session takes its look and title (`Hosts.session`),
under `--title` when one is given. -}
choose : Mode -> { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String, tryPicker : Bool } -> Config -> { config : Result String Config, problems : Array String }
choose mode asked config =
    let
        titled c =
            { c | title = Maybe.withDefault (meant Reason.NotSet c.title) asked.title }

        to h =
            { config = Ok (titled (Hosts.session config h)), problems = [] }
    in
    if not (Array.isEmpty asked.program) then
        { config = Ok config, problems = [] }

    else
        when mode is
            Shell ->
                { config = Ok config, problems = [] }

            Ssh target ->
                when Hosts.quick target is
                    Just h ->
                        to h

                    Nothing ->
                        meant Reason.FromOutside { config = Err ("\"" ++ target ++ "\" is not where to connect, as user@host:port"), problems = [] }

            Plain ->
                when asked.host is
                    Just name ->
                        to (Hosts.named name config)

                    Nothing ->
                        meant Reason.NotSet
                            if String.startsWith "host:" config.start then
                                to (Hosts.named (String.dropFirst 5 config.start) config)

                            else
                                { config = Ok config, problems = [] }

            HostList ->
                { config = Ok config, problems = [] }

            RestoreOne ->
                -- only a claimed window starts, from its own settings
                { config = Ok config, problems = [] }


{-| The host list (V64, V65): the settings window on its Hosts page, whose
Connect makes the same window the host's session, its font the host's. -}
hostList : Process.Permission -> File.Permission -> Dict String String -> Given -> { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String, tryPicker : Bool } -> { config : Config, problems : Array String } -> Task String {}
hostList cp fs vars given asked got =
    SettingsProgram.run { fs = fs, vars = vars, config = asked.config, launcher = True, opener = Nothing }
        |> Task.andThen
            (\outcome ->
                when outcome is
                    SettingsProgram.Closed ->
                        Task.succeed {}

                    SettingsProgram.Session h ->
                        becomeSession cp fs vars given asked got (Hosts.session got.config h)

                    SettingsProgram.LocalShell ->
                        -- the local shell the list offers (SG15)
                        becomeSession cp fs vars given asked got got.config
            )


{-| The host list's window becoming the session chosen in it, a host's or
the local shell: its font, the session's size or the last window's,
maximized as it was (WP8), and the session begun. -}
becomeSession : Process.Permission -> File.Permission -> Dict String String -> Given -> { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String, tryPicker : Bool } -> { config : Config, problems : Array String } -> Config -> Task String {}
becomeSession cp fs vars given asked got chosen =
    let
        config =
            { chosen | title = Maybe.withDefault (meant Reason.NotSet chosen.title) asked.title }
    in
    Platform.locale vars
        |> Task.andThen
            (\locale ->
                Window.setFont { font = config.font, lang = Maybe.withDefault (meant Reason.NotSet locale.language) config.language, points = config.points, glyphCap = config.glyphCacheMb * 1024 * 1024 }
                    |> Task.andThen
                        (\done ->
                            when done is
                                Ok cell ->
                                    -- the host list's window, the settings
                                    -- window's shape, becomes a terminal's
                                    -- (SG11)
                                    lastWindow fs vars { dir = Nothing, claimed = Nothing }
                                        |> Task.andThen
                                            (\last ->
                                                let
                                                    sized =
                                                        when last is
                                                            Just l ->
                                                                { config | columns = l.columns, rows = l.rows }

                                                            Nothing ->
                                                                -- the first window: the settings' size
                                                                meant Reason.NotSet config
                                                in
                                                -- the terminal's gap around its cells, which the
                                                -- settings window has none of (docs/renderer.md R20),
                                                -- before the size, which counts it
                                                Window.setPadding { x = sized.padding, y = sized.paddingVertical }
                                                    |> Task.andThen (\_ -> Window.resize { cols = sized.columns, rows = sized.rows })
                                                    |> Task.andThen (\_ -> Window.setMaximized (Maybe.map .maximized last |> Maybe.withDefault (meant Reason.NotSet False)))
                                                    |> Task.andThen (\_ -> Text.ligatures sized.ligatures)
                                                    |> Task.andThen (\_ -> begin cp vars given got.problems locale sized cell { dir = Nothing, claimed = Nothing })
                                            )

                                Err why ->
                                    meant Reason.Refused Task.fail ("cannot open the session's font: " ++ why)
                        )
            )


start : Process.Permission -> Dict String String -> Given -> Array String -> Config -> Restoring -> Task String {}
start cp vars given problems config restoring =
    Platform.locale vars
        |> Task.andThen (\locale -> startIn cp vars given problems locale config restoring)


startIn : Process.Permission -> Dict String String -> Given -> Array String -> Platform.Locale -> Config -> Restoring -> Task String {}
startIn cp vars given problems locale config0 restoring =
    lastWindow given.fs vars restoring
        |> Task.andThen
            (\last ->
                let
                    -- the last window's normal size and state (WP8); a
                    -- restored window's own, which restoredConfig gave
                    config =
                        when { last = last, claimed = restoring.claimed } is
                            { last = Just l, claimed = Nothing } ->
                                { config0 | columns = l.columns, rows = l.rows }

                            _ ->
                                -- the first window, or a restored one's own
                                config0

                    maximized =
                        when restoring.claimed is
                            Just c ->
                                c.state.maximized

                            Nothing ->
                                -- not a restored window: the last one's state
                                meant Reason.NotSet (Maybe.map .maximized last |> Maybe.withDefault (meant Reason.NotSet False))
                in
                Window.startMaximized maximized
                    |> Task.andThen (\_ -> openWindow cp vars given problems locale config restoring)
            )


openWindow : Process.Permission -> Dict String String -> Given -> Array String -> Platform.Locale -> Config -> Restoring -> Task String {}
openWindow cp vars given problems locale config restoring =
    Window.open
        { cols = config.columns
        , rows = config.rows
        , font = config.font
        , points = config.points
        , lang = Maybe.withDefault (meant Reason.NotSet locale.language) config.language
        , glyphCap = config.glyphCacheMb * 1024 * 1024
        , title = config.title
        , padding = { x = config.padding, y = config.paddingVertical }
        }
        |> Task.andThen
            (\opened ->
                when opened is
                    Err why ->
                        meant Reason.Refused Task.fail ("cannot open the window: " ++ why)

                    Ok cell ->
                        Text.ligatures config.ligatures
                            |> Task.andThen (\_ -> begin cp vars given problems locale config cell restoring)
            )


{-| Where the last window's state is kept: puritty's state folder, which
holds the logs' folder (WP8). -}
lastWindowFile : Maybe String -> Maybe Path.Path
lastWindowFile logDir =
    Maybe.map (\folder -> Path.append (Path.fromString LastWindow.fileName) folder) (stateFolder logDir)


stateFolder : Maybe String -> Maybe Path.Path
stateFolder logDir =
    Maybe.map (\d -> Path.fromString (String.dropLast (String.count "logs") d)) logDir


{-| How the last window was when it closed, unless this one is restored
with its own; none the first time. -}
lastWindow : File.Permission -> Dict String String -> Restoring -> Task x (Maybe LastWindow.Last)
lastWindow fs vars restoring =
    when { file = lastWindowFile (Platform.logDirectory vars), claimed = restoring.claimed } is
        { file = Just file, claimed = Nothing } ->
            File.readFile fs file
                |> Task.map (\b -> Bytes.toString b |> Maybe.andThen LastWindow.fromText)
                |> Task.onError (\_ -> Task.succeed Nothing)

        _ ->
            Task.succeed Nothing


{-| The window's state written for the next window: maximized or not, and
its normal size (WP8); nothing said when it cannot be. -}
rememberWindow : (taken m : Model) -> Task Error Model
rememberWindow m =
    when stateFolder m.logDir is
        Just folder ->
            let
                fs =
                    m.settings.given.fs

                text =
                    LastWindow.toText { maximized = m.maximized, columns = m.normalSize.columns, rows = m.normalSize.rows }
            in
            Directory.createAll fs folder
                |> Task.andThen (\_ -> File.writeFile fs (Bytes.fromString text) (Path.append (Path.fromString LastWindow.fileName) folder))
                |> Task.map (\_ -> {})
                |> Task.onError (\_ -> Task.succeed {})
                |> Task.map (\_ -> m)

        Nothing ->
            -- no state folder (no HOME or LOCALAPPDATA): nothing kept
            meant Reason.NotSet Task.succeed m


{-| A session in the window, open with this cell: the program started on a
terminal of its size, and the loop. -}
begin : Process.Permission -> Dict String String -> Given -> Array String -> Platform.Locale -> Config -> Window.Cell -> Restoring -> Task String {}
begin cp vars given problems locale config cell restoring =
    let
        -- the command, or the platform's programs, the
        -- first of them that starts
        commands =
            if Array.isEmpty config.command then
                Array.map (\program -> [ program ]) (Platform.programs vars)

            else
                [ config.command ]

        options =
            -- the pty's IUTF8 says whether the program's bytes are UTF-8;
            -- a restored local tab in its directory (TB10)
            Process.defaultSpawnOptions (Terminal { columns = config.columns, rows = config.rows, widthInPixels = pixelsOf config.columns cell.width, heightInPixels = pixelsOf config.rows cell.height, utf8 = charset == Charset.Utf8 })
                |> (\o -> { o | workingDirectory = firstDirectory restoring })

        charset =
            Charset.fromName (Maybe.withDefault (meant Reason.NotSet locale.charset) config.charset)
    in
    Task.map2 (\events self -> { events = events, self = self })
        (watchSettings given)
        (Os.Env.executable |> Task.map Just |> Task.onError (\_ -> Task.succeed Nothing))
        |> Task.andThen
            (\w ->
                let
                    opener =
                        Maybe.map
                            (\self ->
                                { cp = cp
                                , program = Path.toString self
                                , args =
                                    when given.file is
                                        Just f ->
                                            if f.required then
                                                [ "settings", "--config", Path.toString f.path ]

                                            else
                                                [ "settings" ]

                                        Nothing ->
                                            meant Reason.NotSet [ "settings" ]
                                }
                            )
                            w.self
                in
                (when config.remote is
                    Just host ->
                        sshBackend vars config cell charset host

                    Nothing ->
                        meant Reason.NotSet
                            ptyBackend cp vars config commands { options | environmentVariables = Process.MergeWithEnvironmentVariables (Dict.set "FORCE_HYPERLINK" "1" (Dict.set "COLORTERM" "truecolor" (Dict.set "TERM" "xterm-256color" Dict.empty))) }
                                |> Task.map (\remote -> { remote = remote, problems = [] })
                )
                    |> Task.andThen
                        (\started ->
                            let
                                -- how a new tab starts (docs/tabs.md TB1): the
                                -- program at the window's size, or another
                                -- session to the host
                                localCharset =
                                    Charset.fromName (Maybe.withDefault (meant Reason.NotSet locale.charset) config.charset)

                                starter =
                                    { local =
                                        \size ->
                                            ptyBackend cp
                                                vars
                                                config
                                                commands
                                                (Process.defaultSpawnOptions (Terminal { columns = size.columns, rows = size.rows, widthInPixels = size.widthInPixels, heightInPixels = size.heightInPixels, utf8 = localCharset == Charset.Utf8 })
                                                    |> (\o -> { o | workingDirectory = size.directory, environmentVariables = Process.MergeWithEnvironmentVariables (Dict.set "FORCE_HYPERLINK" "1" (Dict.set "COLORTERM" "truecolor" (Dict.set "TERM" "xterm-256color" Dict.empty))) })
                                                )
                                    , ssh = \host -> sshBackend vars config cell charset host
                                    , charset = localCharset
                                    }
                            in
                            run (Dict.member "PURITTY_IME_LOG" vars) (Dict.get "PURITTY_SHOT" vars) (clockFrom vars) charset config cell started.remote starter { given = given, locale = locale, events = w.events, at = -1 } (problems ++ started.problems) opener restoring (Platform.logDirectory vars)
                        )
            )


{-| The built-in ssh client's session to a host (`docs/ssh-client.md`
SC18): its options from `~/.ssh/config` with the host entry's over them,
the home, the local user and the agent's socket from the environment. -}
sshBackend : Dict String String -> Config -> Window.Cell -> Charset -> Config.Host -> Task String { remote : Backend, problems : Array String }
sshBackend vars config cell charset host =
    -- the host's command in its character set (docs/sftp.md FT20)
    (when host.command is
        Just text ->
            when inHostCharset (Maybe.withDefault (meant Reason.NotSet charset) (Maybe.map Charset.fromName host.charset)) text is
                Just bytes ->
                    Task.succeed (Just bytes)

                Nothing ->
                    meant Reason.FromOutside (Task.fail ("the host's command has characters " ++ charsetName (Maybe.withDefault (meant Reason.NotSet charset) (Maybe.map Charset.fromName host.charset)) ++ " cannot write"))

        Nothing ->
            meant Reason.NotSet (Task.succeed Nothing)
    )
        |> Task.andThen (\command -> Task.map2 (\net fs -> { permissions = { net = net, fs = fs }, command = command }) Net.initialize File.initialize)
        |> Task.andThen
            (\given ->
                let
                    permissions =
                        given.permissions

                    -- an empty local user is let through: the host, the
                    -- config or a Match may give the user, and one that
                    -- is still empty is refused below
                    localUser =
                        Dict.get "USER" vars |> Maybe.withDefault (meant Reason.FromOutside Dict.get "USERNAME" vars |> Maybe.withDefault (meant Reason.FromOutside ""))
                in
                homeOf vars
                    |> Task.andThen
                        (\home ->
                            SshAgents.agents vars
                                |> Task.andThen
                                    (\agents ->
                                        Session.optionsFor permissions
                                            { host = host.host
                                            , user = host.user
                                            , port = host.port
                                            , identity = host.identity
                                            , jump = Hosts.jumpSpec config host
                                            , command = given.command
                                            , home = home
                                            , localUser = localUser
                                            , environment = vars
                                            , agents = agents
                                            , terminal = Just { term = "xterm-256color", columns = config.columns, rows = config.rows, widthInPixels = pixelsOf config.columns cell.width, heightInPixels = pixelsOf config.rows cell.height, utf8 = charset == Charset.Utf8 }
                                            }
                                            |> Task.andThen
                                                (\resolved ->
                                                    if Array.any (\o -> o.user == "") (Array.pushFirst resolved.options resolved.jumps) then
                                                        Task.fail "no user to log in as: the host gives none, nor does ~/.ssh/config, and neither USER nor USERNAME is set"

                                                    else
                                                        Backend.ssh permissions { options = resolved.options, jumps = resolved.jumps }
                                                            |> Task.map (\remote -> { remote = remote, problems = Array.map (\p -> "~/.ssh/config: " ++ p) resolved.problems })
                                                )
                                    )
                        )
            )


{-| The home the ssh client finds `~/.ssh` in: `HOME`, or Windows'
`USERPROFILE`; with neither, the connection is refused, since `~/.ssh`
would be read from the root. -}
homeOf : Dict String String -> Task String String
homeOf vars =
    let
        set name =
            Dict.get name vars
                |> Maybe.andThen
                    (\v ->
                        if v == "" then
                            Nothing

                        else
                            Just v
                    )
    in
    when set "HOME" is
        Just home ->
            Task.succeed home

        Nothing ->
            meant Reason.FromOutside
                when set "USERPROFILE" is
                    Just home ->
                        Task.succeed home

                    Nothing ->
                        meant Reason.FromOutside (Task.fail "neither HOME nor USERPROFILE is set, so ~/.ssh cannot be found")


{-| A program on a terminal as its tab's backend; for a host of OpenSSH's
`ssh` on Linux, with side channels through its connection (`controlled`,
docs/sftp.md FT31). -}
ptyBackend : Process.Permission -> Dict String String -> Config -> Array (Array String) -> Process.SpawnOptions -> Task String Backend
ptyBackend cp vars config commands options =
    controlled cp vars config commands
        |> Task.mapError Os.Error.toString
        |> Task.andThen
            (\c ->
                spawnFirst cp c.commands options
                    |> Task.mapError Os.Error.toString
                    |> Task.andThen
                        (\child ->
                            when Backend.pty child is
                                Nothing ->
                                    -- started with no terminal, which a spawn with one never is
                                    meant Reason.FromOutside (Task.fail "the program has no terminal")

                                Just remote ->
                                    when c.via is
                                        Just via ->
                                            Backend.withSshHelpers cp via remote

                                        Nothing ->
                                            -- a program on this computer, or ssh on Windows
                                            meant Reason.NotSet (Task.succeed remote)
                        )
            )


{-| The command of a tab of a host that OpenSSH's `ssh` connects to (FT31),
made a `ControlMaster` on a socket of puritty's, one a tab, so that files
can go through its connection with no second login; and the options of
the helpers that do. A host whose own `~/.ssh/config` sets a master up
already (`ssh -G` says `controlmaster` is not `no`, and a `controlpath`)
keeps it: the helpers go through the user's socket, and the tab is not
changed, since another socket would be a second login, a second factor
included. Not on Windows, whose OpenSSH has no `ControlMaster`; not for a
program that is not a host's `ssh`. -}
controlled : Process.Permission -> Dict String String -> Config -> Array (Array String) -> Task Os.Error.Error { commands : Array (Array String), via : Maybe { options : Array Bytes, host : Bytes } }
controlled cp vars config commands =
    let
        host =
            config.hostName |> Maybe.andThen (\n -> Array.findFirst (\h -> h.name == n) config.hosts |> Maybe.map .value)

        none =
            Task.succeed { commands = commands, via = Nothing }
    in
    when { host = host, first = Array.first commands } is
        { host = Just h, first = Just command } ->
            if Platform.pathSeparator == "\\" || Maybe.isJust config.remote || Array.first command /= Just "ssh" then
                none

            else
                let
                    options =
                        Hosts.sshOptions config h

                    shared =
                        [ "-o", "ControlMaster=no", "-o", "BatchMode=yes" ]
                in
                Process.run cp "ssh" ([ "-G" ] ++ options ++ [ h.host ]) Process.defaultRunOptions
                    |> Task.map (\r -> userMaster (Bytes.toStringLossy r.stdout))
                    |> Task.onError (\_ -> Task.succeed False)
                    |> Task.andThen
                        (\own ->
                            if own then
                                Task.succeed { commands = commands, via = Just { options = Array.map Bytes.fromString (shared ++ options), host = Bytes.fromString h.host } }

                            else
                                Os.Random.bytes 5
                                    |> Task.map
                                        (\random ->
                                            let
                                                name =
                                                    "/puritty-" ++ Bytes.toHexString { padding = False } random

                                                -- OpenSSH adds 17 characters to the path while it
                                                -- makes the socket, and Linux takes 108 in all
                                                -- (FT11): a runtime folder too deep for that, /tmp
                                                socket =
                                                    when Dict.get "XDG_RUNTIME_DIR" vars is
                                                        Just dir ->
                                                            if String.count dir + String.count name > 88 then
                                                                "/tmp" ++ name

                                                            else
                                                                dir ++ name

                                                        Nothing ->
                                                            meant Reason.NotSet ("/tmp" ++ name)
                                            in
                                            { commands = [ [ "ssh", "-o", "ControlMaster=auto", "-o", "ControlPath=" ++ socket, "-o", "ControlPersist=no" ] ++ Array.dropFirst 1 command ]
                                            , via = Just { options = Array.map Bytes.fromString ([ "-S", socket ] ++ shared ++ options), host = Bytes.fromString h.host }
                                            }
                                        )
                        )

        _ ->
            none


{-| Whether `ssh -G`'s answer has the user's own master: `controlmaster`
not `no` or `false`, and a `controlpath` not `none`. -}
userMaster : String -> Bool
userMaster said =
    let
        value name =
            String.lines said
                |> Array.findFirst (\l -> String.startsWith (name ++ " ") l)
                |> Maybe.map (\f -> String.trim (String.dropFirst (String.count name + 1) f.value))
    in
    when { master = value "controlmaster", path = value "controlpath" } is
        { master = Just m, path = Just p } ->
            m /= "no" && m /= "false" && p /= "none" && p /= ""

        _ ->
            False


{-| The first of the commands that starts: one that is not found gives way
to the next, and the last one's failure is the answer. -}
spawnFirst : Process.Permission -> Array (Array String) -> Process.SpawnOptions -> Task Os.Error.Error Process.Child
spawnFirst cp commands options =
    when Array.popFirst commands is
        Nothing ->
            meant Reason.NoMore Task.fail { kind = Os.Error.NotFound, operation = "spawn", path = Nothing, detail = "no program to run" }

        Just { first, rest } ->
            Process.spawn cp (Maybe.withDefault (meant Reason.NotSet "") (Array.first first)) (Array.dropFirst 1 first) options
                |> Task.onError
                    (\err ->
                        if err.kind == Os.Error.NotFound && not (Array.isEmpty rest) then
                            spawnFirst cp rest options

                        else
                            Task.fail err
                    )


{-| `imeLog`: with `PURITTY_IME_LOG` set, each commit and each change to
the preedit is written to standard output, for the IME gate
(`harness/ime.py`, V45). `shotPath`: with `PURITTY_SHOT` set, each frame
drawn is written to its file as a picture, for the reload gate
(`harness/reload.py`). `startAt`: the clock's first reading, 0 unless
`PURITTY_CLOCK_START` says, so that a test can start it just before it
starts over (RE11). -}
run : Bool -> Maybe String -> Int -> Charset -> Config -> Window.Cell -> Backend -> Starter -> Settings -> Array String -> Maybe { cp : Process.Permission, program : String, args : Array String } -> Restoring -> Maybe String -> Task String {}
run imeLog shotPath startAt charset config cell remote starter settings problems opener restoring logDir =
    -- the recent connections, for the menus and the taskbar's jump list
    -- (docs/settings-gui.md SG19), this window's own among them
    loadRecents settings.given.fs logDir config
        |> Task.andThen
            (\recents ->
                RecentFile.jumpList recents
                    -- the folder picker's recent folders and bookmarks
                    -- (docs/sftp.md FT32)
                    |> Task.andThen
                        (\jumped ->
                            (when stateFolder logDir is
                                Just dir ->
                                    FolderFile.load settings.given.fs dir

                                Nothing ->
                                    meant Reason.NotSet (Task.succeed Folders.none)
                            )
                                -- the folder picker's times in the computer's zone
                                |> Task.andThen (\folders -> Time.here |> Task.map (\zone -> { folders = folders, zone = zone }))
                                |> Task.andThen (\got -> runWith { recents = recents, jumped = jumped, folders = got.folders, zone = got.zone } imeLog shotPath startAt charset config cell remote starter settings problems opener restoring logDir)
                        )
            )


{-| The recent connections in the state folder, as many as the settings
keep (`[connections] recent`); none without a state folder. -}
loadRecents : File.Permission -> Maybe String -> Config -> Task x (Array Recent)
loadRecents fs logDir config =
    when stateFolder logDir is
        Just dir ->
            RecentFile.load fs dir |> Task.map (Array.takeFirst (max 0 config.recentConnections))

        Nothing ->
            meant Reason.NotSet Task.succeed []


{-| The jump list not taken, said in the diagnostic log with Windows'
reason, an HRESULT (E_ACCESSDENIED, 0x80070005, when Windows is set not
to show recently opened items). -}
noteJumpList : Int -> (taken m : Model) -> Model
noteJumpList code m =
    if code == 0 then
        m

    else
        logLine "window" ("the jump list was not taken: HRESULT 0x" ++ hex8 code) m


{-| A 32-bit value in eight hexadecimal digits, as Windows writes an
HRESULT. -}
hex8 : Int -> String
hex8 n =
    Array.range 0 7
        |> Array.map
            (\i ->
                let
                    digit =
                        Bitwise.and 15 (Bitwise.shiftRightZfBy (4 * (7 - i)) n)
                in
                String.slice digit (digit + 1) "0123456789ABCDEF"
            )
        |> String.join ""


runWith : { recents : Array Recent, jumped : Int, folders : Folders.Folders, zone : Time.Zone } -> Bool -> Maybe String -> Int -> Charset -> Config -> Window.Cell -> Backend -> Starter -> Settings -> Array String -> Maybe { cp : Process.Permission, program : String, args : Array String } -> Restoring -> Maybe String -> Task String {}
runWith started imeLog shotPath startAt charset config cell remote starter settings problems opener restoring logDir =
    -- puritty's own text (its questions, the search bar, the tab
    -- bar) in the interface font, as the settings window's is, apart
    -- from the terminal's (docs/tabs.md TB5)
    Text.interfaceFont Platform.interfaceFont
        -- the system menu's items, where the platform has one (ST26)
        |> Task.andThen (\_ -> Window.systemMenu (Array.map .label (menuItems config started.recents)))
        -- this window counted among those open, a session begun when it is
        -- the only one (SG16)
        |> Task.andThen (\_ -> sessionMark SessionFile.begin settings.given.fs logDir)
        |> Task.andThen (\_ -> clockNow)
        |> Task.andThen
            (\began ->
                let
                    t0 =
                        Clock.after 0 startAt
                in
                restoreInto restoring
                    ({ config = config
                     , look = { foreground = config.foreground, background = config.background, boldIsBright = config.boldIsBright }
                     , term =
                        Vt.new
                            { cols = config.columns
                            , rows = config.rows
                            , scrollbackBytes = Vt.scrollbackBytesFor { cols = config.columns, rows = config.scrollbackLines }
                            , pageRows = Vt.defaultPageRows
                            , checksums = False
                            , cellWidth = cell.width
                            , cellHeight = cell.height
                            }
                            |> Vt.withPalette config.palette
                            |> Vt.withEmbedder (embedderOf config)
                            |> Vt.withImageLimit imageLimit
                            -- what was wrong in the settings, before the
                            -- program's first output (settings-ui.md §5)
                            |> Vt.feed (Bytes.fromString (String.join "" (Array.map notice problems)))
                     , shadow = View.shadow config.columns config.rows
                     , focus = View.focused
                     , last = t0
                     , pending = -1
                     , urgent = True
                     , blinkAt = -1
                     , syncSince = -1
                     , upload = Nothing
                     , imagePaste = NoImagePaste
                     , dropGather = []
                     , note = Nothing
                     , uploads = 0
                     , title = ""
                     , closed = False
                     , lost = False
                     , out = Outbox.empty
                     , preedit = { points = [], feedback = [], caret = 0 }
                     , imeLog = imeLog
                     , points = config.points
                     , charset = charset
                     , decoder = Charset.decoder
                     , replaced = 0
                     , held = 0
                     , mouseLast = Nothing
                     , allMotion = False
                     , bellsHeard = 0
                     , statusSeen = Dict.empty
                     , attentionAsked = False
                     , noticeAt = -1
                     , toOpen = Nothing
                     , linkAsked = Nothing
                     , pointerShown = Window.TextPointer
                     , hover = Nothing
                     , shiftHeld = False
                     , back = 0
                     , selection = Nothing
                     , clicks = { at = -1000, count = 0, cell = { row = 0, col = 0 } }
                     , toOwn = Nothing
                     , wordBoundaries = Array.map Char.toCode (String.toArray config.wordBoundaries)
                     , toPaste = Nothing
                     , pasting = Nothing
                     , clips = []
                     , clipRead = Nothing
                     , settings = settings
                     , shotPath = shotPath
                     , troubles = problems
                     , settingsWindow = opener
                     , menu = Nothing
                     , shownItems = []
                     , ssh =
                        Maybe.map
                            (\h -> { host = h.name, command = h.command, lines = [], asking = Nothing, started = False, failed = Nothing, exitStatus = Nothing, tried = [], changes = [] })
                            config.remote
                     , tmux =
                        -- control mode expected when the tab's command starts
                        -- `tmux -CC` (docs/tmux.md TM108)
                        TmuxMode.expectEntry
                            (when config.remote is
                                Just h ->
                                    Maybe.map TmuxMode.startsTmux h.command |> Maybe.withDefault (meant Reason.NotSet False)

                                Nothing ->
                                    meant Reason.NotSet (TmuxMode.startsTmux (String.join " " config.command))
                            ) <|
                            TmuxMode.setEmbedder (embedderOf config) <|
                                TmuxMode.setCell (paneCell cell) (TmuxMode.setBackground config.background (TmuxMode.setLook (config.tmuxLook == "tmux") (TmuxMode.setBar (config.tmuxTabs == "top") (TmuxMode.idle {}))))
                     , overlaid = False
                     , search = Nothing
                     , barDrag = False
                     , remote = remote
                     , tab = { id = 0, name = "", host = config.remote, hostName = config.hostName, color = HostsColor, bells = 0, bell = False, activity = False }
                     , tabs = Builder.empty 4
                     , order = [ 0 ]
                     , shown = 0
                     , nextTabId = 1
                     , starter = starter
                     , windowRows = config.rows
                     , renaming = Nothing
                     , coloring = Nothing
                     , closing = Nothing
                     , pasteAsk = Nothing
                     , dropAsk = Nothing
                     , choosing = Nothing
                     , picking =
                        if settings.given.tryPicker then
                            Just (demoOpen PickerDemo.files PickerDemo.places)

                        else
                            Nothing
                     , pickerPlaces = PickerDemo.places
                     , shellHost = Nothing
                     , sending = Nothing
                     , pendingSend = Nothing
                     , startFailed = Nothing
                     , barClick = { at = -1000, id = -1 }
                     , saving = { dir = restoring.dir, window = Nothing, written = "", at = -1 }
                     , byButton = False
                     , quietUntil = -1
                     , closedTabs = Builder.empty closedSlots
                     , diag = Diag.off
                     , logDir = logDir
                     , turnMs = t0
                     , loggedTab = -1
                     , clockStart = began - Int64.fromInt startAt
                     , maximized = False
                     , normalSize = { columns = config.columns, rows = config.rows }
                     , recents = started.recents
                     , folders = started.folders
                     , zone = started.zone
                     }
                        |> noteJumpList started.jumped
                    )
                    |> Task.mapError Os.Error.toString
            )
        |> Task.andThen (\m -> finish m.remote m)


{-| `SessionFile.begin` or `end` in the state folder, when there is one. -}
sessionMark : (File.Permission -> Path.Path -> Task Never {}) -> File.Permission -> Maybe String -> Task x {}
sessionMark mark fs logDir =
    when stateFolder logDir is
        Just dir ->
            mark fs dir |> Task.mapError never

        Nothing ->
            meant Reason.NotSet Task.succeed {}


{-| The end: the program's exit status when it ended, 0 when the window
was closed, after asking the program to end. -}
finish : Backend -> (taken m0 : Model) -> Task String {}
finish remote m0 =
    rememberWindow m0
        |> Task.andThen savedAtEnd
        -- this window no longer counted among those open (SG16)
        |> Task.andThen (\m -> sessionMark SessionFile.end m.settings.given.fs m.logDir |> Task.map (\_ -> m))
        |> Task.andThen
            (\m ->
                writeLog True
                    (logLine "end"
                        (if m.lost then
                            "the window was lost"

                         else
                            "the window ended"
                        )
                        m
                    )
            )
        |> Task.mapError Os.Error.toString
        |> Task.andThen (\m -> finishTabs remote m)


{-| What becomes of the window's saved tabs as it ends (docs/tabs.md
TB10). A window lost, as at logout, keeps them, saved once more. One
closed by its button keeps them only when no other window is open, since
closing the last is quitting. One whose last tab ended forgets them. -}
savedAtEnd : (taken m : Model) -> Task Error Model
savedAtEnd m =
    when { dir = m.saving.dir, window = m.saving.window } is
        { dir = Just dir, window = Just w } ->
            let
                fs =
                    m.settings.given.fs
            in
            if m.lost then
                saveNow 0 m

            else if m.byButton then
                Restore.others fs dir w
                    |> Task.andThen
                        (\open ->
                            if open then
                                Restore.forget fs dir w |> Task.map (\_ -> m)

                            else
                                saveNow 0 m
                        )

            else
                Restore.forget fs dir w |> Task.map (\_ -> m)

        _ ->
            Task.succeed m


finishTabs : Backend -> Model -> Task String {}
finishTabs remote m =
    let
        -- the other tabs' programs ended first (docs/tabs.md TB2)
        others =
            remotesOf m

        ending =
            { lost = m.lost, closed = m.closed, ssh = m.ssh }
    in
    Array.foldl (\r done -> done |> Task.andThen (\_ -> r.kill)) (Task.succeed {}) others
        |> Task.andThen (\_ -> finishShown remote ending)


finishShown : Backend -> { lost : Bool, closed : Bool, ssh : Maybe SshScreen } -> Task String {}
finishShown remote m =
    if m.lost then
        remote.kill |> Task.andThen (\_ -> Task.fail "the window is lost")

    else if m.closed then
        remote.kill
            |> Task.andThen
                (\_ ->
                    Os.Env.exitWithCode
                        (m.ssh |> Maybe.andThen .exitStatus |> Maybe.withDefault (meant Reason.FromOutside 0))
                )

    else
        remote.waitForExit
            |> Task.andThen
                (\code ->
                    Os.Env.exitWithCode
                        (if code < 0 then
                            1

                         else
                            code
                        )
                )


syncHeld : Vt.Term -> Bool
syncHeld t =
    Dict.get 2026 t.modes == Just True


blinking : Model -> Bool
blinking m =
    m.config.blinkMs > 0 && m.focus.focused && m.term.showCursor && Dict.get 12 m.term.modes == Just True


{-| When the next frame is due, or -1 for none waiting. -}
frameAt : Model -> Int
frameAt m =
    if m.pending < 0 && not m.urgent then
        -1

    else if syncHeld m.term && m.syncSince >= 0 then
        Clock.after m.syncSince m.config.syncTimeoutMs

    else if m.urgent then
        m.last

    else
        Clock.after m.last m.config.frameMs


{-| The time the timer branch waits for: the frame's, or the blink's. -}
nextAt : Model -> Int
nextAt m =
    let
        f =
            frameAt m

        b =
            if blinking m then
                m.blinkAt

            else
                -1
    in
    Clock.soonest (Clock.soonest (Clock.soonest (Clock.soonest (Clock.soonest (Clock.soonest (Clock.soonest f b) m.settings.at) (TmuxMode.dueAt m.tmux)) m.saving.at) (closedDue m)) (Diag.due m.diag)) (Clock.soonest (noteDue m) (pickerDue m))


{-| What the program is sent, queued: keys, replies, focus reports, a
paste. The pty takes what it takes; the rest waits for `File.writable`, which
the loop races beside its read, so a program that stops reading until its
output is read never holds the window (V48, geng-lang D1049). -}
send : Bytes -> (taken m : Model) -> Model
send text m =
    if TmuxMode.isOn m.tmux then
        -- under tmux control mode, to the active pane (docs/tmux.md TM14)
        let
            k =
                TmuxMode.keys text m.tmux
        in
        sendCommands k.commands { m | tmux = k.state }

    else
        sendPty text m


{-| A typed key sent: under tmux control mode through the client's key
table, so that tmux's prefix and bindings work (docs/tmux.md TM23). -}
sendKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken m : Model) -> Model
sendKey k bytes ms m =
    if TmuxMode.isOn m.tmux then
        let
            r =
                TmuxMode.typed k bytes ms m.tmux
        in
        sendCommands r.commands { m | tmux = r.state }

    else
        -- the line typed, to know whether it starts `tmux -CC` (TM108)
        sendPty bytes { m | tmux = TmuxMode.typedOutside bytes m.tmux }


sendPty : Bytes -> (taken m : Model) -> Model
sendPty text m =
    let
        -- in the pane's character set (cjk-and-thai.md §10.3, V49); what
        -- it cannot send goes as `?`, counted and shown in the title. A
        -- legacy mouse report's bytes are raw and will skip this.
        encoded =
            Charset.encode m.charset text

        bytes =
            encoded.bytes
    in
    { m | out = Outbox.push bytes m.out, replaced = m.replaced + encoded.replaced }


{-| Bytes queued as they are, in no character set: a mouse report, whose
legacy forms are raw bytes. -}
sendRaw : Bytes -> (taken m : Model) -> Model
sendRaw bytes m =
    { m | out = Outbox.push bytes m.out }


{-| What puritty says of itself to the core (`Vt.Embedder`,
`docs/tmux.md` TM4): the look's colors, which OSC 10 and 11 answer and
DSR 996 judges; DA1 with 21 (left and right margins) and 52 (OSC 52), which
tmux turns its `margins` and `clipboard` on from; and XTVERSION with a
version, as tmux matches a name followed by a space. -}
embedderOf : Config -> Vt.Embedder
embedderOf config =
    { look = Just { foreground = config.foreground, background = config.background }
    -- 4: Sixel (`docs/images-sixel.md` SX2), which chafa and timg look for
    , attributes = "\u{001B}[?62;4;21;22;52c"
    , version = "puritty " ++ purittyVersion
    , listening = listeningOf config
    , extraImages = True
    , kittyErases = False
    -- Kitty's pictures from files a program names (`[images]
    -- read_files`, `docs/images-kitty.md` KG9); read for a local
    -- program only (`filesRead`)
    , kittyFiles = config.imageFiles
    }


{-| A terminal's size for the program on it: its cells, and its pixels as
the cell size gives them (`docs/images.md` IM21), 0 while it is not
known, at most 65,535 as a pty holds them. -}
ptySize : Int -> Int -> Vt.Term -> Backend.Size
ptySize cols rows term =
    { columns = cols, rows = rows, widthInPixels = pixelsOf cols term.config.cellWidth, heightInPixels = pixelsOf rows term.config.cellHeight }


{-| `cells` cells of `cell` pixels, at most 65,535. -}
pixelsOf : Int -> Int -> Int
pixelsOf cells cell =
    clamp 0 65535 (clamp 0 32767 cells * clamp 0 4096 cell)


{-| What the terminals tell the diagnostic log of the programs
(`docs/diagnostics.md` DG6): nothing while it is off; their questions and
the answers while it is on; the sequences ignored too with `only = "app"`. -}
listeningOf : Config -> Int
listeningOf config =
    if not config.debugLog then
        0

    else if config.debugOnly == "app" then
        2

    else
        1


{-| The queue written as far as the pty takes it. -}
flush : Backend -> (taken m : Model) -> Task Error Model
flush remote m =
    if Outbox.isEmpty m.out then
        Task.succeed m

    else
        let
            next =
                Outbox.offer m.out
        in
        remote.writeSome next.bytes
            |> Task.map (\n -> { m | out = Outbox.written n next.outbox })


{-| A window that restores (docs/tabs.md TB10) opens its saved tabs, with
their names and colors, and shows the one that was shown; then, when
another saved window waits, `puritty restore` is started for it, which
starts the next in turn. A window that saves without restoring makes its
files. Then the loop. -}
restoreInto : Restoring -> (taken m : Model) -> Task Error Model
restoreInto restoring m =
    let
        fs =
            m.settings.given.fs
    in
    (when restoring.claimed is
        Just c ->
            let
                first =
                    Array.first c.state.tabs |> Maybe.withDefault (meant Reason.FromOutside { name = "", color = HostsColor, directory = Nothing })

                info =
                    m.tab

                named =
                    { m | tab = { info | name = first.name, color = first.color }, saving = { dir = restoring.dir, window = Just c.window, written = "", at = m.last }, quietUntil = Clock.after m.last 3000 }

                shownId =
                    -- ids are given in order from 0, so the saved order's
                    -- place is the id
                    clamp 0 (Array.length c.state.tabs - 1) c.state.shown
            in
            Array.foldl
                (\t acc -> acc |> Task.andThen (openTabWith { directory = Just (Maybe.map Path.fromString t.directory), name = t.name, color = t.color, kept = Nothing }))
                (Task.succeed named)
                (Array.dropFirst 1 c.state.tabs)
                |> Task.map (\opened -> showTab shownId opened)
                |> Task.andThen
                    (\shown ->
                        when restoring.dir is
                            Just dir ->
                                Restore.waiting fs dir
                                    |> Task.andThen
                                        (\more ->
                                            if more then
                                                spawnSelf [ "restore" ] shown

                                            else
                                                Task.succeed shown
                                        )

                            Nothing ->
                                meant Reason.NotSet (Task.succeed shown)
                    )

        Nothing ->
            meant Reason.NotSet startSaving m
    )
        |> Task.andThen (\next -> barFirst next.remote next)


{-| This window's files made, when its tabs are to be restored and it has
none yet; a failure leaves it unsaved, and says so on standard error. -}
startSaving : (taken m : Model) -> Task Error Model
startSaving m =
    when m.saving.dir is
        Just dir ->
            if m.config.tabsRestore && not (Maybe.isJust m.saving.window) then
                Restore.fresh m.settings.given.fs dir
                    |> Task.map Ok
                    |> Task.onError (\e -> Task.succeed (Err e))
                    |> Task.andThen
                        (\made ->
                            when made is
                                Ok w ->
                                    -- due at once: the clock's 0 is a time like any
                                    -- other, as far as 12.4 days ahead (review MA13)
                                    Task.succeed { m | saving = { dir = Just dir, window = Just w, written = "", at = m.turnMs } }

                                Err e ->
                                    meant Reason.Refused Console.writeErr ("puritty: the tabs cannot be saved to restore them: " ++ Os.Error.toString e ++ "\n") |> Task.map (\_ -> m)
                        )

            else
                Task.succeed m

        Nothing ->
            meant Reason.NotSet Task.succeed m


{-| Where the first tab of a restored local window starts. -}
firstDirectory : Restoring -> Maybe Path.Path
firstDirectory restoring =
    restoring.claimed
        |> Maybe.andThen
            (\c ->
                if c.state.host == Nothing then
                    Array.first c.state.tabs

                else
                    Nothing
            )
        |> Maybe.andThen .directory
        |> Maybe.map Path.fromString


{-| The window's tabs saved when five seconds have passed since the last
look, and only when they changed (docs/tabs.md TB10): the shown tab's
directory and the others' are read each time, so a `cd` is kept too. -}
saveIfDue : Int -> (taken m : Model) -> Task Error Model
saveIfDue ms m =
    if m.saving.at < 0 || not (Clock.passed 5000 m.saving.at ms) then
        Task.succeed m

    else
        saveNow ms m


saveNow : Int -> (taken m : Model) -> Task Error Model
saveNow ms m =
    let
        saving =
            m.saving

        fs =
            m.settings.given.fs
    in
    when { dir = saving.dir, window = saving.window } is
        { dir = Just dir, window = Just w } ->
            stateOf m
                |> Task.andThen
                    (\state ->
                        let
                            text =
                                RestoreFile.encode state
                        in
                        (if text == saving.written then
                            Task.succeed saving.written

                         else
                            Restore.save fs dir w text
                                |> Task.map (\_ -> text)
                                |> Task.onError (\_ -> Task.succeed saving.written)
                        )
                    )
                |> Task.andThen (\written -> Task.succeed { m | saving = { saving | written = written, at = Clock.after ms 5000 } })

        _ ->
            Task.succeed m


{-| The window as it is saved: its host, its size, which tab is shown,
and each tab's name, color and, in a local window, directory. -}
stateOf : Model -> Task Error RestoreFile.State
stateOf m =
    let
        -- the tab's own host name, which a settings reload does not
        -- change as it changes `config` (the window's tabs are all one
        -- host's, or all local)
        local =
            m.tab.hostName == Nothing

        header =
            { host = m.tab.hostName, columns = m.normalSize.columns, rows = m.normalSize.rows, shown = shownAt m }

        directoryOf remote =
            if local then
                remote.directory |> Task.map (Maybe.map Path.toString) |> Task.onError (\_ -> Task.succeed Nothing)

            else
                Task.succeed Nothing
    in
    Array.foldl
        (\t acc -> acc |> Task.andThen (\soFar -> directoryOf t.remote |> Task.map (\d -> Array.pushLast { name = t.name, color = t.color, directory = d } soFar)))
        (Task.succeed [])
        (savedTabsOf m)
        |> Task.map (\tabs -> { host = header.host, columns = header.columns, rows = header.rows, maximized = m.maximized, shown = header.shown, tabs = tabs })


{-| Each tab in the bar's order: its name, its color, its backend. -}
savedTabsOf : Model -> Array { name : String, color : TabColor, remote : Backend }
savedTabsOf m =
    let
        hidden =
            savedHidden 0 m []

        shown =
            { name = m.tab.name, color = m.tab.color, remote = m.remote }

        shownId =
            m.tab.id
    in
    Array.mapAndKeepJust
        (\id ->
            if id == shownId then
                Just shown

            else
                Array.findFirst (\h -> h.id == id) hidden |> Maybe.map (\f -> { name = f.value.name, color = f.value.color, remote = f.value.remote })
        )
        m.order


{-| What saving needs of each tab not shown. -}
savedHidden : Int -> Model -> Array { id : Int, name : String, color : TabColor, remote : Backend } -> Array { id : Int, name : String, color : TabColor, remote : Backend }
savedHidden i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        savedHidden (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { id = t.info.id, name = t.info.name, color = t.info.color, remote = t.remote } acc

                Nothing ->
                    meant Reason.Gone acc
            )


{-| The loop, with the first tab's terminal a row shorter when the bar
is shown from the start (`[tabs] bar = "always"`). -}
barFirst : Backend -> (taken m : Model) -> Task Error Model
barFirst remote m =
    (if barRows m > 0 then
        relayout m.term.cols m

     else
        Task.succeed m
    )
        -- the diagnostic log begun, when the settings ask for it
        |> Task.andThen (logTurned False)
        |> Task.andThen (loop remote)


loop : Backend -> (taken m00 : Model) -> Task Error Model
loop remote m00 =
    let
        -- every motion from X only while the program asks for any motion
        -- (mode 1003, docs/phase3-select.md §4), or while there is
        -- something the pointer's shape tells of (`hoverShapes`)
        all =
            (Vt.mouseModes m00.term).tracking == Mouse.any || hoverShapes m00 || Maybe.isJust m00.picking || Maybe.isJust m00.choosing
    in
    (if all == m00.allMotion then
        Task.succeed m00

     else
        Window.motion all |> Task.map (\_ -> { m00 | allMotion = all })
    )
        |> Task.andThen pointerShape
        |> Task.andThen bellRung
        |> Task.andThen statusNoticed
        |> Task.andThen noticesShown
        |> Task.andThen clipboardRequests
        |> Task.andThen linkOpened
        |> Task.andThen (writeLog False)
        |> Task.andThen (flush remote)
        |> Task.andThen (\m0 -> race remote m0)


{-| The bell (docs/sounds.md SN6): when any terminal rang since the last
turn, puritty's own or another tab's or a tmux pane's, the sound
`[sound] bell` names, once however many came. A total that fell (a tab
closed) is taken as it is. -}
bellRung : (taken m : Model) -> Task Error Model
bellRung m =
    let
        others =
            Array.range 0 (Builder.length m.tabs - 1)
                |> Array.foldl
                    (\i n ->
                        when Builder.get i m.tabs is
                            Just (Just t) ->
                                n + t.term.bells

                            _ ->
                                meant Reason.Gone n
                    )
                    0

        total =
            m.term.bells + others + TmuxMode.bells m.tmux

        sound =
            Config.bellSound m.config.soundBell
    in
    if total == m.bellsHeard then
        Task.succeed m

    else if total > m.bellsHeard then
        when sound is
            Just id ->
                Window.sound id
                    |> Task.map
                        (\taken ->
                            logLine "bell"
                                ("rang: "
                                    ++ m.config.soundBell
                                    ++ (if taken then
                                            ", played"

                                        else
                                            ", not played (no audio, or a sound still playing)"
                                       )
                                )
                                { m | bellsHeard = total }
                        )

            Nothing ->
                meant Reason.NotSet Task.succeed (logLine "bell" "rang: none chosen" { m | bellsHeard = total })

    else
        Task.succeed { m | bellsHeard = total }


{-| Each tab's Program Status Protocol state (OSC 7501), the shown tab's
and the others': what the most pressing of its records says, empty for
none (docs/claude-code.md CL7). -}
tabStates : Model -> Array { id : Int, state : String }
tabStates m =
    let
        statusOf term =
            Vt.programStatus term |> Maybe.map .state |> Maybe.withDefault (meant Reason.NotSet "")
    in
    Array.range 0 (Builder.length m.tabs - 1)
        |> Array.foldl
            (\i acc ->
                when Builder.get i m.tabs is
                    Just (Just t) ->
                        Array.pushLast { id = t.info.id, state = statusOf t.term } acc

                    _ ->
                        meant Reason.Gone acc
            )
            [ { id = m.tab.id, state = statusOf m.term } ]


{-| A tab that has come to wait on the user, or finished or failed
(OSC 7501's `blocked`, `done`, `error`), while the user is not looking at
it (the window not focused, or the tab not shown): the window asks for
attention and the bell's sound rings, once for that change. The window
stops asking once it has the focus (docs/claude-code.md CL7). -}
statusNoticed : (taken m : Model) -> Task Error Model
statusNoticed m =
    let
        states =
            tabStates m

        pressing s =
            s == "blocked" || s == "done" || s == "error"

        news =
            Array.keepIf (\t -> pressing t.state && Dict.get t.id m.statusSeen /= Just t.state && (not m.focus.focused || t.id /= m.tab.id)) states

        seen =
            Array.foldl (\t d -> Dict.set t.id t.state d) Dict.empty states

        noted =
            { m | statusSeen = seen }
    in
    when Array.first news is
        Just first ->
            Window.attention True
                |> Task.andThen
                    (\_ ->
                        when Config.bellSound m.config.soundBell is
                            Just id ->
                                Window.sound id |> Task.map (\_ -> {})

                            Nothing ->
                                meant Reason.NotSet Task.succeed {}
                    )
                |> Task.map (\_ -> logLine "status" ("tab " ++ String.fromInt first.id ++ " is " ++ first.state ++ ": attention asked") { noted | attentionAsked = True })

        Nothing ->
            -- nothing new: the attention asked for taken back once the
            -- window has the focus
            meant Reason.NoMore
                (if m.attentionAsked && m.focus.focused then
                    Window.attention False |> Task.map (\_ -> { noted | attentionAsked = False })

                 else
                    Task.succeed noted
                )


{-| The desktop notifications programs asked for (OSC 9, 777, 99;
docs/claude-code.md CL8), taken from every tab's terminal, one with no
title given its tab's; the newest shown, at most one every 3 s, the others
dropped and said in the log. -}
noticesShown : (taken m : Model) -> Task Error Model
noticesShown m0 =
    let
        own =
            Vt.takeNotices m0.term

        label =
            tabLabel m0.tab own.term.title

        titled tab ns =
            Array.map
                (\n ->
                    if n.title == "" then
                        { n | title = tab }

                    else
                        n
                )
                ns

        others =
            noticesFrom 0 m0.tabs []

        m =
            { m0 | term = own.term, tabs = others.tabs }

        all =
            titled label own.notices ++ others.notices
    in
    when Array.last all is
        Just newest ->
            if not m.config.desktopNotifications then
                -- `[notifications] desktop = false`: taken, not shown
                Task.succeed (logLine "notice" (String.fromInt (Array.length all) ++ " not shown: desktop notifications are off") m)

            else if m.noticeAt < 0 || Clock.passed 3000 m.noticeAt m.turnMs then
                Notify.show (Maybe.map .cp m.settingsWindow) newest
                    |> Task.map
                        (\shown ->
                            let
                                said =
                                    when shown is
                                        Ok _ ->
                                            "shown: " ++ String.fromInt (String.count newest.title) ++ " and " ++ String.fromInt (String.count newest.body) ++ " characters"

                                        Err why ->
                                            meant Reason.Refused ("not shown: " ++ why)
                            in
                            logLine "notice"
                                (said
                                    ++ (if Array.length all > 1 then
                                            ", " ++ String.fromInt (Array.length all - 1) ++ " older dropped"

                                        else
                                            ""
                                       )
                                )
                                { m | noticeAt = Clock.after m.turnMs 3000 }
                        )

            else
                Task.succeed (logLine "notice" (String.fromInt (Array.length all) ++ " dropped: one was shown less than 3 s ago") m)

        Nothing ->
            meant Reason.NoMore Task.succeed m


{-| The hidden tabs' notices taken, from tab `i` on, each titled with its
tab's label where it has none. -}
noticesFrom : Int -> (taken tabs : Builder (Maybe Tab)) -> Array { title : String, body : String } -> { tabs : Builder (Maybe Tab), notices : Array { title : String, body : String } }
noticesFrom i tabs acc =
    if i >= Builder.length tabs then
        { tabs = tabs, notices = acc }

    else
        when Builder.get i tabs is
            Just (Just t) ->
                let
                    taken =
                        Vt.takeNotices t.term

                    label =
                        tabLabel t.info taken.term.title

                    titled =
                        Array.map
                            (\n ->
                                if n.title == "" then
                                    { n | title = label }

                                else
                                    n
                            )
                            taken.notices
                in
                noticesFrom (i + 1) (Builder.set i (Just { t | term = taken.term }) tabs) (acc ++ titled)

            _ ->
                meant Reason.Gone noticesFrom (i + 1) tabs acc


{-| The mark a Program Status Protocol state puts before a title: working,
waiting on the user, done, failed (docs/claude-code.md CL7). -}
statusMark : String -> String
statusMark state =
    when state is
        "working" ->
            "◔ "

        "blocked" ->
            "◉ "

        "done" ->
            "✓ "

        "error" ->
            "✗ "

        _ ->
            ""


{-| The key sound for a key that sends something (`[sound] keys`,
`feature-plan.md` §3): Enter's own, any other key's; none for a release or
a key that sends nothing (a modifier alone). -}
keySound : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Task x {}
keySound config k bytes =
    if config.soundKeys && k.action /= 0 && not (Bytes.isEmpty bytes) then
        Window.sound
            (if k.sym == 0xFF0D || k.sym == 0xFF8D then
                1

             else
                0
            )
            |> Task.map (\_ -> {})

    else
        Task.succeed {}


{-| The pointer's shape (docs/phase3-select.md §21): the arrow while the
program takes the mouse and Shift is not held to take it back, the I-beam
otherwise, as Alacritty and Ghostty show them. Over what a press would
drag or click it says so (docs/tmux.md TM38): under tmux control mode the
lines between panes and a floating pane's edges (`TmuxMode.pointerShape`),
and the arrow over the tab bar, the scroll bar, a menu and a question. The
window is told only when it changes. -}
pointerShape : (taken m : Model) -> Task Error Model
pointerShape m =
    let
        program =
            if (Vt.mouseModes m.term).tracking /= Mouse.none && not m.shiftHeld then
                Window.ArrowPointer

            else
                Window.TextPointer

        shape =
            if m.startFailed /= Nothing || m.closing /= Nothing || TmuxMode.entryAsked m.tmux || m.pasteAsk /= Nothing || Maybe.isJust m.choosing || sendingAsks m || Maybe.isJust m.dropAsk || m.coloring /= Nothing || m.menu /= Nothing then
                Window.ArrowPointer

            else
                when m.hover is
                    Just p ->
                        if m.barDrag || (barRows m > 0 && p.y >= m.term.rows * max 1 p.cellHeight) then
                            Window.ArrowPointer

                        else if barShown m && Dialog.scrollbarHit (overlaySize m) { back = viewBack m, most = Vt.scrollbackRows m.term } { x = p.x, y = p.y } /= Nothing then
                            Window.ArrowPointer

                        else
                            TmuxMode.pointerShape m.shiftHeld p m.tmux |> Maybe.withDefault (meant Reason.NotOpen program)

                    Nothing ->
                        meant Reason.OutOfRange program
    in
    if shape == m.pointerShown then
        Task.succeed m

    else
        Window.setPointer shape
            |> Task.map (\_ -> { m | pointerShown = shape })


{-| Whether the pointer's shape can change as it moves with no button held,
so that the window sends every motion: under tmux control mode, with the tab
bar or the scroll bar shown, or a menu or a question up. -}
hoverShapes : Model -> Bool
hoverShapes m =
    TmuxMode.isOn m.tmux || barRows m > 0 || barShown m || m.startFailed /= Nothing || m.closing /= Nothing || m.pasteAsk /= Nothing || Maybe.isJust m.choosing || sendingAsks m || Maybe.isJust m.dropAsk || m.coloring /= Nothing || m.menu /= Nothing


{-| The window's events waiting, taken after a turn the session's output
or notice won (docs/sftp.md FT25): which of a race's ready tasks wins is
not said, and while a transfer keeps the session's notices coming, the
window's clicks and keys could wait for its end. -}
windowToo : Backend -> Int -> (taken m : Model) -> Task Error Model
windowToo remote ms m =
    Window.take
        |> Task.andThen
            (\evs ->
                if Array.isEmpty evs then
                    Task.succeed m

                else
                    handle remote ms evs m
            )


{-| A notice of the session's in the log, but a side channel's output and
how much of its data waits: a transfer has one of each for every piece,
which would be most of the log. -}
noticeLogged : Session.Notice -> (taken m : Model) -> Model
noticeLogged told m =
    when told is
        Session.Side { ref = _, event = Connection.Output _ } ->
            m

        Session.Side { ref = _, event = Connection.Sent _ } ->
            m

        _ ->
            logLine "ssh" (sshLine told) m


race : Backend -> (taken m0 : Model) -> Task Error Model
race remote m0 =
    clock m0.clockStart
        |> Task.andThen
            (\ms0 ->
                let
                    m =
                        if blinking m0 && m0.blinkAt < 0 then
                            { m0 | blinkAt = Clock.after ms0 m0.config.blinkMs }

                        else
                            m0

                    at =
                        nextAt m

                    timer =
                        if at < 0 then
                            []

                        else
                            [ Sleep.sleep (toFloat (max 0 (Clock.since ms0 at))) |> Task.map (\_ -> Due) ]

                    writing =
                        if Outbox.isEmpty m.out then
                            []

                        else
                            [ remote.writable |> Task.map (\_ -> Writable) ]

                    following =
                        when m.settings.events is
                            Nothing ->
                                meant Reason.NotSet []

                            Just events ->
                                [ Source.next events |> Task.map SettingsChanged ]

                    -- the tabs not shown keep reading, and writing what
                    -- waits for them (docs/tabs.md TB2)
                    behindTabs =
                        Array.mapAndFlatten
                            (\t ->
                                Array.pushFirst (t.remote.read |> Task.map (\incoming -> Behind { id = t.id, incoming = incoming }))
                                    (if t.writing then
                                        [ t.remote.writable |> Task.map (\_ -> BehindWritable t.id) ]

                                     else
                                        []
                                    )
                            )
                            (hiddenOf m)
                in
                Task.race (remote.read |> Task.map Read) ([ Window.events |> Task.map Events ] ++ timer ++ writing ++ following ++ behindTabs)
                    |> Task.andThen
                        (\turn ->
                            clock m.clockStart
                                |> Task.andThen
                                    (\ms ->
                                        when turn is
                                            Read (Data chunk) ->
                                                if Bytes.length chunk == 0 then
                                                    -- the shown tab's program ended: the tab
                                                    -- closes, and the window with the last
                                                    if tabCount m > 1 then
                                                        remote.waitForExit
                                                            |> Task.andThen (\_ -> remote.hangUp)
                                                            |> Task.mapError (\why -> { kind = Os.Error.Other, operation = "wait", path = Nothing, detail = why })
                                                            |> Task.andThen (\_ -> dropShown m)
                                                            |> Task.andThen (\next -> step next.remote ms next)

                                                    else
                                                        Task.succeed m

                                                else
                                                    feed remote chunk ms m |> Task.andThen (windowToo remote ms) |> Task.andThen (\next -> step remote ms next)

                                            Read (Notice told) ->
                                                if endsSession told m.ssh then
                                                    closeShown (sshNoticed told (logLine "ssh" (sshLine told) { m | turnMs = ms })) |> Task.andThen (\next -> step next.remote ms next)

                                                else
                                                    sshTold told (noticeLogged told { m | turnMs = ms }) |> Task.andThen (windowToo remote ms) |> Task.andThen (\next -> step remote ms next)

                                            Events up ->
                                                if not up then
                                                    Task.succeed { m | lost = True }

                                                else
                                                    Window.take
                                                        |> Task.andThen (\evs -> handle remote ms evs m)
                                                        |> Task.andThen (\next -> step remote ms next)

                                            Due ->
                                                tmuxDue remote ms m
                                                    |> Task.andThen (\t -> reloadIfDue ms (expireNote ms (expireClosed ms (blink ms (pickerTick ms t)))))
                                                    |> Task.andThen (saveIfDue ms)
                                                    |> Task.andThen (\next -> step next.remote ms next)

                                            Writable ->
                                                step remote ms m

                                            SettingsChanged change ->
                                                step remote ms (noticed ms change m)

                                            Behind b ->
                                                behind b.id b.incoming ms m |> Task.andThen (\next -> step next.remote ms next)

                                            BehindWritable id ->
                                                atTab id (\one -> flush one.remote one) m |> Task.andThen (\next -> step next.remote ms next)
                                    )
                        )
            )


{-| A frame if one is due, then the loop again, unless the window is gone. -}
step : Backend -> Int -> (taken m : Model) -> Task Error Model
step remote ms mIn =
    let
        -- the last frame's time kept recent: a window that drew nothing
        -- for 6.2 days would otherwise wait as long again (review MA1)
        m0 =
            { mIn | last = Clock.recent mIn.config.frameMs mIn.last ms }
    in
    if m0.closed || m0.lost then
        Task.succeed m0

    else
        let
            m =
                if Diag.isOn m0.diag && m0.tab.id /= m0.loggedTab then
                    { m0
                        | loggedTab = m0.tab.id
                        , diag =
                            Diag.add ms
                                "tab"
                                ("shown: tab "
                                    ++ String.fromInt m0.tab.id
                                    ++ " of "
                                    ++ String.fromInt (tabCount m0)
                                    ++ (if TmuxMode.isOn m0.tmux then
                                            ", under tmux -CC"

                                        else
                                            ""
                                       )
                                )
                                m0.diag
                    }

                else
                    m0

            at =
                frameAt m
        in
        if at >= 0 && Clock.reached at ms then
            draw ms m
                |> Task.andThen shoot
                |> Task.andThen
                    (\next ->
                        if next.lost then
                            Task.succeed next

                        else
                            loop next.remote next
                    )

        else
            loop m.remote m


{-| A change in the settings directory: one to the settings file, or
changes the system dropped, has the file read `reloadDelayMs` later; the
directory gone stops the following. -}
noticed : Int -> Maybe Directory.Change -> (taken m : Model) -> Model
noticed ms change m =
    let
        s =
            m.settings

        ours path =
            when s.given.file is
                Just f ->
                    Path.filename path == Path.filename f.path

                Nothing ->
                    meant Reason.NotSet False

        soon =
            { s | at = Clock.after ms reloadDelayMs }

        none =
            { s | events = Nothing }
    in
    when change is
        Just (Directory.Added path) ->
            if ours path then
                { m | settings = soon }

            else
                m

        Just (Directory.Changed path) ->
            if ours path then
                { m | settings = soon }

            else
                m

        Just (Directory.Removed path) ->
            if ours path then
                { m | settings = soon }

            else
                m

        Just Directory.Lost ->
            { m | settings = soon }

        Just Directory.Gone ->
            { m | settings = none }

        Nothing ->
            meant Reason.NoMore { m | settings = none }


{-| The settings read again once a change's delay is up (docs/settings.md
ST3): applied when they decode, and when they do not, the settings in force
kept and why written to standard error. -}
reloadIfDue : Int -> (taken m : Model) -> Task Error Model
reloadIfDue ms m =
    let
        s =
            m.settings
    in
    if s.at < 0 || not (Clock.reached s.at ms) then
        Task.succeed m

    else
        readSettings s.given
            |> Task.onError (\why -> Task.succeed (Unread why))
            |> Task.andThen
                (\read ->
                    let
                        quiet =
                            { m | settings = { s | at = -1 } }
                    in
                    when read is
                        Gave r ->
                            say r.problems
                                |> Task.andThen (\_ -> applySettings (forHost quiet r.config) { quiet | troubles = r.problems, urgent = True })

                        Unread why ->
                            let
                                problems =
                                    [ why ++ "; the settings in force are kept" ]
                            in
                            say problems |> Task.map (\_ -> { quiet | troubles = problems, urgent = True })
                )


{-| Settings read again, for this window: a host's window takes its host's
look over them again (its colors, font, charset and title, as
`Hosts.session` gave them at its start), from the host as the new settings
have it, so that a change to the settings keeps the host's look and a
change to the host's look is seen at once. What runs in the window stays:
its program, its ssh client, and a `--title` from the command line. The
host is the shown tab's, as every tab of a host's window is the one host's
(docs/tabs.md TB10). -}
forHost : Model -> Config -> Config
forHost m new =
    when m.tab.hostName is
        Just name ->
            let
                host =
                    if Array.any (\h -> h.name == name) new.hosts then
                        Hosts.named name new

                    else
                        Hosts.quick name |> Maybe.withDefault (meant Reason.NotKnown Hosts.named name new)

                session =
                    Hosts.session new host
            in
            { session
                | command = m.config.command
                , remote = m.config.remote
                , title = Maybe.withDefault (meant Reason.NotSet session.title) m.settings.given.title
            }

        Nothing ->
            meant Reason.NotSet new


{-| Each problem with the settings on standard error. -}
say : Array String -> Task x {}
say problems =
    Array.foldl (\p t -> t |> Task.andThen (\_ -> Console.writeErr ("puritty: " ++ p ++ "\n"))) (Task.succeed {}) problems


{-| A problem with the settings as the terminal shows it before the
program's output: a line in yellow. -}
notice : String -> String
notice problem =
    "\u{001B}[33mpuritty: " ++ problem ++ "\u{001B}[0m\r\n"


{-| New settings applied to the running window (docs/settings.md ST4):
the font opened again for a new family, language or glyph cache, or sized
again for a new size; the colors and the palette, the scrollback's bound,
the charset and the word boundaries changed; every cell drawn again. What
is read where it is used (the blink, the frames, the paste button, OSC 52,
the title) is in `config`. The window's size in cells and the program are
new windows' (V59). A font the system does not have is said on standard
error, and the one in use kept. -}
applySettings : Config -> (taken m : Model) -> Task Error Model
applySettings new m =
    let
        was =
            m.config.tabsRestore
    in
    let
        wasLogging =
            m.config.debugLog
    in
    applyLook new m
        |> Task.andThen (restoreTurned was)
        |> Task.andThen (logTurned wasLogging)
        |> Task.map (\next -> { next | diag = Diag.keeping next.config.debugOnly next.diag })


-- THE DIAGNOSTIC LOG (docs/diagnostics.md)


{-| `[debug] log` turned on, at the start or while the window runs: a
file begun in the logs folder, the oldest beyond twenty removed; turned
off: the last lines written and the log ended. -}
logTurned : Bool -> (taken m : Model) -> Task Error Model
logTurned was m =
    if m.config.debugLog && not was && not (Diag.isOn m.diag) then
        beginLog m

    else if was && not m.config.debugLog then
        let
            ended =
                logLine "end" "the log was turned off" m
        in
        writeLog True ended |> Task.map (\next -> { next | diag = Diag.off })

    else
        Task.succeed m


beginLog : (taken m : Model) -> Task Error Model
beginLog m =
    when m.logDir is
        Nothing ->
            meant Reason.NotSet Task.succeed m

        Just dir ->
            let
                fs =
                    m.settings.given.fs

                folder =
                    Path.fromString dir

                header =
                    logHeader m
            in
            Directory.createAll fs folder
                |> Task.onError (\_ -> Task.succeed {})
                |> Task.andThen (\_ -> pruneLogs fs folder)
                |> Task.andThen (\_ -> Task.map2 (\posix zone -> { posix = posix, zone = zone }) Time.now Time.here)
                |> Task.andThen
                    (\t ->
                        let
                            dayMs =
                                ((Time.toHour t.zone t.posix * 60 + Time.toMinute t.zone t.posix) * 60 + Time.toSecond t.zone t.posix) * 1000 + Time.toMillis t.zone t.posix

                            day =
                                String.padLeft 4 '0' (String.fromInt (Time.toYear t.zone t.posix))
                                    ++ "-"
                                    ++ String.padLeft 2 '0' (String.fromInt (monthNumber (Time.toMonth t.zone t.posix)))
                                    ++ "-"
                                    ++ String.padLeft 2 '0' (String.fromInt (Time.toDay t.zone t.posix))

                            stamp =
                                String.replace ":" "" (String.takeFirst 8 (Diag.clock dayMs))

                            name =
                                "puritty-" ++ day ++ "_" ++ stamp ++ "-" ++ String.padLeft 3 '0' (String.fromInt (modBy 1000 m.turnMs)) ++ ".log"

                            path =
                                dir ++ Platform.pathSeparator ++ name
                        in
                        clock m.clockStart
                            |> Task.map
                                (\ms ->
                                    { m
                                        | diag =
                                            Diag.start path
                                                { ms = ms, dayMs = dayMs }
                                                ([ "puritty diagnostic log, begun " ++ day ++ " " ++ Diag.clock dayMs ++ " local time"
                                                 , "file " ++ path
                                                 , "nothing typed, pasted or shown is written: keys by name, pastes and output by size"
                                                 ]
                                                    ++ onlyLines m.config.debugOnly
                                                    ++ header
                                                )
                                                |> Diag.keeping m.config.debugOnly
                                        , loggedTab = m.tab.id
                                    }
                                )
                    )
                |> Task.andThen (writeLog True)


{-| What a log that keeps only a program's questions says at its start
(`[debug] only`, `docs/diagnostics.md` DG6). -}
onlyLines : String -> Array String
onlyLines only =
    if only == "" then
        []

    else
        [ if only == "app" then
            "keeping only what programs ask the terminal, its answers, and the sequences it ignores"

          else
            "keeping only what programs ask the terminal, and its answers"
        , "under tmux -CC, tmux answers its panes' questions itself, so they are not here"
        ]


monthNumber : Time.Month -> Int
monthNumber month =
    when month is
        Time.Jan ->
            1

        Time.Feb ->
            2

        Time.Mar ->
            3

        Time.Apr ->
            4

        Time.May ->
            5

        Time.Jun ->
            6

        Time.Jul ->
            7

        Time.Aug ->
            8

        Time.Sep ->
            9

        Time.Oct ->
            10

        Time.Nov ->
            11

        Time.Dec ->
            12


{-| The logs folder's files beyond the newest nineteen removed, so that
with the new one twenty are kept. Their names sort by time. -}
pruneLogs : File.Permission -> Path.Path -> Task Error {}
pruneLogs fs folder =
    Directory.list fs folder
        |> Task.map
            (\entries ->
                entries
                    |> Array.map .path
                    |> Array.keepIf
                        (\p ->
                            let
                                base =
                                    Path.toString p
                            in
                            String.contains "puritty-" base && String.endsWith ".log" base
                        )
                    |> Array.sortBy Path.toString
            )
        |> Task.andThen
            (\logs ->
                Array.foldl
                    (\p acc -> acc |> Task.andThen (\_ -> File.remove fs p |> Task.onError (\_ -> Task.succeed {})))
                    (Task.succeed {})
                    (Array.dropLast 19 logs)
            )
        |> Task.onError (\_ -> Task.succeed {})


{-| What the log says of the window as it begins. -}
logHeader : Model -> Array String
logHeader m =
    [ (embedderOf m.config).version
        ++ " on "
        ++ (if Platform.pathSeparator == "\\" then
                "Windows"

            else
                "Linux"
           )
    , "window " ++ String.fromInt m.term.cols ++ "x" ++ String.fromInt m.windowRows ++ " cells, " ++ String.fromInt (tabCount m) ++ " tabs"
    , "paste button "
        ++ (if m.config.pasteButton == 2 then
                "right"

            else
                "middle"
           )
        ++ ", tmux look "
        ++ m.config.tmuxLook
        ++ ", tmux tabs "
        ++ m.config.tmuxTabs
    ]
        ++ windowState m


{-| A line, at this turn's time. -}
logLine : String -> String -> (taken m : Model) -> Model
logLine tag text m =
    { m | diag = Diag.add m.turnMs tag text m.diag }


{-| What the terminal heard of the program for the log (DG6): `probe`
lines, a question and its answer, and `ignore` lines, a sequence the
terminal does nothing with. -}
logHeard : Array String -> (taken m : Model) -> Model
logHeard heard m =
    Array.foldl
        (\line acc ->
            if String.startsWith "probe " line then
                logLine "probe" (String.dropFirst 6 line) acc

            else
                logLine "ignore" (String.dropFirst 8 line) acc
        )
        m
        heard


{-| The waiting lines appended to the file, when they are due or `now`
says so; a file that cannot be written loses them, said on the next. -}
writeLog : Bool -> (taken m : Model) -> Task Error Model
writeLog force m0 =
    if Diag.isOn m0.diag && (force || Diag.due m0.diag >= 0) then
        clock m0.clockStart
            |> Task.andThen
                (\ms ->
                    let
                        dueAt =
                            Diag.due m0.diag
                    in
                    if dueAt < 0 || (not force && not (Clock.reached dueAt ms)) then
                        Task.succeed m0

                    else
                        let
                            taken =
                                Diag.take ms m0.diag

                            m =
                                { m0 | diag = taken.log }
                        in
                        when taken.path is
                            Just path ->
                                File.appendFile m.settings.given.fs taken.bytes (Path.fromString path)
                                    |> Task.map (\_ -> Nothing)
                                    |> Task.onError (\e -> Task.succeed (Just (Os.Error.toString e)))
                                    |> Task.map
                                        (\problem ->
                                            when problem is
                                                Nothing ->
                                                    meant Reason.Refused m

                                                Just why ->
                                                    logLine "error" ("the log could not be written: " ++ why) m
                                        )

                            Nothing ->
                                meant Reason.NotSet Task.succeed m
                )

    else
        Task.succeed m0


{-| A mark in the log (`[keys] mark_log`, the menu): its number, and the
window's state as it is, written at once. -}
markLog : (taken m : Model) -> Task Error Model
markLog m =
    let
        counted =
            Diag.nextMark m.diag

        withCount =
            { m | diag = counted.log }

        n =
            String.fromInt counted.number

        lines =
            [ "==================== MARK " ++ n ++ " ====================" ]
                ++ windowState withCount
                ++ TmuxMode.diagnose withCount.tmux
                ++ [ "==================== END OF MARK " ++ n ++ " =============" ]
    in
    writeLog True { withCount | diag = Diag.addAll withCount.turnMs "mark" lines withCount.diag }


{-| The window's state for a mark: what decides where keys, pastes and the
mouse go, and what waits. -}
windowState : Model -> Array String
windowState m =
    let
        yes b =
            if b then
                "on"

            else
                "off"

        modes =
            m.term.modes
    in
    [ "tab "
        ++ String.fromInt m.tab.id
        ++ " shown of "
        ++ String.fromInt (tabCount m)
        ++ ", "
        ++ (when m.tab.hostName is
                Just h ->
                    "host " ++ h

                Nothing ->
                    meant Reason.NotSet "no host"
           )
    , "focus " ++ yes m.focus.focused ++ ", buttons held " ++ String.fromInt m.held ++ ", shift " ++ yes m.shiftHeld
    , "paste asked "
        ++ yes (m.toPaste /= Nothing)
        ++ ", paste under way "
        ++ (when m.pasting is
                Just b ->
                    "yes, "
                        ++ (if b then
                                "bracketed"

                            else
                                "plain"
                           )

                Nothing ->
                    meant Reason.NotOpen "no"
           )
    , "waiting to be sent " ++ String.fromInt (Outbox.size m.out) ++ " bytes"
    , "terminal: paste-brackets " ++ yes (Dict.get 2004 modes == Just True) ++ ", focus-reports " ++ yes (Dict.get 1004 modes == Just True) ++ ", mouse " ++ yes ((Vt.mouseModes m.term).tracking /= Mouse.none) ++ ", alt-screen " ++ yes m.term.alt ++ ", view scrolled back " ++ String.fromInt m.back
    , "open: "
        ++ (when Array.keepIf (\x -> x /= "")
                [ if m.menu /= Nothing then
                    "a menu"

                  else
                    ""
                , if m.renaming /= Nothing then
                    "the rename box"

                  else
                    ""
                , if m.coloring /= Nothing then
                    "the color box"

                  else
                    ""
                , if m.closing /= Nothing then
                    "the close question"

                  else
                    ""
                , if m.pasteAsk /= Nothing then
                    "the paste question"

                  else
                    ""
                , if Maybe.isJust m.choosing then
                    "the folder chooser"

                  else
                    ""
                , if sendingAsks m then
                    "the conflict question"

                  else
                    ""
                , if Maybe.isJust m.dropAsk then
                    "the question before dropped files are sent"

                  else
                    ""
                , if m.startFailed /= Nothing then
                    "the box saying a tab did not start"

                  else
                    ""
                , if m.search /= Nothing then
                    "the search bar"

                  else
                    ""
                , if m.selection /= Nothing then
                    "a selection"

                  else
                    ""
                ] is
                [] ->
                    "nothing"

                open ->
                    String.join ", " open
           )
    , "ssh: "
        ++ (when m.ssh is
                Just screen ->
                    "to "
                        ++ screen.host
                        ++ (if screen.started then
                                ", started"

                            else
                                ", not started"
                           )
                        ++ (if screen.asking /= Nothing then
                                ", asking a question"

                            else
                                ""
                           )
                        ++ (when screen.failed is
                                Just why ->
                                    ", failed: " ++ why

                                Nothing ->
                                    meant Reason.NotOpen ""
                           )

                Nothing ->
                    meant Reason.NotSet "none"
           )
    ]


{-| A window event as the log says it, `Nothing` for those it leaves out
(the pointer's motions, a key's release, the preedit as it changes). -}
eventLine : Window.Event -> Maybe { tag : String, text : String }
eventLine ev =
    when ev is
        Window.Key k ->
            Maybe.map (\t -> { tag = "key", text = t }) (Diag.key k)

        Window.Pointer p ->
            Maybe.map (\t -> { tag = "mouse", text = t }) (Diag.pointer p)

        Window.Resized r ->
            Just { tag = "window", text = "size " ++ String.fromInt r.cols ++ "x" ++ String.fromInt r.rows }

        Window.Rescaled c ->
            Just { tag = "window", text = "cell " ++ String.fromInt c.width ++ "x" ++ String.fromInt c.height ++ " (another monitor's scale)" }

        Window.Focus on ->
            Just
                { tag = "window"
                , text =
                    if on then
                        "focus in"

                    else
                        "focus out"
                }

        Window.Close ->
            Just { tag = "window", text = "close asked" }

        Window.Commit text ->
            Just { tag = "ime", text = "commit " ++ String.fromInt (String.count (Bytes.toStringLossy text)) ++ " characters" }

        Window.PreeditDone ->
            Just { tag = "ime", text = "preedit done" }

        Window.ImeReady ->
            Just { tag = "ime", text = "ready" }

        Window.SelectionLost _ ->
            Just { tag = "select", text = "the selection was taken by another program" }

        Window.Pasted more ->
            Just
                { tag = "paste"
                , text =
                    "text came"
                        ++ (if more then
                                ", more to come"

                            else
                                ""
                           )
                }

        Window.MenuChosen c ->
            Just { tag = "menu", text = "chosen: menu " ++ String.fromInt c.menu ++ " item " ++ String.fromInt c.index }

        _ ->
            Nothing


{-| What the ssh session said, as the log says it. -}
sshLine : Session.Notice -> String
sshLine n =
    when n is
        Session.Status st ->
            "status " ++ st

        Session.Asking _ ->
            "asks a question"

        Session.Banner b ->
            "banner, " ++ String.fromInt (String.count b) ++ " characters"

        Session.Started ->
            "the session started"

        Session.Output b ->
            "output " ++ String.fromInt (Bytes.length b) ++ " bytes"

        Session.Exited code ->
            "the program exited, status " ++ String.fromInt code

        Session.Failed why ->
            "failed: " ++ why

        Session.Ended ->
            "ended"

        Session.Side side ->
            "side channel " ++ String.fromInt side.ref ++ ": " ++ sideLine side.event


{-| A side channel's event, as the log says it. -}
sideLine : Connection.Event -> String
sideLine e =
    when e is
        Connection.Started ->
            "started"

        Connection.Refused why ->
            "refused: " ++ why

        Connection.Output b ->
            "output " ++ String.fromInt (Bytes.length b) ++ " bytes"

        Connection.ErrorOutput b ->
            "error output " ++ String.fromInt (Bytes.length b) ++ " bytes"

        Connection.Exited code ->
            "exited, status " ++ String.fromInt code

        Connection.Killed k ->
            "killed by " ++ k.signal

        Connection.Ended ->
            "ended"

        Connection.KeepaliveUnanswered n ->
            String.fromInt n ++ " keepalives unanswered"

        Connection.Sent waiting ->
            "sent; " ++ String.fromInt waiting ++ " bytes wait"


{-| tmux commands written, each a line in the log (redacted, `Diag.command`). -}
sendCommands : Array String -> (taken m : Model) -> Model
sendCommands commands m0 =
    if TmuxMode.isEnding m0.tmux then
        -- the client is detaching: tmux reads nothing more, and what was
        -- written would be typed into the shell it leaves (docs/tmux.md TM92)
        { m0 | diag = Diag.addAll m0.turnMs "tmux-" (Array.map Diag.command commands) m0.diag }

    else
        let
            -- the batch that detaches the client is the last to go
            m =
                { m0 | tmux = TmuxMode.afterSent m0.tmux }
        in
        if Array.isEmpty commands then
            m

        else
            let
                logged =
                    { m | diag = Diag.addAll m.turnMs "tmux>" (Array.map Diag.command commands) m.diag }
            in
            sendRaw (commandLines commands) logged


{-| `[tabs] restore` turned on while the window runs: its tabs are saved
from now; turned off: what it saved is forgotten (docs/tabs.md TB10). -}
restoreTurned : Bool -> (taken m : Model) -> Task Error Model
restoreTurned was m =
    let
        saving =
            m.saving
    in
    if m.config.tabsRestore && not was then
        startSaving m

    else if was && not m.config.tabsRestore then
        when { dir = saving.dir, window = saving.window } is
            { dir = Just dir, window = Just w } ->
                Restore.forget m.settings.given.fs dir w |> Task.map (\_ -> { m | saving = { saving | window = Nothing, written = "", at = -1 } })

            _ ->
                Task.succeed m

    else
        Task.succeed m


applyLook : Config -> (taken m : Model) -> Task Error Model
applyLook new m =
    let
        old =
            m.config

        locale =
            m.settings.locale

        language c =
            Maybe.withDefault (meant Reason.NotSet locale.language) c.language

        refont =
            new.font /= old.font || language new /= language old || new.glyphCacheMb /= old.glyphCacheMb

        -- every tab's terminal, the shown one's here and the others' below
        -- (the code review's MA5, docs/settings.md ST37)
        tabbed =
            lookTab old new m

        shape =
            { cols = tabbed.term.cols, rows = tabbed.term.rows }

        starter =
            tabbed.starter

        applied =
            { tabbed
                | config = new
                , look = { foreground = new.foreground, background = new.background, boldIsBright = new.boldIsBright }
                , starter = { starter | charset = charsetOf locale new }
                , wordBoundaries = Array.map Char.toCode (String.toArray new.wordBoundaries)
                , shadow = View.shadowIn shape.cols shape.rows tabbed.windowRows
                , urgent = True
            }

        hidden =
            Array.map .id (hiddenOf applied)

        -- the bar shown or hidden by `[tabs] bar` changes every tab's rows
        rebar =
            new.tabsBar /= old.tabsBar
    in
    (if new.hosts /= old.hosts then
        Window.systemMenu (Array.map .label (menuItems new m.recents))

     else
        Task.succeed {}
    )
        |> Task.andThen (\_ -> Text.ligatures new.ligatures)
        |> Task.andThen
            (\_ ->
                -- the gap around the cells (docs/renderer.md R20); a
                -- Resized follows with the cells that now fit
                if new.padding /= old.padding || new.paddingVertical /= old.paddingVertical then
                    Window.setPadding { x = new.padding, y = new.paddingVertical }

                else
                    Task.succeed {}
            )
        |> Task.andThen
            (\_ ->
                Array.foldl
                    (\id done -> done |> Task.andThen (atTab id (\one -> Task.succeed (lookTab old new one))))
                    (Task.succeed applied)
                    hidden
            )
        |> Task.andThen (refontOr new old language)
        |> Task.andThen
            (\next ->
                if rebar then
                    relayout next.term.cols next

                else
                    Task.succeed next
            )


{-| A settings change's part that is each tab's (docs/settings.md ST4,
ST37), done to the tab shown: the palette, the scrollback's bound, what the
embedder says (the colors OSC 10 and 11 answer, with a 997 to a program
that asked to hear of them, and `[images] read_files`: the code review's
MA6), tmux's look, and the charset when the setting changed (a host's own
is kept otherwise). -}
lookTab : Config -> Config -> (taken m : Model) -> Model
lookTab old new m =
    let
        charset =
            charsetOf m.settings.locale new

        term0 =
            if new.palette /= old.palette then
                Vt.setPalette new.palette m.term

            else
                m.term

        term1 =
            if new.scrollbackLines /= old.scrollbackLines then
                Vt.setScrollbackBytes (Vt.scrollbackBytesFor { cols = term0.cols, rows = new.scrollbackLines }) term0

            else
                term0

        -- the colors a program asks for, and a 997 to one that asked to
        -- hear of the theme changing (docs/tmux.md TM4), sent at once;
        -- and whether a program may name local files for pictures
        told =
            if embedderOf new /= embedderOf old then
                Vt.takeReplies (Vt.withEmbedder (embedderOf new) term1)

            else
                { term = term1, replies = [] }

        term =
            told.term

        back =
            min m.back (Vt.scrollbackRows term)

        recharset =
            charsetOf m.settings.locale old /= charset
    in
    { m
        | tmux = TmuxMode.setEmbedder (embedderOf new) <| TmuxMode.setBackground new.background (TmuxMode.setLook (new.tmuxLook == "tmux") (TmuxMode.setBar (new.tmuxTabs == "top") m.tmux))
        , term = term
        , back = back
        , charset =
            if recharset then
                charset

            else
                m.charset
        , decoder =
            if recharset && charset /= m.charset then
                Charset.decoder

            else
                m.decoder
    }
        |> (\a -> Array.foldl sendRaw a told.replies)


{-| The charset the settings give a local tab. -}
charsetOf : Platform.Locale -> Config -> Charset
charsetOf locale config =
    Charset.fromName (Maybe.withDefault (meant Reason.NotSet locale.charset) config.charset)


{-| The window's cell size after a zoom or a font change, told to the
terminal and every tab's, which answer `CSI 14 t` and `CSI 16 t` from it
and size images by it (`docs/images.md` IM3); a tab made later copies it. -}
cellSized : { width : Int, height : Int } -> (taken m : Model) -> Model
cellSized cell m =
    { m | term = Vt.withCellSize cell m.term, tmux = TmuxMode.setCell (paneCell cell) m.tmux, tabs = tabsSized cell 0 m.tabs }


tabsSized : { width : Int, height : Int } -> Int -> (taken tabs : Builder (Maybe Tab)) -> Builder (Maybe Tab)
tabsSized cell i tabs =
    if i < Builder.length tabs then
        tabsSized cell (i + 1) (Builder.update i (Maybe.map (\t -> { t | term = Vt.withCellSize cell t.term, tmux = TmuxMode.setCell (paneCell cell) t.tmux })) tabs)

    else
        tabs


{-| The font opened again, or sized again, when the settings ask (ST4). -}
refontOr : Config -> Config -> (Config -> String) -> (taken applied : Model) -> Task Error Model
refontOr new old language applied =
    let
        refont =
            new.font /= old.font || language new /= language old || new.glyphCacheMb /= old.glyphCacheMb
    in
    if refont then
        Window.setFont { font = new.font, lang = language new, points = new.points, glyphCap = new.glyphCacheMb * 1024 * 1024 }
            |> Task.andThen
                (\done ->
                    when done is
                        Ok cell ->
                            Task.succeed (cellSized cell { applied | points = new.points })

                        Err why ->
                            meant Reason.Refused
                                Console.writeErr ("puritty: " ++ why ++ "; the font in use is kept\n")
                                    |> Task.map (\_ -> { applied | config = { new | font = old.font, language = old.language, glyphCacheMb = old.glyphCacheMb } })
                )

    else if new.points /= old.points then
        Window.zoom new.points |> Task.map (\cell -> cellSized cell { applied | points = new.points })

    else
        Task.succeed applied


{-| Ctrl+Comma, as Windows Terminal, VS Code and Ghostty open their
settings (`settings-ui.md` §1): in the usual key encoding a program cannot
tell it from a comma. -}
isSettingsKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
isSettingsKey config k =
    k.action /= 0 && bound config.keySettings k


{-| Whether a key is the one a `[keys]` entry names (docs/tabs.md TB6); an
empty entry, or one that names no key, is no key's. -}
bound : String -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
bound name k =
    when Chord.parse name is
        Ok (Just chord) ->
            Chord.matches chord k

        _ ->
            meant Reason.NotSet False


{-| The settings window started, not tied to this window; a failure said
on standard error. -}
openSettings : (taken m : Model) -> Task x Model
openSettings m =
    spawnSelf [ "settings" ] m


{-| This program started again with `args`, and `--config` when this
window was given one, not tied to this window (ST9, ST26); a failure said
on standard error. -}
spawnSelf : Array String -> (taken m : Model) -> Task x Model
spawnSelf args m =
    when m.settingsWindow is
        Just w ->
            Process.spawn w.cp w.program (args ++ Array.dropFirst 1 w.args) (Process.defaultSpawnOptions Ignored)
                |> Task.map (\_ -> {})
                |> Task.onError (\e -> Console.writeErr ("puritty: " ++ String.join " " args ++ ": " ++ Os.Error.toString e ++ "\n"))
                |> Task.map (\_ -> m)

        Nothing ->
            meant Reason.Refused Console.writeErr "puritty: this program's own file is not known, so no window can be started\n" |> Task.map (\_ -> m)


-- THE MENU (docs/settings.md ST9, ST26)


{-| Ctrl and the right button: the menu. -}
isMenuClick : Window.PointerEvent -> Bool
isMenuClick p =
    p.action == 0 && p.button == 2 && Bitwise.and p.mods 15 == 2


{-| The menu opened at a cell: the settings window, the host list, a
window of its own, then each host of the settings. -}
menuAt : Int -> Int -> Model -> Menu
menuAt row col m =
    { items = popupItems m
    , row = row
    , col = col
    , selected = 0
    }


{-| A menu's item: its words, and what it does. -}
type alias MenuItem =
    { label : String
    , does : MenuDoes
    }


{-| This program started again with these arguments, the shown tab
renamed or colored (docs/tabs.md TB9), or a new tab opened. -}
type MenuDoes
    = Starts (Array String)
    | Renames
    | Colors
    | Reopens
    | Marks
    | OpensTab
    | Customizes


{-| The menu's items: the settings window, the host list, a new tab, a
window of its own, the shown tab's name and color, then the recent
connections, newest first, and each host of the settings not among them
(docs/settings-gui.md SG19). -}
menuItems : Config -> Array Recent -> Array MenuItem
menuItems config recents =
    [ { label = "Settings…", does = Starts [ "settings" ] }
    , { label = "Hosts…", does = Starts [ "hosts" ] }
    , { label = "New tab", does = OpensTab }
    , { label = "New local window", does = Starts [ "shell" ] }
    , { label = "Rename tab…", does = Renames }
    , { label = "Tab color…", does = Colors }
    , { label = "Reopen closed tab", does = Reopens }
    ]
        ++ (if config.debugLog then
                [ { label = "Mark the diagnostic log", does = Marks } ]

            else
                []
           )
        ++ Array.map (\r -> { label = "Connect to " ++ Recent.name r, does = Starts (Recent.arguments r) }) recents
        ++ (config.hosts
                |> Array.keepIf (\h -> not (Array.member (Recent.Saved h.name) recents))
                |> Array.map (\h -> { label = "Connect to " ++ h.name, does = Starts [ "--host", h.name ] })
           )


{-| The pop-up menu's items: the menu's, and under tmux -CC "Customize
tmux…" after "New window", which opens tmux's customize-mode (docs/tmux.md
TM62). The system menu keeps the menu's own, whose places are fixed when
it is made. -}
popupItems : Model -> Array MenuItem
popupItems m =
    let
        items =
            menuItems m.config m.recents
    in
    if TmuxMode.isOn m.tmux then
        when Array.findFirst (\i -> i.label == "New window") items is
            Just at ->
                Array.slice 0 (at.index + 1) items ++ [ { label = "Customize tmux…", does = Customizes } ] ++ Array.dropFirst (at.index + 1) items

            Nothing ->
                meant Reason.NotKnown (Array.pushLast { label = "Customize tmux…", does = Customizes } items)

    else
        items


{-| The recent connections read again, as another window may have made
one: the system menu made again when they changed. -}
refreshRecents : (taken m : Model) -> Task x Model
refreshRecents m =
    loadRecents m.settings.given.fs m.logDir m.config
        |> Task.andThen
            (\recents ->
                if recents == m.recents then
                    Task.succeed m

                else
                    Window.systemMenu (Array.map .label (menuItems m.config recents))
                        |> Task.map (\_ -> { m | recents = recents })
            )


{-| What a chosen item does. -}
menuDo : MenuItem -> (taken m : Model) -> Task Error Model
menuDo item m =
    when item.does is
        Starts args ->
            spawnSelf args m

        Renames ->
            Task.succeed (startRenaming m)

        Colors ->
            Task.succeed (startColoring m)

        Reopens ->
            reopenTab m

        Marks ->
            markLog m

        OpensTab ->
            -- as Ctrl+Shift+T: a tab of puritty's, or tmux's new window
            -- under -CC
            if TmuxMode.isOn m.tmux then
                let
                    r =
                        TmuxMode.newWindow m.tmux
                in
                Task.succeed (sendCommands r.commands { m | tmux = r.state, urgent = True })

            else
                openTab m

        Customizes ->
            if TmuxMode.isOn m.tmux then
                let
                    r =
                        TmuxMode.customize m.tmux
                in
                Task.succeed (sendCommands r.commands { m | tmux = r.state, urgent = True })

            else
                Task.succeed m


{-| The menu at the pointer: the platform's own when it shows one
(Windows), else drawn over the screen. -}
openMenu : Window.PointerEvent -> (taken m : Model) -> Task x Model
openMenu p m =
    let
        items =
            popupItems m
    in
    Window.menu { x = p.x, y = p.y, items = Array.map .label items }
        |> Task.map
            (\shown ->
                if shown then
                    { m | shownItems = items }

                else
                    { m | menu = Just (menuAt (p.y // max 1 p.cellHeight) (p.x // max 1 p.cellWidth) m), urgent = True }
            )


{-| An item chosen in a menu the platform showed: the pop-up's (0) or the
system menu's (1), whose items are the menu's always. -}
menuChosen : { menu : Int, index : Int } -> (taken m : Model) -> Task Error Model
menuChosen c m =
    let
        items =
            if c.menu == 1 then
                menuItems m.config m.recents

            else
                m.shownItems
    in
    when Array.get c.index items is
        Just item ->
            menuDo item m

        Nothing ->
            meant Reason.OutOfRange Task.succeed m


{-| The menu's box: where it is drawn, kept on the screen. -}
menuBox : Menu -> (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> (r : { row : Int, col : Int, width : Int, height : Int } where 0 <= r.row && r.row <= 1000 && 0 <= r.col && r.col <= 1000 && 0 <= r.width && r.width <= 1000 && 0 <= r.height && r.height <= 1000)
menuBox menu cols rows =
    let
        width =
            clamp 0 cols (min 1000 (Array.foldl (\i w -> max w (String.count i.label)) 0 menu.items) + 6)

        height =
            clamp 0 rows (min 1000 (Array.length menu.items) + 2)
    in
    { row = clamp 0 rows (min menu.row (rows - height))
    , col = clamp 0 cols (min menu.col (cols - width))
    , width = width
    , height = height
    }


{-| The menu as the text painted over the screen: a box, the marked item
pointed at. -}
menuPaints : Menu -> (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> Array { row : Int, col : Int, text : String }
menuPaints menu cols rows =
    let
        box =
            menuBox menu cols rows

        inner =
            box.width - 2

        line i item =
            { row = box.row + 1 + i
            , col = box.col
            , text =
                "│"
                    ++ String.padRight inner
                        ' '
                        ((if i == menu.selected then
                            " ▸ "

                          else
                            "   "
                         )
                            ++ item.label
                        )
                    ++ "│"
            }
    in
    [ { row = box.row, col = box.col, text = "┌" ++ String.repeat inner "─" ++ "┐" } ]
        ++ Array.indexedMap line menu.items
        ++ [ { row = box.row + box.height - 1, col = box.col, text = "└" ++ String.repeat inner "─" ++ "┘" } ]


{-| A key while the menu is open: Up and Down move the mark, Enter starts
what it marks, Esc closes it; any other key closes it too. -}
menuKey : Int -> Menu -> (taken m : Model) -> Task Error Model
menuKey sym menu m =
    let
        count =
            Array.length menu.items
    in
    if sym == 0xFF52 then
        Task.succeed { m | menu = Just { menu | selected = modBy count (menu.selected - 1 + count) }, urgent = True }

    else if sym == 0xFF54 then
        Task.succeed { m | menu = Just { menu | selected = modBy count (menu.selected + 1) }, urgent = True }

    else if sym == 0xFF0D || sym == 0xFF8D then
        when Array.get menu.selected menu.items is
            Just item ->
                menuDo item { m | menu = Nothing, urgent = True }

            Nothing ->
                meant Reason.OutOfRange (Task.succeed { m | menu = Nothing, urgent = True })

    else
        Task.succeed { m | menu = Nothing, urgent = True }


{-| A press while the menu is open: on an item, what it says is started;
anywhere else the menu closes. -}
menuPress : Window.PointerEvent -> Menu -> (taken m : Model) -> Task Error Model
menuPress p menu m =
    let
        box =
            menuBox menu m.term.cols m.term.rows

        -- the pointer's cell, kept near the screen so that nothing
        -- computed from it can wrap
        cell =
            { row = clamp -1 2000 (p.y // max 1 p.cellHeight), col = clamp -1 2000 (p.x // max 1 p.cellWidth) }

        i =
            cell.row - box.row - 1

        inside =
            cell.col > box.col && cell.col < box.col + box.width - 1 && i >= 0 && i < Array.length menu.items
    in
    if inside && p.button == 1 then
        menuDo (Array.getProven i menu.items) { m | menu = Nothing, urgent = True }

    else
        Task.succeed { m | menu = Nothing, urgent = True }


{-| The frame just drawn, written to `PURITTY_SHOT`'s file when it is set. -}
shoot : (taken m : Model) -> Task x Model
shoot m =
    when m.shotPath is
        Just path ->
            Window.shot path |> Task.map (\_ -> m)

        Nothing ->
            meant Reason.NotSet Task.succeed m


{-| The time told to tmux's control mode, which closes the panes' numbers
when theirs is past (docs/tmux.md TM28), drawn again when it does. -}
tmuxTick : Int -> (taken m : Model) -> Model
tmuxTick ms m =
    let
        due =
            TmuxMode.dueAt m.tmux
    in
    let
        r =
            TmuxMode.tick ms m.tmux
    in
    sendCommands r.commands { m | tmux = r.state, urgent = m.urgent || (due >= 0 && Clock.reached due ms) }


{-| The time told to tmux's control mode, and, when tmux did not answer
after a line that was not its own (docs/tmux-checks.md TK14), control mode
ended with an empty read: its client is gone, and what the shell wrote
goes to the terminal. -}
tmuxDue : Backend -> Int -> (taken m : Model) -> Task Error Model
tmuxDue remote ms m =
    let
        ticked =
            tmuxTick ms m
    in
    if TmuxMode.givingUp ticked.tmux then
        feed remote Bytes.empty ms ticked

    else
        Task.succeed ticked


blink : Int -> (taken m : Model) -> Model
blink ms m =
    if blinking m && m.blinkAt >= 0 && Clock.reached m.blinkAt ms then
        { m | focus = { focused = m.focus.focused, blinkOn = not m.focus.blinkOn }, blinkAt = Clock.after ms m.config.blinkMs, urgent = True }

    else
        m


{-| What may wait to be written before the core's replies are dropped: a
program that asks and never reads its answers holds no more than this
(S§5.1). Keys and pastes are never dropped. -}
replyCap : Int
replyCap =
    1048576


{-| A read: what tmux control mode says, if it runs (docs/tmux.md TM14),
done to its panes and its commands queued; the rest fed to the core. -}
feed : Backend -> Bytes -> Int -> (taken m : Model) -> Task Error Model
feed remote chunk ms m =
    feedRead remote (ReadChunk chunk) ms m


{-| What `TmuxMode` is given: a read, or the answer to its question
before control mode (docs/tmux.md TM108). -}
type ReadOf
    = ReadChunk Bytes
    | EntryAnswer Bool


{-| A read, or the answer to the entry question, through `TmuxMode`: the
log, the terminal's bytes, the commands. -}
feedRead : Backend -> ReadOf -> Int -> (taken m : Model) -> Task Error Model
feedRead remote what ms m =
    let
        size =
            { cols = m.term.cols, rows = m.term.rows }

        r =
            when what is
                ReadChunk chunk ->
                    TmuxMode.read size chunk m.tmux

                EntryAnswer yes ->
                    TmuxMode.answerEntry size yes m.tmux

        length =
            when what is
                ReadChunk chunk ->
                    Bytes.length chunk

                EntryAnswer _ ->
                    0

        on =
            TmuxMode.isOn r.state

        -- what tmux said, or else the bytes read, in the log
        traced =
            (if Array.isEmpty r.trace && not on then
                Diag.add ms "read" (String.fromInt length ++ " bytes") m.diag

             else
                Diag.addAll ms "tmux<" r.trace m.diag
            )
                -- what puritty shows of tmux, when it changed (docs/tmux-checks.md
                -- TK11): what a test holds to tmux's own, and a stale tab is seen
                |> (\d ->
                        when r.view is
                            Just v ->
                                Diag.add ms "tmux=" v d

                            Nothing ->
                                meant Reason.NoMore d
                   )
    in
    feedTerm remote
        r.outside
        ms
        { m
            | tmux = r.state
            , turnMs = ms
            , diag = traced
            -- tmux's output paced as a program's own, a frame at most
            -- every frameMs: a pane that prints a burst (an app redrawing its
            -- whole transcript) is drawn as it ends, not chunk by chunk
            , urgent = m.urgent
            , pending =
                if on && m.pending < 0 then
                    ms

                else
                    m.pending
        }
        |> Task.map (\fed -> shellHostSeen (sendCommands r.commands fed))


{-| Whether a private mode is set for what keys and pastes reach: the
terminal's program, or under tmux control mode the active pane's
(docs/tmux.md TM16). -}
modeOn : Int -> Model -> Bool
modeOn mode m =
    if TmuxMode.isOn m.tmux then
        TmuxMode.activeMode mode m.tmux == Just True

    else
        Dict.get mode m.term.modes == Just True


{-| tmux commands as the lines written to it. -}
commandLines : Array String -> Bytes
commandLines commands =
    Bytes.fromString (String.join "" (Array.map (\c -> c ++ "\n") commands))


{-| A read fed to the core and its replies queued, while fewer than
`replyCap` bytes wait. -}
feedTerm : Backend -> Bytes -> Int -> (taken m : Model) -> Task Error Model
feedTerm remote chunk0 ms m =
    let
        -- an EUC-KR or CP949 pane's bytes in UTF-8 before the core (V49)
        decoded =
            if m.charset == Charset.Utf8 then
                { decoder = m.decoder, bytes = chunk0 }

            else
                Charset.decode m.decoder chunk0

        pushedBefore =
            Vt.rowsPushed m.term

        decoder =
            decoded.decoder

        -- listening as the diagnostic log is set (DG6), whatever tab
        fed =
            { m | term = Vt.feed decoded.bytes (Vt.listen (listeningOf m.config) m.term) }
    in
    -- a Kitty picture's file read, for a local program only (KG9)
    filesRead fed []
        |> Task.map (\r -> fedTerm r.said decoder pushedBefore ms r.model)


{-| The files the terminal's Kitty commands wait for, read and given, until
none waits (`docs/images-kitty.md` KG9); for an ssh session's program,
refused as before, since its paths name another machine's files. What
was read or refused, for the log. -}
filesRead : (taken m : Model) -> Array String -> Task x { model : Model, said : Array String }
filesRead m said =
    when Vt.fileWanted m.term is
        Just want ->
            (if not (isRemoteTab m) then
                ImageFile.read m.settings.given.fs want

             else
                Task.succeed (Err "EINVAL: unsupported medium")
            )
                |> Task.andThen
                    (\result ->
                        let
                            line =
                                want.path
                                    ++ (when result is
                                            Ok bytes ->
                                                ": " ++ String.fromInt (Bytes.length bytes) ++ " bytes read"

                                            Err why ->
                                                meant Reason.Refused (": " ++ why)
                                       )
                        in
                        filesRead { m | term = Vt.fileGiven result m.term } (Array.pushLast line said)
                    )

        Nothing ->
            meant Reason.NoMore Task.succeed { model = m, said = said }


{-| The rest of a read once the core has it: its replies queued, what it
asked for taken, and the view kept where it was. -}
fedTerm : Array String -> Charset.Decoder -> Int -> Int -> (taken m : Model) -> Model
fedTerm said decoder pushedBefore ms m =
    let
        replied =
            Vt.takeReplies m.term

        taken =
            let
                c =
                    Vt.takeClipboard replied.term

                h =
                    Vt.takeHeard c.term
            in
            { term = h.term, replies = replied.replies, clips = c.requests, heard = h.heard }

        held =
            syncHeld taken.term

        -- a selection's highlight goes when its rows are written over
        selection =
            kept m.selection taken.term

        -- a view scrolled back stays on its rows as more come in below it
        back =
            if m.back > 0 then
                min (Vt.scrollbackRows taken.term) (m.back + Vt.rowsPushed taken.term - pushedBefore)

            else
                0
    in
    Array.foldl
        (\r acc ->
            if Outbox.size acc.out >= replyCap then
                acc

            else
                send r acc
        )
        { m
            | term = taken.term
            -- bounded: a tab not shown keeps them until it is (MB6)
            , clips = ClipQueue.queued m.clips taken.clips
            , back = back
            , selection = selection
            , decoder = decoder
            , pending =
                if m.pending < 0 then
                    ms

                else
                    m.pending
            , syncSince =
                if not held then
                    -1

                else if m.syncSince < 0 then
                    ms

                else
                    m.syncSince
        }
        taken.replies
        |> logHeard taken.heard
        |> (\done -> Array.foldl (\line acc -> logLine "image file" line acc) done said)


{-| The window's events: a key sent to the program, a new size given to the
core and the terminal, the focus kept for the cursor and reported under
mode 1004, a close. -}
handle : Backend -> Int -> Array Window.Event -> (taken m : Model) -> Task Error Model
handle remote ms evs m =
    when Array.first evs is
        Nothing ->
            meant Reason.NoMore Task.succeed m

        Just ev ->
            let
                said =
                    eventLine ev
            in
            handleOne remote
                ms
                (Array.dropFirst 1 evs)
                ev
                { m
                    | shiftHeld = shiftAfter ev m.shiftHeld
                    , turnMs = ms
                    , diag =
                        when said is
                            Just l ->
                                Diag.add ms l.tag l.text m.diag

                            Nothing ->
                                meant Reason.NotKnown m.diag
                }


{-| Whether Shift is held after an event, for the pointer's shape (§21):
a Shift key pressed or released, the Shift bit of a pointer event, and not
once the focus has gone, since its release goes to another window. -}
shiftAfter : Window.Event -> Bool -> Bool
shiftAfter ev held =
    when ev is
        Window.Key k ->
            if k.sym == 0xFFE1 || k.sym == 0xFFE2 then
                k.action /= 0

            else
                held

        Window.Pointer p ->
            Bitwise.and p.mods 1 /= 0

        Window.Focus False ->
            False

        _ ->
            held


-- PURITTY'S OWN SCREEN, for the built-in ssh client (docs/ssh-client.md
-- SC9, SC18): what happens before the session runs, its questions, and
-- why it failed, written by puritty and never by the server, with the
-- window's title its own while it is up.


{-| Whether puritty's own screen is up: before the session runs, while it
asks, and after it failed. -}
ownScreenUp : Model -> Bool
ownScreenUp m =
    when m.ssh is
        Just screen ->
            not screen.started || screen.failed /= Nothing || screen.asking /= Nothing

        Nothing ->
            meant Reason.NotSet False


{-| A notice from the session, taken into the screen; when the session
starts, the window's size is sent to it, since the size its terminal was
asked with can be an old one: a jump host drops a resize made while it
connects (docs/ssh-client.md SC26). -}
sshTold : Session.Notice -> (taken m : Model) -> Task Error Model
sshTold told m =
    when told is
        Session.Started ->
            m.remote.resize (ptySize m.term.cols m.term.rows m.term)
                |> Task.map (\_ -> sshNoticed told m)
                |> Task.andThen rememberChanges

        Session.Asking (Session.HostKeyChanged k) ->
            -- asked by the platform's own dialog where there is one, which
            -- nothing the server prints can pass for (docs/ssh-client.md
            -- SC28); else in puritty's box, by its keys
            Window.warning { title = "puritty: " ++ cleanText k.host ++ "'s key has changed", text = String.join "\n" (changedLines k) ++ "\n\nYes: trust the new key, and put it in place of the old one.\nNo: trust it for this connection only.\nCancel: do not connect. If you did not expect the change, this is the safe choice." }
                |> Task.andThen
                    (\got ->
                        let
                            asked =
                                sshNoticed told m
                        in
                        when { got = got, ssh = asked.ssh } is
                            { got = 1, ssh = Just screen } ->
                                sshAnswered asked.remote (Session.Trust { remember = True }) "the changed key is trusted, in place of the old one" screen asked

                            { got = 2, ssh = Just screen } ->
                                sshAnswered asked.remote (Session.Trust { remember = False }) "the changed key is trusted this once" screen asked

                            { got = 3, ssh = Just screen } ->
                                sshAnswered asked.remote Session.Decline "the changed key is not trusted" screen asked

                            _ ->
                                Task.succeed asked
                    )

        Session.Asking ask ->
            sshAsked ask m

        Session.Side side ->
            sideEvent side m

        Session.Ended ->
            Task.succeed (sshNoticed told (sendingLost (uploadLost m)))

        Session.Failed _ ->
            Task.succeed (sshNoticed told (uploadLost m))

        _ ->
            Task.succeed (sshNoticed told m)


-- A PICTURE PASTED (docs/sftp.md FT13)


{-| How long a note stays up. -}
noteMs : Int
noteMs =
    6000


{-| A note put up, and the same in the log. A note kept (`kept`) stays
until another replaces it. -}
noteUp : { text : String, failed : Bool, kept : Bool } -> (taken m : Model) -> Model
noteUp n m =
    logLine "paste"
        n.text
        { m
            | note =
                Just
                    { text = n.text
                    , failed = n.failed
                    , until =
                        if n.kept then
                            -1

                        else
                            Clock.after m.turnMs noteMs
                    }
            , urgent = True
        }


{-| The note gone when its time has come. -}
expireNote : Int -> (taken m : Model) -> Model
expireNote ms m =
    when m.note is
        Just n ->
            if n.until >= 0 && Clock.reached n.until ms then
                { m | note = Nothing, urgent = True }

            else
                m

        Nothing ->
            meant Reason.NotOpen m


noteDue : Model -> Int
noteDue m =
    when m.note is
        Just n ->
            n.until

        Nothing ->
            meant Reason.NotOpen -1


{-| A size as a person reads it: bytes, KB or MB. -}
sizeText : Int -> String
sizeText n =
    if n < 1024 then
        String.fromInt n ++ " bytes"

    else if n < 1048576 then
        String.fromInt (n // 1024) ++ " KB"

    else
        String.fromInt (n // 1048576) ++ "." ++ String.fromInt (modBy 1048576 n * 10 // 1048576) ++ " MB"


{-| The clipboard's picture, PNG, pasted as a file's name where the tab's
program runs: over a channel beside an ssh session, to the host's paste
folder; on Linux, for a local tab, to a folder of puritty's
(`Platform.pasteDirectory`); on Windows, for a local tab, an empty
bracketed paste, which Claude Code in WSL takes as the cue to read the
clipboard itself, as Windows Terminal sends it. A tab on OpenSSH's `ssh`
has no channel puritty can use, and says so. No picture: nothing. With
`[clipboard] paste_images = "deny"`, nothing written and that said; with
"ask", the file's path asked about first (docs/sftp.md FT16).
-}
imagePasted : Bytes -> (taken m : Model) -> Task Error Model
imagePasted png m =
    if Bytes.isEmpty png then
        Task.succeed (logLine "paste" "the clipboard holds no text and no picture" m)

    else if m.config.pasteImages == "deny" then
        Task.succeed (noteUp { text = "The clipboard holds a picture, which is not pasted: paste_images is \"deny\"", failed = True, kept = False } m)

    else
        when m.remote.side is
            Just side ->
                uploadImage side png m

            Nothing ->
                -- a tab with no ssh session of puritty's: on this computer, or
                -- OpenSSH's ssh
                meant Reason.NotOpen
                    if isRemoteTab m then
                        Task.succeed (noteUp { text = "The picture can't be pasted: this tab's ssh is OpenSSH's, which puritty can't send a file through here (set client = \"built-in\")", failed = True, kept = False } m)

                    else
                        Os.Env.getEnvironmentVariables
                            |> Task.andThen
                                (\vars ->
                                    when Platform.pasteDirectory vars is
                                        Just dir ->
                                            localImage dir png m

                                        Nothing ->
                                            meant Reason.NotSet Task.succeed (emptyPaste m)
                                )


{-| The paste folder as the host's `sh` reads it, in double quotes: `~/`
the home there; empty for `~/.cache/puritty/paste`, `$XDG_CACHE_HOME`'s
when set; whatever else it holds as it is (docs/sftp.md FT15). -}
folderWord : String -> String
folderWord folder =
    if folder == "" then
        "\"${XDG_CACHE_HOME:-$HOME/.cache}/puritty/paste\""

    else if folder == "~" then
        "\"$HOME\""

    else if String.startsWith "~/" folder then
        "\"$HOME/" ++ doubleQuoted (String.dropFirst 2 folder) ++ "\""

    else
        "\"" ++ doubleQuoted folder ++ "\""


{-| A script run under `sh -c`, whatever the user's shell is: in single
quotes, each `'` in it closed and opened again. -}
underSh : String -> String
underSh script =
    "sh -c '" ++ String.replace "'" "'\\''" script ++ "'"


{-| What the host runs to say where its paste folder is, before the user is
asked (FT16): the folder's path written back, nothing made or changed. -}
folderCommand : String -> String
folderCommand folder =
    underSh ("d=" ++ folderWord folder ++ "; printf \"%s\" \"$d\"")


{-| What the host runs to keep a pasted picture (docs/sftp.md FT13, FT15,
FT16): in `folder`, made if it is not there, the file `name`, chosen by
puritty so that it can be shown before anything is written, mode 0600.
Its bytes come from standard input to `NAME.part`, made only if it is not
there, and it is renamed to `name` once all are there, if nothing has that
name; its path is written back. puritty's own pictures there more than a
day old are removed first, those whose names begin `puritty-paste.`, in
the folder itself, and nothing else, so that a folder of the user's
choosing is safe. -}
uploadCommand : String -> String -> String
uploadCommand folder name =
    underSh
        ("umask 077; d="
            ++ folderWord folder
            ++ "; mkdir -p \"$d\" || exit 1; find \"$d\" -maxdepth 1 -type f -name \"puritty-paste.*\" -mmin +1440 -exec rm -f {} + 2>/dev/null; f=\"$d/"
            ++ name
            ++ "\"; p=\"$f.part\"; set -C; cat > \"$p\" || exit 1; if [ -e \"$f\" ]; then rm -f \"$p\"; echo \"$f is there already\" >&2; exit 1; fi; mv \"$p\" \"$f\" && printf \"%s\" \"$f\""
        )


{-| Text inside a shell's double quotes as it is: `\`, `"`, `$` and a
backquote escaped. -}
doubleQuoted : String -> String
doubleQuoted text =
    text
        |> String.replace "\\" "\\\\"
        |> String.replace "\"" "\\\""
        |> String.replace "$" "\\$"
        |> String.replace "`" "\\`"


{-| Whether the shown tab's ssh session is up, so that a channel can be
opened beside it. -}
sideUp : Model -> Bool
sideUp m =
    when m.ssh is
        Just screen ->
            screen.started && screen.failed == Nothing && screen.exitStatus == Nothing

        Nothing ->
            -- a tab of OpenSSH's ssh with helpers (FT31): up while its ssh
            -- runs; a helper that finds no master fails, and says so
            meant Reason.NotSet (Maybe.isJust m.remote.side)


{-| A picture for an ssh session's host, under a name of puritty's
(`puritty-paste.` and ten random hex digits): sent at once with
`paste_images = "allow"`; with "ask", the host asked for its folder's path
first, so that the question can name the file (FT16). -}
uploadImage : (Session.Input -> Task Error {}) -> Bytes -> (taken m : Model) -> Task Error Model
uploadImage side png m =
    if m.upload /= Nothing then
        Task.succeed (noteUp { text = "A picture is still being sent to the host; paste again when it is done", failed = True, kept = False } m)

    else if not (sideUp m) then
        Task.succeed (noteUp { text = "The picture can't be pasted: the tab is not connected", failed = True, kept = False } m)

    else
        Os.Random.bytes 5
            |> Task.andThen
                (\random ->
                    let
                        name =
                            "puritty-paste." ++ Bytes.toHexString { padding = False } random ++ ".png"

                        ref =
                            m.uploads + 1
                    in
                    if m.config.pasteImages == "allow" then
                        sendImage side png name m

                    else
                        when inHostCharset m.charset (folderCommand (pasteFolderOf m)) is
                            Nothing ->
                                meant Reason.FromOutside (Task.succeed (noteUp { text = unwritable m, failed = True, kept = False } m))

                            Just command ->
                                side (Session.OpenExec { ref = ref, command = command })
                                    |> Task.andThen (\_ -> side (Session.SideEof ref))
                                    |> Task.map
                                        (\_ ->
                                            logLine "paste"
                                                "the host asked where its paste folder is"
                                                { m | upload = Just { ref = ref, size = Bytes.length png, out = Bytes.empty, err = Bytes.empty, status = Nothing, asking = Just { png = png, name = name } }, uploads = ref }
                                        )
                )


{-| The picture sent to the host as `name` in its paste folder, over a
new channel beside the session. -}
sendImage : (Session.Input -> Task Error {}) -> Bytes -> String -> (taken m : Model) -> Task Error Model
sendImage side png name m =
    let
        ref =
            m.uploads + 1
    in
    when inHostCharset m.charset (uploadCommand (pasteFolderOf m) name) is
        Nothing ->
            meant Reason.FromOutside (Task.succeed (noteUp { text = unwritable m, failed = True, kept = False } m))

        Just command ->
            sendCommand side ref command png m


sendCommand : (Session.Input -> Task Error {}) -> Int -> Bytes -> Bytes -> (taken m : Model) -> Task Error Model
sendCommand side ref command png m =
    side (Session.OpenExec { ref = ref, command = command })
        |> Task.andThen (\_ -> side (Session.SideWrite { ref = ref, bytes = png }))
        |> Task.andThen (\_ -> side (Session.SideEof ref))
        |> Task.map
            (\_ ->
                noteUp { text = "Sending the picture (" ++ sizeText (Bytes.length png) ++ ") to the host", failed = False, kept = True }
                    { m | upload = Just { ref = ref, size = Bytes.length png, out = Bytes.empty, err = Bytes.empty, status = Nothing, asking = Nothing }, uploads = ref }
            )


{-| Where the shown tab's host keeps pasted pictures: the host's own
`paste_folder`, else the settings'. -}
pasteFolderOf : Model -> String
pasteFolderOf m =
    m.tab.host
        |> Maybe.andThen .pasteFolder
        |> Maybe.withDefault (meant Reason.NotSet m.config.pasteFolder)


{-| What the channel carrying a picture told: its output kept, and at its
end the file's path pasted, or why it could not be. -}
uploaded : { ref : Int, event : Connection.Event } -> (taken m : Model) -> Model
uploaded side m =
    when m.upload is
        Just u ->
            if u.ref /= side.ref then
                m

            else
                when side.event is
                    Connection.Output b ->
                        { m | upload = Just { u | out = Bytes.flatten [ u.out, b ] } }

                    Connection.ErrorOutput b ->
                        { m | upload = Just { u | err = Bytes.flatten [ u.err, b ] } }

                    Connection.Refused why ->
                        { m | upload = Just { u | err = Bytes.flatten [ u.err, Bytes.fromString why ] } }

                    Connection.Exited status ->
                        { m | upload = Just { u | status = Just status } }

                    Connection.Killed _ ->
                        { m | upload = Just { u | status = Just 255 } }

                    Connection.Ended ->
                        uploadDone u { m | upload = Nothing }

                    _ ->
                        m

        Nothing ->
            meant Reason.NotOpen m


uploadDone : Upload -> (taken m : Model) -> Model
uploadDone u m =
    let
        -- in the host's character set, as the tab reads it (FT20)
        path =
            String.trim (fromHost m.charset u.out)

        said =
            String.trim (fromHost m.charset u.err)
    in
    if u.status == Just 0 && path /= "" then
        when u.asking is
            Just a ->
                -- the folder's path: the question, naming the file
                -- (docs/sftp.md FT16)
                askPaste
                    { png = a.png
                    , path =
                        (if String.endsWith "/" path then
                            path

                         else
                            path ++ "/"
                        )
                            ++ a.name
                    , to = ToHost a.name
                    , on = "on " ++ hostLabel m
                    , tab = m.tab.id
                    }
                    m

            Nothing ->
                meant Reason.NotOpen pasteIn False (Bytes.fromString (quotedPath path)) (noteUp { text = "Pasted the picture as " ++ path, failed = False, kept = False } m)

    else
        noteUp
            { text =
                "The picture could not be sent to the host: "
                    ++ (if said /= "" then
                            String.join " " (String.lines said)

                        else
                            when u.status is
                                Just status ->
                                    "its command ended with status " ++ String.fromInt status

                                Nothing ->
                                    meant Reason.FromOutside "the channel closed"
                       )
            , failed = True
            , kept = False
            }
            m


{-| Text for a command on the host, in the tab's character set, as typed
keys are sent (docs/sftp.md FT20): `Nothing` when a character has no form
there, rather than a `?` in a folder's name. -}
inHostCharset : Charset -> String -> Maybe Bytes
inHostCharset charset text =
    let
        encoded =
            Charset.encode charset (Bytes.fromString text)
    in
    if encoded.replaced == 0 then
        Just encoded.bytes

    else
        Nothing


{-| What the host's command printed, in the tab's character set, as text. -}
fromHost : Charset -> Bytes -> String
fromHost charset bytes =
    when charset is
        Charset.Utf8 ->
            Bytes.toStringLossy bytes

        Charset.EucKr ->
            Bytes.toStringLossy (Charset.decode Charset.decoder bytes).bytes

        Charset.Cp949 ->
            Bytes.toStringLossy (Charset.decode Charset.decoder bytes).bytes


charsetName : Charset -> String
charsetName charset =
    when charset is
        Charset.Utf8 ->
            "UTF-8"

        Charset.EucKr ->
            "EUC-KR"

        Charset.Cp949 ->
            "CP949"


unwritable : Model -> String
unwritable m =
    "The picture can't be pasted: the paste folder's name has characters " ++ charsetName m.charset ++ " cannot write"


{-| Files dropped on the window (docs/sftp.md FT22): in a tab on this
computer, their paths pasted, quoted for its shell, as other terminals do
(FT5 question 6). Each must be there first: a name a file manager spoiled
(FT21: Dolphin's U+FFFD for an EUC-KR name) names no file, and is said, as
given, not pasted. A name not UTF-8 is read in the tab's character set, so
that the paste gives the shell the name's own bytes; one that set can't
carry is not pasted. A drop with no file on disk (FT21: a file inside a
zip, an attachment) says so. -}
filesDropped : Bytes -> (taken m : Model) -> Task Error Model
filesDropped list m =
    let
        dropped =
            Drop.paths list

        fs =
            m.settings.given.fs
    in
    dropped.paths
        |> Array.map
            (\p ->
                File.exists fs (Path.fromBytes p)
                    |> Task.onError (\_ -> Task.succeed False)
                    |> Task.map (\there -> { path = p, there = there })
            )
        |> Task.sequence
        |> Task.map (\checked -> droppedChecked dropped.others checked m)


{-| Files dropped on an ssh tab: on a tmux pane whose folder is known,
that folder; else the folder chooser, over an SFTP channel of its own
(FT24), from the host's home. Sending them is item 4's: until then the
note says where they would have gone. -}
sshDropped : Array Bytes -> (taken m : Model) -> Model
sshDropped files m0 =
    let
        -- files dropped on the folder picker: the folder under them, the
        -- user's choice (docs/sftp.md FT32)
        picked =
            Maybe.andThen (\c -> Picker.dropTarget (overlaySize m0) (hostWith m0) (Picker.dragPoint c.picker) c.picker) m0.choosing

        known =
            when TmuxMode.dropTarget m0.tmux |> Maybe.map .folder is
                Just (TmuxMode.Folder path) ->
                    Just path

                Just (TmuxMode.NoFolder _) ->
                    Nothing

                Just (TmuxMode.Asking _) ->
                    Nothing

                Nothing ->
                    -- no tmux pane marked: a tab without tmux -CC, whose
                    -- shell may have said its folder (FT29)
                    meant Reason.NotOpen (shellFolder m0)

        why =
            dropWhere m0

        m =
            { m0 | tmux = TmuxMode.dragLeft m0.tmux, urgent = True }
    in
    if m.config.dropUploads == "deny" then
        noteUp { text = "Dropped files are not sent to the host: [files] drop_uploads is \"deny\"", failed = True, kept = False } m

    else if Maybe.isJust picked then
        { m | pendingSend = Maybe.map (\folder -> { folder = folder, files = files }) picked, choosing = Maybe.map (\c -> { c | ending = True }) m.choosing }

    else
        when known is
            Just folder ->
                if m.config.dropUploads == "allow" then
                    -- sent when this drop's handling is done (`startPending`)
                    { m | pendingSend = Just { folder = folder, files = files } }

                else
                    -- asked first (docs/sftp.md FT28): the folder is
                    -- puritty's choice, not the user's
                    logLine "drop" ("asked: send " ++ String.fromInt (Array.length files) ++ " items to the folder found?") { m | dropAsk = Just { folder = folder, files = files, tab = m.tab.id } }

            Nothing ->
                -- no folder known: the chooser asks
                meant Reason.NotYet
                    (if not (Maybe.isJust m.remote.side) then
                        noteUp { text = "Files can't be sent to this host: this tab's ssh is OpenSSH's (set client = \"built-in\")", failed = True, kept = False } m

                     else if Maybe.isJust m.choosing then
                        noteUp { text = "The folder chooser is open already", failed = True, kept = False } m

                     else
                        chooserOpened files Bytes.empty m
                    )


{-| Files sent once their folder is known (docs/sftp.md FT25): the jobs
made from them, and the batch begun. -}
startPending : (taken m : Model) -> Task Error Model
startPending m0 =
    when m0.pendingSend is
        Just p ->
            let
                m =
                    { m0 | pendingSend = Nothing }
            in
            if Maybe.isJust m.sending then
                Task.succeed (noteUp { text = "Files are still being sent; drop these again when they are done", failed = True, kept = False } m)

            else
                Sending.jobsFor m.settings.given.fs { folder = p.folder, paths = p.files, name = hostName m.charset }
                    |> Task.andThen
                        (\j ->
                            let
                                ref =
                                    m.uploads + 1

                                st =
                                    Sending.begin { ref = ref, tab = m.tab.id, folder = p.folder, jobs = j.jobs, refused = j.refused, allowShell = m.config.uploadThroughShell, ms = m.turnMs }
                            in
                            -- the shell's channels, should SFTP be refused, are
                            -- numbered after `ref`: a block of them kept
                            sendingStep st (logLine "drop" ("sending " ++ String.fromInt (Array.length j.jobs) ++ " items, " ++ String.fromInt (Array.length j.refused) ++ " refused") { m | uploads = ref + 100000 })
                        )

        Nothing ->
            meant Reason.NotSet (Task.succeed m0)


{-| A local file's name as the host's (FT21's answers): UTF-8 in the
host's character set; a name not UTF-8 as its bytes to a host in EUC-KR
or CP949, and refused for a UTF-8 one. -}
hostName : Charset -> Bytes -> Result String Bytes
hostName charset local =
    when Bytes.toString local is
        Just text ->
            when inHostCharset charset text is
                Just b ->
                    Ok b

                Nothing ->
                    meant Reason.FromOutside (Err ("its name has characters " ++ charsetName charset ++ " cannot write"))

        Nothing ->
            -- not UTF-8: already in the host's set, or no name it can take
            meant Reason.FromOutside
                (if charset == Charset.Utf8 then
                    Err "its name is not UTF-8, which this host's UTF-8 can't take"

                 else
                    Ok local
                )


{-| A step of the batch: its outs done in order, each local read told back
as it is done; the progress shown, and at the end what was sent. -}
sendingStep : { sending : Sending.Sending, out : Array Sending.Out } -> (taken m : Model) -> Task Error Model
sendingStep taken m =
    when m.remote.side is
        Just side ->
            Array.foldl
                (\o acc -> acc |> Task.andThen (sendingOut side o))
                -- a frame only for what the screen shows: the question,
                -- and the progress a few times a second (`sendingShown`);
                -- a frame each reply held a shown tab's upload to a fifth
                -- of a hidden one's (FT27)
                (Task.succeed { m | sending = Just taken.sending, urgent = m.urgent || Sending.isAsking taken.sending })
                taken.out
                |> Task.andThen sentRecent
                |> Task.map sendingShown

        Nothing ->
            meant Reason.Gone (Task.succeed (sendingShown { m | sending = Just taken.sending }))


{-| A batch over with anything sent: its folder first among the host's
recent ones (docs/sftp.md FT33); one that sent nothing is not. -}
sentRecent : (taken m : Model) -> Task Error Model
sentRecent m =
    when m.sending is
        Just s ->
            if Maybe.isJust s.over && s.done > 0 then
                folderSent s.folder m

            else
                Task.succeed m

        Nothing ->
            meant Reason.NotOpen (Task.succeed m)


sendingOut : (Session.Input -> Task Error {}) -> Sending.Out -> (taken m : Model) -> Task Error Model
sendingOut side o m =
    when o is
        Sending.Input i ->
            side i |> Task.map (\_ -> m)

        Sending.Read r ->
            File.withHandle m.settings.given.fs File.ForRead r.path (\h -> File.seek (File.FromStart r.offset) h |> Task.andThen (\_ -> readUpTo r.length h []))
                |> Task.map Ok
                |> Task.onError (\e -> Task.succeed (Err (Os.Error.toString e)))
                |> Task.andThen
                    (\got ->
                        when m.sending is
                            Just s ->
                                when got is
                                    Ok bytes ->
                                        sendingStep (Sending.localRead { job = r.job, offset = r.offset, bytes = bytes } s) m

                                    Err why ->
                                        -- the file can't be read here now
                                        meant Reason.Refused (sendingStep (Sending.localFailed { job = r.job, why = why } s) m)

                            Nothing ->
                                meant Reason.Gone (Task.succeed m)
                    )


{-| Up to `n` bytes from a handle's place, fewer at the file's end. -}
readUpTo : Int -> File.Handle -> Array Bytes -> Task Os.Error.Error Bytes
readUpTo n h pieces =
    let
        have =
            Array.foldl (\p acc -> acc + Bytes.length p) 0 pieces
    in
    if have >= n then
        Task.succeed (Bytes.slice 0 n (Bytes.flatten pieces))

    else
        File.read h
            |> Task.andThen
                (\b ->
                    if Bytes.isEmpty b then
                        Task.succeed (Bytes.flatten pieces)

                    else
                        readUpTo n h (Array.pushLast b pieces)
                )


{-| The batch's progress in the note bar, kept while it runs; at its end
what was sent, and the batch gone. -}
sendingShown : (taken m : Model) -> Model
sendingShown m =
    when m.sending is
        Just s ->
            when s.over is
                Just said ->
                    noteUp
                        { text =
                            if isShownTab m then
                                said

                            else
                                -- a tab not shown: which one it was
                                "In the tab " ++ tabLabel m.tab m.term.title ++ ": " ++ said
                        , failed = not (Array.isEmpty s.failed && Array.isEmpty s.refused) || s.done == 0
                        , kept = False
                        }
                        { m | sending = Nothing, urgent = True }

                Nothing ->
                    -- still sending: its progress
                    meant Reason.NotYet
                        (when Sending.progressText m.turnMs s is
                            Just text ->
                                -- over its own tab only: a tab not shown has
                                -- its mark in the bar
                                if isShownTab m && (s.shownAt < 0 || m.turnMs - s.shownAt >= 250) then
                                    { m | note = Just { text = text, failed = False, until = -1 }, sending = Just { s | shownAt = m.turnMs }, urgent = True }

                                else
                                    m

                            Nothing ->
                                -- under a second in: no progress shown
                                meant Reason.NotYet m
                        )

        Nothing ->
            meant Reason.NotOpen m


{-| Whether the model's tab is the one on the screen, not one `atTab` has
swapped in to handle what its session said. -}
isShownTab : Model -> Bool
isShownTab m =
    Array.get m.shown m.order == Just m.tab.id


{-| The session ended under a batch: said, and forgotten. -}
sendingLost : (taken m : Model) -> Model
sendingLost m =
    if Maybe.isJust m.sending then
        noteUp { text = "The connection ended before the files were sent", failed = True, kept = False } { m | sending = Nothing }

    else
        m


{-| A key while the conflict question is up (FT4): R replace, K keep both,
S skip, N replace if newer, Enter replace, Esc cancels the batch. -}
conflictKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Sending.Sending -> (taken m : Model) -> Task Error Model
conflictKey k s m =
    if k.sym == 0xFF0D || k.sym == 0xFF8D || k.sym == 0x72 || k.sym == 0x52 then
        sendingStep (Sending.answer Transfer.Replace s) { m | urgent = True }

    else if k.sym == 0x6B || k.sym == 0x4B then
        sendingStep (Sending.answer Transfer.KeepBoth s) { m | urgent = True }

    else if k.sym == 0x73 || k.sym == 0x53 then
        sendingStep (Sending.answer Transfer.Skip s) { m | urgent = True }

    else if k.sym == 0x6E || k.sym == 0x4E then
        sendingStep (Sending.answer Transfer.ReplaceIfNewer s) { m | urgent = True }

    else if k.sym == 0xFF1B then
        sendingStep (Sending.cancel s) { m | urgent = True }

    else
        Task.succeed m


conflictPress : Window.PointerEvent -> Sending.Sending -> (taken m : Model) -> Task Error Model
conflictPress p s m =
    let
        hit =
            if p.button == 1 then
                Maybe.andThen (\cs -> Dialog.buttonAt (overlaySize m) (Sending.conflictBox (fromHost m.charset) cs) { x = p.x, y = p.y }) s.asking

            else
                Nothing
    in
    when hit is
        Just 0 ->
            sendingStep (Sending.answer Transfer.Replace s) { m | urgent = True }

        Just 1 ->
            sendingStep (Sending.answer Transfer.KeepBoth s) { m | urgent = True }

        Just 2 ->
            sendingStep (Sending.answer Transfer.Skip s) { m | urgent = True }

        Just _ ->
            sendingStep (Sending.answer Transfer.ReplaceIfNewer s) { m | urgent = True }

        Nothing ->
            meant Reason.OutOfRange (Task.succeed m)


{-| Whether the conflict question is up. -}
sendingAsks : Model -> Bool
sendingAsks m =
    Maybe.map Sending.isAsking m.sending == Just True


{-| The folder picker for `files`, at `at` (the host's home when empty),
listing over an SFTP channel of its own (docs/sftp.md FT32); its channel
is opened by `chooserIo`. -}
chooserOpened : Array Bytes -> Bytes -> (taken m : Model) -> Model
chooserOpened files at m =
    let
        host =
            folderHost m

        marks =
            hostMarks host m

        opened =
            Picker.open
                { host = hostLabel m
                , files = files
                , at =
                    if Bytes.isEmpty at then
                        Bytes.fromString "~"

                    else
                        at
                , places = { shell = shellFolder m, home = Nothing, recent = Folders.recentOn host.key m.folders, bookmarks = marks }
                }

        begun =
            PickerSftp.start

        asked =
            askAll opened.requests begun.source
    in
    logLine "drop"
        ("the folder chooser opened for " ++ String.fromInt (Array.length files) ++ " files")
        { m
            | choosing = Just { ref = m.uploads + 1, tab = m.tab.id, picker = opened.picker, source = asked.source, files = files, opened = False, toSend = Bytes.flatten [ begun.send, asked.send ], ending = False, host = host, marks = marks }
            , uploads = m.uploads + 1
        }


{-| The picker's requests made SFTP requests. -}
askAll : Array Picker.Request -> PickerSftp.Source -> { source : PickerSftp.Source, send : Bytes }
askAll requests source =
    let
        asked =
            Array.foldl
                (\q acc ->
                    let
                        a =
                            PickerSftp.ask q acc.source
                    in
                    { source = a.source, send = Array.pushLast a.send acc.send }
                )
                { source = source, send = [] }
                requests
    in
    { source = asked.source, send = Bytes.flatten asked.send }


{-| The tab's host as the folder picker keeps its folders. -}
folderHost : Model -> FolderHost
folderHost m =
    let
        name =
            when m.tab.host is
                Just h ->
                    Just h.name

                Nothing ->
                    meant Reason.NotSet m.tab.hostName

        saved =
            Maybe.andThen
                (\n ->
                    if Array.any (\h -> h.name == n) m.config.hosts then
                        Just n

                    else
                        Nothing
                )
                name
    in
    when saved is
        Just n ->
            { key = Folders.Saved n, saved = Just n }

        Nothing ->
            meant Reason.NotKnown
                { key =
                    when m.tab.host is
                        Just h ->
                            Folders.Ssh (Maybe.withDefault (meant Reason.NotSet "") (Maybe.map (\u -> u ++ "@") h.user) ++ h.host ++ ":" ++ String.fromInt (Maybe.withDefault (meant Reason.NotSet 22) h.port))

                        Nothing ->
                            meant Reason.NotSet (Folders.Ssh (hostLabel m))
                , saved = Nothing
                }


{-| A host's bookmarks: a saved host's from its table, in the host's
character set; another's from the state folder. -}
hostMarks : FolderHost -> Model -> Array Bytes
hostMarks host m =
    when host.saved is
        Just name ->
            Array.findFirst (\h -> h.name == name) m.config.hosts
                |> Maybe.map (\saved -> Array.mapAndKeepJust (inHostCharset m.charset) saved.value.bookmarks)
                |> Maybe.withDefault (meant Reason.NotKnown [])

        Nothing ->
            meant Reason.NotSet (Folders.bookmarksOn host.key m.folders)


{-| The picker's bookmarks kept, when they changed while it was up: a
saved host's in its table of the settings (`SettingsFile.change`, an edit
in place), another's in the state folder. -}
marksKept : Choosing -> Picker.Picker -> (taken m : Model) -> Task Error Model
marksKept c picker m =
    let
        now =
            Picker.bookmarks picker
    in
    if now == c.marks then
        Task.succeed m

    else
        when c.host.saved is
            Just name ->
                when m.settings.given.file is
                    Just f ->
                        let
                            tomlKey =
                                [ "hosts", name, "bookmarks" ]

                            edit doc =
                                if Array.isEmpty now then
                                    Toml.Edit.remove tomlKey doc

                                else
                                    Toml.Edit.set tomlKey (Toml.Edit.array (Array.map (\b -> Toml.Edit.string (fromHost m.charset b)) now)) doc
                        in
                        SettingsFile.change edit (SettingsFile.store m.settings.given.fs f.path)
                            |> Task.map (\_ -> Ok {})
                            |> Task.onError (\why -> Task.succeed (Err why))
                            |> Task.map
                                (\written ->
                                    when written is
                                        Ok _ ->
                                            logLine "drop" "the bookmarks kept in the settings" m

                                        Err why ->
                                            meant Reason.Refused (noteUp { text = "The bookmarks were not kept: " ++ why, failed = True, kept = False } m)
                                )

                    Nothing ->
                        meant Reason.NotSet (Task.succeed m)

            Nothing ->
                -- a host the settings have no table for
                meant Reason.NotKnown
                    (when stateFolder m.logDir is
                        Just dir ->
                            FolderFile.marked m.settings.given.fs dir c.host.key now |> Task.map (\folders -> { m | folders = folders })

                        Nothing ->
                            meant Reason.NotSet (Task.succeed m)
                    )


{-| Files sent to a folder on the tab's host: it first among the host's
recent folders. -}
folderSent : Bytes -> (taken m : Model) -> Task Error Model
folderSent folder m =
    when stateFolder m.logDir is
        Just dir ->
            FolderFile.sentTo m.settings.given.fs dir (folderHost m).key folder |> Task.map (\folders -> { m | folders = folders })

        Nothing ->
            meant Reason.NotSet (Task.succeed m)


{-| How the host's names read and a typed path is written: in the tab's
character set (FT20). -}
hostWith : Model -> Picker.With
hostWith m =
    { decode = fromHost m.charset, encode = inHostCharset m.charset }


{-| The picker's channel opened and its bytes sent, when it has any; or,
a drop on it having chosen, closed. -}
chooserIo : (taken m : Model) -> Task Error Model
chooserIo m =
    when { c = m.choosing, side = m.remote.side } is
        { c = Just c, side = Just side } ->
            if c.ending then
                (if c.opened then
                    side (Session.SideClose c.ref)

                 else
                    Task.succeed {}
                )
                    |> Task.map (\_ -> { m | choosing = Nothing, urgent = True })
                    |> Task.andThen (marksKept c c.picker)

            else
                (if c.opened then
                    Task.succeed {}

                 else
                    side (Session.OpenSubsystem { ref = c.ref, name = "sftp" })
                )
                    |> Task.andThen
                        (\_ ->
                            if Bytes.isEmpty c.toSend then
                                Task.succeed {}

                            else
                                side (Session.SideWrite { ref = c.ref, bytes = c.toSend })
                        )
                    |> Task.map (\_ -> { m | choosing = Just { c | opened = True, toSend = Bytes.empty } })

        _ ->
            Task.succeed m


{-| A side channel's event: the chooser's, or the picture's upload. -}
sideEvent : { ref : Int, event : Connection.Event } -> (taken m : Model) -> Task Error Model
sideEvent side m =
    when m.sending is
        Just s ->
            if Sending.owns side.ref s then
                sendingStep (Sending.side side s) m

            else
                chooserEvent side m

        Nothing ->
            meant Reason.NotOpen (chooserEvent side m)


chooserEvent : { ref : Int, event : Connection.Event } -> (taken m : Model) -> Task Error Model
chooserEvent side m =
    when m.choosing is
        Just c ->
            if c.ref /= side.ref then
                Task.succeed (uploaded side m)

            else
                when side.event is
                    Connection.Output b ->
                        let
                            r =
                                PickerSftp.received b c.source

                            applied =
                                Array.foldl
                                    (\a acc ->
                                        let
                                            st =
                                                Picker.answer a acc.picker
                                        in
                                        { picker = st.picker, requests = acc.requests ++ st.requests }
                                    )
                                    { picker = c.picker, requests = [] }
                                    r.answers
                        in
                        chooserStep { picker = applied.picker, requests = applied.requests, outcome = Picker.Stay } { c | source = r.source, toSend = Bytes.flatten [ c.toSend, r.send ] } m

                    Connection.Refused why ->
                        Task.succeed { m | choosing = Just { c | picker = Picker.trouble ("SFTP is turned off on this host, and the folders are read with it: " ++ why) c.picker }, urgent = True }

                    Connection.Ended ->
                        Task.succeed { m | choosing = Just { c | picker = Picker.trouble "The channel the folders are read on closed" c.picker }, urgent = True }

                    _ ->
                        Task.succeed m

        Nothing ->
            meant Reason.NotOpen (Task.succeed (uploaded side m))


{-| What a key, the pointer or the host's answers came to: the picker's
requests sent; or its folder chosen, and the files sent there; or it
cancelled. -}
chooserStep : Picker.Step -> Choosing -> (taken m : Model) -> Task Error Model
chooserStep s c m =
    when s.outcome is
        Picker.Stay ->
            let
                asked =
                    askAll s.requests c.source
            in
            chooserIo { m | choosing = Just { c | picker = s.picker, source = asked.source, toSend = Bytes.flatten [ c.toSend, asked.send ] }, urgent = True }

        Picker.Send folder ->
            chooserClosed c { m | pendingSend = Just { folder = folder, files = c.files } }
                |> Task.andThen (marksKept c s.picker)
                |> Task.andThen startPending

        Picker.Cancelled ->
            chooserClosed c (logLine "drop" "the folder chooser cancelled" m)
                |> Task.andThen (marksKept c s.picker)


{-| A key in the folder picker. -}
chooserKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Choosing -> (taken m : Model) -> Task Error Model
chooserKey k c m =
    chooserStep (Picker.key (hostWith m) { sym = k.sym, unshifted = k.unshifted, mods = k.mods, text = Bytes.toStringLossy k.text } c.picker) c m


{-| The pointer over the folder picker: its presses, releases and motion;
nothing reaches the terminal under it. -}
chooserPointer : Window.PointerEvent -> Int -> Choosing -> (taken m : Model) -> Task Error Model
chooserPointer p ms c m =
    chooserStep (Picker.pointer (overlaySize m) (hostWith m) { action = p.action, button = p.button, x = p.x, y = p.y, ms = ms } c.picker) c m


{-| The picker gone, its channel closed. -}
chooserClosed : Choosing -> (taken m : Model) -> Task Error Model
chooserClosed c m =
    (when m.remote.side is
        Just side ->
            side (Session.SideClose c.ref)

        Nothing ->
            meant Reason.Gone (Task.succeed {})
    )
        |> Task.map (\_ -> { m | choosing = Nothing, urgent = True })


{-| The question before dropped files are sent to a folder puritty chose
(`[files] drop_uploads = "ask"`, docs/sftp.md FT28): what, where, and on
which host. -}
dropBox : Model -> { folder : Bytes, files : Array Bytes, tab : Int } -> Dialog.Dialog
dropBox m a =
    let
        names =
            Array.map (\p -> Bytes.toStringLossy (Path.filenameAsBytes (Path.fromBytes p))) a.files

        shown =
            Array.takeFirst 5 names |> Array.map (\n -> "  " ++ n)

        more =
            if Array.length names > 5 then
                [ "  and " ++ String.fromInt (Array.length names - 5) ++ " more" ]

            else
                []

        host =
            hostLabel m
    in
    { title =
        if Array.length names == 1 then
            "Send this to " ++ host ++ "?"

        else
            "Send these " ++ String.fromInt (Array.length names) ++ " to " ++ host ++ "?"
    , lines = shown ++ more ++ [ "into" ] ++ wrapPath 56 (fromHost m.charset a.folder) ++ [ "Nothing is sent unless you say yes." ]
    , field = Nothing
    , swatches = []
    , check = Nothing
    , buttons = [ { label = "Send", primary = True }, { label = "Another folder…", primary = False }, { label = "Don't send", primary = False } ]
    , hint = "Enter: send    C: choose    Esc: don't"
    }


dropKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> { folder : Bytes, files : Array Bytes, tab : Int } -> (taken m : Model) -> Task Error Model
dropKey k a m =
    if k.sym == 0xFF0D || k.sym == 0xFF8D || k.sym == 0x79 || k.sym == 0x59 then
        dropAnswer True a m

    else if k.sym == 0xFF1B || k.sym == 0x6E || k.sym == 0x4E then
        dropAnswer False a m

    else if k.sym == 0x63 || k.sym == 0x43 then
        dropElsewhere a m

    else
        Task.succeed m


{-| Another folder than the one puritty found: the chooser, at that one
(FT29). -}
dropElsewhere : { folder : Bytes, files : Array Bytes, tab : Int } -> (taken m : Model) -> Task Error Model
dropElsewhere a m0 =
    let
        m =
            logLine "drop" "question answered: another folder" { m0 | dropAsk = Nothing, urgent = True }
    in
    if a.tab /= m.tab.id || Maybe.isJust m.choosing then
        Task.succeed (noteUp { text = "The dropped files were not sent", failed = False, kept = False } m)

    else
        chooserIo (chooserOpened a.files a.folder m)


dropPress : Window.PointerEvent -> { folder : Bytes, files : Array Bytes, tab : Int } -> (taken m : Model) -> Task Error Model
dropPress p a m =
    let
        hit =
            if p.button == 1 then
                Dialog.buttonAt (overlaySize m) (dropBox m a) { x = p.x, y = p.y }

            else
                Nothing
    in
    when hit is
        Just 0 ->
            dropAnswer True a m

        Just 1 ->
            dropElsewhere a m

        Just _ ->
            dropAnswer False a m

        Nothing ->
            meant Reason.OutOfRange (Task.succeed m)


{-| The question answered: on yes the files sent, if their tab is still
the one shown; on no, nothing. -}
dropAnswer : Bool -> { folder : Bytes, files : Array Bytes, tab : Int } -> (taken m : Model) -> Task Error Model
dropAnswer yes a m0 =
    let
        m =
            logLine "drop"
                ("question answered: "
                    ++ (if yes then
                            "send"

                        else
                            "don't"
                       )
                )
                { m0 | dropAsk = Nothing, urgent = True }
    in
    if not yes then
        Task.succeed (noteUp { text = "The dropped files were not sent", failed = False, kept = False } m)

    else if a.tab /= m.tab.id then
        Task.succeed (noteUp { text = "The dropped files were not sent: their tab is not the one shown now", failed = True, kept = False } m)

    else
        startPending { m | pendingSend = Just { folder = a.folder, files = a.files } }


{-| Whether the tab's program runs on a host, by puritty's own ssh or
OpenSSH's (a host of the settings started either way, docs/sftp.md FT31),
not on this computer. -}
isRemoteTab : Model -> Bool
isRemoteTab m =
    m.tab.host /= Nothing || m.tab.hostName /= Nothing


{-| The tab's host as a question names it: its address, else its name in
the settings. -}
hostLabel : Model -> String
hostLabel m =
    when m.tab.host is
        Just h ->
            h.host

        Nothing ->
            -- a tab of OpenSSH's ssh: its host's name in the settings
            meant Reason.NotSet (Maybe.withDefault (meant Reason.NotSet "the host") m.tab.hostName)


{-| The tab's host, by the first OSC 7 it read (FT29), once one has come. -}
shellHostSeen : (taken m : Model) -> Model
shellHostSeen m =
    if Maybe.isJust m.shellHost || not (isRemoteTab m) then
        m

    else
        when Drop.fileUri (Bytes.fromString (Vt.workingDirectory m.term)) is
            Just u ->
                { m | shellHost = Just u.host }

            Nothing ->
                -- no OSC 7 yet
                meant Reason.NotYet m


{-| The folder the shell of an ssh tab without tmux -CC says it is in, by
OSC 7, when it names the tab's host (FT29): its path's bytes. -}
shellFolder : Model -> Maybe Bytes
shellFolder m =
    when { said = Drop.fileUri (Bytes.fromString (Vt.workingDirectory m.term)), host = m.shellHost } is
        { said = Just u, host = Just h } ->
            if u.host == h && not (Bytes.isEmpty u.path) then
                Just u.path

            else
                -- another host's: a nested ssh's
                Nothing

        _ ->
            Nothing


{-| Where a drop on a tmux pane would have gone, for the note. -}
dropWhere : Model -> String
dropWhere m =
    when TmuxMode.dropTarget m.tmux |> Maybe.map .folder is
        Just (TmuxMode.Folder path) ->
            "; they would go to " ++ Bytes.toStringLossy path

        Just (TmuxMode.NoFolder why) ->
            "; " ++ why ++ ", so a folder would be asked"

        Just (TmuxMode.Asking _) ->
            "; tmux had not yet said the pane's folder"

        Nothing ->
            -- no tmux pane marked
            meant Reason.NotOpen ""


droppedChecked : Int -> Array { path : Bytes, there : Bool } -> (taken m : Model) -> Model
droppedChecked others checked m =
    let
        names =
            Array.map
                (\c ->
                    when Bytes.toString c.path is
                        Just text ->
                            Just text

                        Nothing ->
                            -- a name not UTF-8: in the tab's character set
                            meant Reason.FromOutside
                                (if m.charset == Charset.Utf8 then
                                    Nothing

                                 else
                                    Just (fromHost m.charset c.path)
                                )
                )
                checked

        readable =
            Array.mapAndKeepJust identity names

        pasted =
            Drop.quoted (Platform.pathSeparator == "\\") readable
    in
    if Array.isEmpty checked then
        noteUp
            { text =
                if others > 0 then
                    "What was dropped is not a file on this computer"

                else
                    "The program it was dragged from gave no file on disk to send: a file inside a zip, or an attachment, must be saved first"
            , failed = True
            , kept = False
            }
            m

    else
        when Array.findFirst (\c -> not c.there) checked is
            Just missing ->
                noteUp { text = "A dropped file is not there, by the name it was given as: " ++ Bytes.toStringLossy missing.value.path, failed = True, kept = False } m

            Nothing ->
                -- every file there
                meant Reason.NoMore
                    (if isRemoteTab m then
                        sshDropped (Array.map .path checked) m

                     else if Array.length readable < Array.length names || (Charset.encode m.charset (Bytes.fromString pasted)).replaced > 0 then
                        noteUp { text = "A dropped file's name is not in this tab's character set, " ++ charsetName m.charset ++ ", and was not pasted", failed = True, kept = False } m

                     else
                        logLine "drop" (String.fromInt (Array.length readable) ++ " paths pasted") (pasteIn False (Bytes.fromString pasted) m)
                    )


{-| A path pasted whole: in double quotes when it has a space, which Claude
Code takes off. -}
quotedPath : String -> String
quotedPath path =
    if String.contains " " path then
        "\"" ++ path ++ "\""

    else
        path


{-| A picture on its way when the session ended: said, and forgotten. -}
uploadLost : (taken m : Model) -> Model
uploadLost m =
    if m.upload /= Nothing then
        noteUp { text = "The connection ended before the picture was sent", failed = True, kept = False } { m | upload = Nothing }

    else
        m


{-| A picture pasted in a local tab on Linux: written to a file of its own
in `dir`, its path pasted; with `paste_images = "ask"`, the file's path
asked about first (FT16). -}
localImage : String -> Bytes -> (taken m : Model) -> Task Error Model
localImage dir png m0 =
    let
        n =
            m0.uploads + 1

        m =
            { m0 | uploads = n }

        file =
            Path.append (Path.fromString ("paste-" ++ String.fromInt m.turnMs ++ "-" ++ String.fromInt n ++ ".png")) (Path.fromString dir)
    in
    if m.config.pasteImages == "allow" then
        writeLocal file png m

    else
        Task.succeed (askPaste { png = png, path = Path.toString file, to = ToLocal file, on = "on this computer", tab = m.tab.id } m)


{-| A local tab's picture written to `file`, its folder made first, and
its path pasted. -}
writeLocal : Path.Path -> Bytes -> (taken m : Model) -> Task Error Model
writeLocal file png m =
    let
        fs =
            m.settings.given.fs
    in
    Directory.createAll fs (Path.parent file |> Maybe.withDefault (meant Reason.NotSet file))
        |> Task.andThen (\_ -> File.writeFile fs png file)
        |> Task.map (\_ -> Ok {})
        |> Task.onError (\e -> Task.succeed (Err (Os.Error.toString e)))
        |> Task.map
            (\written ->
                when written is
                    Ok _ ->
                        pasteIn False (Bytes.fromString (quotedPath (Path.toString file))) (noteUp { text = "Pasted the picture as " ++ Path.toString file, failed = False, kept = False } m)

                    Err why ->
                        meant Reason.Refused noteUp { text = "The picture could not be written: " ++ why, failed = True, kept = False } m
            )


{-| The question before a pasted picture is written (docs/sftp.md FT16):
up, and in the log with the path it names. -}
askPaste : PasteAsk -> (taken m : Model) -> Model
askPaste a m =
    logLine "paste" ("asked: write " ++ a.path ++ " " ++ a.on ++ "?") { m | pasteAsk = Just a, urgent = True }


{-| The question: where the picture is to be written, by the file's whole
path, and the buttons that answer. -}
pasteBox : PasteAsk -> Dialog.Dialog
pasteBox a =
    { title = "Paste the picture as a file?"
    , lines =
        [ "The picture (" ++ sizeText (Bytes.length a.png) ++ ") is to be written " ++ a.on ++ " as" ]
            ++ wrapPath 56 a.path
            ++ [ "and that file's name pasted. Nothing is written unless you say yes." ]
    , field = Nothing
    , swatches = []
    , check = Nothing
    , buttons = [ { label = "Paste", primary = True }, { label = "Don't paste", primary = False } ]
    , hint = "Enter: paste it    Esc: don't"
    }


{-| A path in lines of at most `most` characters, broken after a `/`
where it can be, so that the end of it, the file's name, is never what a
box's edge cuts off (the box holds about 60). -}
wrapPath : Int -> String -> Array String
wrapPath most path =
    let
        parts =
            String.split "/" path

        n =
            Array.length parts

        pieces =
            Array.indexedMap
                (\i part ->
                    if i < n - 1 then
                        part ++ "/"

                    else
                        part
                )
                parts

        out =
            Array.foldl
                (\piece acc ->
                    if acc.line == "" || String.count acc.line + String.count piece <= most then
                        { done = acc.done, line = acc.line ++ piece }

                    else
                        { done = acc.done ++ [ acc.line ], line = piece }
                )
                { done = [], line = "" }
                pieces
    in
    Array.flatten (Array.map (chunked most) (out.done ++ [ out.line ]))


{-| Text in pieces of `most` characters, the last shorter. -}
chunked : Int -> String -> Array String
chunked most text =
    if most < 1 || String.count text <= most then
        [ text ]

    else
        [ String.takeFirst most text ] ++ chunked most (String.dropFirst most text)


{-| A key while the paste question is up: Enter or y writes the picture,
Escape or n does not; any other key, nothing. -}
pasteKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> PasteAsk -> (taken m : Model) -> Task Error Model
pasteKey k a m =
    if k.sym == 0xFF0D || k.sym == 0xFF8D || k.sym == 0x79 || k.sym == 0x59 then
        pasteAnswer True a m

    else if k.sym == 0xFF1B || k.sym == 0x6E || k.sym == 0x4E then
        pasteAnswer False a m

    else
        Task.succeed m


{-| A press while the paste question is up: its buttons answer it, and
nothing reaches the terminal under it. -}
pastePress : Window.PointerEvent -> PasteAsk -> (taken m : Model) -> Task Error Model
pastePress p a m =
    let
        hit =
            if p.button == 1 then
                Dialog.buttonAt (overlaySize m) (pasteBox a) { x = p.x, y = p.y }

            else
                Nothing
    in
    when hit is
        Just 0 ->
            pasteAnswer True a m

        Just _ ->
            pasteAnswer False a m

        Nothing ->
            meant Reason.OutOfRange Task.succeed m


{-| The paste question answered: on yes the picture written where the
question said, if its tab is still the one shown and, for a host, still
connected; on no, nothing written. -}
pasteAnswer : Bool -> PasteAsk -> (taken m : Model) -> Task Error Model
pasteAnswer yes a m0 =
    let
        m =
            logLine "paste"
                ("question answered: "
                    ++ (if yes then
                            "paste"

                        else
                            "don't paste"
                       )
                )
                { m0 | pasteAsk = Nothing, urgent = True }
    in
    if not yes then
        Task.succeed (noteUp { text = "The picture was not pasted", failed = False, kept = False } m)

    else if a.tab /= m.tab.id then
        Task.succeed (noteUp { text = "The picture was not pasted: its tab is no longer the one shown", failed = True, kept = False } m)

    else
        when a.to is
            ToLocal file ->
                writeLocal file a.png m

            ToHost name ->
                when m.remote.side is
                    Just side ->
                        if sideUp m && m.upload == Nothing then
                            sendImage side a.png name m

                        else
                            Task.succeed (noteUp { text = "The picture was not pasted: the tab is no longer connected", failed = True, kept = False } m)

                    Nothing ->
                        meant Reason.NotOpen Task.succeed (noteUp { text = "The picture was not pasted: the tab is no longer connected", failed = True, kept = False } m)


{-| A picture pasted in a local tab on Windows: an empty bracketed paste,
where the program asked for bracketed pastes. -}
emptyPaste : (taken m : Model) -> Model
emptyPaste m =
    if modeOn 2004 m && not (TmuxMode.isOn m.tmux) then
        logLine "paste" "a picture: an empty bracketed paste sent, for the program to read the clipboard" (send (Bytes.flatten [ Paste.bracketStart, Paste.bracketEnd ]) m)

    else
        logLine "paste" "a picture, and the program asked for no bracketed paste: nothing sent" m


{-| A question that may be remembered (`docs/saved-secrets.md` PW8):
answered from the store when it holds the answer and it has not been
given on this connection; asked again with a note, "Remember" checked,
when it was given and refused; else asked, the box offering to remember
it. A change waiting for the same name is dropped, since being asked
again means the answer given was refused. -}
sshAsked : Session.Ask -> (taken m : Model) -> Task Error Model
sshAsked ask m =
    let
        asked =
            sshNoticed (Session.Asking ask) m
    in
    when { kept = Remembered.offered { available = SecretStore.available, setting = m.config.rememberSecrets } (questionOf ask), ssh = asked.ssh } is
        { kept = Just k, ssh = Just screen0 } ->
            let
                screen =
                    { screen0 | changes = Array.keepIf (\c -> c.target /= k.target) screen0.changes }

                offering refused model =
                    when screen.asking is
                        Just a ->
                            { model | ssh = Just { screen | asking = Just { a | offer = True, remember = refused, refused = refused } } }

                        Nothing ->
                            meant Reason.NotOpen model
            in
            if Array.member k.target screen.tried then
                Task.succeed (offering True asked)

            else
                SecretStore.read k.target
                    |> Task.andThen
                        (\got ->
                            when got is
                                Ok secret ->
                                    let
                                        answer =
                                            when ask is
                                                Session.Responses _ ->
                                                    Session.GiveAll [ secret ]

                                                _ ->
                                                    Session.Give secret
                                    in
                                    if Remembered.givenAlone (questionOf ask) then
                                        sshAnswered asked.remote answer "the remembered one given, from Windows' Credential Manager" { screen | tried = Array.pushLast k.target screen.tried } asked

                                    else
                                        -- the host's key is not the one known
                                        -- (trusted once, or taken without a
                                        -- question): the remembered one is in the
                                        -- box, given only by the user's Enter
                                        -- (docs/saved-secrets.md PW11, the code
                                        -- review's ST3)
                                        when screen.asking is
                                            Just a ->
                                                Task.succeed { asked | ssh = Just { screen | tried = Array.pushLast k.target screen.tried, asking = Just { a | typed = secret, offer = True } }, urgent = True }

                                            Nothing ->
                                                meant Reason.NotOpen Task.succeed asked

                                Err _ ->
                                    -- none kept, or the store could not be read
                                    meant Reason.NotSet Task.succeed (offering False asked)
                        )

        _ ->
            Task.succeed asked


{-| A question of the session, as `Remembered` takes it. -}
questionOf : Session.Ask -> Remembered.Question
questionOf ask =
    when ask is
        Session.Password p ->
            Remembered.Password { account = p.account, keyKnown = p.keyKnown }

        Session.Passphrase p ->
            Remembered.Passphrase { file = p.file }

        Session.Responses r ->
            Remembered.Responses { prompts = r.prompts, account = r.account, keyKnown = r.keyKnown }

        Session.TrustHostKey _ ->
            Remembered.NotSecret

        Session.HostKeyChanged _ ->
            Remembered.NotSecret


{-| What the store is to get, now that the session has logged in: each
answer the box was told to remember written, each refused one not
replaced taken away; what happened said on the screen. -}
rememberChanges : (taken m : Model) -> Task Error Model
rememberChanges m =
    when m.ssh is
        Just screen ->
            if Array.isEmpty screen.changes then
                Task.succeed m

            else
                screen.changes
                    |> Array.map
                        (\c ->
                            when c.secret is
                                Just secret ->
                                    SecretStore.write { target = c.target, user = c.user, secret = secret }
                                        |> Task.map
                                            (\written ->
                                                when written is
                                                    Ok _ ->
                                                        "remembered in Windows' Credential Manager as " ++ c.target

                                                    Err why ->
                                                        meant Reason.Refused ("not remembered: Windows' Credential Manager said error " ++ why)
                                            )

                                Nothing ->
                                    meant Reason.NotSet
                                        (SecretStore.forget c.target
                                            |> Task.map (\_ -> "the remembered one, refused, is forgotten: " ++ c.target)
                                        )
                        )
                    |> Task.sequence
                    |> Task.map (\said -> { m | ssh = Just { screen | changes = [], lines = Array.takeLast 200 (screen.lines ++ said) }, urgent = True })

        Nothing ->
            meant Reason.NotSet Task.succeed m


{-| tmux control mode not running, with the settings' look, bar and
background. -}
freshTmux : Config -> Vt.Term -> Maybe String -> TmuxMode.State
freshTmux config like command =
    TmuxMode.setBackground config.background (TmuxMode.setLook (config.tmuxLook == "tmux") (TmuxMode.setBar (config.tmuxTabs == "top") (TmuxMode.idle {})))
        |> TmuxMode.setCell (paneCell { width = like.config.cellWidth, height = like.config.cellHeight })
        |> TmuxMode.setEmbedder (embedderOf config)
        -- control mode expected when the tab's command starts `tmux -CC`
        -- (docs/tmux.md TM108)
        |> TmuxMode.expectEntry (Maybe.map TmuxMode.startsTmux command |> Maybe.withDefault (meant Reason.NotSet False))


{-| What a tmux pane's terminal is given (`docs/images.md` IM18): the
window's cell size and the image limit. -}
paneCell : { width : Int, height : Int } -> { width : Int, height : Int, limit : Int }
paneCell cell =
    { width = cell.width, height = cell.height, limit = imageLimit }


{-| What a changed host key is said with, in the platform's dialog, the box
and the screen alike (SC28). -}
changedLines : { host : String, algorithm : String, fingerprint : String, lineNumbers : Array Int } -> Array String
changedLines k =
    [ "Its " ++ k.algorithm ++ " key is not the one known for it,"
    , "which is on line " ++ String.join ", " (Array.map String.fromInt k.lineNumbers) ++ " of known_hosts."
    , "Someone may be pretending to be the host, or the host was rebuilt."
    , "The new key's fingerprint:"
    , "    " ++ k.fingerprint
    ]


{-| A notice from the session, taken into the screen's state. A session
that ended as it should is its callers' to close (`endsSession`), the tab
and the window only with its last; one that failed or never started
leaves the screen up to say why. -}
sshNoticed : Session.Notice -> (taken m : Model) -> Model
sshNoticed told m =
    when m.ssh is
        Nothing ->
            meant Reason.NotSet m

        Just screen ->
            let
                said line =
                    { screen | lines = Array.takeLast 200 (Array.pushLast line screen.lines) }

                updated =
                    when told is
                        Session.Status text ->
                            said (cleanText text)

                        Session.Banner text ->
                            { screen | lines = Array.takeLast 200 (screen.lines ++ Array.map (\l -> "| " ++ cleanText l) (String.lines (String.trimRight text))) }

                        Session.Asking ask ->
                            { screen | asking = Just { ask = ask, typed = "", given = [], offer = False, remember = False, onCheck = False, refused = False } }

                        Session.Started ->
                            { screen | started = True }

                        Session.Exited status ->
                            { screen | exitStatus = Just status }

                        Session.Failed why ->
                            { screen | failed = Just (cleanText why) }

                        Session.Ended ->
                            if screen.started && screen.failed == Nothing && screen.exitStatus /= Nothing then
                                -- a command that failed keeps its screen, with
                                -- the last lines it wrote (SC29)
                                { screen | failed = commandFailed screen |> Maybe.map (\why -> String.join "\n" (lastWritten 4 m.term ++ [ why ])) }

                            else
                                -- a session that ends without its shell's exit status
                                -- dropped: its screen stays up to say so, with
                                -- reconnect (TB8)
                                { screen | failed = Just (Maybe.withDefault (meant Reason.FromOutside "the connection ended") screen.failed) }

                        Session.Output _ ->
                            screen

                        Session.Side _ ->
                            -- the side channels' own users read them
                            screen
            in
            when told is
                Session.Side _ ->
                    m

                _ ->
                    { m | ssh = Just updated, urgent = True }


{-| Whether a notice ends a session that went as it should, its shell's
`exit`, which the server says with an exit status before the end: its tab
then closes as a local tab's does when its program ends, and the window
with its last tab, its exit status the window's (TB8). A session that
failed, never started, dropped without an exit status, or whose command
ended with a status other than 0 (`commandFailed`) keeps its screen
and its tab, to reconnect. -}
endsSession : Session.Notice -> Maybe SshScreen -> Bool
endsSession told ssh =
    when ssh is
        Just screen ->
            told == Session.Ended && screen.started && screen.failed == Nothing && screen.exitStatus /= Nothing && commandFailed screen == Nothing

        Nothing ->
            meant Reason.NotSet False


{-| The last `n` lines a session's program left on its terminal, not
blank, each cleaned of what could not be shown: the screen and a few rows
of scrollback above it, which is where a command's last words are when it
fails (SC29). -}
lastWritten : Int -> Vt.Term -> Array String
lastWritten n term =
    let
        top =
            Vt.rowsPushed term
    in
    Vt.selectionText { row = max 0 (top - n), col = 0 } { row = top + 100000, col = 0 } term
        |> String.lines
        |> Array.map (\l -> cleanText (String.trimRight l))
        |> Array.keepIf (\l -> String.trim l /= "")
        |> Array.takeLast n


{-| Why a session's command failed, when one was given and its exit status
is not 0 (`docs/ssh-client.md` SC29): `tmux -CC attach` that finds no
session, or a command its shell cannot find, said in the program's own
words on the terminal behind. A login shell's status is its last
command's, so a shell closes its window whatever its status. -}
commandFailed : SshScreen -> Maybe String
commandFailed screen =
    when screen.command is
        Just command ->
            when screen.exitStatus is
                Just status ->
                    if status /= 0 then
                        Just ("the command \"" ++ cleanText command ++ "\"\nended with status " ++ String.fromInt status)

                    else
                        Nothing

                Nothing ->
                    -- the session has not said its status
                    meant Reason.NotYet Nothing

        Nothing ->
            -- a login shell, no command given
            meant Reason.NotSet Nothing


{-| Text from the server or the network made safe to show: control
characters, escapes among them, as `?`. -}
cleanText : String -> String
cleanText text =
    String.map
        (\c ->
            let
                n =
                    Char.toCode c
            in
            if n < 32 || n == 127 || (n >= 128 && n < 160) then
                '?'

            else
                c
        )
        text


{-| A key on puritty's own screen: the question's answer, or after a
failure Enter to close and R to connect again; Escape declines a question,
and before the session runs closes the window. -}
sshKey : Backend -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
sshKey remote k m =
    let
        enter =
            k.sym == 0xFF0D || k.sym == 0xFF8D

        escape =
            k.sym == 0xFF1B

        backspace =
            k.sym == 0xFF08

        tab =
            k.sym == 0xFF09

        letter =
            String.toLower (Bytes.toStringLossy k.text)
    in
    when m.ssh is
        Nothing ->
            meant Reason.NotSet Task.succeed m

        Just screen ->
            when screen.asking is
                Just asking ->
                    let
                        answered answer line model =
                            sshAnswered remote answer line screen model

                        -- an answer the box offered to remember: what the
                        -- store is to get at the login, by its checkbox
                        answeredKeeping secret answer line model =
                            when Remembered.offered { available = SecretStore.available, setting = model.config.rememberSecrets } (questionOf asking.ask) is
                                Just name ->
                                    if asking.offer then
                                        sshAnswered remote answer line { screen | changes = Remembered.changesAt { kept = name, remember = asking.remember, refused = asking.refused, secret = secret } screen.changes } model

                                    else
                                        sshAnswered remote answer line screen model

                                Nothing ->
                                    meant Reason.NotSet sshAnswered remote answer line screen model
                    in
                    when asking.ask is
                        Session.HostKeyChanged _ ->
                            -- Enter does nothing: only a letter trusts it
                            if letter == "a" then
                                answered (Session.Trust { remember = True }) "the changed key is trusted, in place of the old one" m

                            else if letter == "o" then
                                answered (Session.Trust { remember = False }) "the changed key is trusted this once" m

                            else if escape || letter == "n" then
                                answered Session.Decline "the changed key is not trusted" m

                            else
                                Task.succeed m

                        Session.TrustHostKey _ ->
                            if letter == "a" then
                                answered (Session.Trust { remember = True }) "the key is trusted and remembered" m

                            else if letter == "o" then
                                answered (Session.Trust { remember = False }) "the key is trusted this once" m

                            else if escape || letter == "n" then
                                answered Session.Decline "the key is not trusted" m

                            else
                                Task.succeed m

                        Session.Responses r ->
                            if escape then
                                answered Session.Decline "the prompts are not answered" m

                            else if tab && asking.offer then
                                -- Tab moves between the field and the
                                -- checkbox (PW10)
                                Task.succeed { m | ssh = Just { screen | asking = Just { asking | onCheck = not asking.onCheck } }, urgent = True }

                            else if asking.onCheck && k.sym == 0x20 then
                                -- Space ticks the checkbox it is on
                                Task.succeed { m | ssh = Just { screen | asking = Just { asking | remember = not asking.remember } }, urgent = True }

                            else if enter then
                                let
                                    given =
                                        Array.pushLast asking.typed asking.given
                                in
                                if Array.length given >= Array.length r.prompts then
                                    answeredKeeping asking.typed (Session.GiveAll given) "answered" m

                                else
                                    Task.succeed { m | ssh = Just { screen | asking = Just { asking | typed = "", given = given } }, urgent = True }

                            else
                                Task.succeed (editTyped backspace k m)

                        _ ->
                            if escape then
                                answered Session.Decline "not given" m

                            else if enter then
                                answeredKeeping asking.typed (Session.Give asking.typed) "given" m

                            else if tab && asking.offer then
                                -- Tab moves between the field and the
                                -- checkbox (PW10)
                                Task.succeed { m | ssh = Just { screen | asking = Just { asking | onCheck = not asking.onCheck } }, urgent = True }

                            else if asking.onCheck && k.sym == 0x20 then
                                -- Space ticks the checkbox it is on
                                Task.succeed { m | ssh = Just { screen | asking = Just { asking | remember = not asking.remember } }, urgent = True }

                            else
                                Task.succeed (editTyped backspace k m)

                Nothing ->
                    meant Reason.NotOpen
                        if screen.failed /= Nothing && letter == "r" then
                            -- the new connection starts outside tmux: one
                            -- attached with -CC when the old dropped never said
                            -- %exit, and its state would take the new shell's
                            -- output and send it the keys as tmux's commands
                            -- (docs/tmux.md TM93); and none of the old
                            -- session's modes kept, its screen left in place
                            -- (docs/tabs.md TB19)
                            remote.reconnect (ptySize m.term.cols m.term.rows m.term)
                                |> Task.map (\_ -> { m | ssh = Just { screen | lines = [ "connecting again" ], failed = Nothing, started = False, exitStatus = Nothing, tried = [], changes = [] }, tmux = freshTmux m.config m.term screen.command, term = Vt.restarted m.term, back = 0, selection = Nothing, urgent = True })

                        else if (screen.failed /= Nothing && enter) || escape then
                            -- this tab's session given up: the tab closed, and
                            -- the window only with its last tab
                            closeShown m

                        else
                            Task.succeed m


{-| The question answered: the answer to the session, and a line said. -}
sshAnswered : Backend -> Session.Answer -> String -> SshScreen -> (taken m : Model) -> Task Error Model
sshAnswered remote answer line screen m =
    remote.answer answer
        |> Task.map (\_ -> { m | ssh = Just { screen | asking = Nothing, lines = Array.pushLast line screen.lines }, urgent = True })


{-| A key typed into the question: a character added, or one taken off. -}
editTyped : Bool -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Model
editTyped backspace k m =
    if backspace then
        updateTyped (String.dropLast 1) m

    else
        sshTyped (Bytes.toStringLossy k.text) m


sshTyped : String -> (taken m : Model) -> Model
sshTyped text m =
    updateTyped (\typed -> typed ++ String.fromArray (Array.keepIf (\c -> Char.toCode c >= 32 && Char.toCode c /= 127) (String.toArray text))) m


updateTyped : (String -> String) -> (taken m : Model) -> Model
updateTyped f m =
    when m.ssh is
        Just screen ->
            when screen.asking is
                Just asking ->
                    if asking.onCheck then
                        -- the checkbox has the keys: nothing typed
                        m

                    else
                        { m | ssh = Just { screen | asking = Just { asking | typed = f asking.typed } }, urgent = True }

                Nothing ->
                    meant Reason.NotOpen m

        Nothing ->
            meant Reason.NotSet m


{-| A question of the ssh session, or why it failed, as a box over the
screen (docs/ssh-client.md SC23): what `ownTerm` writes on the screen
without one. -}
dialogOf : SshScreen -> Maybe Dialog.Dialog
dialogOf screen =
    questionDialog screen
        |> Maybe.map
            (\d ->
                when screen.asking is
                    Just asking ->
                        remembering asking d

                    Nothing ->
                        meant Reason.NotOpen d
            )


{-| A question's box with "Remember" (`docs/saved-secrets.md` PW8, PW10),
where the question may be remembered: its checkbox, which a click ticks,
or Tab to it and Space, and a note when a remembered answer was
refused. -}
remembering : { ask : Session.Ask, typed : String, given : Array String, offer : Bool, remember : Bool, onCheck : Bool, refused : Bool } -> Dialog.Dialog -> Dialog.Dialog
remembering asking d =
    if asking.offer then
        { d
            | lines =
                (if asking.refused then
                    [ "The remembered one was refused." ]

                 else if not (Remembered.givenAlone (questionOf asking.ask)) && asking.typed /= "" then
                    [ "The host's key is not the one known, so the remembered one is filled in, and sent only if you press Enter." ]

                 else
                    []
                )
                    ++ d.lines
            , check = Just { label = "Remember it in Windows' Credential Manager", checked = asking.remember, focused = asking.onCheck }
        }

    else
        d


questionDialog : SshScreen -> Maybe Dialog.Dialog
questionDialog screen =
    when screen.asking is
        Just asking ->
            when asking.ask is
                Session.HostKeyChanged k ->
                    Just
                        { title = "THE KEY OF " ++ cleanText k.host ++ " HAS CHANGED"
                        , lines = changedLines k
                        , field = Nothing
                        , swatches = []
                        , check = Nothing
                        , buttons = []
                        , hint = "Esc: don't connect (safe)    O: trust once    A: trust, in place of the old key"
                        }

                Session.TrustHostKey k ->
                    Just
                        { title = "The host " ++ cleanText k.host ++ " is not known"
                        , lines =
                            [ "Its " ++ k.algorithm ++ " key's fingerprint:", "    " ++ k.fingerprint ]
                                ++ (if Array.isEmpty k.knownTypes then
                                        []

                                    else
                                        [ "It is known by its " ++ String.join ", " k.knownTypes ++ " key, not this one." ]
                                   )
                        , field = Nothing
                        , swatches = []
                        , check = Nothing
                        , buttons = []
                        , hint = "A: trust and remember    O: trust once    Esc: don't connect"
                        }

                Session.Password p ->
                    Just { title = cleanText p.prompt, lines = [], field = Just { typed = asking.typed, hidden = True, caret = String.count asking.typed }, swatches = [], check = Nothing, hint = "Enter: log in    Esc: do not use a password", buttons = [] }

                Session.Passphrase p ->
                    let
                        file =
                            cleanText p.file

                        -- the key's own name, after the last / or \
                        name =
                            lastPiece "\\" (lastPiece "/" file)
                    in
                    Just { title = "The passphrase for " ++ name, lines = [ file ], field = Just { typed = asking.typed, hidden = True, caret = String.count asking.typed }, swatches = [], check = Nothing, hint = "Enter: unlock the key    Esc: skip this key", buttons = [] }

                Session.Responses r ->
                    when Array.get (Array.length asking.given) r.prompts is
                        Just prompt ->
                            Just
                                { title =
                                    if r.name == "" then
                                        "The server asks"

                                    else
                                        cleanText r.name
                                , lines =
                                    (if r.instruction == "" then
                                        []

                                     else
                                        [ cleanText r.instruction ]
                                    )
                                        ++ [ cleanText prompt.text ]
                                , field = Just { typed = asking.typed, hidden = not prompt.echo, caret = String.count asking.typed }
                                , swatches = []
                                , check = Nothing
                                , buttons = []
                                , hint = "Enter: answer    Esc: do not answer"
                                }

                        Nothing ->
                            meant Reason.NoMore Nothing

        Nothing ->
            meant Reason.NotOpen
                when screen.failed is
                    Just why ->
                        Just { title = "The session could not go on", lines = String.lines why, field = Nothing, swatches = [], check = Nothing, hint = "Enter: close    R: connect again", buttons = [] }

                    Nothing ->
                        meant Reason.NotOpen Nothing


{-| The own screen as a terminal of the window's size: a heading, what has
happened, then the question or the failure and the keys that answer it. -}
ownTerm : Model -> Bool -> SshScreen -> Vt.Term
ownTerm m boxed screen =
    let
        dim t =
            "\u{001B}[2m" ++ t ++ "\u{001B}[0m"

        bold t =
            "\u{001B}[1m" ++ t ++ "\u{001B}[0m"

        line t =
            t ++ "\r\n"

        -- what is typed shown as a bullet a character: stars are joined by
        -- a font's ligatures, as Fira Code's `***` raises its middle one
        -- (docs/ssh-client.md SC20), and no font joins bullets
        hidden t =
            String.repeat (String.count t) "•"

        -- where the cursor goes back to once the screen is written: after
        -- what is typed, where the next character will show (DECSC)
        mark =
            "\u{001B}7"

        asked =
            when screen.asking is
                Just asking ->
                    when asking.ask is
                        Session.HostKeyChanged k ->
                            [ line "", line (bold ("THE KEY OF " ++ cleanText k.host ++ " HAS CHANGED.")) ]
                                ++ Array.map (\l -> line ("  " ++ l)) (changedLines k)
                                ++ [ line "", line "  Esc: do not connect (the safe choice)    O: trust it this once    A: trust it, in place of the old key" ]

                        Session.TrustHostKey k ->
                            [ line ""
                            , line (bold ("The host " ++ cleanText k.host ++ " is not known."))
                            , line ("  Its " ++ k.algorithm ++ " key's fingerprint:")
                            , line ("    " ++ k.fingerprint)
                            , if Array.isEmpty k.knownTypes then
                                ""

                              else
                                line ("  It is known by its " ++ String.join ", " k.knownTypes ++ " key, not this one.")
                            , line ""
                            , line "  A: trust it and remember it    O: trust it this once    Esc: do not connect"
                            ]

                        Session.Password p ->
                            [ line "", line (bold (cleanText p.prompt ++ ": ") ++ hidden asking.typed ++ mark), line "", line (dim "  Enter: log in    Esc: do not use a password") ]

                        Session.Passphrase p ->
                            [ line "", line (bold ("The passphrase for " ++ cleanText p.file ++ ": ") ++ hidden asking.typed ++ mark), line "", line (dim "  Enter: unlock the key    Esc: do not use this key") ]

                        Session.Responses r ->
                            let
                                current =
                                    Array.get (Array.length asking.given) r.prompts

                                shown =
                                    when current is
                                        Just prompt ->
                                            line
                                                (bold (cleanText prompt.text)
                                                    ++ (if prompt.echo then
                                                            asking.typed

                                                        else
                                                            hidden asking.typed
                                                       )
                                                    ++ mark
                                                )

                                        Nothing ->
                                            meant Reason.NoMore ""
                            in
                            [ line ""
                            , if r.name == "" then
                                ""

                              else
                                line (bold ("The server asks: " ++ cleanText r.name))
                            , if r.instruction == "" then
                                ""

                              else
                                line (cleanText r.instruction)
                            , shown
                            , line ""
                            , line (dim "  Enter: answer    Esc: do not answer")
                            ]

                Nothing ->
                    meant Reason.NotOpen
                        when screen.failed is
                            Just why ->
                                [ line "", line (bold "The session could not go on:") ] ++ Array.map (\l -> line ("  " ++ l)) (String.lines why) ++ [ line "", line "  Enter: close    R: connect again" ]

                            Nothing ->
                                meant Reason.NotOpen []

        -- the cursor only where something is typed
        typingAsked =
            when screen.asking is
                Just asking ->
                    when asking.ask is
                        Session.TrustHostKey _ ->
                            False

                        Session.HostKeyChanged _ ->
                            False

                        _ ->
                            True

                Nothing ->
                    meant Reason.NotOpen False

        -- a question in a box over the screen is not on it (SC23)
        question =
            if boxed then
                []

            else
                asked

        typing =
            not boxed && typingAsked

        text =
            String.join ""
                ([ "\u{001B}[2J\u{001B}[H"
                 , if typing then
                    "\u{001B}[?25h"

                   else
                    "\u{001B}[?25l"
                 , line (bold ("puritty: ssh to " ++ cleanText screen.host))
                 , line ""
                 ]
                    ++ Array.map (\l -> line (dim ("  " ++ l))) (Array.takeLast (max 1 (m.term.rows - 12)) screen.lines)
                    ++ question
                    -- the cursor back after what is typed (DECRC)
                    ++ [ if typing then
                            "\u{001B}8"

                         else
                            ""
                       ]
                )
    in
    Vt.new
        { cols = m.term.cols
        , rows = m.term.rows
        , scrollbackBytes = 0
        , pageRows = Vt.defaultPageRows
        , checksums = False
        , cellWidth = m.term.config.cellWidth
        , cellHeight = m.term.config.cellHeight
        }
        |> Vt.feed (Bytes.fromString text)


handleOne : Backend -> Int -> Array Window.Event -> Window.Event -> (taken m : Model) -> Task Error Model
handleOne remote ms rest ev m =
    when ev is
        Window.Key k ->
            -- the dialog that is up takes the keys (docs/refine-survey.md RS3)
            when dialogUp m is
                StartFailedUp ->
                    -- the box saying a tab did not start takes the keys
                    (if k.action /= 0 then
                        startFailedKey k m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                DropAsking a ->
                    -- the question before dropped files are sent (FT28)
                    (if k.action /= 0 then
                        dropKey k a m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                Conflicting sending ->
                    -- the conflict question takes the keys (docs/sftp.md FT25)
                    (if k.action /= 0 then
                        conflictKey k sending m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                PickingUp pk ->
                    -- the folder picker's working model takes the keys (docs/sftp.md FT32)
                    (if k.action /= 0 then
                        pickerStep (Picker.key demoWith { sym = k.sym, unshifted = k.unshifted, mods = k.mods, text = Bytes.toStringLossy k.text } pk.picker) pk m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                ChoosingUp c ->
                    -- the folder chooser takes the keys (docs/sftp.md FT24)
                    (if k.action /= 0 then
                        chooserKey k c m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                PasteAsking a ->
                    -- the question before a picture is written takes the keys (docs/sftp.md FT16)
                    (if k.action /= 0 then
                        pasteKey k a m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                ClosingUp c ->
                    -- the question before closing takes the keys (TB4)
                    (if k.action /= 0 then
                        closeKey k c m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                EntryAsking ->
                    -- and the question before control mode (docs/tmux.md TM108)
                    (if k.action /= 0 then
                        entryKey k ms m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                RenamingUp r ->
                    -- the rename box takes the keys while it is open (TB1)
                    (if k.action /= 0 then
                        renameKey k r m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                ColoringUp id ->
                    -- and the color box (TB9)
                    (if k.action /= 0 then
                        colorKey k id m

                     else
                        Task.succeed m
                    )
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                NoDialog ->
                    if ownScreenUp m then
                        -- puritty's own screen takes the keys (docs/ssh-client.md SC18)
                        (if k.action /= 0 then
                            sshKey remote k m

                         else
                            Task.succeed m
                        )
                            |> Task.andThen (\next -> handle next.remote ms rest next)

                    else
                        when { menu = m.menu, search = m.search, pressed = k.action /= 0, copy = isCopyKey m.config k } is
                            { menu = Just menu, search = _, pressed = True, copy = _ } ->
                                -- the menu takes the keys while it is open
                                menuKey k.sym menu m |> Task.andThen (\next -> handle remote ms rest next)

                            { menu = Nothing, search = Just s, pressed = True, copy = False } ->
                                -- the search bar takes the keys while it is open (§23),
                                -- but Ctrl+Shift+C, which copies the match
                                handle remote ms rest (searchKey k s m)

                            _ ->
                                if isSearchKey m.config k && not (TmuxMode.isOn m.tmux) then
                                    handle remote ms rest { m | search = Just Search.start, urgent = True }

                                else if isSettingsKey m.config k then
                                    -- Ctrl+Comma: the settings window (docs/settings.md ST9),
                                    -- which raises one already open
                                    openSettings m |> Task.andThen (\next -> handle remote ms rest next)

                                else if tabAction k m /= Nothing then
                                    -- the tabs' keys (docs/tabs.md TB1)
                                    when tabAction k m is
                                        Just action ->
                                            tabDo action m |> Task.andThen (\next -> handle next.remote ms rest next)

                                        Nothing ->
                                            meant Reason.NotKnown (handle remote ms rest m)

                                else
                                    when zoomOf m k is
                                        Just points ->
                                            Window.zoom points
                                                |> Task.andThen
                                                    (\cell ->
                                                        -- every cell is drawn again at the new size
                                                        handle remote ms rest (cellSized cell { m | points = points, shadow = View.shadowIn m.term.cols m.term.rows m.windowRows, urgent = True })
                                                    )

                                        Nothing ->
                                            meant Reason.NotKnown
                                                if isPasteKey m.config k /= Nothing then
                                                    -- Shift+Insert and Ctrl+Shift+V, the
                                                    -- terminal's before the program's
                                                    owned remote ms rest { m | toPaste = Maybe.map (pasteFrom m.config) (isPasteKey m.config k) }

                                                else if isCopyKey m.config k then
                                                    -- Ctrl+Shift+C: the selection to CLIPBOARD
                                                    -- (docs/user/copy-and-paste.md), the key
                                                    -- puritty's with or without one
                                                    owned remote
                                                        ms
                                                        rest
                                                        (if TmuxMode.isOn m.tmux then
                                                            when TmuxMode.selectedText m.tmux is
                                                                Just text ->
                                                                    { m | toOwn = Just { which = Window.Clipboard, text = text } }

                                                                Nothing ->
                                                                    meant Reason.NotOpen m

                                                         else
                                                            when m.selection is
                                                                Just s ->
                                                                    { m | toOwn = Just { which = Window.Clipboard, text = Vt.selectionText s.anchor s.head m.term } }

                                                                Nothing ->
                                                                    meant Reason.NotOpen m
                                                        )

                                                else if
                                                    TmuxMode.isOn m.tmux
                                                then
                                                    -- the tabs' keys, then the active pane's
                                                    -- view (docs/tmux.md TM17, TM18)
                                                    let
                                                        tabbed =
                                                            TmuxMode.tabKey k m.tmux
                                                    in
                                                    if tabbed.used then
                                                        handle remote ms rest (sendCommands tabbed.commands { m | tmux = tabbed.state, urgent = True })

                                                    else
                                                        let
                                                            scrolled =
                                                                TmuxMode.scrollKey k tabbed.state
                                                        in
                                                        if scrolled.used then
                                                            handle remote ms rest { m | tmux = scrolled.state, urgent = True }

                                                        else
                                                            key remote ms rest k { m | tmux = scrolled.state }

                                                else
                                                    when scrollKeyOf m k is
                                                        Just back ->
                                                            handle remote ms rest { m | back = back, urgent = True }

                                                        Nothing ->
                                                            meant Reason.NotKnown key remote ms rest k m

        Window.Resized size ->
            -- every tab at the window's size, less the bar's row
            -- while it shows (docs/tabs.md TB2); and whether it is
            -- maximized now, its normal size kept while it is not (WP8)
            Window.isMaximized
                |> Task.andThen
                    (\state ->
                        relayout size.cols
                            { m
                                | windowRows = size.rows
                                , maximized = state.maximized
                                , normalSize =
                                    if state.any then
                                        m.normalSize

                                    else
                                        { columns = size.cols, rows = size.rows }
                            }
                    )
                |> Task.andThen (\next -> handle next.remote ms rest next)

        Window.Focus on ->
            let
                report =
                    if modeOn 1004 m then
                        if on then
                            Bytes.fromString "\u{001B}[I"

                        else
                            Bytes.fromString "\u{001B}[O"

                    else
                        Bytes.empty
            in
            (if on then
                refreshRecents m

             else
                Task.succeed m
            )
                |> Task.andThen (\next -> handle remote ms rest (send report { next | focus = { focused = on, blinkOn = True }, urgent = True, blinkAt = -1 }))

        Window.Close ->
            -- asked first when a tab is busy (docs/tabs.md TB7)
            askCloseWindow m
                |> Task.andThen
                    (\next ->
                        if next.closed then
                            Task.succeed next

                        else
                            handle next.remote ms rest next
                    )

        Window.MenuChosen c ->
            menuChosen c m |> Task.andThen (\next -> handle remote ms rest next)

        Window.Note text ->
            -- what the X server did with the window (docs/rhel8-etx.md RE9)
            handle remote ms rest (logLine "window" text m)

        Window.Rescaled _ ->
            -- the window moved to a monitor of another scale
            -- (docs/windows.md WS30): the cell is the window's
            -- own, and the Resized that follows draws every cell
            handle remote ms rest m

        Window.Commit text ->
            when m.renaming is
                Just r ->
                    handle remote ms rest (renameTyped (Bytes.toStringLossy text) r m)

                Nothing ->
                    meant Reason.NotOpen
                        (if m.coloring /= Nothing then
                            -- what the IME commits is no answer to the color box
                            handle remote ms rest m

                         else if ownScreenUp m then
                            -- what the IME commits, typed into the question
                            handle remote ms rest (sshTyped (Bytes.toStringLossy text) m)

                         else if TmuxMode.isAsking m.tmux then
                            -- typed into tmux's prompt that puritty asks (TM25)
                            handle remote ms rest { m | tmux = TmuxMode.typeInto (Bytes.toStringLossy text) m.tmux, urgent = True }

                         else
                            -- the key path: the text as typed, never as a paste (V46)
                            -- one key sound for the commit (feature-plan.md §3)
                            imeLine m.imeLog ("commit " ++ Bytes.toStringLossy text)
                                |> Task.andThen
                                    (\_ ->
                                        if m.config.soundKeys then
                                            Window.sound 0 |> Task.map (\_ -> {})

                                        else
                                            Task.succeed {}
                                    )
                                |> Task.andThen (\_ -> handle remote ms rest (send text { m | urgent = True, back = 0 }))
                        )

        Window.Preedit p ->
            let
                cps =
                    Array.map Char.toCode (String.toArray (Bytes.toStringLossy p.text))

                old =
                    m.preedit

                -- the span the input method changed, within the old text: its
                -- first and length are the X server's, and their sum could
                -- wrap (docs/refine-survey.md RS9)
                spanStart =
                    clamp 0 (Array.length old.points) p.first

                spanEnd =
                    spanStart + clamp 0 (Array.length old.points - spanStart) p.length

                points =
                    Array.takeFirst spanStart old.points ++ cps ++ Array.dropFirst spanEnd old.points

                feedback =
                    Array.takeFirst spanStart old.feedback
                        ++ Array.initialize (Array.length cps) 0 (\i -> Maybe.withDefault (meant Reason.FromOutside 0) (Array.get i p.feedback))
                        ++ Array.dropFirst spanEnd old.feedback
            in
            imeLine m.imeLog ("preedit " ++ String.fromArray (Array.mapAndKeepJust Char.fromCode points) ++ " caret " ++ String.fromInt p.caret ++ " feedback " ++ String.join " " (Array.map String.fromInt feedback))
                |> Task.andThen (\_ -> handle remote ms rest { m | preedit = { points = points, feedback = feedback, caret = p.caret }, urgent = True })

        Window.ImeReady ->
            imeLine m.imeLog "ime ready"
                |> Task.andThen (\_ -> handle remote ms rest m)

        Window.PreeditDone ->
            imeLine m.imeLog "done"
                |> Task.andThen (\_ -> handle remote ms rest { m | preedit = { points = [], feedback = [], caret = 0 }, urgent = True })

        Window.Pointer p ->
            if
                p.action == 2 && m.held == 0 && not (Maybe.isJust m.picking || Maybe.isJust m.choosing) && not
                                                                                                            (if TmuxMode.isOn m.tmux then
                                                                                                                TmuxMode.anyMotion m.tmux

                                                                                                             else
                                                                                                                (Vt.mouseModes m.term).tracking == Mouse.any
                                                                                                            )
            then
                -- a motion with no button held that nothing asked for,
                -- sent for the pointer's shape alone (TM38); under tmux
                -- a pane's program may ask (TM61)
                handle remote ms rest { m | hover = Just p }

            else if m.hover /= Just p then
                -- the pointer's place kept for its shape, and the event
                -- then taken as before, by itself: `handle` would log it
                -- a second time (DG7)
                handleOne remote ms rest (Window.Pointer p) { m | hover = Just p }

            else
                -- the dialog that is up takes the pointer (docs/refine-survey.md RS3)
                when dialogUp m is
                    StartFailedUp ->
                        -- and the pointer: its button dismisses it
                        (if p.action == 0 then
                            startFailedPress p m

                         else
                            Task.succeed m
                        )
                            |> Task.andThen (\next -> handle next.remote ms rest next)

                    DropAsking a ->
                        -- the question before dropped files are sent
                        (if p.action == 0 then
                            dropPress p a m

                         else
                            Task.succeed m
                        )
                            |> Task.andThen (\next -> handle next.remote ms rest next)

                    Conflicting sending ->
                        -- the conflict question takes the pointer
                        (if p.action == 0 then
                            conflictPress p sending m

                         else
                            Task.succeed m
                        )
                            |> Task.andThen (\next -> handle next.remote ms rest next)

                    up ->
                        when noteBarSending p m is
                            Just sending ->
                                -- a click on the progress cancels the batch (FT25)
                                sendingStep (Sending.cancel sending) { m | urgent = True }
                                    |> Task.andThen (\next -> handle next.remote ms rest next)

                            Nothing ->
                                meant Reason.NotOpen
                                    (when up is
                                        PickingUp pk ->
                                            -- the folder picker's working model takes the pointer, its motion too, for what is under it
                                            pickerStep (Picker.pointer (overlaySize m) demoWith { action = p.action, button = p.button, x = p.x, y = p.y, ms = ms } pk.picker) pk m
                                                |> Task.andThen (\next -> handle next.remote ms rest next)

                                        ChoosingUp c ->
                                            -- the folder picker takes the pointer, its motion too, for what is under it (docs/sftp.md FT32)
                                            chooserPointer p ms c m
                                                |> Task.andThen (\next -> handle next.remote ms rest next)

                                        PasteAsking a ->
                                            -- the paste question takes the pointer, as the close question does
                                            (if p.action == 0 then
                                                pastePress p a m

                                             else
                                                Task.succeed m
                                            )
                                                |> Task.andThen (\next -> handle next.remote ms rest next)

                                        ClosingUp c ->
                                            -- the close question takes the pointer: its buttons answer it, and nothing reaches the terminal (TB12)
                                            (if p.action == 0 then
                                                closePress p c m

                                             else
                                                Task.succeed m
                                            )
                                                |> Task.andThen (\next -> handle next.remote ms rest next)

                                        EntryAsking ->
                                            (if p.action == 0 then
                                                entryPress p ms m

                                             else
                                                Task.succeed m
                                            )
                                                |> Task.andThen (\next -> handle next.remote ms rest next)

                                        ColoringUp id ->
                                            -- the color box takes the presses while it is open (TB9)
                                            (if p.action == 0 then
                                                colorPress p id m

                                             else
                                                Task.succeed m
                                            )
                                                |> Task.andThen (\next -> handle next.remote ms rest next)

                                        _ ->
                                            if p.action == 0 && p.button == 1 && ownScreenUp m && rememberOffered m then
                                                -- the ssh question's box: a click on its checkbox ticks it
                                                -- and gives it the keys, one elsewhere gives them back to
                                                -- the field (docs/saved-secrets.md PW10)
                                                handle remote ms rest (rememberPress p m)

                                            else if p.action == 0 && barRows m > 0 && p.y >= m.term.rows * max 1 p.cellHeight then
                                                -- a press on the tab bar (docs/tabs.md TB1)
                                                barPress ms p m |> Task.andThen (\next -> handle next.remote ms rest next)

                                            else
                                                when { menu = m.menu, pressed = p.action == 0 } is
                                                    { menu = Just menu, pressed = True } ->
                                                        menuPress p menu m |> Task.andThen (\next -> handle remote ms rest next)

                                                    _ ->
                                                        if isMenuClick p then
                                                            openMenu p m |> Task.andThen (\next -> handle remote ms rest next)

                                                        else if
                                                            isZoomStep p
                                                        then
                                                            -- Ctrl and the wheel: puritty's always, a point a
                                                            -- step, the steps that came together one zoom
                                                            -- (docs/phase3-select.md §11, §17)
                                                            let
                                                                steps =
                                                                    zoomSteps rest (stepOf p)

                                                                points =
                                                                    clamp 4 96 (m.points + steps.net)
                                                            in
                                                            if points == m.points then
                                                                handle remote ms steps.rest m

                                                            else
                                                                Window.zoom points
                                                                    |> Task.andThen
                                                                        (\cell ->
                                                                            handle remote ms steps.rest (cellSized cell { m | points = points, shadow = View.shadowIn m.term.cols m.term.rows m.windowRows, urgent = True })
                                                                        )

                                                        else
                                                            owned remote ms rest (pointer ms p m)
                                    )

        Window.Pasted more ->
            Window.pasted
                |> Task.andThen
                    (\text ->
                        handle remote
                            ms
                            rest
                            (when m.clipRead is
                                Just r ->
                                    clipReadIn more text r m

                                Nothing ->
                                    meant Reason.NotOpen pasteIn more text m
                            )
                    )

        Window.PastedImage more ->
            Window.pasted
                |> Task.andThen
                    (\bytes ->
                        let
                            got =
                                when m.imagePaste is
                                    Gathering pieces ->
                                        Array.pushLast bytes pieces

                                    _ ->
                                        [ bytes ]
                        in
                        if more then
                            handle remote ms rest { m | imagePaste = Gathering got }

                        else
                            imagePasted (Bytes.flatten got) { m | imagePaste = NoImagePaste, turnMs = ms }
                                |> Task.andThen (handle remote ms rest)
                    )

        Window.DragOver d ->
            if Maybe.isJust m.picking || Maybe.isJust m.choosing then
                handle remote ms rest (pickerDragOver { x = d.x, y = d.y } m)

            else if TmuxMode.isOn m.tmux && isRemoteTab m then
                -- in an ssh tab under tmux -CC, the pane under the pointer is
                -- marked with the folder the files would go to (docs/sftp.md
                -- FT6, FT23)
                let
                    r =
                        TmuxMode.dragOver { col = d.x // max 1 d.cellWidth, row = d.y // max 1 d.cellHeight, ms = ms } m.tmux
                in
                handle remote ms rest (sendCommands r.commands { m | tmux = r.state, urgent = r.changed || m.urgent })

            else
                handle remote ms rest m

        Window.DragLeft ->
            if Maybe.isJust m.picking || Maybe.isJust m.choosing then
                handle remote ms rest (pickerDragLeft m)

            else if TmuxMode.dropTarget m.tmux /= Nothing then
                handle remote ms rest { m | tmux = TmuxMode.dragLeft m.tmux, urgent = True }

            else
                handle remote ms rest m

        Window.Dropped more ->
            Window.dropped
                |> Task.andThen
                    (\bytes ->
                        if more then
                            handle remote ms rest { m | dropGather = Array.pushLast bytes m.dropGather }

                        else
                            (if m.settings.given.tryPicker then
                                -- the working model's: the picker, opened
                                -- or answered (docs/sftp.md FT32)
                                Task.succeed (pickerDropped (Bytes.flatten (Array.pushLast bytes m.dropGather)) { m | dropGather = [], turnMs = ms })

                             else
                                filesDropped (Bytes.flatten (Array.pushLast bytes m.dropGather)) { m | dropGather = [], turnMs = ms }
                                    |> Task.andThen chooserIo
                                    |> Task.andThen startPending
                            )
                                |> Task.andThen (handle remote ms rest)
                    )

        Window.SelectionLost which ->
            -- another program's selection now: the highlight goes,
            -- as xterm takes it away
            handle remote
                ms
                rest
                (if which == Window.Primary then
                    { m | selection = Nothing, urgent = True }

                 else
                    m
                )


{-| The events after one that made a selection the window's, or asked
for a paste: the window told first. -}
owned : Backend -> Int -> Array Window.Event -> (taken m : Model) -> Task Error Model
owned remote ms rest m =
    when m.toOwn is
        Just own ->
            let
                -- a selection made, copied to the clipboard as well when
                -- the settings say (docs/windows.md WS27)
                next =
                    if own.which == Window.Primary && m.config.copyToClipboard then
                        Just { which = Window.Clipboard, text = own.text }

                    else
                        Nothing
            in
            Window.select own.which (Bytes.fromString own.text)
                |> Task.andThen (\_ -> owned remote ms rest { m | toOwn = next })

        Nothing ->
            meant Reason.NoMore
                when m.toPaste is
                    Just which ->
                        -- the clipboard's text, or its picture when it holds
                        -- no text (docs/sftp.md FT13)
                        (if which == Window.Clipboard && m.clipRead == Nothing then
                            Window.pasteOrImage

                         else
                            Window.paste which
                        )
                            |> Task.andThen
                                (\_ ->
                                    handle remote
                                        ms
                                        rest
                                        (logLine "paste"
                                            ("asked from "
                                                ++ (if which == Window.Primary then
                                                        "the selection (primary)"

                                                    else
                                                        "the clipboard"
                                                   )
                                            )
                                            { m | toPaste = Nothing, imagePaste = NoImagePaste }
                                        )
                                )

                    Nothing ->
                        meant Reason.NoMore handle remote ms rest m


{-| An OSC 8 link Ctrl+clicked, opened as the desktop opens one (Open: xdg-open,
the shell's "open"), if it is a web, mail or local file link (`Links`);
what happened said in the log (docs/claude-code.md CL9). -}
linkOpened : (taken m : Model) -> Task x Model
linkOpened m =
    when m.toOpen is
        Just uri ->
            let
                cleared =
                    { m | toOpen = Nothing }
            in
            if Links.openable { remote = isRemoteTab cleared } uri && Links.click { now = cleared.turnMs, asked = cleared.linkAsked } uri == Links.ShowFirst then
                -- shown first, not written to the log: the URI is a
                -- program's text (review W1)
                Task.succeed
                    (logLine "link"
                        ("shown before it is opened, " ++ String.fromInt (String.count uri) ++ " characters")
                        { cleared
                            | linkAsked = Just { uri = uri, until = Clock.after cleared.turnMs noteMs }
                            , note = Just { text = "Ctrl+click again to open " ++ uri, failed = False, until = Clock.after cleared.turnMs noteMs }
                            , urgent = True
                        }
                    )

            else if Links.openable { remote = isRemoteTab cleared } uri then
                Open.link (Maybe.map .cp m.settingsWindow) uri
                    |> Task.map
                        (\opened ->
                            when opened is
                                Ok _ ->
                                    logLine "link" ("opened, " ++ String.fromInt (String.count uri) ++ " characters") { cleared | linkAsked = Nothing }

                                Err why ->
                                    meant Reason.Refused (logLine "link" ("not opened: " ++ why) { cleared | linkAsked = Nothing })
                        )

            else
                Task.succeed (logLine "link" "not opened: not a web, mail or local file link" cleared)

        Nothing ->
            meant Reason.NotSet Task.succeed m


{-| The OSC 52 requests the core made (docs/phase3-select.md §16): a write
makes the window own the selection with its text, as a copy does, and a
write to PRIMARY takes a selection's highlight away; a read is answered only
under `[clipboard] osc52_read = "allow"`, with the selection's text asked of
its owner as a paste is and sent back as base64, and is otherwise dropped
with no answer. -}
clipboardRequests : (taken m : Model) -> Task x Model
clipboardRequests m =
    when Array.first m.clips is
        Nothing ->
            meant Reason.NoMore Task.succeed m

        Just c ->
            let
                rest =
                    { m | clips = Array.dropFirst 1 m.clips }

                which =
                    if c.selection == 0 then
                        Window.Primary

                    else
                        Window.Clipboard
            in
            when c.text is
                Just text ->
                    Window.select which text
                        |> Task.andThen
                            (\_ ->
                                clipboardRequests
                                    (if c.selection == 0 then
                                        { rest | selection = Nothing, urgent = True }

                                     else
                                        rest
                                    )
                            )

                Nothing ->
                    meant Reason.FromOutside
                        if rest.config.osc52Read && rest.clipRead == Nothing then
                            Window.paste which
                                |> Task.andThen
                                    (\asked ->
                                        clipboardRequests
                                            (if asked then
                                                { rest | clipRead = Just { letter = c.letter, bel = c.bel, text = Bytes.empty } }

                                             else
                                                rest
                                            )
                                    )

                        else
                            clipboardRequests rest


{-| An OSC 52 read's text, as it comes; when it is all there, the answer
the program asked for, `OSC 52 ; LETTER ; BASE64` ended as its question was. -}
clipReadIn : Bool -> Bytes -> { letter : Int, bel : Bool, text : Bytes } -> (taken m : Model) -> Model
clipReadIn more text r m =
    let
        all =
            Bytes.flatten [ r.text, text ]
    in
    if more then
        { m | clipRead = Just { r | text = all } }

    else
        sendRaw
            (Bytes.flatten
                [ Bytes.fromString ("\u{001B}]52;" ++ String.fromChar (Maybe.withDefault (meant Reason.FromOutside 'c') (Char.fromCode r.letter)) ++ ";")
                , Base64.encode all
                , Bytes.fromString
                    (if r.bel then
                        "\u{0007}"

                     else
                        "\u{001B}\\"
                    )
                ]
            )
            { m | clipRead = Nothing }


{-| A paste's text, as it comes (docs/phase3-select.md §15): encoded as
Ghostty and xterm encode a paste (`Vt.Paste`), bracketed when the program
had mode 2004 set when its first text came, and queued as typed text is, in
the pane's character set. The view comes to the bottom, as for a key. -}
pasteIn : Bool -> Bytes -> (taken m : Model) -> Model
pasteIn more text m =
    if TmuxMode.isAsking m.tmux then
        -- into tmux's prompt that puritty asks, its line ends as spaces
        -- (docs/tmux.md TM25)
        logLine "paste" (String.fromInt (Bytes.length text) ++ " bytes into tmux's prompt") { m | tmux = TmuxMode.typeInto (Bytes.toStringLossy text) m.tmux, urgent = True }

    else
        pasteInto more text m


{-| A paste's line ends as Enter sends them, CR, bracketed or not, as
xterm, VTE, PuTTY and Windows Terminal paste them; CRLF one CR (docs/tmux.md
TM95). Ghostty's encoder (`Vt.Paste`, held to it by the paste gate) keeps LF
in a bracketed paste, and a program that never asked for brackets gets it
through tmux, which brackets a paste only for the programs that asked: LF is
Ctrl-J to it, Justify to an older nano, which joined the pasted lines. -}
lineEnds : Bytes -> Bytes
lineEnds bytes =
    Bytes.fromUInt8s (lineEndsFrom bytes 0 (Bytes.length bytes) -1 [])


lineEndsFrom : Bytes -> Int -> Int -> Int -> Array UInt8 -> Array UInt8
lineEndsFrom bytes i n last out =
    if i >= n then
        out

    else
        let
            u =
                Bytes.getProven i bytes

            b =
                UInt8.toInt u
        in
        if b == 0x0A then
            if last == 0x0D then
                lineEndsFrom bytes (i + 1) n b out

            else
                lineEndsFrom bytes (i + 1) n b (Array.pushLast (UInt8.fromInt 0x0D) out)

        else
            lineEndsFrom bytes (i + 1) n b (Array.pushLast u out)


pasteInto : Bool -> Bytes -> (taken m : Model) -> Model
pasteInto more text m =
    let
        first =
            m.pasting == Nothing

        bracketed =
            Maybe.withDefault (meant Reason.NotYet modeOn 2004 m) m.pasting

        empty =
            first && not more && Bytes.isEmpty text

        bytes =
            if empty then
                Bytes.empty

            else
                Bytes.flatten
                    [ if first && bracketed then
                        Paste.bracketStart

                      else
                        Bytes.empty
                    , lineEnds (Paste.piece bracketed text)
                    , if not more && bracketed then
                        Paste.bracketEnd

                      else
                        Bytes.empty
                    ]

        -- under tmux -CC, given to tmux to paste (docs/tmux.md TM64): a
        -- tmux client turns bracketed paste on in its terminal at start
        -- (`tty_start_tty`), so a paste reaches it encoded as a bracketed
        -- one, its line ends `\n`, and tmux brackets it for the pane only
        -- where the program asked; puritty encodes it so and lets tmux
        -- bracket it, as tmux knows the pane's modes and puritty may not
        -- (3.6, measured)
        tmuxBytes =
            if empty then
                Bytes.empty

            else
                lineEnds (Paste.piece True text)

        updated =
            { m
                | diag =
                    Diag.add m.turnMs
                        "paste"
                        (String.fromInt (Bytes.length text)
                            ++ " bytes, "
                            ++ String.fromInt (Diag.lines text)
                            ++ " lines, "
                            ++ (if bracketed then
                                    "bracketed"

                                else
                                    "plain"
                               )
                            ++ (when { first = first, more = more } is
                                    { first = True, more = False } ->
                                        ", in one piece"

                                    { first = True, more = True } ->
                                        ", the first piece"

                                    { first = False, more = True } ->
                                        ", a later piece"

                                    { first = False, more = False } ->
                                        ", the last piece"
                               )
                            ++ ", sent "
                            ++ String.fromInt (Bytes.length bytes)
                            ++ " bytes to "
                            ++ (if TmuxMode.isOn m.tmux then
                                    "tmux's active pane"

                                else
                                    "the program"
                               )
                        )
                        m.diag
                , pasting =
                    if more then
                        Just bracketed

                    else
                        Nothing
                , back =
                    if empty then
                        m.back

                    else
                        0
                , urgent = True
            }
    in
    if TmuxMode.isOn updated.tmux then
        let
            r =
                TmuxMode.paste { first = first, last = not more } tmuxBytes updated.tmux
        in
        sendCommands r.commands { updated | tmux = r.state }

    else
        send bytes updated


{-| A press, release or motion of the pointer (docs/phase3-select.md §4):
reported to a program that asked for mouse reports, in its format, by
Ghostty's encoder (`Vt.Mouse`). Shift takes the mouse back from it, as in
Ghostty, xterm and kitty: a press or release of a button with Shift, or a
motion with Shift while a button is held, is puritty's own. The wheel is
not: Ghostty reports it with Shift too, and nvim pages with Shift and the
wheel. A motion is reported with the lowest-numbered button held, as
Ghostty reports it. -}
pointer : Int -> Window.PointerEvent -> (taken m : Model) -> Model
pointer ms p m =
    let
        modes =
            Vt.mouseModes m.term

        bit =
            Bitwise.shiftLeftBy p.button 1

        held =
            if p.button == 0 || (p.button >= 4 && p.button <= 7) then
                -- a wheel step is pressed and never held (`wheel` below)
                m.held

            else if p.action == 0 then
                Bitwise.or m.held bit

            else if p.action == 1 then
                Bitwise.and m.held (Bitwise.complement bit)

            else
                m.held

        wheel =
            p.button >= 4 && p.button <= 7

        taken =
            Bitwise.and p.mods 1 /= 0 && not wheel && (p.action /= 2 || held /= 0)

        -- Ctrl and the left button on an OSC 8 link opens it (CL9): with
        -- Shift too where the program takes the mouse, whose own a plain
        -- Ctrl+click then is
        linkPress =
            p.action == 0 && p.button == 1 && Bitwise.and p.mods 2 /= 0 && Bitwise.and p.mods 12 == 0

        link =
            if not linkPress then
                Nothing

            else if TmuxMode.isOn m.tmux then
                TmuxMode.linkAt p m.tmux

            else if modes.tracking == Mouse.none || Bitwise.and p.mods 1 /= 0 then
                Vt.linkAt (viewBack m)
                    { row = clamp 0 (m.term.rows - 1) (p.y // max 1 p.cellHeight)
                    , col = clamp 0 (m.term.cols - 1) (p.x // max 1 p.cellWidth)
                    }
                    m.term

            else
                Nothing
    in
    if link /= Nothing then
        { m | toOpen = link }

    else if TmuxMode.isOn m.tmux then
        -- tmux's panes, their programs and selections in them
        -- (docs/tmux.md TM16, TM17); Shift selects
        let
            r =
                TmuxMode.pointer { ms = ms, held = held, select = taken, boundaries = m.wordBoundaries, pasteButton = m.config.pasteButton } p m.tmux
        in
        sendCommands r.commands
            { m
                | held = held
                , tmux = r.state
                , urgent = True
                , toOwn = Maybe.map (\t -> { which = Window.Primary, text = t }) r.own
                , toPaste =
                    if r.paste then
                        Just (pasteFrom m.config Window.Primary)

                    else
                        m.toPaste
            }

    else if m.barDrag || (p.action == 0 && p.button == 1 && barShown m && Dialog.scrollbarHit (overlaySize m) { back = viewBack m, most = Vt.scrollbackRows m.term } { x = p.x, y = p.y } /= Nothing) then
        -- the scrollbar: a press puts the thumb at the pointer, a drag moves
        -- it, letting go ends the drag (§23)
        let
            back =
                Dialog.scrollbarHit (overlaySize m) { back = viewBack m, most = Vt.scrollbackRows m.term } { x = 1000000, y = p.y }
                    |> Maybe.withDefault (meant Reason.OutOfRange m.back)
        in
        { m | held = held, back = back, barDrag = held /= 0, urgent = True }

    else if modes.tracking == Mouse.none && wheel && p.action == 0 then
        wheelStep p.button { m | held = held }

    else if modes.tracking == Mouse.none || taken then
        selecting ms p held m

    else
        let
            r =
                Mouse.encode
                    { tracking = modes.tracking
                    , format = modes.format
                    , size =
                        { screenWidth = p.width
                        , screenHeight = p.height
                        , cellWidth = p.cellWidth
                        , cellHeight = p.cellHeight
                        , padTop = 0
                        , padBottom = 0
                        , padRight = 0
                        , padLeft = 0
                        }
                    , anyButtonPressed = held /= 0
                    , track = True
                    , last = m.mouseLast
                    }
                    { action = p.action
                    , button =
                        if p.action == 2 then
                            lowestHeld held 1

                        else
                            p.button
                    , mods = p.mods
                    , x = p.x
                    , y = p.y
                    }
        in
        sendRaw r.bytes { m | held = held, mouseLast = r.last }


{-| A step of the wheel no program asked for (docs/phase3-select.md §11):
on the alternate screen with mode 1007 set, three arrow keys, as Ghostty
sends them, in DECCKM's form; else the view scrolled three rows. A step
sideways does nothing. One step reported to a program that asked for the
mouse is one report, as xterm sends it; Ghostty sends three. -}
wheelStep : Int -> (taken m : Model) -> Model
wheelStep button m =
    let
        up =
            button == 4

        down =
            button == 5
    in
    if not (up || down) then
        m

    else if m.term.alt then
        if Dict.get 1007 m.term.modes == Just False then
            m

        else
            let
                arrow =
                    (if Dict.get 1 m.term.modes == Just True then
                        "\u{001B}O"

                     else
                        "\u{001B}["
                    )
                        ++ (if up then
                                "A"

                            else
                                "B"
                           )
            in
            send (Bytes.fromString (arrow ++ arrow ++ arrow)) m

    else if up then
        { m | back = min (Vt.scrollbackRows m.term) (m.back + 3), urgent = True }

    else
        { m | back = max 0 (m.back - 3), urgent = True }


{-| The left button selecting (docs/phase3-select.md §14): a press starts
a selection, a second and third within 500 ms on the same cell one by
words and by lines; a motion while it is held moves its head; letting go
makes it the window's PRIMARY, or takes it away when nothing was dragged. -}
selecting : Int -> Window.PointerEvent -> Int -> (taken m : Model) -> Model
selecting ms p held m =
    let
        at =
            pointAt p m
    in
    if p.button == m.config.pasteButton && p.action == 0 then
        -- the paste button (docs/user/copy-and-paste.md), PRIMARY, or
        -- the clipboard where it is the selection (WS27.2)
        { m | held = held, toPaste = Just (pasteFrom m.config Window.Primary) }

    else if p.button == 1 && p.action == 0 then
        let
            count =
                if m.clicks.count > 0 && Clock.since m.clicks.at ms <= 500 && m.clicks.cell == at then
                    modBy 3 m.clicks.count + 1

                else
                    1

            span =
                if count == 2 then
                    Vt.wordAt m.wordBoundaries at m.term

                else if count == 3 then
                    Vt.lineAt at m.term

                else
                    Just { start = at, end = at }

            sel =
                Maybe.map
                    (\w ->
                        { anchor = w.start
                        , head = w.end
                        , first = w.start
                        , last = w.end
                        , mode = count - 1
                        , moved = count > 1
                        , made = False
                        , alt = m.term.alt
                        , hashes = Dict.empty
                        }
                    )
                    span
        in
        { m | held = held, selection = sel, clicks = { at = ms, count = count, cell = at }, urgent = True }

    else if p.action == 2 && Bitwise.and held 2 /= 0 then
        when m.selection is
            Just s ->
                if s.made then
                    { m | held = held }

                else
                    { m | held = held, selection = Just (extended at s m), urgent = True }

            Nothing ->
                meant Reason.NotOpen { m | held = held }

    else if p.button == 1 && p.action == 1 then
        when m.selection is
            Just s ->
                if s.made then
                    { m | held = held }

                else if s.mode == 0 && not s.moved then
                    -- a click: no selection
                    { m | held = held, selection = Nothing, urgent = True }

                else
                    let
                        text =
                            Vt.selectionText s.anchor s.head m.term
                    in
                    { m
                        | held = held
                        , selection = Just { s | made = True, hashes = rowHashes s m.term }
                        , toOwn = Just { which = Window.Primary, text = text }
                    }

            Nothing ->
                meant Reason.NotOpen { m | held = held }

    else
        { m | held = held }


{-| A selection being dragged, its head at `at`: by cells, at it; by words
or lines, the word or line there, the first one kept on the far side. -}
extended : Vt.Point -> Selection -> Model -> Selection
extended at s m =
    if s.mode == 0 then
        { s | head = at, moved = True }

    else
        let
            span =
                if s.mode == 1 then
                    Vt.wordAt m.wordBoundaries at m.term

                else
                    Vt.lineAt at m.term

            w =
                Maybe.withDefault (meant Reason.OutOfRange { start = at, end = at }) span
        in
        if before w.start s.first then
            { s | anchor = s.last, head = w.start }

        else
            { s | anchor = s.first, head = w.end }


before : Vt.Point -> Vt.Point -> Bool
before a b =
    a.row < b.row || (a.row == b.row && a.col < b.col)


{-| The point under the pointer, kept on the screen (a drag past its edge
does not scroll the view yet). -}
pointAt : Window.PointerEvent -> Model -> Vt.Point
pointAt p m =
    let
        cw =
            max 1 p.cellWidth

        ch =
            max 1 p.cellHeight

        col =
            clamp 0
                (m.term.cols - 1)
                (if p.x < 0 then
                    0

                 else
                    p.x // cw
                )

        y =
            clamp 0
                (m.term.rows - 1)
                (if p.y < 0 then
                    0

                 else
                    p.y // ch
                )
    in
    { row = Vt.rowsPushed m.term + y - viewBack m, col = col }


{-| How far back the view is drawn: none while the alternate screen is up. -}
viewBack : Model -> Int
viewBack m =
    min m.back (Vt.scrollbackRows m.term)


{-| A hash of each of a selection's rows on the screen, by its row. -}
rowHashes : Selection -> Vt.Term -> Dict Int Int
rowHashes s t =
    let
        pushed =
            Vt.rowsPushed t

        lo =
            max pushed (min s.anchor.row s.head.row)

        hi =
            min (pushed + t.rows - 1) (max s.anchor.row s.head.row)
    in
    Array.foldl (\r d -> Dict.set r (Vt.rowsHash r r t) d) Dict.empty (Array.range lo hi)


{-| The selection after output: kept while the screen is the one it was
made on and none of its rows still on the screen changed (rows that have
scrolled off do not change). -}
kept : Maybe Selection -> Vt.Term -> Maybe Selection
kept sel t =
    when sel is
        Nothing ->
            meant Reason.NotOpen Nothing

        Just s ->
            if s.alt /= t.alt then
                Nothing

            else if not s.made then
                sel

            else
                let
                    pushed =
                        Vt.rowsPushed t

                    same =
                        Dict.foldl (\r h ok -> ok && (r < pushed || Vt.rowsHash r r t == h)) True s.hashes
                in
                if same then
                    sel

                else
                    Nothing


{-| The cells a selection covers on the screen drawn, for the view. -}
highlightOf : Model -> View.Highlight
highlightOf m =
    when m.selection is
        Nothing ->
            meant Reason.NotOpen View.noHighlight

        Just s ->
            let
                a =
                    if before s.head s.anchor then
                        s.head

                    else
                        s.anchor

                b =
                    if before s.head s.anchor then
                        s.anchor

                    else
                        s.head

                top =
                    Vt.rowsPushed m.term - viewBack m

                cols =
                    m.term.cols

                last =
                    cols * m.term.rows - 1

                from =
                    if a.row < top then
                        0

                    else
                        (a.row - top) * cols + a.col

                to =
                    (b.row - top) * cols + b.col
            in
            if to < 0 || from > last then
                View.noHighlight

            else
                { from = from, to = min last to }


{-| A press of the wheel up or down with Ctrl alone: a zoom's step. -}
isZoomStep : Window.PointerEvent -> Bool
isZoomStep p =
    p.action == 0 && (p.button == 4 || p.button == 5) && Bitwise.and p.mods 15 == 2


stepOf : Window.PointerEvent -> Int
stepOf p =
    if p.button == 4 then
        1

    else
        -1


{-| The zoom's steps that follow one in the same take, summed, and the
events after them: a touchpad's stroke sends several, and the window is
sized once. A motion between them, which X sends as the pointer drifts, is
passed over. -}
zoomSteps : Array Window.Event -> Int -> { net : Int, rest : Array Window.Event }
zoomSteps evs net =
    when Array.first evs is
        Just (Window.Pointer p) ->
            if isZoomStep p then
                zoomSteps (Array.dropFirst 1 evs) (net + stepOf p)

            else if p.action == 2 then
                zoomSteps (Array.dropFirst 1 evs) net

            else
                { net = net, rest = evs }

        _ ->
            meant Reason.NoMore { net = net, rest = evs }


lowestHeld : Int -> Int -> Int
lowestHeld held i =
    if i > 11 then
        0

    else if Bitwise.and held (Bitwise.shiftLeftBy i 1) /= 0 then
        i

    else
        lowestHeld held (i + 1)


{-| A key sent to the program, the cursor's blink begun again. -}
key : Backend -> Int -> Array Window.Event -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
key remote ms rest k m =
    let
        -- under tmux control mode, by the active pane's modes (docs/tmux.md TM16)
        bytes =
            if TmuxMode.isOn m.tmux then
                Maybe.withDefault (meant Reason.NotYet Bytes.empty) (TmuxMode.encodeKey k m.tmux)

            else
                Keys.encode m.term k

        blinkAt =
            if blinking m then
                Clock.after ms m.config.blinkMs

            else
                -1

        focus =
            { focused = m.focus.focused, blinkOn = True }

        clicked =
            keySound m.config k bytes
    in
    clicked
        |> Task.andThen
            (\_ ->
                handle remote
                    ms
                    rest
                    (sendKey k
                        bytes
                        ms
                        { m
                            | urgent = True
                            , focus = focus
                            , blinkAt = blinkAt
                            -- a key that reaches the program brings the view to the bottom
                            , back =
                                if Bytes.isEmpty bytes then
                                    m.back

                                else
                                    0
                        }
                    )
            )


{-| Where a paste of PRIMARY reads from (`docs/windows.md` WS27.2): the
clipboard when a selection is copied to it and PRIMARY is puritty's own,
as on Windows, so that what another program copied is pasted by the
middle button and Shift+Insert, as PuTTY's are on Windows; PRIMARY where
the desktop shares it (X), as PuTTY's are there. -}
pasteFrom : Config -> Window.Selection -> Window.Selection
pasteFrom config which =
    if which == Window.Primary && config.copyToClipboard && not Platform.sharedPrimary then
        Window.Clipboard

    else
        which


{-| The paste keys, pressed (docs/user/copy-and-paste.md): Shift+Insert
pastes PRIMARY, Ctrl+Shift+V CLIPBOARD. -}
isPasteKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Window.Selection
isPasteKey config k =
    if k.action /= 1 then
        Nothing

    else if bound config.keyPasteSelection k then
        Just Window.Primary

    else if bound config.keyPaste k then
        Just Window.Clipboard

    else
        Nothing


{-| Ctrl+Shift+F: the search bar (docs/phase3-select.md §23). -}
isSearchKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
isSearchKey config k =
    k.action == 1 && bound config.keySearch k


{-| A key while the search bar is open: Esc closes it; Enter finds the
next match older, Shift+Enter newer; Backspace and typed text change the
query, which is looked for again from the bottom of the view up. -}
searchKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Search.State -> (taken m : Model) -> Model
searchKey k s m =
    let
        viewBottom =
            Vt.rowsPushed m.term - viewBack m + m.term.rows - 1

        typed =
            Bytes.toStringLossy k.text

        ctrl =
            Bitwise.and k.mods 2 /= 0
    in
    if k.sym == 0xFF1B then
        { m | search = Nothing, urgent = True }

    else if k.sym == 0xFF0D || k.sym == 0xFF8D then
        let
            older =
                Bitwise.and k.mods 1 == 0

            from =
                when s.match is
                    Just mt ->
                        if older then
                            mt.start.row - 1

                        else
                            mt.start.row + 1

                    Nothing ->
                        meant Reason.NotYet viewBottom
        in
        found s (Search.find s.query older from m.term) m

    else if k.sym == 0xFF08 then
        let
            query =
                String.dropLast 1 s.query
        in
        let
            r =
                Search.findTyped query viewBottom s.missed m.term
        in
        found { s | query = query, missed = r.missed } r.match m

    else if typed /= "" && not ctrl && Array.all (\c -> Char.toCode c >= 0x20) (String.toArray typed) then
        let
            query =
                s.query ++ typed

            -- a query that begins with one found nowhere is not searched
            -- for again (review MAN1)
            r =
                Search.findTyped query viewBottom s.missed m.term
        in
        found { s | query = query, missed = r.missed } r.match m

    else
        m


{-| A search's match shown: the view scrolled to it, and it selected, so it
is highlighted and a copy takes it. -}
found : Search.State -> Maybe { start : Vt.Point, end : Vt.Point } -> (taken m : Model) -> Model
found s match m =
    when match is
        Just mt ->
            let
                sel =
                    { anchor = mt.start, head = mt.end, first = mt.start, last = mt.end, mode = 0, moved = True, made = True, alt = m.term.alt, hashes = Dict.empty }

                hashes =
                    rowHashes sel m.term

                back =
                    Search.backFor mt.start.row m.back m.term
            in
            { m | search = Just { s | match = Just mt, failed = False }, selection = Just { sel | hashes = hashes }, back = back, urgent = True }

        Nothing ->
            meant Reason.NoMore { m | search = Just { s | failed = s.query /= "" }, urgent = True }


{-| What puritty draws over the cells is sized by: the window in cells and
a cell in pixels. -}
overlaySize : Model -> { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int }
overlaySize m =
    { cols = m.term.cols, rows = m.term.rows, cellWidth = m.term.config.cellWidth, cellHeight = m.term.config.cellHeight }


{-| Whether the scrollbar shows: while the view is scrolled back or the
search bar is open, on puritty's terminal, not its own screen or tmux's. -}
barShown : Model -> Bool
barShown m =
    not (TmuxMode.isOn m.tmux) && not (ownScreenUp m) && Vt.scrollbackRows m.term > 0 && (viewBack m > 0 || m.search /= Nothing)


{-| Ctrl+Shift+C, pressed: the copy key (docs/user/copy-and-paste.md). -}
isCopyKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
isCopyKey config k =
    k.action == 1 && bound config.keyCopy k


{-| The keys that move a view of the scrollback (docs/phase3-select.md
§11), on the main screen, pressed or repeated: with Shift alone, PgUp and
PgDn a page, Home the top, End the bottom; with Ctrl and Shift, Up and Down
the shell's previous and next prompt, as Ghostty's `jump_to_prompt`. On the
alternate screen they are the program's, as in Alacritty and WezTerm. -}
scrollKeyOf : Model -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Int
scrollKeyOf m k =
    let
        most =
            Vt.scrollbackRows m.term
    in
    if k.action == 0 || most == 0 then
        Nothing

    else if Bitwise.and k.mods 15 == 3 && (k.sym == 0xFF52 || k.sym == 0xFF54) then
        Just
            (Vt.promptJump
                (if k.sym == 0xFF52 then
                    -1

                 else
                    1
                )
                m.back
                m.term
            )

    else if Bitwise.and k.mods 15 /= 1 then
        Nothing

    else if k.sym == 0xFF55 then
        Just (min most (m.back + m.term.rows))

    else if k.sym == 0xFF56 then
        Just (max 0 (m.back - m.term.rows))

    else if k.sym == 0xFF50 then
        Just most

    else if k.sym == 0xFF57 then
        Just 0

    else
        Nothing


{-| The zoom's keys (V50): Ctrl with `=` or `+` a point larger, with `-` a
point smaller, with `0` the configured size; pressed or repeated, without
alt or super. Any other key is the program's. -}
zoomOf : Model -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Int
zoomOf m k =
    if k.action == 0 || Bitwise.and k.mods 2 == 0 || Bitwise.and k.mods 12 /= 0 then
        Nothing

    else if k.sym == 0x3D || k.sym == 0x2B || k.sym == 0xFFAB then
        Just (min 96 (m.points + 1))

    else if k.sym == 0x2D || k.sym == 0xFFAD then
        Just (max 4 (m.points - 1))

    else if k.sym == 0x30 then
        Just m.config.points

    else
        Nothing


imeLine : Bool -> String -> Task x {}
imeLine on line =
    if on then
        Console.write (line ++ "\n")

    else
        Task.succeed {}


{-| Where the input method's window goes: at the top layer that has a
caret, the folder picker's, a dialog's box's or the search field's, else
the terminal's cursor. -}
spotOver : { picker : Maybe { a | spot : s }, box : Maybe { b | spot : s }, search : Maybe { c | spot : s } } -> s -> s
spotOver layers cursor =
    when layers.picker is
        Just pd ->
            pd.spot

        Nothing ->
            meant Reason.NotOpen
                (when layers.box is
                    Just bd ->
                        bd.spot

                    Nothing ->
                        meant Reason.NotOpen
                            (when layers.search is
                                Just sd ->
                                    sd.spot

                                Nothing ->
                                    meant Reason.NotOpen cursor
                            )
                )


{-| The last piece of `s` cut at `sep`: a separator that is not empty cuts
at least one piece, so the last is always there. -}
lastPiece : (sep : String where 1 <= String.count sep) -> String -> String
lastPiece sep s =
    let
        parts =
            String.split sep s
    in
    Array.getProven (Array.length parts - 1) parts


{-| The dialog that takes the keys and the pointer: the first that is up,
in the order they are asked (docs/refine-survey.md RS3). -}
type Dialog
    = StartFailedUp
    | DropAsking { folder : Bytes, files : Array Bytes, tab : Int }
    | Conflicting Sending.Sending
    | PickingUp Picking
    | ChoosingUp Choosing
    | PasteAsking PasteAsk
    | ClosingUp { id : Int, why : String, window : Bool }
    | EntryAsking
    | RenamingUp { id : Int, typed : String }
    | ColoringUp Int
    | NoDialog


dialogUp : Model -> Dialog
dialogUp m =
    if m.startFailed /= Nothing then
        StartFailedUp

    else
        dialogFromDrop m


dialogFromDrop : Model -> Dialog
dialogFromDrop m =
    when m.dropAsk is
        Just a ->
            DropAsking a

        Nothing ->
            meant Reason.NotOpen
                (when { asks = sendingAsks m, sending = m.sending } is
                    { asks = True, sending = Just sending } ->
                        Conflicting sending

                    _ ->
                        dialogFromPicker m
                )


dialogFromPicker : Model -> Dialog
dialogFromPicker m =
    when m.picking is
        Just pk ->
            PickingUp pk

        Nothing ->
            meant Reason.NotOpen (dialogFromChooser m)


dialogFromChooser : Model -> Dialog
dialogFromChooser m =
    when m.choosing is
        Just c ->
            ChoosingUp c

        Nothing ->
            meant Reason.NotOpen (dialogFromPaste m)


dialogFromPaste : Model -> Dialog
dialogFromPaste m =
    when m.pasteAsk is
        Just a ->
            PasteAsking a

        Nothing ->
            meant Reason.NotOpen (dialogFromClosing m)


dialogFromClosing : Model -> Dialog
dialogFromClosing m =
    when m.closing is
        Just c ->
            ClosingUp c

        Nothing ->
            meant Reason.NotOpen
                (if TmuxMode.entryAsked m.tmux then
                    EntryAsking

                 else
                    dialogFromRenaming m
                )


dialogFromRenaming : Model -> Dialog
dialogFromRenaming m =
    when m.renaming is
        Just r ->
            RenamingUp r

        Nothing ->
            meant Reason.NotOpen (dialogFromColoring m)


dialogFromColoring : Model -> Dialog
dialogFromColoring m =
    when m.coloring is
        Just id ->
            ColoringUp id

        Nothing ->
            meant Reason.NotOpen (NoDialog)


{-| The batch being sent, when a press is on its progress in the note bar:
the press cancels it (docs/sftp.md FT25). -}
noteBarSending : Window.PointerEvent -> Model -> Maybe Sending.Sending
noteBarSending p m =
    if Maybe.isJust m.sending && p.action == 0 && p.button == 1 && Dialog.noteBarAt (overlaySize m) (Maybe.map .text m.note |> Maybe.withDefault (meant Reason.NotOpen "")) { x = p.x, y = p.y } && Maybe.isJust m.note then
        m.sending

    else
        Nothing


{-| A frame drawn, and the window's title made the program's. -}
draw : Int -> (taken m : Model) -> Task x Model
draw ms m =
    let
        preedit =
            { text = String.fromArray (Array.mapAndKeepJust Char.fromCode m.preedit.points)
            , feedback = m.preedit.feedback
            , caret = m.preedit.caret
            }

        -- the alternate screen keeps no scrollback, so a view scrolled
        -- back shows the screen while it is up
        back =
            viewBack m

        highlight =
            highlightOf m

        ownUp =
            ownScreenUp m

        overlay =
            overlaySize m

        -- a question asked in a box over puritty's screen (SC23)
        dialog =
            if m.startFailed /= Nothing then
                Maybe.map startFailedBox m.startFailed

            else if m.closing /= Nothing then
                Maybe.map closeBox m.closing

            else if TmuxMode.entryAsked m.tmux then
                Just entryBox

            else if Maybe.isJust m.dropAsk then
                Maybe.map (dropBox m) m.dropAsk

            else if sendingAsks m then
                Maybe.andThen (\s -> Maybe.map (Sending.conflictBox (fromHost m.charset)) s.asking) m.sending

            else if Maybe.isJust m.choosing then
                -- the folder picker, drawn by `Picker.draw` below
                Nothing

            else if m.pasteAsk /= Nothing then
                Maybe.map pasteBox m.pasteAsk

            else if m.renaming /= Nothing then
                Maybe.map renameBox m.renaming

            else if m.coloring /= Nothing then
                Just (colorBox m)

            else if ownUp then
                Maybe.andThen dialogOf m.ssh

            else if tmuxOn then
                -- a prompt of tmux's in puritty's look (docs/tmux.md TM25)
                TmuxMode.promptBox m.tmux
                    |> Maybe.map
                        (\p ->
                            { title = p.title
                            , lines = []
                            , field =
                                if p.field then
                                    Just { typed = p.typed, hidden = False, caret = p.caret }

                                else
                                    Nothing
                            , swatches = []
                            , check = Nothing
                            , buttons = []
                            , hint = p.hint
                            }
                        )

            else
                Nothing

        boxed =
            dialog /= Nothing || Maybe.isJust m.picking || Maybe.isJust m.choosing

        own =
            if ownUp then
                Maybe.map (ownTerm m boxed) m.ssh

            else
                Nothing

        -- the tab bar, in the window's last row (docs/tabs.md TB1)
        tabsDrawn =
            tabBar m

        -- the scrollbar and the search bar (docs/phase3-select.md §23)
        bar =
            if barShown m then
                Dialog.scrollbar overlay { back = viewBack m, most = Vt.scrollbackRows m.term }

            else
                Bytes.empty

        searchDrawn =
            if ownUp || tmuxOn then
                Nothing

            else
                Maybe.map
                    (\s ->
                        Dialog.searchBar overlay
                            { query = s.query
                            , note =
                                if s.failed then
                                    "No match"

                                else
                                    "Enter: older    Shift+Enter: newer    Esc: close"
                            , failed = s.failed
                            }
                    )
                    m.search

        -- a note of what puritty did (docs/sftp.md FT13)
        noteDrawn =
            when m.note is
                Just n ->
                    Dialog.noteBar overlay { text = n.text, failed = n.failed }

                Nothing ->
                    meant Reason.NotOpen Bytes.empty

        -- every cell drawn while anything is over them, and in the frame
        -- the last of it goes: a scroll's copy would carry it along
        over =
            boxed || not (Bytes.isEmpty bar) || searchDrawn /= Nothing || not (Bytes.isEmpty noteDrawn)

        shadow0 =
            if over || m.overlaid then
                View.shadowIn m.term.cols m.term.rows m.windowRows

            else
                m.shadow

        boxDrawn =
            Maybe.map (Dialog.draw overlay) dialog

        -- the folder picker, the working model's or a tab's (docs/sftp.md
        -- FT32)
        pickerDrawn =
            when m.picking is
                Just pk ->
                    Just (Picker.draw overlay demoWith Picker.utcText pk.picker)

                Nothing ->
                    meant Reason.NotOpen
                        (if dialog == Nothing then
                            Maybe.map (\c -> Picker.draw overlay { decode = fromHost m.charset, encode = inHostCharset m.charset } (Picker.zonedText m.zone) c.picker) m.choosing

                         else
                            Nothing
                        )

        tmuxOn =
            TmuxMode.isOn m.tmux

        -- under tmux control mode the window is its panes (docs/tmux.md TM14)
        tmux =
            if tmuxOn then
                TmuxMode.paint m.tmux

            else
                m.tmux

        spot =
            View.preeditSpot preedit
                (if tmuxOn then
                    tmux.canvas

                 else
                    m.term
                )

        title =
            (if tmuxOn || ownUp then
                ""

             else
                statusMark (Vt.programStatus m.term |> Maybe.map .state |> Maybe.withDefault (meant Reason.NotSet ""))
            )
                ++ (if tmuxOn then
                        TmuxMode.title tmux

                    else if ownUp then
                        -- puritty's own while its screen is up, which no server can set
                        "puritty: ssh to " ++ (m.ssh |> Maybe.map .host |> Maybe.withDefault (meant Reason.NotOpen ""))

                    else if m.term.title == "" then
                        m.config.title

                    else
                        m.term.title
                   )
                ++ (if m.replaced > 0 then
                        " [" ++ String.fromInt m.replaced ++ " characters sent as ?]"

                    else
                        ""
                   )
                ++ (when Array.first m.troubles is
                        Just first ->
                            " [settings: "
                                ++ first
                                ++ (if Array.length m.troubles > 1 then
                                        " (and " ++ String.fromInt (Array.length m.troubles - 1) ++ " more)"

                                    else
                                        ""
                                   )
                                ++ "]"

                        Nothing ->
                            meant Reason.NoMore ""
                   )

        f =
            if tmuxOn then
                View.frameWith m.look m.focus preedit View.noHighlight tmux.canvas shadow0

            else
                when { own = own, menu = m.menu } is
                    { own = Just t } ->
                        View.frameWith m.look m.focus { text = "", feedback = [], caret = 0 } View.noHighlight t shadow0

                    { menu = Just menu } ->
                        -- the menu painted over a copy of the screen (ST26)
                        View.frameBack m.look m.focus 0 (Vt.viewPainted (menuPaints menu m.term.cols m.term.rows) m.term) highlight m.term shadow0

                    _ ->
                        if back > 0 then
                            View.frameBack m.look m.focus back (Vt.viewAt back m.term) highlight m.term shadow0

                        else
                            View.frameWith m.look m.focus preedit highlight m.term shadow0
    in
    -- the layers over the terminal that are up, in the order they are drawn
    Window.draw (Bytes.flatten ([ f.list, tabsDrawn, bar, noteDrawn ] ++ Array.mapAndKeepJust identity [ Maybe.map .list searchDrawn, Maybe.map .list boxDrawn, Maybe.map .list pickerDrawn ]))
        |> Task.andThen (\up -> Window.spot (spotOver { picker = pickerDrawn, box = boxDrawn, search = searchDrawn } spot) |> Task.map (\_ -> up))
        |> Task.andThen
            (\up ->
                (if title /= m.title then
                    Window.setTitle title

                 else
                    Task.succeed {}
                )
                    |> Task.map
                        (\_ ->
                            let
                                shadow =
                                    View.inked (Maybe.withDefault (meant Reason.Gone Bytes.empty) up) f.shadow

                                -- The view asks for a frame at once when new
                                -- ink lands on a glyph it did not draw (V40).
                                again =
                                    View.wantsFrame shadow
                            in
                            { m
                                | shadow = shadow
                                , tmux = tmux
                                , overlaid = over
                                , last = ms
                                , pending = -1
                                , urgent = again
                                , title = title
                                , lost = m.lost || up == Nothing
                                -- A hold that timed out begins again at the next read.
                                , syncSince = -1
                            }
                        )
            )


-- TABS (docs/tabs.md)


{-| What a tab key asks. -}
type TabAction
    = NewTab
    | CloseTab
    | NextTab
    | PrevTab
    | MoveRight
    | MoveLeft
    | RenameTab
    | ColorTab
    | ReopenTab
    | MarkLog


{-| The tab keys, as the `[keys]` table names them (docs/tabs.md TB1,
TB6), by default Ctrl+Shift+T a new tab, Ctrl+Shift+W the shown one
closed, Ctrl+Shift+R renamed, Ctrl+PgUp and Ctrl+PgDn the tab before and
after, Ctrl+Shift+PgUp and Ctrl+Shift+PgDn the shown tab moved. Under tmux
control mode, `new_tab`, `next_tab` and `previous_tab` are tmux's windows'
(TM18), and `next_tab_always` and `previous_tab_always` (Ctrl+Alt+PgUp
and PgDn) go between puritty's tabs. With one tab, a key that needs
another goes on to the program; so does a key whose entry is empty. When
two entries name one key, the first in this order has it. -}
tabAction : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Model -> Maybe TabAction
tabAction k m =
    let
        keys =
            m.config

        tmuxOn =
            TmuxMode.isOn m.tmux

        others =
            tabCount m > 1

        on name =
            bound name k
    in
    if k.action /= 1 then
        Nothing

    else if on keys.keyNewTab && not tmuxOn then
        Just NewTab

    else if on keys.keyCloseTab then
        Just CloseTab

    else if on keys.keyRenameTab then
        Just RenameTab

    else if on keys.keyColorTab then
        Just ColorTab

    else if on keys.keyReopenTab && closedWaiting m then
        Just ReopenTab

    else if on keys.keyMarkLog && Diag.isOn m.diag then
        Just MarkLog

    else if others && on keys.keyNextTabAlways then
        Just NextTab

    else if others && on keys.keyPreviousTabAlways then
        Just PrevTab

    else if others && not tmuxOn && on keys.keyNextTab then
        Just NextTab

    else if others && not tmuxOn && on keys.keyPreviousTab then
        Just PrevTab

    else if others && on keys.keyMoveTabRight then
        Just MoveRight

    else if others && on keys.keyMoveTabLeft then
        Just MoveLeft

    else
        Nothing


tabDo : TabAction -> (taken m : Model) -> Task Error Model
tabDo action m =
    when action is
        NewTab ->
            openTab m

        CloseTab ->
            askClose m

        NextTab ->
            Task.succeed (showTab (neighborId 1 m) m)

        PrevTab ->
            Task.succeed (showTab (neighborId -1 m) m)

        MoveRight ->
            Task.succeed (moveShown 1 m)

        MoveLeft ->
            Task.succeed (moveShown -1 m)

        RenameTab ->
            Task.succeed (startRenaming m)

        ColorTab ->
            Task.succeed (startColoring m)

        ReopenTab ->
            reopenTab m

        MarkLog ->
            markLog m


tabCount : (m : Model) -> (r : Int where r == Array.length m.order)
tabCount m =
    Array.length m.order


{-| The bar's rows: one while there are two tabs or more, or always
(`[tabs] bar`). -}
barRows : Model -> Int
barRows m =
    if tabCount m > 1 || m.config.tabsBar == "always" then
        1

    else
        0


{-| Where the shown tab is in the bar's order. -}
shownAt : (m : Model) -> (r : Int where 0 <= r && r < Array.length m.order)
shownAt m =
    m.shown


{-| The place `by` (one, either way) along from the shown tab, round past
the ends. -}
neighborAt : (by : Int where -1 <= by && by <= 1) -> (m : Model) -> (r : Int where 0 <= r && r < Array.length m.order)
neighborAt by m =
    TabOrder.around (Array.length m.order) (m.shown + by)


{-| The id `by` places along from the shown tab, round past the ends. -}
neighborId : (by : Int where -1 <= by && by <= 1) -> Model -> Int
neighborId by m =
    Array.getProven (neighborAt by m) m.order


{-| The tab not shown with this id taken out of its slot, which is left
empty: its slot and the tab, found and taken in one walk, so that what was
taken is the tab looked for (`docs/vt-core.md` VC69); `Nothing`, the slots
as they were, when no slot holds it. A tab in another slot is put back as
it was. -}
takeTab : Int -> (taken tabs : Builder (Maybe Tab)) -> { tabs : Builder (Maybe Tab), taken : Maybe { slot : Int, tab : Tab } }
takeTab id tabs =
    takeFrom id 0 tabs


takeFrom : Int -> Int -> (taken tabs : Builder (Maybe Tab)) -> { tabs : Builder (Maybe Tab), taken : Maybe { slot : Int, tab : Tab } }
takeFrom id i tabs =
    if i < 0 || i >= Builder.length tabs then
        { tabs = tabs, taken = Nothing }

    else
        let
            out =
                Builder.swap i Nothing tabs
        in
        when out.old is
            Just (Just t) ->
                if t.info.id == id then
                    { tabs = out.builder, taken = Just { slot = i, tab = t } }

                else
                    takeFrom id (i + 1) (Builder.set i (Just t) out.builder)

            _ ->
                -- an empty slot, a tab closed or shown
                meant Reason.Gone takeFrom id (i + 1) out.builder


{-| The slot a tab not shown is in. -}
slotOf : Int -> Model -> Maybe Int
slotOf id m =
    slotFrom id 0 m


slotFrom : Int -> Int -> Model -> Maybe Int
slotFrom id i m =
    if i >= Builder.length m.tabs then
        Nothing

    else if (Builder.get i m.tabs |> Maybe.andThen identity |> Maybe.map (\t -> t.info.id)) == Just id then
        Just i

    else
        slotFrom id (i + 1) m


{-| What the loop needs of each tab not shown: its id, its backend, and
whether its outbox waits. -}
hiddenOf : Model -> Array { id : Int, remote : Backend, writing : Bool }
hiddenOf m =
    hiddenFrom 0 m []


hiddenFrom : Int -> Model -> Array { id : Int, remote : Backend, writing : Bool } -> Array { id : Int, remote : Backend, writing : Bool }
hiddenFrom i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        hiddenFrom (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { id = t.info.id, remote = t.remote, writing = not (Outbox.isEmpty t.out) } acc

                Nothing ->
                    meant Reason.Gone acc
            )


{-| What the bar needs of each tab not shown. -}
labelsOf : Int -> Model -> Array { id : Int, label : String, bell : Bool, activity : Bool, lost : Bool, color : Maybe Int } -> Array { id : Int, label : String, bell : Bool, activity : Bool, lost : Bool, color : Maybe Int }
labelsOf i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        labelsOf (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { id = t.info.id, label = statusMark (Vt.programStatus t.term |> Maybe.map .state |> Maybe.withDefault (meant Reason.NotSet "")) ++ sendingMark t.sending ++ tabLabel t.info t.term.title, bell = t.info.bell, activity = t.info.activity, lost = sessionLost t.ssh, color = tabColorOf m.config t.info } acc

                Nothing ->
                    meant Reason.Gone acc
            )


remotesOf : Model -> Array Backend
remotesOf m =
    Array.map .remote (hiddenOf m)


{-| The shown tab's session exchanged for `t`'s: the model shows `t`, and
the tab it showed is answered. -}
swapTab : (taken t : Tab) -> (taken m : Model) -> { model : Model, old : Tab }
swapTab t m =
    { old =
        { info = m.tab
        , remote = m.remote
        , term = m.term
        , charset = m.charset
        , decoder = m.decoder
        , replaced = m.replaced
        , out = m.out
        , back = m.back
        , selection = m.selection
        , pasting = m.pasting
        , clips = m.clips
        , clipRead = m.clipRead
        , ssh = m.ssh
        , tmux = m.tmux
        , search = m.search
        , syncSince = m.syncSince
        , upload = m.upload
        , sending = m.sending
        , choosing = m.choosing
        , shellHost = m.shellHost
        }
    , model =
        { m
            | tab = t.info
            , remote = t.remote
            , term = t.term
            , charset = t.charset
            , decoder = t.decoder
            , replaced = t.replaced
            , out = t.out
            , back = t.back
            , selection = t.selection
            , pasting = t.pasting
            , clips = t.clips
            , clipRead = t.clipRead
            , ssh = t.ssh
            , tmux = t.tmux
            , search = t.search
            , syncSince = t.syncSince
            , upload = t.upload
            , sending = t.sending
            , choosing = t.choosing
            , shellHost = t.shellHost
        }
    }


{-| A tab put away by the user: its bells counted as seen, so that only new
ones mark it. -}
putAway : (taken t : Tab) -> Tab
putAway t =
    let
        info =
            t.info
    in
    { t | info = { info | bells = t.term.bells, bell = False, activity = False } }


{-| A tab just shown: its marks gone, and every cell drawn again. -}
afterSwitch : (taken m : Model) -> Model
afterSwitch m =
    let
        info =
            m.tab
    in
    { m
        | tab = { info | bells = m.term.bells, bell = False, activity = False }
        , shadow = View.shadowIn m.term.cols m.term.rows m.windowRows
        , urgent = True
        , menu = Nothing
        -- a note kept for work going on, such as a transfer's progress, is
        -- the tab's that was shown: its mark in the bar says it goes on
        -- (docs/sftp.md FT26)
        , note =
            if Maybe.map .until m.note == Just -1 then
                Nothing

            else
                m.note
    }


{-| The tab with this id shown: it comes out of its slot, and the tab shown
goes into it. -}
showTab : Int -> (taken m : Model) -> Model
showTab id m =
    if id == m.tab.id then
        m

    else
        let
            out =
                takeTab id m.tabs
        in
        when out.taken is
            Just held ->
                let
                    -- its place, set with the tab it is the place of
                    r =
                        swapTab held.tab { m | tabs = out.tabs, shown = max 0 (Array.findIndex (\x -> x == id) m.order) }

                    next =
                        r.model
                in
                afterSwitch { next | tabs = Builder.set held.slot (Just (putAway r.old)) next.tabs }

            Nothing ->
                meant Reason.Gone { m | tabs = out.tabs }


{-| The shown tab moved `by` places along the bar, round past the ends. -}
moveShown : (by : Int where -1 <= by && by <= 1) -> (taken m : Model) -> Model
moveShown by m =
    let
        next =
            TabOrder.moved by m.order m.shown
    in
    { m | order = next.order, shown = next.shown, urgent = True }


{-| The shown tab gone, its program ended or killed: the tab after it shown,
or before it at the end; every tab given the window's rows when the bar
goes. -}
dropShown : (taken m : Model where 2 <= Array.length m.order) -> Task Error Model
dropShown m =
    dropShownFrom Nothing m


{-| `dropShown`, the tab gone kept to open again (TB11), with the directory
its shell was in when that was read. -}
dropShownFrom : Maybe Path.Path -> (taken m : Model where 2 <= Array.length m.order) -> Task Error Model
dropShownFrom dir m =
    let
        -- the tab after it shown, or the one before it at the end
        closing =
            TabOrder.closedShown m.order m.shown

        nextId =
            closing.next

        cols =
            m.term.cols
    in
    let
        out =
            takeTab nextId m.tabs
    in
    when out.taken is
        Just held ->
            let
                -- the closed tab out of the order by its place, and
                -- the next one's place as it is then, in one update
                r =
                    swapTab held.tab { m | tabs = out.tabs, order = closing.order, shown = closing.shown }

                next =
                    r.model
            in
            clock next.clockStart
                |> Task.andThen (\ms -> relayout cols (afterSwitch (keepClosed { tab = r.old, directory = dir, at = ms } next)))

        Nothing ->
            meant Reason.Gone Task.succeed { m | tabs = out.tabs }


{-| Ctrl+Shift+W: the shown tab's program ended, and its tab gone; with one
tab, the window closes. -}
closeShown : (taken m : Model) -> Task Error Model
closeShown m =
    if tabCount m <= 1 then
        Task.succeed { m | closed = True }

    else
        -- where its shell is, read while it runs, to open it there again
        -- (TB11); none for a host's tab
        (if m.tab.hostName == Nothing then
            m.remote.directory |> Task.onError (\_ -> Task.succeed Nothing)

         else
            Task.succeed Nothing
        )
            |> Task.andThen
                (\dir ->
                    -- hung up, not only sent SIGTERM, which a shell ignores
                    -- (review MB1)
                    m.remote.hangUp
                        |> Task.mapError (\why -> { kind = Os.Error.Other, operation = "kill", path = Nothing, detail = why })
                        |> Task.andThen (\_ -> dropShownFrom dir m)
                )


{-| A terminal for a new tab, at a size, as the window's first was made. -}
freshTerm : Config -> Vt.Term -> Int -> Int -> Vt.Term
freshTerm config like cols rows =
    Vt.new
        { cols = cols
        , rows = rows
        , scrollbackBytes = Vt.scrollbackBytesFor { cols = cols, rows = config.scrollbackLines }
        , pageRows = Vt.defaultPageRows
        , checksums = False
        , cellWidth = like.config.cellWidth
        , cellHeight = like.config.cellHeight
        }
        |> Vt.withPalette config.palette
        |> Vt.withEmbedder (embedderOf config)
        |> Vt.withImageLimit imageLimit


{-| The most bytes a terminal's images hold together, 320 MB, as Ghostty's
app and WezTerm keep (`docs/images.md` IM9). It was 0 for 0.1.1, which
was released with images off (IM16). -}
imageLimit : Int
imageLimit =
    320000000


isFree : Maybe Tab -> Bool
isFree slot =
    when slot is
        Nothing ->
            meant Reason.Gone True

        Just _ ->
            False


{-| A free slot for a tab put away, or one more. -}
freeSlot : Model -> Int
freeSlot m =
    freeFrom 0 m


freeFrom : Int -> Model -> Int
freeFrom i m =
    if i >= Builder.length m.tabs then
        Builder.length m.tabs

    else if (Builder.get i m.tabs |> Maybe.map isFree) == Just True then
        i

    else
        freeFrom (i + 1) m


{-| Ctrl+Shift+T: a new tab after the last, shown: the local program, or in
a tab of a session to a host, another session to the same host. A program
that does not start is said on standard error, and nothing changes. -}
openTab : (taken m : Model) -> Task Error Model
openTab m =
    openTabWith { directory = Nothing, name = "", color = HostsColor, kept = Nothing } m


{-| A new tab, shown, as `openTab` opens one, named and colored; a local
one in `directory` when given (a restored tab, TB10), else in the shown
tab's; and a closed tab's screen and scrollback over its new program, when
one is `kept` (TB11). -}
openTabWith : (taken with : { directory : Maybe (Maybe Path.Path), name : String, color : TabColor, kept : Maybe Tab }) -> (taken m : Model) -> Task Error Model
openTabWith with m =
    let
        cols =
            m.term.cols

        rows =
            m.windowRows - 1

        host =
            m.tab.host

        -- its pixels as the shown tab's cells give them (IM21)
        px =
            ptySize cols rows m.term

        -- a local tab starts in the shown one's directory (TB4), or the
        -- program's own when that cannot be read
        here =
            when with.directory is
                Just given ->
                    Task.succeed given

                Nothing ->
                    meant Reason.NotSet m.remote.directory |> Task.onError (\_ -> Task.succeed Nothing)

        starting =
            when host is
                Just h ->
                    m.starter.ssh h

                Nothing ->
                    meant Reason.NotSet
                        here
                            |> Task.mapError Os.Error.toString
                            |> Task.andThen
                                (\dir ->
                                    m.starter.local { columns = cols, rows = rows, widthInPixels = px.widthInPixels, heightInPixels = px.heightInPixels, directory = dir }
                                        -- a directory removed under the shown
                                        -- tab cannot be started in: the
                                        -- program's own, as when it cannot be
                                        -- read (TB4, TB16)
                                        |> Task.onError
                                            (\why ->
                                                if dir == Nothing then
                                                    Task.fail why

                                                else
                                                    m.starter.local { columns = cols, rows = rows, widthInPixels = px.widthInPixels, heightInPixels = px.heightInPixels, directory = Nothing }
                                            )
                                )
                            |> Task.map (\remote -> { remote = remote, problems = [] })
    in
    starting
        |> Task.map Ok
        |> Task.onError (\why -> Task.succeed (Err why))
        |> Task.andThen
            (\started ->
                when started is
                    -- said in the window, which a desktop shows, and on
                    -- standard error for a log (docs/tabs.md TB16)
                    Err why ->
                        meant Reason.Refused Console.writeErr ("puritty: a new tab did not start: " ++ why ++ "\n") |> Task.map (\_ -> { m | startFailed = Just why, urgent = True })

                    Ok begun ->
                        let
                            remote =
                                begun.remote

                            id =
                                m.nextTabId

                            slot =
                                freeSlot m

                            -- ~/.ssh/config's problems, as the first
                            -- window shows them (SC27)
                            tab =
                                withNotices
                                    begun.problems
                                    (when with.kept is
                                        Just k ->
                                            reopened k id remote host m

                                        Nothing ->
                                            meant Reason.NotSet freshTab id remote host with.name with.color cols rows m
                                    )

                            r =
                                swapTab tab { m | nextTabId = id + 1, order = Array.pushLast id m.order, shown = Array.length m.order }

                            next =
                                r.model

                            put =
                                putAway r.old
                        in
                        relayout cols
                            (afterSwitch
                                { next
                                    | tabs =
                                        if slot < Builder.length next.tabs then
                                            Builder.set slot (Just put) next.tabs

                                        else
                                            Builder.pushLast (Just put) next.tabs
                                }
                            )
            )


{-| A new tab's record: its program's backend, a fresh terminal, and the
session's fields as a new tab has them. -}
freshTab : Int -> Backend -> Maybe Config.Host -> String -> TabColor -> Int -> Int -> Model -> Tab
freshTab id remote host name color cols rows m =
    { info = { id = id, name = name, host = host, hostName = m.tab.hostName, color = color, bells = 0, bell = False, activity = False }
    , remote = remote
    , term = freshTerm m.config m.term cols rows
    , charset =
        if host == Nothing then
            m.starter.charset

        else
            m.charset
    , decoder = Charset.decoder
    , replaced = 0
    , out = Outbox.empty
    , back = 0
    , selection = Nothing
    , pasting = Nothing
    , clips = []
    , clipRead = Nothing
    , ssh = Maybe.map (\h -> { host = h.name, command = h.command, lines = [], asking = Nothing, started = False, failed = Nothing, exitStatus = Nothing, tried = [], changes = [] }) host
    , tmux = freshTmux m.config m.term (Maybe.andThen .command host)
    , search = Nothing
    , syncSince = -1
    , upload = Nothing
    , sending = Nothing
    , choosing = Nothing
    , shellHost = Nothing
    }


{-| A closed tab opened again (TB11): its terminal, with its screen and
scrollback, its name and color, over a new program's backend; the rest of
its session as a new tab's. The terminal is brought out of what its old
program left it in (the alternate screen, mouse reports, bracketed paste,
the modes DECSTR resets), and a dim line says where the old session
ended. -}
reopened : (taken k : Tab) -> Int -> Backend -> Maybe Config.Host -> Model -> Tab
reopened k id remote host m =
    let
        info =
            k.info

        bells =
            k.term.bells
    in
    { k
        | info = { info | id = id, bell = False, activity = False, bells = bells }
        , remote = remote
        , term = Vt.feed (Bytes.fromString (reopenedNote (Vt.cursorOf k.term).y k.term.rows)) k.term
        , charset =
            if host == Nothing then
                m.starter.charset

            else
                m.charset
        , decoder = Charset.decoder
        , replaced = 0
        , out = Outbox.empty
        , back = 0
        , selection = Nothing
        , pasting = Nothing
        , clips = []
        , clipRead = Nothing
        , ssh = Maybe.map (\h -> { host = h.name, command = h.command, lines = [], asking = Nothing, started = False, failed = Nothing, exitStatus = Nothing, tried = [], changes = [] }) host
        , tmux = freshTmux m.config m.term (Maybe.andThen .command host)
        , search = Nothing
        , syncSince = -1
        , upload = Nothing
        , sending = Nothing
        , choosing = Nothing
        , shellHost = Nothing
    }


{-| A new tab with problems shown before its program's output. -}
withNotices : Array String -> (taken t : Tab) -> Tab
withNotices problems t =
    if Array.isEmpty problems then
        t

    else
        { t | term = Vt.feed (Bytes.fromString (String.join "" (Array.map notice problems))) t.term }


{-| What a reopened tab's terminal is told: its old program's modes off,
the dim line, and then the whole screen scrolled up into the scrollback, so
that the new program starts on an empty screen and what was there is kept
above it (TB17): a new PowerShell under ConPTY clears the screen it starts
on, which took the old screen with it. -}
reopenedNote : Int -> Int -> String
reopenedNote cursorRow rows =
    "\u{001B}[?1049l\u{001B}[?1000l\u{001B}[?1002l\u{001B}[?1003l\u{001B}[?1006l\u{001B}[?1015l\u{001B}[?1004l\u{001B}[?2004l\u{001B}[!p\u{001B}[0m"
        -- back to the row the cursor was on, which the soft reset left,
        -- so that the line comes after what the old program wrote
        ++ "\u{001B}["
        ++ String.fromInt (cursorRow + 1)
        ++ ";1H"
        ++ "\r\n\u{001B}[2m(closed, and opened again)\u{001B}[0m\r\n"
        ++ "\u{001B}["
        ++ String.fromInt rows
        ++ ";1H"
        ++ String.repeat rows "\n"
        ++ "\u{001B}[H"


-- CLOSED TABS (docs/tabs.md TB11)


{-| How many closed tabs are kept, and for how long. -}
closedSlots : Int
closedSlots =
    5


closedKeepMs : Int
closedKeepMs =
    10 * 60 * 1000


{-| A closed tab kept: in a free slot, else in the oldest's place. -}
keepClosed : (taken c : Closed) -> (taken m : Model) -> Model
keepClosed c m =
    let
        slot =
            closedSlotFor 0 { at = -1, oldest = 0, oldestAt = -1 } m
    in
    if slot < Builder.length m.closedTabs then
        { m | closedTabs = Builder.set slot (Just c) m.closedTabs }

    else
        { m | closedTabs = Builder.pushLast (Just c) m.closedTabs }


{-| The slot a closed tab goes in: the first free one; one past the last
while there are fewer than `closedSlots`; else the oldest. -}
closedSlotFor : Int -> { at : Int, oldest : Int, oldestAt : Int } -> Model -> Int
closedSlotFor i best m =
    if i >= Builder.length m.closedTabs then
        if Builder.length m.closedTabs < closedSlots then
            Builder.length m.closedTabs

        else
            best.oldest

    else
        when Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map .at is
            Nothing ->
                meant Reason.Gone i

            Just at ->
                closedSlotFor (i + 1)
                    (if best.oldestAt < 0 || Clock.since at best.oldestAt > 0 then
                        { best | oldest = i, oldestAt = at }

                     else
                        best
                    )
                    m


{-| The slot of the closed tab closed last, if any. -}
newestClosed : Model -> Maybe Int
newestClosed m =
    newestFrom 0 Nothing -1 m


newestFrom : Int -> Maybe Int -> Int -> Model -> Maybe Int
newestFrom i best bestAt m =
    if i >= Builder.length m.closedTabs then
        best

    else
        when Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map .at is
            Just at ->
                if bestAt < 0 || Clock.since bestAt at > 0 then
                    newestFrom (i + 1) (Just i) at m

                else
                    newestFrom (i + 1) best bestAt m

            Nothing ->
                meant Reason.Gone newestFrom (i + 1) best bestAt m


{-| Whether a closed tab waits to be opened again. -}
closedWaiting : Model -> Bool
closedWaiting m =
    newestClosed m /= Nothing


{-| When the oldest closed tab is let go, -1 for none. -}
closedDue : Model -> Int
closedDue m =
    closedDueFrom 0 -1 m


closedDueFrom : Int -> Int -> Model -> Int
closedDueFrom i due m =
    if i >= Builder.length m.closedTabs then
        due

    else
        closedDueFrom (i + 1)
            (when Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map .at is
                Just at ->
                    Clock.soonest due (Clock.after at closedKeepMs)

                Nothing ->
                    meant Reason.Gone due
            )
            m


{-| The closed tabs kept ten minutes let go, their memory with them. -}
expireClosed : Int -> (taken m : Model) -> Model
expireClosed ms m =
    expireFrom 0 ms m


expireFrom : Int -> Int -> (taken m : Model) -> Model
expireFrom i ms m =
    if i >= Builder.length m.closedTabs then
        m

    else if (Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map (\c -> Clock.reached (Clock.after c.at closedKeepMs) ms)) == Just True then
        expireFrom (i + 1) ms { m | closedTabs = Builder.set i Nothing m.closedTabs }

    else
        expireFrom (i + 1) ms m


{-| Ctrl+Alt+Shift+T, or the menu's Reopen closed tab: the tab closed last
opened again, shown, after the last; a local one in the directory its shell
was in, else in the shown tab's; a host's, a new session to the host. -}
reopenTab : (taken m : Model) -> Task Error Model
reopenTab m =
    when newestClosed m is
        Just slot ->
            let
                out =
                    Builder.swap slot Nothing m.closedTabs
            in
            when out.old |> Maybe.andThen identity is
                Just c ->
                    let
                        name =
                            c.tab.info.name

                        color =
                            c.tab.info.color

                        directory =
                            Maybe.map Just c.directory
                    in
                    -- its bells were rung when it was open: counted as heard,
                    -- so that it does not ring them again (TB17)
                    openTabWith { directory = directory, name = name, color = color, kept = Just c.tab } { m | closedTabs = out.builder, bellsHeard = m.bellsHeard + c.tab.term.bells }

                Nothing ->
                    meant Reason.NoMore (Task.succeed { m | closedTabs = out.builder })

        Nothing ->
            meant Reason.NoMore Task.succeed m


{-| Every tab at `cols` by the window's rows, less the bar's while it shows,
its backend and its tmux told; nothing for a tab already that size. -}
relayout : Int -> (taken m : Model) -> Task Error Model
relayout cols m =
    let
        rows =
            m.windowRows - barRows m

        ids =
            Array.map .id (hiddenOf m)
    in
    Array.foldl
        (\id done -> done |> Task.andThen (\next -> atTab id (resizeShown cols rows) next))
        (resizeShown cols rows m)
        ids
        |> Task.map (\next -> { next | shadow = View.shadowIn next.term.cols next.term.rows next.windowRows, urgent = True })


{-| The shown tab at a size: its terminal, its backend and its tmux. -}
resizeShown : Int -> Int -> (taken m : Model) -> Task Error Model
resizeShown cols rows m =
    if m.term.cols == cols && m.term.rows == rows then
        Task.succeed m

    else
        let
            told =
                TmuxMode.resized { cols = cols, rows = rows } m.tmux
        in
        m.remote.resize (ptySize cols rows m.term)
            |> Task.map (\_ -> sendCommands told.commands { m | term = Vt.resize cols rows m.term, tmux = told.state, urgent = True, back = 0, selection = Nothing })


{-| `work` done on a tab not shown, as if it were (docs/tabs.md TB2): it is
swapped in, worked on with the code every tab's session goes through, and
swapped out again to its slot. -}
atTab : Int -> (Model -> Task Error Model) -> (taken m : Model) -> Task Error Model
atTab id work m =
    let
        out =
            takeTab id m.tabs
    in
    when out.taken is
        Just held ->
            let
                slot =
                    held.slot

                r =
                    swapTab held.tab { m | tabs = out.tabs }

                wasShown =
                    r.old
            in
            work r.model
                |> Task.map
                    (\worked ->
                        let
                            back =
                                swapTab wasShown worked

                            restored =
                                back.model
                        in
                        { restored | tabs = Builder.set slot (Just back.old) restored.tabs }
                    )

        Nothing ->
            meant Reason.Gone Task.succeed { m | tabs = out.tabs }


{-| What a tab not shown read: its terminal fed, and its marks set; its
program's end closes it. -}
behind : Int -> Incoming -> Int -> (taken m : Model) -> Task Error Model
behind id incoming ms m =
    when incoming is
        Data chunk ->
            if Bytes.length chunk == 0 then
                endTab id False m

            else
                atTab id (\one -> feed one.remote chunk ms one |> Task.map (marked ms)) { m | urgent = True }

        Notice told ->
            if endsSession told (sshOfTab id m) then
                endTab id True m

            else
                atTab id (\one -> sshTold told one |> Task.map (marked ms)) { m | urgent = True }


{-| The ssh screen of the tab `id`, not shown. -}
sshOfTab : Int -> Model -> Maybe SshScreen
sshOfTab id m =
    slotOf id m
        |> Maybe.andThen (\slot -> Builder.get slot m.tabs)
        |> Maybe.andThen identity
        |> Maybe.andThen .ssh


{-| A tab that printed while not shown: marked so, and as having rung when
its terminal's bells moved. In the first three seconds of a restored
window, what its tabs print as they start (their prompts) is not marked,
so that the bar does not open with every tab lit (TB10); a bell is. -}
marked : Int -> (taken m : Model) -> Model
marked ms m =
    let
        info =
            m.tab
    in
    { m | tab = { info | activity = info.activity || m.quietUntil < 0 || Clock.passed 3000 m.quietUntil ms, bell = info.bell || m.term.bells /= info.bells, bells = m.term.bells } }


{-| A tab not shown gone: its program killed (`kill`) or ended, and waited
for. -}
endTab : Int -> Bool -> (taken m : Model) -> Task Error Model
endTab id kill m =
    let
        cols =
            m.term.cols

        left =
            TabOrder.removed id m.order m.shown

        out =
            takeTab id m.tabs
    in
    when out.taken is
        Just held ->
            let
                t =
                    held.tab

                rest =
                    { m | tabs = out.tabs, order = left.order, shown = left.shown }
            in
            let
                -- its terminal closed either way, and its program hung
                -- up when it is the tab that goes (review MB1)
                ending =
                    if kill then
                        t.remote.hangUp

                    else
                        t.remote.waitForExit |> Task.andThen (\_ -> t.remote.hangUp)
            in
            ending
                |> Task.mapError (\why -> { kind = Os.Error.Other, operation = "end", path = Nothing, detail = why })
                |> Task.andThen (\_ -> clock rest.clockStart)
                |> Task.andThen (\ms -> relayout cols (keepClosed { tab = t, directory = Nothing, at = ms } rest))

        Nothing ->
            meant Reason.Gone Task.succeed { m | tabs = out.tabs }


-- THE BAR


{-| A tab sending files marked in the bar, shown or not (FT6, FT26). -}
sendingMark : Maybe Sending.Sending -> String
sendingMark sending =
    when sending is
        Just _ ->
            "↑ "

        Nothing ->
            -- a tab sending nothing, most of them
            meant Reason.NotOpen ""


{-| What a tab shows: the name given it, else its host's, else its
program's title, else "shell", with `! ` once it rang. -}
tabLabel : TabInfo -> String -> String
tabLabel info title =
    let
        base =
            if info.name /= "" then
                info.name

            else
                when info.host is
                    Just h ->
                        h.name

                    Nothing ->
                        meant Reason.NotSet
                            if title /= "" then
                                String.takeFirst 24 (shortTitle title)

                            else
                                "shell"
    in
    (if info.bell then
        "! "

     else
        ""
    )
        ++ base


{-| A title that begins with a Windows program's path, as `cmd.exe`'s does
(`C:\WINDOWS\system32\cmd.exe`, and `... - ping -n 30 127.0.0.1` while a
command runs), with the path cut to the program's name: `cmd`, `cmd - ping
-n 30 127.0.0.1`. Any other title as it is. -}
shortTitle : String -> String
shortTitle title =
    let
        parts =
            String.split " - " title

        first =
            Array.getProven 0 parts

        name =
            lastPiece "\\" first
    in
    if String.contains "\\" first && String.endsWith ".exe" (String.toLower first) then
        String.join " - " ([ String.dropLast 4 name ] ++ Array.dropFirst 1 parts)

    else
        title


{-| The bar's tabs in its order, where each is in pixels, and how it is
marked. -}
barTabs : Model -> Array { id : Int, label : String, x : Int, w : Int, active : Bool, bell : Bool, activity : Bool, lost : Bool, color : Maybe Int }
barTabs m =
    let
        cw =
            m.term.config.cellWidth

        size =
            max 8 (m.term.config.cellHeight * 3 // 5)

        hidden =
            labelsOf 0 m []

        -- the shown tab's Program Status mark, read here: the closure
        -- below may only read the model's fields (CL7)
        shownMark =
            statusMark (Vt.programStatus m.term |> Maybe.map .state |> Maybe.withDefault (meant Reason.NotSet ""))

        one id =
            if id == m.tab.id then
                Just { id = id, label = lostMark (sessionLost m.ssh) (shownMark ++ sendingMark m.sending ++ tabLabel m.tab m.term.title), active = True, bell = False, activity = False, lost = sessionLost m.ssh, color = tabColorOf m.config m.tab }

            else
                Array.findFirst (\h -> h.id == id) hidden |> Maybe.map (\f -> { id = id, label = lostMark f.value.lost f.value.label, active = False, bell = f.value.bell, activity = f.value.activity, lost = f.value.lost, color = f.value.color })
    in
    Array.foldl
        (\t acc ->
            let
                w =
                    min 400 (Text.width size t.label) + 2 * cw
            in
            { x = acc.x + w + 2
            , out = Array.pushLast { id = t.id, label = t.label, x = acc.x, w = w, active = t.active, bell = t.bell, activity = t.activity, lost = t.lost, color = t.color } acc.out
            }
        )
        { x = 2, out = [] }
        (Array.mapAndKeepJust one m.order)
        |> .out


{-| The bar's records (docs/tabs.md TB1): the window's last row, each tab as
wide as its name, the shown one in puritty's amber, one that rang red, one
that printed with its name lit. A tab with a color (TB9) is filled with
it, the shown one at full strength with a line along its top, the others
darker, and its marks are a dot at its end: red ringed in white for the
bell, its text's color for output. -}
tabBar : Model -> Bytes
tabBar m =
    if barRows m == 0 then
        Bytes.empty

    else
        let
            ch =
                m.term.config.cellHeight

            cw =
                m.term.config.cellWidth

            y =
                m.term.rows * ch

            width =
                m.term.cols * cw

            size =
                max 8 (ch * 3 // 5)

            -- puritty's look: rounded, the shown tab amber; the plain one
            -- (`[tabs] look`): square, a line between, the shown tab light
            plain =
                m.config.tabsLook == "plain"

            barBg =
                if plain then
                    0x303030

                else
                    0x262626

            shape t fill =
                SettingsGui.box
                    { x = t.x
                    , y =
                        if plain then
                            y

                        else
                            y + 1
                    , w =
                        if plain then
                            t.w + 1

                        else
                            t.w
                    , h =
                        if plain then
                            ch

                        else
                            ch - 2
                    , r =
                        if plain then
                            0

                        else
                            4
                    , color = fill
                    }

            label t color =
                SettingsGui.text
                    { x = t.x + cw
                    , y = y + (ch + size) // 2 - 1
                    , size = size
                    , color = color
                    , text = t.label
                    }

            plainTab t =
                Bytes.flatten
                    [ shape t
                        (if t.active then
                            if plain then
                                0xD0D0D0

                            else
                                0xFFAF00

                         else if t.bell then
                            0xD70000

                         else if plain then
                            0x444444

                         else
                            0x3A3A3A
                        )
                    , label t
                        (if t.active && t.lost then
                            0x8B0000

                         else if t.active then
                            0x1C1C1C

                         else if t.lost then
                            0xFF6B6B

                         else if t.bell || t.activity then
                            0xFFFFFF

                         else
                            0xBCBCBC
                        )
                    ]

            coloredTab t c =
                let
                    fill =
                        if t.active then
                            c

                        else
                            mix c barBg

                    ink =
                        Dialog.contrast fill

                    dot =
                        max 5 (ch // 3)

                    dotX =
                        t.x + t.w - cw // 2 - dot // 2

                    dotY =
                        y + (ch - dot) // 2
                in
                Bytes.flatten
                    [ shape t fill
                    , if t.active then
                        SettingsGui.box
                            { x =
                                t.x
                                    + (if plain then
                                        0

                                       else
                                        3
                                      )
                            , y =
                                if plain then
                                    y

                                else
                                    y + 1
                            , w =
                                t.w
                                    - (if plain then
                                        0

                                       else
                                        6
                                      )
                            , h = max 2 (ch // 8)
                            , r = 0
                            , color = ink
                            }

                      else
                        Bytes.empty
                    , label t ink
                    , if t.active then
                        Bytes.empty

                      else if t.bell then
                        SettingsGui.framed { x = dotX, y = dotY, w = dot, h = dot, r = dot // 2, color = 0xD70000, border = 0xFFFFFF }

                      else if t.activity then
                        SettingsGui.box { x = dotX, y = dotY, w = dot, h = dot, r = dot // 2, color = ink }

                      else
                        Bytes.empty
                    ]
        in
        Bytes.flatten
            ([ SettingsGui.box { x = 0, y = y, w = width, h = ch, r = 0, color = barBg } ]
                ++ Array.map
                    (\t ->
                        when t.color is
                            Just c ->
                                coloredTab t c

                            Nothing ->
                                meant Reason.NotSet plainTab t
                    )
                    (barTabs m)
            )


{-| A tab's color dimmed toward the bar's, for a tab not shown: three
fifths the color. -}
mix : Int -> Int -> Int
mix color toward =
    let
        channel at =
            (3 * Bitwise.and 0xFF (Bitwise.shiftRightZfBy at color) + 2 * Bitwise.and 0xFF (Bitwise.shiftRightZfBy at toward)) // 5
    in
    Bitwise.or (Bitwise.shiftLeftBy 16 (channel 16)) (Bitwise.or (Bitwise.shiftLeftBy 8 (channel 8)) (channel 0))


{-| A press on the bar: the tab under it shown, or with the middle button
closed; a second press on the same tab within half a second renames it. -}
barPress : Int -> Window.PointerEvent -> (taken m : Model) -> Task Error Model
barPress ms p m =
    when Array.findFirst (\t -> p.x >= t.x && p.x < t.x + t.w) (barTabs m) is
        Just hit ->
            if p.button == 3 && m.config.tabsMiddleCloses then
                -- shown first, so that a question is asked over its screen
                askClose (showTab hit.value.id m)

            else if p.button == 1 && hit.value.id == m.barClick.id && Clock.since m.barClick.at ms <= 500 then
                let
                    shown =
                        showTab hit.value.id m
                in
                Task.succeed (startRenaming { shown | barClick = { at = -1000, id = -1 } })

            else if p.button == 1 then
                let
                    shown =
                        showTab hit.value.id m
                in
                Task.succeed { shown | barClick = { at = ms, id = hit.value.id } }

            else if p.button == 2 then
                -- the right button: the menu, over the tab it was on, so
                -- that its tab items are that tab's (TB9)
                openMenu p (showTab hit.value.id m)

            else
                Task.succeed (showTab hit.value.id m)

        Nothing ->
            meant Reason.OutOfRange Task.succeed m


{-| The rename box opened over the shown tab. -}
startRenaming : (taken m : Model) -> Model
startRenaming m =
    { m | renaming = Just { id = m.tab.id, typed = m.tab.name }, urgent = True }


-- THE TAB'S COLOR (docs/tabs.md TB9)


{-| The colors the box offers, keys 1 to 8. -}
tabColors : Array Int
tabColors =
    [ 0xC62828, 0xE65100, 0xF9A825, 0x2E7D32, 0x00838F, 0x1565C0, 0x6A1B9A, 0xAD1457 ]


{-| The color a tab is drawn in, if any: the one chosen for it, else its
host's from the settings in force, so that a host's color changed in the
settings window colors its tabs at once. -}
tabColorOf : Config -> TabInfo -> Maybe Int
tabColorOf config info =
    when info.color is
        Picked c ->
            Just c

        NoColor ->
            Nothing

        HostsColor ->
            info.hostName
                |> Maybe.andThen (\name -> Array.findFirst (\h -> h.name == name) config.hosts)
                |> Maybe.andThen (\entry -> entry.value.tab)


{-| The color box opened over the shown tab. -}
startColoring : (taken m : Model) -> Model
startColoring m =
    { m | coloring = Just m.tab.id, urgent = True }


{-| What each swatch of the box chooses: the eight colors, none, and the
host's own for a tab that has a host. -}
colorChoices : Model -> Array TabColor
colorChoices m =
    Array.map Picked tabColors
        ++ [ NoColor ]
        ++ (if m.tab.hostName /= Nothing then
                [ HostsColor ]

            else
                []
           )


{-| The color box (docs/tabs.md TB9): the colors as swatches, the one in
use framed. It is opened over the shown tab, and is for it. -}
colorBox : Model -> Dialog.Dialog
colorBox m =
    let
        info =
            m.tab

        hostOwn =
            tabColorOf m.config { info | color = HostsColor }

        swatch choice =
            when choice is
                Picked c ->
                    { color = c, label = String.fromInt (1 + (Array.findFirst (\x -> x == c) tabColors |> Maybe.map .index |> Maybe.withDefault (meant Reason.NotKnown 0))), marked = info.color == choice }

                NoColor ->
                    { color = 0x3A3A3A, label = "0", marked = info.color == NoColor || (info.color == HostsColor && hostOwn == Nothing) }

                HostsColor ->
                    { color = Maybe.withDefault (meant Reason.NotSet 0x3A3A3A) hostOwn, label = "H", marked = info.color == HostsColor && hostOwn /= Nothing }
    in
    { title = "The tab's color"
    , lines =
        when info.hostName is
            Just name ->
                [ "H gives it the color of " ++ name ++ "'s tabs in the settings." ]

            Nothing ->
                meant Reason.NotSet [ "A color for this tab in the bar." ]
    , field = Nothing
    , swatches = Array.map swatch (colorChoices m)
    , check = Nothing
    , buttons = []
    , hint =
        if info.hostName /= Nothing then
            "1–8: a color    0: none    H: the host's    Esc: cancel"

        else
            "1–8: a color    0: none    Esc: cancel"
    }


{-| A key in the color box: a swatch's key chooses it, any other closes
the box. -}
colorKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Int -> (taken m : Model) -> Task Error Model
colorKey k id m =
    let
        typed =
            String.toLower (Bytes.toStringLossy k.text)

        choices =
            colorChoices m

        chosen =
            if Bitwise.and k.mods 2 /= 0 then
                Nothing

            else if typed == "0" then
                Just NoColor

            else if typed == "h" && m.tab.hostName /= Nothing then
                Just HostsColor

            else
                String.toInt typed
                    |> Maybe.andThen
                        (\n ->
                            if n >= 1 && n <= 8 then
                                Array.get (n - 1) choices

                            else
                                Nothing
                        )
    in
    when chosen is
        Just choice ->
            colorTab choice id m

        Nothing ->
            -- a modifier alone, as Shift for an H, leaves the box up
            meant Reason.NotKnown
                if String.isEmpty typed && k.sym /= 0xFF1B && k.sym /= 0xFF0D && k.sym /= 0xFF8D then
                    Task.succeed m

                else
                    Task.succeed { m | coloring = Nothing, urgent = True }


{-| A press while the color box is up: on a swatch, its color; anywhere
else the box closes. -}
colorPress : Window.PointerEvent -> Int -> (taken m : Model) -> Task Error Model
colorPress p id m =
    let
        box =
            colorBox m

        hit =
            if p.button == 1 then
                Dialog.swatchAt (overlaySize m) box { x = p.x, y = p.y } |> Maybe.andThen (\i -> Array.get i (colorChoices m))

            else
                Nothing
    in
    when hit is
        Just choice ->
            colorTab choice id m

        Nothing ->
            meant Reason.OutOfRange Task.succeed { m | coloring = Nothing, urgent = True }


{-| The tab the box is for given a color, and the box closed. -}
colorTab : TabColor -> Int -> (taken m : Model) -> Task Error Model
colorTab choice id m =
    if id == m.tab.id then
        let
            info =
                m.tab
        in
        Task.succeed { m | tab = { info | color = choice }, coloring = Nothing, urgent = True }

    else
        atTab id
            (\x ->
                let
                    info =
                        x.tab
                in
                Task.succeed { x | tab = { info | color = choice } }
            )
            { m | coloring = Nothing, urgent = True }


{-| The rename box (docs/tabs.md TB1 item 4): the name typed so far. -}
renameBox : { id : Int, typed : String } -> Dialog.Dialog
renameBox r =
    { title = "Rename the tab"
    , lines = [ "An empty name gives the program's own title back." ]
    , field = Just { typed = r.typed, hidden = False, caret = String.count r.typed }
    , swatches = []
    , check = Nothing
    , buttons = []
    , hint = "Enter: rename    Esc: cancel"
    }


{-| A key in the rename box: Enter names the tab, Esc leaves it, Backspace
takes a letter back, and text is typed in. -}
renameKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> { id : Int, typed : String } -> (taken m : Model) -> Task Error Model
renameKey k r m =
    if k.sym == 0xFF1B then
        Task.succeed { m | renaming = Nothing, urgent = True }

    else if k.sym == 0xFF0D || k.sym == 0xFF8D then
        nameTab r.id (String.trim r.typed) { m | renaming = Nothing, urgent = True }

    else if k.sym == 0xFF08 then
        Task.succeed { m | renaming = Just { r | typed = String.dropLast 1 r.typed }, urgent = True }

    else if Bitwise.and k.mods 2 == 0 then
        Task.succeed (renameTyped (Bytes.toStringLossy k.text) r m)

    else
        Task.succeed m


{-| Text typed or committed by the IME into the rename box; control
characters dropped, and the name kept to 40 characters. -}
renameTyped : String -> { id : Int, typed : String } -> (taken m : Model) -> Model
renameTyped text r m =
    let
        clean =
            String.fromArray (Array.keepIf (\c -> Char.toCode c >= 32 && Char.toCode c /= 127) (String.toArray text))
    in
    { m | renaming = Just { r | typed = String.takeFirst 40 (r.typed ++ clean) }, urgent = True }


{-| The tab `id` given the user's name; an empty one gives the program's
title back. -}
nameTab : Int -> String -> (taken m : Model) -> Task Error Model
nameTab id name m =
    if id == m.tab.id then
        let
            info =
                m.tab
        in
        Task.succeed { m | tab = { info | name = name } }

    else
        atTab id
            (\x ->
                let
                    info =
                        x.tab
                in
                Task.succeed { x | tab = { info | name = name } }
            )
            m


{-| Closing the shown tab, asked first when it matters (docs/tabs.md TB4):
its ssh session open, or a program running in front of its shell. An idle
shell closes at once, and so does every tab with `[tabs]
ask_before_closing` off. When puritty cannot tell, it asks, saying why. -}
askClose : (taken m : Model) -> Task Error Model
askClose m =
    let
        open =
            when m.ssh is
                Just screen ->
                    if screen.started && screen.exitStatus == Nothing && screen.failed == Nothing then
                        Just screen.host

                    else
                        Nothing

                Nothing ->
                    meant Reason.NotSet Nothing

        busy =
            m.remote.busy

        id =
            m.tab.id
    in
    if not m.config.tabsAskBeforeClosing then
        closeShown m

    else
        when open is
            Just host ->
                Task.succeed { m | closing = Just { id = id, why = "Its ssh session to " ++ cleanText host ++ " is open.", window = False }, urgent = True }

            Nothing ->
                meant Reason.NotOpen
                    busy
                        |> Task.map Ok
                        |> Task.onError (\e -> Task.succeed (Err e))
                        |> Task.andThen
                            (\got ->
                                when got is
                                    Ok Nothing ->
                                        closeShown m

                                    Ok (Just name) ->
                                        Task.succeed
                                            { m
                                                | closing =
                                                    Just
                                                        { id = id
                                                        , why =
                                                            (if name == "" then
                                                                "A program"

                                                             else
                                                                cleanText name
                                                            )
                                                                ++ " is running in it."
                                                        , window = False
                                                        }
                                                , urgent = True
                                            }

                                    Err e ->
                                        meant Reason.NoMore
                                            Task.succeed
                                                { m
                                                    | closing = Just { id = id, why = "puritty could not tell whether a program runs in it: " ++ Os.Error.toString e, window = False }
                                                    , urgent = True
                                                }
                            )


{-| Why a new tab did not start (docs/tabs.md TB16), in a box over the shown tab,
since standard error is not seen from a desktop. -}
startFailedBox : String -> Dialog.Dialog
startFailedBox why =
    { title = "The new tab did not start"
    , lines = wordLines 60 why
    , field = Nothing
    , swatches = []
    , check = Nothing
    , buttons = [ { label = "OK", primary = True } ]
    , hint = "Enter or Esc: close this"
    }


{-| A text in lines of at most `width` characters, broken at spaces; a
longer word has a line of its own. -}
wordLines : Int -> String -> Array String
wordLines width text =
    let
        put word acc =
            if acc.line == "" then
                { acc | line = word }

            else if String.count acc.line + 1 + String.count word <= width then
                { acc | line = acc.line ++ " " ++ word }

            else
                { lines = Array.pushLast acc.line acc.lines, line = word }

        done =
            Array.foldl put { lines = [], line = "" } (String.words text)
    in
    if done.line == "" then
        done.lines

    else
        Array.pushLast done.line done.lines


{-| A key while the box is up: Enter, Esc or Space closes it; any other
key is ignored, so nothing typed reaches the terminal under it. -}
startFailedKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
startFailedKey k m =
    if k.sym == 0xFF0D || k.sym == 0xFF8D || k.sym == 0xFF1B || k.sym == 0x20 then
        Task.succeed { m | startFailed = Nothing, urgent = True }

    else
        Task.succeed m


{-| A press while the box is up: on OK, it closes; anywhere else, nothing. -}
startFailedPress : Window.PointerEvent -> (taken m : Model) -> Task Error Model
startFailedPress p m =
    let
        onOk =
            p.button == 1 && (Maybe.andThen (\why -> Dialog.buttonAt (overlaySize m) (startFailedBox why) { x = p.x, y = p.y }) m.startFailed /= Nothing)
    in
    if onOk then
        Task.succeed { m | startFailed = Nothing, urgent = True }

    else
        Task.succeed m


{-| Whether the ssh question up offers to remember its answer. -}
rememberOffered : Model -> Bool
rememberOffered m =
    when m.ssh |> Maybe.andThen .asking is
        Just asking ->
            asking.offer

        Nothing ->
            meant Reason.NotOpen False


{-| A press while the ssh question offers to remember (PW10): on the
checkbox or its label, ticked or not, and the keys to it; anywhere else,
the keys back to the field. -}
rememberPress : Window.PointerEvent -> (taken m : Model) -> Model
rememberPress p m =
    when m.ssh is
        Just screen ->
            when screen.asking is
                Just asking ->
                    let
                        onIt =
                            dialogOf screen
                                |> Maybe.map (\d -> Dialog.checkAt (overlaySize m) d { x = p.x, y = p.y })
                                |> Maybe.withDefault (meant Reason.NotOpen False)
                    in
                    if onIt then
                        { m | ssh = Just { screen | asking = Just { asking | remember = not asking.remember, onCheck = True } }, urgent = True }

                    else
                        { m | ssh = Just { screen | asking = Just { asking | onCheck = False } }, urgent = True }

                Nothing ->
                    meant Reason.NotOpen m

        Nothing ->
            meant Reason.NotSet m


{-| The question before closing a busy tab. -}
closeBox : { id : Int, why : String, window : Bool } -> Dialog.Dialog
closeBox c =
    if c.window then
        { title = "Close the window?"
        , lines =
            String.split "\n" c.why
                ++ [ if String.contains "\n" c.why then
                        "Closing the window ends them."

                     else
                        "Closing the window ends it."
                   ]
        , field = Nothing
        , swatches = []
        , check = Nothing
        , buttons = closeButtons
        , hint = "Enter, or close it again: close it    Esc: keep it"
        }

    else
        { title = "Close this tab?"
        , lines = [ c.why, "Closing the tab ends it." ]
        , field = Nothing
        , swatches = []
        , check = Nothing
        , buttons = closeButtons
        , hint = "Enter: close it    Esc: keep it"
        }


{-| The close question's buttons, for a hand on the mouse (TB12): Close,
as Enter, then Keep it, as Escape. -}
closeButtons : Array Dialog.Button
closeButtons =
    [ { label = "Close", primary = True }, { label = "Keep it", primary = False } ]


{-| A press while the close question is up: on Close, the tab or window
closed; on Keep it, the question gone; anywhere else, nothing, so that a
click cannot reach the terminal under the question. -}
closePress : Window.PointerEvent -> { id : Int, why : String, window : Bool } -> (taken m : Model) -> Task Error Model
closePress p c m =
    let
        hit =
            if p.button == 1 then
                Dialog.buttonAt (overlaySize m) (closeBox c) { x = p.x, y = p.y }

            else
                Nothing
    in
    when hit is
        Just 0 ->
            closeAnswer True c m

        Just _ ->
            closeAnswer False c m

        Nothing ->
            meant Reason.OutOfRange Task.succeed m


{-| The question when control mode starts and the tab did not start
`tmux -CC` (docs/tmux.md TM108): the bytes may be any program's, and
what follows is taken as tmux's. -}
entryBox : Dialog.Dialog
entryBox =
    { title = "Start tmux control mode?"
    , lines =
        [ "Output in this tab started tmux control mode (tmux -CC), but this tab did not start tmux."
        , "Start it only if you ran tmux -CC: what comes next is taken as tmux's."
        ]
    , field = Nothing
    , swatches = []
    , check = Nothing
    , buttons = [ { label = "Start", primary = True }, { label = "Show as text", primary = False } ]
    , hint = "Enter: start it    Esc: show the output as text"
    }


{-| A key while the entry question is up: Enter or Y starts control mode,
Esc or N shows the bytes as the terminal's; any other key is held back. -}
entryKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Int -> (taken m : Model) -> Task Error Model
entryKey k ms m =
    if k.sym == 0xFF0D || k.sym == 0xFF8D || k.sym == 0x79 || k.sym == 0x59 then
        entryAnswer True ms m

    else if k.sym == 0xFF1B || k.sym == 0x6E || k.sym == 0x4E then
        entryAnswer False ms m

    else
        Task.succeed m


{-| A press while the entry question is up: its buttons answer it. -}
entryPress : Window.PointerEvent -> Int -> (taken m : Model) -> Task Error Model
entryPress p ms m =
    let
        hit =
            if p.button == 1 then
                Dialog.buttonAt (overlaySize m) entryBox { x = p.x, y = p.y }

            else
                Nothing
    in
    when hit is
        Just 0 ->
            entryAnswer True ms m

        Just _ ->
            entryAnswer False ms m

        Nothing ->
            -- a press off the buttons, or not the first button
            meant Reason.OutOfRange Task.succeed m


entryAnswer : Bool -> Int -> (taken m : Model) -> Task Error Model
entryAnswer yes ms m0 =
    let
        m =
            logLine "tmux"
                ("control mode's start answered: "
                    ++ (if yes then
                            "start"

                        else
                            "text"
                       )
                )
                m0
    in
    feedRead m.remote (EntryAnswer yes) ms { m | urgent = True }


{-| The close question answered: yes closes the window, or the tab asked
about if it is still the one shown; no keeps them. -}
closeAnswer : Bool -> { id : Int, why : String, window : Bool } -> (taken m : Model) -> Task Error Model
closeAnswer yes c m0 =
    let
        -- the answer in the log, which says when the question went
        -- (docs/tabs.md TB18)
        m =
            logLine "close"
                ("question answered: "
                    ++ (if yes then
                            "close"

                        else
                            "stay"
                       )
                )
                m0
    in
    if yes && c.window then
        Task.succeed { m | closing = Nothing, closed = True, byButton = True }

    else if yes then
        if c.id == m.tab.id then
            closeShown { m | closing = Nothing, urgent = True }

        else
            Task.succeed { m | closing = Nothing, urgent = True }

    else
        Task.succeed { m | closing = Nothing, urgent = True }


{-| A key while the question is up: Enter or Y closes the tab asked about,
if it is still the one shown; Esc or N keeps it; any other key is
ignored. -}
closeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> { id : Int, why : String, window : Bool } -> (taken m : Model) -> Task Error Model
closeKey k c m =
    if k.sym == 0xFF0D || k.sym == 0xFF8D || k.sym == 0x79 || k.sym == 0x59 then
        closeAnswer True c m

    else if k.sym == 0xFF1B || k.sym == 0x6E || k.sym == 0x4E then
        closeAnswer False c m

    else
        Task.succeed m


{-| The window's close button, or the system closing it (docs/tabs.md
TB7): asked first when any tab, shown or not, is busy, as closing one tab
is (TB4), naming each busy tab and what runs in it; at once otherwise, and
with `[tabs] ask_before_closing` off. -}
askCloseWindow : (taken m : Model) -> Task Error Model
askCloseWindow m =
    if not m.config.tabsAskBeforeClosing then
        Task.succeed { m | closed = True, byButton = True }

    else if Maybe.map .window m.closing == Just True then
        -- the close button again while its question is up: the answer is
        -- yes (TB18)
        Task.succeed (logLine "close" "asked again while the question was up: closed" { m | closing = Nothing, closed = True, byButton = True })

    else
        let
            shown =
                { label = tabLabel m.tab m.term.title, ssh = m.ssh, remote = m.remote }

            all =
                [ shown ] ++ busyCandidates 0 m []
        in
        Array.foldl
            (\t acc -> acc |> Task.andThen (\soFar -> busyWhy t |> Task.map (\why -> soFar ++ Array.mapAndKeepJust identity [ Maybe.map (\w -> cleanText t.label ++ ": " ++ w) why ])))
            (Task.succeed [])
            all
            |> Task.map
                (\busy ->
                    if Array.isEmpty busy then
                        { m | closed = True, byButton = True }

                    else
                        let
                            shownLines =
                                Array.takeFirst 6 busy
                                    ++ (if Array.length busy > 6 then
                                            [ "and " ++ String.fromInt (Array.length busy - 6) ++ " more" ]

                                        else
                                            []
                                       )
                        in
                        logLine "close"
                            ("question shown: " ++ String.join "; " shownLines)
                            { m | closing = Just { id = -1, why = String.join "\n" shownLines, window = True }, urgent = True }
                )


{-| What each tab not shown needs for the window's question. -}
busyCandidates : Int -> Model -> Array { label : String, ssh : Maybe SshScreen, remote : Backend } -> Array { label : String, ssh : Maybe SshScreen, remote : Backend }
busyCandidates i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        busyCandidates (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { label = tabLabel t.info t.term.title, ssh = t.ssh, remote = t.remote } acc

                Nothing ->
                    meant Reason.Gone acc
            )


{-| Why closing a tab would end something, or `Nothing` for an idle shell:
an open ssh session, a program in front of the shell, or that puritty
could not tell. -}
busyWhy : { label : String, ssh : Maybe SshScreen, remote : Backend } -> Task x (Maybe String)
busyWhy t =
    when t.ssh is
        Just screen ->
            if screen.started && screen.exitStatus == Nothing && screen.failed == Nothing then
                Task.succeed (Just ("the ssh session to " ++ cleanText screen.host ++ " is open"))

            else
                Task.succeed Nothing

        Nothing ->
            meant Reason.NotSet
                t.remote.busy
                    |> Task.map
                        (Maybe.map
                            (\name ->
                                (if name == "" then
                                    "a program"

                                 else
                                    cleanText name
                                )
                                    ++ " is running"
                            )
                        )
                    |> Task.onError (\e -> Task.succeed (Just ("puritty could not tell what runs: " ++ Os.Error.toString e)))


{-| Whether a tab's ssh session failed or dropped: its tab stays, with the
screen that says why and offers to reconnect, and the bar marks it (TB8,
the survey's must-do 4). -}
sessionLost : Maybe SshScreen -> Bool
sessionLost ssh =
    when ssh is
        Just screen ->
            screen.failed /= Nothing

        Nothing ->
            meant Reason.NotSet False


{-| A lost session's tab label, with `×` before it. -}
lostMark : Bool -> String -> String
lostMark lost label =
    if lost then
        "× " ++ label

    else
        label


-- THE FOLDER PICKER'S WORKING MODEL (docs/sftp.md FT32)


{-| The pretend host's names are UTF-8. -}
demoWith : Picker.With
demoWith =
    { decode = Bytes.toStringLossy, encode = \s -> Just (Bytes.fromString s) }


demoOpen : Array Bytes -> Picker.Places -> Picking
demoOpen files places =
    let
        opened =
            Picker.open { host = PickerDemo.host, files = files, at = Maybe.withDefault (meant Reason.NotSet (Bytes.fromString "/")) places.shell, places = places }
    in
    { picker = opened.picker, demo = PickerDemo.start, queued = opened.requests, count = Array.length files }


{-| What a key or the pointer came to: the picker kept, its requests
queued for the pretend host; or closed, saying what would have been sent. -}
pickerStep : Picker.Step -> Picking -> (taken m : Model) -> Task Error Model
pickerStep s pk m =
    let
        next =
            { pk | picker = s.picker, queued = pk.queued ++ s.requests }

        places =
            m.pickerPlaces

        placesKept =
            { places | bookmarks = Picker.bookmarks s.picker }

        files =
            if pk.count == 1 then
                "1 file"

            else
                String.fromInt pk.count ++ " files"
    in
    when s.outcome is
        Picker.Stay ->
            Task.succeed { m | picking = Just next, urgent = True }

        Picker.Send folder ->
            Task.succeed
                (noteUp
                    { text = "Would send " ++ files ++ " to " ++ PickerDemo.host ++ ":" ++ Bytes.toStringLossy folder ++ " (the working model)"
                    , failed = False
                    , kept = False
                    }
                    { m
                        | picking = Nothing
                        , urgent = True
                        , pickerPlaces = { placesKept | recent = Array.takeFirst 5 (Array.pushFirst folder (Array.keepIf (\r -> r /= folder) placesKept.recent)) }
                    }
                )

        Picker.Cancelled ->
            Task.succeed
                (noteUp
                    { text = "Cancelled: nothing would be sent (the working model)"
                    , failed = False
                    , kept = False
                    }
                    { m | picking = Nothing, urgent = True, pickerPlaces = placesKept }
                )


{-| When the pretend host next answers: at once while requests wait to be
given to it. -}
pickerDue : Model -> Int
pickerDue m =
    when m.picking is
        Just pk ->
            if Array.isEmpty pk.queued then
                PickerDemo.due pk.demo

            else
                m.last

        Nothing ->
            meant Reason.NotOpen -1


{-| The requests given to the pretend host, and its answers due by `ms`
given to the picker. -}
pickerTick : Int -> (taken m : Model) -> Model
pickerTick ms m =
    when m.picking is
        Just pk ->
            let
                asked =
                    Array.foldl (\r d -> PickerDemo.request ms r d) pk.demo pk.queued

                got =
                    PickerDemo.take ms asked

                applied =
                    Array.foldl pickerAnswer { picker = pk.picker, queued = [] } got.answers
            in
            { m
                | picking = Just { pk | demo = got.demo, picker = applied.picker, queued = applied.queued }
                , urgent = m.urgent || not (Array.isEmpty got.answers)
            }

        Nothing ->
            meant Reason.NotOpen m


pickerAnswer : Picker.Answer -> { picker : Picker.Picker, queued : Array Picker.Request } -> { picker : Picker.Picker, queued : Array Picker.Request }
pickerAnswer a acc =
    let
        s =
            Picker.answer a acc.picker
    in
    { picker = s.picker, queued = acc.queued ++ s.requests }


{-| A drag over the window while a picker is up: the working model's or
the folder picker's. -}
pickerDragOver : { x : Int, y : Int } -> (taken m : Model) -> Model
pickerDragOver at m =
    when m.picking is
        Just pk ->
            { m | picking = Just { pk | picker = Picker.dragOver at pk.picker }, urgent = True }

        Nothing ->
            meant Reason.NotOpen { m | choosing = Maybe.map (\c -> { c | picker = Picker.dragOver at c.picker }) m.choosing, urgent = True }


{-| A drag gone from the window, or ended elsewhere. -}
pickerDragLeft : (taken m : Model) -> Model
pickerDragLeft m =
    when m.picking is
        Just pk ->
            { m | picking = Just { pk | picker = Picker.dragLeft pk.picker }, urgent = True }

        Nothing ->
            meant Reason.NotOpen { m | choosing = Maybe.map (\c -> { c | picker = Picker.dragLeft c.picker }) m.choosing, urgent = True }


{-| Files dropped while the working model runs: on the picker, sent (in
the note) to the folder under them; else the picker opened for them. -}
pickerDropped : Bytes -> (taken m : Model) -> Model
pickerDropped bytes m =
    let
        dropped =
            (Drop.paths bytes).paths
    in
    when m.picking is
        Just pk ->
            let
                folder =
                    Picker.dropTarget (overlaySize m) demoWith (Picker.dragPoint pk.picker) pk.picker

                names =
                    if Array.length dropped == 1 then
                        "1 dropped file"

                    else
                        String.fromInt (Array.length dropped) ++ " dropped files"

                placesNow =
                    m.pickerPlaces
            in
            noteUp
                { text =
                    when folder is
                        Just f ->
                            "Would send " ++ names ++ " to " ++ PickerDemo.host ++ ":" ++ Bytes.toStringLossy f ++ " (the working model)"

                        Nothing ->
                            meant Reason.NotYet ("No folder listed yet: " ++ names ++ " would not be sent (the working model)")
                , failed = False
                , kept = False
                }
                { m | picking = Nothing, urgent = True, pickerPlaces = { placesNow | bookmarks = Picker.bookmarks pk.picker } }

        Nothing ->
            meant Reason.NotOpen
                (if Array.isEmpty dropped then
                    m

                 else
                    { m | picking = Just (demoOpen dropped m.pickerPlaces), urgent = True }
                )
