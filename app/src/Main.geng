module Main exposing (main)

{-| visiterm (`docs/renderer.md` §R10, §R12): a program on a terminal,
drawn in an X window.

    visiterm [--config FILE] [--title TITLE] [PROGRAM ARGS...]

`--` before PROGRAM keeps its own flags from being taken for visiterm's.
The command line is `gren-argparse` with its `os` runner; what it gives
wins over the settings file.

It reads its settings (`Config`), opens the window (`packages/x11`), and
starts the program the settings name, or `$SHELL`, on a terminal of the
window's size. Then each turn races the terminal's read, the window's
events and a timer (V23), and draws a frame with `Vt.View` when one is
due:

  - output is drawn at most every `frames.every_ms` (16 ms); a read that
    comes after a key is drawn at once (V31), and so is a resize;
  - while the program holds synchronized output (mode 2026), its output is
    not drawn, for at most `frames.sync_timeout_ms` from the first read it
    held back;
  - a blinking cursor (mode 12) blinks every `cursor.blink_ms` while the
    window has the focus, and shows at once again after a key.

A resize of the window is given to the core and to the terminal; the
focus is drawn in the cursor and, under mode 1004, reported to the
program; the program's title (OSC 0 and 2) is the window's. visiterm ends
when the program does, with its exit status (1 for one a signal ended),
or when the window is closed, asking the program to end.

-}

import Argparse.Parser
import Argparse.PrettyPrinter as PP
import Argparse.Program
import Bitwise
import Bytes exposing (Bytes)
import Config exposing (Config)
import Console
import Dict exposing (Dict)
import Int64
import Keys
import Os.Env
import Os.Error exposing (Error)
import Os.File as File
import Os.Path as Path
import Os.Process as Process exposing (Connection(..))
import Process as Sleep
import Task exposing (Task)
import Time
import Vt
import Vt.Charset as Charset exposing (Charset)
import Vt.Mouse as Mouse
import Vt.View as View
import X11


type alias Model =
    { config : Config
    , look : View.Look
    , term : Vt.Term
    , shadow : View.Shadow
    , focus : View.Focus
    , last : Int
    , pending : Int
    , urgent : Bool
    , blinkAt : Int
    , syncSince : Int
    , title : String
    , closed : Bool
    , lost : Bool
    , out : Bytes
    , preedit : { points : Array Int, feedback : Array Int, caret : Int }
    , imeLog : Bool
    , points : Int
    , charset : Charset
    , decoder : Charset.Decoder
    , replaced : Int
      -- the mouse (docs/phase3-select.md §4): the buttons held, as bits of
      -- Ghostty's numbers; the cell last reported, so a motion within it is
      -- not reported again; whether X sends every motion
    , held : Int
    , mouseLast : Maybe Mouse.Cell
    , allMotion : Bool
      -- how many rows the view is scrolled back, 0 at the bottom
      -- (docs/phase3-select.md §11)
    , back : Int
    }


type Turn
    = Read Bytes
    | Events Bool
    | Due
    | Writable


now : Task x Int
now =
    Time.monotonic |> Task.map (\t -> Int64.toInt (Time.inMilliseconds t))


type Command
    = Run { config : Maybe Path.Path, title : Maybe String, program : Array String }


cli : Argparse.Parser.Command (Array String) { config : Maybe Path.Path, title : Maybe String } Command
cli =
    { word = ""
    , arguments =
        Argparse.Parser.zeroOrMoreArgs
            { value = { label = "program", fn = Just, examples = [ "htop", "vim notes.txt" ] }
            , help = "The program to run, and its arguments; $SHELL when none is given"
            }
    , flags =
        Argparse.Parser.initFlags (\config title -> { config = config, title = title })
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "config") (Argparse.Parser.pathParser Path.fromString) "The settings file, instead of ~/.config/visiterm/config.toml"
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "title") Argparse.Parser.stringParser "The window's title while the program has set none"
    , commonDescription = Nothing
    , summary = "Runs a program on a terminal in an X window:"
    , example = PP.words "visiterm --title notes -- vim -O a.txt b.txt"
    , builder = \program flags -> Run { config = flags.config, title = flags.title, program = program }
    }


main : Task Never {}
main =
    Os.Env.getEnvironment
        |> Task.andThen
            (\env ->
                Argparse.Program.runRootWithContext env
                    { name = "visiterm"
                    , version = "0.1.0"
                    , command = cli
                    , init =
                        \_ ->
                            Task.map3 (\cp fs vars -> { cp = cp, fs = fs, vars = vars }) Process.initialize File.initialize Os.Env.getEnvironmentVariables
                    , onCommand =
                        \_ ctx (Run given) ->
                            settings ctx.fs ctx.vars given.config
                                |> Task.map
                                    (\config ->
                                        { config
                                            | title = Maybe.withDefault config.title given.title
                                            , command = if Array.isEmpty given.program then config.command else given.program
                                        }
                                    )
                                |> Task.andThen (\config -> start ctx.cp ctx.vars config)
                                |> Task.mapError (\why -> Argparse.Program.ExitMessageValue { message = "visiterm: " ++ why, value = 2 })
                    }
            )


{-| The settings file: the one the command line names, which must be
there, or the user's, or the defaults when the user has none. -}
settings : File.Permission -> Dict String String -> Maybe Path.Path -> Task String Config
settings fs vars given =
    let
        dir =
            when Dict.get "XDG_CONFIG_HOME" vars is
                Just d ->
                    if d /= "" then
                        Just d

                    else
                        Maybe.map (\h -> h ++ "/.config") (Dict.get "HOME" vars)

                Nothing ->
                    Maybe.map (\h -> h ++ "/.config") (Dict.get "HOME" vars)

        file =
            when given is
                Just p ->
                    Just { path = p, required = True }

                Nothing ->
                    Maybe.map (\d -> { path = Path.fromString (d ++ "/visiterm/config.toml"), required = False }) dir
    in
    when file is
        Nothing ->
            Task.succeed Config.defaults

        Just f ->
            let
                path =
                    Path.toString f.path
            in
            File.readFile fs f.path
                |> Task.map Just
                |> Task.onError
                    (\err ->
                        if err.kind == Os.Error.NotFound && not f.required then
                            Task.succeed Nothing

                        else
                            Task.fail (Os.Error.toString err)
                    )
                |> Task.andThen
                    (\read ->
                        when read is
                            Nothing ->
                                Task.succeed Config.defaults

                            Just bytes ->
                                when Config.decode (Bytes.toStringLossy bytes) is
                                    Ok config ->
                                        Task.succeed config

                                    Err why ->
                                        Task.fail (path ++ ": " ++ why)
                    )


start : Process.Permission -> Dict String String -> Config -> Task String {}
start cp vars config =
    X11.open
        { cols = config.columns
        , rows = config.rows
        , font = config.font
        , points = config.points
        , lang = Maybe.withDefault (Config.languageOf vars) config.language
        , glyphCap = config.glyphCacheMb * 1024 * 1024
        , title = config.title
        }
        |> Task.andThen
            (\opened ->
                when opened is
                    Err why ->
                        Task.fail ("cannot open the window: " ++ why)

                    Ok cell ->
                        let
                            command =
                                if Array.isEmpty config.command then
                                    [ Maybe.withDefault "/bin/sh" (Dict.get "SHELL" vars |> Maybe.andThen (\s -> if s == "" then Nothing else Just s)) ]

                                else
                                    config.command

                            options =
                                -- the pty's IUTF8 says whether the program's bytes are UTF-8
                                Process.defaultSpawnOptions (Terminal { columns = config.columns, rows = config.rows, utf8 = charset == Charset.Utf8 })

                            charset =
                                Charset.fromName (Maybe.withDefault (Config.charsetOf vars) config.charset)
                        in
                        Process.spawn cp
                            (Maybe.withDefault "/bin/sh" (Array.first command))
                            (Array.dropFirst 1 command)
                            { options | environmentVariables = Process.MergeWithEnvironmentVariables (Dict.set "COLORTERM" "truecolor" (Dict.set "TERM" "xterm-256color" Dict.empty)) }
                            |> Task.mapError Os.Error.toString
                            |> Task.andThen (\child -> run (Dict.member "VISITERM_IME_LOG" vars) charset config cell child)
            )


{-| `imeLog`: with `VISITERM_IME_LOG` set, each commit and each change to
the preedit is written to standard output, for the IME gate
(`harness/ime.py`, V45). -}
run : Bool -> Charset -> Config -> X11.Cell -> Process.Child -> Task String {}
run imeLog charset config cell child =
    when Process.terminal child is
        Nothing ->
            Task.fail "the program has no terminal"

        Just terminal ->
            now
                |> Task.andThen
                    (\t0 ->
                        loop terminal
                            (Process.terminalHandle terminal)
                            { config = config
                            , look = { foreground = config.foreground, background = config.background, boldIsBright = config.boldIsBright }
                            , term =
                                Vt.new
                                    { cols = config.columns
                                    , rows = config.rows
                                    , scrollbackBytes = Vt.scrollbackBytesFor { cols = config.columns, rows = config.scrollbackLines }
                                    , pageRows = Vt.defaultPageRows
                                    , checksums = False
                                    , cellWidth = cell.width
                                    , cellHeight = cell.height
                                    }
                            , shadow = View.shadow config.columns config.rows
                            , focus = View.focused
                            , last = t0
                            , pending = -1
                            , urgent = True
                            , blinkAt = -1
                            , syncSince = -1
                            , title = ""
                            , closed = False
                            , lost = False
                            , out = Bytes.empty
                            , preedit = { points = [], feedback = [], caret = 0 }
                            , imeLog = imeLog
                            , points = config.points
                            , charset = charset
                            , decoder = Charset.decoder
                            , replaced = 0
                            , held = 0
                            , mouseLast = Nothing
                            , allMotion = False
                            , back = 0
                            }
                            |> Task.mapError Os.Error.toString
                    )
                |> Task.andThen (\m -> finish child m)


{-| The end: the program's exit status when it ended, 0 when the window
was closed, after asking the program to end. -}
finish : Process.Child -> Model -> Task String {}
finish child m =
    if m.lost then
        Process.kill child |> Task.andThen (\_ -> Task.fail "the connection to the X server is lost")

    else if m.closed then
        Process.kill child |> Task.andThen (\_ -> Os.Env.exitWithCode 0)

    else
        Process.waitForExit child
            |> Task.andThen
                (\code ->
                    Os.Env.exitWithCode
                        (if code < 0 then
                            1

                         else
                            code
                        )
                )


syncHeld : Vt.Term -> Bool
syncHeld t =
    Dict.get 2026 t.modes == Just True


blinking : Model -> Bool
blinking m =
    m.config.blinkMs > 0 && m.focus.focused && m.term.showCursor && Dict.get 12 m.term.modes == Just True


{-| When the next frame is due, or -1 for none waiting. -}
frameAt : Model -> Int
frameAt m =
    if m.pending < 0 && not m.urgent then
        -1

    else if syncHeld m.term && m.syncSince >= 0 then
        m.syncSince + m.config.syncTimeoutMs

    else if m.urgent then
        0

    else
        m.last + m.config.frameMs


{-| The time the timer branch waits for: the frame's, or the blink's. -}
nextAt : Model -> Int
nextAt m =
    let
        f =
            frameAt m

        b =
            if blinking m then
                m.blinkAt

            else
                -1
    in
    if f < 0 then
        b

    else if b < 0 then
        f

    else
        min f b


{-| What the program is sent, queued: keys, replies, focus reports, a
paste. The pty takes what it takes; the rest waits for `File.writable`, which
the loop races beside its read, so a program that stops reading until its
output is read never holds the window (V48, geng-lang D1049). -}
send : Bytes -> (moved m : Model) -> Model
send text m =
    let
        -- in the pane's character set (cjk-and-thai.md §10.3, V49); what
        -- it cannot send goes as `?`, counted and shown in the title. A
        -- legacy mouse report's bytes are raw and will skip this.
        encoded =
            Charset.encode m.charset text

        bytes =
            encoded.bytes
    in
    if Bytes.isEmpty m.out then
        { m | out = bytes, replaced = m.replaced + encoded.replaced }

    else
        { m | out = Bytes.flatten [ m.out, bytes ], replaced = m.replaced + encoded.replaced }


{-| Bytes queued as they are, in no character set: a mouse report, whose
legacy forms are raw bytes. -}
sendRaw : Bytes -> (moved m : Model) -> Model
sendRaw bytes m =
    if Bytes.isEmpty bytes then
        m

    else if Bytes.isEmpty m.out then
        { m | out = bytes }

    else
        { m | out = Bytes.flatten [ m.out, bytes ] }


{-| The queue written as far as the pty takes it. -}
flush : File.Handle -> (moved m : Model) -> Task Error Model
flush fd m =
    if Bytes.isEmpty m.out then
        Task.succeed m

    else
        File.writeSome m.out fd
            |> Task.map (\n -> { m | out = Bytes.slice n (Bytes.length m.out) m.out })


loop : Process.Terminal -> File.Handle -> (moved m00 : Model) -> Task Error Model
loop terminal fd m00 =
    let
        -- every motion from X only while the program asks for any motion
        -- (mode 1003, docs/phase3-select.md §4)
        all =
            (Vt.mouseModes m00.term).tracking == Mouse.any
    in
    (if all == m00.allMotion then
        Task.succeed m00

     else
        X11.motion all |> Task.map (\_ -> { m00 | allMotion = all })
    )
        |> Task.andThen (flush fd)
        |> Task.andThen (\m0 -> race terminal fd m0)


race : Process.Terminal -> File.Handle -> (moved m0 : Model) -> Task Error Model
race terminal fd m0 =
    now
        |> Task.andThen
            (\ms0 ->
                let
                    m =
                        if blinking m0 && m0.blinkAt < 0 then
                            { m0 | blinkAt = ms0 + m0.config.blinkMs }

                        else
                            m0

                    at =
                        nextAt m

                    timer =
                        if at < 0 then
                            []

                        else
                            [ Sleep.sleep (toFloat (max 0 (at - ms0))) |> Task.map (\_ -> Due) ]

                    writing =
                        if Bytes.isEmpty m.out then
                            []

                        else
                            [ File.writable fd |> Task.map (\_ -> Writable) ]
                in
                Task.race (File.read fd |> Task.map Read) ([ X11.events |> Task.map Events ] ++ timer ++ writing)
                    |> Task.andThen
                        (\turn ->
                            now
                                |> Task.andThen
                                    (\ms ->
                                        when turn is
                                            Read chunk ->
                                                if Bytes.length chunk == 0 then
                                                    Task.succeed m

                                                else
                                                    feed fd chunk ms m |> Task.andThen (\next -> step terminal fd ms next)

                                            Events up ->
                                                if not up then
                                                    Task.succeed { m | lost = True }

                                                else
                                                    X11.take
                                                        |> Task.andThen (\evs -> handle terminal fd ms evs m)
                                                        |> Task.andThen (\next -> step terminal fd ms next)

                                            Due ->
                                                step terminal fd ms (blink ms m)

                                            Writable ->
                                                step terminal fd ms m
                                    )
                        )
            )


{-| A frame if one is due, then the loop again, unless the window is gone. -}
step : Process.Terminal -> File.Handle -> Int -> (moved m : Model) -> Task Error Model
step terminal fd ms m =
    if m.closed || m.lost then
        Task.succeed m

    else
        let
            at =
                frameAt m
        in
        if at >= 0 && ms >= at then
            draw ms m |> Task.andThen (\next -> if next.lost then Task.succeed next else loop terminal fd next)

        else
            loop terminal fd m


blink : Int -> (moved m : Model) -> Model
blink ms m =
    if blinking m && m.blinkAt >= 0 && ms >= m.blinkAt then
        { m | focus = { focused = m.focus.focused, blinkOn = not m.focus.blinkOn }, blinkAt = ms + m.config.blinkMs, urgent = True }

    else
        m


{-| What may wait to be written before the core's replies are dropped: a
program that asks and never reads its answers holds no more than this
(S§5.1). Keys and pastes are never dropped. -}
replyCap : Int
replyCap =
    1048576


{-| A read fed to the core and its replies queued, while fewer than
`replyCap` bytes wait. -}
feed : File.Handle -> Bytes -> Int -> (moved m : Model) -> Task Error Model
feed fd chunk0 ms m =
    let
        -- an EUC-KR or CP949 pane's bytes in UTF-8 before the core (V49)
        decoded =
            if m.charset == Charset.Utf8 then
                { decoder = m.decoder, bytes = chunk0 }

            else
                Charset.decode m.decoder chunk0

        pushedBefore =
            Vt.rowsPushed m.term

        taken =
            Vt.takeReplies (Vt.feed decoded.bytes m.term)

        held =
            syncHeld taken.term

        -- a view scrolled back stays on its rows as more come in below it
        back =
            if m.back > 0 then
                min (Vt.scrollbackRows taken.term) (m.back + Vt.rowsPushed taken.term - pushedBefore)

            else
                0
    in
    Task.succeed
        (Array.foldl (\r acc -> if Bytes.length acc.out >= replyCap then acc else send r acc)
            { m
                | term = taken.term
                , back = back
                , decoder = decoded.decoder
                , pending =
                    if m.pending < 0 then
                        ms

                    else
                        m.pending
                , syncSince =
                    if not held then
                        -1

                    else if m.syncSince < 0 then
                        ms

                    else
                        m.syncSince
            }
            taken.replies
        )


{-| The window's events: a key sent to the program, a new size given to the
core and the terminal, the focus kept for the cursor and reported under
mode 1004, a close. -}
handle : Process.Terminal -> File.Handle -> Int -> Array X11.Event -> (moved m : Model) -> Task Error Model
handle terminal fd ms evs m =
    when Array.first evs is
        Nothing ->
            Task.succeed m

        Just ev ->
            let
                rest =
                    Array.dropFirst 1 evs
            in
            when ev is
                X11.Key k ->
                    when zoomOf m k is
                        Just points ->
                            X11.zoom points
                                |> Task.andThen
                                    (\_ ->
                                        -- every cell is drawn again at the new size
                                        handle terminal fd ms rest { m | points = points, shadow = View.shadow m.term.cols m.term.rows, urgent = True }
                                    )

                        Nothing ->
                            when scrollKeyOf m k is
                                Just back ->
                                    handle terminal fd ms rest { m | back = back, urgent = True }

                                Nothing ->
                                    key terminal fd ms rest k m

                X11.Resized size ->
                    Process.resize terminal { columns = size.cols, rows = size.rows }
                        |> Task.andThen (\_ -> handle terminal fd ms rest { m | term = Vt.resize size.cols size.rows m.term, urgent = True, back = 0 })

                X11.Focus on ->
                    let
                        report =
                            if Dict.get 1004 m.term.modes == Just True then
                                if on then
                                    Bytes.fromString "\u{001B}[I"

                                else
                                    Bytes.fromString "\u{001B}[O"

                            else
                                Bytes.empty
                    in
                    handle terminal fd ms rest (send report { m | focus = { focused = on, blinkOn = True }, urgent = True, blinkAt = -1 })

                X11.Close ->
                    Task.succeed { m | closed = True }

                X11.Commit text ->
                    -- the key path: the text as typed, never as a paste (V46)
                    imeLine m.imeLog ("commit " ++ Bytes.toStringLossy text)
                        |> Task.andThen (\_ -> handle terminal fd ms rest (send text { m | urgent = True, back = 0 }))

                X11.Preedit p ->
                    let
                        cps =
                            Array.map Char.toCode (String.toArray (Bytes.toStringLossy p.text))

                        old =
                            m.preedit

                        points =
                            Array.takeFirst p.first old.points ++ cps ++ Array.dropFirst (p.first + p.length) old.points

                        feedback =
                            Array.takeFirst p.first old.feedback
                                ++ Array.initialize (Array.length cps) 0 (\i -> Maybe.withDefault 0 (Array.get i p.feedback))
                                ++ Array.dropFirst (p.first + p.length) old.feedback
                    in
                    imeLine m.imeLog ("preedit " ++ String.fromArray (Array.mapAndKeepJust Char.fromCode points) ++ " caret " ++ String.fromInt p.caret ++ " feedback " ++ String.join " " (Array.map String.fromInt feedback))
                        |> Task.andThen (\_ -> handle terminal fd ms rest { m | preedit = { points = points, feedback = feedback, caret = p.caret }, urgent = True })

                X11.ImeReady ->
                    imeLine m.imeLog "ime ready"
                        |> Task.andThen (\_ -> handle terminal fd ms rest m)

                X11.PreeditDone ->
                    imeLine m.imeLog "done"
                        |> Task.andThen (\_ -> handle terminal fd ms rest { m | preedit = { points = [], feedback = [], caret = 0 }, urgent = True })

                X11.Pointer p ->
                    handle terminal fd ms rest (pointer p m)


{-| A press, release or motion of the pointer (docs/phase3-select.md §4):
reported to a program that asked for mouse reports, in its format, by
Ghostty's encoder (`Vt.Mouse`). Shift takes the mouse back from it, as in
Ghostty, xterm and kitty: a press or release of a button with Shift, or a
motion with Shift while a button is held, is visiterm's own. The wheel is
not: Ghostty reports it with Shift too, and nvim pages with Shift and the
wheel. A motion is reported with the lowest-numbered button held, as
Ghostty reports it. -}
pointer : X11.PointerEvent -> (moved m : Model) -> Model
pointer p m =
    let
        modes =
            Vt.mouseModes m.term

        bit =
            Bitwise.shiftLeftBy p.button 1

        held =
            if p.button == 0 || (p.button >= 4 && p.button <= 7) then
                -- a wheel step is pressed and never held (`wheel` below)
                m.held

            else if p.action == 0 then
                Bitwise.or m.held bit

            else if p.action == 1 then
                Bitwise.and m.held (Bitwise.complement bit)

            else
                m.held

        wheel =
            p.button >= 4 && p.button <= 7

        taken =
            Bitwise.and p.mods 1 /= 0 && not wheel && (p.action /= 2 || held /= 0)
    in
    if modes.tracking == Mouse.none && wheel && p.action == 0 then
        wheelStep p.button { m | held = held }

    else if modes.tracking == Mouse.none || taken then
        { m | held = held }

    else
        let
            r =
                Mouse.encode
                    { tracking = modes.tracking
                    , format = modes.format
                    , size =
                        { screenWidth = p.width
                        , screenHeight = p.height
                        , cellWidth = p.cellWidth
                        , cellHeight = p.cellHeight
                        , padTop = 0
                        , padBottom = 0
                        , padRight = 0
                        , padLeft = 0
                        }
                    , anyButtonPressed = held /= 0
                    , track = True
                    , last = m.mouseLast
                    }
                    { action = p.action
                    , button =
                        if p.action == 2 then
                            lowestHeld held 1

                        else
                            p.button
                    , mods = p.mods
                    , x = p.x
                    , y = p.y
                    }
        in
        sendRaw r.bytes { m | held = held, mouseLast = r.last }


{-| A step of the wheel no program asked for (docs/phase3-select.md §11):
on the alternate screen with mode 1007 set, three arrow keys, as Ghostty
sends them, in DECCKM's form; else the view scrolled three rows. A step
sideways does nothing. One step reported to a program that asked for the
mouse is one report, as xterm sends it; Ghostty sends three. -}
wheelStep : Int -> (moved m : Model) -> Model
wheelStep button m =
    let
        up =
            button == 4

        down =
            button == 5
    in
    if not (up || down) then
        m

    else if m.term.alt then
        if Dict.get 1007 m.term.modes == Just False then
            m

        else
            let
                arrow =
                    (if Dict.get 1 m.term.modes == Just True then
                        "\u{001B}O"

                     else
                        "\u{001B}["
                    )
                        ++ (if up then
                                "A"

                            else
                                "B"
                           )
            in
            send (Bytes.fromString (arrow ++ arrow ++ arrow)) m

    else if up then
        { m | back = min (Vt.scrollbackRows m.term) (m.back + 3), urgent = True }

    else
        { m | back = max 0 (m.back - 3), urgent = True }


lowestHeld : Int -> Int -> Int
lowestHeld held i =
    if i > 11 then
        0

    else if Bitwise.and held (Bitwise.shiftLeftBy i 1) /= 0 then
        i

    else
        lowestHeld held (i + 1)


{-| A key sent to the program, the cursor's blink begun again. -}
key : Process.Terminal -> File.Handle -> Int -> Array X11.Event -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (moved m : Model) -> Task Error Model
key terminal fd ms rest k m =
    let
        bytes =
            Keys.encode m.term k

        blinkAt =
            if blinking m then
                ms + m.config.blinkMs

            else
                -1

        focus =
            { focused = m.focus.focused, blinkOn = True }
    in
    handle terminal fd ms rest
        (send bytes
            { m
                | urgent = True
                , focus = focus
                , blinkAt = blinkAt
                , -- a key that reaches the program brings the view to the bottom
                  back =
                    if Bytes.isEmpty bytes then
                        m.back

                    else
                        0
            }
        )


{-| The keys that move a view of the scrollback (docs/phase3-select.md
§11), on the main screen, pressed or repeated: with Shift alone, PgUp and
PgDn a page, Home the top, End the bottom; with Ctrl and Shift, Up and Down
the shell's previous and next prompt, as Ghostty's `jump_to_prompt`. On the
alternate screen they are the program's, as in Alacritty and WezTerm. -}
scrollKeyOf : Model -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Int
scrollKeyOf m k =
    let
        most =
            Vt.scrollbackRows m.term
    in
    if k.action == 0 || most == 0 then
        Nothing

    else if Bitwise.and k.mods 15 == 3 && (k.sym == 0xFF52 || k.sym == 0xFF54) then
        Just
            (Vt.promptJump
                (if k.sym == 0xFF52 then
                    -1

                 else
                    1
                )
                m.back
                m.term
            )

    else if Bitwise.and k.mods 15 /= 1 then
        Nothing

    else if k.sym == 0xFF55 then
        Just (min most (m.back + m.term.rows))

    else if k.sym == 0xFF56 then
        Just (max 0 (m.back - m.term.rows))

    else if k.sym == 0xFF50 then
        Just most

    else if k.sym == 0xFF57 then
        Just 0

    else
        Nothing


{-| The zoom's keys (V50): Ctrl with `=` or `+` a point larger, with `-` a
point smaller, with `0` the configured size; pressed or repeated, without
alt or super. Any other key is the program's. -}
zoomOf : Model -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Int
zoomOf m k =
    if k.action == 0 || Bitwise.and k.mods 2 == 0 || Bitwise.and k.mods 12 /= 0 then
        Nothing

    else if k.sym == 0x3D || k.sym == 0x2B || k.sym == 0xFFAB then
        Just (min 96 (m.points + 1))

    else if k.sym == 0x2D || k.sym == 0xFFAD then
        Just (max 4 (m.points - 1))

    else if k.sym == 0x30 then
        Just m.config.points

    else
        Nothing


imeLine : Bool -> String -> Task x {}
imeLine on line =
    if on then
        Console.write (line ++ "\n")

    else
        Task.succeed {}


{-| A frame drawn, and the window's title made the program's. -}
draw : Int -> (moved m : Model) -> Task x Model
draw ms m =
    let
        preedit =
            { text = String.fromArray (Array.mapAndKeepJust Char.fromCode m.preedit.points)
            , feedback = m.preedit.feedback
            , caret = m.preedit.caret
            }

        -- the alternate screen keeps no scrollback, so a view scrolled
        -- back shows the screen while it is up
        back =
            min m.back (Vt.scrollbackRows m.term)

        f =
            if back > 0 then
                View.frameBack m.look m.focus back (Vt.viewAt back m.term) m.term m.shadow

            else
                View.frameWith m.look m.focus preedit m.term m.shadow

        spot =
            View.preeditSpot preedit m.term

        title =
            (if m.term.title == "" then
                m.config.title

             else
                m.term.title
            )
                ++ (if m.replaced > 0 then
                        " [" ++ String.fromInt m.replaced ++ " characters sent as ?]"

                    else
                        ""
                   )
    in
    X11.draw f.list
        |> Task.andThen (\up -> X11.spot spot |> Task.map (\_ -> up))
        |> Task.andThen
            (\up ->
                (if title /= m.title then
                    X11.setTitle title

                 else
                    Task.succeed {}
                )
                    |> Task.map
                        (\_ ->
                            let
                                shadow =
                                    View.inked (Maybe.withDefault Bytes.empty up) f.shadow

                                -- The view asks for a frame at once when new
                                -- ink lands on a glyph it did not draw (V40).
                                again =
                                    View.wantsFrame shadow
                            in
                            { m
                                | shadow = shadow
                                , last = ms
                                , pending = -1
                                , urgent = again
                                , title = title
                                , lost = m.lost || up == Nothing
                                -- A hold that timed out begins again at the next read.
                                , syncSince = -1
                            }
                        )
            )
