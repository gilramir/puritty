type alias Model =
    { config : Config
    , look : View.Look
    , term : Vt.Term
    , shadow : View.Shadow
    , focus : View.Focus
    , last : Int
    , pending : Int
    , urgent : Bool
    , blinkAt : Int
    , syncSince : Int
    , title : String
    , closed : Bool
    , lost : Bool
    , out : Outbox
    , preedit : { points : Array Int, feedback : Array Int, caret : Int }
    , imeLog : Bool
    , points : Int
    , charset : Charset
    , decoder : Charset.Decoder
    , replaced : Int
      -- the mouse (docs/phase3-select.md §4): the buttons held, as bits of
      -- Ghostty's numbers; the cell last reported, so a motion within it is
      -- not reported again; whether X sends every motion
    , held : Int
    , mouseLast : Maybe Mouse.Cell
    , allMotion : Bool
      -- the pointer shown (the arrow while the program takes the mouse, a
      -- drag's shape over what is dragged, docs/tmux.md TM38), the pointer's
      -- last place over the window, and whether Shift is held, which takes
      -- the mouse back (docs/phase3-select.md §21)
    , pointerShown : Window.Pointer
    , hover : Maybe Window.PointerEvent
    , shiftHeld : Bool
      -- how many rows the view is scrolled back, 0 at the bottom
      -- (docs/phase3-select.md §11)
    , back : Int
      -- the selection (docs/phase3-select.md §14), the last press of the
      -- left button for double and triple clicks, and a selection to hand
      -- to the window when the event's model is done
    , selection : Maybe Selection
    , clicks : { at : Int, count : Int, cell : Vt.Point }
    , toOwn : Maybe { which : Window.Selection, text : String }
    , wordBoundaries : Array Int
      -- a paste to ask for when the event's model is done, and one under
      -- way: whether it is bracketed, decided by mode 2004 when its first
      -- text comes (docs/phase3-select.md §15)
    , toPaste : Maybe Window.Selection
    , pasting : Maybe Bool
      -- OSC 52 (docs/phase3-select.md §16): requests the core made, to be
      -- done by the loop, and a read under way, its text so far
    , clips : Array Vt.Clip
    , clipRead : Maybe { letter : Int, bel : Bool, text : Bytes }
      -- where the settings came from, and a change to them followed
      -- (docs/settings.md ST3)
    , settings : Settings
      -- with PURITTY_SHOT set, the file each frame's picture is written to,
      -- for the reload gate (harness/reload.py)
    , shotPath : Maybe String
      -- what was wrong in the settings file when it was last read, the
      -- first of it shown in the title (docs/settings.md ST17)
    , troubles : Array String
      -- how Ctrl+Comma starts the settings window (docs/settings.md ST9):
      -- this program's own file, with `settings`, not tied to this one
    , settingsWindow : Maybe { cp : Process.Permission, program : String, args : Array String }
      -- the menu Ctrl+right-click opens, drawn over the screen (ST26), or
      -- the items of the one the platform shows, and of its system menu
    , menu : Maybe Menu
    , shownItems : Array MenuItem
      -- the built-in ssh client's session (docs/ssh-client.md SC18): what
      -- puritty's own screen shows until the session runs, a question it
      -- asks, how the session ended
    , ssh : Maybe SshScreen
      -- tmux control mode, when `tmux -CC` runs on the terminal
      -- (docs/tmux.md TM14)
    , tmux : TmuxMode.State
      -- whether the last frame had a question's box over it, so that the
      -- frame it comes or goes in draws every cell (docs/ssh-client.md SC23)
    , overlaid : Bool
      -- scrollback search, while its bar is open, and a drag of the
      -- scrollbar's thumb going on (docs/phase3-select.md §23)
    , search : Maybe Search.State
    , barDrag : Bool
      -- the tabs (docs/tabs.md TB2): the shown one's backend and its tab's
      -- name and marks; the other tabs, each its session's fields, in slots
      -- (`Nothing` a free one) a tab is swapped in and out of; the tabs'
      -- ids in the bar's order, the shown one's among them; the next tab's
      -- id; how a tab is started; and the window's rows, of which the bar
      -- takes the last while it shows
    , remote : Backend
    , tab : TabInfo
    , tabs : Builder (Maybe Tab)
    , order : Array Int
    , nextTabId : Int
    , starter : Starter
    , windowRows : Int
    , renaming : Maybe { id : Int, typed : String }
    , coloring : Maybe Int
    , closing : Maybe { id : Int, why : String, window : Bool }
    , barClick : { at : Int, id : Int }
      -- the tabs kept to restore (docs/tabs.md TB10): the state directory,
      -- none for a window not kept; this window's files once made; what
      -- was last written; when to look again (-1 never); and whether the
      -- window was closed by its button, which is remembered only when
      -- no other window is open
    , saving : { dir : Maybe Path.Path, window : Maybe Restore.Window, written : String, at : Int }
    , byButton : Bool
    , quietUntil : Int
      -- tabs closed lately, to open again (docs/tabs.md TB11): five
      -- slots, each a tab as it was with where it was and when it closed
    , closedTabs : Builder (Maybe Closed)
      -- the diagnostic log (docs/diagnostics.md DG1): its lines waiting to
      -- be written, the folder its files go in, the time of the turn the
      -- lines are written at, and the tab last said to be shown
    , diag : Diag.Log
    , logDir : Maybe String
    , turnMs : Int
    , loggedTab : Int
    }


{-| A tab closed, kept to open again (docs/tabs.md TB11): the tab as it
was, its program gone; the directory its shell was in, when it was read
before the close; and when it closed. -}
type alias Closed =
    { tab : Tab
    , directory : Maybe Path.Path
    , at : Int
    }


{-| A tab not shown (docs/tabs.md TB2): its backend and its session's own
fields, which `swapTab` exchanges with the model's when it is shown. -}
type alias Tab =
    { info : TabInfo
    , remote : Backend
    , term : Vt.Term
    , charset : Charset
    , decoder : Charset.Decoder
    , replaced : Int
    , out : Outbox
    , back : Int
    , selection : Maybe Selection
    , pasting : Maybe Bool
    , clips : Array Vt.Clip
    , clipRead : Maybe { letter : Int, bel : Bool, text : Bytes }
    , ssh : Maybe SshScreen
    , tmux : TmuxMode.State
    , search : Maybe Search.State
    , syncSince : Int
    }


{-| A tab's own: an id the loop's reads are told apart by, the name the
user gave it (empty for none), the host it is a session to, the bells its
terminal had rung when last looked at, and whether it rang or printed
since. -}
type alias TabInfo =
    { id : Int
    , name : String
    , host : Maybe Config.Host
    , hostName : Maybe String
    , color : TabColor
    , bells : Int
    , bell : Bool
    , activity : Bool
    }


{-| How a tab is started: a local program at a size, with the character set
of a local tab; or a session to a host, as the window's first was. -}
type alias Starter =
    { local : { columns : Int, rows : Int, directory : Maybe Path.Path } -> Task String Backend
    , ssh : Config.Host -> Task String Backend
    , charset : Charset
    }


{-| puritty's own screen for an ssh session: the host, what has happened,
the question asked and what has been typed for it, whether the session
runs, why it failed, and its exit status. -}
type alias SshScreen =
    { host : String
    , lines : Array String
    , asking : Maybe { ask : Session.Ask, typed : String, given : Array String }
    , started : Bool
    , failed : Maybe String
    , exitStatus : Maybe Int
    }


{-| A menu over the screen: its items, each what this program is started
again with, where its box is, and the item marked. -}
type alias Menu =
    { items : Array MenuItem
    , row : Int
    , col : Int
    , selected : Int
    }


{-| A selection: from `anchor` to `head`, in either order, both included.
`mode` 0 by cells, 1 by words, 2 by lines; a drag by words or lines keeps
the first word or line, `first` to `last`, whichever way it goes. `made`
once the button is let go and its text is the window's PRIMARY; `hashes`
then holds each of its rows on the screen, so that a write over one takes
the highlight away. `alt` is the screen it was made on. -}
type alias Selection =
    { anchor : Vt.Point
    , head : Vt.Point
    , first : Vt.Point
    , last : Vt.Point
    , mode : Int
    , moved : Bool
    , made : Bool
    , alt : Bool
    , hashes : Dict Int Int
    }


type Turn
    = Read Incoming
    | Events Bool
    | Due
    | Writable
    | SettingsChanged (Maybe Directory.Change)
    | Behind { id : Int, incoming : Incoming }
    | BehindWritable Int


now : Task x Int
now =
    Time.monotonic |> Task.map (\t -> Int64.toInt (Time.inMilliseconds t))


type Command
    = Run { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String }


{-| What the first word asked for (`docs/settings.md` ST11, V64): nothing
(the settings' `start`), a local shell, or a quick connect. -}
type Mode
    = Plain
    | Shell
    | Ssh String
    | HostList
    | RestoreOne


cli : Argparse.Parser.Command (Array String) { config : Maybe Path.Path, title : Maybe String, host : Maybe String } Command
cli =
    { word = ""
    , arguments =
        Argparse.Parser.zeroOrMoreArgs
            { value = { label = "program", fn = Just, examples = [ "htop", "vim notes.txt" ] }
            , help = "The program to run, and its arguments; $SHELL (on Windows PowerShell) when none is given"
            }
    , flags =
        Argparse.Parser.initFlags (\config title host -> { config = config, title = title, host = host })
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "config") (Argparse.Parser.pathParser Path.fromString) "The settings file, instead of ~/.config/puritty/config.toml (on Windows %APPDATA%\\puritty\\config.toml)"
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "title") Argparse.Parser.stringParser "The window's title while the program has set none"
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "host") Argparse.Parser.stringParser "A host of the settings, connected to with ssh; a name they do not have is ssh's own (an alias of ~/.ssh/config)"
    , commonDescription = Nothing
    , summary = "Runs a program on a terminal in an X window:"
    , example = PP.words "puritty --title notes -- vim -O a.txt b.txt"
    , builder = \program flags -> Run { config = flags.config, title = flags.title, host = flags.host, program = program }
    }


main : Task Never {}
main =
    Os.Env.getEnvironment
        |> Task.andThen
            (\env ->
                -- `puritty settings`: the settings window, a process of its
                -- own (docs/settings.md ST2, V57); `puritty -- settings`
                -- runs a program of that name
                when Array.first env.args is
                    Just "settings" ->
                        settingsMain { env | args = Array.dropFirst 1 env.args }

                    -- `puritty shell`: a local shell, whatever `start` says
                    Just "shell" ->
                        terminalMain Shell { env | args = Array.dropFirst 1 env.args }

                    -- `puritty restore`: one saved window opened again, or
                    -- none when none waits (docs/tabs.md TB10)
                    Just "restore" ->
                        terminalMain RestoreOne { env | args = Array.dropFirst 1 env.args }

                    -- `puritty hosts`: the host list, which a session replaces
                    Just "hosts" ->
                        terminalMain HostList { env | args = Array.dropFirst 1 env.args }

                    -- `puritty ssh user@host:port`: quick connect
                    Just "ssh" ->
                        when Array.get 1 env.args is
                            Just target ->
                                terminalMain (Ssh target) { env | args = Array.dropFirst 2 env.args }

                            Nothing ->
                                Console.writeErr "puritty ssh: give where to connect, as user@host:port\n"
                                    |> Task.andThen (\_ -> Os.Env.exitWithCode 2)

                    _ ->
                        terminalMain Plain env
            )


settingsMain : Os.Env.Environment -> Task Never {}
settingsMain env =
    Argparse.Program.runRootWithContext env
        { name = "puritty settings"
        , version = "0.1.0"
        , command = settingsCli
        , init =
            \_ ->
                Task.map3 (\cp fs more -> { cp = cp, fs = fs, vars = more.vars, self = more.self })
                    Process.initialize
                    File.initialize
                    (Task.map2 (\vars self -> { vars = vars, self = self })
                        Os.Env.getEnvironmentVariables
                        (Os.Env.executable |> Task.map Just |> Task.onError (\_ -> Task.succeed Nothing))
                    )
        , onCommand =
            \_ ctx (Settings asked) ->
                SettingsProgram.run
                    { fs = ctx.fs
                    , vars = ctx.vars
                    , config = asked
                    , launcher = False
                    , opener = Maybe.map (\self -> { cp = ctx.cp, program = Path.toString self, config = Maybe.map Path.toString asked }) ctx.self
                    }
                    |> Task.map (\_ -> {})
                    |> Task.mapError (\why -> Argparse.Program.ExitMessageValue { message = "puritty settings: " ++ why, value = 2 })
        }


type SettingsCommand
    = Settings (Maybe Path.Path)


settingsCli : Argparse.Parser.Command {} (Maybe Path.Path) SettingsCommand
settingsCli =
    { word = ""
    , arguments = Argparse.Parser.noArgs
    , flags =
        Argparse.Parser.initFlags identity
            |> Argparse.Parser.flag (Argparse.Parser.LongOnly "config") (Argparse.Parser.pathParser Path.fromString) "The settings file, instead of ~/.config/puritty/config.toml (on Windows %APPDATA%\\puritty\\config.toml)"
    , commonDescription = Nothing
    , summary = "Opens the settings window, whose changes every puritty window takes at once:"
    , example = PP.words "puritty settings"
    , builder = \_ config -> Settings config
    }


terminalMain : Mode -> Os.Env.Environment -> Task Never {}
terminalMain mode env =
                Argparse.Program.runRootWithContext env
                    { name = "puritty"
                    , version = "0.1.0"
                    , command = cli
                    , init =
                        \_ ->
                            Task.map3 (\cp fs vars -> { cp = cp, fs = fs, vars = vars }) Process.initialize File.initialize Os.Env.getEnvironmentVariables
                    , onCommand =
                        \_ ctx (Run asked) ->
                            let
                                given =
                                    { file = settingsFile ctx.vars asked.config
                                    , fs = ctx.fs
                                    , title = asked.title
                                    , program = asked.program
                                    }
                            in
                            readSettings given
                                |> Task.andThen
                                    (\read ->
                                        let
                                            got =
                                                when read is
                                                    Gave r ->
                                                        r

                                                    Unread why ->
                                                        { config = overridden given Config.defaults, problems = [ why ++ "; the defaults are used" ] }

                                            chosen =
                                                choose mode asked got.config

                                            listing =
                                                Array.isEmpty asked.program
                                                    && asked.host == Nothing
                                                    && (mode == HostList || (mode == Plain && got.config.start == "hosts"))

                                            -- the state directory, for a window whose tabs can
                                            -- be restored: not one started with a program
                                            -- (docs/tabs.md TB10)
                                            stateDir =
                                                if Array.isEmpty asked.program then
                                                    Maybe.map Path.fromString (Platform.stateDirectory ctx.vars)

                                                else
                                                    Nothing

                                            -- a plain start with restoring on, or `puritty
                                            -- restore`, claims a saved window
                                            claiming =
                                                when stateDir is
                                                    Just dir ->
                                                        if asked.host == Nothing && (mode == RestoreOne || (mode == Plain && got.config.tabsRestore)) then
                                                            Restore.claim ctx.fs dir

                                                        else
                                                            Task.succeed Nothing

                                                    Nothing ->
                                                        Task.succeed Nothing
                                        in
                                        claiming
                                            |> Task.andThen
                                                (\claimed ->
                                                    when claimed is
                                                        Just c ->
                                                            say got.problems
                                                                |> Task.andThen (\_ -> start ctx.cp ctx.vars given got.problems (restoredConfig c.state got.config) { dir = stateDir, claimed = Just c })

                                                        Nothing ->
                                                            if mode == RestoreOne then
                                                                -- none waits: nothing to open
                                                                Task.succeed {}

                                                            else if listing then
                                                                hostList ctx.cp ctx.fs ctx.vars given asked got

                                                            else
                                                            when chosen.config is
                                                                Err why ->
                                                                    Task.fail why

                                                                Ok config ->
                                                                    say (got.problems ++ chosen.problems)
                                                                        |> Task.andThen (\_ -> start ctx.cp ctx.vars given (got.problems ++ chosen.problems) config { dir = stateDir, claimed = Nothing })
                                                )
                                    )
                                |> Task.mapError (\why -> Argparse.Program.ExitMessageValue { message = "puritty: " ++ why, value = 2 })
                    }


{-| How a window's tabs are kept to restore (docs/tabs.md TB10): the
state directory, none for a window that is not kept, and the saved window
this one opens again, if it does. -}
type alias Restoring =
    { dir : Maybe Path.Path
    , claimed : Maybe { window : Restore.Window, state : RestoreFile.State }
    }


{-| The settings a restored window starts with: its host's session, as
`--host` gives, and its size. -}
restoredConfig : RestoreFile.State -> Config -> Config
restoredConfig state config =
    let
        base =
            when state.host is
                Just name ->
                    Hosts.session config
                        (if Array.any (\h -> h.name == name) config.hosts then
                            Hosts.named name config

                         else
                            Hosts.quick name |> Maybe.withDefault (Hosts.named name config)
                        )

                Nothing ->
                    config
    in
    { base | columns = clamp 10 1000 state.columns, rows = clamp 3 1000 state.rows }


{-| What the window runs (`docs/settings.md` ST11, V64): a program on the
command line, else what the first word or `--host` asked, else what
`start` says. A host's session takes its look and title (`Hosts.session`),
under `--title` when one is given. -}
choose : Mode -> { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String } -> Config -> { config : Result String Config, problems : Array String }
choose mode asked config =
    let
        titled c =
            { c | title = Maybe.withDefault c.title asked.title }

        to h =
            { config = Ok (titled (Hosts.session config h)), problems = [] }
    in
    if not (Array.isEmpty asked.program) then
        { config = Ok config, problems = [] }

    else
        when mode is
            Shell ->
                { config = Ok config, problems = [] }

            Ssh target ->
                when Hosts.quick target is
                    Just h ->
                        to h

                    Nothing ->
                        { config = Err ("\"" ++ target ++ "\" is not where to connect, as user@host:port"), problems = [] }

            Plain ->
                when asked.host is
                    Just name ->
                        to (Hosts.named name config)

                    Nothing ->
                        if String.startsWith "host:" config.start then
                            to (Hosts.named (String.dropFirst 5 config.start) config)

                        else
                            { config = Ok config, problems = [] }

            HostList ->
                { config = Ok config, problems = [] }

            RestoreOne ->
                -- only a claimed window starts, from its own settings
                { config = Ok config, problems = [] }


{-| The host list (V64, V65): the settings window on its Hosts page, whose
Connect makes the same window the host's session, its font the host's. -}
hostList : Process.Permission -> File.Permission -> Dict String String -> Given -> { config : Maybe Path.Path, title : Maybe String, host : Maybe String, program : Array String } -> { config : Config, problems : Array String } -> Task String {}
hostList cp fs vars given asked got =
    SettingsProgram.run { fs = fs, vars = vars, config = asked.config, launcher = True, opener = Nothing }
        |> Task.andThen
            (\outcome ->
                when outcome is
                    SettingsProgram.Closed ->
                        Task.succeed {}

                    SettingsProgram.Session h ->
                        let
                            config =
                                (\c -> { c | title = Maybe.withDefault c.title asked.title }) (Hosts.session got.config h)
                        in
                        Platform.locale vars
                            |> Task.andThen
                                (\locale ->
                                    Window.setFont { font = config.font, lang = Maybe.withDefault locale.language config.language, points = config.points, glyphCap = config.glyphCacheMb * 1024 * 1024 }
                                        |> Task.andThen
                                            (\done ->
                                                when done is
                                                    Ok cell ->
                                                        -- the host list's window, the settings
                                                        -- window's shape, becomes a terminal's:
                                                        -- the session's size (SG11)
                                                        Window.resize { cols = config.columns, rows = config.rows }
                                                            |> Task.andThen (\_ -> Text.ligatures config.ligatures)
                                                            |> Task.andThen (\_ -> begin cp vars given got.problems locale config cell { dir = Nothing, claimed = Nothing })

                                                    Err why ->
                                                        Task.fail ("cannot open the host's font: " ++ why)
                                            )
                                )
            )


start : Process.Permission -> Dict String String -> Given -> Array String -> Config -> Restoring -> Task String {}
start cp vars given problems config restoring =
    Platform.locale vars
        |> Task.andThen (\locale -> startIn cp vars given problems locale config restoring)


startIn : Process.Permission -> Dict String String -> Given -> Array String -> Platform.Locale -> Config -> Restoring -> Task String {}
startIn cp vars given problems locale config restoring =
    Window.open
        { cols = config.columns
        , rows = config.rows
        , font = config.font
        , points = config.points
        , lang = Maybe.withDefault locale.language config.language
        , glyphCap = config.glyphCacheMb * 1024 * 1024
        , title = config.title
        }
        |> Task.andThen
            (\opened ->
                when opened is
                    Err why ->
                        Task.fail ("cannot open the window: " ++ why)

                    Ok cell ->
                        Text.ligatures config.ligatures
                            |> Task.andThen (\_ -> begin cp vars given problems locale config cell restoring)
            )


{-| A session in the window, open with this cell: the program started on a
terminal of its size, and the loop. -}
begin : Process.Permission -> Dict String String -> Given -> Array String -> Platform.Locale -> Config -> Window.Cell -> Restoring -> Task String {}
begin cp vars given problems locale config cell restoring =
                        let
                            -- the command, or the platform's programs, the
                            -- first of them that starts
                            commands =
                                if Array.isEmpty config.command then
                                    Array.map (\program -> [ program ]) (Platform.programs vars)

                                else
                                    [ config.command ]

                            options =
                                -- the pty's IUTF8 says whether the program's bytes are UTF-8;
                                -- a restored local tab in its directory (TB10)
                                Process.defaultSpawnOptions (Terminal { columns = config.columns, rows = config.rows, utf8 = charset == Charset.Utf8 })
                                    |> (\o -> { o | workingDirectory = firstDirectory restoring })

                            charset =
                                Charset.fromName (Maybe.withDefault locale.charset config.charset)
                        in
                        Task.map2 (\events self -> { events = events, self = self })
                            (watchSettings given)
                            (Os.Env.executable |> Task.map Just |> Task.onError (\_ -> Task.succeed Nothing))
                            |> Task.andThen
                                (\w ->
                                    let
                                        opener =
                                            Maybe.map
                                                (\self ->
                                                    { cp = cp
                                                    , program = Path.toString self
                                                    , args =
                                                        when given.file is
                                                            Just f ->
                                                                if f.required then [ "settings", "--config", Path.toString f.path ] else [ "settings" ]

                                                            Nothing ->
                                                                [ "settings" ]
                                                    }
                                                )
                                                w.self
                                    in
                                    (when config.remote is
                                        Just host ->
                                            sshBackend vars config charset host

                                        Nothing ->
                                            spawnFirst cp commands { options | environmentVariables = Process.MergeWithEnvironmentVariables (Dict.set "COLORTERM" "truecolor" (Dict.set "TERM" "xterm-256color" Dict.empty)) }
                                                |> Task.mapError Os.Error.toString
                                                |> Task.andThen
                                                    (\child ->
                                                        when Backend.pty child is
                                                            Nothing ->
                                                                Task.fail "the program has no terminal"

                                                            Just remote ->
                                                                Task.succeed { remote = remote, problems = [] }
                                                    )
                                    )
                                        |> Task.andThen
                                            (\started ->
                                                let
                                                    -- how a new tab starts (docs/tabs.md TB1): the
                                                    -- program at the window's size, or another
                                                    -- session to the host
                                                    localCharset =
                                                        Charset.fromName (Maybe.withDefault locale.charset config.charset)

                                                    starter =
                                                        { local =
                                                            \size ->
                                                                spawnFirst cp commands
                                                                    (Process.defaultSpawnOptions (Terminal { columns = size.columns, rows = size.rows, utf8 = localCharset == Charset.Utf8 })
                                                                        |> (\o -> { o | workingDirectory = size.directory, environmentVariables = Process.MergeWithEnvironmentVariables (Dict.set "COLORTERM" "truecolor" (Dict.set "TERM" "xterm-256color" Dict.empty)) })
                                                                    )
                                                                    |> Task.mapError Os.Error.toString
                                                                    |> Task.andThen
                                                                        (\child ->
                                                                            when Backend.pty child is
                                                                                Nothing ->
                                                                                    Task.fail "the program has no terminal"

                                                                                Just remote ->
                                                                                    Task.succeed remote
                                                                        )
                                                        , ssh = \host -> sshBackend vars config charset host |> Task.map .remote
                                                        , charset = localCharset
                                                        }
                                                in
                                                run (Dict.member "PURITTY_IME_LOG" vars) (Dict.get "PURITTY_SHOT" vars) charset config cell started.remote starter { given = given, locale = locale, events = w.events, at = -1 } (problems ++ started.problems) opener restoring (Platform.logDirectory vars)
                                            )
                                )


{-| The built-in ssh client's session to a host (`docs/ssh-client.md`
SC18): its options from `~/.ssh/config` with the host entry's over them,
the home, the local user and the agent's socket from the environment. -}
sshBackend : Dict String String -> Config -> Charset -> Config.Host -> Task String { remote : Backend, problems : Array String }
sshBackend vars config charset host =
    Task.map2 (\net fs -> { net = net, fs = fs }) Net.initialize File.initialize
        |> Task.andThen
            (\permissions ->
                let
                    home =
                        Dict.get "HOME" vars |> Maybe.withDefault (Dict.get "USERPROFILE" vars |> Maybe.withDefault "")

                    localUser =
                        Dict.get "USER" vars |> Maybe.withDefault (Dict.get "USERNAME" vars |> Maybe.withDefault "")
                in
                SshAgents.agents vars
                    |> Task.andThen
                        (\agents ->
                Session.optionsFor permissions
                    { host = host.host
                    , user = host.user
                    , port = host.port
                    , identity = host.identity
                    , jump = Hosts.jumpSpec config host
                    , command = host.command
                    , home = home
                    , localUser = localUser
                    , agents = agents
                    , terminal = Just { term = "xterm-256color", columns = config.columns, rows = config.rows, utf8 = charset == Charset.Utf8 }
                    }
                    |> Task.andThen
                        (\resolved ->
                            Backend.ssh permissions { options = resolved.options, jumps = resolved.jumps }
                                |> Task.map (\remote -> { remote = remote, problems = Array.map (\p -> "~/.ssh/config: " ++ p) resolved.problems })
                        )
                        )
            )


{-| The first of the commands that starts: one that is not found gives way
to the next, and the last one's failure is the answer. -}
spawnFirst : Process.Permission -> Array (Array String) -> Process.SpawnOptions -> Task Os.Error.Error Process.Child
spawnFirst cp commands options =
    when Array.popFirst commands is
        Nothing ->
            Task.fail { kind = Os.Error.NotFound, operation = "spawn", path = Nothing, detail = "no program to run" }

        Just { first, rest } ->
            Process.spawn cp (Maybe.withDefault "" (Array.first first)) (Array.dropFirst 1 first) options
                |> Task.onError
                    (\err ->
                        if err.kind == Os.Error.NotFound && not (Array.isEmpty rest) then
                            spawnFirst cp rest options

                        else
                            Task.fail err
                    )


{-| `imeLog`: with `PURITTY_IME_LOG` set, each commit and each change to
the preedit is written to standard output, for the IME gate
(`harness/ime.py`, V45). `shotPath`: with `PURITTY_SHOT` set, each frame
drawn is written to its file as a picture, for the reload gate
(`harness/reload.py`). -}
run : Bool -> Maybe String -> Charset -> Config -> Window.Cell -> Backend -> Starter -> Settings -> Array String -> Maybe { cp : Process.Permission, program : String, args : Array String } -> Restoring -> Maybe String -> Task String {}
run imeLog shotPath charset config cell remote starter settings problems opener restoring logDir =
            -- puritty's own text (its questions, the search bar, the tab
            -- bar) in the interface font, as the settings window's is, apart
            -- from the terminal's (docs/tabs.md TB5)
            Text.interfaceFont Platform.interfaceFont
                -- the system menu's items, where the platform has one (ST26)
                |> Task.andThen (\_ -> Window.systemMenu (Array.map .label (menuItems config)))
                |> Task.andThen (\_ -> now)
                |> Task.andThen
                    (\t0 ->
                        restoreInto restoring
                            { config = config
                            , look = { foreground = config.foreground, background = config.background, boldIsBright = config.boldIsBright }
                            , term =
                                Vt.new
                                    { cols = config.columns
                                    , rows = config.rows
                                    , scrollbackBytes = Vt.scrollbackBytesFor { cols = config.columns, rows = config.scrollbackLines }
                                    , pageRows = Vt.defaultPageRows
                                    , checksums = False
                                    , cellWidth = cell.width
                                    , cellHeight = cell.height
                                    }
                                    |> Vt.withPalette config.palette
                                    |> Vt.withEmbedder (embedderOf config)
                                    -- what was wrong in the settings, before the
                                    -- program's first output (settings-ui.md §5)
                                    |> Vt.feed (Bytes.fromString (String.join "" (Array.map notice problems)))
                            , shadow = View.shadow config.columns config.rows
                            , focus = View.focused
                            , last = t0
                            , pending = -1
                            , urgent = True
                            , blinkAt = -1
                            , syncSince = -1
                            , title = ""
                            , closed = False
                            , lost = False
                            , out = Outbox.empty
                            , preedit = { points = [], feedback = [], caret = 0 }
                            , imeLog = imeLog
                            , points = config.points
                            , charset = charset
                            , decoder = Charset.decoder
                            , replaced = 0
                            , held = 0
                            , mouseLast = Nothing
                            , allMotion = False
                            , pointerShown = Window.TextPointer
                            , hover = Nothing
                            , shiftHeld = False
                            , back = 0
                            , selection = Nothing
                            , clicks = { at = -1000, count = 0, cell = { row = 0, col = 0 } }
                            , toOwn = Nothing
                            , wordBoundaries = Array.map Char.toCode (String.toArray config.wordBoundaries)
                            , toPaste = Nothing
                            , pasting = Nothing
                            , clips = []
                            , clipRead = Nothing
                            , settings = settings
                            , shotPath = shotPath
                            , troubles = problems
                            , settingsWindow = opener
                            , menu = Nothing
                            , shownItems = []
                            , ssh =
                                Maybe.map
                                    (\h -> { host = h.name, lines = [], asking = Nothing, started = False, failed = Nothing, exitStatus = Nothing })
                                    config.remote
                            , tmux = TmuxMode.setLook (config.tmuxLook == "tmux") (TmuxMode.setBar (config.tmuxTabs == "top") (TmuxMode.idle {}))
                            , overlaid = False
                            , search = Nothing
                            , barDrag = False
                            , remote = remote
                            , tab = { id = 0, name = "", host = config.remote, hostName = config.hostName, color = HostsColor, bells = 0, bell = False, activity = False }
                            , tabs = Builder.empty 4
                            , order = [ 0 ]
                            , nextTabId = 1
                            , starter = starter
                            , windowRows = config.rows
                            , renaming = Nothing
                            , coloring = Nothing
                            , closing = Nothing
                            , barClick = { at = -1000, id = -1 }
                            , saving = { dir = restoring.dir, window = Nothing, written = "", at = -1 }
                            , byButton = False
                            , quietUntil = -1
                            , closedTabs = Builder.empty closedSlots
                            , diag = Diag.off
                            , logDir = logDir
                            , turnMs = t0
                            , loggedTab = -1
                            }
                            |> Task.mapError Os.Error.toString
                    )
                |> Task.andThen (\m -> finish m.remote m)


{-| The end: the program's exit status when it ended, 0 when the window
was closed, after asking the program to end. -}
finish : Backend -> (taken m0 : Model) -> Task String {}
finish remote m0 =
    savedAtEnd m0
        |> Task.andThen (\m -> writeLog True (logLine "end" (if m.lost then "the window was lost" else "the window ended") m))
        |> Task.mapError Os.Error.toString
        |> Task.andThen (\m -> finishTabs remote m)


{-| What becomes of the window's saved tabs as it ends (docs/tabs.md
TB10). A window lost, as at logout, keeps them, saved once more. One
closed by its button keeps them only when no other window is open, since
closing the last is quitting. One whose last tab ended forgets them. -}
savedAtEnd : (taken m : Model) -> Task Error Model
savedAtEnd m =
    when { dir = m.saving.dir, window = m.saving.window } is
        { dir = Just dir, window = Just w } ->
            let
                fs =
                    m.settings.given.fs
            in
            if m.lost then
                saveNow 0 m

            else if m.byButton then
                Restore.others fs dir w
                    |> Task.andThen (\open -> if open then Restore.forget fs dir w |> Task.map (\_ -> m) else saveNow 0 m)

            else
                Restore.forget fs dir w |> Task.map (\_ -> m)

        _ ->
            Task.succeed m


finishTabs : Backend -> Model -> Task String {}
finishTabs remote m =
    let
        -- the other tabs' programs ended first (docs/tabs.md TB2)
        others =
            remotesOf m

        ending =
            { lost = m.lost, closed = m.closed, ssh = m.ssh }
    in
    Array.foldl (\r done -> done |> Task.andThen (\_ -> r.kill)) (Task.succeed {}) others
        |> Task.andThen (\_ -> finishShown remote ending)


finishShown : Backend -> { lost : Bool, closed : Bool, ssh : Maybe SshScreen } -> Task String {}
finishShown remote m =
    if m.lost then
        remote.kill |> Task.andThen (\_ -> Task.fail "the window is lost")

    else if m.closed then
        remote.kill
            |> Task.andThen
                (\_ ->
                    Os.Env.exitWithCode
                        (m.ssh |> Maybe.andThen .exitStatus |> Maybe.withDefault 0)
                )

    else
        remote.waitForExit
            |> Task.andThen
                (\code ->
                    Os.Env.exitWithCode
                        (if code < 0 then
                            1

                         else
                            code
                        )
                )


syncHeld : Vt.Term -> Bool
syncHeld t =
    Dict.get 2026 t.modes == Just True


blinking : Model -> Bool
blinking m =
    m.config.blinkMs > 0 && m.focus.focused && m.term.showCursor && Dict.get 12 m.term.modes == Just True


{-| When the next frame is due, or -1 for none waiting. -}
frameAt : Model -> Int
frameAt m =
    if m.pending < 0 && not m.urgent then
        -1

    else if syncHeld m.term && m.syncSince >= 0 then
        m.syncSince + m.config.syncTimeoutMs

    else if m.urgent then
        0

    else
        m.last + m.config.frameMs


{-| The time the timer branch waits for: the frame's, or the blink's. -}
nextAt : Model -> Int
nextAt m =
    let
        f =
            frameAt m

        b =
            if blinking m then
                m.blinkAt

            else
                -1
    in
    soonest (soonest (soonest (soonest (soonest (soonest f b) m.settings.at) (TmuxMode.dueAt m.tmux)) m.saving.at) (closedDue m)) (Diag.due m.diag)


{-| The sooner of two times, -1 standing for none. -}
soonest : Int -> Int -> Int
soonest a b =
    if a < 0 then
        b

    else if b < 0 then
        a

    else
        min a b


{-| What the program is sent, queued: keys, replies, focus reports, a
paste. The pty takes what it takes; the rest waits for `File.writable`, which
the loop races beside its read, so a program that stops reading until its
output is read never holds the window (V48, geng-lang D1049). -}
send : Bytes -> (taken m : Model) -> Model
send text m =
    if TmuxMode.isOn m.tmux then
        -- under tmux control mode, to the active pane (docs/tmux.md TM14)
        let
            k =
                TmuxMode.keys text m.tmux
        in
        sendCommands k.commands { m | tmux = k.state }

    else
        sendPty text m


{-| A typed key sent: under tmux control mode through the client's key
table, so that tmux's prefix and bindings work (docs/tmux.md TM23). -}
sendKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bytes -> Int -> (taken m : Model) -> Model
sendKey k bytes ms m =
    if TmuxMode.isOn m.tmux then
        let
            r =
                TmuxMode.typed k bytes ms m.tmux
        in
        sendCommands r.commands { m | tmux = r.state }

    else
        sendPty bytes m


sendPty : Bytes -> (taken m : Model) -> Model
sendPty text m =
    let
        -- in the pane's character set (cjk-and-thai.md §10.3, V49); what
        -- it cannot send goes as `?`, counted and shown in the title. A
        -- legacy mouse report's bytes are raw and will skip this.
        encoded =
            Charset.encode m.charset text

        bytes =
            encoded.bytes
    in
    { m | out = Outbox.push bytes m.out, replaced = m.replaced + encoded.replaced }


{-| Bytes queued as they are, in no character set: a mouse report, whose
legacy forms are raw bytes. -}
sendRaw : Bytes -> (taken m : Model) -> Model
sendRaw bytes m =
    { m | out = Outbox.push bytes m.out }


{-| What puritty says of itself to the core (`Vt.Embedder`,
`docs/tmux.md` TM4): the look's colors, which OSC 10 and 11 answer and
DSR 996 judges; DA1 with 21 (left and right margins) and 52 (OSC 52), which
tmux turns its `margins` and `clipboard` on from; and XTVERSION with a
version, as tmux matches a name followed by a space. -}
embedderOf : Config -> Vt.Embedder
embedderOf config =
    { look = Just { foreground = config.foreground, background = config.background }
    , attributes = "\u{001B}[?62;21;22;52c"
    , version = "puritty 0.1.0"
    }


{-| The queue written as far as the pty takes it. -}
flush : Backend -> (taken m : Model) -> Task Error Model
flush remote m =
    if Outbox.isEmpty m.out then
        Task.succeed m

    else
        let
            next =
                Outbox.offer m.out
        in
        remote.writeSome next.bytes
            |> Task.map (\n -> { m | out = Outbox.written n next.outbox })


{-| A window that restores (docs/tabs.md TB10) opens its saved tabs, with
their names and colors, and shows the one that was shown; then, when
another saved window waits, `puritty restore` is started for it, which
starts the next in turn. A window that saves without restoring makes its
files. Then the loop. -}
restoreInto : Restoring -> (taken m : Model) -> Task Error Model
restoreInto restoring m =
    let
        fs =
            m.settings.given.fs
    in
    (when restoring.claimed is
        Just c ->
            let
                first =
                    Array.first c.state.tabs |> Maybe.withDefault { name = "", color = HostsColor, directory = Nothing }

                info =
                    m.tab

                named =
                    { m | tab = { info | name = first.name, color = first.color }, saving = { dir = restoring.dir, window = Just c.window, written = "", at = 0 }, quietUntil = m.last + 3000 }

                shownId =
                    -- ids are given in order from 0, so the saved order's
                    -- place is the id
                    clamp 0 (Array.length c.state.tabs - 1) c.state.shown
            in
            Array.foldl
                (\t acc -> acc |> Task.andThen (openTabWith { directory = Just (Maybe.map Path.fromString t.directory), name = t.name, color = t.color, kept = Nothing }))
                (Task.succeed named)
                (Array.dropFirst 1 c.state.tabs)
                |> Task.map (\opened -> showTab shownId opened)
                |> Task.andThen
                    (\shown ->
                        when restoring.dir is
                            Just dir ->
                                Restore.waiting fs dir
                                    |> Task.andThen (\more -> if more then spawnSelf [ "restore" ] shown else Task.succeed shown)

                            Nothing ->
                                Task.succeed shown
                    )

        Nothing ->
            startSaving m
    )
        |> Task.andThen (\next -> barFirst next.remote next)


{-| This window's files made, when its tabs are to be restored and it has
none yet; a failure leaves it unsaved, and says so on standard error. -}
startSaving : (taken m : Model) -> Task Error Model
startSaving m =
    when m.saving.dir is
        Just dir ->
            if m.config.tabsRestore && not (Maybe.isJust m.saving.window) then
                Restore.fresh m.settings.given.fs dir
                    |> Task.map Ok
                    |> Task.onError (\e -> Task.succeed (Err e))
                    |> Task.andThen
                        (\made ->
                            when made is
                                Ok w ->
                                    Task.succeed { m | saving = { dir = Just dir, window = Just w, written = "", at = 0 } }

                                Err e ->
                                    Console.writeErr ("puritty: the tabs cannot be saved to restore them: " ++ Os.Error.toString e ++ "\n") |> Task.map (\_ -> m)
                        )

            else
                Task.succeed m

        Nothing ->
            Task.succeed m


{-| Where the first tab of a restored local window starts. -}
firstDirectory : Restoring -> Maybe Path.Path
firstDirectory restoring =
    restoring.claimed
        |> Maybe.andThen (\c -> if c.state.host == Nothing then Array.first c.state.tabs else Nothing)
        |> Maybe.andThen .directory
        |> Maybe.map Path.fromString


{-| The window's tabs saved when five seconds have passed since the last
look, and only when they changed (docs/tabs.md TB10): the shown tab's
directory and the others' are read each time, so a `cd` is kept too. -}
saveIfDue : Int -> (taken m : Model) -> Task Error Model
saveIfDue ms m =
    if m.saving.at < 0 || ms < m.saving.at then
        Task.succeed m

    else
        saveNow ms m


saveNow : Int -> (taken m : Model) -> Task Error Model
saveNow ms m =
    let
        saving =
            m.saving

        fs =
            m.settings.given.fs
    in
    when { dir = saving.dir, window = saving.window } is
        { dir = Just dir, window = Just w } ->
            stateOf m
                |> Task.andThen
                    (\state ->
                        let
                            text =
                                RestoreFile.encode state
                        in
                        (if text == saving.written then
                            Task.succeed saving.written

                         else
                            Restore.save fs dir w text
                                |> Task.map (\_ -> text)
                                |> Task.onError (\_ -> Task.succeed saving.written)
                        )
                    )
                |> Task.andThen (\written -> Task.succeed { m | saving = { saving | written = written, at = ms + 5000 } })

        _ ->
            Task.succeed m


{-| The window as it is saved: its host, its size, which tab is shown,
and each tab's name, color and, in a local window, directory. -}
stateOf : Model -> Task Error RestoreFile.State
stateOf m =
    let
        -- the tab's own host name, which a settings reload does not
        -- change as it changes `config` (the window's tabs are all one
        -- host's, or all local)
        local =
            m.tab.hostName == Nothing

        header =
            { host = m.tab.hostName, columns = m.term.cols, rows = m.windowRows, shown = shownAt m }

        directoryOf remote =
            if local then
                remote.directory |> Task.map (Maybe.map Path.toString) |> Task.onError (\_ -> Task.succeed Nothing)

            else
                Task.succeed Nothing
    in
    Array.foldl
        (\t acc -> acc |> Task.andThen (\soFar -> directoryOf t.remote |> Task.map (\d -> Array.pushLast { name = t.name, color = t.color, directory = d } soFar)))
        (Task.succeed [])
        (savedTabsOf m)
        |> Task.map (\tabs -> { host = header.host, columns = header.columns, rows = header.rows, shown = header.shown, tabs = tabs })


{-| Each tab in the bar's order: its name, its color, its backend. -}
savedTabsOf : Model -> Array { name : String, color : TabColor, remote : Backend }
savedTabsOf m =
    let
        hidden =
            savedHidden 0 m []

        shown =
            { name = m.tab.name, color = m.tab.color, remote = m.remote }

        shownId =
            m.tab.id
    in
    Array.mapAndKeepJust
        (\id ->
            if id == shownId then
                Just shown

            else
                Array.findFirst (\h -> h.id == id) hidden |> Maybe.map (\f -> { name = f.value.name, color = f.value.color, remote = f.value.remote })
        )
        m.order


{-| What saving needs of each tab not shown. -}
savedHidden : Int -> Model -> Array { id : Int, name : String, color : TabColor, remote : Backend } -> Array { id : Int, name : String, color : TabColor, remote : Backend }
savedHidden i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        savedHidden (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { id = t.info.id, name = t.info.name, color = t.info.color, remote = t.remote } acc

                Nothing ->
                    acc
            )


{-| The loop, with the first tab's terminal a row shorter when the bar
is shown from the start (`[tabs] bar = "always"`). -}
barFirst : Backend -> (taken m : Model) -> Task Error Model
barFirst remote m =
    (if barRows m > 0 then
        relayout m.term.cols m

     else
        Task.succeed m
    )
        -- the diagnostic log begun, when the settings ask for it
        |> Task.andThen (logTurned False)
        |> Task.andThen (loop remote)


loop : Backend -> (taken m00 : Model) -> Task Error Model
loop remote m00 =
    let
        -- every motion from X only while the program asks for any motion
        -- (mode 1003, docs/phase3-select.md §4), or while there is
        -- something the pointer's shape tells of (`hoverShapes`)
        all =
            (Vt.mouseModes m00.term).tracking == Mouse.any || hoverShapes m00
    in
    (if all == m00.allMotion then
        Task.succeed m00

     else
        Window.motion all |> Task.map (\_ -> { m00 | allMotion = all })
    )
        |> Task.andThen pointerShape
        |> Task.andThen clipboardRequests
        |> Task.andThen (writeLog False)
        |> Task.andThen (flush remote)
        |> Task.andThen (\m0 -> race remote m0)


{-| The pointer's shape (docs/phase3-select.md §21): the arrow while the
program takes the mouse and Shift is not held to take it back, the I-beam
otherwise, as Alacritty and Ghostty show them. Over what a press would
drag or click it says so (docs/tmux.md TM38): under tmux control mode the
lines between panes and a floating pane's edges (`TmuxMode.pointerShape`),
and the arrow over the tab bar, the scroll bar, a menu and a question. The
window is told only when it changes. -}
pointerShape : (taken m : Model) -> Task Error Model
pointerShape m =
    let
        program =
            if (Vt.mouseModes m.term).tracking /= Mouse.none && not m.shiftHeld then
                Window.ArrowPointer

            else
                Window.TextPointer

        shape =
            if m.closing /= Nothing || m.coloring /= Nothing || m.menu /= Nothing then
                Window.ArrowPointer

            else
                when m.hover is
                    Just p ->
                        if m.barDrag || (barRows m > 0 && p.y >= m.term.rows * max 1 p.cellHeight) then
                            Window.ArrowPointer

                        else if barShown m && Dialog.scrollbarHit (overlaySize m) { back = viewBack m, most = Vt.scrollbackRows m.term } { x = p.x, y = p.y } /= Nothing then
                            Window.ArrowPointer

                        else
                            TmuxMode.pointerShape m.shiftHeld p m.tmux |> Maybe.withDefault program

                    Nothing ->
                        program
    in
    if shape == m.pointerShown then
        Task.succeed m

    else
        Window.setPointer shape
            |> Task.map (\_ -> { m | pointerShown = shape })


{-| Whether the pointer's shape can change as it moves with no button held,
so that the window sends every motion: under tmux control mode, with the tab
bar or the scroll bar shown, or a menu or a question up. -}
hoverShapes : Model -> Bool
hoverShapes m =
    TmuxMode.isOn m.tmux || barRows m > 0 || barShown m || m.closing /= Nothing || m.coloring /= Nothing || m.menu /= Nothing


race : Backend -> (taken m0 : Model) -> Task Error Model
race remote m0 =
    now
        |> Task.andThen
            (\ms0 ->
                let
                    m =
                        if blinking m0 && m0.blinkAt < 0 then
                            { m0 | blinkAt = ms0 + m0.config.blinkMs }

                        else
                            m0

                    at =
                        nextAt m

                    timer =
                        if at < 0 then
                            []

                        else
                            [ Sleep.sleep (toFloat (max 0 (at - ms0))) |> Task.map (\_ -> Due) ]

                    writing =
                        if Outbox.isEmpty m.out then
                            []

                        else
                            [ remote.writable |> Task.map (\_ -> Writable) ]

                    following =
                        when m.settings.events is
                            Nothing ->
                                []

                            Just events ->
                                [ Source.next events |> Task.map SettingsChanged ]

                    -- the tabs not shown keep reading, and writing what
                    -- waits for them (docs/tabs.md TB2)
                    behindTabs =
                        Array.mapAndFlatten
                            (\t ->
                                Array.pushFirst (t.remote.read |> Task.map (\incoming -> Behind { id = t.id, incoming = incoming }))
                                    (if t.writing then [ t.remote.writable |> Task.map (\_ -> BehindWritable t.id) ] else [])
                            )
                            (hiddenOf m)
                in
                Task.race (remote.read |> Task.map Read) ([ Window.events |> Task.map Events ] ++ timer ++ writing ++ following ++ behindTabs)
                    |> Task.andThen
                        (\turn ->
                            now
                                |> Task.andThen
                                    (\ms ->
                                        when turn is
                                            Read (Data chunk) ->
                                                if Bytes.length chunk == 0 then
                                                    -- the shown tab's program ended: the tab
                                                    -- closes, and the window with the last
                                                    if tabCount m > 1 then
                                                        remote.waitForExit
                                                            |> Task.mapError (\why -> { kind = Os.Error.Other, operation = "wait", path = Nothing, detail = why })
                                                            |> Task.andThen (\_ -> dropShown m)
                                                            |> Task.andThen (\next -> step next.remote ms next)

                                                    else
                                                        Task.succeed m

                                                else
                                                    feed remote chunk ms m |> Task.andThen (\next -> step remote ms next)

                                            Read (Notice told) ->
                                                if endsSession told m.ssh then
                                                    closeShown (sshNoticed told (logLine "ssh" (sshLine told) { m | turnMs = ms })) |> Task.andThen (\next -> step next.remote ms next)

                                                else
                                                    sshTold told (logLine "ssh" (sshLine told) { m | turnMs = ms }) |> Task.andThen (\next -> step remote ms next)

                                            Events up ->
                                                if not up then
                                                    Task.succeed { m | lost = True }

                                                else
                                                    Window.take
                                                        |> Task.andThen (\evs -> handle remote ms evs m)
                                                        |> Task.andThen (\next -> step remote ms next)

                                            Due ->
                                                reloadIfDue ms (expireClosed ms (blink ms (tmuxTick ms m))) |> Task.andThen (saveIfDue ms) |> Task.andThen (\next -> step next.remote ms next)

                                            Writable ->
                                                step remote ms m

                                            SettingsChanged change ->
                                                step remote ms (noticed ms change m)

                                            Behind b ->
                                                behind b.id b.incoming ms m |> Task.andThen (\next -> step next.remote ms next)

                                            BehindWritable id ->
                                                atTab id (\one -> flush one.remote one) m |> Task.andThen (\next -> step next.remote ms next)
                                    )
                        )
            )


{-| A frame if one is due, then the loop again, unless the window is gone. -}
step : Backend -> Int -> (taken m : Model) -> Task Error Model
step remote ms m0 =
    if m0.closed || m0.lost then
        Task.succeed m0

    else
        let
            m =
                if Diag.isOn m0.diag && m0.tab.id /= m0.loggedTab then
                    { m0 | loggedTab = m0.tab.id, diag = Diag.add ms "tab" ("shown: tab " ++ String.fromInt m0.tab.id ++ " of " ++ String.fromInt (tabCount m0) ++ (if TmuxMode.isOn m0.tmux then ", under tmux -CC" else "")) m0.diag }

                else
                    m0

            at =
                frameAt m
        in
        if at >= 0 && ms >= at then
            draw ms m
                |> Task.andThen shoot
                |> Task.andThen (\next -> if next.lost then Task.succeed next else loop next.remote next)

        else
            loop m.remote m


{-| A change in the settings directory: one to the settings file, or
changes the system dropped, has the file read `reloadDelayMs` later; the
directory gone stops the following. -}
noticed : Int -> Maybe Directory.Change -> (taken m : Model) -> Model
noticed ms change m =
    let
        s =
            m.settings

        ours path =
            when s.given.file is
                Just f ->
                    Path.filename path == Path.filename f.path

                Nothing ->
                    False

        soon =
            { s | at = ms + reloadDelayMs }

        none =
            { s | events = Nothing }
    in
    when change is
        Just (Directory.Added path) ->
            if ours path then { m | settings = soon } else m

        Just (Directory.Changed path) ->
            if ours path then { m | settings = soon } else m

        Just (Directory.Removed path) ->
            if ours path then { m | settings = soon } else m

        Just Directory.Lost ->
            { m | settings = soon }

        Just Directory.Gone ->
            { m | settings = none }

        Nothing ->
            { m | settings = none }


{-| The settings read again once a change's delay is up (docs/settings.md
ST3): applied when they decode, and when they do not, the settings in force
kept and why written to standard error. -}
reloadIfDue : Int -> (taken m : Model) -> Task Error Model
reloadIfDue ms m =
    let
        s =
            m.settings
    in
    if s.at < 0 || ms < s.at then
        Task.succeed m

    else
        readSettings s.given
            |> Task.onError (\why -> Task.succeed (Unread why))
            |> Task.andThen
                (\read ->
                    let
                        quiet =
                            { m | settings = { s | at = -1 } }
                    in
                    when read is
                        Gave r ->
                            say r.problems
                                |> Task.andThen (\_ -> applySettings (forHost quiet r.config) { quiet | troubles = r.problems, urgent = True })

                        Unread why ->
                            let
                                problems =
                                    [ why ++ "; the settings in force are kept" ]
                            in
                            say problems |> Task.map (\_ -> { quiet | troubles = problems, urgent = True })
                )


{-| Settings read again, for this window: a host's window takes its host's
look over them again (its colors, font, charset and title, as
`Hosts.session` gave them at its start), from the host as the new settings
have it, so that a change to the settings keeps the host's look and a
change to the host's look is seen at once. What runs in the window stays:
its program, its ssh client, and a `--title` from the command line. The
host is the shown tab's, as every tab of a host's window is the one host's
(docs/tabs.md TB10). -}
forHost : Model -> Config -> Config
forHost m new =
    when m.tab.hostName is
        Just name ->
            let
                host =
                    if Array.any (\h -> h.name == name) new.hosts then
                        Hosts.named name new

                    else
                        Hosts.quick name |> Maybe.withDefault (Hosts.named name new)

                session =
                    Hosts.session new host
            in
            { session
                | command = m.config.command
                , remote = m.config.remote
                , title = Maybe.withDefault session.title m.settings.given.title
            }

        Nothing ->
            new


{-| Each problem with the settings on standard error. -}
say : Array String -> Task x {}
say problems =
    Array.foldl (\p t -> t |> Task.andThen (\_ -> Console.writeErr ("puritty: " ++ p ++ "\n"))) (Task.succeed {}) problems


{-| A problem with the settings as the terminal shows it before the
program's output: a line in yellow. -}
notice : String -> String
notice problem =
    "\u{001B}[33mpuritty: " ++ problem ++ "\u{001B}[0m\r\n"


{-| New settings applied to the running window (docs/settings.md ST4):
the font opened again for a new family, language or glyph cache, or sized
again for a new size; the colors and the palette, the scrollback's bound,
the charset and the word boundaries changed; every cell drawn again. What
is read where it is used (the blink, the frames, the paste button, OSC 52,
the title) is in `config`. The window's size in cells and the program are
new windows' (V59). A font the system does not have is said on standard
error, and the one in use kept. -}
applySettings : Config -> (taken m : Model) -> Task Error Model
applySettings new m =
    let
        was =
            m.config.tabsRestore
    in
    let
        wasLogging =
            m.config.debugLog
    in
    applyLook new m |> Task.andThen (restoreTurned was) |> Task.andThen (logTurned wasLogging)


-- THE DIAGNOSTIC LOG (docs/diagnostics.md)


{-| `[debug] log` turned on, at the start or while the window runs: a
file begun in the logs folder, the oldest beyond twenty removed; turned
off: the last lines written and the log ended. -}
logTurned : Bool -> (taken m : Model) -> Task Error Model
logTurned was m =
    if m.config.debugLog && not was && not (Diag.isOn m.diag) then
        beginLog m

    else if was && not m.config.debugLog then
        let
            ended =
                logLine "end" "the log was turned off" m
        in
        writeLog True ended |> Task.map (\next -> { next | diag = Diag.off })

    else
        Task.succeed m


beginLog : (taken m : Model) -> Task Error Model
beginLog m =
    when m.logDir is
        Nothing ->
            Task.succeed m

        Just dir ->
            let
                fs =
                    m.settings.given.fs

                folder =
                    Path.fromString dir

                header =
                    logHeader m
            in
            Directory.createAll fs folder
                |> Task.onError (\_ -> Task.succeed {})
                |> Task.andThen (\_ -> pruneLogs fs folder)
                |> Task.andThen (\_ -> Task.map2 (\posix zone -> { posix = posix, zone = zone }) Time.now Time.here)
                |> Task.andThen
                    (\t ->
                        let
                            dayMs =
                                ((Time.toHour t.zone t.posix * 60 + Time.toMinute t.zone t.posix) * 60 + Time.toSecond t.zone t.posix) * 1000 + Time.toMillis t.zone t.posix

                            day =
                                String.padLeft 4 '0' (String.fromInt (Time.toYear t.zone t.posix))
                                    ++ "-"
                                    ++ String.padLeft 2 '0' (String.fromInt (monthNumber (Time.toMonth t.zone t.posix)))
                                    ++ "-"
                                    ++ String.padLeft 2 '0' (String.fromInt (Time.toDay t.zone t.posix))

                            stamp =
                                String.replace ":" "" (String.takeFirst 8 (Diag.clock dayMs))

                            name =
                                "puritty-" ++ day ++ "_" ++ stamp ++ "-" ++ String.padLeft 3 '0' (String.fromInt (modBy 1000 m.turnMs)) ++ ".log"

                            path =
                                dir ++ Platform.pathSeparator ++ name
                        in
                        now
                            |> Task.map
                                (\ms ->
                                    { m
                                        | diag =
                                            Diag.start path
                                                { ms = ms, dayMs = dayMs }
                                                ([ "puritty diagnostic log, begun " ++ day ++ " " ++ Diag.clock dayMs ++ " local time"
                                                 , "file " ++ path
                                                 , "nothing typed, pasted or shown is written: keys by name, pastes and output by size"
                                                 ]
                                                    ++ header
                                                )
                                        , loggedTab = m.tab.id
                                    }
                                )
                    )
                |> Task.andThen (writeLog True)


monthNumber : Time.Month -> Int
monthNumber month =
    when month is
        Time.Jan -> 1
        Time.Feb -> 2
        Time.Mar -> 3
        Time.Apr -> 4
        Time.May -> 5
        Time.Jun -> 6
        Time.Jul -> 7
        Time.Aug -> 8
        Time.Sep -> 9
        Time.Oct -> 10
        Time.Nov -> 11
        Time.Dec -> 12


{-| The logs folder's files beyond the newest nineteen removed, so that
with the new one twenty are kept. Their names sort by time. -}
pruneLogs : File.Permission -> Path.Path -> Task Error {}
pruneLogs fs folder =
    Directory.list fs folder
        |> Task.map
            (\entries ->
                entries
                    |> Array.map .path
                    |> Array.keepIf
                        (\p ->
                            let
                                base =
                                    Path.toString p
                            in
                            String.contains "puritty-" base && String.endsWith ".log" base
                        )
                    |> Array.sortBy Path.toString
            )
        |> Task.andThen
            (\logs ->
                Array.foldl
                    (\p acc -> acc |> Task.andThen (\_ -> File.remove fs p |> Task.onError (\_ -> Task.succeed {})))
                    (Task.succeed {})
                    (Array.dropLast 19 logs)
            )
        |> Task.onError (\_ -> Task.succeed {})


{-| What the log says of the window as it begins. -}
logHeader : Model -> Array String
logHeader m =
    [ (embedderOf m.config).version ++ " on " ++ (if Platform.pathSeparator == "\\" then "Windows" else "Linux")
    , "window " ++ String.fromInt m.term.cols ++ "x" ++ String.fromInt m.windowRows ++ " cells, " ++ String.fromInt (tabCount m) ++ " tabs"
    , "paste button " ++ (if m.config.pasteButton == 2 then "right" else "middle") ++ ", tmux look " ++ m.config.tmuxLook ++ ", tmux tabs " ++ m.config.tmuxTabs
    ]
        ++ windowState m


{-| A line, at this turn's time. -}
logLine : String -> String -> (taken m : Model) -> Model
logLine tag text m =
    { m | diag = Diag.add m.turnMs tag text m.diag }


{-| The waiting lines appended to the file, when they are due or `now`
says so; a file that cannot be written loses them, said on the next. -}
writeLog : Bool -> (taken m : Model) -> Task Error Model
writeLog force m0 =
    if Diag.isOn m0.diag && (force || Diag.due m0.diag >= 0) then
        now
            |> Task.andThen
                (\ms ->
                    let
                        dueAt =
                            Diag.due m0.diag
                    in
                    if dueAt < 0 || (not force && ms < dueAt) then
                        Task.succeed m0

                    else
                        let
                            taken =
                                Diag.take ms m0.diag

                            m =
                                { m0 | diag = taken.log }
                        in
                        when taken.path is
                            Just path ->
                                File.appendFile m.settings.given.fs taken.bytes (Path.fromString path)
                                    |> Task.map (\_ -> Nothing)
                                    |> Task.onError (\e -> Task.succeed (Just (Os.Error.toString e)))
                                    |> Task.map
                                        (\problem ->
                                            when problem is
                                                Nothing ->
                                                    m

                                                Just why ->
                                                    logLine "error" ("the log could not be written: " ++ why) m
                                        )

                            Nothing ->
                                Task.succeed m
                )

    else
        Task.succeed m0


{-| A mark in the log (`[keys] mark_log`, the menu): its number, and the
window's state as it is, written at once. -}
markLog : (taken m : Model) -> Task Error Model
markLog m =
    let
        counted =
            Diag.nextMark m.diag

        withCount =
            { m | diag = counted.log }

        n =
            String.fromInt counted.number

        lines =
            [ "==================== MARK " ++ n ++ " ====================" ]
                ++ windowState withCount
                ++ TmuxMode.diagnose withCount.tmux
                ++ [ "==================== END OF MARK " ++ n ++ " =============" ]
    in
    writeLog True { withCount | diag = Diag.addAll withCount.turnMs "mark" lines withCount.diag }


{-| The window's state for a mark: what decides where keys, pastes and the
mouse go, and what waits. -}
windowState : Model -> Array String
windowState m =
    let
        yes b =
            if b then "on" else "off"

        modes =
            m.term.modes
    in
    [ "tab " ++ String.fromInt m.tab.id ++ " shown of " ++ String.fromInt (tabCount m) ++ ", " ++ (when m.tab.hostName is
            Just h -> "host " ++ h
            Nothing -> "no host")
    , "focus " ++ yes m.focus.focused ++ ", buttons held " ++ String.fromInt m.held ++ ", shift " ++ yes m.shiftHeld
    , "paste asked " ++ yes (m.toPaste /= Nothing) ++ ", paste under way " ++ (when m.pasting is
            Just b -> "yes, " ++ (if b then "bracketed" else "plain")
            Nothing -> "no")
    , "waiting to be sent " ++ String.fromInt (Outbox.size m.out) ++ " bytes"
    , "terminal: paste-brackets " ++ yes (Dict.get 2004 modes == Just True) ++ ", focus-reports " ++ yes (Dict.get 1004 modes == Just True) ++ ", mouse " ++ yes ((Vt.mouseModes m.term).tracking /= Mouse.none) ++ ", alt-screen " ++ yes m.term.alt ++ ", view scrolled back " ++ String.fromInt m.back
    , "open: " ++ (when Array.keepIf (\x -> x /= "")
            [ if m.menu /= Nothing then "a menu" else ""
            , if m.renaming /= Nothing then "the rename box" else ""
            , if m.coloring /= Nothing then "the color box" else ""
            , if m.closing /= Nothing then "the close question" else ""
            , if m.search /= Nothing then "the search bar" else ""
            , if m.selection /= Nothing then "a selection" else ""
            ] is
                [] -> "nothing"
                open -> String.join ", " open)
    , "ssh: " ++ (when m.ssh is
            Just screen -> "to " ++ screen.host ++ (if screen.started then ", started" else ", not started") ++ (if screen.asking /= Nothing then ", asking a question" else "") ++ (when screen.failed is
                Just why -> ", failed: " ++ why
                Nothing -> "")
            Nothing -> "none")
    ]


{-| A window event as the log says it, `Nothing` for those it leaves out
(the pointer's motions, a key's release, the preedit as it changes). -}
eventLine : Window.Event -> Maybe { tag : String, text : String }
eventLine ev =
    when ev is
        Window.Key k ->
            Maybe.map (\t -> { tag = "key", text = t }) (Diag.key k)

        Window.Pointer p ->
            Maybe.map (\t -> { tag = "mouse", text = t }) (Diag.pointer p)

        Window.Resized r ->
            Just { tag = "window", text = "size " ++ String.fromInt r.cols ++ "x" ++ String.fromInt r.rows }

        Window.Rescaled c ->
            Just { tag = "window", text = "cell " ++ String.fromInt c.width ++ "x" ++ String.fromInt c.height ++ " (another monitor's scale)" }

        Window.Focus on ->
            Just { tag = "window", text = if on then "focus in" else "focus out" }

        Window.Close ->
            Just { tag = "window", text = "close asked" }

        Window.Commit text ->
            Just { tag = "ime", text = "commit " ++ String.fromInt (String.count (Bytes.toStringLossy text)) ++ " characters" }

        Window.PreeditDone ->
            Just { tag = "ime", text = "preedit done" }

        Window.ImeReady ->
            Just { tag = "ime", text = "ready" }

        Window.SelectionLost _ ->
            Just { tag = "select", text = "the selection was taken by another program" }

        Window.Pasted more ->
            Just { tag = "paste", text = "text came" ++ (if more then ", more to come" else "") }

        Window.MenuChosen c ->
            Just { tag = "menu", text = "chosen: menu " ++ String.fromInt c.menu ++ " item " ++ String.fromInt c.index }

        _ ->
            Nothing


{-| What the ssh session said, as the log says it. -}
sshLine : Session.Notice -> String
sshLine n =
    when n is
        Session.Status st ->
            "status " ++ st

        Session.Asking _ ->
            "asks a question"

        Session.Banner b ->
            "banner, " ++ String.fromInt (String.count b) ++ " characters"

        Session.Started ->
            "the session started"

        Session.Output b ->
            "output " ++ String.fromInt (Bytes.length b) ++ " bytes"

        Session.Exited code ->
            "the program exited, status " ++ String.fromInt code

        Session.Failed why ->
            "failed: " ++ why

        Session.Ended ->
            "ended"


{-| tmux commands written, each a line in the log (redacted, `Diag.command`). -}
sendCommands : Array String -> (taken m : Model) -> Model
sendCommands commands m =
    if Array.isEmpty commands then
        m

    else
        let
            logged =
                { m | diag = Diag.addAll m.turnMs "tmux>" (Array.map Diag.command commands) m.diag }
        in
        sendRaw (commandLines commands) logged


{-| `[tabs] restore` turned on while the window runs: its tabs are saved
from now; turned off: what it saved is forgotten (docs/tabs.md TB10). -}
restoreTurned : Bool -> (taken m : Model) -> Task Error Model
restoreTurned was m =
    let
        saving =
            m.saving
    in
    if m.config.tabsRestore && not was then
        startSaving m

    else if was && not m.config.tabsRestore then
        when { dir = saving.dir, window = saving.window } is
            { dir = Just dir, window = Just w } ->
                Restore.forget m.settings.given.fs dir w |> Task.map (\_ -> { m | saving = { saving | window = Nothing, written = "", at = -1 } })

            _ ->
                Task.succeed m

    else
        Task.succeed m


applyLook : Config -> (taken m : Model) -> Task Error Model
applyLook new m =
    let
        old =
            m.config

        locale =
            m.settings.locale

        language c =
            Maybe.withDefault locale.language c.language

        charset =
            Charset.fromName (Maybe.withDefault locale.charset new.charset)

        term0 =
            if new.palette /= old.palette then
                Vt.setPalette new.palette m.term

            else
                m.term

        term1 =
            if new.scrollbackLines /= old.scrollbackLines then
                Vt.setScrollbackBytes (Vt.scrollbackBytesFor { cols = term0.cols, rows = new.scrollbackLines }) term0

            else
                term0

        -- the colors a program asks for, and a 997 to one that asked to
        -- hear of the theme changing (docs/tmux.md TM4), sent at once
        told =
            if new.foreground /= old.foreground || new.background /= old.background then
                Vt.takeReplies (Vt.withEmbedder (embedderOf new) term1)

            else
                { term = term1, replies = [] }

        term =
            told.term

        -- read before `term` is moved into the model
        shape =
            { back = min m.back (Vt.scrollbackRows term), cols = term.cols, rows = term.rows }

        refont =
            new.font /= old.font || language new /= language old || new.glyphCacheMb /= old.glyphCacheMb

        applied =
            { m
                | config = new
                , tmux = TmuxMode.setLook (new.tmuxLook == "tmux") (TmuxMode.setBar (new.tmuxTabs == "top") m.tmux)
                , look = { foreground = new.foreground, background = new.background, boldIsBright = new.boldIsBright }
                , term = term
                , back = shape.back
                , charset = charset
                , decoder =
                    if charset /= m.charset then
                        Charset.decoder

                    else
                        m.decoder
                , wordBoundaries = Array.map Char.toCode (String.toArray new.wordBoundaries)
                , shadow = View.shadowIn shape.cols shape.rows m.windowRows
                , urgent = True
            }
                |> (\a -> Array.foldl sendRaw a told.replies)

        -- the bar shown or hidden by `[tabs] bar` changes every tab's rows
        rebar =
            new.tabsBar /= old.tabsBar
    in
    (if new.hosts /= old.hosts then
        Window.systemMenu (Array.map .label (menuItems new))

     else
        Task.succeed {}
    )
        |> Task.andThen (\_ -> Text.ligatures new.ligatures)
        |> Task.andThen (\_ -> refontOr new old language applied)
        |> Task.andThen (\next -> if rebar then relayout next.term.cols next else Task.succeed next)


{-| The font opened again, or sized again, when the settings ask (ST4). -}
refontOr : Config -> Config -> (Config -> String) -> (taken applied : Model) -> Task Error Model
refontOr new old language applied =
    let
        refont =
            new.font /= old.font || language new /= language old || new.glyphCacheMb /= old.glyphCacheMb
    in
    if refont then
        Window.setFont { font = new.font, lang = language new, points = new.points, glyphCap = new.glyphCacheMb * 1024 * 1024 }
            |> Task.andThen
                (\done ->
                    when done is
                        Ok _ ->
                            Task.succeed { applied | points = new.points }

                        Err why ->
                            Console.writeErr ("puritty: " ++ why ++ "; the font in use is kept\n")
                                |> Task.map (\_ -> { applied | config = { new | font = old.font, language = old.language, glyphCacheMb = old.glyphCacheMb } })
                )

    else if new.points /= old.points then
        Window.zoom new.points |> Task.map (\_ -> { applied | points = new.points })

    else
        Task.succeed applied


{-| Ctrl+Comma, as Windows Terminal, VS Code and Ghostty open their
settings (`settings-ui.md` §1): in the usual key encoding a program cannot
tell it from a comma. -}
isSettingsKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
isSettingsKey config k =
    k.action /= 0 && bound config.keySettings k


{-| Whether a key is the one a `[keys]` entry names (docs/tabs.md TB6); an
empty entry, or one that names no key, is no key's. -}
bound : String -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
bound name k =
    when Chord.parse name is
        Ok (Just chord) ->
            Chord.matches chord k

        _ ->
            False


{-| The settings window started, not tied to this window; a failure said
on standard error. -}
openSettings : (taken m : Model) -> Task x Model
openSettings m =
    spawnSelf [ "settings" ] m


{-| This program started again with `args`, and `--config` when this
window was given one, not tied to this window (ST9, ST26); a failure said
on standard error. -}
spawnSelf : Array String -> (taken m : Model) -> Task x Model
spawnSelf args m =
    when m.settingsWindow is
        Just w ->
            Process.spawn w.cp w.program (args ++ Array.dropFirst 1 w.args) (Process.defaultSpawnOptions Ignored)
                |> Task.map (\_ -> {})
                |> Task.onError (\e -> Console.writeErr ("puritty: " ++ String.join " " args ++ ": " ++ Os.Error.toString e ++ "\n"))
                |> Task.map (\_ -> m)

        Nothing ->
            Console.writeErr "puritty: this program's own file is not known, so no window can be started\n" |> Task.map (\_ -> m)


-- THE MENU (docs/settings.md ST9, ST26)


{-| Ctrl and the right button: the menu. -}
isMenuClick : Window.PointerEvent -> Bool
isMenuClick p =
    p.action == 0 && p.button == 2 && Bitwise.and p.mods 15 == 2


{-| The menu opened at a cell: the settings window, the host list, a
window of its own, then each host of the settings. -}
menuAt : Int -> Int -> Model -> Menu
menuAt row col m =
    { items = menuItems m.config
    , row = row
    , col = col
    , selected = 0
    }


{-| A menu's item: its words, and what it does. -}
type alias MenuItem =
    { label : String
    , does : MenuDoes
    }


{-| This program started again with these arguments, the shown tab
renamed or colored (docs/tabs.md TB9), or a new tab opened. -}
type MenuDoes
    = Starts (Array String)
    | Renames
    | Colors
    | Reopens
    | Marks
    | OpensTab


{-| The menu's items: the settings window, the host list, a new tab, a
window of its own, the shown tab's name and color, then each host of the
settings. -}
menuItems : Config -> Array MenuItem
menuItems config =
    [ { label = "Settings…", does = Starts [ "settings" ] }
    , { label = "Hosts…", does = Starts [ "hosts" ] }
    , { label = "New tab", does = OpensTab }
    , { label = "New window", does = Starts [ "shell" ] }
    , { label = "Rename tab…", does = Renames }
    , { label = "Tab color…", does = Colors }
    , { label = "Reopen closed tab", does = Reopens }
    ]
        ++ (if config.debugLog then [ { label = "Mark the diagnostic log", does = Marks } ] else [])
        ++ Array.map (\h -> { label = "Connect to " ++ h.name, does = Starts [ "--host", h.name ] }) config.hosts


{-| What a chosen item does. -}
menuDo : MenuItem -> (taken m : Model) -> Task Error Model
menuDo item m =
    when item.does is
        Starts args ->
            spawnSelf args m

        Renames ->
            Task.succeed (startRenaming m)

        Colors ->
            Task.succeed (startColoring m)

        Reopens ->
            reopenTab m

        Marks ->
            markLog m

        OpensTab ->
            -- as Ctrl+Shift+T: a tab of puritty's, or tmux's new window
            -- under -CC
            if TmuxMode.isOn m.tmux then
                let
                    r =
                        TmuxMode.newWindow m.tmux
                in
                Task.succeed (sendCommands r.commands { m | tmux = r.state, urgent = True })

            else
                openTab m


{-| The menu at the pointer: the platform's own when it shows one
(Windows), else drawn over the screen. -}
openMenu : Window.PointerEvent -> (taken m : Model) -> Task x Model
openMenu p m =
    let
        items =
            menuItems m.config
    in
    Window.menu { x = p.x, y = p.y, items = Array.map .label items }
        |> Task.map
            (\shown ->
                if shown then
                    { m | shownItems = items }

                else
                    { m | menu = Just (menuAt (p.y // max 1 p.cellHeight) (p.x // max 1 p.cellWidth) m), urgent = True }
            )


{-| An item chosen in a menu the platform showed: the pop-up's (0) or the
system menu's (1), whose items are the menu's always. -}
menuChosen : { menu : Int, index : Int } -> (taken m : Model) -> Task Error Model
menuChosen c m =
    let
        items =
            if c.menu == 1 then menuItems m.config else m.shownItems
    in
    when Array.get c.index items is
        Just item ->
            menuDo item m

        Nothing ->
            Task.succeed m


{-| The menu's box: where it is drawn, kept on the screen. -}
menuBox : Menu -> (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> (r : { row : Int, col : Int, width : Int, height : Int } where 0 <= r.row && r.row <= 1000 && 0 <= r.col && r.col <= 1000 && 0 <= r.width && r.width <= 1000 && 0 <= r.height && r.height <= 1000)
menuBox menu cols rows =
    let
        width =
            clamp 0 cols (min 1000 (Array.foldl (\i w -> max w (String.count i.label)) 0 menu.items) + 6)

        height =
            clamp 0 rows (min 1000 (Array.length menu.items) + 2)
    in
    { row = clamp 0 rows (min menu.row (rows - height))
    , col = clamp 0 cols (min menu.col (cols - width))
    , width = width
    , height = height
    }


{-| The menu as the text painted over the screen: a box, the marked item
pointed at. -}
menuPaints : Menu -> (cols : Int where 1 <= cols && cols <= 1000) -> (rows : Int where 1 <= rows && rows <= 1000) -> Array { row : Int, col : Int, text : String }
menuPaints menu cols rows =
    let
        box =
            menuBox menu cols rows

        inner =
            box.width - 2

        line i item =
            { row = box.row + 1 + i
            , col = box.col
            , text =
                "│"
                    ++ String.padRight inner ' ' ((if i == menu.selected then " ▸ " else "   ") ++ item.label)
                    ++ "│"
            }
    in
    [ { row = box.row, col = box.col, text = "┌" ++ String.repeat inner "─" ++ "┐" } ]
        ++ Array.indexedMap line menu.items
        ++ [ { row = box.row + box.height - 1, col = box.col, text = "└" ++ String.repeat inner "─" ++ "┘" } ]


{-| A key while the menu is open: Up and Down move the mark, Enter starts
what it marks, Esc closes it; any other key closes it too. -}
menuKey : Int -> Menu -> (taken m : Model) -> Task Error Model
menuKey sym menu m =
    let
        count =
            Array.length menu.items
    in
    if sym == 0xFF52 then
        Task.succeed { m | menu = Just { menu | selected = modBy count (menu.selected - 1 + count) }, urgent = True }

    else if sym == 0xFF54 then
        Task.succeed { m | menu = Just { menu | selected = modBy count (menu.selected + 1) }, urgent = True }

    else if sym == 0xFF0D || sym == 0xFF8D then
        when Array.get menu.selected menu.items is
            Just item ->
                menuDo item { m | menu = Nothing, urgent = True }

            Nothing ->
                Task.succeed { m | menu = Nothing, urgent = True }

    else
        Task.succeed { m | menu = Nothing, urgent = True }


{-| A press while the menu is open: on an item, what it says is started;
anywhere else the menu closes. -}
menuPress : Window.PointerEvent -> Menu -> (taken m : Model) -> Task Error Model
menuPress p menu m =
    let
        box =
            menuBox menu m.term.cols m.term.rows

        -- the pointer's cell, kept near the screen so that nothing
        -- computed from it can wrap
        cell =
            { row = clamp -1 2000 (p.y // max 1 p.cellHeight), col = clamp -1 2000 (p.x // max 1 p.cellWidth) }

        i =
            cell.row - box.row - 1

        inside =
            cell.col > box.col && cell.col < box.col + box.width - 1 && i >= 0 && i < Array.length menu.items
    in
    if inside && p.button == 1 then
        when Array.get i menu.items is
            Just item ->
                menuDo item { m | menu = Nothing, urgent = True }

            Nothing ->
                Task.succeed { m | menu = Nothing, urgent = True }

    else
        Task.succeed { m | menu = Nothing, urgent = True }


{-| The frame just drawn, written to `PURITTY_SHOT`'s file when it is set. -}
shoot : (taken m : Model) -> Task x Model
shoot m =
    when m.shotPath is
        Just path ->
            Window.shot path |> Task.map (\_ -> m)

        Nothing ->
            Task.succeed m


{-| The time told to tmux's control mode, which closes the panes' numbers
when theirs is past (docs/tmux.md TM28), drawn again when it does. -}
tmuxTick : Int -> (taken m : Model) -> Model
tmuxTick ms m =
    let
        due =
            TmuxMode.dueAt m.tmux
    in
    { m | tmux = TmuxMode.tick ms m.tmux, urgent = m.urgent || (due >= 0 && ms >= due) }


blink : Int -> (taken m : Model) -> Model
blink ms m =
    if blinking m && m.blinkAt >= 0 && ms >= m.blinkAt then
        { m | focus = { focused = m.focus.focused, blinkOn = not m.focus.blinkOn }, blinkAt = ms + m.config.blinkMs, urgent = True }

    else
        m


{-| What may wait to be written before the core's replies are dropped: a
program that asks and never reads its answers holds no more than this
(S§5.1). Keys and pastes are never dropped. -}
replyCap : Int
replyCap =
    1048576


{-| A read: what tmux control mode says, if it runs (docs/tmux.md TM14),
done to its panes and its commands queued; the rest fed to the core. -}
feed : Backend -> Bytes -> Int -> (taken m : Model) -> Task Error Model
feed remote chunk ms m =
    let
        size =
            { cols = m.term.cols, rows = m.term.rows }

        r =
            TmuxMode.read size chunk m.tmux

        on =
            TmuxMode.isOn r.state

        -- what tmux said, or else the bytes read, in the log
        traced =
            if Array.isEmpty r.trace && not on then
                Diag.add ms "read" (String.fromInt (Bytes.length chunk) ++ " bytes") m.diag

            else
                Diag.addAll ms "tmux<" r.trace m.diag
    in
    feedTerm remote r.outside ms
        { m
            | tmux = r.state
            , turnMs = ms
            , diag = traced
            , urgent = m.urgent || on
            , pending =
                if on && m.pending < 0 then
                    ms

                else
                    m.pending
        }
        |> Task.map (\fed -> sendCommands r.commands fed)


{-| Whether a private mode is set for what keys and pastes reach: the
terminal's program, or under tmux control mode the active pane's
(docs/tmux.md TM16). -}
modeOn : Int -> Model -> Bool
modeOn mode m =
    if TmuxMode.isOn m.tmux then
        TmuxMode.activeMode mode m.tmux == Just True

    else
        Dict.get mode m.term.modes == Just True


{-| tmux commands as the lines written to it. -}
commandLines : Array String -> Bytes
commandLines commands =
    Bytes.fromString (String.join "" (Array.map (\c -> c ++ "\n") commands))


{-| A read fed to the core and its replies queued, while fewer than
`replyCap` bytes wait. -}
feedTerm : Backend -> Bytes -> Int -> (taken m : Model) -> Task Error Model
feedTerm remote chunk0 ms m =
    let
        -- an EUC-KR or CP949 pane's bytes in UTF-8 before the core (V49)
        decoded =
            if m.charset == Charset.Utf8 then
                { decoder = m.decoder, bytes = chunk0 }

            else
                Charset.decode m.decoder chunk0

        pushedBefore =
            Vt.rowsPushed m.term

        replied =
            Vt.takeReplies (Vt.feed decoded.bytes m.term)

        taken =
            let
                c =
                    Vt.takeClipboard replied.term
            in
            { term = c.term, replies = replied.replies, clips = c.requests }

        held =
            syncHeld taken.term

        -- a selection's highlight goes when its rows are written over
        selection =
            kept m.selection taken.term

        -- a view scrolled back stays on its rows as more come in below it
        back =
            if m.back > 0 then
                min (Vt.scrollbackRows taken.term) (m.back + Vt.rowsPushed taken.term - pushedBefore)

            else
                0
    in
    Task.succeed
        (Array.foldl (\r acc -> if Outbox.size acc.out >= replyCap then acc else send r acc)
            { m
                | term = taken.term
                , clips = m.clips ++ taken.clips
                , back = back
                , selection = selection
                , decoder = decoded.decoder
                , pending =
                    if m.pending < 0 then
                        ms

                    else
                        m.pending
                , syncSince =
                    if not held then
                        -1

                    else if m.syncSince < 0 then
                        ms

                    else
                        m.syncSince
            }
            taken.replies
        )


{-| The window's events: a key sent to the program, a new size given to the
core and the terminal, the focus kept for the cursor and reported under
mode 1004, a close. -}
handle : Backend -> Int -> Array Window.Event -> (taken m : Model) -> Task Error Model
handle remote ms evs m =
    when Array.first evs is
        Nothing ->
            Task.succeed m

        Just ev ->
            let
                said =
                    eventLine ev
            in
            handleOne remote
                ms
                (Array.dropFirst 1 evs)
                ev
                { m
                    | shiftHeld = shiftAfter ev m.shiftHeld
                    , turnMs = ms
                    , diag =
                        when said is
                            Just l ->
                                Diag.add ms l.tag l.text m.diag

                            Nothing ->
                                m.diag
                }


{-| Whether Shift is held after an event, for the pointer's shape (§21):
a Shift key pressed or released, the Shift bit of a pointer event, and not
once the focus has gone, since its release goes to another window. -}
shiftAfter : Window.Event -> Bool -> Bool
shiftAfter ev held =
    when ev is
        Window.Key k ->
            if k.sym == 0xFFE1 || k.sym == 0xFFE2 then
                k.action /= 0

            else
                held

        Window.Pointer p ->
            Bitwise.and p.mods 1 /= 0

        Window.Focus False ->
            False

        _ ->
            held


-- PURITTY'S OWN SCREEN, for the built-in ssh client (docs/ssh-client.md
-- SC9, SC18): what happens before the session runs, its questions, and
-- why it failed, written by puritty and never by the server, with the
-- window's title its own while it is up.


{-| Whether puritty's own screen is up: before the session runs, while it
asks, and after it failed. -}
ownScreenUp : Model -> Bool
ownScreenUp m =
    when m.ssh is
        Just screen ->
            not screen.started || screen.failed /= Nothing || screen.asking /= Nothing

        Nothing ->
            False


{-| A notice from the session, taken into the screen; when the session
starts, the window's size is sent to it, since the size its terminal was
asked with can be an old one: a jump host drops a resize made while it
connects (docs/ssh-client.md SC26). -}
sshTold : Session.Notice -> (taken m : Model) -> Task Error Model
sshTold told m =
    when told is
        Session.Started ->
            m.remote.resize { columns = m.term.cols, rows = m.term.rows }
                |> Task.map (\_ -> sshNoticed told m)

        _ ->
            Task.succeed (sshNoticed told m)


{-| A notice from the session, taken into the screen's state. A session
that ended as it should is its callers' to close (`endsSession`), the tab
and the window only with its last; one that failed or never started
leaves the screen up to say why. -}
sshNoticed : Session.Notice -> (taken m : Model) -> Model
sshNoticed told m =
    when m.ssh is
        Nothing ->
            m

        Just screen ->
            let
                said line =
                    { screen | lines = Array.takeLast 200 (Array.pushLast line screen.lines) }

                updated =
                    when told is
                        Session.Status text ->
                            said (cleanText text)

                        Session.Banner text ->
                            { screen | lines = Array.takeLast 200 (screen.lines ++ Array.map (\l -> "| " ++ cleanText l) (String.lines (String.trimRight text))) }

                        Session.Asking ask ->
                            { screen | asking = Just { ask = ask, typed = "", given = [] } }

                        Session.Started ->
                            { screen | started = True }

                        Session.Exited status ->
                            { screen | exitStatus = Just status }

                        Session.Failed why ->
                            { screen | failed = Just (cleanText why) }

                        Session.Ended ->
                            if screen.started && screen.failed == Nothing && screen.exitStatus /= Nothing then
                                screen

                            else
                                -- a session that ends without its shell's exit status
                                -- dropped: its screen stays up to say so, with
                                -- reconnect (TB8)
                                { screen | failed = Just (Maybe.withDefault "the connection ended" screen.failed) }

                        Session.Output _ ->
                            screen
            in
            { m | ssh = Just updated, urgent = True }


{-| Whether a notice ends a session that went as it should, its shell's
`exit`, which the server says with an exit status before the end: its tab
then closes as a local tab's does when its program ends, and the window
with its last tab, its exit status the window's (TB8). A session that
failed, never started, or dropped without an exit status keeps its screen
and its tab, to reconnect. -}
endsSession : Session.Notice -> Maybe SshScreen -> Bool
endsSession told ssh =
    when ssh is
        Just screen ->
            told == Session.Ended && screen.started && screen.failed == Nothing && screen.exitStatus /= Nothing

        Nothing ->
            False


{-| Text from the server or the network made safe to show: control
characters, escapes among them, as `?`. -}
cleanText : String -> String
cleanText text =
    String.map
        (\c ->
            let
                n =
                    Char.toCode c
            in
            if n < 32 || n == 127 || (n >= 128 && n < 160) then
                '?'

            else
                c
        )
        text


{-| A key on puritty's own screen: the question's answer, or after a
failure Enter to close and R to connect again; Escape declines a question,
and before the session runs closes the window. -}
sshKey : Backend -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
sshKey remote k m =
    let
        enter =
            k.sym == 0xFF0D || k.sym == 0xFF8D

        escape =
            k.sym == 0xFF1B

        backspace =
            k.sym == 0xFF08

        letter =
            String.toLower (Bytes.toStringLossy k.text)
    in
    when m.ssh is
        Nothing ->
            Task.succeed m

        Just screen ->
            when screen.asking is
                Just asking ->
                    let
                        answered answer line model =
                            sshAnswered remote answer line screen model
                    in
                    when asking.ask is
                        Session.TrustHostKey _ ->
                            if letter == "a" then
                                answered (Session.Trust { remember = True }) "the key is trusted and remembered" m

                            else if letter == "o" then
                                answered (Session.Trust { remember = False }) "the key is trusted this once" m

                            else if escape || letter == "n" then
                                answered Session.Decline "the key is not trusted" m

                            else
                                Task.succeed m

                        Session.Responses r ->
                            if escape then
                                answered Session.Decline "the prompts are not answered" m

                            else if enter then
                                let
                                    given =
                                        Array.pushLast asking.typed asking.given
                                in
                                if Array.length given >= Array.length r.prompts then
                                    answered (Session.GiveAll given) "answered" m

                                else
                                    Task.succeed { m | ssh = Just { screen | asking = Just { asking | typed = "", given = given } }, urgent = True }

                            else
                                Task.succeed (editTyped backspace k m)

                        _ ->
                            if escape then
                                answered Session.Decline "not given" m

                            else if enter then
                                answered (Session.Give asking.typed) "given" m

                            else
                                Task.succeed (editTyped backspace k m)

                Nothing ->
                    if screen.failed /= Nothing && letter == "r" then
                        remote.reconnect { columns = m.term.cols, rows = m.term.rows }
                            |> Task.map (\_ -> { m | ssh = Just { screen | lines = [ "connecting again" ], failed = Nothing, started = False, exitStatus = Nothing }, urgent = True })

                    else if (screen.failed /= Nothing && enter) || escape then
                        -- this tab's session given up: the tab closed, and
                        -- the window only with its last tab
                        closeShown m

                    else
                        Task.succeed m


{-| The question answered: the answer to the session, and a line said. -}
sshAnswered : Backend -> Session.Answer -> String -> SshScreen -> (taken m : Model) -> Task Error Model
sshAnswered remote answer line screen m =
    remote.answer answer
        |> Task.map (\_ -> { m | ssh = Just { screen | asking = Nothing, lines = Array.pushLast line screen.lines }, urgent = True })


{-| A key typed into the question: a character added, or one taken off. -}
editTyped : Bool -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Model
editTyped backspace k m =
    if backspace then
        updateTyped (String.dropLast 1) m

    else
        sshTyped (Bytes.toStringLossy k.text) m


sshTyped : String -> (taken m : Model) -> Model
sshTyped text m =
    updateTyped (\typed -> typed ++ String.fromArray (Array.keepIf (\c -> Char.toCode c >= 32 && Char.toCode c /= 127) (String.toArray text))) m


updateTyped : (String -> String) -> (taken m : Model) -> Model
updateTyped f m =
    when m.ssh is
        Just screen ->
            when screen.asking is
                Just asking ->
                    { m | ssh = Just { screen | asking = Just { asking | typed = f asking.typed } }, urgent = True }

                Nothing ->
                    m

        Nothing ->
            m


{-| A question of the ssh session, or why it failed, as a box over the
screen (docs/ssh-client.md SC23): what `ownTerm` writes on the screen
without one. -}
dialogOf : SshScreen -> Maybe Dialog.Dialog
dialogOf screen =
    when screen.asking is
        Just asking ->
            when asking.ask is
                Session.TrustHostKey k ->
                    Just
                        { title = "The host " ++ cleanText k.host ++ " is not known"
                        , lines =
                            [ "Its " ++ k.algorithm ++ " key's fingerprint:", "    " ++ k.fingerprint ]
                                ++ (if Array.isEmpty k.knownTypes then [] else [ "It is known by its " ++ String.join ", " k.knownTypes ++ " key, not this one." ])
                        , field = Nothing
                        , swatches = []
                        , buttons = []
                        , hint = "A: trust and remember    O: trust once    Esc: don't connect"
                        }

                Session.Password p ->
                    Just { title = cleanText p.prompt, lines = [], field = Just { typed = asking.typed, hidden = True, caret = String.count asking.typed }, swatches = [], hint = "Enter: log in    Esc: do not use a password", buttons = [] }

                Session.Passphrase p ->
                    let
                        file =
                            cleanText p.file

                        -- the key's own name, after the last / or \
                        name =
                            String.split "/" file |> Array.last |> Maybe.withDefault file |> String.split "\\" |> Array.last |> Maybe.withDefault file
                    in
                    Just { title = "The passphrase for " ++ name, lines = [ file ], field = Just { typed = asking.typed, hidden = True, caret = String.count asking.typed }, swatches = [], hint = "Enter: unlock the key    Esc: skip this key", buttons = [] }

                Session.Responses r ->
                    when Array.get (Array.length asking.given) r.prompts is
                        Just prompt ->
                            Just
                                { title = if r.name == "" then "The server asks" else cleanText r.name
                                , lines = (if r.instruction == "" then [] else [ cleanText r.instruction ]) ++ [ cleanText prompt.text ]
                                , field = Just { typed = asking.typed, hidden = not prompt.echo, caret = String.count asking.typed }
                                , swatches = []
                                , buttons = []
                                , hint = "Enter: answer    Esc: do not answer"
                                }

                        Nothing ->
                            Nothing

        Nothing ->
            when screen.failed is
                Just why ->
                    Just { title = "The session could not go on", lines = [ why ], field = Nothing, swatches = [], hint = "Enter: close    R: connect again", buttons = [] }

                Nothing ->
                    Nothing


{-| The own screen as a terminal of the window's size: a heading, what has
happened, then the question or the failure and the keys that answer it. -}
ownTerm : Model -> Bool -> SshScreen -> Vt.Term
ownTerm m boxed screen =
    let
        dim t =
            "\u{001B}[2m" ++ t ++ "\u{001B}[0m"

        bold t =
            "\u{001B}[1m" ++ t ++ "\u{001B}[0m"

        line t =
            t ++ "\r\n"

        -- what is typed shown as a bullet a character: stars are joined by
        -- a font's ligatures, as Fira Code's `***` raises its middle one
        -- (docs/ssh-client.md SC20), and no font joins bullets
        hidden t =
            String.repeat (String.count t) "•"

        -- where the cursor goes back to once the screen is written: after
        -- what is typed, where the next character will show (DECSC)
        mark =
            "\u{001B}7"

        asked =
            when screen.asking is
                Just asking ->
                    when asking.ask is
                        Session.TrustHostKey k ->
                            [ line ""
                            , line (bold ("The host " ++ cleanText k.host ++ " is not known."))
                            , line ("  Its " ++ k.algorithm ++ " key's fingerprint:")
                            , line ("    " ++ k.fingerprint)
                            , if Array.isEmpty k.knownTypes then
                                ""

                              else
                                line ("  It is known by its " ++ String.join ", " k.knownTypes ++ " key, not this one.")
                            , line ""
                            , line "  A: trust it and remember it    O: trust it this once    Esc: do not connect"
                            ]

                        Session.Password p ->
                            [ line "", line (bold (cleanText p.prompt ++ ": ") ++ hidden asking.typed ++ mark), line "", line (dim "  Enter: log in    Esc: do not use a password") ]

                        Session.Passphrase p ->
                            [ line "", line (bold ("The passphrase for " ++ cleanText p.file ++ ": ") ++ hidden asking.typed ++ mark), line "", line (dim "  Enter: unlock the key    Esc: do not use this key") ]

                        Session.Responses r ->
                            let
                                current =
                                    Array.get (Array.length asking.given) r.prompts

                                shown =
                                    when current is
                                        Just prompt ->
                                            line
                                                (bold (cleanText prompt.text)
                                                    ++ (if prompt.echo then
                                                            asking.typed

                                                        else
                                                            hidden asking.typed
                                                       )
                                                    ++ mark
                                                )

                                        Nothing ->
                                            ""
                            in
                            [ line ""
                            , if r.name == "" then "" else line (bold ("The server asks: " ++ cleanText r.name))
                            , if r.instruction == "" then "" else line (cleanText r.instruction)
                            , shown
                            , line ""
                            , line (dim "  Enter: answer    Esc: do not answer")
                            ]

                Nothing ->
                    when screen.failed is
                        Just why ->
                            [ line "", line (bold "The session could not go on:"), line ("  " ++ why), line "", line "  Enter: close    R: connect again" ]

                        Nothing ->
                            []

        -- the cursor only where something is typed
        typingAsked =
            when screen.asking is
                Just asking ->
                    when asking.ask is
                        Session.TrustHostKey _ ->
                            False

                        _ ->
                            True

                Nothing ->
                    False

        -- a question in a box over the screen is not on it (SC23)
        question =
            if boxed then
                []

            else
                asked

        typing =
            not boxed && typingAsked

        text =
            String.join ""
                ([ "\u{001B}[2J\u{001B}[H"
                 , if typing then "\u{001B}[?25h" else "\u{001B}[?25l"
                 , line (bold ("puritty: ssh to " ++ cleanText screen.host))
                 , line ""
                 ]
                    ++ Array.map (\l -> line (dim ("  " ++ l))) (Array.takeLast (max 1 (m.term.rows - 12)) screen.lines)
                    ++ question
                    -- the cursor back after what is typed (DECRC)
                    ++ [ if typing then "\u{001B}8" else "" ]
                )
    in
    Vt.new
        { cols = m.term.cols
        , rows = m.term.rows
        , scrollbackBytes = 0
        , pageRows = Vt.defaultPageRows
        , checksums = False
        , cellWidth = m.term.config.cellWidth
        , cellHeight = m.term.config.cellHeight
        }
        |> Vt.feed (Bytes.fromString text)


handleOne : Backend -> Int -> Array Window.Event -> Window.Event -> (taken m : Model) -> Task Error Model
handleOne remote ms rest ev m =
            when ev is
                Window.Key k ->
                  if m.closing /= Nothing then
                    -- the question before closing takes the keys (TB4)
                    (if k.action /= 0 then closeKey k m else Task.succeed m)
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                  else if m.renaming /= Nothing then
                    -- the rename box takes the keys while it is open (TB1)
                    (if k.action /= 0 then renameKey k m else Task.succeed m)
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                  else if m.coloring /= Nothing then
                    -- and the color box (TB9)
                    (if k.action /= 0 then colorKey k m else Task.succeed m)
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                  else if ownScreenUp m then
                    -- puritty's own screen takes the keys (docs/ssh-client.md SC18)
                    (if k.action /= 0 then sshKey remote k m else Task.succeed m)
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                  else if m.menu /= Nothing && k.action /= 0 then
                    -- the menu takes the keys while it is open
                    when m.menu is
                        Just menu ->
                            menuKey k.sym menu m |> Task.andThen (\next -> handle remote ms rest next)

                        Nothing ->
                            handle remote ms rest m

                  else if m.search /= Nothing && k.action /= 0 && not (isCopyKey m.config k) then
                    -- the search bar takes the keys while it is open (§23),
                    -- but Ctrl+Shift+C, which copies the match
                    handle remote ms rest (searchKey k m)

                  else if isSearchKey m.config k && not (TmuxMode.isOn m.tmux) then
                    handle remote ms rest { m | search = Just Search.start, urgent = True }

                  else if isSettingsKey m.config k then
                    -- Ctrl+Comma: the settings window (docs/settings.md ST9),
                    -- which raises one already open
                    openSettings m |> Task.andThen (\next -> handle remote ms rest next)

                  else if tabAction k m /= Nothing then
                    -- the tabs' keys (docs/tabs.md TB1)
                    when tabAction k m is
                        Just action ->
                            tabDo action m |> Task.andThen (\next -> handle next.remote ms rest next)

                        Nothing ->
                            handle remote ms rest m

                  else
                    when zoomOf m k is
                        Just points ->
                            Window.zoom points
                                |> Task.andThen
                                    (\_ ->
                                        -- every cell is drawn again at the new size
                                        handle remote ms rest { m | points = points, shadow = View.shadowIn m.term.cols m.term.rows m.windowRows, urgent = True }
                                    )

                        Nothing ->
                            if isPasteKey m.config k /= Nothing then
                                -- Shift+Insert and Ctrl+Shift+V, the
                                -- terminal's before the program's
                                owned remote ms rest { m | toPaste = Maybe.map (pasteFrom m.config) (isPasteKey m.config k) }

                            else if isCopyKey m.config k then
                                -- Ctrl+Shift+C: the selection to CLIPBOARD
                                -- (docs/user/copy-and-paste.md), the key
                                -- puritty's with or without one
                                owned remote ms rest
                                    (if TmuxMode.isOn m.tmux then
                                        when TmuxMode.selectedText m.tmux is
                                            Just text ->
                                                { m | toOwn = Just { which = Window.Clipboard, text = text } }

                                            Nothing ->
                                                m

                                     else
                                        when m.selection is
                                            Just s ->
                                                { m | toOwn = Just { which = Window.Clipboard, text = Vt.selectionText s.anchor s.head m.term } }

                                            Nothing ->
                                                m
                                    )

                            else
                                if TmuxMode.isOn m.tmux then
                                    -- the tabs' keys, then the active pane's
                                    -- view (docs/tmux.md TM17, TM18)
                                    let
                                        tabbed =
                                            TmuxMode.tabKey k m.tmux
                                    in
                                    if tabbed.used then
                                        handle remote ms rest (sendCommands tabbed.commands { m | tmux = tabbed.state, urgent = True })

                                    else
                                        let
                                            scrolled =
                                                TmuxMode.scrollKey k tabbed.state
                                        in
                                        if scrolled.used then
                                            handle remote ms rest { m | tmux = scrolled.state, urgent = True }

                                        else
                                            key remote ms rest k { m | tmux = scrolled.state }

                                else
                                    when scrollKeyOf m k is
                                        Just back ->
                                            handle remote ms rest { m | back = back, urgent = True }

                                        Nothing ->
                                            key remote ms rest k m

                Window.Resized size ->
                    -- every tab at the window's size, less the bar's row
                    -- while it shows (docs/tabs.md TB2)
                    relayout size.cols { m | windowRows = size.rows }
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                Window.Focus on ->
                    let
                        report =
                            if modeOn 1004 m then
                                if on then
                                    Bytes.fromString "\u{001B}[I"

                                else
                                    Bytes.fromString "\u{001B}[O"

                            else
                                Bytes.empty
                    in
                    handle remote ms rest (send report { m | focus = { focused = on, blinkOn = True }, urgent = True, blinkAt = -1 })

                Window.Close ->
                    -- asked first when a tab is busy (docs/tabs.md TB7)
                    askCloseWindow m |> Task.andThen (\next -> if next.closed then Task.succeed next else handle next.remote ms rest next)

                Window.MenuChosen c ->
                    menuChosen c m |> Task.andThen (\next -> handle remote ms rest next)

                Window.Rescaled _ ->
                    -- the window moved to a monitor of another scale
                    -- (docs/windows.md WS30): the cell is the window's
                    -- own, and the Resized that follows draws every cell
                    handle remote ms rest m

                Window.Commit text ->
                  if m.renaming /= Nothing then
                    handle remote ms rest (renameTyped (Bytes.toStringLossy text) m)

                  else if m.coloring /= Nothing then
                    -- what the IME commits is no answer to the color box
                    handle remote ms rest m

                  else if ownScreenUp m then
                    -- what the IME commits, typed into the question
                    handle remote ms rest (sshTyped (Bytes.toStringLossy text) m)

                  else if TmuxMode.isAsking m.tmux then
                    -- typed into tmux's prompt that puritty asks (TM25)
                    handle remote ms rest { m | tmux = TmuxMode.typeInto (Bytes.toStringLossy text) m.tmux, urgent = True }

                  else
                    -- the key path: the text as typed, never as a paste (V46)
                    imeLine m.imeLog ("commit " ++ Bytes.toStringLossy text)
                        |> Task.andThen (\_ -> handle remote ms rest (send text { m | urgent = True, back = 0 }))

                Window.Preedit p ->
                    let
                        cps =
                            Array.map Char.toCode (String.toArray (Bytes.toStringLossy p.text))

                        old =
                            m.preedit

                        points =
                            Array.takeFirst p.first old.points ++ cps ++ Array.dropFirst (p.first + p.length) old.points

                        feedback =
                            Array.takeFirst p.first old.feedback
                                ++ Array.initialize (Array.length cps) 0 (\i -> Maybe.withDefault 0 (Array.get i p.feedback))
                                ++ Array.dropFirst (p.first + p.length) old.feedback
                    in
                    imeLine m.imeLog ("preedit " ++ String.fromArray (Array.mapAndKeepJust Char.fromCode points) ++ " caret " ++ String.fromInt p.caret ++ " feedback " ++ String.join " " (Array.map String.fromInt feedback))
                        |> Task.andThen (\_ -> handle remote ms rest { m | preedit = { points = points, feedback = feedback, caret = p.caret }, urgent = True })

                Window.ImeReady ->
                    imeLine m.imeLog "ime ready"
                        |> Task.andThen (\_ -> handle remote ms rest m)

                Window.PreeditDone ->
                    imeLine m.imeLog "done"
                        |> Task.andThen (\_ -> handle remote ms rest { m | preedit = { points = [], feedback = [], caret = 0 }, urgent = True })

                Window.Pointer p ->
                  if p.action == 2 && m.held == 0 && (Vt.mouseModes m.term).tracking /= Mouse.any then
                    -- a motion with no button held that nothing asked for,
                    -- sent for the pointer's shape alone (TM38)
                    handle remote ms rest { m | hover = Just p }

                  else if m.hover /= Just p then
                    -- the pointer's place kept for its shape, and the event
                    -- then taken as before
                    handle remote ms (Array.pushFirst (Window.Pointer p) rest) { m | hover = Just p }

                  else if m.closing /= Nothing then
                    -- the close question takes the pointer: its buttons
                    -- answer it, and nothing reaches the terminal (TB12)
                    (if p.action == 0 then closePress p m else Task.succeed m)
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                  else if m.coloring /= Nothing then
                    -- the color box takes the presses while it is open (TB9)
                    (if p.action == 0 then colorPress p m else Task.succeed m)
                        |> Task.andThen (\next -> handle next.remote ms rest next)

                  else if p.action == 0 && barRows m > 0 && p.y >= m.term.rows * max 1 p.cellHeight then
                    -- a press on the tab bar (docs/tabs.md TB1)
                    barPress ms p m |> Task.andThen (\next -> handle next.remote ms rest next)

                  else if p.action == 0 && m.menu /= Nothing then
                    when m.menu is
                        Just menu ->
                            menuPress p menu m |> Task.andThen (\next -> handle remote ms rest next)

                        Nothing ->
                            handle remote ms rest m

                  else if isMenuClick p then
                    openMenu p m |> Task.andThen (\next -> handle remote ms rest next)

                  else
                    if isZoomStep p then
                        -- Ctrl and the wheel: puritty's always, a point a
                        -- step, the steps that came together one zoom
                        -- (docs/phase3-select.md §11, §17)
                        let
                            steps =
                                zoomSteps rest (stepOf p)

                            points =
                                clamp 4 96 (m.points + steps.net)
                        in
                        if points == m.points then
                            handle remote ms steps.rest m

                        else
                            Window.zoom points
                                |> Task.andThen
                                    (\_ ->
                                        handle remote ms steps.rest { m | points = points, shadow = View.shadowIn m.term.cols m.term.rows m.windowRows, urgent = True }
                                    )

                    else
                        owned remote ms rest (pointer ms p m)

                Window.Pasted more ->
                    Window.pasted
                        |> Task.andThen
                            (\text ->
                                handle remote ms rest
                                    (when m.clipRead is
                                        Just r ->
                                            clipReadIn more text r m

                                        Nothing ->
                                            pasteIn more text m
                                    )
                            )

                Window.SelectionLost which ->
                    -- another program's selection now: the highlight goes,
                    -- as xterm takes it away
                    handle remote ms rest
                        (if which == Window.Primary then
                            { m | selection = Nothing, urgent = True }

                         else
                            m
                        )


{-| The events after one that made a selection the window's, or asked
for a paste: the window told first. -}
owned : Backend -> Int -> Array Window.Event -> (taken m : Model) -> Task Error Model
owned remote ms rest m =
    when m.toOwn is
        Just own ->
            let
                -- a selection made, copied to the clipboard as well when
                -- the settings say (docs/windows.md WS27)
                next =
                    if own.which == Window.Primary && m.config.copyToClipboard then
                        Just { which = Window.Clipboard, text = own.text }

                    else
                        Nothing
            in
            Window.select own.which (Bytes.fromString own.text)
                |> Task.andThen (\_ -> owned remote ms rest { m | toOwn = next })

        Nothing ->
            when m.toPaste is
                Just which ->
                    Window.paste which
                        |> Task.andThen (\_ -> handle remote ms rest (logLine "paste" ("asked from " ++ (if which == Window.Primary then "the selection (primary)" else "the clipboard")) { m | toPaste = Nothing }))

                Nothing ->
                    handle remote ms rest m


{-| The OSC 52 requests the core made (docs/phase3-select.md §16): a write
makes the window own the selection with its text, as a copy does, and a
write to PRIMARY takes a selection's highlight away; a read is answered only
under `[clipboard] osc52_read = "allow"`, with the selection's text asked of
its owner as a paste is and sent back as base64, and is otherwise dropped
with no answer. -}
clipboardRequests : (taken m : Model) -> Task x Model
clipboardRequests m =
    when Array.first m.clips is
        Nothing ->
            Task.succeed m

        Just c ->
            let
                rest =
                    { m | clips = Array.dropFirst 1 m.clips }

                which =
                    if c.selection == 0 then
                        Window.Primary

                    else
                        Window.Clipboard
            in
            when c.text is
                Just text ->
                    Window.select which text
                        |> Task.andThen
                            (\_ ->
                                clipboardRequests
                                    (if c.selection == 0 then
                                        { rest | selection = Nothing, urgent = True }

                                     else
                                        rest
                                    )
                            )

                Nothing ->
                    if rest.config.osc52Read && rest.clipRead == Nothing then
                        Window.paste which
                            |> Task.andThen
                                (\asked ->
                                    clipboardRequests
                                        (if asked then
                                            { rest | clipRead = Just { letter = c.letter, bel = c.bel, text = Bytes.empty } }

                                         else
                                            rest
                                        )
                                )

                    else
                        clipboardRequests rest


{-| An OSC 52 read's text, as it comes; when it is all there, the answer
the program asked for, `OSC 52 ; LETTER ; BASE64` ended as its question was. -}
clipReadIn : Bool -> Bytes -> { letter : Int, bel : Bool, text : Bytes } -> (taken m : Model) -> Model
clipReadIn more text r m =
    let
        all =
            Bytes.flatten [ r.text, text ]
    in
    if more then
        { m | clipRead = Just { r | text = all } }

    else
        sendRaw
            (Bytes.flatten
                [ Bytes.fromString ("\u{001B}]52;" ++ String.fromChar (Maybe.withDefault 'c' (Char.fromCode r.letter)) ++ ";")
                , Base64.encode all
                , Bytes.fromString
                    (if r.bel then
                        "\u{0007}"

                     else
                        "\u{001B}\\"
                    )
                ]
            )
            { m | clipRead = Nothing }


{-| A paste's text, as it comes (docs/phase3-select.md §15): encoded as
Ghostty and xterm encode a paste (`Vt.Paste`), bracketed when the program
had mode 2004 set when its first text came, and queued as typed text is, in
the pane's character set. The view comes to the bottom, as for a key. -}
pasteIn : Bool -> Bytes -> (taken m : Model) -> Model
pasteIn more text m =
    if TmuxMode.isAsking m.tmux then
        -- into tmux's prompt that puritty asks, its line ends as spaces
        -- (docs/tmux.md TM25)
        logLine "paste" (String.fromInt (Bytes.length text) ++ " bytes into tmux's prompt") { m | tmux = TmuxMode.typeInto (Bytes.toStringLossy text) m.tmux, urgent = True }

    else
        pasteInto more text m


pasteInto : Bool -> Bytes -> (taken m : Model) -> Model
pasteInto more text m =
    let
        first =
            m.pasting == Nothing

        bracketed =
            Maybe.withDefault (modeOn 2004 m) m.pasting

        empty =
            first && not more && Bytes.isEmpty text

        bytes =
            if empty then
                Bytes.empty

            else
                Bytes.flatten
                    [ if first && bracketed then Paste.bracketStart else Bytes.empty
                    , Paste.piece bracketed text
                    , if not more && bracketed then Paste.bracketEnd else Bytes.empty
                    ]
    in
    send bytes
        { m
            | diag =
                Diag.add m.turnMs
                    "paste"
                    (String.fromInt (Bytes.length text)
                        ++ " bytes, "
                        ++ String.fromInt (Diag.lines text)
                        ++ " lines, "
                        ++ (if bracketed then "bracketed" else "plain")
                        ++ (when { first = first, more = more } is
                                { first = True, more = False } -> ", in one piece"
                                { first = True, more = True } -> ", the first piece"
                                { first = False, more = True } -> ", a later piece"
                                { first = False, more = False } -> ", the last piece")
                        ++ ", sent "
                        ++ String.fromInt (Bytes.length bytes)
                        ++ " bytes to "
                        ++ (if TmuxMode.isOn m.tmux then "tmux's active pane" else "the program")
                    )
                    m.diag
            , pasting =
                if more then
                    Just bracketed

                else
                    Nothing
            , back =
                if empty then
                    m.back

                else
                    0
            , urgent = True
        }


{-| A press, release or motion of the pointer (docs/phase3-select.md §4):
reported to a program that asked for mouse reports, in its format, by
Ghostty's encoder (`Vt.Mouse`). Shift takes the mouse back from it, as in
Ghostty, xterm and kitty: a press or release of a button with Shift, or a
motion with Shift while a button is held, is puritty's own. The wheel is
not: Ghostty reports it with Shift too, and nvim pages with Shift and the
wheel. A motion is reported with the lowest-numbered button held, as
Ghostty reports it. -}
pointer : Int -> Window.PointerEvent -> (taken m : Model) -> Model
pointer ms p m =
    let
        modes =
            Vt.mouseModes m.term

        bit =
            Bitwise.shiftLeftBy p.button 1

        held =
            if p.button == 0 || (p.button >= 4 && p.button <= 7) then
                -- a wheel step is pressed and never held (`wheel` below)
                m.held

            else if p.action == 0 then
                Bitwise.or m.held bit

            else if p.action == 1 then
                Bitwise.and m.held (Bitwise.complement bit)

            else
                m.held

        wheel =
            p.button >= 4 && p.button <= 7

        taken =
            Bitwise.and p.mods 1 /= 0 && not wheel && (p.action /= 2 || held /= 0)
    in
    if TmuxMode.isOn m.tmux then
        -- tmux's panes, their programs and selections in them
        -- (docs/tmux.md TM16, TM17); Shift selects
        let
            r =
                TmuxMode.pointer { ms = ms, held = held, select = taken, boundaries = m.wordBoundaries, pasteButton = m.config.pasteButton } p m.tmux
        in
        sendCommands r.commands
            { m
                | held = held
                , tmux = r.state
                , urgent = True
                , toOwn = Maybe.map (\t -> { which = Window.Primary, text = t }) r.own
                , toPaste = if r.paste then Just (pasteFrom m.config Window.Primary) else m.toPaste
            }

    else if m.barDrag || (p.action == 0 && p.button == 1 && barShown m && Dialog.scrollbarHit (overlaySize m) { back = viewBack m, most = Vt.scrollbackRows m.term } { x = p.x, y = p.y } /= Nothing) then
        -- the scrollbar: a press puts the thumb at the pointer, a drag moves
        -- it, letting go ends the drag (§23)
        let
            back =
                Dialog.scrollbarHit (overlaySize m) { back = viewBack m, most = Vt.scrollbackRows m.term } { x = 1000000, y = p.y }
                    |> Maybe.withDefault m.back
        in
        { m | held = held, back = back, barDrag = held /= 0, urgent = True }

    else if modes.tracking == Mouse.none && wheel && p.action == 0 then
        wheelStep p.button { m | held = held }

    else if modes.tracking == Mouse.none || taken then
        selecting ms p held m

    else
        let
            r =
                Mouse.encode
                    { tracking = modes.tracking
                    , format = modes.format
                    , size =
                        { screenWidth = p.width
                        , screenHeight = p.height
                        , cellWidth = p.cellWidth
                        , cellHeight = p.cellHeight
                        , padTop = 0
                        , padBottom = 0
                        , padRight = 0
                        , padLeft = 0
                        }
                    , anyButtonPressed = held /= 0
                    , track = True
                    , last = m.mouseLast
                    }
                    { action = p.action
                    , button =
                        if p.action == 2 then
                            lowestHeld held 1

                        else
                            p.button
                    , mods = p.mods
                    , x = p.x
                    , y = p.y
                    }
        in
        sendRaw r.bytes { m | held = held, mouseLast = r.last }


{-| A step of the wheel no program asked for (docs/phase3-select.md §11):
on the alternate screen with mode 1007 set, three arrow keys, as Ghostty
sends them, in DECCKM's form; else the view scrolled three rows. A step
sideways does nothing. One step reported to a program that asked for the
mouse is one report, as xterm sends it; Ghostty sends three. -}
wheelStep : Int -> (taken m : Model) -> Model
wheelStep button m =
    let
        up =
            button == 4

        down =
            button == 5
    in
    if not (up || down) then
        m

    else if m.term.alt then
        if Dict.get 1007 m.term.modes == Just False then
            m

        else
            let
                arrow =
                    (if Dict.get 1 m.term.modes == Just True then
                        "\u{001B}O"

                     else
                        "\u{001B}["
                    )
                        ++ (if up then
                                "A"

                            else
                                "B"
                           )
            in
            send (Bytes.fromString (arrow ++ arrow ++ arrow)) m

    else if up then
        { m | back = min (Vt.scrollbackRows m.term) (m.back + 3), urgent = True }

    else
        { m | back = max 0 (m.back - 3), urgent = True }


{-| The left button selecting (docs/phase3-select.md §14): a press starts
a selection, a second and third within 500 ms on the same cell one by
words and by lines; a motion while it is held moves its head; letting go
makes it the window's PRIMARY, or takes it away when nothing was dragged. -}
selecting : Int -> Window.PointerEvent -> Int -> (taken m : Model) -> Model
selecting ms p held m =
    let
        at =
            pointAt p m
    in
    if p.button == m.config.pasteButton && p.action == 0 then
        -- the paste button (docs/user/copy-and-paste.md), PRIMARY, or
        -- the clipboard where it is the selection (WS27.2)
        { m | held = held, toPaste = Just (pasteFrom m.config Window.Primary) }

    else if p.button == 1 && p.action == 0 then
        let
            count =
                if ms - m.clicks.at <= 500 && m.clicks.cell == at then
                    modBy 3 m.clicks.count + 1

                else
                    1

            span =
                if count == 2 then
                    Vt.wordAt m.wordBoundaries at m.term

                else if count == 3 then
                    Vt.lineAt at m.term

                else
                    Just { start = at, end = at }

            sel =
                Maybe.map
                    (\w ->
                        { anchor = w.start
                        , head = w.end
                        , first = w.start
                        , last = w.end
                        , mode = count - 1
                        , moved = count > 1
                        , made = False
                        , alt = m.term.alt
                        , hashes = Dict.empty
                        }
                    )
                    span
        in
        { m | held = held, selection = sel, clicks = { at = ms, count = count, cell = at }, urgent = True }

    else if p.action == 2 && Bitwise.and held 2 /= 0 then
        when m.selection is
            Just s ->
                if s.made then
                    { m | held = held }

                else
                    { m | held = held, selection = Just (extended at s m), urgent = True }

            Nothing ->
                { m | held = held }

    else if p.button == 1 && p.action == 1 then
        when m.selection is
            Just s ->
                if s.made then
                    { m | held = held }

                else if s.mode == 0 && not s.moved then
                    -- a click: no selection
                    { m | held = held, selection = Nothing, urgent = True }

                else
                    let
                        text =
                            Vt.selectionText s.anchor s.head m.term
                    in
                    { m
                        | held = held
                        , selection = Just { s | made = True, hashes = rowHashes s m.term }
                        , toOwn = Just { which = Window.Primary, text = text }
                    }

            Nothing ->
                { m | held = held }

    else
        { m | held = held }


{-| A selection being dragged, its head at `at`: by cells, at it; by words
or lines, the word or line there, the first one kept on the far side. -}
extended : Vt.Point -> Selection -> Model -> Selection
extended at s m =
    if s.mode == 0 then
        { s | head = at, moved = True }

    else
        let
            span =
                if s.mode == 1 then
                    Vt.wordAt m.wordBoundaries at m.term

                else
                    Vt.lineAt at m.term

            w =
                Maybe.withDefault { start = at, end = at } span
        in
        if before w.start s.first then
            { s | anchor = s.last, head = w.start }

        else
            { s | anchor = s.first, head = w.end }


before : Vt.Point -> Vt.Point -> Bool
before a b =
    a.row < b.row || (a.row == b.row && a.col < b.col)


{-| The point under the pointer, kept on the screen (a drag past its edge
does not scroll the view yet). -}
pointAt : Window.PointerEvent -> Model -> Vt.Point
pointAt p m =
    let
        cw =
            max 1 p.cellWidth

        ch =
            max 1 p.cellHeight

        col =
            clamp 0 (m.term.cols - 1) (if p.x < 0 then 0 else p.x // cw)

        y =
            clamp 0 (m.term.rows - 1) (if p.y < 0 then 0 else p.y // ch)
    in
    { row = Vt.rowsPushed m.term + y - viewBack m, col = col }


{-| How far back the view is drawn: none while the alternate screen is up. -}
viewBack : Model -> Int
viewBack m =
    min m.back (Vt.scrollbackRows m.term)


{-| A hash of each of a selection's rows on the screen, by its row. -}
rowHashes : Selection -> Vt.Term -> Dict Int Int
rowHashes s t =
    let
        pushed =
            Vt.rowsPushed t

        lo =
            max pushed (min s.anchor.row s.head.row)

        hi =
            min (pushed + t.rows - 1) (max s.anchor.row s.head.row)
    in
    Array.foldl (\r d -> Dict.set r (Vt.rowsHash r r t) d) Dict.empty (Array.range lo hi)


{-| The selection after output: kept while the screen is the one it was
made on and none of its rows still on the screen changed (rows that have
scrolled off do not change). -}
kept : Maybe Selection -> Vt.Term -> Maybe Selection
kept sel t =
    when sel is
        Nothing ->
            Nothing

        Just s ->
            if s.alt /= t.alt then
                Nothing

            else if not s.made then
                sel

            else
                let
                    pushed =
                        Vt.rowsPushed t

                    same =
                        Dict.foldl (\r h ok -> ok && (r < pushed || Vt.rowsHash r r t == h)) True s.hashes
                in
                if same then
                    sel

                else
                    Nothing


{-| The cells a selection covers on the screen drawn, for the view. -}
highlightOf : Model -> View.Highlight
highlightOf m =
    when m.selection is
        Nothing ->
            View.noHighlight

        Just s ->
            let
                a =
                    if before s.head s.anchor then
                        s.head

                    else
                        s.anchor

                b =
                    if before s.head s.anchor then
                        s.anchor

                    else
                        s.head

                top =
                    Vt.rowsPushed m.term - viewBack m

                cols =
                    m.term.cols

                last =
                    cols * m.term.rows - 1

                from =
                    if a.row < top then
                        0

                    else
                        (a.row - top) * cols + a.col

                to =
                    (b.row - top) * cols + b.col
            in
            if to < 0 || from > last then
                View.noHighlight

            else
                { from = from, to = min last to }


{-| A press of the wheel up or down with Ctrl alone: a zoom's step. -}
isZoomStep : Window.PointerEvent -> Bool
isZoomStep p =
    p.action == 0 && (p.button == 4 || p.button == 5) && Bitwise.and p.mods 15 == 2


stepOf : Window.PointerEvent -> Int
stepOf p =
    if p.button == 4 then
        1

    else
        -1


{-| The zoom's steps that follow one in the same take, summed, and the
events after them: a touchpad's stroke sends several, and the window is
sized once. A motion between them, which X sends as the pointer drifts, is
passed over. -}
zoomSteps : Array Window.Event -> Int -> { net : Int, rest : Array Window.Event }
zoomSteps evs net =
    when Array.first evs is
        Just (Window.Pointer p) ->
            if isZoomStep p then
                zoomSteps (Array.dropFirst 1 evs) (net + stepOf p)

            else if p.action == 2 then
                zoomSteps (Array.dropFirst 1 evs) net

            else
                { net = net, rest = evs }

        _ ->
            { net = net, rest = evs }


lowestHeld : Int -> Int -> Int
lowestHeld held i =
    if i > 11 then
        0

    else if Bitwise.and held (Bitwise.shiftLeftBy i 1) /= 0 then
        i

    else
        lowestHeld held (i + 1)


{-| A key sent to the program, the cursor's blink begun again. -}
key : Backend -> Int -> Array Window.Event -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
key remote ms rest k m =
    let
        -- under tmux control mode, by the active pane's modes (docs/tmux.md TM16)
        bytes =
            if TmuxMode.isOn m.tmux then
                Maybe.withDefault Bytes.empty (TmuxMode.encodeKey k m.tmux)

            else
                Keys.encode m.term k

        blinkAt =
            if blinking m then
                ms + m.config.blinkMs

            else
                -1

        focus =
            { focused = m.focus.focused, blinkOn = True }
    in
    handle remote ms rest
        (sendKey k bytes ms
            { m
                | urgent = True
                , focus = focus
                , blinkAt = blinkAt
                , -- a key that reaches the program brings the view to the bottom
                  back =
                    if Bytes.isEmpty bytes then
                        m.back

                    else
                        0
            }
        )


{-| Where a paste of PRIMARY reads from (`docs/windows.md` WS27.2): the
clipboard when a selection is copied to it and PRIMARY is puritty's own,
as on Windows, so that what another program copied is pasted by the
middle button and Shift+Insert, as PuTTY's are on Windows; PRIMARY where
the desktop shares it (X), as PuTTY's are there. -}
pasteFrom : Config -> Window.Selection -> Window.Selection
pasteFrom config which =
    if which == Window.Primary && config.copyToClipboard && not Platform.sharedPrimary then
        Window.Clipboard

    else
        which


{-| The paste keys, pressed (docs/user/copy-and-paste.md): Shift+Insert
pastes PRIMARY, Ctrl+Shift+V CLIPBOARD. -}
isPasteKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Window.Selection
isPasteKey config k =
    if k.action /= 1 then
        Nothing

    else if bound config.keyPasteSelection k then
        Just Window.Primary

    else if bound config.keyPaste k then
        Just Window.Clipboard

    else
        Nothing


{-| Ctrl+Shift+F: the search bar (docs/phase3-select.md §23). -}
isSearchKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
isSearchKey config k =
    k.action == 1 && bound config.keySearch k


{-| A key while the search bar is open: Esc closes it; Enter finds the
next match older, Shift+Enter newer; Backspace and typed text change the
query, which is looked for again from the bottom of the view up. -}
searchKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Model
searchKey k m =
    when m.search is
        Nothing ->
            m

        Just s ->
            let
                viewBottom =
                    Vt.rowsPushed m.term - viewBack m + m.term.rows - 1

                typed =
                    Bytes.toStringLossy k.text

                ctrl =
                    Bitwise.and k.mods 2 /= 0
            in
            if k.sym == 0xFF1B then
                { m | search = Nothing, urgent = True }

            else if k.sym == 0xFF0D || k.sym == 0xFF8D then
                let
                    older =
                        Bitwise.and k.mods 1 == 0

                    from =
                        when s.match is
                            Just mt ->
                                if older then mt.start.row - 1 else mt.start.row + 1

                            Nothing ->
                                viewBottom
                in
                found s (Search.find s.query older from m.term) m

            else if k.sym == 0xFF08 then
                let
                    query =
                        String.dropLast 1 s.query
                in
                found { s | query = query } (Search.find query True viewBottom m.term) m

            else if typed /= "" && not ctrl && Array.all (\c -> Char.toCode c >= 0x20) (String.toArray typed) then
                let
                    query =
                        s.query ++ typed
                in
                found { s | query = query } (Search.find query True viewBottom m.term) m

            else
                m


{-| A search's match shown: the view scrolled to it, and it selected, so it
is highlighted and a copy takes it. -}
found : Search.State -> Maybe { start : Vt.Point, end : Vt.Point } -> (taken m : Model) -> Model
found s match m =
    when match is
        Just mt ->
            let
                sel =
                    { anchor = mt.start, head = mt.end, first = mt.start, last = mt.end, mode = 0, moved = True, made = True, alt = m.term.alt, hashes = Dict.empty }

                hashes =
                    rowHashes sel m.term

                back =
                    Search.backFor mt.start.row m.back m.term
            in
            { m | search = Just { s | match = Just mt, failed = False }, selection = Just { sel | hashes = hashes }, back = back, urgent = True }

        Nothing ->
            { m | search = Just { s | failed = s.query /= "" }, urgent = True }


{-| What puritty draws over the cells is sized by: the window in cells and
a cell in pixels. -}
overlaySize : Model -> { cols : Int, rows : Int, cellWidth : Int, cellHeight : Int }
overlaySize m =
    { cols = m.term.cols, rows = m.term.rows, cellWidth = m.term.config.cellWidth, cellHeight = m.term.config.cellHeight }


{-| Whether the scrollbar shows: while the view is scrolled back or the
search bar is open, on puritty's terminal, not its own screen or tmux's. -}
barShown : Model -> Bool
barShown m =
    not (TmuxMode.isOn m.tmux) && not (ownScreenUp m) && Vt.scrollbackRows m.term > 0 && (viewBack m > 0 || m.search /= Nothing)


{-| Ctrl+Shift+C, pressed: the copy key (docs/user/copy-and-paste.md). -}
isCopyKey : Config -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Bool
isCopyKey config k =
    k.action == 1 && bound config.keyCopy k


{-| The keys that move a view of the scrollback (docs/phase3-select.md
§11), on the main screen, pressed or repeated: with Shift alone, PgUp and
PgDn a page, Home the top, End the bottom; with Ctrl and Shift, Up and Down
the shell's previous and next prompt, as Ghostty's `jump_to_prompt`. On the
alternate screen they are the program's, as in Alacritty and WezTerm. -}
scrollKeyOf : Model -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Int
scrollKeyOf m k =
    let
        most =
            Vt.scrollbackRows m.term
    in
    if k.action == 0 || most == 0 then
        Nothing

    else if Bitwise.and k.mods 15 == 3 && (k.sym == 0xFF52 || k.sym == 0xFF54) then
        Just
            (Vt.promptJump
                (if k.sym == 0xFF52 then
                    -1

                 else
                    1
                )
                m.back
                m.term
            )

    else if Bitwise.and k.mods 15 /= 1 then
        Nothing

    else if k.sym == 0xFF55 then
        Just (min most (m.back + m.term.rows))

    else if k.sym == 0xFF56 then
        Just (max 0 (m.back - m.term.rows))

    else if k.sym == 0xFF50 then
        Just most

    else if k.sym == 0xFF57 then
        Just 0

    else
        Nothing


{-| The zoom's keys (V50): Ctrl with `=` or `+` a point larger, with `-` a
point smaller, with `0` the configured size; pressed or repeated, without
alt or super. Any other key is the program's. -}
zoomOf : Model -> { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Maybe Int
zoomOf m k =
    if k.action == 0 || Bitwise.and k.mods 2 == 0 || Bitwise.and k.mods 12 /= 0 then
        Nothing

    else if k.sym == 0x3D || k.sym == 0x2B || k.sym == 0xFFAB then
        Just (min 96 (m.points + 1))

    else if k.sym == 0x2D || k.sym == 0xFFAD then
        Just (max 4 (m.points - 1))

    else if k.sym == 0x30 then
        Just m.config.points

    else
        Nothing


imeLine : Bool -> String -> Task x {}
imeLine on line =
    if on then
        Console.write (line ++ "\n")

    else
        Task.succeed {}


{-| A frame drawn, and the window's title made the program's. -}
draw : Int -> (taken m : Model) -> Task x Model
draw ms m =
    let
        preedit =
            { text = String.fromArray (Array.mapAndKeepJust Char.fromCode m.preedit.points)
            , feedback = m.preedit.feedback
            , caret = m.preedit.caret
            }

        -- the alternate screen keeps no scrollback, so a view scrolled
        -- back shows the screen while it is up
        back =
            viewBack m

        highlight =
            highlightOf m

        ownUp =
            ownScreenUp m

        overlay =
            overlaySize m

        -- a question asked in a box over puritty's screen (SC23)
        dialog =
            if m.closing /= Nothing then
                Maybe.map closeBox m.closing

            else if m.renaming /= Nothing then
                Maybe.map renameBox m.renaming

            else if m.coloring /= Nothing then
                Just (colorBox m)

            else if ownUp then
                Maybe.andThen dialogOf m.ssh

            else if tmuxOn then
                -- a prompt of tmux's in puritty's look (docs/tmux.md TM25)
                TmuxMode.promptBox m.tmux
                    |> Maybe.map
                        (\p ->
                            { title = p.title
                            , lines = []
                            , field = if p.field then Just { typed = p.typed, hidden = False, caret = p.caret } else Nothing
                            , swatches = []
                            , buttons = []
                            , hint = p.hint
                            }
                        )

            else
                Nothing

        boxed =
            dialog /= Nothing

        own =
            if ownUp then
                Maybe.map (ownTerm m boxed) m.ssh

            else
                Nothing

        -- the tab bar, in the window's last row (docs/tabs.md TB1)
        tabsDrawn =
            tabBar m

        -- the scrollbar and the search bar (docs/phase3-select.md §23)
        bar =
            if barShown m then
                Dialog.scrollbar overlay { back = viewBack m, most = Vt.scrollbackRows m.term }

            else
                Bytes.empty

        searchDrawn =
            if ownUp || tmuxOn then
                Nothing

            else
                Maybe.map
                    (\s -> Dialog.searchBar overlay { query = s.query, note = if s.failed then "No match" else "Enter: older    Shift+Enter: newer    Esc: close", failed = s.failed })
                    m.search

        -- every cell drawn while anything is over them, and in the frame
        -- the last of it goes: a scroll's copy would carry it along
        over =
            boxed || not (Bytes.isEmpty bar) || searchDrawn /= Nothing

        shadow0 =
            if over || m.overlaid then
                View.shadowIn m.term.cols m.term.rows m.windowRows

            else
                m.shadow

        boxDrawn =
            Maybe.map (Dialog.draw overlay) dialog

        tmuxOn =
            TmuxMode.isOn m.tmux

        -- under tmux control mode the window is its panes (docs/tmux.md TM14)
        tmux =
            if tmuxOn then
                TmuxMode.paint m.tmux

            else
                m.tmux

        spot =
            View.preeditSpot preedit (if tmuxOn then tmux.canvas else m.term)

        title =
            (if tmuxOn then
                TmuxMode.title tmux

             else if ownUp then
                -- puritty's own while its screen is up, which no server can set
                "puritty: ssh to " ++ (m.ssh |> Maybe.map .host |> Maybe.withDefault "")

             else if m.term.title == "" then
                m.config.title

             else
                m.term.title
            )
                ++ (if m.replaced > 0 then
                        " [" ++ String.fromInt m.replaced ++ " characters sent as ?]"

                    else
                        ""
                   )
                ++ (when Array.first m.troubles is
                        Just first ->
                            " [settings: "
                                ++ first
                                ++ (if Array.length m.troubles > 1 then
                                        " (and " ++ String.fromInt (Array.length m.troubles - 1) ++ " more)"

                                    else
                                        ""
                                   )
                                ++ "]"

                        Nothing ->
                            ""
                   )

        f =
            if tmuxOn then
                View.frameWith m.look m.focus preedit View.noHighlight tmux.canvas shadow0

            else
                when { own = own, menu = m.menu } is
                    { own = Just t } ->
                        View.frameWith m.look m.focus { text = "", feedback = [], caret = 0 } View.noHighlight t shadow0

                    { menu = Just menu } ->
                        -- the menu painted over a copy of the screen (ST26)
                        View.frameBack m.look m.focus 0 (Vt.viewPainted (menuPaints menu m.term.cols m.term.rows) m.term) highlight m.term shadow0

                    _ ->
                        if back > 0 then
                            View.frameBack m.look m.focus back (Vt.viewAt back m.term) highlight m.term shadow0

                        else
                            View.frameWith m.look m.focus preedit highlight m.term shadow0
    in
    Window.draw (Bytes.flatten [ f.list, tabsDrawn, bar, Maybe.withDefault Bytes.empty (Maybe.map .list searchDrawn), Maybe.withDefault Bytes.empty (Maybe.map .list boxDrawn) ])
        |> Task.andThen (\up -> Window.spot (Maybe.withDefault (Maybe.withDefault spot (Maybe.map .spot searchDrawn)) (Maybe.map .spot boxDrawn)) |> Task.map (\_ -> up))
        |> Task.andThen
            (\up ->
                (if title /= m.title then
                    Window.setTitle title

                 else
                    Task.succeed {}
                )
                    |> Task.map
                        (\_ ->
                            let
                                shadow =
                                    View.inked (Maybe.withDefault Bytes.empty up) f.shadow

                                -- The view asks for a frame at once when new
                                -- ink lands on a glyph it did not draw (V40).
                                again =
                                    View.wantsFrame shadow
                            in
                            { m
                                | shadow = shadow
                                , tmux = tmux
                                , overlaid = over
                                , last = ms
                                , pending = -1
                                , urgent = again
                                , title = title
                                , lost = m.lost || up == Nothing
                                -- A hold that timed out begins again at the next read.
                                , syncSince = -1
                            }
                        )
            )


-- TABS (docs/tabs.md)


{-| What a tab key asks. -}
type TabAction
    = NewTab
    | CloseTab
    | NextTab
    | PrevTab
    | MoveRight
    | MoveLeft
    | RenameTab
    | ColorTab
    | ReopenTab
    | MarkLog


{-| The tab keys, as the `[keys]` table names them (docs/tabs.md TB1,
TB6), by default Ctrl+Shift+T a new tab, Ctrl+Shift+W the shown one
closed, Ctrl+Shift+R renamed, Ctrl+PgUp and Ctrl+PgDn the tab before and
after, Ctrl+Shift+PgUp and Ctrl+Shift+PgDn the shown tab moved. Under tmux
control mode, `new_tab`, `next_tab` and `previous_tab` are tmux's windows'
(TM18), and `next_tab_always` and `previous_tab_always` (Ctrl+Alt+PgUp
and PgDn) go between puritty's tabs. With one tab, a key that needs
another goes on to the program; so does a key whose entry is empty. When
two entries name one key, the first in this order has it. -}
tabAction : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> Model -> Maybe TabAction
tabAction k m =
    let
        keys =
            m.config

        tmuxOn =
            TmuxMode.isOn m.tmux

        others =
            tabCount m > 1

        on name =
            bound name k
    in
    if k.action /= 1 then
        Nothing

    else if on keys.keyNewTab && not tmuxOn then
        Just NewTab

    else if on keys.keyCloseTab then
        Just CloseTab

    else if on keys.keyRenameTab then
        Just RenameTab

    else if on keys.keyColorTab then
        Just ColorTab

    else if on keys.keyReopenTab && closedWaiting m then
        Just ReopenTab

    else if on keys.keyMarkLog && Diag.isOn m.diag then
        Just MarkLog

    else if others && on keys.keyNextTabAlways then
        Just NextTab

    else if others && on keys.keyPreviousTabAlways then
        Just PrevTab

    else if others && not tmuxOn && on keys.keyNextTab then
        Just NextTab

    else if others && not tmuxOn && on keys.keyPreviousTab then
        Just PrevTab

    else if others && on keys.keyMoveTabRight then
        Just MoveRight

    else if others && on keys.keyMoveTabLeft then
        Just MoveLeft

    else
        Nothing


tabDo : TabAction -> (taken m : Model) -> Task Error Model
tabDo action m =
    when action is
        NewTab ->
            openTab m

        CloseTab ->
            askClose m

        NextTab ->
            Task.succeed (showTab (neighborId 1 m) m)

        PrevTab ->
            Task.succeed (showTab (neighborId -1 m) m)

        MoveRight ->
            Task.succeed (moveShown 1 m)

        MoveLeft ->
            Task.succeed (moveShown -1 m)

        RenameTab ->
            Task.succeed (startRenaming m)

        ColorTab ->
            Task.succeed (startColoring m)

        ReopenTab ->
            reopenTab m

        MarkLog ->
            markLog m


tabCount : Model -> Int
tabCount m =
    Array.length m.order


{-| The bar's rows: one while there are two tabs or more, or always
(`[tabs] bar`). -}
barRows : Model -> Int
barRows m =
    if tabCount m > 1 || m.config.tabsBar == "always" then 1 else 0


{-| Where the shown tab is in the bar's order. -}
shownAt : Model -> Int
shownAt m =
    Array.findFirst (\id -> id == m.tab.id) m.order |> Maybe.map .index |> Maybe.withDefault 0


{-| The id `by` places along from the shown tab, round past the ends. -}
neighborId : Int -> Model -> Int
neighborId by m =
    let
        n =
            max 1 (Array.length m.order)
    in
    Array.get (modBy n (shownAt m + by)) m.order |> Maybe.withDefault m.tab.id


{-| The slot a tab not shown is in. -}
slotOf : Int -> Model -> Maybe Int
slotOf id m =
    slotFrom id 0 m


slotFrom : Int -> Int -> Model -> Maybe Int
slotFrom id i m =
    if i >= Builder.length m.tabs then
        Nothing

    else if (Builder.get i m.tabs |> Maybe.andThen identity |> Maybe.map (\t -> t.info.id)) == Just id then
        Just i

    else
        slotFrom id (i + 1) m


{-| What the loop needs of each tab not shown: its id, its backend, and
whether its outbox waits. -}
hiddenOf : Model -> Array { id : Int, remote : Backend, writing : Bool }
hiddenOf m =
    hiddenFrom 0 m []


hiddenFrom : Int -> Model -> Array { id : Int, remote : Backend, writing : Bool } -> Array { id : Int, remote : Backend, writing : Bool }
hiddenFrom i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        hiddenFrom (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { id = t.info.id, remote = t.remote, writing = not (Outbox.isEmpty t.out) } acc

                Nothing ->
                    acc
            )


{-| What the bar needs of each tab not shown. -}
labelsOf : Int -> Model -> Array { id : Int, label : String, bell : Bool, activity : Bool, lost : Bool, color : Maybe Int } -> Array { id : Int, label : String, bell : Bool, activity : Bool, lost : Bool, color : Maybe Int }
labelsOf i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        labelsOf (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { id = t.info.id, label = tabLabel t.info t.term.title, bell = t.info.bell, activity = t.info.activity, lost = sessionLost t.ssh, color = tabColorOf m.config t.info } acc

                Nothing ->
                    acc
            )


remotesOf : Model -> Array Backend
remotesOf m =
    Array.map .remote (hiddenOf m)


{-| The shown tab's session exchanged for `t`'s: the model shows `t`, and
the tab it showed is answered. -}
swapTab : (taken t : Tab) -> (taken m : Model) -> { model : Model, old : Tab }
swapTab t m =
    { old =
        { info = m.tab
        , remote = m.remote
        , term = m.term
        , charset = m.charset
        , decoder = m.decoder
        , replaced = m.replaced
        , out = m.out
        , back = m.back
        , selection = m.selection
        , pasting = m.pasting
        , clips = m.clips
        , clipRead = m.clipRead
        , ssh = m.ssh
        , tmux = m.tmux
        , search = m.search
        , syncSince = m.syncSince
        }
    , model =
        { m
            | tab = t.info
            , remote = t.remote
            , term = t.term
            , charset = t.charset
            , decoder = t.decoder
            , replaced = t.replaced
            , out = t.out
            , back = t.back
            , selection = t.selection
            , pasting = t.pasting
            , clips = t.clips
            , clipRead = t.clipRead
            , ssh = t.ssh
            , tmux = t.tmux
            , search = t.search
            , syncSince = t.syncSince
        }
    }


{-| A tab put away by the user: its bells counted as seen, so that only new
ones mark it. -}
putAway : (taken t : Tab) -> Tab
putAway t =
    let
        info =
            t.info
    in
    { t | info = { info | bells = t.term.bells, bell = False, activity = False } }


{-| A tab just shown: its marks gone, and every cell drawn again. -}
afterSwitch : (taken m : Model) -> Model
afterSwitch m =
    let
        info =
            m.tab
    in
    { m
        | tab = { info | bells = m.term.bells, bell = False, activity = False }
        , shadow = View.shadowIn m.term.cols m.term.rows m.windowRows
        , urgent = True
        , menu = Nothing
    }


{-| The tab with this id shown: it comes out of its slot, and the tab shown
goes into it. -}
showTab : Int -> (taken m : Model) -> Model
showTab id m =
    if id == m.tab.id then
        m

    else
        when slotOf id m is
            Just slot ->
                let
                    out =
                        Builder.swap slot Nothing m.tabs
                in
                when out.old |> Maybe.andThen identity is
                    Just t ->
                        let
                            r =
                                swapTab t { m | tabs = out.builder }

                            next =
                                r.model
                        in
                        afterSwitch { next | tabs = Builder.set slot (Just (putAway r.old)) next.tabs }

                    Nothing ->
                        { m | tabs = out.builder }

            Nothing ->
                m


{-| The shown tab moved `by` places along the bar, round past the ends. -}
moveShown : Int -> (taken m : Model) -> Model
moveShown by m =
    let
        at =
            shownAt m

        n =
            Array.length m.order

        to =
            modBy (max 1 n) (at + by)

        without =
            Array.keepIf (\id -> id /= m.tab.id) m.order
    in
    { m | order = Array.slice 0 to without ++ [ m.tab.id ] ++ Array.dropFirst to without, urgent = True }


{-| The shown tab gone, its program ended or killed: the tab after it shown,
or before it at the end; every tab given the window's rows when the bar
goes. -}
dropShown : (taken m : Model) -> Task Error Model
dropShown m =
    dropShownFrom Nothing m


{-| `dropShown`, the tab gone kept to open again (TB11), with the directory
its shell was in when that was read. -}
dropShownFrom : Maybe Path.Path -> (taken m : Model) -> Task Error Model
dropShownFrom dir m =
    let
        at =
            shownAt m

        gone =
            m.tab.id

        nextId =
            if at + 1 < Array.length m.order then neighborId 1 m else neighborId -1 m

        cols =
            m.term.cols
    in
    when slotOf nextId m is
        Just slot ->
            let
                out =
                    Builder.swap slot Nothing m.tabs
            in
            when out.old |> Maybe.andThen identity is
                Just t ->
                    let
                        r =
                            swapTab t { m | tabs = out.builder }

                        next =
                            r.model
                    in
                    now
                        |> Task.andThen (\ms -> relayout cols (afterSwitch (keepClosed { tab = r.old, directory = dir, at = ms } { next | order = Array.keepIf (\id -> id /= gone) next.order })))

                Nothing ->
                    Task.succeed { m | tabs = out.builder }

        Nothing ->
            Task.succeed m


{-| Ctrl+Shift+W: the shown tab's program ended, and its tab gone; with one
tab, the window closes. -}
closeShown : (taken m : Model) -> Task Error Model
closeShown m =
    if tabCount m <= 1 then
        Task.succeed { m | closed = True }

    else
        -- where its shell is, read while it runs, to open it there again
        -- (TB11); none for a host's tab
        (if m.tab.hostName == Nothing then m.remote.directory |> Task.onError (\_ -> Task.succeed Nothing) else Task.succeed Nothing)
            |> Task.andThen
                (\dir ->
                    m.remote.kill
                        |> Task.mapError (\why -> { kind = Os.Error.Other, operation = "kill", path = Nothing, detail = why })
                        |> Task.andThen (\_ -> dropShownFrom dir m)
                )


{-| A terminal for a new tab, at a size, as the window's first was made. -}
freshTerm : Config -> Vt.Term -> Int -> Int -> Vt.Term
freshTerm config like cols rows =
    Vt.new
        { cols = cols
        , rows = rows
        , scrollbackBytes = Vt.scrollbackBytesFor { cols = cols, rows = config.scrollbackLines }
        , pageRows = Vt.defaultPageRows
        , checksums = False
        , cellWidth = like.config.cellWidth
        , cellHeight = like.config.cellHeight
        }
        |> Vt.withPalette config.palette
        |> Vt.withEmbedder (embedderOf config)


isFree : Maybe Tab -> Bool
isFree slot =
    when slot is
        Nothing ->
            True

        Just _ ->
            False


{-| A free slot for a tab put away, or one more. -}
freeSlot : Model -> Int
freeSlot m =
    freeFrom 0 m


freeFrom : Int -> Model -> Int
freeFrom i m =
    if i >= Builder.length m.tabs then
        Builder.length m.tabs

    else if (Builder.get i m.tabs |> Maybe.map isFree) == Just True then
        i

    else
        freeFrom (i + 1) m


{-| Ctrl+Shift+T: a new tab after the last, shown: the local program, or in
a tab of a session to a host, another session to the same host. A program
that does not start is said on standard error, and nothing changes. -}
openTab : (taken m : Model) -> Task Error Model
openTab m =
    openTabWith { directory = Nothing, name = "", color = HostsColor, kept = Nothing } m


{-| A new tab, shown, as `openTab` opens one, named and colored; a local
one in `directory` when given (a restored tab, TB10), else in the shown
tab's; and a closed tab's screen and scrollback over its new program, when
one is `kept` (TB11). -}
openTabWith : (taken with : { directory : Maybe (Maybe Path.Path), name : String, color : TabColor, kept : Maybe Tab }) -> (taken m : Model) -> Task Error Model
openTabWith with m =
    let
        cols =
            m.term.cols

        rows =
            m.windowRows - 1

        host =
            m.tab.host

        -- a local tab starts in the shown one's directory (TB4), or the
        -- program's own when that cannot be read
        here =
            when with.directory is
                Just given ->
                    Task.succeed given

                Nothing ->
                    m.remote.directory |> Task.onError (\_ -> Task.succeed Nothing)

        starting =
            when host is
                Just h ->
                    m.starter.ssh h

                Nothing ->
                    here |> Task.mapError Os.Error.toString |> Task.andThen (\dir -> m.starter.local { columns = cols, rows = rows, directory = dir })
    in
    starting
        |> Task.map Ok
        |> Task.onError (\why -> Task.succeed (Err why))
        |> Task.andThen
            (\started ->
                when started is
                    Err why ->
                        Console.writeErr ("puritty: a new tab did not start: " ++ why ++ "\n") |> Task.map (\_ -> m)

                    Ok remote ->
                        let
                            id =
                                m.nextTabId

                            slot =
                                freeSlot m

                            tab =
                                when with.kept is
                                    Just k ->
                                        reopened k id remote host m

                                    Nothing ->
                                        freshTab id remote host with.name with.color cols rows m

                            r =
                                swapTab tab { m | nextTabId = id + 1, order = Array.pushLast id m.order }

                            next =
                                r.model

                            put =
                                putAway r.old
                        in
                        relayout cols
                            (afterSwitch
                                { next
                                    | tabs =
                                        if slot < Builder.length next.tabs then
                                            Builder.set slot (Just put) next.tabs

                                        else
                                            Builder.pushLast (Just put) next.tabs
                                }
                            )
            )


{-| A new tab's record: its program's backend, a fresh terminal, and the
session's fields as a new tab has them. -}
freshTab : Int -> Backend -> Maybe Config.Host -> String -> TabColor -> Int -> Int -> Model -> Tab
freshTab id remote host name color cols rows m =
    { info = { id = id, name = name, host = host, hostName = m.tab.hostName, color = color, bells = 0, bell = False, activity = False }
    , remote = remote
    , term = freshTerm m.config m.term cols rows
    , charset = if host == Nothing then m.starter.charset else m.charset
    , decoder = Charset.decoder
    , replaced = 0
    , out = Outbox.empty
    , back = 0
    , selection = Nothing
    , pasting = Nothing
    , clips = []
    , clipRead = Nothing
    , ssh = Maybe.map (\h -> { host = h.name, lines = [], asking = Nothing, started = False, failed = Nothing, exitStatus = Nothing }) host
    , tmux = TmuxMode.setLook (m.config.tmuxLook == "tmux") (TmuxMode.setBar (m.config.tmuxTabs == "top") (TmuxMode.idle {}))
    , search = Nothing
    , syncSince = -1
    }


{-| A closed tab opened again (TB11): its terminal, with its screen and
scrollback, its name and color, over a new program's backend; the rest of
its session as a new tab's. The terminal is brought out of what its old
program left it in (the alternate screen, mouse reports, bracketed paste,
the modes DECSTR resets), and a dim line says where the old session
ended. -}
reopened : (taken k : Tab) -> Int -> Backend -> Maybe Config.Host -> Model -> Tab
reopened k id remote host m =
    let
        info =
            k.info

        bells =
            k.term.bells
    in
    { k
        | info = { info | id = id, bell = False, activity = False, bells = bells }
        , remote = remote
        , term = Vt.feed (Bytes.fromString reopenedNote) k.term
        , charset = if host == Nothing then m.starter.charset else m.charset
        , decoder = Charset.decoder
        , replaced = 0
        , out = Outbox.empty
        , back = 0
        , selection = Nothing
        , pasting = Nothing
        , clips = []
        , clipRead = Nothing
        , ssh = Maybe.map (\h -> { host = h.name, lines = [], asking = Nothing, started = False, failed = Nothing, exitStatus = Nothing }) host
        , tmux = TmuxMode.setLook (m.config.tmuxLook == "tmux") (TmuxMode.setBar (m.config.tmuxTabs == "top") (TmuxMode.idle {}))
        , search = Nothing
        , syncSince = -1
    }


reopenedNote : String
reopenedNote =
    "\u{001B}[?1049l\u{001B}[?1000l\u{001B}[?1002l\u{001B}[?1003l\u{001B}[?1006l\u{001B}[?1015l\u{001B}[?1004l\u{001B}[?2004l\u{001B}[!p\u{001B}[0m"
        ++ "\r\n\u{001B}[2m(closed, and opened again)\u{001B}[0m\r\n"


-- CLOSED TABS (docs/tabs.md TB11)


{-| How many closed tabs are kept, and for how long. -}
closedSlots : Int
closedSlots =
    5


closedKeepMs : Int
closedKeepMs =
    10 * 60 * 1000


{-| A closed tab kept: in a free slot, else in the oldest's place. -}
keepClosed : (taken c : Closed) -> (taken m : Model) -> Model
keepClosed c m =
    let
        slot =
            closedSlotFor 0 { at = -1, oldest = 0, oldestAt = -1 } m
    in
    if slot < Builder.length m.closedTabs then
        { m | closedTabs = Builder.set slot (Just c) m.closedTabs }

    else
        { m | closedTabs = Builder.pushLast (Just c) m.closedTabs }


{-| The slot a closed tab goes in: the first free one; one past the last
while there are fewer than `closedSlots`; else the oldest. -}
closedSlotFor : Int -> { at : Int, oldest : Int, oldestAt : Int } -> Model -> Int
closedSlotFor i best m =
    if i >= Builder.length m.closedTabs then
        if Builder.length m.closedTabs < closedSlots then Builder.length m.closedTabs else best.oldest

    else
        when Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map .at is
            Nothing ->
                i

            Just at ->
                closedSlotFor (i + 1) (if best.oldestAt < 0 || at < best.oldestAt then { best | oldest = i, oldestAt = at } else best) m


{-| The slot of the closed tab closed last, if any. -}
newestClosed : Model -> Maybe Int
newestClosed m =
    newestFrom 0 Nothing -1 m


newestFrom : Int -> Maybe Int -> Int -> Model -> Maybe Int
newestFrom i best bestAt m =
    if i >= Builder.length m.closedTabs then
        best

    else
        when Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map .at is
            Just at ->
                if at > bestAt then newestFrom (i + 1) (Just i) at m else newestFrom (i + 1) best bestAt m

            Nothing ->
                newestFrom (i + 1) best bestAt m


{-| Whether a closed tab waits to be opened again. -}
closedWaiting : Model -> Bool
closedWaiting m =
    newestClosed m /= Nothing


{-| When the oldest closed tab is let go, -1 for none. -}
closedDue : Model -> Int
closedDue m =
    closedDueFrom 0 -1 m


closedDueFrom : Int -> Int -> Model -> Int
closedDueFrom i due m =
    if i >= Builder.length m.closedTabs then
        due

    else
        closedDueFrom (i + 1)
            (when Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map .at is
                Just at ->
                    soonest due (at + closedKeepMs)

                Nothing ->
                    due
            )
            m


{-| The closed tabs kept ten minutes let go, their memory with them. -}
expireClosed : Int -> (taken m : Model) -> Model
expireClosed ms m =
    expireFrom 0 ms m


expireFrom : Int -> Int -> (taken m : Model) -> Model
expireFrom i ms m =
    if i >= Builder.length m.closedTabs then
        m

    else if (Builder.get i m.closedTabs |> Maybe.andThen identity |> Maybe.map (\c -> ms >= c.at + closedKeepMs)) == Just True then
        expireFrom (i + 1) ms { m | closedTabs = Builder.set i Nothing m.closedTabs }

    else
        expireFrom (i + 1) ms m


{-| Ctrl+Alt+Shift+T, or the menu's Reopen closed tab: the tab closed last
opened again, shown, after the last; a local one in the directory its shell
was in, else in the shown tab's; a host's, a new session to the host. -}
reopenTab : (taken m : Model) -> Task Error Model
reopenTab m =
    when newestClosed m is
        Just slot ->
            let
                out =
                    Builder.swap slot Nothing m.closedTabs
            in
            when out.old |> Maybe.andThen identity is
                Just c ->
                    let
                        name =
                            c.tab.info.name

                        color =
                            c.tab.info.color

                        directory =
                            Maybe.map Just c.directory
                    in
                    openTabWith { directory = directory, name = name, color = color, kept = Just c.tab } { m | closedTabs = out.builder }

                Nothing ->
                    Task.succeed { m | closedTabs = out.builder }

        Nothing ->
            Task.succeed m


{-| Every tab at `cols` by the window's rows, less the bar's while it shows,
its backend and its tmux told; nothing for a tab already that size. -}
relayout : Int -> (taken m : Model) -> Task Error Model
relayout cols m =
    let
        rows =
            m.windowRows - barRows m

        ids =
            Array.map .id (hiddenOf m)
    in
    Array.foldl
        (\id done -> done |> Task.andThen (\next -> atTab id (resizeShown cols rows) next))
        (resizeShown cols rows m)
        ids
        |> Task.map (\next -> { next | shadow = View.shadowIn next.term.cols next.term.rows next.windowRows, urgent = True })


{-| The shown tab at a size: its terminal, its backend and its tmux. -}
resizeShown : Int -> Int -> (taken m : Model) -> Task Error Model
resizeShown cols rows m =
    if m.term.cols == cols && m.term.rows == rows then
        Task.succeed m

    else
        let
            told =
                TmuxMode.resized { cols = cols, rows = rows } m.tmux
        in
        m.remote.resize { columns = cols, rows = rows }
            |> Task.map (\_ -> sendCommands told.commands { m | term = Vt.resize cols rows m.term, tmux = told.state, urgent = True, back = 0, selection = Nothing })


{-| `work` done on a tab not shown, as if it were (docs/tabs.md TB2): it is
swapped in, worked on with the code every tab's session goes through, and
swapped out again to its slot. -}
atTab : Int -> (Model -> Task Error Model) -> (taken m : Model) -> Task Error Model
atTab id work m =
    when slotOf id m is
        Just slot ->
            let
                out =
                    Builder.swap slot Nothing m.tabs
            in
            when out.old |> Maybe.andThen identity is
                Just t ->
                    let
                        r =
                            swapTab t { m | tabs = out.builder }

                        wasShown =
                            r.old
                    in
                    work r.model
                        |> Task.map
                            (\worked ->
                                let
                                    back =
                                        swapTab wasShown worked

                                    restored =
                                        back.model
                                in
                                { restored | tabs = Builder.set slot (Just back.old) restored.tabs }
                            )

                Nothing ->
                    Task.succeed { m | tabs = out.builder }

        Nothing ->
            Task.succeed m


{-| What a tab not shown read: its terminal fed, and its marks set; its
program's end closes it. -}
behind : Int -> Incoming -> Int -> (taken m : Model) -> Task Error Model
behind id incoming ms m =
    when incoming is
        Data chunk ->
            if Bytes.length chunk == 0 then
                endTab id False m

            else
                atTab id (\one -> feed one.remote chunk ms one |> Task.map (marked ms)) { m | urgent = True }

        Notice told ->
            if endsSession told (sshOfTab id m) then
                endTab id True m

            else
                atTab id (\one -> sshTold told one |> Task.map (marked ms)) { m | urgent = True }


{-| The ssh screen of the tab `id`, not shown. -}
sshOfTab : Int -> Model -> Maybe SshScreen
sshOfTab id m =
    slotOf id m
        |> Maybe.andThen (\slot -> Builder.get slot m.tabs)
        |> Maybe.andThen identity
        |> Maybe.andThen .ssh


{-| A tab that printed while not shown: marked so, and as having rung when
its terminal's bells moved. In the first three seconds of a restored
window, what its tabs print as they start (their prompts) is not marked,
so that the bar does not open with every tab lit (TB10); a bell is. -}
marked : Int -> (taken m : Model) -> Model
marked ms m =
    let
        info =
            m.tab
    in
    { m | tab = { info | activity = info.activity || ms >= m.quietUntil, bell = info.bell || m.term.bells /= info.bells, bells = m.term.bells } }


{-| A tab not shown gone: its program killed (`kill`) or ended, and waited
for. -}
endTab : Int -> Bool -> (taken m : Model) -> Task Error Model
endTab id kill m =
    when slotOf id m is
        Just slot ->
            let
                out =
                    Builder.swap slot Nothing m.tabs

                cols =
                    m.term.cols

                rest =
                    { m | tabs = out.builder, order = Array.keepIf (\i -> i /= id) m.order }
            in
            when out.old |> Maybe.andThen identity is
                Just t ->
                    let
                        ending =
                            if kill then t.remote.kill else t.remote.waitForExit |> Task.map (\_ -> {})
                    in
                    ending
                        |> Task.mapError (\why -> { kind = Os.Error.Other, operation = "end", path = Nothing, detail = why })
                        |> Task.andThen (\_ -> now)
                        |> Task.andThen (\ms -> relayout cols (keepClosed { tab = t, directory = Nothing, at = ms } rest))

                Nothing ->
                    Task.succeed rest

        Nothing ->
            Task.succeed m


-- THE BAR


{-| What a tab shows: the name given it, else its host's, else its
program's title, else "shell", with `! ` once it rang. -}
tabLabel : TabInfo -> String -> String
tabLabel info title =
    let
        base =
            if info.name /= "" then
                info.name

            else
                when info.host is
                    Just h ->
                        h.name

                    Nothing ->
                        if title /= "" then String.takeFirst 24 (shortTitle title) else "shell"
    in
    (if info.bell then "! " else "") ++ base


{-| A title that begins with a Windows program's path, as `cmd.exe`'s does
(`C:\WINDOWS\system32\cmd.exe`, and `... - ping -n 30 127.0.0.1` while a
command runs), with the path cut to the program's name: `cmd`, `cmd - ping
-n 30 127.0.0.1`. Any other title as it is. -}
shortTitle : String -> String
shortTitle title =
    let
        parts =
            String.split " - " title

        first =
            Maybe.withDefault title (Array.first parts)

        name =
            Maybe.withDefault first (Array.last (String.split "\\" first))
    in
    if String.contains "\\" first && String.endsWith ".exe" (String.toLower first) then
        String.join " - " ([ String.dropLast 4 name ] ++ Array.dropFirst 1 parts)

    else
        title


{-| The bar's tabs in its order, where each is in pixels, and how it is
marked. -}
barTabs : Model -> Array { id : Int, label : String, x : Int, w : Int, active : Bool, bell : Bool, activity : Bool, lost : Bool, color : Maybe Int }
barTabs m =
    let
        cw =
            m.term.config.cellWidth

        size =
            max 8 (m.term.config.cellHeight * 3 // 5)

        hidden =
            labelsOf 0 m []

        one id =
            if id == m.tab.id then
                Just { id = id, label = lostMark (sessionLost m.ssh) (tabLabel m.tab m.term.title), active = True, bell = False, activity = False, lost = sessionLost m.ssh, color = tabColorOf m.config m.tab }

            else
                Array.findFirst (\h -> h.id == id) hidden |> Maybe.map (\f -> { id = id, label = lostMark f.value.lost f.value.label, active = False, bell = f.value.bell, activity = f.value.activity, lost = f.value.lost, color = f.value.color })
    in
    Array.foldl
        (\t acc ->
            let
                w =
                    min 400 (Text.width size t.label) + 2 * cw
            in
            { x = acc.x + w + 2
            , out = Array.pushLast { id = t.id, label = t.label, x = acc.x, w = w, active = t.active, bell = t.bell, activity = t.activity, lost = t.lost, color = t.color } acc.out
            }
        )
        { x = 2, out = [] }
        (Array.mapAndKeepJust one m.order)
        |> .out


{-| The bar's records (docs/tabs.md TB1): the window's last row, each tab as
wide as its name, the shown one in puritty's amber, one that rang red, one
that printed with its name lit. A tab with a color (TB9) is filled with
it, the shown one at full strength with a line along its top, the others
darker, and its marks are a dot at its end: red ringed in white for the
bell, its text's color for output. -}
tabBar : Model -> Bytes
tabBar m =
    if barRows m == 0 then
        Bytes.empty

    else
        let
            ch =
                m.term.config.cellHeight

            cw =
                m.term.config.cellWidth

            y =
                m.term.rows * ch

            width =
                m.term.cols * cw

            size =
                max 8 (ch * 3 // 5)

            -- puritty's look: rounded, the shown tab amber; the plain one
            -- (`[tabs] look`): square, a line between, the shown tab light
            plain =
                m.config.tabsLook == "plain"

            barBg =
                if plain then 0x303030 else 0x262626

            shape t fill =
                SettingsGui.box
                    { x = t.x
                    , y = if plain then y else y + 1
                    , w = if plain then t.w + 1 else t.w
                    , h = if plain then ch else ch - 2
                    , r = if plain then 0 else 4
                    , color = fill
                    }

            label t color =
                SettingsGui.text
                    { x = t.x + cw
                    , y = y + (ch + size) // 2 - 1
                    , size = size
                    , color = color
                    , text = t.label
                    }

            plainTab t =
                Bytes.flatten
                    [ shape t
                        (if t.active then
                            if plain then 0xD0D0D0 else 0xFFAF00

                         else if t.bell then
                            0xD70000

                         else if plain then
                            0x444444

                         else
                            0x3A3A3A
                        )
                    , label t
                        (if t.active && t.lost then
                            0x8B0000

                         else if t.active then
                            0x1C1C1C

                         else if t.lost then
                            0xFF6B6B

                         else if t.bell || t.activity then
                            0xFFFFFF

                         else
                            0xBCBCBC
                        )
                    ]

            coloredTab t c =
                let
                    fill =
                        if t.active then c else mix c barBg

                    ink =
                        Dialog.contrast fill

                    dot =
                        max 5 (ch // 3)

                    dotX =
                        t.x + t.w - cw // 2 - dot // 2

                    dotY =
                        y + (ch - dot) // 2
                in
                Bytes.flatten
                    [ shape t fill
                    , if t.active then
                        SettingsGui.box { x = t.x + (if plain then 0 else 3), y = if plain then y else y + 1, w = t.w - (if plain then 0 else 6), h = max 2 (ch // 8), r = 0, color = ink }

                      else
                        Bytes.empty
                    , label t ink
                    , if t.active then
                        Bytes.empty

                      else if t.bell then
                        SettingsGui.framed { x = dotX, y = dotY, w = dot, h = dot, r = dot // 2, color = 0xD70000, border = 0xFFFFFF }

                      else if t.activity then
                        SettingsGui.box { x = dotX, y = dotY, w = dot, h = dot, r = dot // 2, color = ink }

                      else
                        Bytes.empty
                    ]
        in
        Bytes.flatten
            ([ SettingsGui.box { x = 0, y = y, w = width, h = ch, r = 0, color = barBg } ]
                ++ Array.map
                    (\t ->
                        when t.color is
                            Just c ->
                                coloredTab t c

                            Nothing ->
                                plainTab t
                    )
                    (barTabs m)
            )


{-| A tab's color dimmed toward the bar's, for a tab not shown: three
fifths the color. -}
mix : Int -> Int -> Int
mix color toward =
    let
        channel at =
            (3 * Bitwise.and 0xFF (Bitwise.shiftRightZfBy at color) + 2 * Bitwise.and 0xFF (Bitwise.shiftRightZfBy at toward)) // 5
    in
    Bitwise.or (Bitwise.shiftLeftBy 16 (channel 16)) (Bitwise.or (Bitwise.shiftLeftBy 8 (channel 8)) (channel 0))


{-| A press on the bar: the tab under it shown, or with the middle button
closed; a second press on the same tab within half a second renames it. -}
barPress : Int -> Window.PointerEvent -> (taken m : Model) -> Task Error Model
barPress ms p m =
    when Array.findFirst (\t -> p.x >= t.x && p.x < t.x + t.w) (barTabs m) is
        Just hit ->
            if p.button == 3 && m.config.tabsMiddleCloses then
                -- shown first, so that a question is asked over its screen
                askClose (showTab hit.value.id m)

            else if p.button == 1 && hit.value.id == m.barClick.id && ms - m.barClick.at <= 500 then
                let
                    shown =
                        showTab hit.value.id m
                in
                Task.succeed (startRenaming { shown | barClick = { at = -1000, id = -1 } })

            else if p.button == 1 then
                let
                    shown =
                        showTab hit.value.id m
                in
                Task.succeed { shown | barClick = { at = ms, id = hit.value.id } }

            else if p.button == 2 then
                -- the right button: the menu, over the tab it was on, so
                -- that its tab items are that tab's (TB9)
                openMenu p (showTab hit.value.id m)

            else
                Task.succeed (showTab hit.value.id m)

        Nothing ->
            Task.succeed m


{-| The rename box opened over the shown tab. -}
startRenaming : (taken m : Model) -> Model
startRenaming m =
    { m | renaming = Just { id = m.tab.id, typed = m.tab.name }, urgent = True }


-- THE TAB'S COLOR (docs/tabs.md TB9)


{-| The colors the box offers, keys 1 to 8. -}
tabColors : Array Int
tabColors =
    [ 0xC62828, 0xE65100, 0xF9A825, 0x2E7D32, 0x00838F, 0x1565C0, 0x6A1B9A, 0xAD1457 ]


{-| The color a tab is drawn in, if any: the one chosen for it, else its
host's from the settings in force, so that a host's color changed in the
settings window colors its tabs at once. -}
tabColorOf : Config -> TabInfo -> Maybe Int
tabColorOf config info =
    when info.color is
        Picked c ->
            Just c

        NoColor ->
            Nothing

        HostsColor ->
            info.hostName
                |> Maybe.andThen (\name -> Array.findFirst (\h -> h.name == name) config.hosts)
                |> Maybe.andThen (\entry -> entry.value.tab)


{-| The color box opened over the shown tab. -}
startColoring : (taken m : Model) -> Model
startColoring m =
    { m | coloring = Just m.tab.id, urgent = True }


{-| What each swatch of the box chooses: the eight colors, none, and the
host's own for a tab that has a host. -}
colorChoices : Model -> Array TabColor
colorChoices m =
    Array.map Picked tabColors
        ++ [ NoColor ]
        ++ (if m.tab.hostName /= Nothing then [ HostsColor ] else [])


{-| The color box (docs/tabs.md TB9): the colors as swatches, the one in
use framed. It is opened over the shown tab, and is for it. -}
colorBox : Model -> Dialog.Dialog
colorBox m =
    let
        info =
            m.tab

        hostOwn =
            tabColorOf m.config { info | color = HostsColor }

        swatch choice =
            when choice is
                Picked c ->
                    { color = c, label = String.fromInt (1 + (Array.findFirst (\x -> x == c) tabColors |> Maybe.map .index |> Maybe.withDefault 0)), marked = info.color == choice }

                NoColor ->
                    { color = 0x3A3A3A, label = "0", marked = info.color == NoColor || (info.color == HostsColor && hostOwn == Nothing) }

                HostsColor ->
                    { color = Maybe.withDefault 0x3A3A3A hostOwn, label = "H", marked = info.color == HostsColor && hostOwn /= Nothing }
    in
    { title = "The tab's color"
    , lines =
        when info.hostName is
            Just name ->
                [ "H gives it the color of " ++ name ++ "'s tabs in the settings." ]

            Nothing ->
                [ "A color for this tab in the bar." ]
    , field = Nothing
    , swatches = Array.map swatch (colorChoices m)
    , buttons = []
    , hint =
        if info.hostName /= Nothing then
            "1–8: a color    0: none    H: the host's    Esc: cancel"

        else
            "1–8: a color    0: none    Esc: cancel"
    }


{-| A key in the color box: a swatch's key chooses it, any other closes
the box. -}
colorKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
colorKey k m =
    let
        typed =
            String.toLower (Bytes.toStringLossy k.text)

        choices =
            colorChoices m

        chosen =
            if Bitwise.and k.mods 2 /= 0 then
                Nothing

            else if typed == "0" then
                Just NoColor

            else if typed == "h" && m.tab.hostName /= Nothing then
                Just HostsColor

            else
                String.toInt typed |> Maybe.andThen (\n -> if n >= 1 && n <= 8 then Array.get (n - 1) choices else Nothing)
    in
    when chosen is
        Just choice ->
            colorTab choice m

        Nothing ->
            -- a modifier alone, as Shift for an H, leaves the box up
            if String.isEmpty typed && k.sym /= 0xFF1B && k.sym /= 0xFF0D && k.sym /= 0xFF8D then
                Task.succeed m

            else
                Task.succeed { m | coloring = Nothing, urgent = True }


{-| A press while the color box is up: on a swatch, its color; anywhere
else the box closes. -}
colorPress : Window.PointerEvent -> (taken m : Model) -> Task Error Model
colorPress p m =
    let
        box =
            colorBox m

        hit =
            if p.button == 1 then
                Dialog.swatchAt (overlaySize m) box { x = p.x, y = p.y } |> Maybe.andThen (\i -> Array.get i (colorChoices m))

            else
                Nothing
    in
    when hit is
        Just choice ->
            colorTab choice m

        Nothing ->
            Task.succeed { m | coloring = Nothing, urgent = True }


{-| The tab the box is for given a color, and the box closed. -}
colorTab : TabColor -> (taken m : Model) -> Task Error Model
colorTab choice m =
    when m.coloring is
        Just id ->
            if id == m.tab.id then
                let
                    info =
                        m.tab
                in
                Task.succeed { m | tab = { info | color = choice }, coloring = Nothing, urgent = True }

            else
                atTab id
                    (\x ->
                        let
                            info =
                                x.tab
                        in
                        Task.succeed { x | tab = { info | color = choice } }
                    )
                    { m | coloring = Nothing, urgent = True }

        Nothing ->
            Task.succeed m


{-| The rename box (docs/tabs.md TB1 item 4): the name typed so far. -}
renameBox : { id : Int, typed : String } -> Dialog.Dialog
renameBox r =
    { title = "Rename the tab"
    , lines = [ "An empty name gives the program's own title back." ]
    , field = Just { typed = r.typed, hidden = False, caret = String.count r.typed }
    , swatches = []
    , buttons = []
    , hint = "Enter: rename    Esc: cancel"
    }


{-| A key in the rename box: Enter names the tab, Esc leaves it, Backspace
takes a letter back, and text is typed in. -}
renameKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
renameKey k m =
    when m.renaming is
        Nothing ->
            Task.succeed m

        Just r ->
            if k.sym == 0xFF1B then
                Task.succeed { m | renaming = Nothing, urgent = True }

            else if k.sym == 0xFF0D || k.sym == 0xFF8D then
                nameTab r.id (String.trim r.typed) { m | renaming = Nothing, urgent = True }

            else if k.sym == 0xFF08 then
                Task.succeed { m | renaming = Just { r | typed = String.dropLast 1 r.typed }, urgent = True }

            else if Bitwise.and k.mods 2 == 0 then
                Task.succeed (renameTyped (Bytes.toStringLossy k.text) m)

            else
                Task.succeed m


{-| Text typed or committed by the IME into the rename box; control
characters dropped, and the name kept to 40 characters. -}
renameTyped : String -> (taken m : Model) -> Model
renameTyped text m =
    when m.renaming is
        Just r ->
            let
                clean =
                    String.fromArray (Array.keepIf (\c -> Char.toCode c >= 32 && Char.toCode c /= 127) (String.toArray text))
            in
            { m | renaming = Just { r | typed = String.takeFirst 40 (r.typed ++ clean) }, urgent = True }

        Nothing ->
            m


{-| The tab `id` given the user's name; an empty one gives the program's
title back. -}
nameTab : Int -> String -> (taken m : Model) -> Task Error Model
nameTab id name m =
    if id == m.tab.id then
        let
            info =
                m.tab
        in
        Task.succeed { m | tab = { info | name = name } }

    else
        atTab id
            (\x ->
                let
                    info =
                        x.tab
                in
                Task.succeed { x | tab = { info | name = name } }
            )
            m


{-| Closing the shown tab, asked first when it matters (docs/tabs.md TB4):
its ssh session open, or a program running in front of its shell. An idle
shell closes at once, and so does every tab with `[tabs]
ask_before_closing` off. When puritty cannot tell, it asks, saying why. -}
askClose : (taken m : Model) -> Task Error Model
askClose m =
    let
        open =
            when m.ssh is
                Just screen ->
                    if screen.started && screen.exitStatus == Nothing && screen.failed == Nothing then
                        Just screen.host

                    else
                        Nothing

                Nothing ->
                    Nothing

        busy =
            m.remote.busy

        id =
            m.tab.id
    in
    if not m.config.tabsAskBeforeClosing then
        closeShown m

    else
        when open is
            Just host ->
                Task.succeed { m | closing = Just { id = id, why = "Its ssh session to " ++ cleanText host ++ " is open.", window = False }, urgent = True }

            Nothing ->
                busy
                    |> Task.map Ok
                    |> Task.onError (\e -> Task.succeed (Err e))
                    |> Task.andThen
                        (\got ->
                            when got is
                                Ok Nothing ->
                                    closeShown m

                                Ok (Just name) ->
                                    Task.succeed
                                        { m
                                            | closing = Just { id = id, why = (if name == "" then "A program" else cleanText name) ++ " is running in it.", window = False }
                                            , urgent = True
                                        }

                                Err e ->
                                    Task.succeed
                                        { m
                                            | closing = Just { id = id, why = "puritty could not tell whether a program runs in it: " ++ Os.Error.toString e, window = False }
                                            , urgent = True
                                        }
                        )


{-| The question before closing a busy tab. -}
closeBox : { id : Int, why : String, window : Bool } -> Dialog.Dialog
closeBox c =
    if c.window then
        { title = "Close the window?"
        , lines =
            String.split "\n" c.why
                ++ [ if String.contains "\n" c.why then "Closing the window ends them." else "Closing the window ends it." ]
        , field = Nothing
        , swatches = []
        , buttons = closeButtons
        , hint = "Enter: close it    Esc: keep it"
        }

    else
        { title = "Close this tab?"
        , lines = [ c.why, "Closing the tab ends it." ]
        , field = Nothing
        , swatches = []
        , buttons = closeButtons
        , hint = "Enter: close it    Esc: keep it"
        }


{-| The close question's buttons, for a hand on the mouse (TB12): Close,
as Enter, then Keep it, as Escape. -}
closeButtons : Array Dialog.Button
closeButtons =
    [ { label = "Close", primary = True }, { label = "Keep it", primary = False } ]


{-| A press while the close question is up: on Close, the tab or window
closed; on Keep it, the question gone; anywhere else, nothing, so that a
click cannot reach the terminal under the question. -}
closePress : Window.PointerEvent -> (taken m : Model) -> Task Error Model
closePress p m =
    let
        hit =
            if p.button == 1 then
                Maybe.andThen (\c -> Dialog.buttonAt (overlaySize m) (closeBox c) { x = p.x, y = p.y }) m.closing

            else
                Nothing
    in
    when hit is
        Just 0 ->
            closeAnswer True m

        Just _ ->
            closeAnswer False m

        Nothing ->
            Task.succeed m


{-| The close question answered: yes closes the window, or the tab asked
about if it is still the one shown; no keeps them. -}
closeAnswer : Bool -> (taken m : Model) -> Task Error Model
closeAnswer yes m =
    when m.closing is
        Nothing ->
            Task.succeed m

        Just c ->
            if yes && c.window then
                Task.succeed { m | closing = Nothing, closed = True, byButton = True }

            else if yes then
                if c.id == m.tab.id then
                    closeShown { m | closing = Nothing, urgent = True }

                else
                    Task.succeed { m | closing = Nothing, urgent = True }

            else
                Task.succeed { m | closing = Nothing, urgent = True }


{-| A key while the question is up: Enter or Y closes the tab asked about,
if it is still the one shown; Esc or N keeps it; any other key is
ignored. -}
closeKey : { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes } -> (taken m : Model) -> Task Error Model
closeKey k m =
    when m.closing is
        Nothing ->
            Task.succeed m

        Just _ ->
            if k.sym == 0xFF0D || k.sym == 0xFF8D || k.sym == 0x79 || k.sym == 0x59 then
                closeAnswer True m

            else if k.sym == 0xFF1B || k.sym == 0x6E || k.sym == 0x4E then
                closeAnswer False m

            else
                Task.succeed m


{-| The window's close button, or the system closing it (docs/tabs.md
TB7): asked first when any tab, shown or not, is busy, as closing one tab
is (TB4), naming each busy tab and what runs in it; at once otherwise, and
with `[tabs] ask_before_closing` off. -}
askCloseWindow : (taken m : Model) -> Task Error Model
askCloseWindow m =
    if not m.config.tabsAskBeforeClosing then
        Task.succeed { m | closed = True, byButton = True }

    else
        let
            shown =
                { label = tabLabel m.tab m.term.title, ssh = m.ssh, remote = m.remote }

            all =
                [ shown ] ++ busyCandidates 0 m []
        in
        Array.foldl
            (\t acc -> acc |> Task.andThen (\soFar -> busyWhy t |> Task.map (\why -> soFar ++ Array.mapAndKeepJust identity [ Maybe.map (\w -> cleanText t.label ++ ": " ++ w) why ])))
            (Task.succeed [])
            all
            |> Task.map
                (\busy ->
                    if Array.isEmpty busy then
                        { m | closed = True, byButton = True }

                    else
                        let
                            shownLines =
                                Array.takeFirst 6 busy
                                    ++ (if Array.length busy > 6 then [ "and " ++ String.fromInt (Array.length busy - 6) ++ " more" ] else [])
                        in
                        { m | closing = Just { id = -1, why = String.join "\n" shownLines, window = True }, urgent = True }
                )


{-| What each tab not shown needs for the window's question. -}
busyCandidates : Int -> Model -> Array { label : String, ssh : Maybe SshScreen, remote : Backend } -> Array { label : String, ssh : Maybe SshScreen, remote : Backend }
busyCandidates i m acc =
    if i >= Builder.length m.tabs then
        acc

    else
        busyCandidates (i + 1)
            m
            (when Builder.get i m.tabs |> Maybe.andThen identity is
                Just t ->
                    Array.pushLast { label = tabLabel t.info t.term.title, ssh = t.ssh, remote = t.remote } acc

                Nothing ->
                    acc
            )


{-| Why closing a tab would end something, or `Nothing` for an idle shell:
an open ssh session, a program in front of the shell, or that puritty
could not tell. -}
busyWhy : { label : String, ssh : Maybe SshScreen, remote : Backend } -> Task x (Maybe String)
busyWhy t =
    when t.ssh is
        Just screen ->
            if screen.started && screen.exitStatus == Nothing && screen.failed == Nothing then
                Task.succeed (Just ("the ssh session to " ++ cleanText screen.host ++ " is open"))

            else
                Task.succeed Nothing

        Nothing ->
            t.remote.busy
                |> Task.map (Maybe.map (\name -> (if name == "" then "a program" else cleanText name) ++ " is running"))
                |> Task.onError (\e -> Task.succeed (Just ("puritty could not tell what runs: " ++ Os.Error.toString e)))


{-| Whether a tab's ssh session failed or dropped: its tab stays, with the
screen that says why and offers to reconnect, and the bar marks it (TB8,
the survey's must-do 4). -}
sessionLost : Maybe SshScreen -> Bool
sessionLost ssh =
    when ssh is
        Just screen ->
            screen.failed /= Nothing

        Nothing ->
            False


{-| A lost session's tab label, with `×` before it. -}
lostMark : Bool -> String -> String
lostMark lost label =
    if lost then "× " ++ label else label

