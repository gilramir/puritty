module SettingsWindow exposing
    ( Effect(..)
    , Focus(..)
    , Input(..)
    , Model
    , Target(..)
    , Typing
    , changed
    , choicesOf
    , fileRead
    , focused
    , fontNote
    , hostRows
    , hostsPage
    , inList
    , init
    , isFamily
    , isSystemFont
    , linesPerRow
    , listed
    , onHosts
    , pageCount
    , pageNameOf
    , rowCount
    , rowLines
    , rowTop
    , suggestions
    , told
    , update
    , withFontUsed
    , withPageNamed
    , withRecents
    , withRowLines
    )

{-| The settings window's model (`docs/settings.md` ST7, `settings-gui.md`
SG1), pure: what `puritty settings` and the host list hold, and what a
key, a click on what is drawn (`Hit`, by `SettingsGui`'s boxes), or the
file read again does to it. `SettingsGui` draws it; `app/tests` drive it
without a window.

Keys: Tab and Shift+Tab move between the search, the pages and the
settings; Up and Down move in each; Enter changes the setting (on and off,
and a choice, change at once; the rest are typed, and written while what
is typed is a value the setting takes); Esc stops typing, clears the
search, or closes; Delete or Backspace resets a setting to its default;
Ctrl+Z undoes; Ctrl+M shows only the settings that differ from their
defaults; Ctrl+F goes to the search.

@docs Model, Input, Effect, init, update, fileRead, told

-}

import Bitwise
import Config exposing (Config)
import Hosts
import Reason
import Recent exposing (Recent(..))
import Schema exposing (Kind(..), Setting, Value(..))
import TextEdit
import Words exposing (Message)


type Focus
    = OnSearch
    | OnPages
    | OnRows


{-| What is being typed into a setting: its text as characters, where the
caret is among them, the selection's other end (`anchor`, the caret when
nothing is selected, SG20), the value it had when typing began, why what
is there is not a value it takes, if it is not, and in quick connect
which recent connection Up brought back (`recall`, -1 for none). -}
type alias Typing =
    { -- the key of the setting typed into, [] for a box of no setting's:
      -- what is typed goes to it whatever rows are listed meanwhile (the
      -- code review's PS3, docs/settings-gui.md SG23)
      key : Array String
    , chars : Array Char
    , caret : Int
    , anchor : Int
    , before : Value
    , problem : Maybe Message
    , pick : Int
    , recall : Int
    }


{-| A box typed into anew, holding `chars`, the caret at their end. -}
fresh : Array Char -> Typing
fresh chars =
    { key = [], chars = chars, caret = Array.length chars, anchor = Array.length chars, before = Unset, problem = Nothing, pick = -1, recall = -1 }


type alias Model =
    { config : Config
    , path : String
    , reports : Array String
    , cols : Int
    , rows : Int
    , focus : Focus
    , page : Int
    , row : Int
    , scroll : Int
    , search : Array Char
    , modifiedOnly : Bool
    , typing : Maybe Typing
    , undo : Array Undo
    , message : Maybe Message
    , fonts : Array String
    -- the family the terminal shows for the font the file named when the
    -- window opened (ST35): its own, or the one in its place
    , fontUsed : { name : String, used : String }
    -- the hosts of ~/.ssh/config, listed with the file's (V63), and
    -- whether the window is the host list, which a session replaces (V65)
    , aliases : Array String
    -- PuTTY's saved sessions as hosts, listed after them (SG21)
    , putty : Array Config.Host
    , launcher : Bool
    -- the connections made last, newest first, listed before the saved
    -- hosts (SG14)
    , recents : Array Recent
    -- the host whose form is shown on the Hosts page (ST25)
    , form : Maybe String
    -- how many lines each listed row takes, as the drawing measured
    -- them so that no description is cut (SG12); a row not in it takes
    -- linesPerRow
    , lines : Array Int
    -- the focused choice setting's list, open, and the choice picked in
    -- it (SG13)
    , choosing : Maybe Int
    }


{-| What Ctrl+Z puts back: a setting's value, or the hosts as they were
before one was added, removed or renamed. -}
type Undo
    = Was { setting : Setting, value : Value }
    | HostsWere (Array Config.Host)


{-| What the window is told. `Key`'s `sym` is X's keysym, as both
platforms' `Window` give it, and `mods` its bits: Shift 1, Ctrl 2, Alt 4.
`Typed` is text an input method committed; `Pasted`, a paste asked by
`PasteAsked`, its lines joined by spaces (SG20). -}
type Input
    = Key { sym : Int, mods : Int, text : String }
    | Typed String
    | Pasted String
    | Hit { target : Target, count : Int }
    | Scroll Int
    | Resized { cols : Int, rows : Int }


{-| What a click is on, in the drawn window (`docs/settings-gui.md` SG3):
the search field, the "modified only" switch, a page, a row (its label or
description), a row's value, a row's reset button, or one of the fonts the
font picker offers while one is typed. -}
type Target
    = OnSearchField
    | OnModifiedOnly
    | OnPage Int
    | OnRow Int
    | OnValue Int
    | OnReset Int
    | OnSuggestion Int
    | OnChoice Int
    | OnEdit Int


{-| What the window asks of the program: a setting written to the file, or
the window closed; text copied to the clipboard, or the clipboard's text
asked for, which comes as `Pasted` (SG20). -}
type Effect
    = Write { setting : Setting, value : Value }
    | Close
    | ConnectHost String
    | ConnectQuick String
    | PutHost Config.Host
    | DeleteHost String
    | RenameHost { from : String, to : String }
    | Hear { setting : Setting, value : Value }
    | ForgetRecent Recent
    | OpenLocal
    | Copy String
    | PasteAsked


init : { config : Config, path : String, reports : Array String, cols : Int, rows : Int, fonts : Array String, aliases : Array String, putty : Array Config.Host, launcher : Bool } -> Model
init r =
    { config = r.config
    , path = r.path
    , reports = r.reports
    , cols = r.cols
    , rows = r.rows
    , focus = OnRows
    , page =
        if r.launcher then
            hostsPage

        else
            0
    , row = 0
    , scroll = 0
    , search = []
    , modifiedOnly = False
    , typing =
        if r.launcher then
            Just (fresh [])

        else
            Nothing
    , undo = []
    , fonts = r.fonts
    , fontUsed = { name = "", used = "" }
    , aliases = r.aliases
    , putty = r.putty
    , launcher = r.launcher
    , recents = []
    , form = Nothing
    , lines = []
    , choosing = Nothing
    , message =
        when Array.first r.reports is
            Just first ->
                Just
                    (if Array.length r.reports > 1 then
                        Words.message "message.more" |> Words.with "first" first |> Words.with "more" (String.fromInt (Array.length r.reports - 1))

                     else
                        Words.plain first
                    )

            Nothing ->
                meant Reason.NoMore Nothing
    }


{-| The file read again after a change from elsewhere (an edit by hand):
its settings shown, what is being typed kept. -}
fileRead : { config : Config, reports : Array String } -> Model -> Model
fileRead r m =
    { m | config = r.config, reports = r.reports }


{-| A message at the foot, from the program: a write that failed. -}
told : Message -> Model -> Model
told message m =
    { m | message = Just message }


-- WHAT IS SHOWN


modified : Config -> Setting -> Bool
modified config s =
    s.get config /= s.get (Schema.defaultsFor config)


matches : String -> Setting -> Bool
matches query s =
    let
        q =
            String.toLower query

        within t =
            String.contains q (String.toLower t)
    in
    within s.label || within s.description || within (Schema.keyName s) || Array.any within s.words


{-| The settings listed: the page's, or with a search every page's that
match, in the pages' order; only the modified ones under Modified only. -}
listed : Model -> Array Setting
listed m =
    let
        query =
            String.fromArray m.search
    in
    if onHosts m then
        when m.form is
            Just name ->
                if Array.any (\h -> h.name == name) m.config.hosts then
                    Array.pushFirst (Schema.nameSetting name) (Schema.hostFields name)

                else
                    []

            Nothing ->
                meant Reason.NotOpen []

    else
        listedSettings m query


listedSettings : Model -> String -> Array Setting
listedSettings m query =
    let
        base =
            if query == "" then
                Array.keepIf (\s -> Array.get m.page Schema.pages == Just s.page) Schema.settings

            else
                Array.foldl (\p acc -> acc ++ Array.keepIf (\s -> s.page == p && matches query s) Schema.settings) [] Schema.pages
    in
    if m.modifiedOnly then
        Array.keepIf (modified m.config) base

    else
        base


focused : Model -> Maybe Setting
focused m =
    Array.get m.row (listed m)


{-| How many settings a page has to show: the search's matches when there
is one, else the ones changed. -}
pageCount : Model -> Schema.Page -> Int
pageCount m p =
    let
        query =
            String.fromArray m.search

        on =
            Array.keepIf (\s -> s.page == p) Schema.settings
    in
    if query /= "" then
        Array.length (Array.keepIf (matches query) on)

    else
        Array.length (Array.keepIf (modified m.config) on)


{-| The Hosts page, after the settings' pages (ST11). -}
hostsPage : Int
hostsPage =
    Array.length Schema.pages


onHosts : Model -> Bool
onHosts m =
    m.page == hostsPage && Array.isEmpty m.search


{-| A row of the host list: its name, where it goes and where it is from;
whether it is a host of the settings, a recent connection, or one of
PuTTY's sessions (SG21), the host it is made when it is used. -}
type alias HostRow =
    { name : String, detail : Message, from : Message, own : Bool, recent : Maybe Recent, putty : Maybe Config.Host }


{-| The connections made last (SG14), then the hosts listed: the file's,
then ~/.ssh/config's that the file does not name, then PuTTY's sessions
that neither names (SG21), each with where it goes and where it is from. -}
hostRows : Model -> Array HostRow
hostRows m =
    let
        whereOf h =
            Maybe.withDefault (meant Reason.NotSet "") (Maybe.map (\u -> u ++ "@") h.user)
                ++ h.host
                ++ Maybe.withDefault (meant Reason.NotSet "") (Maybe.map (\p -> ":" ++ String.fromInt p) h.port)
                ++ (when h.command is
                        Just c ->
                            " · " ++ c

                        Nothing ->
                            meant Reason.NotSet ""
                   )

        own =
            Array.map
                (\h ->
                    { name = h.name
                    , detail = Words.plain (whereOf h)
                    , from =
                        when h.jump is
                            Just jump ->
                                Words.message "message.hostThrough" |> Words.with "jump" jump

                            Nothing ->
                                meant Reason.NotSet Words.message "message.hostFromSettings"
                    , own = True
                    , recent = Nothing
                    , putty = Nothing
                    }
                )
                m.config.hosts

        theirs =
            m.aliases
                |> Array.keepIf (\a -> not (Array.any (\h -> h.name == a) m.config.hosts))
                |> Array.map (\a -> { name = a, detail = Words.message "message.asSshConfig", from = Words.message "message.hostFromSshConfig", own = False, recent = Nothing, putty = Nothing })

        puttys =
            m.putty
                |> Array.keepIf (\p -> not (Array.any (\h -> h.name == p.name) m.config.hosts) && not (Array.member p.name m.aliases))
                |> Array.map (\p -> { name = p.name, detail = Words.plain (whereOf p), from = Words.message "message.hostFromPutty", own = False, recent = Nothing, putty = Just p })

        recent =
            m.recents
                |> Array.map
                    (\r ->
                        when r is
                            Saved name ->
                                { name = name
                                , detail =
                                    when hostNamed m name is
                                        Just h ->
                                            Words.plain (whereOf h)

                                        Nothing ->
                                            meant Reason.NotKnown Words.message "message.asSshConfig"
                                , from = Words.message "message.recentSaved"
                                , own = False
                                , recent = Just r
                                , putty = Nothing
                                }

                            Quick text ->
                                { name = text, detail = Words.message "message.quickConnected", from = Words.message "message.recent", own = False, recent = Just r, putty = Nothing }
                    )
    in
    recent ++ own ++ theirs ++ puttys


{-| The page's name, as `settings-page.txt` keeps it (SG16): a page of
the settings by its title, or `Hosts`. -}
pageNameOf : Model -> String
pageNameOf m =
    if m.page >= hostsPage then
        "Hosts"

    else
        Array.get m.page Schema.pages |> Maybe.map Schema.pageName |> Maybe.withDefault (meant Reason.OutOfRange "")


{-| The window on the page of this name, the first row of it; as it was
when no page has the name (a page renamed since). -}
withPageNamed : String -> Model -> Model
withPageNamed name m =
    if name == "Hosts" then
        { m | page = hostsPage, row = 0, scroll = 0 }

    else
        when Array.findFirst (\p -> Schema.pageName p == name) Schema.pages is
            Just found ->
                { m | page = found.index, row = 0, scroll = 0 }

            Nothing ->
                meant Reason.NotKnown m


{-| The connections made last, read from their file (SG14). -}
withRecents : Array Recent -> Model -> Model
withRecents recents m =
    { m | recents = recents }


{-| The family the terminal shows for the font `name` names (ST35). -}
withFontUsed : { name : String, used : String } -> Model -> Model
withFontUsed used m =
    { m | fontUsed = used }


{-| What the font's row says of a font that is not this computer's or
puritty cannot use (docs/settings.md ST35): the family shown in its place,
when the window asked; that it is not among the fonts, when it did not
(one typed since). Nothing for a font in the list, or the default. -}
fontNote : Model -> Maybe Words.Message
fontNote m =
    let
        name =
            String.trim m.config.font

        same a b =
            String.toLower a == String.toLower b
    in
    if name == "" || Array.any (same name) m.fonts then
        Nothing

    else if same name m.fontUsed.name && m.fontUsed.used /= "" then
        if same name m.fontUsed.used then
            Nothing

        else
            Just (Words.message "message.fontNotUsed" |> Words.with "used" m.fontUsed.used)

    else
        Just (Words.message "message.fontNotHere")


{-| Whether a name in the font list is one of the system's; the font the
file names that is not, first in the list (ST35), is not. -}
isSystemFont : Model -> String -> Bool
isSystemFont m name =
    Array.any (\f -> String.toLower f == String.toLower name) m.fonts


{-| The host list: the Hosts page with no host's form open. -}
inList : Model -> Bool
inList m =
    onHosts m && m.form == Nothing


{-| The font suggested at `pick`, or none while nothing is picked (-1):
`Array.get` would count a negative place from the end, and give the last
font in the list (review PS1). -}
picked : Int -> Array String -> Maybe String
picked pick offered =
    if pick < 0 then
        Nothing

    else
        Array.get pick offered


{-| The host on a row of the list (quick connect, New connection and the
local shell come first). -}
hostAt : Model -> Int -> Maybe HostRow
hostAt m row =
    -- below the three fixed rows; Array.get would count a negative place
    -- from the end
    if row < 3 then
        Nothing

    else
        Array.get (row - 3) (hostRows m)


{-| Right on a recent connection (SG14): a saved host's form, as Right on
its own row; one quick connect made saved as a host first, named for where
it goes, and its form opened to name it and give it the rest. -}
saveRecent : Recent -> Model -> { model : Model, effects : Array Effect }
saveRecent recent m =
    let
        opened name st =
            keepInView { st | form = Just name, row = 1, scroll = 0 }

        saveAs host =
            let
                name =
                    if hostNamed m host.name == Nothing then
                        host.name

                    else
                        copyName m host.name

                made =
                    { host | name = name }

                saved =
                    hostsChanged (m.config.hosts ++ [ made ]) [ PutHost made ] (Words.message "message.hostAdded" |> Words.with "name" name) m
            in
            { saved | model = opened name saved.model }
    in
    when recent is
        Quick text ->
            when Hosts.quick text is
                Just host ->
                    saveAs { host | name = host.host }

                Nothing ->
                    meant Reason.FromOutside done { m | message = Just (Words.message "message.notAnAddress" |> Words.with "text" text) }

        Saved name ->
            when hostNamed m name is
                Just _ ->
                    done (opened name { m | message = Nothing })

                Nothing ->
                    -- one of ~/.ssh/config's, saved as a host first
                    meant Reason.NotKnown saveAs (Config.host name name)


{-| Right on a host's row: its form; one of ~/.ssh/config's is saved as a
host first. -}
rightOnHost : HostRow -> Model -> { model : Model, effects : Array Effect }
rightOnHost h m =
    if h.own then
        done (keepInView { m | form = Just h.name, row = 1, scroll = 0, message = Nothing })

    else
        let
            saved =
                when h.putty is
                    Just p ->
                        fromPutty p m

                    Nothing ->
                        meant Reason.NotSet hostsChanged (m.config.hosts ++ [ Config.host h.name h.name ]) [ PutHost (Config.host h.name h.name) ] (Words.message "message.hostAdded" |> Words.with "name" h.name) m

            after =
                saved.model
        in
        { saved | model = keepInView { after | form = Just h.name, row = 1, scroll = 0 } }


{-| One of PuTTY's sessions made a host of the settings (SG21), and the
sessions it jumps through that are not hosts yet with it, so that its
`jump` names a host. -}
fromPutty : Config.Host -> Model -> { model : Model, effects : Array Effect }
fromPutty p m =
    let
        chain h acc =
            if Array.any (\a -> a.name == h.name) acc || hostNamed m h.name /= Nothing then
                acc

            else
                let
                    more =
                        Array.pushLast h acc
                in
                when h.jump |> Maybe.andThen (\j -> Array.findFirst (\q -> q.name == j) m.putty) is
                    Just found ->
                        chain found.value more

                    Nothing ->
                        meant Reason.NotSet more

        made =
            chain p []
    in
    hostsChanged (m.config.hosts ++ made) (Array.map PutHost made) (Words.message "message.hostFromPuttySaved" |> Words.with "name" p.name) m


{-| A host of the settings, by name. -}
hostNamed : Model -> String -> Maybe Config.Host
hostNamed m name =
    Array.findFirst (\h -> h.name == name) m.config.hosts |> Maybe.map .value


{-| The hosts changed: the model's at once, the file's by the effects, and
undone together by Ctrl+Z. -}
hostsChanged : Array Config.Host -> Array Effect -> Message -> Model -> { model : Model, effects : Array Effect }
hostsChanged hosts effects message m =
    let
        config =
            m.config
    in
    { model = keepInView { m | config = { config | hosts = hosts }, undo = Array.pushLast (HostsWere config.hosts) m.undo, message = Just message }
    , effects = effects
    }


{-| A name for a copy of a host that no host has: `name-2`, `name-3`... -}
copyName : Model -> String -> String
copyName m name =
    Array.range 2 1000
        |> Array.map (\n -> name ++ "-" ++ String.fromInt n)
        |> Array.findFirst (\n -> hostNamed m n == Nothing)
        |> Maybe.map .value
        |> Maybe.withDefault (meant Reason.NoMore name ++ "-copy")


{-| How many rows the settings' side has: the settings listed, or quick
connect, New host and the hosts. -}
rowCount : Model -> Int
rowCount m =
    if inList m then
        3 + Array.length (hostRows m)

    else
        Array.length (listed m)


-- UPDATE


update : Input -> Model -> { model : Model, effects : Array Effect }
update input m =
    when input is
        Resized r ->
            done (keepInView { m | cols = r.cols, rows = r.rows })

        Pasted text ->
            update (Typed (TextEdit.oneLine text)) m

        Typed text ->
            when m.typing is
                Just t ->
                    typed (insert text t) m

                Nothing ->
                    meant Reason.NotOpen
                        if m.focus == OnSearch then
                            done (searched (m.search ++ String.toArray text) m)

                        else if m.focus == OnRows && inList m && m.row <= 1 then
                            typed (insert text (fresh [])) m

                        else
                            done m

        Hit h ->
            hit h m

        Scroll steps ->
            let
                most =
                    max 0 (rowTop m (rowCount m) - bodyRows m)
            in
            when m.choosing is
                Just pick ->
                    choosingKey
                        { sym =
                            if steps < 0 then
                                sym.up

                            else
                                sym.down
                        , mods = 0
                        , text = ""
                        }
                        pick
                        m

                Nothing ->
                    meant Reason.NotOpen done { m | scroll = max 0 (min most (m.scroll + linesPerRow * steps)) }

        Key pressed ->
            let
                k =
                    { pressed | sym = mainKey pressed.sym }
            in
            when m.choosing is
                Just pick ->
                    choosingKey k pick m

                Nothing ->
                    meant Reason.NotOpen
                        if Bitwise.and k.mods 2 /= 0 then
                            control k m

                        else
                            keyed k m


{-| A key with no list open and no Ctrl: to the field being typed in, or
to the part of the window that has the focus. -}
keyed : { sym : Int, mods : Int, text : String } -> Model -> { model : Model, effects : Array Effect }
keyed k m =
    when m.typing is
        Just t ->
            typingKey k t m

        Nothing ->
            meant Reason.NotOpen
                when
                    (if k.sym == sym.insert && Bitwise.and k.mods 1 /= 0 then
                        pasteHere m

                     else
                        Nothing
                    )
                is
                    Just r ->
                        r

                    Nothing ->
                        meant Reason.NotKnown (focusKey k m)


focusKey : { sym : Int, mods : Int, text : String } -> Model -> { model : Model, effects : Array Effect }
focusKey k m =
    when m.focus is
        OnSearch ->
            searchKey k m

        OnPages ->
            pagesKey k m

        OnRows ->
            rowsKey k m


done : Model -> { model : Model, effects : Array Effect }
done m =
    { model = m, effects = [] }


sym =
    { enter = 0xFF0D
    , keypadEnter = 0xFF8D
    , escape = 0xFF1B
    , tab = 0xFF09
    , backTab = 0xFE20
    , backspace = 0xFF08
    , delete = 0xFFFF
    , left = 0xFF51
    , up = 0xFF52
    , right = 0xFF53
    , down = 0xFF54
    , home = 0xFF50
    , end = 0xFF57
    , pageUp = 0xFF55
    , pageDown = 0xFF56
    , space = 0x20
    , insert = 0xFF63
    , f2 = 0xFFBF
    }


{-| A keypad key the window takes as its main key: the keypad's arrows,
Home, End, Page Up and Down and Delete, as NumLock off gives them (and as
Windows gives a key sent without its extended flag). -}
mainKey : Int -> Int
mainKey s =
    if s == 0xFF97 then
        sym.up

    else if s == 0xFF99 then
        sym.down

    else if s == 0xFF96 then
        0xFF51

    else if s == 0xFF98 then
        0xFF53

    else if s == 0xFF95 then
        0xFF50

    else if s == 0xFF9C then
        0xFF57

    else if s == 0xFF9A then
        0xFF55

    else if s == 0xFF9B then
        0xFF56

    else if s == 0xFF9F then
        0xFFFF

    else
        s


isEnter : Int -> Bool
isEnter s =
    s == sym.enter || s == sym.keypadEnter


{-| Tab and Shift+Tab: the search, the pages, the settings, round. -}
moveFocus : { sym : Int, mods : Int, text : String } -> Model -> Maybe Model
moveFocus k m =
    let
        back =
            k.sym == sym.backTab || Bitwise.and k.mods 1 /= 0
    in
    if k.sym == sym.tab || k.sym == sym.backTab then
        Just
            { m
                | focus =
                    when m.focus is
                        OnSearch ->
                            if back then
                                OnRows

                            else
                                OnPages

                        OnPages ->
                            if back then
                                OnSearch

                            else
                                OnRows

                        OnRows ->
                            if back then
                                OnPages

                            else
                                OnSearch
            }

    else
        Nothing


control : { sym : Int, mods : Int, text : String } -> Model -> { model : Model, effects : Array Effect }
control k m =
    -- Ctrl with a letter: its keysym is the letter's, in either case
    let
        letter =
            if k.sym >= 0x41 && k.sym <= 0x5A then
                k.sym + 32

            else
                k.sym

        -- an editing key in the box typed into, or a paste where none is
        -- typed yet (SG20)
        editing =
            when m.typing is
                Just t ->
                    edited k t m

                Nothing ->
                    meant Reason.NotOpen
                        if letter == 0x76 then
                            pasteHere m

                        else
                            Nothing
    in
    when editing is
        Just r ->
            r

        Nothing ->
            meant Reason.NotKnown (controlNotEditing letter k m)


controlNotEditing : Int -> { sym : Int, mods : Int, text : String } -> Model -> { model : Model, effects : Array Effect }
controlNotEditing letter k m0 =
    let
        -- Ctrl+Z, Ctrl+M and Ctrl+F end what is being typed as Enter
        -- does, its change undoable, before the rows change under it (PS3)
        m =
            if letter == 0x7A || letter == 0x6D || letter == 0x66 then
                endTyping m0

            else
                m0
    in
    if letter == 0x7A then
        undo { m | typing = Nothing }

    else if letter == 0x6D then
        done
            (keepInView
                { m
                    | modifiedOnly = not m.modifiedOnly
                    , row = 0
                    , message =
                        if m.modifiedOnly then
                            Nothing

                        else
                            Just (Words.message "message.modifiedOnly")
                }
            )

    else if letter == 0x66 then
        done { m | focus = OnSearch, typing = Nothing }

    else if letter == 0x64 && onHosts m then
        -- Ctrl+D: a copy of the host listed, or of the form's
        let
            name =
                when m.form is
                    Just n ->
                        Just n

                    Nothing ->
                        meant Reason.NotOpen
                            hostAt m m.row
                                |> Maybe.andThen
                                    (\h ->
                                        if h.own then
                                            Just h.name

                                        else
                                            Nothing
                                    )
        in
        when Maybe.andThen (hostNamed m) name is
            Just h ->
                let
                    copy =
                        { h | name = copyName m h.name }

                    made =
                        hostsChanged (m.config.hosts ++ [ copy ]) [ PutHost copy ] (Words.message "message.copied" |> Words.with "name" copy.name |> Words.with "from" h.name) { m | typing = Nothing }

                    r =
                        made.model
                in
                { made | model = keepInView { r | form = Just copy.name, row = 0, scroll = 0 } }

            Nothing ->
                meant Reason.NotKnown done m

    else
        done m


searchKey : { sym : Int, mods : Int, text : String } -> Model -> { model : Model, effects : Array Effect }
searchKey k m =
    when moveFocus k m is
        Just moved ->
            done moved

        Nothing ->
            meant Reason.NotKnown
                if k.sym == sym.escape then
                    if Array.isEmpty m.search then
                        { model = m, effects = [ Close ] }

                    else
                        done (searched [] m)

                else if k.sym == sym.backspace then
                    done (searched (Array.slice 0 -1 m.search) m)

                else if k.sym == sym.down || isEnter k.sym then
                    done { m | focus = OnRows }

                else if k.text /= "" && Bitwise.and k.mods 4 == 0 && printable k.text then
                    done (searched (m.search ++ String.toArray k.text) m)

                else
                    done m


searched : Array Char -> Model -> Model
searched query m =
    keepInView { m | search = query, row = 0, scroll = 0 }


pagesKey : { sym : Int, mods : Int, text : String } -> Model -> { model : Model, effects : Array Effect }
pagesKey k m =
    when moveFocus k m is
        Just moved ->
            done moved

        Nothing ->
            meant Reason.NotKnown
                if k.sym == sym.up then
                    done (keepInView { m | page = max 0 (m.page - 1), row = 0, scroll = 0 })

                else if k.sym == sym.down then
                    done (keepInView { m | page = min hostsPage (m.page + 1), row = 0, scroll = 0 })

                else if k.sym == sym.right || isEnter k.sym then
                    done { m | focus = OnRows }

                else if k.sym == sym.escape then
                    { model = m, effects = [ Close ] }

                else
                    done m


rowsKey : { sym : Int, mods : Int, text : String } -> Model -> { model : Model, effects : Array Effect }
rowsKey k m =
    let
        count =
            rowCount m
    in
    when moveFocus k m is
        Just moved ->
            done moved

        Nothing ->
            meant Reason.NotKnown
                if k.sym == sym.up then
                    done (keepInView { m | row = max 0 (m.row - 1) })

                else if k.sym == sym.down then
                    done (keepInView { m | row = min (count - 1) (m.row + 1) })

                else if k.sym == sym.pageUp then
                    done (keepInView { m | row = max 0 (m.row - bodyRows m // 3) })

                else if k.sym == sym.pageDown then
                    done (keepInView { m | row = max 0 (min (count - 1) (m.row + bodyRows m // 3)) })

                else if k.sym == sym.home then
                    done (keepInView { m | row = 0 })

                else if k.sym == sym.end then
                    done (keepInView { m | row = max 0 (count - 1) })

                else if k.sym == sym.left then
                    done { m | focus = OnPages }

                else if k.sym == sym.escape then
                    if Array.isEmpty m.search then
                        { model = m, effects = [ Close ] }

                    else
                        done (searched [] m)

                else if inList m && m.row <= 1 && k.text /= "" && k.text /= " " && Bitwise.and k.mods 4 == 0 && printable k.text then
                    -- a key typed on quick connect or a new host begins typing it
                    quickKey k (fresh []) { m | typing = Just (fresh []), message = Nothing }

                else if (isEnter k.sym || k.sym == sym.space) && inList m then
                    if m.row <= 1 then
                        -- quick connect, or a new host's name
                        done { m | typing = Just (fresh []), message = Nothing }

                    else if m.row == 2 then
                        -- the local shell (SG15)
                        { model = { m | message = Just (Words.message "message.openingLocal") }, effects = [ OpenLocal ] }

                    else
                        when hostAt m m.row is
                            Just h ->
                                when h.putty is
                                    Just p ->
                                        -- PuTTY's: made a host, then connected (SG21)
                                        let
                                            saved =
                                                fromPutty p m

                                            after =
                                                saved.model
                                        in
                                        { model = { after | message = Just (Words.message "message.connecting" |> Words.with "name" h.name) }, effects = saved.effects ++ [ ConnectHost h.name ] }

                                    Nothing ->
                                        meant Reason.NotSet
                                            { model = { m | message = Just (Words.message "message.connecting" |> Words.with "name" h.name) }
                                            , effects =
                                                when h.recent is
                                                    Just (Quick text) ->
                                                        [ ConnectQuick text ]

                                                    Just (Saved name) ->
                                                        [ ConnectHost name ]

                                                    Nothing ->
                                                        -- a saved host's own row
                                                        meant Reason.NotSet [ ConnectHost h.name ]
                                            }

                            Nothing ->
                                meant Reason.OutOfRange done m

                else if k.sym == sym.f2 && inList m && m.row >= 3 then
                    -- the row's connection into quick connect, to edit (SG20)
                    editRow m.row m

                else if k.sym == sym.right && inList m then
                    -- a host's form; one of ~/.ssh/config's is saved as a host first
                    when hostAt m m.row is
                        Just h ->
                            when h.recent is
                                Just recent ->
                                    saveRecent recent m

                                Nothing ->
                                    -- a saved host's own row, or ~/.ssh/config's
                                    meant Reason.NotSet (rightOnHost h m)

                        Nothing ->
                            meant Reason.OutOfRange done m

                else if (k.sym == sym.left || k.sym == sym.escape) && onHosts m && m.form /= Nothing then
                    -- back to the list, on the host the form was of
                    let
                        back =
                            { m | form = Nothing, message = Nothing }

                        row =
                            m.form
                                |> Maybe.andThen (\name -> Array.findFirst (\h -> h.name == name && h.recent == Nothing) (hostRows back))
                                |> Maybe.map (\f -> f.index + 3)
                                |> Maybe.withDefault (meant Reason.Gone 0)
                    in
                    done (keepInView { back | row = row })

                else if (k.sym == sym.delete || k.sym == sym.backspace) && inList m then
                    when hostAt m m.row is
                        Just h ->
                            when h.recent is
                                Just r ->
                                    let
                                        left =
                                            { m | recents = Recent.forgotten r m.recents, message = Just (Words.message "message.recentForgotten" |> Words.with "name" h.name) }
                                    in
                                    { model = keepInView { left | row = min left.row (rowCount left - 1) }, effects = [ ForgetRecent r ] }

                                Nothing ->
                                    -- a host of the settings, PuTTY's or ~/.ssh/config's
                                    meant Reason.NotOpen
                                        (if h.own then
                                            hostsChanged (Array.keepIf (\o -> o.name /= h.name) m.config.hosts) [ DeleteHost h.name ] (Words.message "message.hostRemoved" |> Words.with "name" h.name) m

                                         else if h.putty /= Nothing then
                                            done { m | message = Just (Words.message "message.fromPutty" |> Words.with "name" h.name) }

                                         else
                                            done { m | message = Just (Words.message "message.fromSshConfig" |> Words.with "name" h.name) }
                                        )

                        Nothing ->
                            meant Reason.OutOfRange done m

                else if isEnter k.sym || k.sym == sym.space then
                    when focused m is
                        Just s ->
                            change s m

                        Nothing ->
                            meant Reason.NotOpen done m

                else if k.sym == sym.delete || k.sym == sym.backspace then
                    when focused m is
                        Just s ->
                            if s.kind == Schema.HostName then
                                done { m | message = Just (Words.message "message.removeFromList") }

                            else if not s.optional && s.page == Schema.HostsPage then
                                done { m | message = Just (Words.message "message.hostNeedsAddress") }

                            else
                                set s
                                    (if s.page == Schema.HostsPage then
                                        Unset

                                     else
                                        s.get (Schema.defaultsFor m.config)
                                    )
                                    { m | message = Just (Words.message "message.isDefault" |> Words.with "key" (Schema.keyName s)) }

                        Nothing ->
                            meant Reason.NotOpen done m

                else if k.text /= "" && Bitwise.and k.mods 4 == 0 && printable k.text then
                    -- typing from the list searches, as a settings editor's does
                    done (searched (m.search ++ String.toArray k.text) { m | focus = OnSearch })

                else
                    done m


printable : String -> Bool
printable text =
    String.all (\c -> Char.toCode c >= 0x20 && Char.toCode c /= 0x7F) text


{-| What a choice setting can be: its names, and "the default" first when
it may be left unset. -}
choicesOf : Setting -> Array Value
choicesOf s =
    when s.kind is
        OneOf names ->
            (if s.optional then
                [ Unset ]

             else
                []
            )
                ++ Array.map Text names

        _ ->
            []


{-| A key while a choice's list is open (SG13): Up and Down move the pick,
Home and End go to the ends, Page Up and Down by ten; Enter or Space take
the pick and Escape leaves the value as it was. Either closes the list;
every other key is ignored. -}
choosingKey : { sym : Int, mods : Int, text : String } -> Int -> Model -> { model : Model, effects : Array Effect }
choosingKey k pick m =
    when focused m is
        Just s ->
            let
                count =
                    Array.length (choicesOf s)

                -- the pick held to the list, so its moves stay inside `Int`
                at0 =
                    clamp 0 (max 0 (count - 1)) pick

                -- a sound's list plays each choice the pick reaches
                -- (`docs/sounds.md` SN7)
                moved n =
                    let
                        at =
                            max 0 (min (count - 1) n)
                    in
                    { model = { m | choosing = Just at }
                    , effects =
                        if at == pick then
                            []

                        else
                            when Array.get at (choicesOf s) is
                                Just v ->
                                    heard s v

                                Nothing ->
                                    meant Reason.OutOfRange []
                    }
            in
            if k.sym == sym.up then
                moved (at0 - 1)

            else if k.sym == sym.down then
                moved (at0 + 1)

            else if k.sym == sym.home then
                moved 0

            else if k.sym == sym.end then
                moved (count - 1)

            else if k.sym == sym.pageUp then
                moved (at0 - 10)

            else if k.sym == sym.pageDown then
                moved
                    (if at0 >= count - 10 then
                        count - 1

                     else
                        at0 + 10
                    )

            else if k.sym == sym.enter || k.sym == sym.keypadEnter || k.sym == sym.space then
                chosen pick m

            else if k.sym == sym.escape then
                done { m | choosing = Nothing }

            else
                done m

        Nothing ->
            meant Reason.NotOpen done { m | choosing = Nothing }


{-| The focused choice setting given its `i`th choice, and the list
closed. -}
chosen : Int -> Model -> { model : Model, effects : Array Effect }
chosen i m =
    let
        closed =
            { m | choosing = Nothing }
    in
    when focused closed is
        Just s ->
            when Array.get i (choicesOf s) is
                Just v ->
                    let
                        taken =
                            set s v closed
                    in
                    -- a click on a choice the pick was not on plays it; one
                    -- the pick reached was heard as it got there
                    if m.choosing == Just i then
                        taken

                    else
                        { taken | effects = taken.effects ++ heard s v }

                Nothing ->
                    meant Reason.OutOfRange done closed

        Nothing ->
            meant Reason.NotOpen done closed


{-| Enter on a setting: on and off change at once, a choice opens its
list (SG13); the rest begin typing. -}
change : Setting -> Model -> { model : Model, effects : Array Effect }
change s m =
    let
        now =
            s.get m.config
    in
    when s.kind is
        OnOff ->
            let
                on =
                    now /= Flag True

                turned =
                    set s (Flag on) m
            in
            if on then
                { turned | effects = turned.effects ++ heard s (Flag True) }

            else
                turned

        OneOf _ ->
            let
                at =
                    Array.findFirst (\c -> c == now) (choicesOf s) |> Maybe.map .index |> Maybe.withDefault (meant Reason.NotKnown 0)
            in
            done { m | choosing = Just at, message = Nothing }

        _ ->
            let
                chars =
                    String.toArray (Schema.toText now)
            in
            done { m | typing = Just { key = s.key, chars = chars, caret = Array.length chars, anchor = Array.length chars, before = now, problem = Nothing, pick = -1, recall = -1 }, message = Nothing }


{-| A sound setting's value played as it is chosen (`docs/sounds.md` SN7):
the bell a list's pick reaches, the key sound as it is turned on. Nothing
for any other page's setting. -}
heard : Setting -> Value -> Array Effect
heard s v =
    if s.page == Schema.SoundPage then
        [ Hear { setting = s, value = v } ]

    else
        []


{-| A setting given a value: the model's at once, the file's by the
program, and undone by Ctrl+Z. Nothing when it has it already. -}
set : Setting -> Value -> Model -> { model : Model, effects : Array Effect }
set s v m =
    let
        before =
            s.get m.config
    in
    if v == before then
        done m

    else
        { model = { m | config = s.set v m.config, undo = Array.pushLast (Was { setting = s, value = before }) m.undo }
        , effects = [ Write { setting = s, value = v } ]
        }


undo : Model -> { model : Model, effects : Array Effect }
undo m =
    when Array.popLast m.undo is
        Just { last, initial } ->
            when last is
                Was w ->
                    { model = { m | config = w.setting.set w.value m.config, undo = initial, message = Just (Words.message "message.backAsItWas" |> Words.with "key" (Schema.keyName w.setting)) }
                    , effects = [ Write { setting = w.setting, value = w.value } ]
                    }

                HostsWere before ->
                    let
                        now =
                            m.config.hosts

                        -- each host as it was written back, and each host
                        -- added since taken out
                        effects =
                            Array.mapAndKeepJust
                                (\h ->
                                    if Array.member h now then
                                        Nothing

                                    else
                                        Just (PutHost h)
                                )
                                before
                                ++ Array.mapAndKeepJust
                                    (\h ->
                                        if Array.any (\b -> b.name == h.name) before then
                                            Nothing

                                        else
                                            Just (DeleteHost h.name)
                                    )
                                    now

                        config =
                            m.config
                    in
                    { model = keepInView { m | config = { config | hosts = before }, undo = initial, form = Nothing, message = Just (Words.message "message.hostsBack") }
                    , effects = effects
                    }

        Nothing ->
            meant Reason.NoMore done { m | message = Just (Words.message "message.nothingToUndo") }


typingKey : { sym : Int, mods : Int, text : String } -> Typing -> Model -> { model : Model, effects : Array Effect }
typingKey k t m =
    if inList m && m.row == 1 then
        newHostKey k t m

    else if inList m then
        quickKey k t m

    else if (isEnter k.sym || k.sym == sym.tab) && isHostName m then
        -- a host renamed on Enter, its table and those under it
        let
            from =
                Maybe.withDefault (meant Reason.NotOpen "") m.form

            to =
                String.trim (String.fromArray t.chars)
        in
        if to == from then
            done { m | typing = Nothing, message = Nothing }

        else if to == "" then
            done { m | message = Just (Words.message "problem.hostNeedsName") }

        else if hostNamed m to /= Nothing then
            done { m | message = Just (Words.message "message.hostExists" |> Words.with "name" to) }

        else
            let
                renamed =
                    hostsChanged
                        (Array.map
                            (\h ->
                                if h.name == from then
                                    { h | name = to }

                                else
                                    h
                            )
                            m.config.hosts
                        )
                        [ RenameHost { from = from, to = to } ]
                        (Words.message "message.renamed" |> Words.with "from" from |> Words.with "to" to)
                        { m | typing = Nothing }

                r =
                    renamed.model
            in
            { renamed | model = { r | form = Just to } }

    else if k.sym == sym.escape then
        -- what was there before typing began, back
        when typedOn t m is
            Just s ->
                let
                    back =
                        s.get m.config /= t.before
                in
                { model = { m | config = s.set t.before m.config, typing = Nothing, message = Nothing }
                , effects =
                    if back then
                        [ Write { setting = s, value = t.before } ]

                    else
                        []
                }

            Nothing ->
                meant Reason.NotOpen done { m | typing = Nothing }

    else if (isEnter k.sym || k.sym == sym.tab) && isFamily m then
        -- a font is written when it is chosen, not as its name is typed
        when focused m is
            Just s ->
                let
                    name =
                        Maybe.withDefault (meant Reason.NotSet String.trim (String.fromArray t.chars)) (picked t.pick (suggestions m t))
                in
                if name == "" then
                    done { m | message = Just (Words.message "problem.noFont") }

                else
                    set s (Text name) { m | typing = Nothing, message = Nothing }

            Nothing ->
                meant Reason.NotOpen (done { m | typing = Nothing })

    else if (k.sym == sym.up || k.sym == sym.down) && isFamily m then
        let
            count =
                Array.length (suggestions m t)
        in
        done
            { m
                | typing =
                    Just
                        { t
                            | pick =
                                if k.sym == sym.down then
                                    min (count - 1) (t.pick + 1)

                                else
                                    max -1 (t.pick - 1)
                        }
            }

    else if isEnter k.sym || k.sym == sym.tab then
        when t.problem is
            Just why ->
                done { m | message = Just why }

            Nothing ->
                meant Reason.NotOpen
                    when typedOn t m is
                        Just s ->
                            let
                                now =
                                    s.get m.config
                            in
                            done
                                { m
                                    | typing = Nothing
                                    , message = Nothing
                                    , undo =
                                        if now /= t.before then
                                            Array.pushLast (Was { setting = s, value = t.before }) m.undo

                                        else
                                            m.undo
                                }

                        Nothing ->
                            meant Reason.NotOpen done { m | typing = Nothing }

    else
        when edited k t m is
            Just r ->
                r

            Nothing ->
                meant Reason.NotKnown (done m)


{-| A new host's name typed: on Enter the host is made, where to connect
taken to be its name, and its form opened. -}
newHostKey : { sym : Int, mods : Int, text : String } -> Typing -> Model -> { model : Model, effects : Array Effect }
newHostKey k t m =
    let
        name =
            String.trim (String.fromArray t.chars)
    in
    if isEnter k.sym then
        if name == "" then
            done { m | message = Just (Words.message "problem.hostNeedsName") }

        else if hostNamed m name /= Nothing then
            done { m | message = Just (Words.message "message.hostExists" |> Words.with "name" name) }

        else
            let
                made =
                    hostsChanged (m.config.hosts ++ [ Config.host name name ]) [ PutHost (Config.host name name) ] (Words.message "message.hostMade" |> Words.with "name" name) { m | typing = Nothing }

                r =
                    made.model
            in
            { made | model = keepInView { r | form = Just name, row = 1, scroll = 0 } }

    else
        quickKey k t m


{-| Quick connect typed: `user@host:port`, connected to on Enter. -}
quickKey : { sym : Int, mods : Int, text : String } -> Typing -> Model -> { model : Model, effects : Array Effect }
quickKey k t m =
    let
        text =
            String.trim (String.fromArray t.chars)
    in
    if k.sym == sym.escape then
        done { m | typing = Nothing, message = Nothing }

    else if k.sym == sym.up && m.row == 0 && (Array.isEmpty t.chars || t.recall >= 0) then
        recalled (t.recall + 1) t m

    else if k.sym == sym.down && m.row == 0 && t.recall >= 0 then
        recalled (t.recall - 1) t m

    else if k.sym == sym.down || k.sym == sym.up then
        -- what is typed is left, and the list moved in
        done
            (keepInView
                { m
                    | typing = Nothing
                    , message = Nothing
                    , row =
                        if k.sym == sym.down then
                            min (rowCount m - 1) (m.row + 1)

                        else
                            max 0 (m.row - 1)
                }
            )

    else if isEnter k.sym then
        when Hosts.quick text is
            Just _ ->
                { model = { m | typing = Nothing, message = Just (Words.message "message.connecting" |> Words.with "name" text) }, effects = [ ConnectQuick text ] }

            Nothing ->
                meant Reason.FromOutside done { m | message = Just (Words.message "message.notAnAddress" |> Words.with "text" text) }

    else
        when edited k t m is
            Just r ->
                r

            Nothing ->
                meant Reason.NotKnown (done m)


insert : String -> Typing -> Typing
insert text t =
    let
        e =
            TextEdit.replaceSelection text { chars = t.chars, caret = t.caret, anchor = t.anchor }
    in
    { t | chars = e.chars, caret = e.caret, anchor = e.anchor }


{-| An editing key in the box typed into (SG20), as `TextEdit` takes it:
the text or the caret moved, what is typed written as `typed` writes it
when the text changed; a copy or a paste asked of the program. Nothing for
a key that is not an editing one. -}
edited : { sym : Int, mods : Int, text : String } -> Typing -> Model -> Maybe { model : Model, effects : Array Effect }
edited k t m =
    when TextEdit.key k { chars = t.chars, caret = t.caret, anchor = t.anchor } is
        TextEdit.Edited e ->
            Just (afterEdit e t m)

        TextEdit.Copied c ->
            let
                r =
                    afterEdit c.edit t m
            in
            Just
                { r
                    | effects =
                        if c.text == "" then
                            r.effects

                        else
                            r.effects ++ [ Copy c.text ]
                }

        TextEdit.PasteAsked ->
            Just { model = m, effects = [ PasteAsked ] }

        TextEdit.NotMine ->
            Nothing


afterEdit : TextEdit.Edit -> Typing -> Model -> { model : Model, effects : Array Effect }
afterEdit e t m =
    let
        next =
            { t | chars = e.chars, caret = e.caret, anchor = e.anchor }
    in
    if e.chars == t.chars then
        done { m | typing = Just next }

    else
        typed { next | recall = -1 } { m | message = Nothing }


{-| A paste asked where nothing is typed yet: into the search, or into
quick connect or a new host's name, which it begins typing. -}
pasteHere : Model -> Maybe { model : Model, effects : Array Effect }
pasteHere m =
    if m.focus == OnSearch then
        Just { model = m, effects = [ PasteAsked ] }

    else if m.focus == OnRows && inList m && m.row <= 1 then
        Just { model = { m | typing = Just (fresh []), message = Nothing }, effects = [ PasteAsked ] }

    else
        Nothing


{-| The line quick connect takes for a listed row (SG20): a recent quick
connection's own; a saved host's address, `user@host:port`, and its
command; one of ~/.ssh/config's, its name. -}
rowLine : Model -> HostRow -> String
rowLine m h =
    when h.recent is
        Just r ->
            recentLine m r

        Nothing ->
            meant Reason.NotSet
                if h.own then
                    savedLine m h.name

                else
                    when h.putty is
                        Just p ->
                            hostLine p

                        Nothing ->
                            meant Reason.NotSet h.name


recentLine : Model -> Recent -> String
recentLine m r =
    when r is
        Quick text ->
            text

        Saved name ->
            savedLine m name


savedLine : Model -> String -> String
savedLine m name =
    when hostNamed m name is
        Just h ->
            hostLine h

        Nothing ->
            meant Reason.Gone name


hostLine : Config.Host -> String
hostLine h =
    Hosts.spec h
        ++ (when h.command is
                Just c ->
                    " " ++ c

                Nothing ->
                    meant Reason.NotSet ""
           )


{-| A row's connection put into quick connect to be edited, the caret at
its end, and nothing connected to (F2, or the row's pencil; SG20). -}
editRow : Int -> Model -> { model : Model, effects : Array Effect }
editRow i m =
    when hostAt m i is
        Just h ->
            done (keepInView { m | row = 0, focus = OnRows, form = Nothing, typing = Just (fresh (String.toArray (rowLine m h))), message = Nothing })

        Nothing ->
            meant Reason.OutOfRange done m


{-| Up and Down in quick connect while it is empty or holds one brought
back: the recent connections, newest first, as a shell's history (SG20);
past the newest, empty again. -}
recalled : Int -> Typing -> Model -> { model : Model, effects : Array Effect }
recalled i t m =
    let
        lines =
            Array.map (recentLine m) m.recents
    in
    if i < 0 then
        done { m | typing = Just { t | chars = [], caret = 0, anchor = 0, recall = -1 }, message = Nothing }

    else
        when Array.get i lines is
            Just line ->
                let
                    f =
                        fresh (String.toArray line)
                in
                done { m | typing = Just { f | recall = i }, message = Nothing }

            Nothing ->
                -- past the oldest: kept
                meant Reason.NoMore done m


{-| What is typed, written while it is a value the setting takes, so that
the terminals show it as it is typed (ST6); its problem kept otherwise. -}
typed : Typing -> Model -> { model : Model, effects : Array Effect }
typed t m =
    if inList m then
        done { m | typing = Just t }

    else
        typedSetting t m


{-| The setting what is typed belongs to: the one typing began in, by its
key, whatever row has the focus now (PS3). -}
typedOn : Typing -> Model -> Maybe Setting
typedOn t m =
    when focused m is
        Just s ->
            if Array.isEmpty t.key || s.key == t.key then
                Just s

            else
                Schema.find t.key

        Nothing ->
            meant Reason.NotOpen Schema.find t.key


{-| What was being typed ended, as Enter ends it: its value kept, and an
undo entry when it changed (PS3). -}
endTyping : Model -> Model
endTyping m =
    when m.typing is
        Just t ->
            when typedOn t m is
                Just s ->
                    let
                        now =
                            s.get m.config
                    in
                    { m
                        | typing = Nothing
                        , undo =
                            if now /= t.before then
                                Array.pushLast (Was { setting = s, value = t.before }) m.undo

                            else
                                m.undo
                    }

                Nothing ->
                    meant Reason.NotOpen { m | typing = Nothing }

        Nothing ->
            meant Reason.NotOpen m


typedSetting : Typing -> Model -> { model : Model, effects : Array Effect }
typedSetting t m =
    when typedOn t m is
        Just s ->
            if s.kind == FontFamily || s.kind == Schema.HostName then
                -- the suggestions follow the name; it is written when chosen
                done { m | typing = Just { t | pick = -1, problem = Nothing } }

            else
                when Schema.fromText s (String.fromArray t.chars) is
                    Ok v ->
                        let
                            writes =
                                if v /= s.get m.config then
                                    [ Write { setting = s, value = v } ]

                                else
                                    []
                        in
                        { model = { m | config = s.set v m.config, typing = Just { t | problem = Nothing }, message = Nothing }, effects = writes }

                    Err why ->
                        meant Reason.FromOutside done { m | typing = Just { t | problem = Just why }, message = Just why }

        Nothing ->
            meant Reason.NotOpen done { m | typing = Nothing }


{-| A click on a drawn target, through the paths the keys take. What is
being typed is kept, as Enter keeps it, unless the click is on the row
being typed or on a font offered for it; in the host list, where Enter
connects or makes a host, it is let go, as Esc lets it go. -}
hit : { target : Target, count : Int } -> Model -> { model : Model, effects : Array Effect }
hit h m =
    let
        typingHere =
            m.typing /= Nothing && (h.target == OnValue m.row || h.target == OnRow m.row)
    in
    when { target = h.target, typing = m.typing } is
        { target = OnChoice i, typing = _ } ->
            chosen i m

        { target = OnEdit i, typing = _ } ->
            -- a row's pencil: its connection into quick connect (SG20)
            editRow i { m | typing = Nothing, choosing = Nothing }

        { target = OnSuggestion i, typing = Just t } ->
            typingKey { sym = sym.enter, mods = 0, text = "" } { t | pick = i } m

        _ ->
            if m.choosing /= Nothing then
                -- a click off an open list closes it, and does nothing more
                done { m | choosing = Nothing }

            else if typingHere then
                done m

            else
                let
                    finished =
                        when m.typing is
                            Just t ->
                                if inList m then
                                    -- quick connect or New host: their Enter
                                    -- connects or makes the host, which a
                                    -- click away must not (review PS2)
                                    typingKey { sym = sym.escape, mods = 0, text = "" } t m

                                else
                                    let
                                        kept =
                                            typingKey { sym = sym.enter, mods = 0, text = "" } t m
                                    in
                                    when kept.model.typing is
                                        Just t2 ->
                                            let
                                                back =
                                                    typingKey { sym = sym.escape, mods = 0, text = "" } t2 kept.model
                                            in
                                            { model = back.model, effects = kept.effects ++ back.effects }

                                        Nothing ->
                                            meant Reason.NotOpen kept

                            Nothing ->
                                meant Reason.NotOpen done m

                    after =
                        hitOn h finished.model
                in
                { model = after.model, effects = finished.effects ++ after.effects }


hitOn : { target : Target, count : Int } -> Model -> { model : Model, effects : Array Effect }
hitOn h m =
    let
        enterAt i =
            rowsKey { sym = sym.enter, mods = 0, text = "" } { m | focus = OnRows, row = i }
    in
    when h.target is
        OnSearchField ->
            done { m | focus = OnSearch }

        OnModifiedOnly ->
            control { sym = 0x6D, mods = 2, text = "" } m

        OnPage p ->
            if p <= hostsPage then
                done (keepInView { m | focus = OnPages, page = p, row = 0, scroll = 0, search = [], form = Nothing })

            else
                done m

        OnRow i ->
            if i >= rowCount m then
                done m

            else if h.count >= 2 then
                enterAt i

            else
                done (keepInView { m | focus = OnRows, row = i })

        OnValue i ->
            if i >= rowCount m then
                done m

            else if inList m && h.count < 2 && i >= 2 then
                -- a host connects on a double click
                done (keepInView { m | focus = OnRows, row = i })

            else
                enterAt i

        OnReset i ->
            rowsKey { sym = sym.delete, mods = 0, text = "" } { m | focus = OnRows, row = i }

        OnSuggestion _ ->
            done m

        OnChoice _ ->
            done m

        OnEdit i ->
            editRow i m


{-| Whether a setting's row shows it changed, the marker and the reset
mark: a setting that differs from its default, or a host's field that is
set and may be unset (not its name, not where it connects). -}
changed : Config -> Setting -> Bool
changed config s =
    if s.page == Schema.HostsPage then
        s.optional && s.get config /= Unset

    else
        modified config s


{-| Whether a host's name is being typed. -}
isHostName : Model -> Bool
isHostName m =
    when focused m is
        Just s ->
            s.kind == Schema.HostName

        Nothing ->
            meant Reason.NotOpen False


{-| Whether a font is being typed. -}
isFamily : Model -> Bool
isFamily m =
    when focused m is
        Just s ->
            s.kind == FontFamily

        Nothing ->
            meant Reason.NotOpen False


{-| The system's fonts whose names hold what is typed; all of them while the
font's name is as it was when typing began (SG7). -}
suggestions : Model -> Typing -> Array String
suggestions m t =
    let
        name =
            String.trim (String.fromArray t.chars)

        q =
            if name == Schema.toText t.before then
                ""

            else
                String.toLower name
    in
    -- the font the file names, first, where it is not the system's, so
    -- that opening the list does not lose it (ST35)
    (if q == "" && fontNote m /= Nothing then
        [ String.trim m.config.font ]

     else
        []
    )
        ++ (m.fonts
                |> Array.keepIf (\f -> q == "" || String.contains q (String.toLower f))
           )


-- LAYOUT


linesPerRow : Int
linesPerRow =
    4


{-| How many lines row `i` takes: what the drawing measured, and never
fewer than `linesPerRow`. -}
rowLines : Model -> Int -> Int
rowLines m i =
    max linesPerRow (Maybe.withDefault (meant Reason.NotYet linesPerRow) (Array.get i m.lines))


{-| The line row `i` starts on, counted from the first row's. -}
rowTop : Model -> Int -> Int
rowTop m i =
    Array.foldl (\k acc -> acc + rowLines m k) 0 (Array.range 0 (i - 1))


{-| The lines the listed rows take, as measured, with the scroll kept
inside them. -}
withRowLines : Array Int -> Model -> Model
withRowLines lines m =
    let
        measured =
            { m | lines = lines }

        most =
            max 0 (rowTop measured (rowCount measured) - bodyRows measured)
    in
    { measured | scroll = min most measured.scroll }


{-| The rows between the two rules: the window's rows less three above
(the search, a space, a rule; the drawn window's header is as tall) and
two below. -}
bodyRows : Model -> Int
bodyRows m =
    max 1 (m.rows - 5)


{-| The scroll moved so that the focused setting's lines are in view. -}
keepInView : Model -> Model
keepInView m =
    let
        count =
            rowCount m

        row =
            max 0 (min (count - 1) m.row)

        top =
            rowTop m row

        bottom =
            top + rowLines m row - 1

        scroll =
            if top < m.scroll then
                top

            else if bottom >= m.scroll + bodyRows m then
                bottom - bodyRows m + 1

            else
                m.scroll
    in
    { m | row = row, scroll = max 0 scroll }
