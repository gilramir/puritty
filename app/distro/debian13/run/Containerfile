# A Debian 13 (trixie) desktop's libraries and nothing to build with,
# to run the debian13 build in (app/distro/smoke.sh): the X libraries puritty
# links, fontconfig and a monospace font, and Xvfb to draw on. The .deb is
# checked in this image too, installed with apt (../deb.sh).
#
#   podman build -t puritty-run-debian13 app/distro/debian13/run
FROM docker.io/library/debian:13
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libxcb1 libxcb-util1 libxcb-image0 libxcb-render-util0 libxcb-render0 libxcb-xkb1 \
      libxcb-randr0 libxkbcommon-x11-0 \
      fontconfig fonts-dejavu-core libpng16-16t64 zlib1g xvfb xkb-data procps \
 && rm -rf /var/lib/apt/lists/*
