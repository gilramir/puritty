# A RHEL10 desktop's libraries and nothing to build with, to run the RHEL10
# build in (app/distro/smoke.sh): AlmaLinux 10 with the X libraries puritty
# links, fontconfig and a monospace font. RHEL 10 has no Xvfb (it dropped
# the X server); xwfb-run draws on Xwayland under a headless weston (EPEL)
# instead, which smoke.sh uses where Xvfb is missing.
#
#   podman build -t puritty-run-rhel10 app/distro/rhel10/run
FROM docker.io/library/almalinux:10
RUN dnf -y install dnf-plugins-core epel-release \
 && dnf config-manager --set-enabled crb \
 && dnf -y install libxcb xcb-util xcb-util-image xcb-util-renderutil libxkbcommon-x11 \
      fontconfig dejavu-sans-mono-fonts libpng zlib xkeyboard-config procps-ng \
      xorg-x11-server-Xwayland xwayland-run weston dbus-daemon \
 && dnf clean all
