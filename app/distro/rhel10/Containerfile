# The RHEL10 build's toolchain (docs/releasing.md RL3): AlmaLinux 10, whose
# glibc and X libraries are RHEL 10's, with clang from its AppStream (21.1.8,
# the devbox's, so the release's profile is read). puritty links its own
# libxcb, xkbcommon and fontconfig; FreeType, HarfBuzz, xcb-util-cursor and
# xcb-imdkit are built into it (../build-libs.sh), as for RHEL8.
#
#   podman build -t puritty-build-rhel10 app/distro/rhel10
FROM docker.io/library/almalinux:10
RUN dnf -y install dnf-plugins-core \
 && dnf config-manager --set-enabled crb \
 && dnf -y install clang lld gcc-c++ make cmake meson ninja-build pkgconf-pkg-config \
      libxcb-devel libxkbcommon-devel libxkbcommon-x11-devel fontconfig-devel \
      xcb-util-devel xcb-util-renderutil-devel xcb-util-image-devel xcb-util-keysyms-devel \
      xcb-util-wm-devel xorg-x11-util-macros zlib-devel libpng-devel \
      git patch xz bzip2 file which findutils diffutils \
 && dnf clean all
