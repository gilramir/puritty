# Arch Linux's libraries, to run the RHEL8 build in as the plain Linux build
# (docs/releasing.md RL3; app/distro/smoke.sh arch BINARY): no build of its
# own, only the X libraries puritty links, fontconfig and a monospace font,
# and Xvfb to draw on.
#
#   podman build -t puritty-run-arch app/distro/arch/run
FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm libxcb xcb-util xcb-util-image xcb-util-renderutil libxkbcommon-x11 \
      fontconfig ttf-dejavu libpng zlib xorg-server-xvfb xkeyboard-config procps-ng \
 && pacman -Scc --noconfirm
