#!/bin/sh
# A distribution build's pkg-config (GENG_PKG_CONFIG): the build image's,
# which knows the distribution's libraries, and vendor/distro/NAME's for
# those built in (build-libs.sh).
here=$(cd "$(dirname "$0")" && pwd)
exec podman run --rm --userns=keep-id -v "$HOME:$HOME" -w "$PWD" \
    -e PKG_CONFIG_PATH="$here/../../vendor/distro/$PURITTY_DISTRO/lib/pkgconfig" \
    "puritty-build-$PURITTY_DISTRO" pkg-config "$@"
