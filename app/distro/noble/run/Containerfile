# A Ubuntu 24.04 (noble), which Linux Mint 22.3 is built on desktop's libraries and nothing to build with,
# to run the noble build in (app/distro/smoke.sh): the X libraries puritty
# links, fontconfig and a monospace font, and Xvfb to draw on. The .deb is
# checked in this image too, installed with apt (../deb.sh).
#
#   podman build -t puritty-run-noble app/distro/noble/run
FROM docker.io/library/ubuntu:24.04
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libxcb1 libxcb-util1 libxcb-image0 libxcb-render-util0 libxcb-render0 libxcb-xkb1 \
      libxcb-randr0 libxkbcommon-x11-0 \
      fontconfig fonts-dejavu-core libpng16-16t64 zlib1g xvfb xkb-data procps \
 && rm -rf /var/lib/apt/lists/*
