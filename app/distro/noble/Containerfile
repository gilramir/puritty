# The noble build's toolchain (docs/releasing.md RL3): Ubuntu 24.04 (noble), which Linux Mint 22.3 is built on,
# its glibc and X libraries, and its own clang, whose version is not the
# devbox's, so the build reads no profile (RL1). FreeType, HarfBuzz,
# xcb-util-cursor and xcb-imdkit are built into it (../build-libs.sh), as for
# RHEL; dpkg-dev makes the .deb (../deb.sh).
#
#   podman build -t puritty-build-noble app/distro/noble
FROM docker.io/library/ubuntu:24.04
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      clang lld build-essential cmake meson ninja-build pkg-config \
      libxcb1-dev libxkbcommon-dev libxkbcommon-x11-dev libfontconfig-dev \
      libxcb-util-dev libxcb-render-util0-dev libxcb-image0-dev libxcb-keysyms1-dev \
      libxcb-icccm4-dev libxcb-render0-dev libxcb-xkb-dev libxcb-randr0-dev \
      xutils-dev zlib1g-dev libpng-dev \
      git patch xz-utils bzip2 file dpkg-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*
