#!/bin/sh
# A distribution build's C compiler (GENG_CC; README.md): the build image's
# clang for PURITTY_DISTRO, run in the caller's directory with the home and
# /tmp seen at the same paths, so that the paths geng-lang's compiler passes
# mean the same there.
exec podman run --rm --userns=keep-id -v "$HOME:$HOME" -v /tmp:/tmp -w "$PWD" \
    "puritty-build-$PURITTY_DISTRO" clang "$@"
