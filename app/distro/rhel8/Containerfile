# The RHEL8 build's toolchain (docs/rhel8-etx.md): AlmaLinux 8, whose
# glibc (2.28) and X libraries are RHEL 8.10's, with clang from its
# AppStream. puritty links RHEL8's own libxcb, xkbcommon and fontconfig,
# which every RHEL8 desktop has; FreeType, HarfBuzz, xcb-util-cursor and
# xcb-imdkit are built into it (../build-libs.sh), since RHEL8's are too old
# or missing.
#
#   podman build -t puritty-build-rhel8 app/distro/rhel8
FROM docker.io/library/almalinux:8
RUN dnf -y install dnf-plugins-core \
 && dnf config-manager --set-enabled powertools \
 && dnf -y install clang lld gcc-c++ make cmake meson ninja-build pkgconf-pkg-config \
      libxcb-devel libxkbcommon-devel libxkbcommon-x11-devel fontconfig-devel \
      xcb-util-devel xcb-util-renderutil-devel xcb-util-image-devel xcb-util-keysyms-devel \
      xcb-util-wm-devel xorg-x11-util-macros zlib-devel libpng-devel \
      git patch xz bzip2 file which findutils diffutils \
 && dnf clean all
