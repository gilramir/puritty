# Fedora's libraries, to run the RHEL8 build in as the plain Linux build
# (docs/releasing.md RL3; app/distro/smoke.sh fedora BINARY): no build of
# its own, only the X libraries puritty links, fontconfig and a monospace
# font, and Xvfb to draw on.
#
#   podman build -t puritty-run-fedora app/distro/fedora/run
FROM registry.fedoraproject.org/fedora:43
RUN dnf -y install libxcb xcb-util xcb-util-image xcb-util-renderutil libxkbcommon-x11 \
      fontconfig dejavu-sans-mono-fonts libpng zlib xorg-x11-server-Xvfb xkeyboard-config procps-ng \
 && dnf clean all
