module SecretStore exposing (available, forget, read, write)

{-| Where a remembered password or passphrase is kept on Windows: the
Credential Manager (`docs/saved-secrets.md` PW7). `app/linux` keeps none.
-}

import Credentials
import Task exposing (Task)


available : Bool
available =
    True


read : String -> Task x (Result String String)
read =
    Credentials.read


write : { target : String, user : String, secret : String } -> Task x (Result String {})
write =
    Credentials.write


forget : String -> Task x Bool
forget =
    Credentials.forget
