module PuttyStore exposing (sessions)

{-| PuTTY's saved sessions on Windows (`docs/settings-gui.md` SG21): the
registry's, under `HKCU\Software\SimonTatham\PuTTY\Sessions`, as
`Registry.puttySessions` reads them. `app/linux` reads PuTTY's folder.
-}

import Dict exposing (Dict)
import Os.File as File
import Putty
import Registry
import Task exposing (Task)


sessions : File.Permission -> Dict String String -> Task x (Array Putty.Session)
sessions _ _ =
    Registry.puttySessions
        |> Task.map Putty.parseSessions
