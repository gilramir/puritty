module Notify exposing (show)

{-| A desktop notification a program asked for (puritty
`docs/claude-code.md` CL8), on Windows: a toast, by the notification
area's balloon (`Window.notify`). `app/linux` asks the desktop's
notification service. -}

import Os.Process as Process
import Task exposing (Task)
import Window


{-| Shown, or why not. -}
show : Maybe Process.Permission -> { title : String, body : String } -> Task x (Result String {})
show _ n =
    Window.notify n
        |> Task.map
            (\shown ->
                if shown then
                    Ok {}

                else
                    Err "the notification area refused it"
            )
