module Platform exposing (variable, settingsDirectory, stateDirectory, programs, font, Locale, locale, sshConfig, defaultClient, start, interfaceFont, copyToClipboard, sharedPrimary)

{-| What puritty does differently on Windows and on Linux, other than its
window (`docs/windows.md` WS10, V55): this module is `app/windows`'s, and
`app/linux` has its own with the same functions.

Windows' environment variables are named in any case (`ComSpec`), so they
are looked for without it.
-}

import Dict exposing (Dict)
import Locale
import Task exposing (Task)


variable : String -> Dict String String -> Maybe String
variable name vars =
    Dict.foldl
        (\k v found ->
            if found == Nothing && String.toLower k == String.toLower name && v /= "" then
                Just v

            else
                found
        )
        Nothing
        vars


{-| The directory of the settings file: `%APPDATA%\puritty` (WS9). -}
settingsDirectory : Dict String String -> Maybe String
settingsDirectory vars =
    Maybe.map (\d -> d ++ "\\puritty") (variable "APPDATA" vars)


{-| Where each window's tabs are kept to restore them (docs/tabs.md TB10):
`%LOCALAPPDATA%\puritty\windows`, which stays on this machine. -}
stateDirectory : Dict String String -> Maybe String
stateDirectory vars =
    Maybe.map (\d -> d ++ "\\puritty\\windows") (variable "LOCALAPPDATA" vars)


{-| The program run when the settings and the command line name none, as
the programs tried in order until one starts (V54): PowerShell 7, Windows
PowerShell, then `%ComSpec%`. -}
programs : Dict String String -> Array String
programs vars =
    [ "pwsh.exe", "powershell.exe", Maybe.withDefault "cmd.exe" (variable "ComSpec" vars) ]


{-| The font drawn when the settings name none: Cascadia Mono, Windows
Terminal's, which Windows 11 has (WS21). Where it is missing, Consolas
and then Courier New stand in, as `packages/win32` looks for them. -}
font : String
font =
    "Cascadia Mono"


{-| What the locale says: the language fallback fonts are asked for (V25;
empty for none), and the character set of a local program's bytes. -}
type alias Locale =
    { language : String
    , charset : String
    }


{-| The locale, from Windows, which sets no `LANG` (WS21): the language
is the user's first (`Locale.language`) as fontconfig names one (`ko-KR`
is `ko`, `zh-Hant-TW` is `zh-tw`). The charset is UTF-8 whatever the
locale, since a pseudo console speaks nothing else; a remote program's
other one is the settings' to name. -}
locale : Dict String String -> Task x Locale
locale _ =
    Locale.language
        |> Task.map (\name -> { language = languageOf name, charset = "utf-8" })


{-| A Windows locale name's language: `zh` keeps its region, and Chinese
named by script alone is the region that writes it. -}
languageOf : String -> String
languageOf name =
    let
        parts =
            String.split "-" (String.toLower name)
    in
    when parts is
        [] ->
            ""

        [ "zh", "hans" ] ->
            "zh-cn"

        [ "zh", "hant" ] ->
            "zh-tw"

        [ "zh" ] ->
            "zh-cn"

        _ ->
            let
                lang =
                    Maybe.withDefault "" (Array.first parts)
            in
            if lang == "zh" then
                "zh-" ++ Maybe.withDefault "cn" (Array.last parts)

            else if String.count lang == 2 || String.count lang == 3 then
                lang

            else
                ""


{-| Where OpenSSH's own settings are: `%USERPROFILE%\\.ssh\\config`. -}
sshConfig : Dict String String -> Maybe String
sshConfig vars =
    Maybe.map (\h -> h ++ "\\.ssh\\config") (variable "USERPROFILE" vars)


{-| The client a host connects with when its `client` is unset: the
built-in one (`docs/ssh-client.md` SC12 question 6; Gilbert made it the
default on 2026-11-10). `client = "openssh"` keeps a host on `ssh.exe`,
and a host with a jump host is OpenSSH's until the built-in client takes
one. -}
defaultClient : String
defaultClient =
    "built-in"


{-| What `puritty` with nothing after it opens when `start` is unset
(`docs/settings-gui.md` SG8): the host list, asking where to connect: on Windows puritty is mostly an ssh client. -}
start : String
start =
    "hosts"


{-| The settings window's font (`docs/settings-gui.md` SG2): Segoe UI, Windows' own. -}
interfaceFont : String
interfaceFont =
    "Segoe UI"


{-| Whether a selection is also copied to the clipboard when the mouse
button is let go, unless the settings say (`docs/windows.md` WS27): on, as PuTTY and MobaXterm do: Windows has the clipboard alone, and users coming from them take a selection and the clipboard to be one thing. -}
copyToClipboard : Bool
copyToClipboard =
    True


{-| Whether PRIMARY is shared with the desktop's other programs
(`docs/windows.md` WS27.2): Windows has no PRIMARY: puritty keeps its own (V53). -}
sharedPrimary : Bool
sharedPrimary =
    False

