module Open exposing (link)

{-| A link opened as the desktop opens one (puritty `docs/claude-code.md`
CL9), on Windows: the shell's "open" (`Window.openLink`). `app/linux`
starts `xdg-open`. -}

import Os.Process as Process
import Task exposing (Task)
import Window


link : Maybe Process.Permission -> String -> Task x (Result String {})
link _ uri =
    Window.openLink uri
        |> Task.map
            (\opened ->
                if opened then
                    Ok {}

                else
                    Err "the shell would not open it"
            )
