            , { line = "select-pane -t :0.1    # the other pane made active", wrote = [ "%window-pane-changed @0 %2" ] }
            , { line = "select-window -t :1    # another window shown", wrote = [ "%session-window-changed $0 @1" ] }
            , { line = "select-window -t :0    # the first window shown again", wrote = [ "%session-window-changed $0 @0" ] }
