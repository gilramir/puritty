            , { line = "break-pane -d -n broke -s :5.1    # a pane broken out to a window", wrote = [ "%window-pane-changed @0 %9", "%layout-change @0 21a0,100x30,0,0[100x14,0,0,9,100x15,0,15,8] 21a0,100x30,0,0[100x14,0,0,9,100x15,0,15,8] *", "%window-renamed @6 sh", "%window-add @6" ] }
