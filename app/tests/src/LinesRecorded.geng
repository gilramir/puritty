            , { line = "split-window -d -t :0 sleep 0.5    # a pane made whose program ends", wrote = [ "%layout-change @0 c196,80x24,0,0[80x12,0,0,0,80x11,0,13,3] c196,80x24,0,0[80x12,0,0,0,80x11,0,13,3] *", "%layout-change @0 b25d,80x24,0,0,0 b25d,80x24,0,0,0 *" ] }
            , { line = "(its program ends: waited 1.5 s)", wrote = [] }
