            , { line = "resize-pane -Z -t :5    # unzoomed", wrote = [ "%layout-change @0 67e0,100x30,0,0[100x15,0,0{50x15,0,0,9,49x15,51,0,0},100x14,0,16,8] 67e0,100x30,0,0[100x15,0,0{50x15,0,0,9,49x15,51,0,0},100x14,0,16,8] *" ] }
            , { line = "resize-pane -t :5 -R 3    # a pane resized", wrote = [ "%layout-change @0 a2a0,100x30,0,0[100x15,0,0{53x15,0,0,9,46x15,54,0,0},100x14,0,16,8] a2a0,100x30,0,0[100x15,0,0{53x15,0,0,9,46x15,54,0,0},100x14,0,16,8] *", "%output %9 \\015\\033[K$ " ] }
            , { line = "select-layout -t :5 tiled    # the panes laid out tiled", wrote = [ "%layout-change @0 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] *", "%layout-change @0 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] *", "%output %8 \\015\\033[K$ ", "%output %9 \\015\\033[K$ " ] }
