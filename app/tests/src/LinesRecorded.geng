            ]
      }
    , { name = "2.9"
      , version = "2.9"
      , lines =
            [ { line = "display-message -p A ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "select-pane -t %99 ; display-message -p B", wrote = [ "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p A ; select-pane -t %99 ; display-message -p C", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p A ; select-pane -t %99", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p A ; capture-pane -p -t %99 ; display-message -p C", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p -t %99 A ; display-message -p B", wrote = [ "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "nosuchcommand ; display-message -p B", wrote = [ "%begin TIME N 1", "parse error: unknown command: nosuchcommand", "%error TIME N 1" ] }
            , { line = "display-message -p A ; nosuchcommand", wrote = [ "%begin TIME N 1", "parse error: unknown command: nosuchcommand", "%error TIME N 1" ] }
            , { line = "display-message -p A ; display-message -Z B", wrote = [ "%begin TIME N 1", "parse error: usage: display-message [-apv] [-c target-client] [-F format] [-t target-pane] [message]", "%error TIME N 1" ] }
            , { line = "display-message -p A ; display-message -p 'unclosed", wrote = [ "%begin TIME N 1", "parse error: invalid or unknown command: display-message -p A ; display-message -p 'unclosed", "%error TIME N 1" ] }
            , { line = "display-message -p A ; display-popup -E true ; display-message -p B", wrote = [ "%begin TIME N 1", "parse error: unknown command: display-popup", "%error TIME N 1" ] }
            , { line = "display-message -p A ; split-window -d -t %0 ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%layout-change @0 c195,80x24,0,0[80x12,0,0,0,80x11,0,13,1] c195,80x24,0,0[80x12,0,0,0,80x11,0,13,1] *", "%output %1 $ " ] }
            , { line = "display-message -p A ; select-pane -t %1 ; display-message -p B", wrote = [ "(the client ended)" ] }
            ]
      , notices =
            [ { line = "new-window -d -n two    # a window made, not shown", wrote = [ "%window-pane-changed @1 %1", "%window-add @1", "%output %1 $ " ] }
            , { line = "rename-window -t :1 renamed    # another window renamed", wrote = [ "%window-renamed @1 renamed" ] }
            , { line = "rename-window -t :0 first    # the shown window renamed", wrote = [ "%window-renamed @0 first" ] }
            , { line = "split-window -d -t :0    # the shown window split", wrote = [ "%layout-change @0 4196,80x24,0,0[80x12,0,0,0,80x11,0,13,2] 4196,80x24,0,0[80x12,0,0,0,80x11,0,13,2] *", "%output %2 $ " ] }
            , { line = "select-pane -t :0.1    # the other pane made active", wrote = [ "(tmux said: lost server)", "(the client ended)" ] }
            ]
      }
