            , { line = "if-shell -F 1 'select-pane -t %99' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
