      }
    , { name = "almalinux-10"
      , version = "next-3.4"
      , lines =
            [ { line = "display-message -p A ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "select-pane -t %99 ; display-message -p B", wrote = [ "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p A ; select-pane -t %99 ; display-message -p C", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p A ; select-pane -t %99", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p A ; capture-pane -p -t %99 ; display-message -p C", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1" ] }
            , { line = "display-message -p -t %99 A ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "nosuchcommand ; display-message -p B", wrote = [ "%begin TIME N 1", "parse error: unknown command: nosuchcommand", "%error TIME N 1" ] }
            , { line = "display-message -p A ; nosuchcommand", wrote = [ "%begin TIME N 1", "parse error: unknown command: nosuchcommand", "%error TIME N 1" ] }
            , { line = "display-message -p A ; display-message -Z B", wrote = [ "%begin TIME N 1", "parse error: command display-message: unknown flag -Z", "%error TIME N 1" ] }
            , { line = "display-message -p A ; display-message -p 'unclosed", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "unclosed", "%end TIME N 1" ] }
            , { line = "display-message -p A ; display-popup -E true ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "display-message -p A ; split-window -d -t %0 ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%layout-change @0 c195,80x24,0,0[80x12,0,0,0,80x11,0,13,1] c195,80x24,0,0[80x12,0,0,0,80x11,0,13,1] *", "%output %1 \\033[?2004h$ " ] }
            , { line = "display-message -p A ; select-pane -t %1 ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%window-pane-changed @0 %1" ] }
            , { line = "display-message -p A ; kill-pane -t %1 ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%layout-change @0 b25d,80x24,0,0,0 b25d,80x24,0,0,0 *", "%window-pane-changed @0 %0" ] }
            , { line = "display-message -p A ; new-window -d -n two ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%window-add @1", "%output %2 \\033[?2004h$ " ] }
            , { line = "display-message -p A ; kill-window -t :1 ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%unlinked-window-close @1" ] }
            , { line = "display-message -p A ; copy-mode -t %0 ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%pane-mode-changed %0" ] }
            , { line = "send-keys -t %0 -X cancel ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%pane-mode-changed %0" ] }
            , { line = "send-keys -t %0 -X cancel ; display-message -p B", wrote = [ "%begin TIME N 1", "not in a mode", "%error TIME N 1" ] }
            , { line = "display-message -p A ; refresh-client -C 100x30 ; display-message -p B", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1", "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%layout-change @0 a87d,100x30,0,0,0 a87d,100x30,0,0,0 *" ] }
            , { line = "refresh-client -C 80x24", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%layout-change @0 b25d,80x24,0,0,0 b25d,80x24,0,0,0 *" ] }
            , { line = "display-message M ; display-message -p B", wrote = [ "%begin TIME N 1", "%message M", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "if-shell -F 1 'display-message -p X' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "X", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "if-shell -F 1 'select-pane -t %99' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "can't find pane: %99", "%error TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "if-shell -F 1 'display-message -p X ; display-message -p Y' 'display-message -p N' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "X", "%end TIME N 1", "%begin TIME N 1", "Y", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "if-shell 'true' 'display-message -p X' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "X", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "if-shell -b 'true' 'display-message -p X' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1", "%begin TIME N 0", "X", "%end TIME N 0" ] }
            , { line = "source-file /tmp/puritty-lines.conf ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "S1", "%end TIME N 1", "%begin TIME N 1", "S2", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "run-shell 'echo ran' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%pane-mode-changed %0", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "run-shell -b 'echo ran' ; display-message -p B", wrote = [ "%begin TIME N 1", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "capture-pane -p -t %0 -S -2 ; display-message -p B", wrote = [ "%begin TIME N 1", "line 175", "line 176", "line 177", "line 178", "line 179", "line 180", "line 181", "line 182", "line 183", "line 184", "line 185", "line 186", "line 187", "line 188", "line 189", "line 190", "line 191", "line 192", "line 193", "line 194", "line 195", "line 196", "line 197", "line 198", "line 199", "line 200", "%end TIME N 1", "%begin TIME N 1", "B", "%end TIME N 1" ] }
            , { line = "   ", wrote = [] }
            , { line = ";", wrote = [ "%begin TIME N 1", "parse error: syntax error", "%error TIME N 1" ] }
            , { line = "display-message -p A ;", wrote = [ "%begin TIME N 1", "A", "%end TIME N 1" ] }
            , { line = "display-message -p A ; kill-pane -t", wrote = [ "%begin TIME N 1", "parse error: command kill-pane: -t expects an argument", "%error TIME N 1" ] }
            ]
      , notices =
            [ { line = "new-window -d -n two    # a window made, not shown", wrote = [ "%window-add @1", "%output %1 \\033[?2004h$ " ] }
            , { line = "rename-window -t :1 renamed    # another window renamed", wrote = [ "%window-renamed @1 renamed" ] }
            , { line = "rename-window -t :0 first    # the shown window renamed", wrote = [ "%window-renamed @0 first" ] }
            , { line = "split-window -d -t :0    # the shown window split", wrote = [ "%layout-change @0 4196,80x24,0,0[80x12,0,0,0,80x11,0,13,2] 4196,80x24,0,0[80x12,0,0,0,80x11,0,13,2] *", "%output %2 \\033[?2004h$ " ] }
            , { line = "select-pane -t :0.1    # the other pane made active", wrote = [ "%window-pane-changed @0 %2" ] }
            , { line = "select-window -t :1    # another window shown", wrote = [ "%session-window-changed $0 @1" ] }
            , { line = "select-window -t :0    # the first window shown again", wrote = [ "%session-window-changed $0 @0" ] }
            , { line = "kill-pane -t :0.1    # a pane of the shown window killed", wrote = [ "%layout-change @0 b25d,80x24,0,0,0 b25d,80x24,0,0,0 *", "%window-pane-changed @0 %0" ] }
            , { line = "split-window -d -t :0 sleep 0.5    # a pane made whose program ends", wrote = [ "%layout-change @0 c196,80x24,0,0[80x12,0,0,0,80x11,0,13,3] c196,80x24,0,0[80x12,0,0,0,80x11,0,13,3] *", "%layout-change @0 b25d,80x24,0,0,0 b25d,80x24,0,0,0 *" ] }
            , { line = "(its program ends: waited 1.5 s)", wrote = [] }
            , { line = "new-window -d -n short sleep 0.5    # a window made whose program ends", wrote = [ "%window-add @2", "%unlinked-window-close @2" ] }
            , { line = "(that window's last pane's program ends: waited 1.5 s)", wrote = [] }
            , { line = "kill-window -t :1    # another window killed", wrote = [ "%unlinked-window-close @1" ] }
            , { line = "new-window -n brief sleep 0.8    # a window made and shown, whose program ends", wrote = [ "%session-window-changed $0 @3", "%window-add @3" ] }
            , { line = "(the shown window's last pane's program ends: waited 2.0 s)", wrote = [ "%session-window-changed $0 @0", "%unlinked-window-close @3" ] }
            , { line = "new-session -d -s other -n elsewhere    # a session made", wrote = [ "%unlinked-window-add @4", "%sessions-changed" ] }
            , { line = "new-window -d -t other:    # a window made in the other session", wrote = [ "%unlinked-window-add @5", "%unlinked-window-renamed @5 tmux" ] }
            , { line = "rename-window -t other:1 far    # a window of the other session renamed", wrote = [ "%unlinked-window-renamed @5 sh", "%unlinked-window-renamed @5 far" ] }
            , { line = "kill-window -t other:1    # a window of the other session killed", wrote = [ "%unlinked-window-close @5" ] }
            , { line = "rename-session -t other renamed-session    # the other session renamed", wrote = [ "%session-renamed $1 renamed-session" ] }
            , { line = "rename-session -t main main2    # the shown session renamed", wrote = [ "%session-renamed $0 main2" ] }
            , { line = "rename-session -t main2 main    # the shown session renamed back", wrote = [ "%session-renamed $0 main" ] }
            , { line = "kill-session -t renamed-session    # the other session killed", wrote = [ "%sessions-changed", "%unlinked-window-close @4" ] }
            , { line = "copy-mode -t :0.0    # copy mode entered", wrote = [ "%pane-mode-changed %0" ] }
            , { line = "send-keys -t :0.0 -X cancel    # copy mode left", wrote = [ "%pane-mode-changed %0" ] }
