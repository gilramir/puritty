            , { line = "respawn-pane -k -t :5.1    # a pane respawned", wrote = [ "%output %0 line 1\\015\\012line 2\\015\\012line 3\\015\\012line 4\\015\\012line 5\\015\\012line 6\\015\\012line 7\\015\\012line 8\\015\\012line 9\\015\\012line 10\\015\\012line 11\\015\\012line 12\\015\\012line 13\\015\\012line 14\\015\\012line 15\\015\\012line 16\\015\\012line 17\\015\\012line 18\\015\\012line 19\\015\\012line 20\\015\\012line 21\\015\\012line 22\\015\\012line 23\\015\\012line 24\\015\\012line 25\\015\\012line 26\\015\\012line 27\\015\\012line 28\\015\\012line 29\\015\\012line 30\\015\\012line 31\\015\\012line 32\\015\\012line 33\\015\\012line 34\\015\\012line 35\\015\\012line 36\\015\\012line 37\\015\\012line 38\\015\\012line 39\\015\\012line 40\\015\\012line 41\\015\\012line 42\\015\\012line 43\\015\\012line 44\\015\\012line 45\\015\\012line 46\\015\\012line 47\\015\\012line 48\\015\\012line 49\\015\\012line 50\\015\\012line 51\\015\\012line 52\\015\\012line 53\\015\\012line 54\\015\\012line 55\\015\\012line 56\\015\\012line 57\\015\\012line 58\\015\\012line 59\\015\\012line 60\\015\\012line 61\\015\\012line 62\\015\\012line 63\\015\\012line 64\\015\\012line 65\\015\\012line 66\\015\\012line 67\\015\\012line 68\\015\\012line 69\\015\\012line 70\\015\\012line 71\\015\\012line 72\\015\\012line 73\\015\\012line 74\\015\\012line 75\\015\\012line 76\\015\\012line 77\\015\\012line 78\\015\\012line 79\\015\\012line 80\\015\\012line 81\\015\\012line 82\\015\\012line 83\\015\\012line 84\\015\\012line 85\\015\\012line 86\\015\\012line 87\\015\\012line 88\\015\\012line 89\\015\\012line 90\\015\\012line 91\\015\\012line 92\\015\\012line 93\\015\\012line 94\\015\\012line 95\\015\\012line 96\\015\\012line 97\\015\\012line 98\\015\\012line 99\\015\\012line 100\\015\\012line 101\\015\\012line 102\\015\\012line 103\\015\\012line 104\\015\\012line 105\\015\\012line 106\\015\\012line 107\\015\\012line 108\\015\\012line 109\\015\\012line 110\\015\\012line 111\\015\\012line 112\\015\\0