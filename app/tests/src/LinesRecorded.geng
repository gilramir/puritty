            , { line = "select-layout -t :5 tiled    # the panes laid out tiled", wrote = [ "%layout-change @0 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] *", "%layout-change @0 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] 36b8,100x30,0,0[100x14,0,0{49x14,0,0,9,50x14,50,0,0},100x15,0,15,8] *" ] }
            , { line = "respawn-pane -k -t :5.1    # a pane respawned", wrote = [ "%output %0 line 1\\015\\012line 2\\015\\012line 3\\015\\012line 4\\015\\012line 5\\015\\012line 6\\015\\012line 7\\015\\012line 8\\015\\012line 9\\015\\012line 10\\015\\012line 11\\015\\012line 12\\015\\012line 13\\015\\012line 14\\015\\012line 15\\015\\012line 16\\015\\012line 17\\015\\012line 18\\015\\012line 19\\015\\012line 20\\015\\012line 21\\015\\012line 22\\015\\012line 23\\015\\012line 24\\015\\012line 25\\015\\012line 26\\015\\012line 27\\015\\012line 28\\015\\012line 29\\015\\012line 30\\015\\012line 31\\015\\012line 32\\015\\012line 33\\015\\012line 34\\015\\012line 35\\015\\012line 36\\015\\012line 37\\015\\012line 38\\015\\012line 39\\015\\012line 40\\015\\012line 41\\015\\012line 42\\015\\012line 43\\015\\012line 44\\015\\012line 45\\015\\012line 46\\015\\012line 47\\015\\012line 48\\015\\012line 49\\015\\012line 50\\015\\012line 51\\015\\012line 52\\015\\012line 53\\015\\012line 54\\015\\012line 55\\015\\012line 56\\015\\012line 57\\015\\012line 58\\015\\012line 59\\015\\012line 60\\015\\012line 61\\015\\012line 62\\015\\012line 63\\015\\012line 64\\015\\012line 65\\015\\012line 66\\015\\012line 67\\015\\012line 68\\015\\012line 69\\015\\012line 70\\015\\012line 71\\015\\012line 72\\015\\012line 73\\015\\012line 74\\015\\012line 75\\015\\012line 76\\015\\012line 77\\015\\012line 78\\015\\012line 79\\015\\012line 80\\015\\012line 81\\015\\012line 82\\015\\012line 83\\015\\012line 84\\015\\012line 85\\015\\012line 86\\015\\012line 87\\015\\012line 88\\015\\012line 89\\015\\012line 90\\015\\012line 91\\015\\012line 92\\015\\012line 93\\015\\012line 94\\015\\012line 95\\015\\012line 96\\015\\012line 97\\015\\012line 98\\015\\012line 99\\015\\012line 100\\015\\012line 101\\015\\012line 102\\015\\012line 103\\015\\012line 104\\015\\012line 105\\015\\012line 106\\015\\012line 107\\015\\012line 108\\015\\012line 109\\015\\012line 110\\015\\012line 111\\015\\012line 112\\015\\012line 113\\015\\012line 114\\015\\012line 115\\015\\012line 116\\015\\012line 117\\015\\012line 118\\015\\012line 119\\015\\012line 120\\015\\012line 121\\015\\012line 122\\015\\012line 123\\015\\012line 124\\015\\012line 125\\015\\012line 126\\015\\012line 127\\015\\012line 128\\015\\012line 129\\015\\012line 130\\015\\012line 131\\015\\012line 132\\015\\012line 133\\015\\012line 134\\015\\012line 135\\015\\012line 136\\015\\012line 137\\015\\012line 138\\015\\012line 139\\015\\012line 140\\015\\012line 141\\015\\012line 142\\015\\012line 143\\015\\012line 144\\015\\012line 145\\015\\012line 146\\015\\012line 147\\015\\012line 148\\015\\012line 149\\015\\012line 150\\015\\012line 151\\015\\012line 152\\015\\012line 153\\015\\012line 154\\015\\012line 155\\015\\012line 156\\015\\012line 157\\015\\012line 158\\015\\012line 159\\015\\012line 160\\015\\012line 161\\015\\012line 162\\015\\012line 163\\015\\012line 164\\015\\012line 165\\015\\012line 166\\015\\012line 167\\015\\012line 168\\015\\012line 169\\015\\012line 170\\015\\012line 171\\015\\012line 172\\015\\012line 173\\015\\012line 174\\015\\012line 175\\015\\012line 176\\015\\012line 177\\015\\012line 178\\015\\012line 179\\015\\012line 180\\015\\012line 181\\015\\012line 182\\015\\012line 183\\015\\012line 184\\015\\012line 185\\015\\012line 186\\015\\012line 187\\015\\012line 188\\015\\012line 189\\015\\012line 190\\015\\012line 191\\015\\012line 192\\015\\012line 193\\015\\012line 194\\015\\012line 195\\015\\012line 196\\015\\012line 197\\015\\012line 198\\015\\012line 199\\015\\012line 200" ] }
            , { line = "break-pane -d -n broke -s :5.1    # a pane broken out to a window", wrote = [ "%window-pane-changed @0 %9", "%layout-change @0 21a0,100x30,0,0[100x14,0,0,9,100x15,0,15,8] 21a0,100x30,0,0[100x14,0,0,9,100x15,0,15,8] *", "%window-renamed @6 broke", "%window-add @6" ] }
            , { line = "join-pane -d -s :broke -t :5    # a pane joined back", wrote = [ "%unlinked-window-close @6", "%layout-change @0 e1ab,100x30,0,0[100x7,0,0,9,100x6,0,8,0,100x15,0,15,8] e1ab,100x30,0,0[100x7,0,0,9,100x6,0,8,0,100x15,0,15,8] *" ] }
            , { line = "new-window -d -n swap    # a window made, then two windows swapped", wrote = [ "%window-add @7", "%output %10 $ " ] }
            , { line = "swap-window -s :5 -t :swap    # swapped", wrote = [] }
            , { line = "kill-server    # the server killed", wrote = [ "%sessions-changed", "%exit", "(the client ended)" ] }
            ]
      }
    ]
