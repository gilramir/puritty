module PickerTests exposing (picker)

{-| The folder picker (`docs/sftp.md` FT32, FT33) told a listing and keys,
and its memory's file read back. -}

import Bytes exposing (Bytes)
import Expect exposing (Expectation)
import Folders
import Picker exposing (Answer(..), Ask(..), Kind(..))
import Recent
import Task
import Test.Runner.UnitNode as U
import TmuxMode
import UInt8


with : Picker.With
with =
    { decode = Bytes.toStringLossy, encode = \s -> Just (Bytes.fromString s) }


folderNamed : String -> Picker.Entry
folderNamed name =
    { name = Bytes.fromString name, kind = Folder, link = Nothing, size = Nothing, mtime = Nothing }


opened : { picker : Picker.Picker, requests : Array Picker.Request }
opened =
    Picker.open { host = "h", files = [], at = Bytes.fromString "/x", places = { shell = Nothing, home = Nothing, recent = [], bookmarks = [] } }


{-| The picker at `/x`, its listing come in two parts: `a`, then `b`. -}
listedAt : Picker.Picker
listedAt =
    let
        first =
            Picker.answer with (Listed { id = 1, path = Bytes.fromString "/x", entries = [ folderNamed "a" ], more = True }) opened.picker

        second =
            Picker.answer with (Listed { id = 1, path = Bytes.fromString "/x", entries = [ folderNamed "b" ], more = False }) first.picker
    in
    second.picker


press : Int -> Int -> Int -> Picker.Picker -> Picker.Step
press sym unshifted mods p =
    Picker.key with { sym = sym, unshifted = unshifted, mods = mods, text = "" } p


asks : Array Picker.Request -> Array String
asks requests =
    Array.map
        (\r ->
            when r.ask is
                List path ->
                    "list " ++ Bytes.toStringLossy path

                MakeFolder path ->
                    "make " ++ Bytes.toStringLossy path
        )
        requests


picker : U.Suite
picker =
    U.suite
        { name = "picker"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests = Array.map (\c -> U.test c.name (\_ -> Task.succeed (c.test {}))) cases
        }


cases : Array { name : String, test : {} -> Expectation }
cases =
    [ { name = "after End, the wheel scrolls up from the rows shown, and the view stays where the wheel put it (review PS11)"
      , test =
            \_ ->
                let
                    size =
                        { cols = 100, rows = 40, cellWidth = 9, cellHeight = 17 }

                    many =
                        (Picker.answer with (Listed { id = 1, path = Bytes.fromString "/x", entries = Array.map (\k -> folderNamed ("f" ++ String.padLeft 4 '0' (String.fromInt k))) (Array.range 0 1999), more = False }) opened.picker).picker

                    ended =
                        (press 0xFF57 0xFF57 0 many).picker

                    wheel p =
                        (Picker.pointer size with { action = 0, button = 4, x = 300, y = 300, ms = 0 } p).picker

                    once =
                        wheel ended

                    twice =
                        wheel once
                in
                Expect.equal { scrolled = True, again = 3 }
                    { scrolled = once.top > 1900 && once.top < 1999, again = once.top - twice.top }
      }
    , { name = "it opens by listing the folder it starts at"
      , test = \_ -> Expect.equal [ "list /x" ] (asks opened.requests)
      }
    , { name = "Enter with nothing highlighted goes nowhere, after a listing's second part (Array.get reads -1 from the end)"
      , test = \_ -> Expect.equal [] (asks (press 0xFF0D 0 0 listedAt).requests)
      }
    , { name = "Down, Down and Enter go into the folder under `..`"
      , test =
            \_ ->
                let
                    down =
                        (press 0xFF54 0 0 (press 0xFF54 0 0 listedAt).picker).picker
                in
                Expect.equal [ "list /x/a" ] (asks (press 0xFF0D 0 0 down).requests)
      }
    , { name = "Ctrl+Enter sends to the folder you are in, whatever is highlighted"
      , test =
            \_ ->
                let
                    down =
                        (press 0xFF54 0 0 (press 0xFF54 0 0 listedAt).picker).picker
                in
                Expect.equal (Picker.Send (Bytes.fromString "/x")) (press 0xFF0D 0 2 down).outcome
      }
    , { name = "a typed folder the host answers by another path completes without asking again, and Tab stops where all the matches agree (review PS18)"
      , test =
            \_ ->
                let
                    typeIn text p0 =
                        String.foldl
                            (\c acc ->
                                let
                                    r =
                                        Picker.key with { sym = Char.toCode c, unshifted = Char.toCode c, mods = 0, text = String.fromChar c } acc.picker
                                in
                                { picker = r.picker, requests = acc.requests ++ r.requests }
                            )
                            { picker = p0, requests = [] }
                            text

                    peeked =
                        typeIn "/var/www/" listedAt

                    -- nine folders under the link's target: the first eight
                    -- agree as far as `alpha`, all nine as far as `alp`
                    names =
                        Array.map (\i -> "alpha" ++ String.fromInt i) (Array.range 1 8) ++ [ "alpine" ]

                    answeredBy path =
                        when Array.last peeked.requests is
                            Just r ->
                                (Picker.answer with (Listed { id = r.id, path = Bytes.fromString path, entries = Array.map folderNamed names, more = False }) peeked.picker).picker

                            Nothing ->
                                peeked.picker

                    answered =
                        answeredBy "/srv/www"

                    -- answered by the path asked: Tab alone
                    direct =
                        press 0xFF09 0xFF09 0 (typeIn "a" (answeredBy "/var/www")).picker

                    more =
                        typeIn "a" answered

                    tabbed =
                        press 0xFF09 0xFF09 0 more.picker

                    typedNow t =
                        when t.typing is
                            Just e ->
                                String.fromArray e.edit.chars

                            Nothing ->
                                ""
                in
                Expect.equal { peeks = [ "list /", "list /var", "list /var/www" ], again = [], tab = "/var/www/alp", tabDirect = "/var/www/alp" }
                    { peeks = asks peeked.requests, again = asks more.requests, tab = typedNow tabbed.picker, tabDirect = typedNow direct.picker }
      }
    , { name = "the places column scrolls by the wheel and its hidden rows take no click (review PS19)"
      , test =
            \_ ->
                let
                    size =
                        { cols = 100, rows = 14, cellWidth = 9, cellHeight = 17 }

                    l =
                        Picker.layout size

                    marks =
                        Array.range 0 19 |> Array.map (\i -> Bytes.fromString ("/b" ++ String.padLeft 2 '0' (String.fromInt i)))

                    p0 =
                        (Picker.open { host = "h", files = [], at = Bytes.fromString "/x", places = { shell = Nothing, home = Nothing, recent = [], bookmarks = marks } }).picker

                    x =
                        l.placesX + 10

                    at button y p =
                        Picker.pointer size with { action = 0, button = button, x = x, y = y, ms = 0 } p

                    clicked y p =
                        asks (at 1 y p).requests
                            ++ asks (Picker.pointer size with { action = 1, button = 1, x = x, y = y, ms = 0 } (at 1 y p).picker).requests

                    scrolled =
                        Array.foldl (\_ p -> (at 5 (l.bodyY + 5) p).picker) p0 (Array.range 1 10)

                    bookmarkAsked r =
                        Array.any (String.startsWith "list /b") r
                in
                Expect.equal { below = False, scrolledTop = True }
                    { below = bookmarkAsked (clicked (l.bodyBottom + 2) p0)
                    , scrolledTop = bookmarkAsked (clicked (l.bodyY + 5) scrolled)
                    }
      }
    , { name = "Ctrl+D bookmarks the folder you are in, and again takes it off"
      , test =
            \_ ->
                let
                    marked =
                        (press 0x64 0x64 2 listedAt).picker
                in
                Expect.equal [ [ "/x" ], [] ] [ Array.map Bytes.toStringLossy (Picker.bookmarks marked), Array.map Bytes.toStringLossy (Picker.bookmarks (press 0x64 0x64 2 marked).picker) ]
      }
    , { name = "choose-buffer's and choose-client's rows asked in each tmux's own words: t/p from 3.2, size and time before (review TB8)"
      , test =
            \_ ->
                Expect.equal
                    [ True, True, False, False, True, True ]
                    [ String.contains "#{buffer_size} bytes (#{t:buffer_created})" (TmuxMode.listQuery 27 "buffer").command
                    , String.contains "session #{session_name} (#{client_width}x#{client_height}, #{t:client_activity})" (TmuxMode.listQuery 30 "client").command
                    , String.contains "t/p:" (TmuxMode.listQuery 31 "buffer").command
                    , String.contains "t/p:" (TmuxMode.listQuery 27 "client").command
                    , String.contains "#{t/p:buffer_created}: #{buffer_sample}" (TmuxMode.listQuery 38 "buffer").command
                    , String.contains "#{t/p:client_activity}: session #{session_name}" (TmuxMode.listQuery 32 "client").command
                    ]
      }
    , { name = "a pane running ssh: an OSC 7 with no host or localhost is not taken for a folder on tmux's host; one naming tmux's host is (review TB16)"
      , test =
            \_ ->
                let
                    folder command uri =
                        TmuxMode.dropFolderOf (Array.map Bytes.fromString [ "/home/me", command, uri, "box.example", "box" ])
                in
                Expect.equal
                    [ TmuxMode.NoFolder "the pane runs ssh, whose folder tmux can't see"
                    , TmuxMode.NoFolder "the pane runs ssh, whose folder tmux can't see"
                    , TmuxMode.Folder (Bytes.fromString "/srv/www")
                    , TmuxMode.Folder (Bytes.fromString "/srv/www")
                    ]
                    [ folder "ssh" "file:///srv/www", folder "ssh" "file://localhost/srv/www", folder "ssh" "file://box/srv/www", folder "bash" "file:///srv/www" ]
      }
    , { name = "a tmux pane's drop label: a path that fits whole"
      , test = \_ -> Expect.equal " Drop into /srv/www/site " (TmuxMode.dropLabel 40 (TmuxMode.Folder (Bytes.fromString "/srv/www/site")))
      }
    , { name = "a tmux pane's drop label: a long path keeps its last names whole"
      , test = \_ -> Expect.equal " Drop into /…/assets/site " (TmuxMode.dropLabel 26 (TmuxMode.Folder (Bytes.fromString "/home/me/projects/assets/site")))
      }
    , { name = "a tmux pane's drop label: a last name too long by itself loses its middle"
      , test = \_ -> Expect.equal " Drop into /…/customer…-11-20-final " (TmuxMode.dropLabel 36 (TmuxMode.Folder (Bytes.fromString "/srv/customer-portal-deployment-2026-11-20-final")))
      }
    , { name = "a tmux pane's drop label: a name of 4,000 characters loses its middle, found in a few tries (review PS8)"
      , test =
            \_ ->
                Expect.equal (" Drop into /…/" ++ String.repeat 16 "s" ++ "…" ++ String.repeat 28 "e" ++ " ")
                    (TmuxMode.dropLabel 60 (TmuxMode.Folder (Bytes.fromString ("/" ++ String.repeat 2000 "s" ++ String.repeat 2000 "e"))))
      }
    , { name = "a tmux pane's drop label: of 1,500 names the last that fit, found in a few tries (review PS8)"
      , test =
            \_ ->
                Expect.equal " Drop into /…/n/n/n/n/n/n/n/n/n/n/n/n/n/n/n/n/n/n/n/n/n/end "
                    (TmuxMode.dropLabel 60 (TmuxMode.Folder (Bytes.fromString (String.repeat 1500 "/n" ++ "/end"))))
      }
    , { name = "a name cut in its middle keeps the most that fit, found by halves (review PS8)"
      , test =
            \_ ->
                Expect.equal [ 1234, 3999, 1 ]
                    [ Picker.keptFitting (\keep -> keep <= 1234) 1 3999
                    , Picker.keptFitting (\_ -> True) 1 3999
                    , Picker.keptFitting (\_ -> False) 1 3999
                    ]
      }
    , { name = "a folder of 20,000 names come 100 at a time, out of order: each part merged in, all in order at the end (review PS9)"
      , test =
            \_ ->
                let
                    named i =
                        "f" ++ String.padLeft 5 '0' (String.fromInt i)

                    part k =
                        Array.range (k * 100) (k * 100 + 99) |> Array.map (\i -> folderNamed (named (modBy 20000 (i * 7919))))

                    final =
                        Array.foldl
                            (\k p -> (Picker.answer with (Listed { id = 1, path = Bytes.fromString "/x", entries = part k, more = k < 199 }) p).picker)
                            opened.picker
                            (Array.range 0 199)
                in
                Expect.equal (Array.map named (Array.range 0 19999)) (Array.map (\e -> Bytes.toStringLossy e.name) final.entries)
      }
    , { name = "names in the host's character set: sorted and filtered as it reads them, not as UTF-8 (review PS7)"
      , test =
            \_ ->
                let
                    zeta =
                        Bytes.fromUInt8s (Array.map UInt8.fromIntWrap [ 0xA1 ])

                    alpha =
                        Bytes.fromUInt8s (Array.map UInt8.fromIntWrap [ 0xB2 ])

                    -- a host whose character set reads 0xA1 as "Zeta" and
                    -- 0xB2 as "alpha", neither of them UTF-8
                    host =
                        { decode =
                            \b ->
                                if b == zeta then
                                    "Zeta"

                                else if b == alpha then
                                    "alpha"

                                else
                                    Bytes.toStringLossy b
                        , encode = \t -> Just (Bytes.fromString t)
                        }

                    shown =
                        (Picker.answer host (Listed { id = 1, path = Bytes.fromString "/x", entries = [ { name = zeta, kind = Folder, link = Nothing, size = Nothing, mtime = Nothing }, { name = alpha, kind = Folder, link = Nothing, size = Nothing, mtime = Nothing } ], more = False }) opened.picker).picker

                    filtered =
                        (Picker.key host { sym = 0x70, unshifted = 0x70, mods = 0, text = "alp" } shown).picker

                    drawn =
                        Bytes.toStringLossy (Picker.draw { cols = 100, rows = 30, cellWidth = 8, cellHeight = 16 } host Picker.utcText filtered).list
                in
                Expect.equal { order = [ alpha, zeta ], alphaShown = True, zetaShown = False }
                    { order = Array.map .name shown.entries, alphaShown = String.contains "alpha" drawn, zetaShown = String.contains "Zeta" drawn }
      }
    , { name = "a folder refreshed while its listing comes: the two listings' parts interleave, and what is shown is the second's whole (review PS6)"
      , test =
            \_ ->
                let
                    part id names more p =
                        (Picker.answer with (Listed { id = id, path = Bytes.fromString "/x", entries = Array.map folderNamed names, more = more }) p).picker

                    firstPart =
                        part 1 [ "a", "b" ] True opened.picker

                    -- Ctrl+R: the folder asked for again, as request 2
                    again =
                        (press 0x72 0x72 2 firstPart).picker

                    final =
                        again
                            |> part 2 [ "a", "b" ] True
                            |> part 1 [ "c" ] False
                            |> part 2 [ "c" ] False
                in
                Expect.equal { names = [ "a", "b", "c" ], complete = True }
                    { names = Array.map (\e -> Bytes.toStringLossy e.name) final.entries, complete = final.complete }
      }
    , { name = "the folders' file read back: a path not UTF-8 as bytes, a host of a later kind passed over"
      , test =
            \_ ->
                let
                    folders =
                        [ { host = Folders.Saved "web1", recent = [ Bytes.fromString "/srv/www" ], bookmarks = [] }
                        , { host = Folders.Ssh "me@h:22", recent = [], bookmarks = [ Bytes.fromString "/var/log", Bytes.fromUInt8s (Array.map UInt8.fromIntWrap [ 0x2F, 0xB0, 0xA1 ]) ] }
                        ]
                in
                Expect.equal folders (Folders.fromText (Folders.toText folders ++ "\n[[hosts]]\nlater = \"x\"\nrecent = [\"/y\"]\n"))
      }
    , { name = "the folders' file as TOML"
      , test =
            \_ ->
                Expect.equal "[[hosts]]\nhost = \"web1\"\nrecent = [\"/srv/www\"]\n\n[[hosts]]\nssh = \"me@h:22\"\nbookmarks = [{ bytes = \"2fb0a1\" }]\n"
                    (Folders.toText
                        [ { host = Folders.Saved "web1", recent = [ Bytes.fromString "/srv/www" ], bookmarks = [] }
                        , { host = Folders.Ssh "me@h:22", recent = [], bookmarks = [ Bytes.fromUInt8s (Array.map UInt8.fromIntWrap [ 0x2F, 0xB0, 0xA1 ]) ] }
                        ]
                    )
      }
    , { name = "the recent connections' file read back, a connection of another kind passed over"
      , test =
            \_ ->
                let
                    recents =
                        [ Recent.Quick "me@h tmux -CC attach", Recent.Saved "build-box" ]
                in
                Expect.equal recents (Recent.fromText (Recent.toText recents ++ "\n[[connections]]\nlater = \"x\"\n"))
      }
    , { name = "the old recent.txt read for its one import into recent.toml"
      , test =
            \_ ->
                Expect.equal [ Recent.Quick "me@h tmux -CC attach", Recent.Saved "build-box" ]
                    (Recent.fromOldText "quick me@h tmux -CC attach\nhost build-box\nlater x\nhost \n")
      }
    ]
