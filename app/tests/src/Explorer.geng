module Explorer exposing (explorer, lineShapesDiffer, noticesDiffer, violations)

{-| Check 3 (`docs/tmux-checks.md` TK4, TK10): puritty's real `TmuxMode`
against the fake tmux, in every order the conversation can take.

At each point one of these happens: tmux runs the next line puritty sent
it; puritty reads the next thing tmux wrote; something happens in tmux's
world (a pane's program exits); or the user acts. Each scenario is
explored breadth first, and after every step two things must hold, for
each tmux's rules for a line of several commands (`FakeTmux.rulesOf`, as
measured on every dumped tmux):

  - **no answer without a question**: puritty never reads a block of its
    own commands while it waits for nothing (its log's `for nothing waited
    for`);
  - **nothing owed when all is said**: once tmux has run every line and
    puritty has read every block, puritty waits for nothing;
  - **a reply waited for each command**: what the user does makes puritty
    wait for as many replies as the commands in the lines it sends.

A step that breaks one is reported with the steps that led to it, the
shortest such path. States already seen are skipped: two paths are the
same state when tmux has the same lines to run and the same bytes to
write, the same world events are left, and puritty has read the same
bytes and done the same things between them.

The fake's rules are held to what every dumped tmux wrote
(`lineShapesDiffer`, `LinesRecorded`).
-}

import Bytes
import Dict exposing (Dict)
import Expect
import FakeTmux exposing (World)
import LinesRecorded
import Task
import Test.Runner.UnitNode as U
import Tmux.Command as Command
import Tmux.Syntax as Syntax
import TmuxMode


-- WHAT THE REAL TMUXES WROTE, AND THE FAKE


{-| What tmux wrote for a line, as its shape: each block `ok` or `error`
(with `/0` when not this client's, flags 0), a `%message` inside one, each
notification by its name, `%output` left out, and a bare line `text`. -}
shapeOf : Array String -> String
shapeOf wrote =
    Array.foldl
        (\line acc ->
            if String.startsWith "%begin " line then
                { acc | inside = True, own = String.endsWith " 1" line }

            else if String.startsWith "%end " line || String.startsWith "%error " line then
                { acc
                    | inside = False
                    , shape =
                        Array.pushLast
                            ((if String.startsWith "%end " line then
                                "ok"

                              else
                                "error"
                             )
                                ++ (if acc.own then
                                        ""

                                    else
                                        "/0"
                                   )
                            )
                            acc.shape
                }

            else if acc.inside then
                if String.startsWith "%message " line then
                    { acc | shape = Array.pushLast "message" acc.shape }

                else
                    acc

            else if String.startsWith "%output " line then
                acc

            else if String.startsWith "%" line then
                { acc | shape = Array.pushLast (String.split " " line |> Array.first |> Maybe.withDefault line) acc.shape }

            else
                { acc | shape = Array.pushLast "text" acc.shape }
        )
        { inside = False, own = True, shape = [] }
        wrote
        |> .shape
        |> String.join " "


{-| The lines of dump-lines.py's the fake models: those whose commands it
has, in a window it can hold. Left out: panes and windows made and killed
(`split-window`, `new-window`), `refresh-client -C` (whose size each tmux
takes in its own form, check 1's, TK7), `run-shell` (a shell), a command
not every tmux has (`display-popup`, check 1's), and `kill-pane -t` with
its argument missing (3.3 ends its server). -}
modeled : String -> Bool
modeled line =
    not (Array.any (\word -> String.contains word line) [ "split-window", "select-pane -t %1", "kill-pane", "new-window", "kill-window", "refresh-client", "run-shell", "display-popup" ])


{-| The fake, following `rules`' tmux, answering the lines it models in
order, each answer's shape. -}
fakeShapes : String -> Array String -> Array String
fakeShapes rules lines =
    let
        made =
            FakeTmux.world { version = "3.8", cols = 80, rows = 24, lines = [ "line 200" ] }

        start =
            { made | rules = rules, files = Dict.singleton "/tmp/puritty-lines.conf" "display-message -p S1\ndisplay-message -p S2\n" }
    in
    Array.foldl
        (\line acc ->
            let
                answered =
                    FakeTmux.answer line acc.w

                wrote =
                    Bytes.toStringLossy answered.bytes |> String.split "\u{000D}\n" |> Array.keepIf (\l -> l /= "")
            in
            { w = answered.world, shapes = Array.pushLast (shapeOf wrote) acc.shapes }
        )
        { w = start, shapes = [] }
        lines
        |> .shapes


{-| Each line the fake models where its answer's shape is not the one the
real tmux wrote, for every dumped tmux: `name: line: tmux …, fake …`. A
record that ends where its tmux ended the client (2.9) is held to as far
as it goes. -}
lineShapesDiffer : Array String
lineShapesDiffer =
    LinesRecorded.recorded
        |> Array.mapAndFlatten
            (\tmux ->
                let
                    ended =
                        Array.findFirst (\l -> Array.member "(the client ended)" l.wrote) tmux.lines
                            |> Maybe.map .index
                            |> Maybe.withDefault (Array.length tmux.lines)

                    asked =
                        Array.takeFirst ended tmux.lines |> Array.keepIf (\l -> modeled l.line)

                    fake =
                        fakeShapes tmux.version (Array.map .line asked)
                in
                Array.indexedMap (\i l -> { l = l, ours = Maybe.withDefault "?" (Array.get i fake) }) asked
                    |> Array.mapAndKeepJust
                        (\pair ->
                            let
                                l =
                                    pair.l

                                real =
                                    shapeOf l.wrote

                                ours =
                                    pair.ours
                            in
                            if real == ours then
                                Nothing

                            else
                                Just (tmux.name ++ ": " ++ l.line ++ ": tmux " ++ real ++ ", fake " ++ ours)
                        )
            )


{-| The steps of dump-notices.py the fake models (TK11), by what each
step is, and the event it is in the fake; windows' ids as a fresh server
gives them, the steps between that it does not model left out. -}
noticeSteps : Array { what : String, happen : World -> { world : World, notices : Array String } }
noticeSteps =
    [ { what = "a window made, not shown", happen = FakeTmux.addWindow 1 1 }
    , { what = "another window renamed", happen = FakeTmux.renameWindow 1 "renamed" }
    , { what = "the shown window renamed", happen = FakeTmux.renameWindow 0 "first" }
    , { what = "another window shown", happen = FakeTmux.switchWindow 1 }
    , { what = "the first window shown again", happen = FakeTmux.switchWindow 0 }
    , { what = "another window killed", happen = FakeTmux.closeWindow 1 }
    , { what = "a window made and shown, whose program ends", happen = openedShown 3 5 }
    , { what = "the shown window's last pane's program ends", happen = FakeTmux.closeWindow 3 }
    ]


{-| A window made and shown (`new-window` without `-d`): on 2.x its pane
said active, the window added, then the session's window changed; from
3.0 the session's window changed, then the window added. -}
openedShown : Int -> Int -> World -> { world : World, notices : Array String }
openedShown id pane w =
    let
        added =
            FakeTmux.addWindow id pane w

        shown =
            FakeTmux.switchWindow id added.world
    in
    { world = shown.world
    , notices =
        -- 2.x adds the window before it shows it; 3.x shows it first
        -- (notices.txt, TK11)
        if Array.any (String.startsWith "%window-pane-changed") added.notices then
            added.notices ++ shown.notices

        else
            Array.keepIf (\n -> not (String.startsWith "%window-add" n)) added.notices
                ++ shown.notices
                ++ Array.keepIf (String.startsWith "%window-add") added.notices
    }


{-| A notification about windows, as its name and the window it names. -}
windowNotice : String -> Maybe String
windowNotice line =
    let
        parts =
            String.split " " line

        name =
            Maybe.withDefault "" (Array.first parts)
    in
    if Array.member name [ "%window-add", "%window-close", "%unlinked-window-close", "%window-renamed", "%unlinked-window-renamed", "%session-window-changed", "%window-pane-changed" ] then
        Just (name ++ " " ++ (Array.findFirst (String.startsWith "@") parts |> Maybe.map .value |> Maybe.withDefault ""))

    else
        Nothing


{-| Each step the fake models where what it tells of windows is not what
the real tmux told, for every dumped tmux: `name: step: tmux …, fake …`.
A record that ends where its tmux ended the client is held to as far as
it goes. -}
noticesDiffer : Array String
noticesDiffer =
    LinesRecorded.recorded
        |> Array.mapAndFlatten
            (\tmux ->
                let
                    made =
                        FakeTmux.world { version = "3.8", cols = 80, rows = 24, lines = [ "line 200" ] }

                    ended =
                        Array.findFirst (\l -> Array.member "(the client ended)" l.wrote) tmux.notices |> Maybe.map .index |> Maybe.withDefault (Array.length tmux.notices)

                    recordedOf what =
                        Array.takeFirst ended tmux.notices
                            |> Array.findFirst (\l -> String.contains ("# " ++ what) l.line || String.contains ("(" ++ what ++ ":") l.line)
                            |> Maybe.map (\found -> Array.mapAndKeepJust (\l -> windowNotice (String.trim l)) found.value.wrote)
                in
                Array.foldl
                    (\s acc ->
                        let
                            done =
                                s.happen acc.w

                            ours =
                                Array.mapAndKeepJust windowNotice done.notices
                        in
                        { w = done.world
                        , differ =
                            when recordedOf s.what is
                                Just real ->
                                    if real == ours then
                                        acc.differ

                                    else
                                        Array.pushLast (tmux.name ++ ": " ++ s.what ++ ": tmux " ++ String.join ", " real ++ "; fake " ++ String.join ", " ours) acc.differ

                                Nothing ->
                                    acc.differ
                        }
                    )
                    { w = { made | rules = tmux.version }, differ = [] }
                    noticeSteps
                    |> .differ
            )


-- THE EXPLORER


{-| A point in a conversation: puritty's state, tmux's world, the lines
puritty has sent that tmux has not run, what tmux has written that
puritty has not read (a string each step), the world's events and the
user's actions not yet happened, and the steps so far. `read` is a digest
of everything puritty has been given, for telling states apart. -}
type alias Node =
    { tmux : TmuxMode.State
    , world : World
    , inbox : Array String
    , outbox : Array { text : String, told : Array FakeTmux.Told }
    , events : Array Event
    , actions : Array Action
    , steps : Array String
    , read : Int
    }


{-| Something in tmux's world, which tmux tells the client of. -}
type alias Event =
    { name : String, happen : World -> { world : World, notices : Array String } }


{-| Something the user does: puritty's state changed and the lines it
sends. -}
type alias Action =
    { name : String, act : TmuxMode.State -> { state : TmuxMode.State, commands : Array String } }


type alias Scenario =
    { name : String
    , world : World
    , events : Array Event
    , actions : Array Action
    -- attached and every answer read before the exploring starts
    , settled : Bool
    }


{-| A step: tmux runs the next line, puritty reads the next thing tmux
wrote, the `n`th event left happens, or the user does the `n`th action
left. -}
type Choice
    = Run
    | Read
    | Happen Int
    | Do Int


size : World -> { cols : Int, rows : Int }
size w =
    { cols = w.cols, rows = w.rows + 1 }


digest : Int -> String -> Int
digest seed text =
    String.foldl (\c h -> modBy 2147483647 (h * 131 + Char.toCode c)) seed text


{-| puritty reads `bytes`: its state, and the lines it sends queued for
tmux; and whether it read a reply of its own commands while waiting for
nothing, which its log says (`for nothing waited for`, docs/diagnostics.md). -}
readsAll : String -> (taken node : Node) -> { node : Node, unawaited : Bool }
readsAll text node =
    let
        r =
            TmuxMode.read (size node.world) (Bytes.fromString text) node.tmux
    in
    { node = { node | tmux = r.state, inbox = node.inbox ++ r.commands, read = digest node.read text }
    , unawaited = Array.any (String.contains "for nothing waited for") r.trace
    }


reads : String -> (taken node : Node) -> Node
reads text node =
    (readsAll text node).node


{-| tmux runs the next line. -}
runs : (taken node : Node) -> Node
runs node =
    when Array.popFirst node.inbox is
        Just { first, rest } ->
            let
                answered =
                    FakeTmux.answer first node.world

                text =
                    Bytes.toStringLossy answered.bytes
            in
            { node
                | world = answered.world
                , inbox = rest
                , outbox =
                    if text == "" then
                        node.outbox

                    else
                        Array.pushLast { text = text, told = answered.told } node.outbox
                , steps = Array.pushLast ("tmux runs: " ++ first) node.steps
            }

        Nothing ->
            node


without : Int -> Array a -> Array a
without i array =
    Array.takeFirst i array ++ Array.dropFirst (i + 1) array


{-| A choice made, and what it broke, if anything: puritty read a block of
its own commands' while it waited for nothing, or what the user did sent
commands puritty does not wait for a reply each from. -}
apply : Choice -> (taken node : Node) -> { node : Node, broken : Maybe String }
apply choice node =
    when choice is
        Run ->
            { node = runs node, broken = Nothing }

        Read ->
            when Array.popFirst node.outbox is
                Just { first, rest } ->
                    let
                        line =
                            "puritty reads: " ++ String.join " | " (String.split "\u{000D}\n" first.text |> Array.keepIf (\l -> l /= "") |> Array.takeFirst 3)

                        before =
                            node.tmux.expecting

                        r =
                            readsAll first.text { node | outbox = rest, steps = Array.pushLast line node.steps }
                    in
                    { node = r.node
                    , broken =
                        if r.unawaited then
                            Just "puritty read a reply to its own command while it waited for nothing"

                        else
                            orElse (lacked r.node.world (Array.dropFirst (Array.length node.inbox) r.node.inbox))
                                (heldTo first.told before r.node.tmux.expecting)
                    }

                Nothing ->
                    { node = node, broken = Nothing }

        Happen i ->
            when Array.get i node.events is
                Just e ->
                    let
                        done =
                            e.happen node.world
                    in
                    { node =
                        { node
                            | world = done.world
                            , outbox = Array.pushLast { text = String.join "" (Array.map (\n -> n ++ "\u{000D}\n") done.notices), told = [] } node.outbox
                            , events = without i node.events
                            , steps = Array.pushLast e.name node.steps
                        }
                    , broken = Nothing
                    }

                Nothing ->
                    { node = node, broken = Nothing }

        Do i ->
            when Array.get i node.actions is
                Just a ->
                    let
                        before =
                            Array.length node.tmux.expecting

                        done =
                            a.act node.tmux

                        waited =
                            Array.length done.state.expecting - before

                        commands =
                            Array.foldl (\line n -> n + Array.length (Syntax.commands (Syntax.tokens line))) 0 done.commands
                    in
                    { node =
                        { node
                            | tmux = done.state
                            , inbox = node.inbox ++ done.commands
                            , actions = without i node.actions
                            , steps = Array.pushLast a.name node.steps
                            , read = digest node.read a.name
                        }
                    , broken =
                        if waited /= commands then
                            Just ("the user's action sent " ++ String.fromInt commands ++ " commands, and puritty waits for " ++ String.fromInt waited ++ " replies to them: " ++ String.join " / " done.commands)

                        else
                            lacked node.world done.commands
                    }

                Nothing ->
                    { node = node, broken = Nothing }


{-| A line sent that asks this tmux for what it does not have: `#{T:…}`
before 2.9, which it expands empty (docs/tmux-versions.md TV10), but for
the probe, `#{T:version}`, by which puritty learns it (TM72). -}
lacked : World -> Array String -> Maybe String
lacked w lines =
    if FakeTmux.tenths w.version < 29 then
        Array.findFirst (\line -> String.contains "#{T:" (String.replace "#{T:version}" "" line)) lines
            |> Maybe.map (\found -> "puritty asked tmux " ++ w.version ++ ", which has no #{T:…}, for " ++ found.value)

    else
        Nothing


orElse : Maybe a -> Maybe a -> Maybe a
orElse first second =
    when first is
        Just _ ->
            first

        Nothing ->
            second


{-| A command as tmux reads it: its words, quotes taken off, joined by
spaces, as the fake tells each block's. -}
words : String -> String
words command =
    Syntax.tokens command |> Array.map .value |> String.join " "


{-| A read's blocks held to what puritty waited for (TK10.5): each block
of its own commands must answer the question asked by the command that
made it, in turn; one that fails ends its line, whose other questions go
unanswered; the blocks of the commands a command ran come before its
fence's. And what puritty waits for after the read must begin with what
those blocks left. -}
heldTo : Array FakeTmux.Told -> Array TmuxMode.Asked -> Array TmuxMode.Asked -> Maybe String
heldTo told before after =
    let
        fence =
            words (Command.display "puritty-fence")

        step b acc =
            when acc.broken is
                Just _ ->
                    acc

                Nothing ->
                    when Array.first acc.queue is
                        Nothing ->
                            { acc | broken = Just ("tmux's reply to `" ++ b.command ++ "` came while puritty waited for nothing") }

                        Just head ->
                            if words head.command == fence && b.command /= fence then
                                -- what a command ran, before its fence
                                acc

                            else if words head.command /= b.command then
                                { acc | broken = Just ("tmux's reply to `" ++ b.command ++ "` was read as the answer to `" ++ head.command ++ "`") }

                            else
                                let
                                    rest =
                                        Array.dropFirst 1 acc.queue

                                    ended =
                                        if b.ok then
                                            0

                                        else
                                            Array.findFirst (\a -> a.line /= head.line) rest |> Maybe.map .index |> Maybe.withDefault (Array.length rest)
                                in
                                { acc | queue = Array.dropFirst ended rest }

        held =
            Array.foldl step { queue = before, broken = Nothing } (Array.keepIf (\b -> b.flags == 1) told)

        same a b =
            a.command == b.command && a.line == b.line
    in
    when held.broken is
        Just why ->
            Just why

        Nothing ->
            if Array.length after >= Array.length held.queue && Array.all identity (Array.map2 same held.queue (Array.takeFirst (Array.length held.queue) after)) then
                Nothing

            else
                Just ("after the read puritty waits for " ++ String.join "; " (Array.map .command after) ++ ", where tmux's blocks left " ++ String.join "; " (Array.map .command held.queue))


{-| tmux's windows and the shown window's panes, as `TmuxMode.viewLine`
writes puritty's (TK11). -}
worldView : World -> String
worldView w =
    let
        windows =
            Array.pushFirst { id = w.window.id, index = w.window.index, name = w.window.name } (Array.map (\o -> { id = o.id, index = o.index, name = o.name }) w.others)
                |> Array.sortBy .index
    in
    "tabs "
        ++ String.join " " (Array.map (\o -> "@" ++ String.fromInt o.id ++ ":" ++ o.name) windows)
        ++ " | window @"
        ++ String.fromInt w.window.id
        ++ " | panes "
        ++ String.join " "
            (Array.map
                (\id ->
                    "%"
                        ++ String.fromInt id
                        ++ (if id == w.active then
                                "*"

                            else
                                ""
                           )
                )
                (Array.sort (Array.map .id w.panes))
            )


{-| Once no event or action is left, the rest is one way: tmux answers in
turn, and puritty reads in turn. Run to the end, and at the end puritty
must wait for nothing. -}
finish : Int -> (taken node : Node) -> { node : Node, broken : Maybe String }
finish budget node =
    if budget <= 0 then
        { node = node, broken = Nothing }

    else if not (Array.isEmpty node.outbox) then
        let
            r =
                apply Read node
        in
        when r.broken is
            Just _ ->
                r

            Nothing ->
                finish (budget - 1) r.node

    else if not (Array.isEmpty node.inbox) then
        finish (budget - 1) (runs node)

    else if not (Array.isEmpty node.tmux.expecting) then
        { node = node, broken = Just ("tmux owes nothing, and puritty waits for " ++ String.fromInt (Array.length node.tmux.expecting)) }

    else
        -- all said and read: what puritty shows must be tmux's (TK11)
        let
            -- the tabs, the window and its panes: the fake's sizes are its
            -- own, the harness holds the rest to real tmuxes (TK12)
            shows =
                TmuxMode.viewLine node.tmux |> String.split " | " |> Array.takeFirst 3 |> String.join " | "

            has =
                worldView node.world
        in
        if shows /= has then
            { node = node, broken = Just ("puritty shows " ++ shows ++ ", where tmux has " ++ has) }

        else
            -- and tmux's window the size puritty's window asks for, and
            -- the size puritty's layout says (TK10.10)
            let
                wanted =
                    TmuxMode.wantedSize node.tmux

                layoutSize =
                    TmuxMode.viewLine node.tmux |> String.split " | " |> Array.get 3 |> Maybe.withDefault ""

                tmuxSize =
                    String.fromInt node.world.cols ++ "x" ++ String.fromInt node.world.rows
            in
            if wanted.cols /= node.world.cols || wanted.rows /= node.world.rows then
                { node = node, broken = Just ("puritty's window asks for " ++ String.fromInt wanted.cols ++ "x" ++ String.fromInt wanted.rows ++ ", where tmux's window is " ++ tmuxSize) }

            else if not (String.contains tmuxSize layoutSize) then
                { node = node, broken = Just ("puritty's layout says " ++ layoutSize ++ ", where tmux's window is " ++ tmuxSize) }

            else
                { node = node, broken = Nothing }


begin : Scenario -> Node
begin s =
    let
        begun =
            reads (Bytes.toStringLossy FakeTmux.startBytes)
                { tmux = TmuxMode.idle {}
                , world = s.world
                , inbox = []
                , outbox = []
                , events = s.events
                , actions = s.actions
                , steps = []
                , read = 0
                }
    in
    if s.settled then
        (finish 400 begun).node

    else
        begun


{-| The choices made from the start: the node they lead to, or what broke
on the way, and when none is left to choose, the rest run to the end. -}
replay : Scenario -> Array Choice -> { node : Node, broken : Maybe String }
replay s choices =
    let
        went =
            Array.foldl
                (\c acc ->
                    when acc.broken is
                        Just _ ->
                            acc

                        Nothing ->
                            apply c acc.node
                )
                { node = begin s, broken = Nothing }
                choices
    in
    when went.broken is
        Just _ ->
            went

        Nothing ->
            if Array.isEmpty went.node.events && Array.isEmpty went.node.actions then
                finish 1000 went.node

            else
                went


{-| The choices open at a node, but for orders that cannot differ: with
no world event left, tmux running its next line commutes with puritty's
reading and the user's acting (it takes the head of the lines, which they
only add to), so it is taken at once; with no user action left, puritty's
reading the next thing tmux wrote commutes with tmux's running and the
world's events (it takes the head of what was written, which they only
add to), so it is taken at once (TK10.7). Every order left out reaches a
state one taken reaches. -}
open : Node -> Array Choice
open node =
    if Array.isEmpty node.events && not (Array.isEmpty node.inbox) then
        [ Run ]

    else if Array.isEmpty node.actions && not (Array.isEmpty node.outbox) then
        [ Read ]

    else
        every node


every : Node -> Array Choice
every node =
    (if Array.isEmpty node.inbox then
        []

     else
        [ Run ]
    )
        ++ (if Array.isEmpty node.outbox then
                []

            else
                [ Read ]
           )
        ++ Array.indexedMap (\i _ -> Happen i) node.events
        ++ Array.indexedMap (\i _ -> Do i) node.actions


key : Node -> String
key node =
    String.fromInt node.read
        ++ "|"
        ++ String.join "\n" node.inbox
        ++ "|"
        ++ String.fromInt (digest 7 (String.join "" (Array.map .text node.outbox)))
        ++ "|"
        ++ String.join "," (Array.map .name node.events)
        ++ "|"
        ++ String.join "," (Array.map .name node.actions)


{-| The scenario explored breadth first, each node rebuilt by replaying
its choices (puritty's state is written in place, so it is not copied):
the first step that broke something, with the steps to it, and how many
states there were. -}
explore : Int -> Scenario -> { broken : Maybe { steps : Array String, what : String }, states : Int }
explore limit s =
    let
        level frontier seen count =
            if count > limit then
                -- not explored to the end: said, not passed
                { broken = Just { steps = [], what = "more than " ++ String.fromInt limit ++ " states; not explored to the end" }, states = count }

            else if Array.isEmpty frontier then
                { broken = Nothing, states = count }

            else
                let
                    stepped =
                        Array.foldl
                            (\entry acc ->
                                Array.foldl
                                    (\c a ->
                                        when a.broken is
                                            Just _ ->
                                                a

                                            Nothing ->
                                                let
                                                    choices =
                                                        Array.pushLast c entry.choices

                                                    r =
                                                        replay s choices
                                                in
                                                when r.broken is
                                                    Just what ->
                                                        { a | broken = Just { steps = r.node.steps, what = what } }

                                                    Nothing ->
                                                        let
                                                            k =
                                                                key r.node

                                                            choosable =
                                                                open r.node
                                                        in
                                                        if Dict.member k a.seen || Array.isEmpty r.node.events && Array.isEmpty r.node.actions then
                                                            { a | seen = Dict.set k {} a.seen }

                                                        else
                                                            { a | seen = Dict.set k {} a.seen, frontier = Array.pushLast { choices = choices, open = choosable } a.frontier }
                                    )
                                    acc
                                    entry.open
                            )
                            { broken = Nothing, seen = seen, frontier = [] }
                            frontier
                in
                when stepped.broken is
                    Just b ->
                        { broken = Just b, states = count }

                    Nothing ->
                        level stepped.frontier stepped.seen (count + Array.length stepped.frontier)

        first =
            replay s []
    in
    when first.broken is
        Just what ->
            { broken = Just { steps = first.node.steps, what = what }, states = 1 }

        Nothing ->
            level [ { choices = [], open = open first.node } ] Dict.empty 1


-- THE SCENARIOS


{-| The tmuxes whose rules for a line the scenarios run on (TK10): 2.7
(2.7 to 3.1c: a command at a pane or window not there fails, and what a
command runs is not this client's), 3.2 (3.2 to 3.7c) and 3.8
(notifications after each command's block). 3.0 differs from 2.7, and
3.4 from 3.2, only in a blank line and a `%message` in a block, which no
scenario sends; the fake's rules for all five are held to every dumped
tmux (`lineShapesDiffer`). -}
eras : Array String
eras =
    [ "2.7", "3.2", "3.8" ]


{-| The recorded tmux that answers as an era's (TM68, docs/tmux-versions.md
TV10): its own release, 3.2a for 3.2. -}
versionOf : String -> String
versionOf rules =
    if rules == "3.2" then
        "3.2a"

    else
        rules


{-| A window of two panes side by side, on the fake answering as the
era's own tmux (`versionOf`, whose questions and answers are recorded,
TM68) following `rules`' lines. -}
twoPanes : String -> World
twoPanes rules =
    twoPanesOn (versionOf rules) rules


{-| `twoPanes` answering as `version`, following `rules`' lines. -}
twoPanesOn : String -> String -> World
twoPanesOn version rules =
    let
        made =
            FakeTmux.world { version = version, cols = 80, rows = 24, lines = [ "line 1", "line 2" ] }

        first =
            Array.first made.panes |> Maybe.withDefault { id = 0, lines = [], rows = 24, mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 }
    in
    { made | rules = rules, panes = [ first, { first | id = 1 } ], number = 2 }


{-| `twoPanes`, and another window, `@1`, with one pane, `%2`. -}
twoWindows : String -> World
twoWindows rules =
    let
        w =
            twoPanes rules

        first =
            Array.first w.panes |> Maybe.withDefault { id = 0, lines = [], rows = 24, mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 }
    in
    { w | others = [ { id = 1, index = 1, name = "two", panes = [ { first | id = 2 } ], active = 2 } ], number = 3 }


windowCloses : Int -> Event
windowCloses id =
    { name = "window @" ++ String.fromInt id ++ " closes", happen = FakeTmux.closeWindow id }


windowAdded : Int -> Int -> Event
windowAdded id pane =
    { name = "another client opens window @" ++ String.fromInt id, happen = FakeTmux.addWindow id pane }


windowShown : Int -> Event
windowShown id =
    { name = "another client shows window @" ++ String.fromInt id, happen = FakeTmux.switchWindow id }


paneExits : Int -> Event
paneExits id =
    { name = "pane %" ++ String.fromInt id ++ "'s program exits", happen = FakeTmux.closePane id }


{-| A key with a letter on it typed; Ctrl with `mods` 2. -}
press : Int -> String -> (taken s : TmuxMode.State) -> { state : TmuxMode.State, commands : Array String }
press mods letter s =
    let
        code =
            String.toArray letter |> Array.first |> Maybe.map Char.toCode |> Maybe.withDefault 0

        text =
            if mods == 2 then
                Char.fromCode (code - 0x60) |> Maybe.map String.fromChar |> Maybe.withDefault ""

            else
                letter
    in
    TmuxMode.typed { action = 1, keycode = 0, mods = mods, consumed = 0, unshifted = code, sym = code, text = Bytes.fromString text } (Bytes.fromString text) 1000 s


{-| Keys typed one after another, what each sends gathered. -}
pressAll : Array { mods : Int, key : String } -> (taken s : TmuxMode.State) -> { state : TmuxMode.State, commands : Array String }
pressAll keys s =
    Array.foldl
        (\k acc ->
            let
                r =
                    if k.key == "Enter" then
                        TmuxMode.typed { action = 1, keycode = 0, mods = 0, consumed = 0, unshifted = 0xFF0D, sym = 0xFF0D, text = Bytes.fromString "\u{000D}" } (Bytes.fromString "\u{000D}") 1000 acc.state

                    else
                        press k.mods k.key acc.state
            in
            { state = r.state, commands = acc.commands ++ r.commands }
        )
        { state = s, commands = [] }
        keys


{-| A command typed at tmux's prompt, `prefix :`, and run with Enter. -}
promptRuns : String -> Action
promptRuns command =
    { name = "the user runs `" ++ command ++ "` at the prompt"
    , act =
        pressAll
            ([ { mods = 2, key = "b" }, { mods = 0, key = ":" } ]
                ++ (String.toArray command |> Array.map (\c -> { mods = 0, key = String.fromChar c }))
                ++ [ { mods = 0, key = "Enter" } ]
            )
    }


{-| A pointer event at a cell of puritty's window: `action` 0 a press, 1 a
release, 2 a move with the left button held. -}
pointerAt : Int -> Int -> Int -> { action : Int, button : Int, mods : Int, x : Int, y : Int, width : Int, height : Int, cellWidth : Int, cellHeight : Int }
pointerAt action col row =
    { action = action, button = 1, mods = 0, x = col * 10 + 5, y = row * 20 + 5, width = 800, height = 500, cellWidth = 10, cellHeight = 20 }


{-| A floating pane's box dragged by its left edge, two cells left, and let
go: a move and a resize on one line each step (TM20). -}
dragsLeftEdge : { x : Int, y : Int } -> Action
dragsLeftEdge box =
    let
        -- below the tab bar at the window's top
        row =
            box.y + 1 + 2
    in
    { name = "the user drags a floating pane's left edge"
    , act =
        \s ->
            { state = s, commands = [] }
                |> pointed 1 (pointerAt 0 (box.x - 1) row)
                |> pointed 1 (pointerAt 2 (box.x - 3) row)
                |> pointed 0 (pointerAt 1 (box.x - 3) row)
    }


{-| A pointer event given to puritty, the button `held` (1 the left), and
what it sends gathered. -}
pointed : Int -> { action : Int, button : Int, mods : Int, x : Int, y : Int, width : Int, height : Int, cellWidth : Int, cellHeight : Int } -> (taken acc : { state : TmuxMode.State, commands : Array String }) -> { state : TmuxMode.State, commands : Array String }
pointed held e acc =
    let
        r =
            TmuxMode.pointer { ms = 1000, held = held, select = False, boundaries = [], pasteButton = 2 } e acc.state
    in
    { state = r.state, commands = acc.commands ++ r.commands }


scenarios : String -> Array Scenario
scenarios rules =
    windowScenarios rules
        ++ keyScenarios rules
        ++ menuScenarios rules
        ++ pauseScenarios rules
        ++ pollScenarios rules
        ++ resizeScenarios rules
        ++ [ { name = "attaching to two panes, one of whose programs exits"
             , world = twoPanes rules
             , events = [ paneExits 1 ]
             , actions = []
             , settled = False
             }
           , { name = "a file sourced at the prompt"
             , world =
                let
                    w =
                        twoPanes rules
                in
                { w | files = Dict.singleton "/p.conf" "display-message -p one\ndisplay-message -p two\n" }
             , events = []
             , actions = [ promptRuns "source-file /p.conf" ]
             , settled = True
             }
           , { name = "an if-shell run at the prompt"
             , world = twoPanes rules
             , events = []
             , actions = [ promptRuns "if-shell true 'display-message -p yes'" ]
             , settled = True
             }
           ]
        ++ (if rules == "3.8" then
                -- floating panes are 3.7's, and puritty drags them on 3.8
                [ { name = "a floating pane dragged by its left edge"
                  , world =
                        let
                            w =
                                twoPanes rules
                        in
                        { w | floats = [ { id = 1, x = 10, y = 5, w = 30, h = 8 } ] }
                  , events = []
                  , actions = [ dragsLeftEdge { x = 10, y = 5 } ]
                  , settled = True
                  }
                ]

            else
                []
           )


{-| Windows coming and going (TK10.6). -}
windowScenarios : String -> Array Scenario
windowScenarios rules =
    [ { name = "attaching while the window shown closes"
      , world = twoWindows rules
      , events = [ windowCloses 0 ]
      , actions = []
      , settled = False
      }
    , { name = "another client opens, closes and shows windows"
      , world = twoWindows rules
      , events = [ windowAdded 2 3, windowCloses 1, windowShown 1 ]
      , actions = []
      , settled = True
      }
    ]


{-| `prefix` then a key, as the user types them. -}
prefixThen : String -> Action
prefixThen letter =
    { name = "the user types the prefix, then " ++ letter
    , act = pressAll [ { mods = 2, key = "b" }, { mods = 0, key = letter } ]
    }


{-| A key with a letter on it typed. -}
typesKey : String -> Action
typesKey letter =
    { name = "the user types " ++ letter, act = pressAll [ { mods = 0, key = letter } ] }


{-| A pane put in copy mode by tmux (`prefix [`, or another client). -}
copyEntered : Int -> Event
copyEntered id =
    { name = "pane %" ++ String.fromInt id ++ " goes into copy mode", happen = FakeTmux.enterCopy id }


{-| Keys typed while replies are pending (TK10.7). -}
keyScenarios : String -> Array Scenario
keyScenarios rules =
    [ { name = "the tree opened while attaching"
      , world = twoPanes rules
      , events = []
      , actions = [ prefixThen "w" ]
      , settled = False
      }
    , { name = "the window menu opened while attaching"
      , world = twoPanes rules
      , events = []
      , actions = [ prefixThen "<" ]
      , settled = False
      }
    , { name = "the tree opened as a pane exits"
      , world = twoPanes rules
      , events = [ paneExits 1 ]
      , actions = [ prefixThen "w" ]
      , settled = True
      }
    , { name = "copy mode's keys while its pane exits"
      , world = twoPanes rules
      , events = [ copyEntered 0, paneExits 0 ]
      , actions = [ typesKey "k", typesKey "k" ]
      , settled = True
      }
    ]


{-| Menus and popups as their pane exits (TK10.8): the pane menu
(`prefix >`) asks tmux to expand its title, names and commands at the
pane; an item's key may come before the menu is shown; a popup opened at
the prompt is five commands on one line (3.8; before it, puritty says
so and sends nothing). The pane is `%0`, the active one. -}
menuScenarios : String -> Array Scenario
menuScenarios rules =
    [ { name = "the pane menu opened as its pane exits"
      , world = twoPanes rules
      , events = [ paneExits 0 ]
      , actions = [ prefixThen ">" ]
      , settled = True
      }
    , { name = "the pane menu opened and an item's key typed before it is shown, as its pane exits"
      , world = twoPanes rules
      , events = [ paneExits 0 ]
      , actions =
            [ { name = "the user types the prefix, >, then m"
              , act = pressAll [ { mods = 2, key = "b" }, { mods = 0, key = ">" }, { mods = 0, key = "m" } ]
              }
            ]
      , settled = True
      }
    , { name = "a popup opened at the prompt as its pane exits"
      , world = twoPanes rules
      , events = [ paneExits 0 ]
      , actions = [ promptRuns "display-popup -E true" ]
      , settled = True
      }
    ]


{-| A pane paused (`%pause`, from 3.2: puritty asks `pause-after`) and
continued on one line with its state and captures, while it exits
(TK10.7). -}
pauseScenarios : String -> Array Scenario
pauseScenarios rules =
    if rules == "2.7" then
        []

    else
        [ { name = "a pane paused as it exits"
          , world = twoPanes rules
          , events = [ { name = "tmux pauses pane %1", happen = \w -> { world = w, notices = [ "%pause %1" ] } }, paneExits 1 ]
          , actions = []
          , settled = True
          }
        ]


{-| The status line's timer firing (TM72): before 3.2 puritty asks what
3.2's subscriptions would tell, once a second (`TmuxMode.tick`), a
question a subscription, those before 2.9 in two steps, each option's
text, then the format with it in place of `#{T:…}`. -}
timerFires : Action
timerFires =
    { name = "the status line's timer fires"
    , act =
        \s ->
            TmuxMode.tick
                (if s.pollAt >= 0 then
                    s.pollAt

                 else
                    s.clock
                )
                s
    }


{-| The poll's timer among the world's changes, before 3.2 only, on 2.7
(two steps) and 3.0 (`#{T:…}` asked at once), both on 2.7's rules for a
line (TK10.6: 3.0's differ only where no scenario goes). -}
pollScenarios : String -> Array Scenario
pollScenarios rules =
    if rules /= "2.7" then
        []

    else
        [ "2.7", "3.0" ]
            |> Array.mapAndFlatten
                (\version ->
                    [ { name = "the timer fires while attaching, on " ++ version ++ "'s answers"
                      , world = twoPanesOn version rules
                      , events = []
                      , actions = [ timerFires ]
                      , settled = False
                      }
                    , { name = "the timer fires as a pane exits, on " ++ version ++ "'s answers"
                      , world = twoPanesOn version rules
                      , events = [ paneExits 1 ]
                      , actions = [ timerFires ]
                      , settled = True
                      }
                    , { name = "the timer fires again before the first poll is answered, on " ++ version ++ "'s answers"
                      , world = twoPanesOn version rules
                      , events = []
                      , actions = [ timerFires, timerFires ]
                      , settled = True
                      }
                    , { name = "the timer fires as another client closes a window and opens one, on " ++ version ++ "'s answers"
                      , world =
                            let
                                w =
                                    twoPanesOn version rules

                                first =
                                    Array.first w.panes |> Maybe.withDefault { id = 0, lines = [], rows = 24, mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 }
                            in
                            { w | others = [ { id = 1, index = 1, name = "two", panes = [ { first | id = 2 } ], active = 2 } ], number = 3 }
                      , events = [ windowCloses 1, windowAdded 2 3 ]
                      , actions = [ timerFires ]
                      , settled = True
                      }
                    ]
                )


{-| The user makes puritty's window `cols` by `rows` cells of tmux's (one
row more for puritty's own, as `size` gives it): puritty tells tmux
(`refresh-client -C`), and tmux tells a new layout for every window. -}
resizes : Int -> Int -> Action
resizes cols rows =
    { name = "the user makes puritty's window " ++ String.fromInt cols ++ "x" ++ String.fromInt rows
    , act = TmuxMode.resized { cols = cols, rows = rows + 1 }
    }


{-| Resizes (TK10.10): while attaching, to the session's first window and
to its second (whose layout comes after the first's); as a pane exits;
twice before tmux answers; and as another client shows another window. -}
resizeScenarios : String -> Array Scenario
resizeScenarios rules =
    [ { name = "puritty's window resized while attaching"
      , world = twoPanes rules
      , events = []
      , actions = [ resizes 90 20 ]
      , settled = False
      }
    , { name = "puritty's window resized while attaching to the session's second window"
      , world = (FakeTmux.switchWindow 1 (twoWindows rules)).world
      , events = []
      , actions = [ resizes 90 20 ]
      , settled = False
      }
    , { name = "puritty's window resized as a pane exits"
      , world = twoPanes rules
      , events = [ paneExits 1 ]
      , actions = [ resizes 90 20 ]
      , settled = True
      }
    , { name = "puritty's window resized twice before tmux answers"
      , world = twoPanes rules
      , events = []
      , actions = [ resizes 90 20, resizes 100 30 ]
      , settled = True
      }
    , { name = "puritty's window resized as another client shows another window"
      , world = twoWindows rules
      , events = [ windowShown 1 ]
      , actions = [ resizes 90 20 ]
      , settled = True
      }
    ]


{-| Each scenario on each era's rules that broke something: what, and the
steps to it. -}
violations : Array String
violations =
    eras
        |> Array.mapAndFlatten
            (\rules ->
                scenarios rules
                    |> Array.mapAndKeepJust
                        (\s ->
                            (explore 5000 s).broken
                                |> Maybe.map (\b -> rules ++ ", " ++ s.name ++ ": " ++ b.what ++ ", after:\n    " ++ String.join "\n    " b.steps)
                        )
            )


explorer : U.Suite
explorer =
    U.suite
        { name = "Explorer"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            Array.map (\c -> U.test c.name (\_ -> Task.succeed (c.test {})))
                [ { name = "the fake answers a line of several commands as every dumped tmux does (TK10)"
                  , test = \_ -> Expect.equal [] lineShapesDiffer
                  }
                , { name = "the fake tells windows' changes as every dumped tmux does (TK11)"
                  , test = \_ -> Expect.equal [] noticesDiffer
                  }
                , { name = "puritty's questions and tmux's answers stay in step, in every order, on every tmux's rules (TK4)"
                  , test = \_ -> Expect.equal [] violations
                  }
                ]
        }
