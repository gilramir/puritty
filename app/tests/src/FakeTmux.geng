module FakeTmux exposing
    ( Pane
    , Told
    , World
    , addWindow
    , answer
    , closePane
    , closeWindow
    , copyState
    , enterCopy
    , known
    , renameWindow
    , startBytes
    , switchWindow
    , tenths
    , world
    )

{-| A tmux server as puritty's control mode sees it, for `TmuxMode`'s tests
(`docs/tmux.md` TM68): one session (`$0`, `main`) with one window (`@0`)
and its panes, numbered from `%0` as a new server numbers them, each with its lines (history and screen) and, in copy
mode, where the view and the cursor are. It answers the command lines
`TmuxMode` sends as tmux 3.8 or 3.6a does (`version`), a `%begin`/`%end` block a command,
expanding the `#{…}` formats it is asked for from that model, and acts on
the commands that change it (`send-keys` in copy mode, `copy-mode`). A
command it does not know is answered with nothing and kept in `unknown`,
so that a test can see what it was not ready for.

How a line of several commands is answered is the tmux whose rules the
world follows (`rules`, its version), as measured on every dumped tmux
(`corpus/tmux/*/lines.txt`, docs/tmux-checks.md TK10): a line that does
not parse, one `%error`; otherwise a block a command, in turn, the first
that fails ending the line; what the commands made tmux tell the client
after the line's last block, or from 3.8 after each command's; and the
commands `if-shell` and `source-file` run, a block each, this client's
from 3.2 (flags 1) and not before (0).

It is a model, so it can be wrong where tmux is not; `known` lists what it
answers, and each answer is checked against a real tmux's (TM68), and its
lines' shapes against every dumped tmux's (TK10).
-}

import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import RealTmux
import Tmux.Syntax as Syntax


{-| A pane: its id (`%id`), its lines, oldest first, the last `rows` of
them its screen; its mode as `#{pane_mode}` says it (`""` or `copy-mode`,
whose keys are copy-mode-vi's here); and in copy mode how
many lines back from the bottom the view is and the cursor in the pane. -}
type alias Pane =
    { id : Int
    , lines : Array String
    , rows : Int
    , mode : String
    , scroll : Int
    , cx : Int
    , cy : Int
    , wanted : Int
    }


{-| The server: the tmux it is (`"3.8"` or `"3.6a"`), the window's size,
its panes side by side, the active one, the reply count, what was asked
that it does not know, the subscriptions, every command answered, in
order, and every command line as it was sent (`heard`), which a test
holds against the recorded questions (TM69). -}
type alias World =
    { version : String
    , cols : Int
    , rows : Int
    , panes : Array Pane
    , active : Int
    , number : Int
    , unknown : Array String
    , subscriptions : Array { name : String, scope : String, format : String }
    , answered : Array String
    , heard : Array String
    , options : Dict String String
    -- variables this tmux answers empty, as an older one does: one it
    -- does not have (docs/tmux-checks.md TK8)
    , lacking : Array String
    -- the tmux whose rules a line of several commands is answered by
    -- (TK10), and the files `source-file` reads
    , rules : String
    , files : Dict String String
    -- panes that float (3.7), each with its box, drawn over the tiled ones
    -- in the layout (`"z"`), the first the bottom one
    , floats : Array { id : Int, x : Int, y : Int, w : Int, h : Int }
    -- the window shown, whose panes are `panes`; and the session's others,
    -- each with its own (TK10.6)
    , window : { id : Int, index : Int, name : String }
    , others : Array Other
    -- whether the client asked for 3.8's layouts (`refresh-client -f
    -- new-layouts`), which `%layout-change` then carries too
    , newLayouts : Bool
    -- the paste buffers, newest first (`show-buffer`, TM80)
    , buffers : Array String
    -- each prompt type's history, oldest first (`show-prompt-history`,
    -- 3.3, TM89)
    , promptHistory : Dict String (Array String)
    }


{-| A window of the session not shown, with its panes and its active one. -}
type alias Other =
    { id : Int, index : Int, name : String, panes : Array Pane, active : Int }


{-| A window of `cols` by `rows` with one pane, `%0`, showing `lines`, the
cursor after the last of them, as a program that printed them and no last
newline leaves it, on tmux `version`. -}
world : { version : String, cols : Int, rows : Int, lines : Array String } -> World
world w =
    { version = w.version
    , cols = w.cols
    , rows = w.rows
    , panes = [ { id = 0, lines = w.lines, rows = w.rows, mode = "", scroll = 0, cx = 0, cy = w.rows - 1, wanted = 0 } ]
    , active = 0
    , number = 1
    , unknown = []
    , subscriptions = []
    , answered = []
    , heard = []
    , options = Dict.empty
    , lacking = lackingOf w.version
    , rules = w.version
    , files = Dict.empty
    , floats = []
    , window = { id = 0, index = 0, name = "sh" }
    , others = []
    , newLayouts = False
    , buffers = []
    , promptHistory = Dict.empty
    }


{-| The variables and options of the newest recorded tmux that `version`
lacks (`RealTmux.lacking`, from the dumps, docs/tmux-checks.md TK8), which
it answers empty. -}
lackingOf : String -> Array String
lackingOf version =
    RealTmux.lacking
        |> Array.findFirst (\l -> l.version == version)
        |> Maybe.map (\found -> found.value.names)
        |> Maybe.withDefault []


{-| What `tmux -CC attach` writes first: control mode begun, and the
attach command's own empty reply. -}
startBytes : Bytes
startBytes =
    Bytes.fromString ("\u{001B}P1000p" ++ "%begin 1700000000 0 0\u{000D}\n%end 1700000000 0 0\u{000D}\n")


{-| The commands tmux answers here, by name. -}
known : Array String
known =
    [ "display-message", "list-windows", "list-panes", "list-sessions", "list-keys", "list-commands", "capture-pane", "refresh-client", "send-keys", "copy-mode", "switch-client", "select-pane", "set-option", "show-buffer", "list-buffers", "show-prompt-history" ]


{-| A block tmux wrote: the command it answers (its words as tmux read
them, joined by spaces), its flags, and whether it is an `%end`. -}
type alias Told =
    { command : String, flags : Int, ok : Bool }


{-| A command line answered as the world's `rules` say (TK10): its
commands' blocks and what they made tmux tell the client
(`%pane-mode-changed`, subscriptions), and each block's command, for a
test to hold puritty's questions to (`told`). A line refused whole is
told as its first command's failing. -}
answer : String -> World -> { world : World, bytes : Bytes, told : Array Told }
answer line w0 =
    let
        r =
            rulesOf w0.rules

        heard =
            { w0 | heard = Array.pushLast line w0.heard }

        commands =
            Syntax.commands (Syntax.tokens line) |> Array.map (Array.map .value)

        refusal =
            if Array.isEmpty commands then
                Just "parse error: syntax error"

            else if r.quoteFails && unclosed line then
                Just ("parse error: invalid or unknown command: " ++ line)

            else
                Array.mapAndKeepJust (refused heard) commands |> Array.first
    in
    if String.trim line == "" then
        -- 2.x reads a blank line as a command and refuses it; 3.0 skips it
        if r.blankFails then
            { world = { heard | number = heard.number + 1 }, bytes = Bytes.fromString (block heard.number 1 False [ "parse error: (null)" ]), told = [ { command = "", flags = 1, ok = False } ] }

        else
            { world = heard, bytes = Bytes.empty, told = [] }

    else
        when refusal is
            Just why ->
                -- refused whole, before any of it runs
                { world = { heard | number = heard.number + 1 }
                , bytes = Bytes.fromString (block heard.number 1 False [ why ])
                , told = [ { command = Array.first commands |> Maybe.map (String.join " ") |> Maybe.withDefault "", flags = 1, ok = False } ]
                }

            Nothing ->
                let
                    done =
                        runAll r 1 commands { w = heard, text = "", notices = [], later = [], told = [] }

                    -- `if-shell -b`'s commands, run when its shell is done,
                    -- after the line: not this client's (measured, every tmux)
                    afterwards =
                        runAll r 0 done.later { w = done.w, text = "", notices = [], later = [], told = [] }
                in
                { world = afterwards.w
                , bytes = Bytes.fromString (done.text ++ noticed done.notices ++ afterwards.text ++ noticed afterwards.notices)
                , told = done.told ++ afterwards.told
                }


{-| Notifications as tmux writes them, a line each. -}
noticed : Array String -> String
noticed notices =
    String.join "" (Array.map (\n -> n ++ "\u{000D}\n") notices)


{-| How a tmux answers a line, by its version (`corpus/tmux/*/lines.txt`,
TK10): the commands `if-shell` and `source-file` run answered as this
client's (3.2); notifications after each command's block, not the line's
last (3.8); `display-message -t` a pane that is not there refused (before
3.2; from it, the current pane shown); `display-message` without `-p` a
`%message` in its block (3.4; before, nothing); a blank line refused
(before 3.0); a quote left open refused (before 3.2); a window of the
session closing said `%unlinked-window-close`, as another session's is
(before 3.8; `%window-close` from it); a new window's pane said active
before the window is (before 3.0). Measured, `corpus/tmux/*/notices.txt`
(TK11). And how it answers what a line asks, measured on each release
(docs/tmux-versions.md TV10): a condition naming a variable or option it
does not have taken as true (2.7; from 2.8 as empty, false);
`capture-pane -J` writing a line's cleared cells, as many as tmux gave
the line, a quarter, half or all of the width (before 3.3); `capture-pane
-a` with no alternate screen nothing (before 3.2; from it one empty
line); copy mode's cursor held to a line's last character as it moves
(3.7); the layout as JSON (3.8; before, tmux's layout string). -}
type alias Rules =
    { nestedOwn : Bool
    , noticesEach : Bool
    , missingDisplayFails : Bool
    , messageInBlock : Bool
    , blankFails : Bool
    , quoteFails : Bool
    , closeUnlinked : Bool
    , newWindowPane : Bool
    , unknownTrue : Bool
    , padsCells : Bool
    , emptyAlternate : Bool
    , clamps : Bool
    , jsonLayout : Bool
    }


rulesOf : String -> Rules
rulesOf version =
    let
        t =
            tenths version
    in
    { nestedOwn = t >= 32
    , noticesEach = t >= 38
    , missingDisplayFails = t < 32
    , messageInBlock = t >= 34
    , blankFails = t < 30
    , quoteFails = t < 32
    , closeUnlinked = t < 38
    , newWindowPane = t < 30
    , unknownTrue = t < 28
    , padsCells = t < 33
    , emptyAlternate = t >= 32
    , clamps = t >= 37
    , jsonLayout = t >= 38
    }


{-| A version in tenths: `3.6a` 36, `2.9a` 29, `next-3.4` 34. -}
tenths : String -> Int
tenths version =
    let
        digits =
            String.replace "next-" "" version |> String.split "."

        part i =
            Array.get i digits |> Maybe.andThen (\d -> String.toInt (String.keepIf Char.isDigit d)) |> Maybe.withDefault 0
    in
    part 0 * 10 + part 1


type alias Answering =
    { w : World, text : String, notices : Array String, later : Array (Array String), told : Array Told }


{-| Commands run in turn, a block each with `flags`, until one fails;
the commands a command runs (`if-shell`, `source-file`) after its block,
as a group of their own. -}
runAll : Rules -> Int -> Array (Array String) -> Answering -> Answering
runAll r flags commands start =
    let
        done =
            Array.foldl
                (\words acc ->
                    if acc.stopped then
                        acc

                    else
                        let
                            ran =
                                runOne r words acc.w

                            numbered =
                                { ran.w | number = ran.w.number + 1, answered = Array.pushLast (String.join " " words) ran.w.answered }

                            own =
                                block acc.w.number flags ran.ok ran.lines

                            inner =
                                runAll r
                                    (if r.nestedOwn then
                                        1

                                     else
                                        0
                                    )
                                    ran.nested
                                    { w = numbered, text = "", notices = [], later = [], told = [] }

                            told =
                                acc.told ++ [ { command = String.join " " words, flags = flags, ok = ran.ok } ] ++ inner.told

                            notices =
                                ran.notices ++ inner.notices
                        in
                        if r.noticesEach then
                            { acc | w = inner.w, text = acc.text ++ own ++ inner.text ++ noticed notices, later = acc.later ++ ran.later ++ inner.later, told = told, stopped = not ran.ok }

                        else
                            { acc | w = inner.w, text = acc.text ++ own ++ inner.text, notices = acc.notices ++ notices, later = acc.later ++ ran.later ++ inner.later, told = told, stopped = not ran.ok }
                )
                { w = start.w, text = start.text, notices = start.notices, later = start.later, told = start.told, stopped = False }
                commands
    in
    { w = done.w, text = done.text, notices = done.notices, later = done.later, told = done.told }


{-| Why tmux refuses a command before running its line: a name it does not
have, or a flag its usage does not list. A tmux without a recorded table
refuses nothing. -}
refused : World -> Array String -> Maybe String
refused w words =
    let
        table =
            tableOf w.version

        name =
            Maybe.withDefault "" (Array.first words)
    in
    if Array.isEmpty table then
        Nothing

    else
        when Array.findFirst (\c -> c.name == name || c.alias == name) table is
            Nothing ->
                Just ("parse error: unknown command: " ++ name)

            Just found ->
                let
                    args =
                        parsed (Array.dropFirst 1 words)

                    allowed =
                        flagsOf found.value.usage

                    used =
                        String.toArray args.bools ++ Array.mapAndKeepJust (\k -> String.toArray k |> Array.first) (Dict.keys args.values)
                in
                when Array.findFirst (\c -> not (Array.member c allowed)) used is
                    Just bad ->
                        Just ("parse error: command " ++ found.value.name ++ ": unknown flag -" ++ String.fromChar bad.value)

                    Nothing ->
                        Nothing


{-| The flag letters a usage line lists: `[-aCI]` and `[-t target]`. -}
flagsOf : String -> Array Char
flagsOf usage =
    String.split "[-" usage
        |> Array.dropFirst 1
        |> Array.mapAndFlatten
            (\piece ->
                let
                    head =
                        String.split "]" piece |> Array.first |> Maybe.withDefault ""
                in
                if String.contains " " head then
                    String.toArray head |> Array.takeFirst 1

                else
                    String.toArray head
            )


{-| One command as a line's rules run it: a target pane that is not there
refused (but `display-message`'s from 3.2), `if-shell` and `source-file`
handing back the commands they run, the rest by `one`. -}
runOne : Rules -> Array String -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String, nested : Array (Array String), later : Array (Array String) }
runOne r words w =
    let
        name =
            Maybe.withDefault "" (Array.first words)

        args =
            parsed (Array.dropFirst 1 words)

        display =
            name == "display-message" || name == "display"

        missing =
            when Dict.get "t" args.values is
                Just t ->
                    String.startsWith "%" t
                        && (when String.toInt (String.dropFirst 1 t) is
                                Just id ->
                                    not (Array.any (\p -> p.id == id) (allPanes w))

                                Nothing ->
                                    False
                           )

                Nothing ->
                    False

        failed why =
            { w = w, ok = False, lines = [ why ], notices = [], nested = [], later = [] }

        commandsOf text =
            Syntax.commands (Syntax.tokens text) |> Array.map (Array.map .value)
    in
    if missing && (r.missingDisplayFails || not display) then
        failed ("can't find pane: " ++ Maybe.withDefault "" (Dict.get "t" args.values))

    else if name == "if-shell" || name == "if" then
        let
            -- if-shell's own flags: `-b` and `-F` alone, `-t` a pane
            own =
                ifArgs (Array.dropFirst 1 words)

            condition =
                Maybe.withDefault "" (Array.get 0 own.rest)

            yes =
                if String.contains "F" own.bools then
                    let
                        v =
                            expand (vars w (paneOf own.target w)) condition
                    in
                    v /= "" && v /= "0"

                else
                    -- the shell's command: `false` fails, anything else here
                    -- succeeds
                    String.trim condition /= "false"

            chosen =
                Array.get
                    (if yes then
                        1

                     else
                        2
                    )
                    own.rest
                    |> Maybe.map commandsOf
                    |> Maybe.withDefault []
        in
        if String.contains "b" own.bools then
            { w = w, ok = True, lines = [], notices = [], nested = [], later = chosen }

        else
            { w = w, ok = True, lines = [], notices = [], nested = chosen, later = [] }

    else if name == "source-file" || name == "source" then
        let
            path =
                Maybe.withDefault "" (Array.first args.rest)
        in
        when Dict.get path w.files is
            Just text ->
                { w = w
                , ok = True
                , lines = []
                , notices = []
                , nested = String.split "\n" text |> Array.mapAndFlatten commandsOf
                , later = []
                }

            Nothing ->
                failed (path ++ ": No such file or directory")

    else
        let
            o =
                one words w
        in
        { w = o.w, ok = o.ok, lines = o.lines, notices = o.notices, nested = [], later = [] }


{-| `if-shell`'s words: its flags (`-bF`), its pane (`-t`), and the
condition and commands. -}
ifArgs : Array String -> { bools : String, target : Maybe String, rest : Array String }
ifArgs words =
    when Array.popFirst words is
        Just { first, rest } ->
            if first == "-t" then
                let
                    after =
                        ifArgs (Array.dropFirst 1 rest)
                in
                { after | target = Array.first rest }

            else if String.startsWith "-" first && String.count first > 1 then
                let
                    after =
                        ifArgs rest
                in
                { after | bools = String.dropFirst 1 first ++ after.bools }

            else
                { bools = "", target = Nothing, rest = words }

        Nothing ->
            { bools = "", target = Nothing, rest = [] }


{-| Whether a line leaves a quote open: tmux before 3.2 refuses it, and
from 3.2 takes the rest of the line as the quoted word (measured, TK10). -}
unclosed : String -> Bool
unclosed line =
    String.foldl
        (\c st ->
            if st.escaped then
                { st | escaped = False }

            else if st.quote == ' ' then
                if c == '\'' || c == '"' then
                    { st | quote = c }

                else if c == '\\' then
                    { st | escaped = True }

                else
                    st

            else if c == st.quote then
                { st | quote = ' ' }

            else if c == '\\' && st.quote == '"' then
                { st | escaped = True }

            else
                st
        )
        { quote = ' ', escaped = False }
        line
        |> (\st -> st.quote /= ' ')


block : Int -> Int -> Bool -> Array String -> String
block number flags ok lines =
    let
        tail =
            (if ok then
                "%end "

             else
                "%error "
            )
                ++ "1700000000 "
                ++ String.fromInt number
                ++ " "
                ++ String.fromInt flags
                ++ "\u{000D}\n"
    in
    "%begin 1700000000 " ++ String.fromInt number ++ " " ++ String.fromInt flags ++ "\u{000D}\n" ++ String.join "" (Array.map (\l -> l ++ "\u{000D}\n") lines) ++ tail


{-| One command: its reply's lines, whether it succeeded, the world after it
and what tmux tells the client because of it. -}
one : Array String -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String }
one words w =
    let
        name =
            Maybe.withDefault "" (Array.first words)

        args =
            parsed (Array.dropFirst 1 words)

        target =
            paneOf (Dict.get "t" args.values) w

        format =
            Maybe.withDefault "" (Dict.get "F" args.values)

        reply lines =
            { w = w, ok = True, lines = lines, notices = [] }
    in
    when name is
        "display-message" ->
            reply (displayed w target args)

        "display" ->
            reply (displayed w target args)

        "list-windows" ->
            -- the session's windows, by index
            reply
                (windowsOf w
                    |> Array.sortBy .index
                    |> Array.map
                        (\o ->
                            expand
                                (\v ->
                                    -- `?pane_format` too: a condition's name
                                    if v == "pane_format" || v == "?pane_format" then
                                        "0"

                                    else
                                        vars (viewed o w) (activePane (viewed o w)) v
                                )
                                format
                        )
                )

        "list-panes" ->
            if String.contains "s" args.bools then
                -- every window's panes
                reply (windowsOf w |> Array.mapAndFlatten (\o -> Array.map (\p -> expand (vars (viewed o w) p) format) o.panes))

            else
                reply (Array.map (\p -> expand (vars w p) format) w.panes)

        "list-sessions" ->
            reply [ expand (vars w (activePane w)) format ]

        "list-keys" ->
            reply
                (if Dict.member "F" args.values || String.contains "N" args.bools then
                    []

                 else
                    bindingsOf w.version
                )

        "list-commands" ->
            if Dict.member "F" args.values then
                reply (Array.map (\c -> expand (commandVars c (vars w target)) format) (tableOf w.version))

            else
                -- the usage lines, as recorded (TM72)
                reply (Array.map .usage (tableOf w.version))

        "capture-pane" ->
            reply (captured w args target)

        "refresh-client" ->
            when Dict.get "B" args.values is
                Just sub ->
                    subscribe sub w

                Nothing ->
                    when Dict.get "C" args.values |> Maybe.andThen sizeOf is
                        Just size ->
                            resizedTo size w

                        Nothing ->
                            if Maybe.withDefault "" (Dict.get "f" args.values) |> String.contains "new-layouts" then
                                { w = { w | newLayouts = True }, ok = True, lines = [], notices = [] }

                            else
                                reply []

        "send-keys" ->
            sendKeys args target w

        "show-buffer" ->
            -- the buffer `-b` names, or the newest, its text a line each;
            -- refused when there is none ("no buffers", "no buffer NAME")
            when
                (when Dict.get "b" args.values is
                    Just wanted ->
                        Array.findFirst (\b -> b.name == wanted) (buffersOf w) |> Maybe.map (\found -> found.value.text)

                    Nothing ->
                        Array.first w.buffers
                )
            is
                Just text ->
                    reply (String.split "\n" text)

                Nothing ->
                    { w = w, ok = False, lines = [ "no buffers" ], notices = [] }

        "show-prompt-history" ->
            -- as `cmd_show_prompt_history_exec` prints one type's (TM89)
            let
                kind =
                    Maybe.withDefault "command" (Dict.get "T" args.values)
            in
            if not (Array.any (\c -> c.name == "show-prompt-history") (tableOf w.version)) then
                -- before 3.3, as tmux refuses a command it has not
                { w = w, ok = False, lines = [ "parse error: unknown command: show-prompt-history" ], notices = [] }

            else
                reply
                    ([ "History for " ++ kind ++ ":", "" ]
                        ++ Array.indexedMap (\i line -> String.fromInt (i + 1) ++ ": " ++ line) (Maybe.withDefault [] (Dict.get kind w.promptHistory))
                        ++ [ "" ]
                    )

        "list-buffers" ->
            -- newest first, each expanded with its own variables
            reply (Array.map (\b -> expand (bufferVars b (vars w (activePane w))) format) (buffersOf w))

        "copy-mode" ->
            let
                next =
                    enterCopy target.id w
            in
            { w = next.world, ok = True, lines = [], notices = next.notices }

        "switch-client" ->
            reply []

        "set-option" ->
            -- a user option (`@name`), kept for formats to read
            when args.rest is
                [ option, value ] ->
                    { w = { w | options = Dict.set option value w.options }, ok = True, lines = [], notices = [] }

                [ option ] ->
                    { w = { w | options = Dict.set option "" w.options }, ok = True, lines = [], notices = [] }

                _ ->
                    reply []

        "select-pane" ->
            reply []

        _ ->
            { w = { w | unknown = Array.pushLast (String.join " " words) w.unknown }, ok = True, lines = [], notices = [] }


{-| A command's words: its flags without values (`-p` as `p`), the ones
with (`-t %1`), and the rest. -}
parsed : Array String -> { bools : String, values : Dict String String, rest : Array String }
parsed words =
    let
        takesValue c =
            String.contains c "tFBCcfTSEbx"

        step acc =
            when Array.get acc.at words is
                Nothing ->
                    acc

                Just word ->
                    if acc.restOnly || not (String.startsWith "-" word) || word == "-" then
                        step { acc | at = acc.at + 1, rest = Array.pushLast word acc.rest, restOnly = True }

                    else if word == "--" then
                        step { acc | at = acc.at + 1, restOnly = True }

                    else
                        let
                            letters =
                                String.dropFirst 1 word

                            last =
                                String.takeLast 1 letters
                        in
                        if takesValue last then
                            step
                                { acc
                                    | at = acc.at + 2
                                    , bools = acc.bools ++ String.dropLast 1 letters
                                    , values = Dict.set last (Maybe.withDefault "" (Array.get (acc.at + 1) words)) acc.values
                                }

                        else
                            step { acc | at = acc.at + 1, bools = acc.bools ++ letters }

        done =
            step { at = 0, bools = "", values = Dict.empty, rest = [], restOnly = False }
    in
    { bools = done.bools, values = done.values, rest = done.rest }


{-| The session's windows, the shown one first. -}
windowsOf : World -> Array Other
windowsOf w =
    Array.pushFirst { id = w.window.id, index = w.window.index, name = w.window.name, panes = w.panes, active = w.active } w.others


{-| The world as it would be with `o` shown, for its variables. -}
viewed : Other -> World -> World
viewed o w =
    { w | window = { id = o.id, index = o.index, name = o.name }, panes = o.panes, active = o.active, others = [] }


allPanes : World -> Array Pane
allPanes w =
    Array.mapAndFlatten .panes (windowsOf w)


{-| Another client shows window `id` (`select-window`): it is the shown
one, and tmux says so (`%session-window-changed`). Nothing for a window the
session has not. -}
switchWindow : Int -> World -> { world : World, notices : Array String }
switchWindow id w =
    when Array.findFirst (\o -> o.id == id) w.others is
        Just found ->
            let
                o =
                    found.value

                was =
                    { id = w.window.id, index = w.window.index, name = w.window.name, panes = w.panes, active = w.active }
            in
            { world = { w | window = { id = o.id, index = o.index, name = o.name }, panes = o.panes, active = o.active, others = Array.pushLast was (Array.keepIf (\x -> x.id /= id) w.others) }
            , notices = [ "%session-window-changed $0 @" ++ String.fromInt id ]
            }

        Nothing ->
            { world = w, notices = [] }


{-| A window made by another client (`new-window -d`), with one pane. -}
addWindow : Int -> Int -> World -> { world : World, notices : Array String }
addWindow id pane w =
    let
        first =
            activePane w

        index =
            1 + Array.foldl (\o m -> max m o.index) w.window.index w.others
    in
    { world = { w | others = Array.pushLast { id = id, index = index, name = "sh", panes = [ { first | id = pane, lines = [], mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 } ], active = pane } w.others }
    , notices =
        (if (rulesOf w.rules).newWindowPane then
            [ "%window-pane-changed @" ++ String.fromInt id ++ " %" ++ String.fromInt pane ]

         else
            []
        )
            ++ [ "%window-add @" ++ String.fromInt id ]
    }


{-| A window closed (its last pane's program exited, or `kill-window`):
the shown one, the next window shown in its place (`%window-close`, then
`%session-window-changed`); another, said gone. Nothing for the last window,
whose closing ends the session, or one the session has not. -}
closeWindow : Int -> World -> { world : World, notices : Array String }
closeWindow id w =
    if id == w.window.id then
        when Array.first w.others is
            Just next ->
                let
                    switched =
                        switchWindow next.id w

                    after =
                        switched.world
                in
                { world = { after | others = Array.keepIf (\o -> o.id /= id) after.others }
                , notices = Array.pushLast (closed w id) switched.notices
                }

            Nothing ->
                { world = w, notices = [] }

    else if Array.any (\o -> o.id == id) w.others then
        { world = { w | others = Array.keepIf (\o -> o.id /= id) w.others }, notices = [ closed w id ] }

    else
        { world = w, notices = [] }


{-| A window of the session closing, as the world's tmux says it. -}
closed : World -> Int -> String
closed w id =
    (if (rulesOf w.rules).closeUnlinked then
        "%unlinked-window-close @"

     else
        "%window-close @"
    )
        ++ String.fromInt id


{-| A window renamed (`rename-window`, or its program's name): its tab's
name in tmux, and tmux's word of it. -}
renameWindow : Int -> String -> World -> { world : World, notices : Array String }
renameWindow id name w =
    if id == w.window.id then
        let
            current =
                w.window
        in
        { world = { w | window = { current | name = name } }, notices = [ "%window-renamed @" ++ String.fromInt id ++ " " ++ name ] }

    else if Array.any (\o -> o.id == id) w.others then
        { world =
            { w
                | others =
                    Array.map
                        (\o ->
                            if o.id == id then
                                { o | name = name }

                            else
                                o
                        )
                        w.others
            }
        , notices = [ "%window-renamed @" ++ String.fromInt id ++ " " ++ name ]
        }

    else
        { world = w, notices = [] }


activePane : World -> Pane
activePane w =
    Array.findFirst (\p -> p.id == w.active) w.panes
        |> Maybe.map .value
        |> Maybe.withDefault { id = 0, lines = [], rows = 1, mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 }


{-| A command's target pane: `%N`, or the active one for anything else. -}
paneOf : Maybe String -> World -> Pane
paneOf t w =
    when t
        |> Maybe.andThen
            (\s ->
                if String.startsWith "%" s then
                    String.toInt (String.dropFirst 1 s)

                else
                    Nothing
            ) is
        Just id ->
            Array.findFirst (\p -> p.id == id) w.panes
                |> Maybe.map .value
                |> Maybe.withDefault (activePane w)

        Nothing ->
            activePane w


setPane : Pane -> World -> World
setPane p w =
    { w
        | panes =
            Array.map
                (\q ->
                    if q.id == p.id then
                        p

                    else
                        q
                )
                w.panes
    }


{-| A pane put in copy mode (`prefix [`), the cursor where the pane's is,
and tmux's word of it. -}
enterCopy : Int -> World -> { world : World, notices : Array String }
enterCopy id w =
    let
        p =
            paneOf (Just ("%" ++ String.fromInt id)) w
    in
    { world = setPane { p | mode = "copy-mode", scroll = 0, cx = cursorX p, cy = p.rows - 1, wanted = cursorX p } w
    , notices = [ "%pane-mode-changed %" ++ String.fromInt id ]
    }


{-| Where a pane's copy mode is: lines back from the bottom, and the
cursor in the pane. -}
copyState : Int -> World -> { scroll : Int, cx : Int, cy : Int, mode : String }
copyState id w =
    let
        p =
            paneOf (Just ("%" ++ String.fromInt id)) w
    in
    { scroll = p.scroll, cx = p.cx, cy = p.cy, mode = p.mode }


{-| A pane gone, as when its program exits: the next one active if it was,
and tmux's word of it, the window's new layout and its active pane
(measured, TK10). -}
closePane : Int -> World -> { world : World, notices : Array String }
closePane id w =
    let
        left =
            Array.keepIf (\p -> p.id /= id) w.panes

        active =
            if w.active == id then
                Array.first left |> Maybe.map .id |> Maybe.withDefault w.active

            else
                w.active

        next =
            { w | panes = left, active = active }
    in
    { world = next
    , notices =
        [ "%layout-change @0 " ++ layout next ++ " " ++ layout next ++ " *" ]
            ++ (if active /= w.active then
                    [ "%window-pane-changed @0 %" ++ String.fromInt active ]

                else
                    []
               )
    }


{-| `send-keys`: in copy mode, a copy command (`-X cursor-up`) or a key
through copy-mode-vi's table (`-K k`, a key name, or `-H 6b`, its bytes in
hex, as puritty sends a letter); otherwise nothing changes here (what the
program would print is a test's to send). -}
sendKeys : { bools : String, values : Dict String String, rest : Array String } -> Pane -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String }
sendKeys args p w =
    let
        commandsOf =
            if String.contains "X" args.bools then
                args.rest

            else
                Array.map (\k -> Maybe.withDefault "" (Dict.get k copyTable)) keysSent

        keysSent =
            if String.contains "H" args.bools then
                Array.map (\h -> String.fromChar (Maybe.withDefault '?' (Char.fromCode (hexValue h)))) args.rest

            else
                args.rest
    in
    if p.mode == "" then
        if String.contains "X" args.bools then
            -- a copy command for a pane not in a mode (measured, TK10)
            { w = w, ok = False, lines = [ "not in a mode" ], notices = [] }

        else
            { w = w, ok = True, lines = [], notices = [] }

    else
        let
            ran =
                Array.foldl (\c acc -> copyCommand (clamps w) c acc) { pane = p, left = False } commandsOf

            next =
                if ran.left then
                    setPane { p | mode = "", scroll = 0 } w

                else
                    setPane ran.pane w
        in
        { w = next
        , ok = True
        , lines = []
        , notices =
            if ran.left then
                [ "%pane-mode-changed %" ++ String.fromInt p.id ]

            else
                []
        }


hexValue : String -> Int
hexValue text =
    String.foldl
        (\c v ->
            let
                code =
                    Char.toCode c
            in
            v * 16
                + (if code >= 0x61 then
                    code - 0x61 + 10

                   else if code >= 0x41 then
                    code - 0x41 + 10

                   else
                    code - 0x30
                  )
        )
        0
        text


copyTable : Dict String String
copyTable =
    Dict.empty
        |> Dict.set "k" "cursor-up"
        |> Dict.set "Up" "cursor-up"
        |> Dict.set "j" "cursor-down"
        |> Dict.set "Down" "cursor-down"
        |> Dict.set "q" "cancel"


{-| Whether this tmux holds copy mode's cursor to a line's last character
when it moves (from 3.7: measured, TM68, TV10). -}
clamps : World -> Bool
clamps w =
    (rulesOf w.version).clamps


{-| One copy-mode command, as tmux moves its cursor and view. -}
copyCommand : Bool -> String -> { pane : Pane, left : Bool } -> { pane : Pane, left : Bool }
copyCommand clamp c acc =
    let
        p =
            acc.pane

        moved q =
            if clamp then
                held q

            else
                q

        rows =
            p.rows
    in
    when c is
        "cursor-up" ->
            if p.cy > 0 then
                { acc | pane = moved { p | cy = p.cy - 1 } }

            else if p.scroll < historyOf p then
                { acc | pane = moved { p | scroll = p.scroll + 1 } }

            else
                acc

        "cursor-down" ->
            if p.cy < rows - 1 then
                { acc | pane = moved { p | cy = p.cy + 1 } }

            else if p.scroll > 0 then
                { acc | pane = moved { p | scroll = p.scroll - 1 } }

            else
                acc

        "cancel" ->
            { acc | left = True }

        _ ->
            acc


{-| Copy mode's cursor after a move up or down on 3.8: at the column it
keeps to, but no further than the last character of the line under it, as
vi keys allow (measured: from column 8 up to `line 177`, 7; on entering
copy mode it stays where the pane's cursor was, past the end). 3.6a keeps
the column (8). -}
held : Pane -> Pane
held p =
    let
        at =
            Array.length p.lines - p.rows - p.scroll + p.cy

        length =
            String.count (Maybe.withDefault "" (Array.get at p.lines))
    in
    { p | cx = min p.wanted (max 0 (length - 1)) }


{-| The pane's cursor's column: after its last line. -}
cursorX : Pane -> Int
cursorX p =
    String.count (Maybe.withDefault "" (Array.last p.lines))


{-| The lines of a pane above its screen. -}
historyOf : Pane -> Int
historyOf p =
    max 0 (Array.length p.lines - p.rows)


{-| `list-keys`: the version's default bindings, recorded from it. -}
bindingsOf : String -> Array String
bindingsOf version =
    RealTmux.keys
        |> Array.findFirst (\k -> k.version == version)
        |> Maybe.map (\found -> found.value.lines)
        |> Maybe.withDefault []


{-| `display-message -p`'s line: its format expanded, and `%%` written
`%`, as tmux writes it (measured, 3.8 and 3.6a: `100%%` shows `100%`), and
strftime's fields filled in the message as written, before its variables
are expanded, as every version fills them (TV10). -}
shown : World -> Pane -> { bools : String, values : Dict String String, rest : Array String } -> String
shown w target args =
    expand (vars w target) (strftime (Maybe.withDefault "" (Array.last args.rest)))
        |> String.replace "%%" "%"


{-| `display-message`'s reply: with `-p` its line; without, from 3.4 a
`%message` in its block, and before it nothing (measured, TK10). -}
displayed : World -> Pane -> { bools : String, values : Dict String String, rest : Array String } -> Array String
displayed w target args =
    if String.contains "p" args.bools then
        [ shown w target args ]

    else if (rulesOf w.rules).messageInBlock then
        [ "%message " ++ shown w target args ]

    else
        []


{-| `capture-pane -p`: the screen, or from `-S` to `-E` where `-` is the
history's first line or the last; with `-a`, the alternate screen, which a
pane without one gives as one empty line, before 3.2 as nothing; with
`-J` before 3.3, each line with the cleared cells tmux gave it (measured,
TV10). -}
captured : World -> { bools : String, values : Dict String String, rest : Array String } -> Pane -> Array String
captured w args p =
    if String.contains "a" args.bools then
        if (rulesOf w.version).emptyAlternate then
            [ "" ]

        else
            []

    else if String.contains "J" args.bools && (rulesOf w.version).padsCells then
        Array.map (padded w.cols) (captured w { args | bools = String.replace "J" "" args.bools } p)

    else
        let
            total =
                Array.length p.lines

            screenTop =
                max 0 (total - p.rows)

            line flag fallback =
                when Dict.get flag args.values is
                    Just "-" ->
                        if flag == "S" then
                            0

                        else
                            total - 1

                    Just n ->
                        String.toInt n
                            |> Maybe.map
                                (\v ->
                                    if v < 0 then
                                        screenTop + v

                                    else
                                        screenTop + v
                                )
                            |> Maybe.withDefault fallback

                    Nothing ->
                        fallback

            from =
                line "S" screenTop

            to =
                line "E" (total - 1)
        in
        Array.slice from (to + 1) p.lines


{-| The buffers as tmux names them, newest first: `bufferN`, the newest
the highest N. -}
buffersOf : World -> Array { name : String, text : String }
buffersOf w =
    Array.indexedMap (\i text -> { name = "buffer" ++ String.fromInt (Array.length w.buffers - 1 - i), text = text }) w.buffers


{-| A buffer's variables: its name, size in bytes and creation time, and as
its sample (`buffer_sample`) its first line, which is all this fake keeps
of tmux's sample (TM81). -}
bufferVars : { name : String, text : String } -> (String -> String) -> String -> String
bufferVars b lookup name =
    when name is
        "buffer_name" ->
            b.name

        "buffer_size" ->
            String.fromInt (Bytes.length (Bytes.fromString b.text))

        "buffer_created" ->
            "1700000000"

        "buffer_sample" ->
            String.split "\n" b.text |> Array.first |> Maybe.withDefault ""

        _ ->
            lookup name


{-| A line as tmux before 3.3 kept it, written whole by `capture-pane -J`:
its cells grown to a quarter of the width, then half, then all of it, as
`grid_expand_line` grew them; an empty line has none. -}
padded : Int -> String -> String
padded cols line =
    let
        used =
            String.count line

        cells =
            if used == 0 then
                0

            else if used < cols // 4 then
                cols // 4

            else if used < cols // 2 then
                cols // 2

            else
                max cols used
    in
    line ++ String.repeat (cells - used) " "


{-| `list-commands`' table: each command's name, alias and usage line,
from the usage lines recorded from the version (`send-keys (send)
[-HlXRM] …`; a command with no alias has no parenthesis). -}
tableOf : String -> Array { name : String, alias : String, usage : String }
tableOf version =
    RealTmux.commands
        |> Array.findFirst (\c -> c.version == version)
        |> Maybe.map (\found -> found.value.lines)
        |> Maybe.withDefault []
        |> Array.map
            (\l ->
                let
                    words =
                        String.split " " l

                    second =
                        Maybe.withDefault "" (Array.get 1 words)
                in
                { name = Maybe.withDefault "" (Array.first words)
                , alias =
                    if String.startsWith "(" second && String.endsWith ")" second then
                        String.slice 1 (String.count second - 1) second

                    else
                        ""
                , usage = l
                }
            )


commandVars : { name : String, alias : String, usage : String } -> (String -> String) -> String -> String
commandVars c lookup name =
    if String.startsWith "?" name then
        commandVars c lookup (String.dropFirst 1 name)

    else if name == "command_list_name" then
        c.name

    else if name == "command_list_alias" then
        c.alias

    else
        lookup name


{-| `refresh-client -B name:what:format`: kept, and its value told at
once, as tmux tells a new subscription's. -}
subscribe : String -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String }
subscribe sub w =
    let
        parts =
            String.split ":" sub

        name =
            Maybe.withDefault "" (Array.get 0 parts)

        scope =
            Maybe.withDefault "" (Array.get 1 parts)

        format =
            String.join ":" (Array.dropFirst 2 parts)

        notice p =
            "%subscription-changed " ++ name ++ " $0 @0 0 %" ++ String.fromInt p.id ++ " - : " ++ expand (vars w p) format

        notices =
            if scope == "%*" then
                Array.map notice w.panes

            else
                [ notice (activePane w) ]
    in
    { w = { w | subscriptions = Array.pushLast { name = name, scope = scope, format = format } w.subscriptions }, ok = True, lines = [], notices = notices }


{-| `refresh-client -C`'s size, `100x30` (3.0 and later) or `100,30` (2.x). -}
sizeOf : String -> Maybe { cols : Int, rows : Int }
sizeOf text =
    when String.split "x" (String.replace "," "x" text) |> Array.map String.toInt is
        [ Just cols, Just rows ] ->
            Just { cols = cols, rows = rows }

        _ ->
            Nothing


{-| The control client's size set (`refresh-client -C`): the session's
windows made that size, an empty block, and a `%layout-change` for each
window in the order of their indexes, in tmux's layout string, or in
JSON on 3.8 when the client asked for `new-layouts`, the shown one's flags
`*` and the others' none (measured on 2.7, 3.0, 3.2a, 3.4, 3.7c and 3.8,
docs/tmux-checks.md TK10.10). -}
resizedTo : { cols : Int, rows : Int } -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String }
resizedTo size w0 =
    let
        w =
            { w0 | cols = size.cols, rows = size.rows, panes = Array.map (\p -> { p | rows = size.rows }) w0.panes, others = Array.map (\o -> { o | panes = Array.map (\p -> { p | rows = size.rows }) o.panes }) w0.others }

        notice o =
            let
                l =
                    layoutWith ((rulesOf w.version).jsonLayout && w.newLayouts) (viewed o w)
            in
            "%layout-change @"
                ++ String.fromInt o.id
                ++ " "
                ++ l
                ++ " "
                ++ l
                ++ " "
                ++ (if o.id == w.window.id then
                        "*"

                    else
                        ""
                   )
    in
    { w = w, ok = True, lines = [], notices = windowsOf w |> Array.sortBy .index |> Array.map notice }


{-| The layout tmux gives: the panes side by side, in 3.8's JSON form
(`new-layouts`), or before it as `b25d,80x24,0,0,0`, the body after its
checksum, as this version writes `window_layout`. -}
layout : World -> String
layout w =
    layoutWith (rulesOf w.version).jsonLayout w


layoutWith : Bool -> World -> String
layoutWith asJson w =
    let
        n =
            String.fromInt

        floating id =
            Array.findFirst (\f -> f.id == id) w.floats |> Maybe.map .value

        tiled =
            Array.keepIf (\p -> floating p.id == Nothing) w.panes

        tiledWorld =
            { w | panes = tiled }

        cells =
            Array.map (\p -> { id = p.id, x = paneIndex tiledWorld p * (paneWidth tiledWorld + 1), width = widthOf tiledWorld p }) tiled

        size =
            n w.cols ++ "x" ++ n w.rows ++ ",0,0"

        body =
            when cells is
                [ only ] ->
                    size ++ "," ++ n only.id

                _ ->
                    size ++ "{" ++ String.join "," (Array.map (\c -> n c.width ++ "x" ++ n w.rows ++ "," ++ n c.x ++ ",0," ++ n c.id) cells) ++ "}"

        json c =
            box { id = c.id, x = c.x, y = 0, w = c.width, h = w.rows } ""

        box c z =
            "{\"t\":\"p\",\"w\":"
                ++ n c.w
                ++ ",\"h\":"
                ++ n c.h
                ++ ",\"x\":"
                ++ n c.x
                ++ ",\"y\":"
                ++ n c.y
                ++ ","
                ++ (if c.id == w.active then
                        "\"a\":true,"

                    else
                        ""
                   )
                ++ "\"i\":"
                ++ n c.id
                ++ z
                ++ ",\"I\":\"%"
                ++ n c.id
                ++ "\"}"

        floats =
            Array.indexedMap (\i f -> box f (",\"z\":" ++ n (Array.length w.floats - 1 - i))) w.floats
    in
    if not asJson then
        hex4 (checksum body) ++ "," ++ body

    else
        when { cells = cells, floats = floats } is
            { cells = [ only ], floats = [] } ->
                "{\"V\":2,\"L\":" ++ json { only | x = 0, width = w.cols } ++ "}"

            _ ->
                "{\"V\":2,\"L\":{\"t\":\"h\",\"w\":" ++ n w.cols ++ ",\"h\":" ++ n w.rows ++ ",\"x\":0,\"y\":0,\"c\":[" ++ String.join "," (Array.map json cells ++ floats) ++ "]}}"


{-| tmux's layout checksum (`layout_checksum`): a 16-bit sum, rotated right
by one before each character is added. -}
checksum : String -> Int
checksum text =
    String.foldl
        (\c sum ->
            let
                rotated =
                    Bitwise.or (Bitwise.shiftRightZfBy 1 sum) (Bitwise.and 0x8000 (Bitwise.shiftLeftBy 15 sum))
            in
            Bitwise.and 0xFFFF (rotated + Char.toCode c)
        )
        0
        text


{-| Four hexadecimal digits, lower case, as `%04hx` writes them. -}
hex4 : Int -> String
hex4 n =
    Array.map (\shift -> String.slice (Bitwise.and 15 (Bitwise.shiftRightZfBy shift n)) (Bitwise.and 15 (Bitwise.shiftRightZfBy shift n) + 1) "0123456789abcdef") [ 12, 8, 4, 0 ]
        |> String.join ""


{-| A format's variables for a pane, as tmux 3.8 expands them; one this
model has no value for, or one the world lacks, is empty, as tmux's
unknown ones are. A `?name` is one a condition names (`#{?name,a,b}`),
which 2.7 takes as true when it does not have it. -}
vars : World -> Pane -> String -> String
vars w p name =
    if String.startsWith "?" name then
        let
            bare =
                String.dropFirst 1 name

            unknown =
                Array.member bare w.lacking || String.startsWith "@" bare && not (Dict.member bare w.options)
        in
        if unknown && (rulesOf w.version).unknownTrue then
            "1"

        else
            vars w p bare

    else if String.startsWith "pane#" name then
        -- a pane of the window's by its index, for `P:`
        let
            at =
                String.split ":" (String.dropFirst 5 name)

            index =
                Array.first at |> Maybe.andThen String.toInt |> Maybe.withDefault 0
        in
        vars w (Array.get index w.panes |> Maybe.withDefault p) (String.join ":" (Array.dropFirst 1 at))

    else if Array.member name w.lacking then
        ""

    else
        varsOf w p name


varsOf : World -> Pane -> String -> String
varsOf w p name =
    let
        n =
            String.fromInt

        history =
            historyOf p

        -- copy mode's variables are empty outside it (measured, 3.8 and 3.6a)
        copying value =
            if p.mode == "" then
                ""

            else
                value
    in
    if String.startsWith "@" name then
        Maybe.withDefault "" (Dict.get name w.options)

    else if Dict.member name w.options then
        -- an option a test set, as this version writes it
        Maybe.withDefault "" (Dict.get name w.options)

    else
        when name is
            "pane_id" ->
                "%" ++ n p.id

            "window_id" ->
                "@" ++ n w.window.id

            "session_id" ->
                "$0"

            "session_name" ->
                "main"

            "window_name" ->
                w.window.name

            "window_index" ->
                n w.window.index

            "window_active" ->
                "1"

            "window_flags" ->
                "*"

            "window_panes" ->
                n (Array.length w.panes)

            "session_attached" ->
                "1"

            "session_windows" ->
                n (1 + Array.length w.others)

            "session_grouped" ->
                "0"

            "session_activity" ->
                "1700000000"

            "session_created" ->
                "1700000000"

            "window_activity" ->
                "1700000000"

            "pane_activity" ->
                "1700000000"

            "pane_flags" ->
                if p.id == w.active then
                    "*"

                else
                    ""

            "pane_left" ->
                n (paneIndex w p * (paneWidth w + 1))

            "pane_top" ->
                "0"

            "pane_marked" ->
                "0"

            "pane_marked_set" ->
                "0"

            "pane_private_modes" ->
                "7,25"

            -- a shell's pane: its cursor shown, wrapping, no origin mode
            "cursor_flag" ->
                "1"

            "wrap_flag" ->
                "1"

            "origin_flag" ->
                "0"

            "host" ->
                "host"

            "host_short" ->
                "host"

            "tree-mode-preview-style" ->
                "fg=themered"

            -- 3.7's preview label, the window's or the pane's by where it
            -- is expanded (TM88)
            "tree-mode-preview-format" ->
                "#{?pane_format,#{pane_index}:#{pane_title},#{window_index}:#{window_name}}"

            -- a format expanded for a pane, as display-message and
            -- list-panes do; list-windows says 0
            "pane_format" ->
                "1"

            "pane_search_string" ->
                ""

            "selection_present" ->
                copying "0"

            "window_layout" ->
                layout w

            "window_visible_layout" ->
                layout w

            "window_width" ->
                n w.cols

            "window_height" ->
                n w.rows

            "window_zoomed_flag" ->
                "0"

            "pane_active" ->
                if p.id == w.active then
                    "1"

                else
                    "0"

            "pane_index" ->
                n (paneIndex w p)

            "pane_width" ->
                n (widthOf w p)

            "pane_height" ->
                n w.rows

            "pane_current_command" ->
                "sh"

            "pane_title" ->
                "host"

            "cursor_x" ->
                n (cursorX p)

            "cursor_y" ->
                n (w.rows - 1)

            "alternate_on" ->
                "0"

            "scroll_region_upper" ->
                "0"

            "scroll_region_lower" ->
                n (w.rows - 1)

            "pane_mode" ->
                p.mode

            "pane_in_mode" ->
                if p.mode == "" then
                    "0"

                else
                    "1"

            "mode-keys" ->
                "vi"

            "scroll_position" ->
                copying (n p.scroll)

            "history_size" ->
                n history

            "copy_cursor_x" ->
                copying (n p.cx)

            "copy_cursor_y" ->
                copying (n p.cy)

            "prefix" ->
                "C-b"

            "prefix2" ->
                "None"

            "repeat-time" ->
                "500"

            "version" ->
                w.version

            "display-panes-time" ->
                "1000"

            "client_name" ->
                "client-0"

            _ ->
                -- with nothing selected, where a selection is is empty
                if String.startsWith "selection_" name then
                    ""

                else if String.startsWith "search_" name || name == "rectangle_toggle" then
                    copying "0"

                else if String.endsWith "_flag" name then
                    "0"

                else
                    optionOf w name


{-| An option's value with no configuration, as this version's format
gives it (`RealTmux.options`); empty for one it does not have. -}
optionOf : World -> String -> String
optionOf w name =
    RealTmux.options
        |> Array.findFirst (\o -> o.version == w.version)
        |> Maybe.andThen (\found -> Array.findFirst (\v -> v.name == name) found.value.values)
        |> Maybe.map (\found -> found.value.value)
        |> Maybe.withDefault ""


{-| The version a format's modifier came in (measured on each release,
docs/tmux-versions.md TV10): before it, tmux expands `#{op:…}` empty. -}
modifierSince : String -> Int
modifierSince op =
    when op is
        "T" ->
            29

        "E" ->
            29

        "q" ->
            29

        "m/r" ->
            30

        "<" ->
            30

        ">" ->
            30

        "t/p" ->
            32

        "P" ->
            30

        "!" ->
            36

        _ ->
            if String.startsWith "=/" op then
                30

            else if String.startsWith "e|" op then
                32

            else
                0


{-| `e|op:a,b` on integers: the sum, difference or product. -}
arithmetic : (Int -> Int -> Int) -> String -> String -> String
arithmetic op a b =
    String.fromInt (op (String.toInt a |> Maybe.withDefault 0) (String.toInt b |> Maybe.withDefault 0))


{-| `e|op:a,b` comparing integers, 1 or 0. -}
compared : (Int -> Int -> Bool) -> String -> String -> String
compared op a b =
    if op (String.toInt a |> Maybe.withDefault 0) (String.toInt b |> Maybe.withDefault 0) then
        "1"

    else
        "0"


{-| strftime's fields in an expanded `T:`, as record-tmux.py writes the
time a real tmux gave. -}
strftime : String -> String
strftime text =
    text
        |> String.replace "%H" "12"
        |> String.replace "%M" "00"
        |> String.replace "%d" "01"
        |> String.replace "%b" "Jan"
        |> String.replace "%y" "70"


{-| Where a pane is among the window's, and how wide each is: the panes
side by side, a column of border between. -}
paneIndex : World -> Pane -> Int
paneIndex w p =
    Array.findFirst (\q -> q.id == p.id) w.panes |> Maybe.map .index |> Maybe.withDefault 0


paneWidth : World -> Int
paneWidth w =
    (w.cols - (Array.length w.panes - 1)) // max 1 (Array.length w.panes)


{-| A pane's width: `paneWidth`, the last pane what is left. -}
widthOf : World -> Pane -> Int
widthOf w p =
    if paneIndex w p == Array.length w.panes - 1 then
        w.cols - paneIndex w p * (paneWidth w + 1)

    else
        paneWidth w


{-| A format expanded as tmux expands one: `#{name}` a variable; `#{?a,b,c}`
b where a is true (not empty and not `0`), else c; the modifiers `E:`,
`T:`, `q:`, `m/r:`, `==:`, `!=:`, `<:`, `>:`, `&&:`, `||:`, `!:`, `t/p:` and
`=N:`/`=/N/end:`; `#{#{x}}` the variable the inner format names; the
one-letter aliases (`#W`, `#S`); `##` a `#`; and `#[style]` left as it
is. -}
expand : (String -> String) -> String -> String
expand lookup text =
    let
        chars =
            String.toArray text

        go i acc =
            when Array.get i chars is
                Nothing ->
                    acc

                Just '#' ->
                    when Array.get (i + 1) chars is
                        Just '{' ->
                            let
                                close =
                                    matching chars (i + 2) 1

                                inner =
                                    String.fromArray (Array.slice (i + 2) close chars)
                            in
                            go (close + 1) (acc ++ variable lookup inner)

                        Just '#' ->
                            go (i + 2) (acc ++ "#")

                        Just ',' ->
                            go (i + 2) (acc ++ ",")

                        Just c ->
                            when aliasOf c is
                                Just name ->
                                    go (i + 2) (acc ++ lookup name)

                                Nothing ->
                                    go (i + 1) (acc ++ "#")

                        Nothing ->
                            go (i + 1) (acc ++ "#")

                Just c ->
                    go (i + 1) (acc ++ String.fromChar c)
    in
    go 0 ""


matching : Array Char -> Int -> Int -> Int
matching chars i depth =
    when Array.get i chars is
        Nothing ->
            i

        Just '}' ->
            if depth == 1 then
                i

            else
                matching chars (i + 1) (depth - 1)

        Just '{' ->
            matching chars (i + 1) (depth + 1)

        Just _ ->
            matching chars (i + 1) depth


variable : (String -> String) -> String -> String
variable lookup inner =
    let
        truthy v =
            v /= "" && v /= "0"

        bool b =
            if b then
                "1"

            else
                "0"

        parts rest =
            Array.map (expand lookup) (topLevel rest)

        two rest f =
            when parts rest is
                [ a, b ] ->
                    f a b

                _ ->
                    ""
    in
    if String.startsWith "?" inner then
        let
            choices =
                topLevel (String.dropFirst 1 inner)

            first =
                Maybe.withDefault "" (Array.get 0 choices)

            -- a condition that is a format (`#{?#{!:x},a,b}`) is expanded;
            -- a name (`#{?pane_marked,a,b}`) is looked up as a condition's
            -- (`vars`), and one with a modifier as a format
            cond =
                if String.startsWith "#" first then
                    expand lookup first

                else if modifierOf first == Nothing then
                    lookup ("?" ++ first)

                else
                    expand lookup ("#{" ++ first ++ "}")
        in
        if truthy cond then
            expand lookup (Maybe.withDefault "" (Array.get 1 choices))

        else
            expand lookup (Maybe.withDefault "" (Array.get 2 choices))

    else if String.startsWith "#" inner then
        lookup (expand lookup inner)

    else
        when modifierOf inner is
            Nothing ->
                lookup inner

            Just m ->
                -- the version through the lookup, which every one answers
                if tenths (lookup "version") < modifierSince m.op then
                    ""

                else
                    when m.op is
                        "P" ->
                            -- each of the window's panes, by its index
                            Array.range 0 ((String.toInt (lookup "window_panes") |> Maybe.withDefault 1) - 1)
                                |> Array.map (\i -> expand (\name -> lookup ("pane#" ++ String.fromInt i ++ ":" ++ name)) m.rest)
                                |> String.join ""

                        "E" ->
                            expand lookup (lookup m.rest)

                        "e|+" ->
                            two m.rest (arithmetic (+))

                        "e|-" ->
                            two m.rest (arithmetic (-))

                        "e|*" ->
                            two m.rest (arithmetic (*))

                        "e|>=" ->
                            two m.rest (compared (>=))

                        "e|<=" ->
                            two m.rest (compared (<=))

                        "e|>" ->
                            two m.rest (compared (>))

                        "e|<" ->
                            two m.rest (compared (<))

                        "e|==" ->
                            two m.rest (compared (==))

                        "T" ->
                            strftime (expand lookup (lookup m.rest))

                        "q" ->
                            quoted (lookup m.rest)

                        "m/r" ->
                            two m.rest (\pattern text -> bool (matches pattern text))

                        "==" ->
                            two m.rest (\a b -> bool (a == b))

                        "!=" ->
                            two m.rest (\a b -> bool (a /= b))

                        "<" ->
                            two m.rest (\a b -> bool (a < b))

                        ">" ->
                            two m.rest (\a b -> bool (a > b))

                        "&&" ->
                            two m.rest (\a b -> bool (truthy a && truthy b))

                        "||" ->
                            two m.rest (\a b -> bool (truthy a || truthy b))

                        "!" ->
                            bool (not (truthy (expand lookup m.rest)))

                        "t/p" ->
                            if lookup m.rest == "" then
                                ""

                            else
                                "12:00"

                        op ->
                            when truncation op is
                                Just t ->
                                    let
                                        value =
                                            lookup m.rest
                                    in
                                    if String.count value > t.length then
                                        String.takeFirst t.length value ++ t.end

                                    else
                                        value

                                Nothing ->
                                    lookup m.rest


{-| A format's modifier: the text before its first `:` outside `#{…}`,
when that is one tmux has, and what follows. -}
modifierOf : String -> Maybe { op : String, rest : String }
modifierOf inner =
    let
        chars =
            String.toArray inner

        colon i depth =
            when Array.get i chars is
                Nothing ->
                    Nothing

                Just ':' ->
                    if depth == 0 then
                        Just i

                    else
                        colon (i + 1) depth

                Just '{' ->
                    colon (i + 1) (depth + 1)

                Just '}' ->
                    colon (i + 1) (depth - 1)

                Just _ ->
                    colon (i + 1) depth
    in
    when colon 0 0 is
        Just at ->
            let
                op =
                    String.takeFirst at inner
            in
            if Array.member op [ "E", "T", "q", "m/r", "==", "!=", "<", ">", "&&", "||", "!", "t/p", "P", "e|+", "e|-", "e|*", "e|>=", "e|<=", "e|>", "e|<", "e|==" ] || truncation op /= Nothing then
                Just { op = op, rest = String.dropFirst (at + 1) inner }

            else
                Nothing

        Nothing ->
            Nothing


{-| `=N` or `=/N/end`: at most N characters, `end` after a value cut. -}
truncation : String -> Maybe { length : Int, end : String }
truncation op =
    if String.startsWith "=/" op then
        when String.split "/" (String.dropFirst 2 op) is
            [ n, end ] ->
                String.toInt n |> Maybe.map (\v -> { length = v, end = end })

            _ ->
                Nothing

    else if String.startsWith "=" op then
        String.toInt (String.dropFirst 1 op) |> Maybe.map (\v -> { length = v, end = "" })

    else
        Nothing


{-| `q:`'s quoting: each character a shell would take specially escaped
with a backslash. -}
quoted : String -> String
quoted value =
    String.foldl
        (\c acc ->
            if String.contains (String.fromChar c) "|&;<>()$`\\\"'*?[# =%" then
                acc ++ "\\" ++ String.fromChar c

            else
                acc ++ String.fromChar c
        )
        ""
        value


{-| `m/r:`'s match, for the patterns tmux's own bindings use: literal
text with one group of alternatives (`(copy|view)-mode`), found anywhere
in the text. -}
matches : String -> String -> Bool
matches pattern text =
    let
        alternatives =
            when String.firstIndexOf "(" pattern is
                Just open ->
                    when String.firstIndexOf ")" pattern is
                        Just close ->
                            String.slice (open + 1) close pattern
                                |> String.split "|"
                                |> Array.map (\a -> String.takeFirst open pattern ++ a ++ String.dropFirst (close + 1) pattern)

                        Nothing ->
                            [ pattern ]

                Nothing ->
                    [ pattern ]
    in
    Array.any (\a -> String.contains a text) alternatives


{-| tmux's one-letter aliases (`#W` for `#{window_name}`). -}
aliasOf : Char -> Maybe String
aliasOf c =
    when c is
        'D' ->
            Just "pane_id"

        'F' ->
            Just "window_flags"

        'H' ->
            Just "host"

        'h' ->
            Just "host_short"

        'I' ->
            Just "window_index"

        'P' ->
            Just "pane_index"

        'S' ->
            Just "session_name"

        'T' ->
            Just "pane_title"

        'W' ->
            Just "window_name"

        _ ->
            Nothing


{-| A text split at its commas outside `#{…}`. -}
topLevel : String -> Array String
topLevel text =
    let
        done =
            String.toArray text
                |> Array.foldl
                    (\c acc ->
                        if c == ',' && acc.depth == 0 && not (String.endsWith "#" acc.current) then
                            { acc | parts = Array.pushLast acc.current acc.parts, current = "" }

                        else
                            { acc
                                | current = acc.current ++ String.fromChar c
                                , depth =
                                    if c == '{' then
                                        acc.depth + 1

                                    else if c == '}' then
                                        acc.depth - 1

                                    else
                                        acc.depth
                            }
                    )
                    { parts = [], current = "", depth = 0 }
    in
    Array.pushLast done.current done.parts
