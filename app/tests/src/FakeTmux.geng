module FakeTmux exposing
    ( Pane
    , World
    , answer
    , copyState
    , enterCopy
    , known
    , startBytes
    , world
    )

{-| A tmux server as puritty's control mode sees it, for `TmuxMode`'s tests
(`docs/tmux.md` TM68): one session (`$0`, `main`) with one window (`@0`)
and its panes, numbered from `%0` as a new server numbers them, each with its lines (history and screen) and, in copy
mode, where the view and the cursor are. It answers the command lines
`TmuxMode` sends as tmux 3.8 or 3.6a does (`version`), a `%begin`/`%end` block a command,
expanding the `#{…}` formats it is asked for from that model, and acts on
the commands that change it (`send-keys` in copy mode, `copy-mode`). A
command it does not know is answered with nothing and kept in `unknown`,
so that a test can see what it was not ready for.

It is a model, so it can be wrong where tmux is not; `known` lists what it
answers, and each answer is checked against a real tmux's (TM68).
-}

import Bitwise
import Bytes exposing (Bytes)
import Dict exposing (Dict)
import RealTmux
import Tmux.Syntax as Syntax


{-| A pane: its id (`%id`), its lines, oldest first, the last `rows` of
them its screen; its mode as `#{pane_mode}` says it (`""` or `copy-mode`,
whose keys are copy-mode-vi's here); and in copy mode how
many lines back from the bottom the view is and the cursor in the pane. -}
type alias Pane =
    { id : Int
    , lines : Array String
    , rows : Int
    , mode : String
    , scroll : Int
    , cx : Int
    , cy : Int
    , wanted : Int
    }


{-| The server: the tmux it is (`"3.8"` or `"3.6a"`), the window's size,
its panes side by side, the active one, the reply count, what was asked
that it does not know, the subscriptions, every command answered, in
order, and every command line as it was sent (`heard`), which a test
holds against the recorded questions (TM69). -}
type alias World =
    { version : String
    , cols : Int
    , rows : Int
    , panes : Array Pane
    , active : Int
    , number : Int
    , unknown : Array String
    , subscriptions : Array { name : String, scope : String, format : String }
    , answered : Array String
    , heard : Array String
    , options : Dict String String
    }


{-| A window of `cols` by `rows` with one pane, `%0`, showing `lines`, the
cursor after the last of them, as a program that printed them and no last
newline leaves it, on tmux `version`. -}
world : { version : String, cols : Int, rows : Int, lines : Array String } -> World
world w =
    { version = w.version
    , cols = w.cols
    , rows = w.rows
    , panes = [ { id = 0, lines = w.lines, rows = w.rows, mode = "", scroll = 0, cx = 0, cy = w.rows - 1, wanted = 0 } ]
    , active = 0
    , number = 1
    , unknown = []
    , subscriptions = []
    , answered = []
    , heard = []
    , options = Dict.empty
    }


{-| What `tmux -CC attach` writes first: control mode begun, and the
attach command's own empty reply. -}
startBytes : Bytes
startBytes =
    Bytes.fromString ("\u{001B}P1000p" ++ "%begin 1700000000 0 0\u{000D}\n%end 1700000000 0 0\u{000D}\n")


{-| The commands tmux answers here, by name. -}
known : Array String
known =
    [ "display-message", "list-windows", "list-panes", "list-sessions", "list-keys", "list-commands", "capture-pane", "refresh-client", "send-keys", "copy-mode", "switch-client", "select-pane", "set-option" ]


{-| A command line answered: each of its commands' replies, then what the
commands made tmux tell the client (`%pane-mode-changed`, subscriptions). -}
answer : String -> World -> { world : World, bytes : Bytes }
answer line w0 =
    let
        done =
            Syntax.commands (Syntax.tokens line)
                |> Array.foldl
                    (\tokens acc ->
                        let
                            r =
                                one (Array.map .value tokens) acc.w
                        in
                        { w = { r.w | number = r.w.number + 1, answered = Array.pushLast (String.join " " (Array.map .value tokens)) r.w.answered }
                        , text = acc.text ++ block acc.w.number r.ok r.lines
                        , notices = acc.notices ++ r.notices
                        }
                    )
                    { w = { w0 | heard = Array.pushLast line w0.heard }, text = "", notices = [] }
    in
    { world = done.w
    , bytes = Bytes.fromString (done.text ++ String.join "" (Array.map (\n -> n ++ "\u{000D}\n") done.notices))
    }


block : Int -> Bool -> Array String -> String
block number ok lines =
    let
        tail =
            (if ok then
                "%end "

             else
                "%error "
            )
                ++ "1700000000 "
                ++ String.fromInt number
                ++ " 1\u{000D}\n"
    in
    "%begin 1700000000 " ++ String.fromInt number ++ " 1\u{000D}\n" ++ String.join "" (Array.map (\l -> l ++ "\u{000D}\n") lines) ++ tail


{-| One command: its reply's lines, whether it succeeded, the world after it
and what tmux tells the client because of it. -}
one : Array String -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String }
one words w =
    let
        name =
            Maybe.withDefault "" (Array.first words)

        args =
            parsed (Array.dropFirst 1 words)

        target =
            paneOf (Dict.get "t" args.values) w

        format =
            Maybe.withDefault "" (Dict.get "F" args.values)

        reply lines =
            { w = w, ok = True, lines = lines, notices = [] }
    in
    when name is
        "display-message" ->
            reply [ shown w target args ]

        "display" ->
            reply [ shown w target args ]

        "list-windows" ->
            reply [ expand (vars w (activePane w)) format ]

        "list-panes" ->
            reply (Array.map (\p -> expand (vars w p) format) w.panes)

        "list-sessions" ->
            reply [ expand (vars w (activePane w)) format ]

        "list-keys" ->
            reply
                (if Dict.member "F" args.values || String.contains "N" args.bools then
                    []

                 else
                    bindingsOf w.version
                )

        "list-commands" ->
            reply (Array.map (\c -> expand (commandVars c (vars w target)) format) (tableOf w.version))

        "capture-pane" ->
            reply (captured args target)

        "refresh-client" ->
            when Dict.get "B" args.values is
                Just sub ->
                    subscribe sub w

                Nothing ->
                    reply []

        "send-keys" ->
            sendKeys args target w

        "copy-mode" ->
            let
                next =
                    enterCopy target.id w
            in
            { w = next.world, ok = True, lines = [], notices = next.notices }

        "switch-client" ->
            reply []

        "set-option" ->
            -- a user option (`@name`), kept for formats to read
            when args.rest is
                [ option, value ] ->
                    { w = { w | options = Dict.set option value w.options }, ok = True, lines = [], notices = [] }

                [ option ] ->
                    { w = { w | options = Dict.set option "" w.options }, ok = True, lines = [], notices = [] }

                _ ->
                    reply []

        "select-pane" ->
            reply []

        _ ->
            { w = { w | unknown = Array.pushLast (String.join " " words) w.unknown }, ok = True, lines = [], notices = [] }


{-| A command's words: its flags without values (`-p` as `p`), the ones
with (`-t %1`), and the rest. -}
parsed : Array String -> { bools : String, values : Dict String String, rest : Array String }
parsed words =
    let
        takesValue c =
            String.contains c "tFBCcfTSEbx"

        step acc =
            when Array.get acc.at words is
                Nothing ->
                    acc

                Just word ->
                    if acc.restOnly || not (String.startsWith "-" word) || word == "-" then
                        step { acc | at = acc.at + 1, rest = Array.pushLast word acc.rest, restOnly = True }

                    else if word == "--" then
                        step { acc | at = acc.at + 1, restOnly = True }

                    else
                        let
                            letters =
                                String.dropFirst 1 word

                            last =
                                String.takeLast 1 letters
                        in
                        if takesValue last then
                            step
                                { acc
                                    | at = acc.at + 2
                                    , bools = acc.bools ++ String.dropLast 1 letters
                                    , values = Dict.set last (Maybe.withDefault "" (Array.get (acc.at + 1) words)) acc.values
                                }

                        else
                            step { acc | at = acc.at + 1, bools = acc.bools ++ letters }

        done =
            step { at = 0, bools = "", values = Dict.empty, rest = [], restOnly = False }
    in
    { bools = done.bools, values = done.values, rest = done.rest }


activePane : World -> Pane
activePane w =
    Array.findFirst (\p -> p.id == w.active) w.panes
        |> Maybe.map .value
        |> Maybe.withDefault { id = 0, lines = [], rows = 1, mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 }


{-| A command's target pane: `%N`, or the active one for anything else. -}
paneOf : Maybe String -> World -> Pane
paneOf t w =
    when t
        |> Maybe.andThen
            (\s ->
                if String.startsWith "%" s then
                    String.toInt (String.dropFirst 1 s)

                else
                    Nothing
            ) is
        Just id ->
            Array.findFirst (\p -> p.id == id) w.panes
                |> Maybe.map .value
                |> Maybe.withDefault (activePane w)

        Nothing ->
            activePane w


setPane : Pane -> World -> World
setPane p w =
    { w
        | panes =
            Array.map
                (\q ->
                    if q.id == p.id then
                        p

                    else
                        q
                )
                w.panes
    }


{-| A pane put in copy mode (`prefix [`), the cursor where the pane's is,
and tmux's word of it. -}
enterCopy : Int -> World -> { world : World, notices : Array String }
enterCopy id w =
    let
        p =
            paneOf (Just ("%" ++ String.fromInt id)) w
    in
    { world = setPane { p | mode = "copy-mode", scroll = 0, cx = cursorX p, cy = p.rows - 1, wanted = cursorX p } w
    , notices = [ "%pane-mode-changed %" ++ String.fromInt id ]
    }


{-| Where a pane's copy mode is: lines back from the bottom, and the
cursor in the pane. -}
copyState : Int -> World -> { scroll : Int, cx : Int, cy : Int, mode : String }
copyState id w =
    let
        p =
            paneOf (Just ("%" ++ String.fromInt id)) w
    in
    { scroll = p.scroll, cx = p.cx, cy = p.cy, mode = p.mode }


{-| `send-keys`: in copy mode, a copy command (`-X cursor-up`) or a key
through copy-mode-vi's table (`-K k`, a key name, or `-H 6b`, its bytes in
hex, as puritty sends a letter); otherwise nothing changes here (what the
program would print is a test's to send). -}
sendKeys : { bools : String, values : Dict String String, rest : Array String } -> Pane -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String }
sendKeys args p w =
    let
        commandsOf =
            if String.contains "X" args.bools then
                args.rest

            else
                Array.map (\k -> Maybe.withDefault "" (Dict.get k copyTable)) keysSent

        keysSent =
            if String.contains "H" args.bools then
                Array.map (\h -> String.fromChar (Maybe.withDefault '?' (Char.fromCode (hexValue h)))) args.rest

            else
                args.rest
    in
    if p.mode == "" then
        { w = w, ok = True, lines = [], notices = [] }

    else
        let
            ran =
                Array.foldl (\c acc -> copyCommand (clamps w) c acc) { pane = p, left = False } commandsOf

            next =
                if ran.left then
                    setPane { p | mode = "", scroll = 0 } w

                else
                    setPane ran.pane w
        in
        { w = next
        , ok = True
        , lines = []
        , notices =
            if ran.left then
                [ "%pane-mode-changed %" ++ String.fromInt p.id ]

            else
                []
        }


hexValue : String -> Int
hexValue text =
    String.foldl
        (\c v ->
            let
                code =
                    Char.toCode c
            in
            v * 16
                + (if code >= 0x61 then
                    code - 0x61 + 10

                   else if code >= 0x41 then
                    code - 0x41 + 10

                   else
                    code - 0x30
                  )
        )
        0
        text


copyTable : Dict String String
copyTable =
    Dict.empty
        |> Dict.set "k" "cursor-up"
        |> Dict.set "Up" "cursor-up"
        |> Dict.set "j" "cursor-down"
        |> Dict.set "Down" "cursor-down"
        |> Dict.set "q" "cancel"


{-| Whether this tmux holds copy mode's cursor to a line's last character
when it moves (3.8 does, 3.6a does not: measured, TM68). -}
clamps : World -> Bool
clamps w =
    w.version /= "3.6a"


{-| One copy-mode command, as tmux moves its cursor and view. -}
copyCommand : Bool -> String -> { pane : Pane, left : Bool } -> { pane : Pane, left : Bool }
copyCommand clamp c acc =
    let
        p =
            acc.pane

        moved q =
            if clamp then
                held q

            else
                q

        rows =
            p.rows
    in
    when c is
        "cursor-up" ->
            if p.cy > 0 then
                { acc | pane = moved { p | cy = p.cy - 1 } }

            else if p.scroll < historyOf p then
                { acc | pane = moved { p | scroll = p.scroll + 1 } }

            else
                acc

        "cursor-down" ->
            if p.cy < rows - 1 then
                { acc | pane = moved { p | cy = p.cy + 1 } }

            else if p.scroll > 0 then
                { acc | pane = moved { p | scroll = p.scroll - 1 } }

            else
                acc

        "cancel" ->
            { acc | left = True }

        _ ->
            acc


{-| Copy mode's cursor after a move up or down on 3.8: at the column it
keeps to, but no further than the last character of the line under it, as
vi keys allow (measured: from column 8 up to `line 177`, 7; on entering
copy mode it stays where the pane's cursor was, past the end). 3.6a keeps
the column (8). -}
held : Pane -> Pane
held p =
    let
        at =
            Array.length p.lines - p.rows - p.scroll + p.cy

        length =
            String.count (Maybe.withDefault "" (Array.get at p.lines))
    in
    { p | cx = min p.wanted (max 0 (length - 1)) }


{-| The pane's cursor's column: after its last line. -}
cursorX : Pane -> Int
cursorX p =
    String.count (Maybe.withDefault "" (Array.last p.lines))


{-| The lines of a pane above its screen. -}
historyOf : Pane -> Int
historyOf p =
    max 0 (Array.length p.lines - p.rows)


{-| `list-keys`: the version's default bindings, recorded from it. -}
bindingsOf : String -> Array String
bindingsOf version =
    RealTmux.keys
        |> Array.findFirst (\k -> k.version == version)
        |> Maybe.map (\found -> found.value.lines)
        |> Maybe.withDefault []


{-| `display-message -p`'s line: its format expanded, and `%%` written
`%`, as tmux writes it (measured, 3.8 and 3.6a: `100%%` shows `100%`). -}
shown : World -> Pane -> { bools : String, values : Dict String String, rest : Array String } -> String
shown w target args =
    expand (vars w target) (Maybe.withDefault "" (Array.last args.rest))
        |> String.replace "%%" "%"


{-| `capture-pane -p`: the screen, or from `-S` to `-E` where `-` is the
history's first line or the last; with `-a`, the alternate screen, which a
pane without one gives as one empty line (measured). -}
captured : { bools : String, values : Dict String String, rest : Array String } -> Pane -> Array String
captured args p =
    if String.contains "a" args.bools then
        [ "" ]

    else
        let
            total =
                Array.length p.lines

            screenTop =
                max 0 (total - p.rows)

            line flag fallback =
                when Dict.get flag args.values is
                    Just "-" ->
                        if flag == "S" then
                            0

                        else
                            total - 1

                    Just n ->
                        String.toInt n
                            |> Maybe.map
                                (\v ->
                                    if v < 0 then
                                        screenTop + v

                                    else
                                        screenTop + v
                                )
                            |> Maybe.withDefault fallback

                    Nothing ->
                        fallback

            from =
                line "S" screenTop

            to =
                line "E" (total - 1)
        in
        Array.slice from (to + 1) p.lines


{-| `list-commands`' table: each command's name and alias, recorded from
the version. -}
tableOf : String -> Array { name : String, alias : String }
tableOf version =
    RealTmux.commands
        |> Array.findFirst (\c -> c.version == version)
        |> Maybe.map (\found -> found.value.lines)
        |> Maybe.withDefault []
        |> Array.map
            (\l ->
                when String.split "\t" l is
                    [ name, alias ] ->
                        { name = name, alias = alias }

                    _ ->
                        { name = l, alias = "" }
            )


commandVars : { name : String, alias : String } -> (String -> String) -> String -> String
commandVars c lookup name =
    if name == "command_list_name" then
        c.name

    else if name == "command_list_alias" then
        c.alias

    else
        lookup name


{-| `refresh-client -B name:what:format`: kept, and its value told at
once, as tmux tells a new subscription's. -}
subscribe : String -> World -> { w : World, ok : Bool, lines : Array String, notices : Array String }
subscribe sub w =
    let
        parts =
            String.split ":" sub

        name =
            Maybe.withDefault "" (Array.get 0 parts)

        scope =
            Maybe.withDefault "" (Array.get 1 parts)

        format =
            String.join ":" (Array.dropFirst 2 parts)

        notice p =
            "%subscription-changed " ++ name ++ " $0 @0 0 %" ++ String.fromInt p.id ++ " - : " ++ expand (vars w p) format

        notices =
            if scope == "%*" then
                Array.map notice w.panes

            else
                [ notice (activePane w) ]
    in
    { w = { w | subscriptions = Array.pushLast { name = name, scope = scope, format = format } w.subscriptions }, ok = True, lines = [], notices = notices }


{-| The layout tmux gives: one pane filling the window, in 3.8's JSON form
(`new-layouts`), or before it as `b25d,80x24,0,0,0`, the body after its
checksum. -}
layout : World -> String
layout w =
    let
        p =
            activePane w

        body =
            String.fromInt w.cols ++ "x" ++ String.fromInt w.rows ++ ",0,0," ++ String.fromInt p.id
    in
    if w.version == "3.6a" then
        hex4 (checksum body) ++ "," ++ body

    else
        "{\"V\":2,\"L\":{\"t\":\"p\",\"w\":"
            ++ String.fromInt w.cols
            ++ ",\"h\":"
            ++ String.fromInt w.rows
            ++ ",\"x\":0,\"y\":0,\"a\":true,\"i\":"
            ++ String.fromInt p.id
            ++ ",\"I\":\"%"
            ++ String.fromInt p.id
            ++ "\"}}"


{-| tmux's layout checksum (`layout_checksum`): a 16-bit sum, rotated right
by one before each character is added. -}
checksum : String -> Int
checksum text =
    String.foldl
        (\c sum ->
            let
                rotated =
                    Bitwise.or (Bitwise.shiftRightZfBy 1 sum) (Bitwise.and 0x8000 (Bitwise.shiftLeftBy 15 sum))
            in
            Bitwise.and 0xFFFF (rotated + Char.toCode c)
        )
        0
        text


{-| Four hexadecimal digits, lower case, as `%04hx` writes them. -}
hex4 : Int -> String
hex4 n =
    Array.map (\shift -> String.slice (Bitwise.and 15 (Bitwise.shiftRightZfBy shift n)) (Bitwise.and 15 (Bitwise.shiftRightZfBy shift n) + 1) "0123456789abcdef") [ 12, 8, 4, 0 ]
        |> String.join ""


{-| A format's variables for a pane, as tmux 3.8 expands them; one this
model has no value for is empty, as tmux's unknown ones are. -}
vars : World -> Pane -> String -> String
vars w p name =
    let
        n =
            String.fromInt

        history =
            historyOf p

        -- copy mode's variables are empty outside it (measured, 3.8 and 3.6a)
        copying value =
            if p.mode == "" then
                ""

            else
                value
    in
    if String.startsWith "@" name then
        Maybe.withDefault "" (Dict.get name w.options)

    else
        when name is
            "pane_id" ->
                "%" ++ n p.id

            "window_id" ->
                "@0"

            "session_id" ->
                "$0"

            "session_name" ->
                "main"

            "window_name" ->
                "sh"

            "window_index" ->
                "0"

            "window_active" ->
                "1"

            "window_flags" ->
                "*"

            "window_panes" ->
                n (Array.length w.panes)

            "session_attached" ->
                "1"

            "session_windows" ->
                "1"

            "session_grouped" ->
                "0"

            "session_activity" ->
                "1700000000"

            "session_created" ->
                "1700000000"

            "window_activity" ->
                "1700000000"

            "pane_activity" ->
                "1700000000"

            "pane_flags" ->
                if w.version /= "3.6a" && p.id == w.active then
                    "*"

                else
                    ""

            "pane_left" ->
                n (paneIndex w p * (paneWidth w + 1))

            "pane_top" ->
                "0"

            "pane_marked" ->
                "0"

            "pane_marked_set" ->
                "0"

            "pane_private_modes" ->
                if w.version == "3.6a" then
                    ""

                else
                    "7,25"

            "host" ->
                "host"

            "host_short" ->
                "host"

            "tree-mode-preview-style" ->
                if w.version == "3.6a" then
                    ""

                else
                    "fg=themered"

            "pane_search_string" ->
                ""

            "selection_present" ->
                copying "0"

            "window_layout" ->
                layout w

            "window_visible_layout" ->
                layout w

            "window_width" ->
                n w.cols

            "window_height" ->
                n w.rows

            "window_zoomed_flag" ->
                "0"

            "pane_active" ->
                if p.id == w.active then
                    "1"

                else
                    "0"

            "pane_index" ->
                n (paneIndex w p)

            "pane_width" ->
                n (paneWidth w)

            "pane_height" ->
                n w.rows

            "pane_current_command" ->
                "sh"

            "pane_title" ->
                "host"

            "cursor_x" ->
                n (cursorX p)

            "cursor_y" ->
                n (w.rows - 1)

            "alternate_on" ->
                "0"

            "scroll_region_upper" ->
                "0"

            "scroll_region_lower" ->
                n (w.rows - 1)

            "pane_mode" ->
                p.mode

            "pane_in_mode" ->
                if p.mode == "" then
                    "0"

                else
                    "1"

            "mode-keys" ->
                "vi"

            "scroll_position" ->
                copying (n p.scroll)

            "history_size" ->
                n history

            "copy_cursor_x" ->
                copying (n p.cx)

            "copy_cursor_y" ->
                copying (n p.cy)

            "prefix" ->
                "C-b"

            "prefix2" ->
                "None"

            "repeat-time" ->
                "500"

            "version" ->
                w.version

            "display-panes-time" ->
                "1000"

            "client_name" ->
                "client-0"

            "status" ->
                "on"

            _ ->
                -- with nothing selected, where a selection is is empty
                if String.startsWith "selection_" name then
                    ""

                else if String.startsWith "search_" name || name == "rectangle_toggle" then
                    copying "0"

                else if String.endsWith "_flag" name then
                    "0"

                else
                    ""


{-| Where a pane is among the window's, and how wide each is: the panes
side by side, a column of border between. -}
paneIndex : World -> Pane -> Int
paneIndex w p =
    Array.findFirst (\q -> q.id == p.id) w.panes |> Maybe.map .index |> Maybe.withDefault 0


paneWidth : World -> Int
paneWidth w =
    (w.cols - (Array.length w.panes - 1)) // max 1 (Array.length w.panes)


{-| A format expanded as tmux expands one: `#{name}` a variable; `#{?a,b,c}`
b where a is true (not empty and not `0`), else c; the modifiers `E:`,
`T:`, `q:`, `m/r:`, `==:`, `!=:`, `<:`, `>:`, `&&:`, `||:`, `!:`, `t/p:` and
`=N:`/`=/N/end:`; `#{#{x}}` the variable the inner format names; the
one-letter aliases (`#W`, `#S`); `##` a `#`; and `#[style]` left as it
is. -}
expand : (String -> String) -> String -> String
expand lookup text =
    let
        chars =
            String.toArray text

        go i acc =
            when Array.get i chars is
                Nothing ->
                    acc

                Just '#' ->
                    when Array.get (i + 1) chars is
                        Just '{' ->
                            let
                                close =
                                    matching chars (i + 2) 1

                                inner =
                                    String.fromArray (Array.slice (i + 2) close chars)
                            in
                            go (close + 1) (acc ++ variable lookup inner)

                        Just '#' ->
                            go (i + 2) (acc ++ "#")

                        Just c ->
                            when aliasOf c is
                                Just name ->
                                    go (i + 2) (acc ++ lookup name)

                                Nothing ->
                                    go (i + 1) (acc ++ "#")

                        Nothing ->
                            go (i + 1) (acc ++ "#")

                Just c ->
                    go (i + 1) (acc ++ String.fromChar c)
    in
    go 0 ""


matching : Array Char -> Int -> Int -> Int
matching chars i depth =
    when Array.get i chars is
        Nothing ->
            i

        Just '}' ->
            if depth == 1 then
                i

            else
                matching chars (i + 1) (depth - 1)

        Just '{' ->
            matching chars (i + 1) (depth + 1)

        Just _ ->
            matching chars (i + 1) depth


variable : (String -> String) -> String -> String
variable lookup inner =
    let
        truthy v =
            v /= "" && v /= "0"

        bool b =
            if b then
                "1"

            else
                "0"

        parts rest =
            Array.map (expand lookup) (topLevel rest)

        two rest f =
            when parts rest is
                [ a, b ] ->
                    f a b

                _ ->
                    ""
    in
    if String.startsWith "?" inner then
        let
            choices =
                topLevel (String.dropFirst 1 inner)

            first =
                Maybe.withDefault "" (Array.get 0 choices)

            -- a condition that is a format (`#{?#{!:x},a,b}`) is expanded;
            -- a name (`#{?pane_marked,a,b}`) is looked up
            cond =
                if String.startsWith "#" first then
                    expand lookup first

                else
                    expand lookup ("#{" ++ first ++ "}")
        in
        if truthy cond then
            expand lookup (Maybe.withDefault "" (Array.get 1 choices))

        else
            expand lookup (Maybe.withDefault "" (Array.get 2 choices))

    else if String.startsWith "#" inner then
        lookup (expand lookup inner)

    else
        when modifierOf inner is
            Nothing ->
                lookup inner

            Just m ->
                when m.op is
                    "E" ->
                        expand lookup (lookup m.rest)

                    "T" ->
                        expand lookup (lookup m.rest)

                    "q" ->
                        quoted (lookup m.rest)

                    "m/r" ->
                        two m.rest (\pattern text -> bool (matches pattern text))

                    "==" ->
                        two m.rest (\a b -> bool (a == b))

                    "!=" ->
                        two m.rest (\a b -> bool (a /= b))

                    "<" ->
                        two m.rest (\a b -> bool (a < b))

                    ">" ->
                        two m.rest (\a b -> bool (a > b))

                    "&&" ->
                        two m.rest (\a b -> bool (truthy a && truthy b))

                    "||" ->
                        two m.rest (\a b -> bool (truthy a || truthy b))

                    "!" ->
                        bool (not (truthy (expand lookup m.rest)))

                    "t/p" ->
                        if lookup m.rest == "" then
                            ""

                        else
                            "12:00"

                    op ->
                        when truncation op is
                            Just t ->
                                let
                                    value =
                                        lookup m.rest
                                in
                                if String.count value > t.length then
                                    String.takeFirst t.length value ++ t.end

                                else
                                    value

                            Nothing ->
                                lookup m.rest


{-| A format's modifier: the text before its first `:` outside `#{…}`,
when that is one tmux has, and what follows. -}
modifierOf : String -> Maybe { op : String, rest : String }
modifierOf inner =
    let
        chars =
            String.toArray inner

        colon i depth =
            when Array.get i chars is
                Nothing ->
                    Nothing

                Just ':' ->
                    if depth == 0 then
                        Just i

                    else
                        colon (i + 1) depth

                Just '{' ->
                    colon (i + 1) (depth + 1)

                Just '}' ->
                    colon (i + 1) (depth - 1)

                Just _ ->
                    colon (i + 1) depth
    in
    when colon 0 0 is
        Just at ->
            let
                op =
                    String.takeFirst at inner
            in
            if Array.member op [ "E", "T", "q", "m/r", "==", "!=", "<", ">", "&&", "||", "!", "t/p" ] || truncation op /= Nothing then
                Just { op = op, rest = String.dropFirst (at + 1) inner }

            else
                Nothing

        Nothing ->
            Nothing


{-| `=N` or `=/N/end`: at most N characters, `end` after a value cut. -}
truncation : String -> Maybe { length : Int, end : String }
truncation op =
    if String.startsWith "=/" op then
        when String.split "/" (String.dropFirst 2 op) is
            [ n, end ] ->
                String.toInt n |> Maybe.map (\v -> { length = v, end = end })

            _ ->
                Nothing

    else if String.startsWith "=" op then
        String.toInt (String.dropFirst 1 op) |> Maybe.map (\v -> { length = v, end = "" })

    else
        Nothing


{-| `q:`'s quoting: each character a shell would take specially escaped
with a backslash. -}
quoted : String -> String
quoted value =
    String.foldl
        (\c acc ->
            if String.contains (String.fromChar c) "|&;<>()$`\\\"'*?[# =%" then
                acc ++ "\\" ++ String.fromChar c

            else
                acc ++ String.fromChar c
        )
        ""
        value


{-| `m/r:`'s match, for the patterns tmux's own bindings use: literal
text with one group of alternatives (`(copy|view)-mode`), found anywhere
in the text. -}
matches : String -> String -> Bool
matches pattern text =
    let
        alternatives =
            when String.firstIndexOf "(" pattern is
                Just open ->
                    when String.firstIndexOf ")" pattern is
                        Just close ->
                            String.slice (open + 1) close pattern
                                |> String.split "|"
                                |> Array.map (\a -> String.takeFirst open pattern ++ a ++ String.dropFirst (close + 1) pattern)

                        Nothing ->
                            [ pattern ]

                Nothing ->
                    [ pattern ]
    in
    Array.any (\a -> String.contains a text) alternatives


{-| tmux's one-letter aliases (`#W` for `#{window_name}`). -}
aliasOf : Char -> Maybe String
aliasOf c =
    when c is
        'D' ->
            Just "pane_id"

        'F' ->
            Just "window_flags"

        'H' ->
            Just "host"

        'h' ->
            Just "host_short"

        'I' ->
            Just "window_index"

        'P' ->
            Just "pane_index"

        'S' ->
            Just "session_name"

        'T' ->
            Just "pane_title"

        'W' ->
            Just "window_name"

        _ ->
            Nothing


{-| A text split at its commas outside `#{…}`. -}
topLevel : String -> Array String
topLevel text =
    let
        done =
            String.toArray text
                |> Array.foldl
                    (\c acc ->
                        if c == ',' && acc.depth == 0 then
                            { acc | parts = Array.pushLast acc.current acc.parts, current = "" }

                        else
                            { acc
                                | current = acc.current ++ String.fromChar c
                                , depth =
                                    if c == '{' then
                                        acc.depth + 1

                                    else if c == '}' then
                                        acc.depth - 1

                                    else
                                        acc.depth
                            }
                    )
                    { parts = [], current = "", depth = 0 }
    in
    Array.pushLast done.current done.parts
