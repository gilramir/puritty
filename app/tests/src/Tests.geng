module Tests exposing (main)

{-| The application's unit tests (`docs/settings.md` ST17), with
gren-unit-node: the settings' table and its lenient decoder. Run with
`./run.sh`. `Platform` is `app/linux`'s.
-}

import Config
import Expect exposing (Expectation)
import Hosts
import Node
import Schema
import Screen
import SettingsWindow
import Task exposing (Task)
import Test.Runner.UnitNode as U
import Toml


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                U.run env
                    { name = "puritty-app"
                    , version = "0.1.0"
                    , suites = [ schema, writing, window, hosts ]
                    }
            )


run : String -> Array { name : String, test : {} -> Expectation } -> U.Suite
run name tests =
    U.suite
        { name = name
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests = Array.map (\c -> U.test c.name (\fix -> Task.succeed (c.test fix))) tests
        }


{-| What a file's reports say, as `line: message`, or why it is not TOML. -}
reported : String -> Array String
reported text =
    when Schema.decode text is
        Ok d ->
            Array.map (\r -> String.fromInt r.line ++ ": " ++ r.message) d.reports

        Err r ->
            [ "not TOML at " ++ String.fromInt r.line ]


decoded : String -> Config.Config
decoded text =
    when Schema.decode text is
        Ok d ->
            d.config

        Err _ ->
            Config.defaults


schema : U.Suite
schema =
    run "Schema"
        [ { name = "an empty file is the defaults"
          , test = \_ -> Expect.equal { config = Config.defaults, reports = [] } (Result.withDefault { config = Config.defaults, reports = [ { line = 0, message = "not TOML" } ] } (Schema.decode ""))
          }
        , { name = "the example decodes with nothing reported"
          , test = \_ -> Expect.equal [] (reported Schema.example)
          }
        , { name = "the example names every setting, in its table"
          , test =
                \_ ->
                    let
                        missing =
                            Schema.settings
                                |> Array.keepIf
                                    (\s ->
                                        when s.key is
                                            [ table, name ] ->
                                                not (String.contains ("[" ++ table ++ "]") Schema.example && String.contains ("\n" ++ name ++ " = ") Schema.example)

                                            [ name ] ->
                                                -- a key outside any table comes first
                                                not (String.startsWith (name ++ " = ") Schema.example)

                                            _ ->
                                                True
                                    )
                                |> Array.map Schema.keyName
                    in
                    Expect.equal [] missing
          }
        , { name = "the example's values are read"
          , test =
                \_ ->
                    let
                        c =
                            decoded Schema.example
                    in
                    Expect.equal
                        { palette = [ 0x1D1F21, 0xCC6666 ], command = [ "htop" ], charset = Just "euc-kr", language = Just "ja", pasteButton = 3, osc52Read = False, title = "puritty" }
                        { palette = c.palette, command = c.command, charset = c.charset, language = c.language, pasteButton = c.pasteButton, osc52Read = c.osc52Read, title = c.title }
          }
        , { name = "every key is in one table and no two settings share one"
          , test =
                \_ ->
                    let
                        names =
                            Array.map Schema.keyName Schema.settings
                    in
                    Expect.equal (Array.length names) (Array.length (Array.foldl (\n acc -> if Array.member n acc then acc else Array.pushLast n acc) [] names))
          }
        , { name = "the example's host is read whole"
          , test =
                \_ ->
                    Expect.equal
                        [ { name = "build-box", host = "build.example.com", user = Just "gilbert", port = Just 2222, identity = Just "~/.ssh/id_ed25519", jump = Just "bastion.example.com", command = Just "tmux new -A -s main", foreground = Nothing, background = Just 0x2A1010, palette = Nothing, font = Nothing, points = Just 13, charset = Just "euc-kr", title = Just "build" } ]
                        (decoded Schema.example).hosts
          }
        , { name = "a host with no host is reported and left out"
          , test =
                \_ ->
                    Expect.equal { reports = [ "1: hosts.box has no host = \"…\", where to connect; it is left out" ], hosts = 0 }
                        { reports = reported "[hosts.box]\nuser = \"me\"\n", hosts = Array.length (decoded "[hosts.box]\nuser = \"me\"\n").hosts }
          }
        , { name = "a host's misspelt key is reported, with the nearest"
          , test = \_ -> Expect.equal [ "3: hosts.box.usr is not a host's setting; did you mean user?" ] (reported "[hosts.box]\nhost = \"h\"\nusr = \"me\"\n")
          }
        , { name = "a host's port out of range is reported and left out"
          , test =
                \_ ->
                    Expect.equal { reports = [ "3: hosts.box.port: 70000 is not from 1 to 65535; it is left out" ], port = [ Nothing ] }
                        { reports = reported "[hosts.box]\nhost = \"h\"\nport = 70000\n", port = Array.map .port (decoded "[hosts.box]\nhost = \"h\"\nport = 70000\n").hosts }
          }
        , { name = "a host's name may hold a space"
          , test = \_ -> Expect.equal [ "my box" ] (Array.map .name (decoded "[hosts.\"my box\"]\nhost = \"h\"\n").hosts)
          }
        , { name = "start takes shell, hosts or host:NAME"
          , test =
                \_ ->
                    Expect.equal { reports = [ "1: start: \"ssh\" is not \"shell\", \"hosts\" or \"host:\" and a host's name; \"shell\" is used" ], start = "host:box" }
                        { reports = reported "start = \"ssh\"\n", start = (decoded "start = \"host:box\"\n").start }
          }
        , { name = "a misspelt key is reported at its line, with the nearest setting"
          , test = \_ -> Expect.equal [ "3: font.sise is not a setting; did you mean font.size?" ] (reported "[font]\nfamily = \"x\"\nsise = 12\n")
          }
        , { name = "the rest of the file is read past a misspelt key"
          , test = \_ -> Expect.equal "x" (decoded "[font]\nfamily = \"x\"\nsise = 12\n").font
          }
        , { name = "a key with nothing near it is reported without a guess"
          , test = \_ -> Expect.equal [ "2: font.weight_of_glyphs is not a setting" ] (reported "[font]\nweight_of_glyphs = 1\n")
          }
        , { name = "a misspelt table is reported at its header, with the nearest"
          , test = \_ -> Expect.equal [ "1: [fonts] is not a table of settings; did you mean [font]?" ] (reported "[fonts]\nsize = 12\n")
          }
        , { name = "a value out of bounds is reported, and the default used"
          , test =
                \_ ->
                    Expect.equal { reports = [ "2: font.size: 2 is not from 4 to 200; 11 is used" ], points = 11 }
                        { reports = reported "[font]\nsize = 2\n", points = (decoded "[font]\nsize = 2\n").points }
          }
        , { name = "a value of the wrong kind is reported"
          , test = \_ -> Expect.equal [ "2: colours.background: not a string; \"#1d1f21\" is used" ] (reported "[colours]\nbackground = 12\n")
          }
        , { name = "a colour that is not #rrggbb is reported"
          , test = \_ -> Expect.equal [ "2: colours.foreground: \"#fff\" is not a colour as #rrggbb; \"#c5c8c6\" is used" ] (reported "[colours]\nforeground = \"#fff\"\n")
          }
        , { name = "a choice not among a setting's is reported with them"
          , test = \_ -> Expect.equal [ "2: mouse.paste_button: \"left\" is not \"middle\" or \"right\"; \"middle\" is used" ] (reported "[mouse]\npaste_button = \"left\"\n")
          }
        , { name = "a palette longer than 16 is reported"
          , test =
                \_ ->
                    Expect.equal [ "2: colours.palette: 17 colours, where the palette has 16; [] is used" ]
                        (reported ("[colours]\npalette = [" ++ String.join ", " (Array.repeat 17 "\"#000000\"") ++ "]\n"))
          }
        , { name = "a line after a value that runs on is counted"
          , test = \_ -> Expect.equal [ "6: colours.forground is not a setting; did you mean colours.foreground?" ] (reported "[colours]\npalette = [\n  \"#000000\",\n  \"#111111\",\n]\nforground = \"#ffffff\"\n")
          }
        , { name = "several reports come in the order of the file"
          , test = \_ -> Expect.equal [ "2: window.colums is not a setting; did you mean window.columns?", "4: font.size: 300 is not from 4 to 200; 11 is used" ] (reported "[window]\ncolums = 80\n[font]\nsize = 300\n")
          }
        , { name = "a file that is not TOML is refused, with its line"
          , test = \_ -> Expect.equal [ "not TOML at 2" ] (reported "[font]\nsize = = 3\n")
          }
        , { name = "an optional setting left out is unset"
          , test = \_ -> Expect.equal Nothing (decoded "[font]\nsize = 12\n").charset
          }
        , { name = "each setting reads back what it was set to"
          , test =
                \_ ->
                    let
                        wrong =
                            Schema.settings
                                |> Array.keepIf (\s -> s.get (s.set (s.get Config.defaults) Config.defaults) /= s.get Config.defaults)
                                |> Array.map Schema.keyName
                    in
                    Expect.equal [] wrong
          }
        ]


{-| A file as a user keeps it, comments and all. -}
sample : String
sample =
    """
    # My puritty settings

    [window]
    columns = 100   # wide
    rows = 0x1E     # thirty, in hex
    title = "work"

    # fonts
    [font]
    family = "Fira Code"
    """
        -- a file ends its last line; Gren's multi-line string does not
        ++ "\n"


{-| The file after writing each setting and value in turn. -}
written : String -> Array { key : Array String, value : Schema.Value } -> String
written text changes =
    when Toml.parse text is
        Ok doc ->
            Array.foldl
                (\c d ->
                    when Schema.find c.key is
                        Just s ->
                            Schema.write s c.value d

                        Nothing ->
                            d
                )
                doc
                changes
                |> Toml.toString

        Err _ ->
            "not TOML"


{-| A value of a setting's kind other than its default. -}
another : Schema.Setting -> Schema.Value
another s =
    when s.kind is
        Schema.WholeIn r ->
            Schema.Whole (if r.low == 0 then 1 else r.low)

        Schema.AnyText ->
            Schema.Text "something else"

        Schema.FontFamily ->
            Schema.Text "Some Font"

        Schema.OnOff ->
            Schema.Flag (s.get Config.defaults /= Schema.Flag True)

        Schema.OneColour ->
            Schema.Colour 0x123456

        Schema.ColourList _ ->
            Schema.Colours [ 0x010203, 0xFFFEFD ]

        Schema.OneOf names ->
            Schema.Text (Maybe.withDefault "" (Array.last names))

        Schema.Command ->
            Schema.Words [ "vim", "-O", "a b.txt" ]

        Schema.Launch ->
            Schema.Text "hosts"


writing : U.Suite
writing =
    run "Writing"
        [ { name = "a setting written as it is changes no byte"
          , test = \_ -> Expect.equal sample (written sample [ { key = [ "window", "columns" ], value = Schema.Whole 100 } ])
          }
        , { name = "a value the file writes another way is kept as it writes it"
          , test = \_ -> Expect.equal sample (written sample [ { key = [ "window", "rows" ], value = Schema.Whole 30 } ])
          }
        , { name = "a setting set and then reset gives the file back"
          , test =
                \_ ->
                    Expect.equal sample
                        (written sample [ { key = [ "font", "size" ], value = Schema.Whole 14 }, { key = [ "font", "size" ], value = Schema.Whole 11 } ])
          }
        , { name = "a setting in a table the file lacks, set and reset, gives the file back"
          , test =
                \_ ->
                    Expect.equal sample
                        (written sample [ { key = [ "colours", "background" ], value = Schema.Colour 0x102030 }, { key = [ "colours", "background" ], value = Schema.Colour 0x1D1F21 } ])
          }
        , { name = "a setting set is read back from the file"
          , test =
                \_ ->
                    Expect.equal { size = 14, columns = 100, family = "Fira Code" }
                        (let
                            c =
                                decoded (written sample [ { key = [ "font", "size" ], value = Schema.Whole 14 } ])
                         in
                         { size = c.points, columns = c.columns, family = c.font }
                        )
          }
        , { name = "a reset takes the key and its comment out, and keeps the table's others"
          , test =
                \_ ->
                    Expect.equal
                        (String.replace "columns = 100   # wide\n" "" sample)
                        (written sample [ { key = [ "window", "columns" ], value = Schema.Whole 80 } ])
          }
        , { name = "a table emptied by a reset goes"
          , test = \_ -> Expect.equal "" (written "[font]\nsize = 14\n" [ { key = [ "font", "size" ], value = Schema.Whole 11 } ])
          }
        , { name = "a table emptied by a reset stays when a comment is over its header"
          , test =
                \_ ->
                    Expect.equal "# kept by hand\n[font]\n"
                        (written "# kept by hand\n[font]\nsize = 14 # mine\n" [ { key = [ "font", "size" ], value = Schema.Whole 11 } ])
          }
        , { name = "an optional setting unset is taken out"
          , test =
                \_ ->
                    Expect.equal "[font]\nsize = 14\n"
                        (written "[font]\nsize = 14\nlanguage = \"ja\"\n" [ { key = [ "font", "language" ], value = Schema.Unset } ])
          }
        , { name = "every setting written to an empty file is read back as written"
          , test =
                \_ ->
                    let
                        wrong =
                            Schema.settings
                                |> Array.keepIf
                                    (\s ->
                                        let
                                            v =
                                                another s
                                        in
                                        s.get (decoded (written "" [ { key = s.key, value = v } ])) /= v
                                    )
                                |> Array.map Schema.keyName
                    in
                    Expect.equal [] wrong
          }
        , { name = "every setting written to an empty file is reported for nothing"
          , test =
                \_ ->
                    Expect.equal []
                        (Array.mapAndKeepJust
                            (\s ->
                                when reported (written "" [ { key = s.key, value = another s } ]) is
                                    [] ->
                                        Nothing

                                    r ->
                                        Just (Schema.keyName s ++ ": " ++ String.join "; " r)
                            )
                            Schema.settings
                        )
          }
        ]


opened : SettingsWindow.Model
opened =
    SettingsWindow.init { config = Config.defaults, path = "config.toml", reports = [], cols = 100, rows = 24, fonts = [ "DejaVu Sans Mono", "Fira Code", "Fira Mono", "Noto Sans Mono" ], aliases = [], launcher = False }


press : Int -> SettingsWindow.Input
press sym =
    SettingsWindow.Key { sym = sym, mods = 0, text = "" }


typeIn : String -> Array SettingsWindow.Input
typeIn text =
    Array.map (\c -> SettingsWindow.Key { sym = Char.toCode c, mods = 0, text = String.fromChar c }) (String.toArray text)


ctrl : Char -> SettingsWindow.Input
ctrl c =
    SettingsWindow.Key { sym = Char.toCode c, mods = 2, text = "" }


k =
    { enter = press 0xFF0D, escape = press 0xFF1B, tab = press 0xFF09, down = press 0xFF54, up = press 0xFF52, backspace = press 0xFF08, delete = press 0xFFFF, left = press 0xFF51 }


{-| Effects as text: `font.size = 114`, `close`. -}
said : Array SettingsWindow.Effect -> Array String
said effects =
    Array.map
        (\e ->
            when e is
                SettingsWindow.Write w ->
                    Schema.keyName w.setting ++ " = " ++ (when w.value is
                        Schema.Unset ->
                            "(unset)"

                        v ->
                            Schema.toText v
                    )

                SettingsWindow.Close ->
                    "close"

                SettingsWindow.ConnectHost name ->
                    "connect " ++ name

                SettingsWindow.ConnectQuick target ->
                    "connect to " ++ target
        )
        effects


after : Array SettingsWindow.Input -> { screen : Array String, said : Array String, model : SettingsWindow.Model }
after inputs =
    let
        r =
            Screen.feedInputs inputs opened
    in
    { screen = Screen.screenOf r.model, said = said r.effects, model = r.model }


{-| The window with the example's host and an alias of ~/.ssh/config, on
the Hosts page (the host list opens there; the settings window is taken
there by its pages), after these inputs. -}
onHostsPage : Bool -> Array SettingsWindow.Input -> { screen : Array String, said : Array String, model : SettingsWindow.Model }
onHostsPage launcher inputs =
    let
        start =
            SettingsWindow.init { config = decoded Schema.example, path = "config.toml", reports = [], cols = 100, rows = 24, fonts = [], aliases = [ "work", "build-box" ], launcher = launcher }

        toPage =
            if launcher then [] else [ k.tab, k.tab ] ++ Array.repeat 7 k.down ++ [ press 0xFF53 ]

        r =
            Screen.feedInputs (toPage ++ inputs) start
    in
    { screen = Screen.screenOf r.model, said = said r.effects, model = r.model }


lastRow : Array String -> String
lastRow rows =
    Maybe.withDefault "" (Array.last rows)


window : U.Suite
window =
    run "SettingsWindow"
        [ { name = "the first screen: the search, the pages, Appearance's settings, the focused key"
          , test =
                \_ ->
                    let
                        rows =
                            Screen.screenOf opened
                    in
                    Expect.equal
                        { top = "Search:                                                                            Modified only [ ]"
                        , first = "Appearance            │   Font                        DejaVu Sans Mono"
                        , colour = "Advanced              │   Foreground                  #c5c8c6 ██"
                        , foot = "font.family · Enter change · Del reset · Ctrl+Z undo · Ctrl+M modified only · Esc close"
                        , count = 24
                        }
                        { top = Maybe.withDefault "" (Array.get 0 rows)
                        , first = Maybe.withDefault "" (Array.get 2 rows)
                        , colour = Maybe.withDefault "" (Array.get 8 rows)
                        , foot = lastRow rows
                        , count = Array.length rows
                        }
          }
        , { name = "Down moves to the next setting"
          , test = \_ -> Expect.equal True (String.startsWith "font.size · " (lastRow (after [ k.down ]).screen))
          }
        , { name = "a number typed is written while it is one the setting takes"
          , test =
                \_ ->
                    -- 114, then 11 on the way back, which the setting takes too;
                    -- 1 is too small and is not written
                    Expect.equal [ "font.size = 114", "font.size = 11", "font.size = 13" ]
                        (after ([ k.down, k.enter ] ++ typeIn "4" ++ [ k.backspace, k.backspace ] ++ typeIn "3" ++ [ k.enter ])).said
          }
        , { name = "a number the setting does not take is shown as a problem and not written"
          , test =
                \_ ->
                    let
                        r =
                            after ([ k.down, k.enter, k.backspace ] ++ typeIn "")
                    in
                    Expect.equal { said = [], foot = "1 is not from 4 to 200" } { said = r.said, foot = lastRow r.screen }
          }
        , { name = "Ctrl+Z undoes a change typed"
          , test =
                \_ ->
                    Expect.equal [ "font.size = 114", "font.size = 11", "font.size = 13", "font.size = 11" ]
                        (after ([ k.down, k.enter ] ++ typeIn "4" ++ [ k.backspace, k.backspace ] ++ typeIn "3" ++ [ k.enter, ctrl 'z' ])).said
          }
        , { name = "Esc while typing puts back what was there"
          , test = \_ -> Expect.equal [ "font.size = 114", "font.size = 11" ] (after ([ k.down, k.enter ] ++ typeIn "4" ++ [ k.escape ])).said
          }
        , { name = "Enter turns a setting on or off, and it is marked as changed"
          , test =
                \_ ->
                    let
                        r =
                            after [ k.down, k.down, k.down, k.down, k.enter ]
                    in
                    Expect.equal { said = [ "colours.bold_is_bright = true" ], marked = True }
                        { said = r.said, marked = Array.any (\row -> String.contains "● Bold is bright" row && String.contains "[x] on  ⟲" row) r.screen }
          }
        , { name = "Delete resets a setting to its default"
          , test = \_ -> Expect.equal [ "colours.bold_is_bright = true", "colours.bold_is_bright = false" ] (after [ k.down, k.down, k.down, k.down, k.enter, k.delete ]).said
          }
        , { name = "a search lists the matches of every page, and the pages count them"
          , test =
                \_ ->
                    let
                        r =
                            after ([ ctrl 'f' ] ++ typeIn "euc")
                    in
                    Expect.equal
                        { search = "Search: euc", first = "Appearance            │   Character set               the system's", count = "Text & language    (1)│", rest = "                      │" }
                        { search = String.takeFirst 11 (Maybe.withDefault "" (Array.get 0 r.screen))
                        , first = Maybe.withDefault "" (Array.get 2 r.screen)
                        , count = Maybe.withDefault "" (Array.get 4 r.screen)
                        , rest = Maybe.withDefault "" (Array.get 12 r.screen)
                        }
          }
        , { name = "Enter goes round a choice, the system's among them for an optional one"
          , test =
                \_ ->
                    Expect.equal [ "terminal.charset = utf-8", "terminal.charset = euc-kr", "terminal.charset = cp949", "terminal.charset = (unset)" ]
                        (after ([ ctrl 'f' ] ++ typeIn "euc" ++ [ k.down, k.enter, k.enter, k.enter, k.enter ])).said
          }
        , { name = "Modified only, with nothing changed, says so"
          , test = \_ -> Expect.equal True (Array.any (String.contains "Nothing here differs from its default.") (after [ ctrl 'm' ]).screen)
          }
        , { name = "Esc with nothing to stop closes the window"
          , test = \_ -> Expect.equal [ "close" ] (after [ k.escape ]).said
          }
        , { name = "text an input method commits is typed, and drawn two cells a character"
          , test =
                \_ ->
                    let
                        r =
                            after [ ctrl 'f', SettingsWindow.Typed "title", k.down, k.enter, k.backspace, k.backspace, k.backspace, k.backspace, k.backspace, k.backspace, k.backspace, SettingsWindow.Typed "한글", k.enter ]
                    in
                    Expect.equal { said = True, shown = [ "Appearance            │ ● Title                       한글  ⟲" ] }
                        { said = Array.member "window.title = 한글" r.said
                        , shown = Array.keepIf (String.contains "Title") r.screen
                        }
          }
        , { name = "a click on a page shows it"
          , test = \_ -> Expect.equal True (String.contains "Columns" (Maybe.withDefault "" (Array.get 2 (after [ SettingsWindow.Click { col = 3, row = 3 } ]).screen)))
          }
        , { name = "a font typed is offered the system's that hold its name"
          , test =
                \_ ->
                    let
                        r =
                            after ([ k.enter ] ++ Array.repeat 16 k.backspace ++ typeIn "fira")
                    in
                    Expect.equal { offered = [ "Window                │     Fira Code", "Text & language       │     Fira Mono" ], said = [] }
                        { offered = Array.keepIf (String.contains "     Fira") r.screen, said = r.said }
          }
        , { name = "a font is written when it is chosen, not as it is typed"
          , test = \_ -> Expect.equal [ "font.family = Fira Mono" ] (after ([ k.enter ] ++ Array.repeat 16 k.backspace ++ typeIn "fira" ++ [ k.down, k.down, k.enter ])).said
          }
        , { name = "a font's name typed with nothing chosen is taken as typed"
          , test = \_ -> Expect.equal [ "font.family = Some Font" ] (after ([ k.enter ] ++ Array.repeat 16 k.backspace ++ typeIn "Some Font" ++ [ k.enter ])).said
          }
        , { name = "the Hosts page lists quick connect, the file's hosts and ~/.ssh/config's"
          , test =
                \_ ->
                    let
                        rows =
                            (onHostsPage False []).screen
                    in
                    Expect.equal
                        [ "Quick connect               user@host:port"
                        , "build-box                   gilbert@build.example.com:2222"
                        , "through bastion.example.com · from the settings"
                        , "work                        as ~/.ssh/config has it"
                        , "from ~/.ssh/config"
                        ]
                        (Array.mapAndKeepJust (\r -> String.split "│" r |> Array.get 1 |> Maybe.map String.trim) rows |> Array.keepIf (\r -> r /= "" && not (String.startsWith "Connect without" r)) |> Array.takeFirst 5)
          }
        , { name = "Enter on a host connects to it"
          , test = \_ -> Expect.equal [ "connect build-box" ] (onHostsPage False [ k.down, k.enter ]).said
          }
        , { name = "quick connect connects to what is typed"
          , test = \_ -> Expect.equal [ "connect to me@h.example.com:22" ] (onHostsPage False ([ k.enter ] ++ typeIn "me@h.example.com:22" ++ [ k.enter ])).said
          }
        , { name = "quick connect refuses what is not user@host:port"
          , test =
                \_ ->
                    let
                        r =
                            onHostsPage False ([ k.enter ] ++ typeIn "me@" ++ [ k.enter ])
                    in
                    Expect.equal { said = [], foot = "\"me@\" is not where to connect, as user@host:port" } { said = r.said, foot = lastRow r.screen }
          }
        , { name = "the host list opens on the Hosts page, and connects there"
          , test = \_ -> Expect.equal True (String.startsWith "Enter connects here" (lastRow (onHostsPage True []).screen))
          }
        , { name = "a narrow window still draws every row"
          , test = \_ -> Expect.equal 24 (Array.length (after [ SettingsWindow.Resized { cols = 40, rows = 24 } ]).screen)
          }
        ]


hosts : U.Suite
hosts =
    let
        config =
            decoded Schema.example

        box =
            Hosts.named "build-box" config
    in
    run "Hosts"
        [ { name = "a host's command is OpenSSH's, with its port, user, key, jump and command"
          , test = \_ -> Expect.equal [ "ssh", "-p", "2222", "-l", "gilbert", "-i", "~/.ssh/id_ed25519", "-J", "bastion.example.com", "-t", "build.example.com", "tmux new -A -s main" ] (Hosts.sshCommand config box)
          }
        , { name = "a jump that names another host is that host's user@host:port"
          , test =
                \_ ->
                    let
                        c =
                            decoded "[hosts.bastion]\nhost = \"b.example.com\"\nuser = \"me\"\nport = 2200\n\n[hosts.inner]\nhost = \"10.0.0.5\"\njump = \"bastion\"\n"
                    in
                    Expect.equal [ "ssh", "-J", "me@b.example.com:2200", "10.0.0.5" ] (Hosts.sshCommand c (Hosts.named "inner" c))
          }
        , { name = "a name the settings do not have is ssh's to resolve, as an alias"
          , test = \_ -> Expect.equal [ "ssh", "work" ] (Hosts.sshCommand config (Hosts.named "work" config))
          }
        , { name = "quick connect reads user@host:port, each part left out as one likes"
          , test =
                \_ ->
                    Expect.equal
                        [ Just [ "ssh", "-p", "22", "-l", "me", "h.example.com" ], Just [ "ssh", "h" ], Just [ "ssh", "-l", "me", "h" ], Just [ "ssh", "-p", "2222", "::1" ], Nothing, Nothing ]
                        (Array.map (\t -> Hosts.quick t |> Maybe.map (Hosts.sshCommand config)) [ "me@h.example.com:22", "h", "me@h", "[::1]:2222", "me@", "h:port" ])
          }
        , { name = "a session takes the host's look, charset and title, and its name when it gives no title"
          , test =
                \_ ->
                    let
                        c =
                            Hosts.session config box

                        plain =
                            Hosts.session config (Hosts.named "work" config)
                    in
                    Expect.equal { background = 0x2A1010, points = 13, charset = Just "euc-kr", title = "build", plainTitle = "work", foreground = config.foreground }
                        { background = c.background, points = c.points, charset = c.charset, title = c.title, plainTitle = plain.title, foreground = c.foreground }
          }
        ]
