module Tests exposing (main)

{-| The application's unit tests on node; `AppSuites` says what they are,
and `native/` runs the same suites as a native program. Run with
`./run.sh`. On node, `TmuxMode` compiles against `stub/Window.geng`, the
two types of `Window`'s it uses (`docs/tmux.md` TM68).
-}

import AppSuites
import Node
import Task exposing (Task)
import Test.Runner.UnitNode.Program as Program


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                Program.run env
                    { name = "puritty-app"
                    , version = "0.1.0"
                    , suites = AppSuites.suites
                    }
            )
