                            else
                                Just "abc def"
                        }
                        { noBuffer = typedThen [], buffer = typedThen [ "hello w\u{00F6}rld\nsecond" ] }
          }
        , { name = "C-y with nothing cut puts in the newest buffer, as this tmux reads it (TM80)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        run =
                            attached { made | buffers = [ "hello w\u{00F6}rld\nsecond", "older" ] }
                                |> prefixThen ":"
                                |> typeText "x "
                                |> ctrl "y"
                                |> settle
                    in
