                                |> Array.findFirst (\r -> Array.length r.parts > 1)
                                |> Maybe.map (\found -> { row = found.value.row, col = String.count (Maybe.withDefault "" (Array.first found.value.parts)) + 1 })

                        clicked =
                            Maybe.map
                                (\c ->
                                    (TmuxMode.pointer { ms = 1000, held = 1, select = False, boundaries = [], pasteButton = 2 }
                                        { action = 0, button = 1, mods = 0, x = c.col * 10 + 5, y = c.row * 20 + 5, width = 800, height = 500, cellWidth = 10, cellHeight = 20 }
                                        seen.run.tmux
                                    ).commands
                                        |> Array.any (String.contains "resize-pane -Z")
                                )
                                at
                    in
                    Expect.equal
                        (if version == "3.8" then
                            Just True

                         else
                            Nothing
                        )
                        clicked
          }
        , { name = "a popup's -T title is given to its floating pane's box on 3.8 (TM82)"
