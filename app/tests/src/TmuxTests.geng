                            TmuxMode.setStart True (TmuxMode.idle {})

                        first =
                            TmuxMode.read { cols = 80, rows = 25 } FakeTmux.startBytes (always {})

                        -- read again, since `first` is looked at below
                        second =
                            TmuxMode.read { cols = 80, rows = 25 } FakeTmux.startBytes (always {})

                        expected =
                            TmuxMode.read { cols = 80, rows = 25 } FakeTmux.startBytes (TmuxMode.expectEntry True (TmuxMode.idle {}))

                        -- control mode ended, then entered again unasked
                        again =
                            TmuxMode.read { cols = 80, rows = 25 } (Bytes.fromString "%exit\u{000D}\n\u{001B}\\") second.state
                                |> .state
                                |> TmuxMode.read { cols = 80, rows = 25 } FakeTmux.startBytes
                    in
                    Expect.equal
