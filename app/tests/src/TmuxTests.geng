                        withEscape =
                            { made | options = Dict.set "status-left" "L\u{001B}(0qq\u{001B}(B" made.options }

                        seen =
                            look (settle (deliver FakeTmux.startBytes { tmux = TmuxMode.setLook True (TmuxMode.expectEntry True (TmuxMode.idle {})), world = withEscape, held = [], ms = 1000 }))

                        status =
