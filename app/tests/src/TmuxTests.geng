module TmuxTests exposing (tmuxMode)

{-| `TmuxMode` driven by `FakeTmux` (`docs/tmux.md` TM68): tmux's bytes
delivered, keys typed, replies held back or let through, and the screen
puritty draws read as rows of text. -}

import Bytes exposing (Bytes)
import Dict
import Expect exposing (Expectation)
import FakeTmux exposing (World)
import RealTmux
import Task
import Test.Runner.UnitNode as U
import Tmux.Syntax as Syntax
import TmuxMode
import Vt


{-| A session in progress: puritty's state, the fake server, the command
lines puritty has sent and tmux has not answered yet, and the clock. -}
type alias Run =
    { tmux : TmuxMode.State
    , world : World
    , held : Array String
    , ms : Int
    }


{-| puritty's window: the tmux window and one row for the tab bar. -}
size : World -> { cols : Int, rows : Int }
size w =
    { cols = w.cols, rows = w.rows + 1 }


{-| tmux's bytes read by puritty; what it sends back is held. -}
deliver : Bytes -> (taken run : Run) -> Run
deliver bytes run =
    let
        sized =
            size run.world

        held =
            run.held

        r =
            TmuxMode.read sized bytes run.tmux
    in
    { run | tmux = r.state, held = held ++ r.commands }


{-| Every held command answered, and what that makes puritty send, until
it sends nothing more (at most `n` rounds). -}
settle : (taken run : Run) -> Run
settle run =
    settleUpTo 200 run


settleUpTo : Int -> (taken run : Run) -> Run
settleUpTo n run =
    when Array.popFirst run.held is
        Just { first, rest } ->
            if n <= 0 then
                run

            else
                let
                    answered =
                        FakeTmux.answer first run.world
                in
                settleUpTo (n - 1) (deliver answered.bytes { run | world = answered.world, held = rest })

        Nothing ->
            run


{-| A session attached to `w` and settled. -}
attached : World -> Run
attached w =
    settle (deliver FakeTmux.startBytes { tmux = TmuxMode.idle {}, world = w, held = [], ms = 1000 })


{-| A key with a letter on it (`k`), typed. -}
typeKey : String -> (taken run : Run) -> Run
typeKey letter run =
    let
        sym =
            String.toArray letter |> Array.first |> Maybe.map Char.toCode |> Maybe.withDefault 0
    in
    press { mods = 0, sym = sym, unshifted = sym, text = Bytes.fromString letter } run


{-| A letter typed with Ctrl held (`C-b`, tmux's prefix): its control
character is the text, as the window gives it. -}
ctrl : String -> (taken run : Run) -> Run
ctrl letter run =
    let
        code =
            String.toArray letter |> Array.first |> Maybe.map Char.toCode |> Maybe.withDefault 0

        control =
            Char.fromCode (code - 0x60) |> Maybe.map String.fromChar |> Maybe.withDefault ""
    in
    press { mods = 2, sym = code, unshifted = code, text = Bytes.fromString control } run


{-| A key with a name and no text (Enter, Escape, the arrows), by its X
keysym, typed. -}
named : Int -> (taken run : Run) -> Run
named sym run =
    press
        { mods = 0
        , sym = sym
        , unshifted = sym
        , text =
            Bytes.fromString
                (if sym == enterKey then
                    "\u{000D}"

                 else if sym == escapeKey then
                    "\u{001B}"

                 else if sym == tabKey then
                    "\t"

                 else if sym == upKey then
                    -- an arrow's bytes, as the window gives them
                    "\u{001B}[A"

                 else
                    ""
                )
        }
        run


enterKey : Int
enterKey =
    0xFF0D


escapeKey : Int
escapeKey =
    0xFF1B


downKey : Int
downKey =
    0xFF54


upKey : Int
upKey =
    0xFF52


tabKey : Int
tabKey =
    0xFF09


{-| A button pressed on a cell, at a time, and what it makes puritty send
held: 1 the left, 2 the right, 4 and 5 the wheel. -}
clickAt : Int -> { col : Int, row : Int } -> Int -> (taken run : Run) -> Run
clickAt button c ms run =
    let
        held =
            run.held

        r =
            TmuxMode.pointer { ms = ms, held = 1, select = False, boundaries = [], pasteButton = 3 }
                { action = 0, button = button, mods = 0, x = c.col * 10 + 5, y = c.row * 20 + 5, width = 800, height = 500, cellWidth = 10, cellHeight = 20 }
                run.tmux
    in
    { run | tmux = r.state, held = held ++ r.commands }


{-| Text typed a character at a time. -}
typeText : String -> Run -> Run
typeText text run =
    String.foldl (\c r -> typeKey (String.fromChar c) r) run text


{-| A key typed, and what it makes puritty send held. -}
press : { mods : Int, sym : Int, unshifted : Int, text : Bytes } -> (taken run : Run) -> Run
press k run =
    let
        ms =
            run.ms

        held =
            run.held

        r =
            TmuxMode.typed { action = 1, keycode = 0, mods = k.mods, consumed = 0, unshifted = k.unshifted, sym = k.sym, text = k.text } k.text ms run.tmux
    in
    { run | tmux = r.state, held = held ++ r.commands, ms = ms + 30 }


{-| Keys typed, each answered before the next: `C-b`, then `s`. -}
prefixThen : String -> (taken run : Run) -> Run
prefixThen letter run =
    settle (typeKey letter (settle (ctrl "b" run)))


{-| The pane put in copy mode by tmux (as `prefix [` does), and settled. -}
inCopyMode : Int -> (taken run : Run) -> Run
inCopyMode pane run =
    let
        e =
            FakeTmux.enterCopy pane run.world
    in
    settle (deliver (Bytes.fromString (String.join "" (Array.map (\n -> n ++ "\u{000D}\n") e.notices))) { run | world = e.world })


{-| The screen puritty draws, each row's text without its trailing blanks,
and the run, painted. -}
look : (taken run : Run) -> { run : Run, rows : Array String }
look run =
    let
        painted =
            TmuxMode.paint run.tmux

        top =
            Vt.rowsPushed painted.canvas

        rows =
            Array.range 0 (painted.canvas.rows - 1)
                |> Array.map (\r -> Vt.selectionText { row = top + r, col = 0 } { row = top + r, col = painted.canvas.cols - 1 } painted.canvas |> String.trimRight)
    in
    { run = { run | tmux = painted }, rows = rows }


row : Int -> { run : Run, rows : Array String } -> String
row i seen =
    Maybe.withDefault "" (Array.get i seen.rows)


{-| A row as its text and what sits at its right edge, the run of spaces
between dropped: `{ text = "line 170", edge = "[7/176]" }`. -}
split : Int -> { run : Run, rows : Array String } -> { text : String, edge : String }
split i seen =
    let
        line =
            row i seen
    in
    when String.firstIndexOf "    " line is
        Just at ->
            { text = String.takeFirst at line, edge = String.trim (String.dropFirst at line) }

        Nothing ->
            { text = line, edge = "" }


numbered : Int -> Array String
numbered n =
    Array.range 1 n |> Array.map (\i -> "line " ++ String.fromInt i)


tmuxMode : U.Suite
tmuxMode =
    U.suite
        { name = "TmuxMode"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            Array.map (\c -> U.test c.name (\_ -> Task.succeed (c.test {})))
                ([ { name = "the fake answers as the real tmuxes do, in every recorded state (TM68)"
                   , test = \_ -> Expect.equal [] fakeDiffers
                   }
                 , { name = "every question puritty asks in the scenarios is recorded from a real tmux (TM69)"
                   , test = \_ -> Expect.equal "" unrecorded
                   }
                 , { name = "no question puritty asks tmux 2.7 tests a bare name it does not have, which 2.7 takes as true (TV10)"
                   , test = \_ -> Expect.equal [] (bareConditions "2.7" (askedOn "2.7" |> Array.map .command))
                   }
                 , { name = "a mistyped command ends control mode with tmux's message on the terminal, and nothing asked (TM70)"
                   , test =
                        \_ ->
                            -- as tmux 3.8 and 3.6a answer `tmux -CC attacth-t main`
                            Expect.equal
                                { said = "unknown command: attacth-t\u{000D}\n", asked = [] }
                                (failedStart "\u{001B}P1000punknown command: attacth-t\u{000D}\n%exit\u{000D}\n\u{001B}\\")
                   }
                 , { name = "an attach that fails ends control mode with tmux's error on the terminal, and nothing asked (TM70)"
                   , test =
                        \_ ->
                            -- as tmux answers `tmux -CC attach` with no server
                            Expect.equal
                                { said = "no sessions\u{000D}\n", asked = [] }
                                (failedStart "\u{001B}P1000p%begin 1794605254 322 0\u{000D}\nno sessions\u{000D}\n%error 1794605254 322 0\u{000D}\n%exit\u{000D}\n\u{001B}\\")
                   }
                 ]
                    ++ Array.flatten (Array.map onVersion RealTmux.versions)
                )
        }


{-| The tests that drive puritty, on one tmux version's fake. -}
onVersion : String -> Array { name : String, test : {} -> Expectation }
onVersion version =
    Array.map (\c -> { c | name = c.name ++ ", tmux " ++ version })
        [ { name = "attaching asks for nothing the fake does not know, and draws the pane"
          , test =
                \_ ->
                    let
                        seen =
                            look (attached (start version))
                    in
                    Expect.equal
                        { unknown = [], first = "line 177", last = "line 200" }
                        { unknown = seen.run.world.unknown, first = row 0 seen, last = row 23 seen }
          }
        , { name = "copy mode scrolled by k shows the lines tmux scrolled to (TM31)"
          , test =
                \_ ->
                    let
                        seen =
                            attached (start version)
                                |> inCopyMode 0
                                |> keys 30
                                |> look
                    in
                    -- copy mode's position at the top right, as tmux's
                    -- `[scroll/history]`
                    Expect.equal
                        { scroll = 7, top = { text = "line 170", edge = timed version "[7/176]" } }
                        { scroll = (FakeTmux.copyState 0 seen.run.world).scroll, top = split 0 seen }
          }
        , { name = "the wheel over a pane in copy mode scrolls copy mode, and sends its program nothing, mouse or not (review TB1, TM107)"
          , test =
                \_ ->
                    let
                        -- the pane's program asked for the mouse, or is on the
                        -- alternate screen, then copy mode, then the wheel up
                        wheeled modes =
                            attached (start version)
                                |> deliver (Bytes.fromString ("%output %0 " ++ modes ++ "\u{000D}\n"))
                                |> settle
                                |> inCopyMode 0
                                |> clickAt 4 { col = 5, row = 5 } 2000
                                |> settle

                        -- copy mode's state, and whether bytes went to the
                        -- pane (`send-keys -H` or `-l`), which copy mode
                        -- would take as its keys
                        state run =
                            let
                                c =
                                    FakeTmux.copyState 0 run.world
                            in
                            { mode = c.mode, scroll = c.scroll, sent = Array.any (\l -> String.startsWith "send-keys" l && (String.contains " -H " l || String.contains " -l " l)) run.world.heard }
                    in
                    Expect.equal
                        { mouse = { mode = "copy-mode", scroll = 5, sent = False }, alternate = { mode = "copy-mode", scroll = 5, sent = False } }
                        { mouse = state (wheeled "\\033[?1000h\\033[?1006h")
                        , alternate = state (wheeled "\\033[?1049h")
                        }
          }
        , { name = "the tree of sessions shows the session, its windows and attachment, and q closes it (TM32)"
          , test =
                \_ ->
                    let
                        opened =
                            look (prefixThen "s" (attached (start version)))

                        row1 =
                            row 1 opened

                        title =
                            String.contains "choose a session" (row 0 opened)

                        session =
                            String.trim (String.slice 1 (String.count row1 - 1) row1)

                        closed =
                            look (settle (typeKey "q" opened.run))
                    in
                    Expect.equal
                        { title = True, session = "0  ▸ main: 1 windows (attached)", after = "line 177" }
                        { title = title, session = session, after = row 0 closed }
          }
        , { name = "the tree of windows opens the session and shows its window, flags and all (TM32)"
          , test =
                \_ ->
                    let
                        opened =
                            look (prefixThen "w" (attached (start version)))

                        inner r =
                            String.trim (String.slice 1 (String.count r - 1) r)
                    in
                    -- each tmux's own row (TM77): before 3.6 a window's
                    -- only pane is no row, so there is nothing to open;
                    -- before 3.2 its panes and title are written out
                    Expect.equal
                        [ "0  ▾ main: 1 windows (attached)"
                        , when version is
                            "2.7" ->
                                "1      0: sh* (1 panes) \"host\""

                            "3.0" ->
                                "1      0: sh* (1 panes) \"host\""

                            "3.2a" ->
                                "1      0: sh*"

                            "3.4" ->
                                "1      0: sh*"

                            _ ->
                                "1    ▸ 0: sh*"
                        ]
                        [ inner (row 1 opened), inner (row 2 opened) ]
          }
        , { name = "the command prompt runs what is typed as a tmux command (TM25)"
          , test =
                \_ ->
                    let
                        asked =
                            prefixThen ":" (attached (start version))

                        box =
                            TmuxMode.promptBox asked.tmux

                        typed =
                            typeText "kill-server -a" asked

                        shown =
                            TmuxMode.promptBox typed.tmux |> Maybe.map .typed

                        ran =
                            settle (named enterKey typed)
                    in
                    Expect.equal
                        { opened = True, shown = Just "kill-server -a", closed = True, sent = True }
                        { opened = box /= Nothing
                        , shown = shown
                        , closed = TmuxMode.promptBox ran.tmux == Nothing
                        , sent = Array.member "kill-server -a" ran.world.heard
                        }
          }
        , { name = "the window menu shows the items this tmux draws, and Rename asks with the window's name in the prompt (TM27)"
          , test =
                \_ ->
                    let
                        opened =
                            look (prefixThen "<" (attached (start version)))

                        items =
                            opened.rows
                                |> Array.keepIf (\r -> String.startsWith "│" r)
                                |> Array.map (\r -> String.trim (String.slice 1 (String.count r - 1) r))

                        renaming =
                            settle (typeKey "n" opened.run)

                        drawn =
                            drawnMenu version "<"
                    in
                    -- before 3.0 tmux has no menus, and n is typed to the pane
                    Expect.equal
                        { items = drawn
                        , prompt =
                            if Array.isEmpty drawn then
                                Nothing

                            else
                                Just "sh"
                        }
                        { items = items, prompt = TmuxMode.promptBox renaming.tmux |> Maybe.map .typed }
          }
        , { name = "a menu's -C chooses where the keyboard starts, and -O chooses on a press (TM84)"
          , test =
                \_ ->
                    let
                        opened line =
                            attached (start version)
                                |> prefixThen ":"
                                |> typeText line
                                |> named enterKey
                                |> settle

                        heardOf run =
                            run.world.heard |> Array.map (String.replace "'" "") |> Array.keepIf (\l -> l == "display-message -p A" || l == "display-message -p B")

                        -- Enter on the item -C starts at
                        started =
                            heardOf (settle (named enterKey (opened "display-menu -C 1 -T t a a { display-message -p A } b b { display-message -p B }")))

                        -- a press on the row of item b, with and without -O
                        pressed flag =
                            let
                                seen =
                                    look (opened ("display-menu " ++ flag ++ " -T t a a { display-message -p A } b b { display-message -p B }"))

                                at =
                                    seen.rows
                                        |> Array.indexedMap (\i r -> { row = i, parts = String.split " b " r })
                                        |> Array.findFirst (\r -> Array.length r.parts > 1)
                                        |> Maybe.map (\found -> { row = found.value.row, col = String.count (Maybe.withDefault "" (Array.first found.value.parts)) + 1 })
                            in
                            when at is
                                Just c ->
                                    (TmuxMode.pointer { ms = 1000, held = 1, select = False, boundaries = [], pasteButton = 2 }
                                        { action = 0, button = 1, mods = 0, x = c.col * 10 + 5, y = c.row * 20 + 5, width = 800, height = 500, cellWidth = 10, cellHeight = 20 }
                                        seen.run.tmux
                                    ).commands
                                        |> Array.map (String.replace "'" "")
                                        |> Array.keepIf (\l -> l == "display-message -p A" || l == "display-message -p B")

                                Nothing ->
                                    [ "no row b" ]
                    in
                    if Array.member version [ "2.7", "3.0", "3.2a" ] then
                        -- -C is 3.4's, and these tmuxes refuse it
                        Expect.pass

                    else
                        Expect.equal
                            { started = [ "display-message -p B" ], stayOpen = [ "display-message -p B" ], plain = [] }
                            { started = started, stayOpen = pressed "-O", plain = pressed "" }
          }
        , { name = "the mouse in choose-buffer: a press chooses a row, a double click pastes it, the wheel moves; the right button from 3.0 (TM86)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        -- buffer2 the newest, chosen first; each case opens its own
                        opening _ =
                            look (attached { made | buffers = [ "zero", "one", "two" ] } |> prefixThen "=" |> settle)

                        seen =
                            (opening {}).rows

                        rowOf name =
                            seen
                                |> Array.indexedMap (\i r -> { row = i, text = r })
                                |> Array.findFirst (\r -> String.contains (name ++ ":") r.text)
                                |> Maybe.map (\found -> { col = 10, row = found.value.row })
                                |> Maybe.withDefault { col = 0, row = 0 }

                        pasted run =
                            run.world.heard
                                |> Array.keepIf (String.contains "paste-buffer")
                                |> Array.map
                                    (\l ->
                                        if String.contains "buffer0" l then
                                            "buffer0"

                                        else if String.contains "buffer1" l then
                                            "buffer1"

                                        else if String.contains "buffer2" l then
                                            "buffer2"

                                        else
                                            l
                                    )

                        clicked =
                            pasted ((opening {}).run |> clickAt 1 (rowOf "buffer0") 2000 |> named enterKey |> settle)

                        doubled =
                            pasted ((opening {}).run |> clickAt 1 (rowOf "buffer1") 2000 |> clickAt 1 (rowOf "buffer1") 2200 |> settle)

                        wheeled =
                            pasted ((opening {}).run |> clickAt 5 (rowOf "buffer0") 2000 |> named enterKey |> settle)

                        -- the right button chooses the row and, from 3.0,
                        -- opens its menu (TM87), closed here before Enter
                        righted =
                            pasted ((opening {}).run |> clickAt 2 (rowOf "buffer0") 2000 |> ctrl "c" |> named enterKey |> settle)
                    in
                    Expect.equal
                        { clicked = [ "buffer0" ]
                        , doubled = [ "buffer1" ]
                        , wheeled = [ "buffer1" ]
                        , righted =
                            if version == "2.7" then
                                [ "buffer2" ]

                            else
                                [ "buffer0" ]
                        }
                        { clicked = clicked, doubled = doubled, wheeled = wheeled, righted = righted }
          }
        , { name = "the right button opens a mode's menu from 3.0; its item gives the mode its key (TM87)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        opening _ =
                            look (attached { made | buffers = [ "zero", "one", "two" ] } |> prefixThen "=" |> settle)

                        seen =
                            (opening {}).rows

                        rowOf name =
                            seen
                                |> Array.indexedMap (\i r -> { row = i, text = r })
                                |> Array.findFirst (\r -> String.contains (name ++ ":") r.text)
                                |> Maybe.map (\found -> { col = 10, row = found.value.row })
                                |> Maybe.withDefault { col = 0, row = 0 }

                        -- the right button on buffer0, then p: Paste, from the
                        -- menu; before 3.0 p reaches the list, buffer2 chosen
                        pasted =
                            (opening {}).run
                                |> clickAt 2 (rowOf "buffer0") 2000
                                |> typeKey "p"
                                |> settle
                                |> .world
                                |> .heard
                                |> Array.keepIf (String.contains "paste-buffer")
                                |> Array.map
                                    (\l ->
                                        if String.contains "buffer0" l then
                                            "buffer0"

                                        else if String.contains "buffer2" l then
                                            "buffer2"

                                        else
                                            l
                                    )

                        menuShown =
                            look ((opening {}).run |> clickAt 2 (rowOf "buffer0") 2000)
                                |> .rows
                                |> Array.any (String.contains "Delete Tagged")

                        -- the right button under the list, in the preview
                        outside =
                            look ((opening {}).run |> clickAt 2 { col = 30, row = 20 } 2000)
                                |> .rows
                                |> Array.any (String.contains "Scroll Right")
                    in
                    Expect.equal
                        (if version == "2.7" then
                            { pasted = [ "buffer2" ], menuShown = False, outside = False }

                         else
                            { pasted = [ "buffer0" ], menuShown = True, outside = True }
                        )
                        { pasted = pasted, menuShown = menuShown, outside = outside }
          }
        , { name = "a double click on the tree's row does what its keys do (TM86)"
          , test =
                \_ ->
                    let
                        opening _ =
                            look (settle (prefixThen "w" (attached (start version))))

                        sessionRow =
                            (opening {}).rows
                                |> Array.indexedMap (\i r -> { row = i, text = r })
                                |> Array.findFirst (\r -> String.contains "main:" r.text)
                                |> Maybe.map (\found -> { col = 12, row = found.value.row })
                                |> Maybe.withDefault { col = 0, row = 0 }

                        chose run =
                            run.world.heard |> Array.keepIf (String.contains "switch-client")

                        byMouse =
                            chose ((opening {}).run |> clickAt 1 sessionRow 2000 |> clickAt 1 sessionRow 2300 |> settle)

                        byKeys =
                            chose ((opening {}).run |> typeKey "g" |> named enterKey |> settle)
                    in
                    Expect.equal { same = True, session = True } { same = byMouse == byKeys, session = Array.any (String.contains "'$0'") byMouse }
          }
        , { name = "a press on a window in the tree's preview chooses it, as window_tree_mouse (TM86)"
          , test =
                \_ ->
                    let
                        opening _ =
                            look (settle (prefixThen "s" (attached (start version))))

                        -- inside the preview's box, two rows under its top
                        inPreview =
                            (opening {}).rows
                                |> Array.indexedMap (\i r -> { row = i, text = r })
                                |> Array.findFirst (\r -> String.contains "┌" r.text)
                                |> Maybe.map (\found -> { col = 20, row = found.value.row + 2 })

                        chose =
                            Maybe.map (\c -> (opening {}).run |> clickAt 1 c 2000 |> settle |> .world |> .heard |> Array.keepIf (String.contains "switch-client -t")) inPreview
                    in
                    Expect.equal (Just [ "switch-client -t '@0'" ]) chose
          }
        , { name = "in tmux's look the tree's preview boxes each label in the middle, as each tmux words it (TM88)"
          , test =
                \_ ->
                    let
                        begun =
                            attached (start version)

                        tmuxLooking =
                            { begun | tmux = TmuxMode.setLook True begun.tmux }

                        session =
                            look (settle (prefixThen "s" tmuxLooking))

                        sessionRows =
                            session.rows

                        -- the w tree, its window's row: a window's panes
                        windowRun =
                            let
                                again =
                                    attached (start version)
                            in
                            { again | tmux = TmuxMode.setLook True again.tmux }

                        window =
                            look (settle (named downKey (settle (prefixThen "w" windowRun))))

                        has text rows =
                            Array.any (String.contains text) rows
                    in
                    Expect.equal
                        { session = True
                        , window = True
                        , lineLabel = False
                        }
                        { session = has "│ 0:sh │" sessionRows
                        , window =
                            has
                                (if version == "3.8" then
                                    "│ 0:host │"

                                 else
                                    "│ 0 │"
                                )
                                window.rows
                        , lineLabel = has "─ 0:sh ─" sessionRows
                        }
          }
        , { name = "Up at the prompt goes back through tmux's own history from 3.3, after what was typed here, each type its own (TM89)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        -- tmux's history: one command and one search
                        held =
                            { made | promptHistory = Dict.empty |> Dict.set "command" [ "set-option -g @older 1" ] |> Dict.set "search" [ "needle" ] }

                        -- a command typed here, then the prompt opened again
                        reopened =
                            attached held
                                |> prefixThen ":"
                                |> typeText "set-option -g @mine 1"
                                |> named enterKey
                                |> settle
                                |> prefixThen ":"
                                |> settle

                        typedOf run =
                            TmuxMode.promptBox run.tmux |> Maybe.map .typed |> Maybe.withDefault "(none)"

                        once =
                            named upKey reopened

                        first =
                            typedOf once

                        second =
                            typedOf (named upKey once)

                        -- a search prompt (-T search) goes back through
                        -- tmux's searches, not its commands
                        searching =
                            attached held
                                |> prefixThen ":"
                                |> typeText "command-prompt -T search -p find 'display-message %%'"
                                |> named enterKey
                                |> settle
                                |> named upKey
                                |> typedOf
                    in
                    Expect.equal
                        (if Array.member version [ "2.7", "3.0", "3.2a" ] then
                            -- one list of puritty's own: nothing of tmux's
                            -- can be read; the command typed is in it
                            { first = "set-option -g @mine 1", second = "set-option -g @mine 1", search = "command-prompt -T search -p find 'display-message %%'" }

                         else
                            { first = "set-option -g @mine 1", second = "set-option -g @older 1", search = "needle" }
                        )
                        { first = first, second = second, search = searching }
          }
        , { name = "a selection goes when its pane leaves its screen or writes over its rows, as without tmux (TM91)"
          , test =
                \_ ->
                    let
                        -- rows 2 to 4 dragged over in pane %0, and let go
                        dragged _ =
                            let
                                begun =
                                    attached (start version)

                                at action buttons c r =
                                    TmuxMode.pointer { ms = 2000, held = buttons, select = False, boundaries = [], pasteButton = 3 }
                                        { action = action, button = 1, mods = 0, x = c * 10 + 5, y = r * 20 + 5, width = 800, height = 500, cellWidth = 10, cellHeight = 20 }

                                pressed =
                                    at 0 1 0 2 begun.tmux

                                moved =
                                    at 2 2 10 4 pressed.state

                                let_go =
                                    at 1 0 10 4 moved.state
                            in
                            { begun | tmux = let_go.state }

                        -- the pane's output, as tmux sends it (`%output`, its
                        -- control characters in octal)
                        output text run =
                            deliver (Bytes.fromString ("%output %0 " ++ text ++ "\u{000D}\n")) run

                        selecting run =
                            TmuxMode.selectedText run.tmux /= Nothing
                    in
                    Expect.equal
                        { made = True, alternate = False, elsewhere = True, overwritten = False }
                        { made = selecting (dragged {})
                        , alternate = selecting (output "\\033[?1049h" (dragged {}))
                        , elsewhere = selecting (output "x" (dragged {}))
                        , overwritten = selecting (output "\\033[4;1Hchanged" (dragged {}))
                        }
          }
        , { name = "a Kitty graphics image in a pane's output is shown on the canvas, cut to its pane (images IM18)"
          , test =
                \_ ->
                    let
                        run =
                            attached (start version)

                        sized =
                            { run | tmux = TmuxMode.setCell { width = 10, height = 20, limit = 10000000 } run.tmux }

                        -- a 2 by 1 RGB image shown 3 columns by 2 rows, as
                        -- tmux sends it (`%output`, ESC in octal)
                        shown =
                            deliver (Bytes.fromString "%output %0 \\033_Ga=T,f=24,s=2,v=1,c=3,r=2;/wAAAP8A\\033\\\\\u{000D}\n") sized

                        canvas =
                            (TmuxMode.paint shown.tmux).canvas

                        placed =
                            Vt.composedPlaces canvas
                    in
                    Expect.equal [ { cols = 3, rows = 2, inside = True } ]
                        (Array.map (\p -> { cols = p.cols, rows = p.rows, inside = p.clip.cols == 3 && p.clip.rows == 2 && p.clip.x >= 0 && p.clip.y >= 0 }) placed)
          }
        , { name = "once what detaches this client has gone, nothing more is sent, which tmux would no longer read (TM92)"
          , test =
                \_ ->
                    let
                        -- whether nothing more may go, after the batch the
                        -- key or line made went
                        endedBy steps =
                            TmuxMode.isEnding (TmuxMode.afterSent (steps (attached (start version))).tmux)

                        line text run =
                            run |> prefixThen ":" |> typeText text |> named enterKey
                    in
                    Expect.equal
                        { prefixD = True, prefixC = False, typed = True, others = False }
                        { prefixD = endedBy (\r -> r |> ctrl "b" |> settle |> typeKey "d")
                        , prefixC = endedBy (\r -> r |> ctrl "b" |> settle |> typeKey "c")
                        , typed = endedBy (line "detach")
                        , others = endedBy (line "detach-client -a")
                        }
          }
        , { name = "a typed line tmux makes no command of leaves the replies in step: no other reply is taken for its (review TA1)"
          , test =
                \_ ->
                    let
                        line text run =
                            run |> prefixThen ":" |> typeText text |> named enterKey |> settle

                        -- whether a reply was taken as the line's output and
                        -- shown in a view, as the window's question's was
                        viewOpen text =
                            TmuxMode.diagnose (line text (attached (start version))).tmux
                                |> Array.any (String.contains "a view")
                    in
                    Expect.equal
                        { assignment = False, comment = False, hidden = False }
                        { assignment = viewOpen "FOO=bar"
                        , comment = viewOpen "# a note"
                        , hidden = viewOpen "%hidden X=1"
                        }
          }
        , { name = "a detach naming another client does not end this one, and one whose line fails is let go of (review TA2)"
          , test =
                \_ ->
                    let
                        endedBy steps =
                            TmuxMode.isEnding (TmuxMode.afterSent (steps (attached (start version))).tmux)

                        line text run =
                            run |> prefixThen ":" |> typeText text |> named enterKey

                        -- what is held answered as the fake tmux answers,
                        -- but a detach refused, as tmux refuses one naming
                        -- no client
                        refused run =
                            when Array.popFirst run.held is
                                Just { first, rest } ->
                                    if String.startsWith "detach" first then
                                        refused (deliver (Bytes.fromString "%begin 1700000000 900 1\u{000D}\n%error 1700000000 900 1\u{000D}\n") { run | held = rest })

                                    else
                                        let
                                            answered =
                                                FakeTmux.answer first run.world
                                        in
                                        refused (deliver answered.bytes { run | world = answered.world, held = rest })

                                Nothing ->
                                    run
                    in
                    -- the fake tmux's client is `client-0`
                    Expect.equal
                        { another = False, joined = False, own = True, session = True, failed = False }
                        { another = endedBy (line "detach-client -t client-9")
                        , joined = endedBy (line "detach-client -Pt client-9")
                        , own = endedBy (line "detach-client -t client-0")
                        , session = endedBy (line "detach-client -s 0")
                        , failed = endedBy (\r -> r |> line "detach-client -t client-0" |> refused)
                        }
          }
        , { name = "Tab at the prompt completes what each tmux completes, 3.8 listing what it cannot choose between (TM96)"
          , test =
                \_ ->
                    let
                        -- typed at `:`, then Tab: the line and the hint
                        tabbed text =
                            let
                                run =
                                    attached (start version)
                                        |> prefixThen ":"
                                        |> typeText text
                                        |> named tabKey
                            in
                            TmuxMode.promptBox run.tmux
                                |> Maybe.map (\b -> { typed = b.typed, hint = b.hint })
                                |> Maybe.withDefault { typed = "(none)", hint = "" }

                        newest =
                            version == "3.8"
                    in
                    Expect.equal
                        { spl =
                            if version == "2.7" then
                                "split-window "

                            else
                                "split"
                        , select =
                            if newest then
                                "select-layout  select-pane  select-window"

                            else
                                "Enter: run    Esc: cancel    Up, Down: earlier answers"
                        , option =
                            if newest then
                                "set -g status-k"

                            else
                                "set -g status-keys "
                        , layout =
                            if newest then
                                "select-layout even-h"

                            else
                                "select-layout even-horizontal "
                        }
                        { spl = (tabbed "spl").typed
                        , select = (tabbed "select-").hint
                        , option = (tabbed "set -g status-k").typed
                        , layout = (tabbed "select-layout even-h").typed
                        }
          }
        , { name = "before 3.2 Tab completes a -t word to a session, then a window (TM97)"
          , test =
                \_ ->
                    let
                        tabbed text =
                            let
                                run =
                                    attached (start version)
                                        |> prefixThen ":"
                                        |> typeText text
                                        |> named tabKey
                                        |> settle
                            in
                            TmuxMode.promptBox run.tmux |> Maybe.map .typed |> Maybe.withDefault "(none)"

                        older =
                            Array.member version [ "2.7", "3.0" ]
                    in
                    -- 3.2 to 3.7 complete the session too, and a window
                    -- by its index only (TM98); 3.8 neither
                    Expect.equal
                        (if older then
                            { session = "select-window -tmain:", window = "select-window -t:sh " }

                         else if version == "3.8" then
                            { session = "select-window -tma", window = "select-window -t:s" }

                         else
                            { session = "select-window -tmain:", window = "select-window -t:s" }
                        )
                        { session = tabbed "select-window -tma", window = tabbed "select-window -t:s" }
          }
        , { name = "on 3.2 to 3.7 Tab opens a menu of what it cannot choose between, a digit choosing (TM98)"
          , test =
                \_ ->
                    let
                        opened =
                            attached (start version)
                                |> prefixThen ":"
                                |> typeText "select-"
                                |> named tabKey

                        menuShown =
                            look opened

                        chosen =
                            typeKey "1" menuShown.run

                        typedOf run =
                            TmuxMode.promptBox run.tmux |> Maybe.map .typed |> Maybe.withDefault "(none)"

                        menu =
                            Array.member version [ "3.2a", "3.4", "3.6a" ]
                    in
                    Expect.equal
                        (if menu then
                            { shown = True, typed = "select-pane" }

                         else
                            { shown = False, typed = "select-1" }
                        )
                        { shown = Array.any (String.contains "select-window") menuShown.rows, typed = typedOf chosen }
          }
        , { name = "a pane's bell sounds, shows or is ignored as bell-action, visual-bell and monitor-bell say (TM99)"
          , test =
                \_ ->
                    let
                        -- pane %0 rings, with these options set
                        rung settings =
                            let
                                made =
                                    start version

                                run =
                                    attached { made | options = Array.foldl (\o d -> Dict.set o.name o.value d) made.options settings }
                                        |> deliver (Bytes.fromString "%output %0 \\007\u{000D}\n")

                                seen =
                                    look run
                            in
                            { sounds = TmuxMode.bells seen.run.tmux, says = Array.any (String.contains "Bell in current window") seen.rows }
                    in
                    Expect.equal
                        { plain = { sounds = 1, says = False }
                        , visual = { sounds = 0, says = True }
                        , both = { sounds = 1, says = True }
                        , none = { sounds = 0, says = False }
                        , other = { sounds = 0, says = False }
                        , unmonitored = { sounds = 0, says = False }
                        }
                        { plain = rung []
                        , visual = rung [ { name = "visual-bell", value = "on" } ]
                        , both = rung [ { name = "visual-bell", value = "both" } ]
                        , none = rung [ { name = "bell-action", value = "none" } ]
                        , other = rung [ { name = "bell-action", value = "other" } ]
                        , unmonitored = rung [ { name = "monitor-bell", value = "off" } ]
                        }
          }
        , { name = "the prompt's word keys stop at word-separators as each tmux's do (RV2)"
          , test =
                \_ ->
                    let
                        prompt steps =
                            attached (start version)
                                |> prefixThen ":"
                                |> steps
                                |> (\r -> TmuxMode.promptBox r.tmux)
                                |> Maybe.map .typed
                                |> Maybe.withDefault "(closed)"

                        -- each as the window gives it: Alt with the letter,
                        -- the others with their bytes
                        alt letter r =
                            press { mods = 4, sym = Char.toCode letter, unshifted = Char.toCode letter, text = Bytes.fromString (String.fromChar letter) } r

                        ctrlLeft r =
                            press { mods = 2, sym = 0xFF51, unshifted = 0xFF51, text = Bytes.fromString "\u{001B}[1;5D" } r

                        home r =
                            press { mods = 0, sym = 0xFF50, unshifted = 0xFF50, text = Bytes.fromString "\u{001B}[H" } r

                        -- each tmux's default word-separators: ` -_@` before
                        -- 3.0, a space to 3.2, and from 3.3 the punctuation
                        -- but `_`, a run of which is a word of its own
                        newer =
                            Array.member version [ "3.4", "3.6a", "3.8" ]
                    in
                    Expect.equal
                        { forward =
                            if newer then
                                "aX--b c"

                            else
                                "a--bX c"
                        , back =
                            if newer then
                                "a bX--"

                            else
                                "a Xb--"
                        , cut =
                            if version == "2.7" then
                                "new-window -n my_"

                            else
                                "new-window -n "
                        , ctrlArrow =
                            -- Ctrl+Left moves by words from 3.0
                            if version == "2.7" then
                                "ab cX"

                            else
                                "ab Xc"
                        }
                        { forward = prompt (\r -> r |> typeText "a--b c" |> home |> alt 'f' |> typeText "X")
                        , back = prompt (\r -> r |> typeText "a b--" |> alt 'b' |> typeText "X")
                        , cut = prompt (\r -> r |> typeText "new-window -n my_logs" |> ctrl "w")
                        , ctrlArrow = prompt (\r -> r |> typeText "ab c" |> ctrlLeft |> typeText "X")
                        }
          }
        , { name = "with status-keys vi the prompt has vi's insert and command modes, as each tmux (TM100)"
          , test =
                \_ ->
                    let
                        prompt steps =
                            let
                                made =
                                    start version

                                run =
                                    attached { made | options = Dict.set "status-keys" "vi" made.options }
                                        |> prefixThen ":"
                                        |> steps
                            in
                            TmuxMode.promptBox run.tmux |> Maybe.map .typed |> Maybe.withDefault "(closed)"

                        newer n =
                            Array.member version [ "3.2a", "3.4", "3.6a", "3.8" ] && (n <= 32 || Array.member version [ "3.4", "3.6a", "3.8" ])
                    in
                    Expect.equal
                        { edit = "ello world!"
                        , word =
                            -- before 3.3 w is M-f: to the separator, back one
                            if newer 33 then
                                "abc ef"

                            else
                                "ab def"
                        , quit =
                            if newer 32 then
                                "(closed)"

                            else
                                "keep"
                        , ctrlA =
                            if newer 33 then
                                "zxy"

                            else
                                "xyz"
                        }
                        { edit = prompt (\r -> r |> typeText "hello world" |> named escapeKey |> typeKey "0" |> typeKey "x" |> typeKey "A" |> typeKey "!")
                        , word = prompt (\r -> r |> typeText "abc def" |> named escapeKey |> typeKey "0" |> typeKey "w" |> typeKey "x")
                        , quit = prompt (\r -> r |> typeText "keep" |> named escapeKey |> typeKey "q")
                        , ctrlA = prompt (\r -> r |> typeText "xy" |> ctrl "a" |> typeKey "z")
                        }
          }
        , { name = "a click on [z] in a pane's title zooms it, as tmux 3.8's MouseDown1Control8 (TM83)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        seen =
                            look (attached { made | options = made.options |> Dict.set "mouse" "on" |> Dict.set "pane-border-status" "top" })

                        -- the [z] on the screen, by its row and the z's column
                        at =
                            seen.rows
                                |> Array.indexedMap (\i r -> { row = i, parts = String.split "[z]" r })
                                |> Array.findFirst (\r -> Array.length r.parts > 1)
                                |> Maybe.map (\found -> { row = found.value.row, col = String.count (Maybe.withDefault "" (Array.first found.value.parts)) + 1 })

                        clicked =
                            Maybe.map
                                (\c ->
                                    (TmuxMode.pointer { ms = 1000, held = 1, select = False, boundaries = [], pasteButton = 2 }
                                        { action = 0, button = 1, mods = 0, x = c.col * 10 + 5, y = c.row * 20 + 5, width = 800, height = 500, cellWidth = 10, cellHeight = 20 }
                                        seen.run.tmux
                                    ).commands
                                        |> Array.any (String.contains "resize-pane -Z")
                                )
                                at
                    in
                    Expect.equal
                        (if version == "3.8" then
                            Just True

                         else
                            Nothing
                        )
                        clicked
          }
        , { name = "a popup's -T title is given to its floating pane's box on 3.8 (TM82)"
          , test =
                \_ ->
                    let
                        heard =
                            attached (start version)
                                |> prefixThen ":"
                                |> typeText "display-popup -T hello -E true"
                                |> named enterKey
                                |> settle
                                |> .world
                                |> .heard
                                |> Array.keepIf (String.contains "new-pane")
                                |> Array.map (String.replace "'" "")
                    in
                    Expect.equal
                        (if version == "3.8" then
                            { panes = 1, title = True, status = True }

                         else
                            { panes = 0, title = False, status = False }
                        )
                        { panes = Array.length heard
                        , title = Array.any (String.contains "pane-border-format hello") heard
                        , status = Array.any (String.contains "pane-border-status top") heard
                        }
          }
        , { name = "choose-buffer's search finds a buffer's whole text, and ignores case from 3.6 only (TM81)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        -- buffer2 newest, the one chosen first
                        chose search =
                            attached { made | buffers = [ "plain text", "one apple\nzebra here", "Two Bananas" ] }
                                |> prefixThen "="
                                |> typeKey "/"
                                |> typeText search
                                |> named enterKey
                                |> settle
                                |> named enterKey
                                |> settle
                                |> .world
                                |> .heard
                                |> Array.keepIf (String.contains "paste-buffer")
                                |> Array.map
                                    (\l ->
                                        if String.contains "buffer2" l then
                                            "buffer2"

                                        else if String.contains "buffer1" l then
                                            "buffer1"

                                        else if String.contains "buffer0" l then
                                            "buffer0"

                                        else
                                            l
                                    )
                    in
                    Expect.equal
                        { zebra = [ "buffer1" ]
                        , two =
                            if Array.member version [ "3.6a", "3.8" ] then
                                [ "buffer0" ]

                            else
                                [ "buffer2" ]
                        }
                        { zebra = chose "zebra", two = chose "two" }
          }
        , { name = "C-y at the prompt puts back what C-w cut from 3.0, else the newest buffer up to a control character (TM80)"
          , test =
                \_ ->
                    let
                        typedThen buffers =
                            let
                                made =
