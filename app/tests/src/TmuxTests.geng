                                        (if version == "2.7" then
                                            "0"

                                         else
                                            "off"
                                        )
                                        made.options
                            }

                        -- in tmux's look, which draws tmux's status lines
                        run =
                            settle (deliver FakeTmux.startBytes { tmux = TmuxMode.setLook True (TmuxMode.expectEntry True (TmuxMode.idle {})), world = off, held = [], ms = 1000 })

