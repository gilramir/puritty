                        { on = TmuxMode.isOn first.state
                        , asked = TmuxMode.entryAsked first.state
                        , commands = first.commands
                        , againOn = TmuxMode.isOn again.state
                        , againAsked = TmuxMode.entryAsked again.state
                        }
          }
