                                [ "buffer2" ]
                        }
                        { zebra = chose "zebra", two = chose "two" }
          }
        , { name = "C-y at the prompt puts back what C-w cut from 3.0, else the newest buffer up to a control character (TM80)"
          , test =
                \_ ->
                    let
                        typedThen buffers =
                            let
                                made =
                                    start version

                                run =
                                    attached { made | buffers = buffers }
                                        |> prefixThen ":"
                                        |> typeText "abc def"
                                        |> ctrl "w"
                                        |> ctrl "y"
                                        |> settle
                            in
                            TmuxMode.promptBox run.tmux |> Maybe.map .typed

                        older =
                            Array.member version [ "2.7" ]
                    in
                    Expect.equal
                        { noBuffer =
                            if older then
                                Just "abc "

                            else
                                Just "abc def"
                        , buffer =
                            if older then
                                Just "abc hello w"

                            else
                                Just "abc def"
                        }
                        { noBuffer = typedThen [], buffer = typedThen [ "hello w\u{00F6}rld\nsecond" ] }
          }
        , { name = "C-y with nothing cut puts in the newest buffer, as this tmux reads it (TM80)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        run =
                            attached { made | buffers = [ "hello w\u{00F6}rld\nsecond", "older" ] }
                                |> prefixThen ":"
                                |> typeText "x "
                                |> ctrl "y"
                                |> settle
                    in
                    Expect.equal
                        (if Array.member version [ "2.7" ] then
                            Just "x hello w"

                         else
                            Just "x hello w\u{00F6}rld"
                        )
                        (TmuxMode.promptBox run.tmux |> Maybe.map .typed)
          }
        , { name = "the panes' numbers take a digit, and from 3.2 a letter for panes 10 to 35, each run with the pane's id (TM79)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        first =
                            Array.first made.panes |> Maybe.withDefault { id = 0, lines = [], rows = 24, mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 }

                        twelve =
                            { made | panes = Array.map (\i -> { first | id = i }) (Array.range 0 11), number = 12 }

                        chose letter =
                            settle (typeKey letter (prefixThen "q" (attached twelve)))
                                |> .world
                                |> .heard
                                |> Array.keepIf (String.startsWith "select-pane")

                        letters =
                            not (Array.member version [ "2.7", "3.0" ])
                    in
                    Expect.equal
                        { digit = [ "select-pane -t '%3'" ]
                        , letter =
                            if letters then
                                [ "select-pane -t '%11'" ]

                            else
                                []
                        }
                        { digit = chose "3", letter = chose "b" }
          }
        , { name = "a pane that closes while a press in it holds the pointer lets go of it: a press in the other pane reaches its program (review TA7)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        -- two panes side by side, each program taking the mouse
                        two =
                            { made | panes = made.panes ++ Array.map (\p -> { p | id = 1 }) made.panes }

                        mouse pane run =
                            deliver (Bytes.fromString ("%output %" ++ String.fromInt pane ++ " \\033[?1000h\\033[?1006h\u{000D}\n")) run

                        -- pane 0 pressed, then it closes, then pane 1 pressed
                        pressed =
                            attached two
                                |> mouse 0
                                |> mouse 1
                                |> settle
                                |> clickAt 1 { col = 5, row = 5 } 2000

                        closed =
                            let
                                c =
                                    FakeTmux.closePane 0 pressed.world
                            in
                            settle (deliver (Bytes.fromString (String.join "" (Array.map (\n -> n ++ "\u{000D}\n") c.notices))) { pressed | world = c.world })

                        after =
                            clickAt 1 { col = 60, row = 5 } 3000 closed |> settle
                    in
                    Expect.equal True
                        (Array.any (\l -> String.startsWith "send-keys -t '%1'" l) (Array.dropFirst (Array.length closed.world.heard) after.world.heard))
          }
        , { name = "keys typed after a binding that moves the active pane, before tmux has answered, all go to the pane it made active (review TA4)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        two =
                            { made | panes = made.panes ++ Array.map (\p -> { p | id = 1 }) made.panes }

                        prefixed =
                            settle (ctrl "b" (attached two))

                        -- `prefix o`, then `ls` and Enter, typed before
                        -- tmux's answer to the `o` is read
                        typedAhead =
                            prefixed
                                |> typeKey "o"
                                |> typeKey "l"
                                |> typeKey "s"
                                |> named enterKey

                        -- tmux runs the binding: pane 1 is active; from 3.4
                        -- the binding's block comes, not this client's
                        w =
                            typedAhead.world

                        moved =
                            { typedAhead | world = { w | active = 1 } }
                                |> deliver
                                    (Bytes.fromString
                                        ((if Array.member version [ "3.4", "3.6a", "3.8" ] then
                                            "%begin 1700000000 900 0\u{000D}\n%end 1700000000 900 0\u{000D}\n"

                                          else
                                            ""
                                         )
                                            ++ "%window-pane-changed @"
                                            ++ String.fromInt w.window.id
                                            ++ " %1\u{000D}\n"
                                        )
                                    )
                                |> settle

                        after =
                            Array.dropFirst (Array.length prefixed.world.heard) moved.world.heard
                    in
                    Expect.equal { toOld = [], toNew = True }
                        { toOld = Array.keepIf (String.startsWith "send-keys -t '%0'") after
                        , toNew = Array.any (String.startsWith "send-keys -t '%1'") after
                        }
          }
        , { name = "a pane that closes is forgotten, its terminal with it (review TA8)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        two _ =
                            attached { made | panes = made.panes ++ Array.map (\p -> { p | id = 1 }) made.panes }

                        closed =
                            let
                                run =
                                    two {}

                                c =
                                    FakeTmux.closePane 1 run.world
                            in
                            settle (deliver (Bytes.fromString (String.join "" (Array.map (\n -> n ++ "\u{000D}\n") c.notices))) { run | world = c.world })

                        kept run =
                            TmuxMode.diagnose run.tmux |> Array.keepIf (String.startsWith "  terminals kept")
                    in
                    Expect.equal { before = [ "  terminals kept: 2 (%0 %1)" ], after = [ "  terminals kept: 1 (%0)" ] }
                        { before = kept (two {}), after = kept closed }
          }
        , { name = "a version that is not one is taken as the oldest tmux with what this one takes (review TB7, TM111)"
          , test =
                \_ ->
                    let
                        caps =
                            RealTmux.commands
                                |> Array.findFirst (\c -> c.version == version)
                                |> Maybe.map (\found -> Caps.fromUsage found.value.lines)
                                |> Maybe.withDefault Caps.assumed

                        wanted =
                            when version is
                                "3.8" ->
                                    38

                                "3.6a" ->
                                    36

                                "3.4" ->
                                    34

                                "3.2a" ->
                                    32

                                "3.0" ->
                                    30

                                _ ->
                                    27
                    in
                    Expect.equal { odd = wanted, plain = TmuxMode.versionFrom caps version }
                        { odd = TmuxMode.versionFrom caps "openbsd-7.6", plain = wanted }
          }
        , { name = "with pane-scrollbars on, a layout change sizes each pane's terminal to its cell less the scrollbar (TM53, review TA11)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        -- three panes, the last closed: a %layout-change for
                        -- the two left, each wider
                        widths scrollbars =
                            let
                                three =
                                    { made
                                        | panes = made.panes ++ Array.map (\p -> { p | id = 1 }) made.panes ++ Array.map (\p -> { p | id = 2 }) made.panes
                                        , options = Dict.set "pane-scrollbars" scrollbars made.options
                                    }

                                run =
                                    settle (deliver FakeTmux.startBytes { tmux = TmuxMode.setLook True (TmuxMode.expectEntry True (TmuxMode.idle {})), world = three, held = [], ms = 1000 })

                                c =
                                    FakeTmux.closePane 2 run.world

                                closed =
                                    settle (deliver (Bytes.fromString (String.join "" (Array.map (\n -> n ++ "\u{000D}\n") c.notices))) { run | world = c.world })
                            in
                            TmuxMode.diagnose closed.tmux
                                |> Array.keepIf (String.startsWith "  pane %")
                                |> Array.mapAndKeepJust (\l -> String.split ", size " l |> Array.get 1 |> Maybe.andThen (String.split "x" >> Array.first) |> Maybe.andThen String.toInt)

                        off =
                            widths "off"
                    in
                    Expect.equal
                        -- pane-scrollbars is 3.6's
                        (if Array.member version [ "3.6a", "3.8" ] then
                            Array.map (\w -> w - 1) off

                         else
                            off
                        )
                        (widths "on")
          }
        , { name = "a command that binds a key or sets the prefix has the key tables read again (review TA12)"
          , test =
                \_ ->
                    let
                        run line =
                            let
                                before =
                                    prefixThen ":" (attached (start version))

                                ran =
                                    settle (named enterKey (typeText line before))
                            in
                            Array.dropFirst (Array.length before.world.heard) ran.world.heard
                                |> Array.keepIf (\l -> String.startsWith "list-keys" l || String.contains "#{prefix}" l)
                                |> Array.length
                    in
                    Expect.equal { bind = 2, prefix = 2, other = 0 }
                        { bind = run "bind -n F5 send-keys hi", prefix = run "set -g prefix C-a", other = run "display-message hi" }
          }
        , { name = "a resize sizes the panes of windows not shown too (review TA13)"
          , test =
                \_ ->
                    let
                        first =
                            attached (start version)

                        -- a second window, not shown, with pane %1
                        added =
                            let
                                a =
                                    FakeTmux.addWindow 1 1 first.world
                            in
                            settle (deliver (Bytes.fromString (String.join "" (Array.map (\n -> n ++ "\u{000D}\n") a.notices))) { first | world = a.world })

                        -- puritty's window made 100 by 31: tmux's panes 100 by 30
                        resized =
                            let
                                r =
                                    TmuxMode.resized { cols = 100, rows = 31 } added.tmux
                            in
                            settle { added | tmux = r.state, held = added.held ++ r.commands }

                        said =
                            TmuxMode.diagnose resized.tmux

                        sizeOf pane =
                            said
                                |> Array.findFirst (String.startsWith ("  pane %" ++ String.fromInt pane))
                                |> Maybe.andThen (\found -> String.split ", size " found.value |> Array.get 1)
                                |> Maybe.andThen (String.split "," >> Array.first)
                    in
                    Expect.equal { shown = Just "100x30", hidden = Just "100x30" } { shown = sizeOf 0, hidden = sizeOf 1 }
          }
        , { name = "a binding of two commands sent by puritty (before 3.4) waits for both replies, so the window asked after it gets its own (review TA6, TM116)"
          , test =
                \_ ->
