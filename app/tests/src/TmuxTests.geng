          }
        , { name = "the panes' numbers take a digit, and from 3.2 a letter for panes 10 to 35, each run with the pane's id (TM79)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        first =
                            Array.first made.panes |> Maybe.withDefault { id = 0, lines = [], rows = 24, mode = "", scroll = 0, cx = 0, cy = 0, wanted = 0 }

                        twelve =
                            { made | panes = Array.map (\i -> { first | id = i }) (Array.range 0 11), number = 12 }

                        chose letter =
                            settle (typeKey letter (prefixThen "q" (attached twelve)))
                                |> .world
                                |> .heard
                                |> Array.keepIf (String.startsWith "select-pane")

                        letters =
                            not (Array.member version [ "2.7", "3.0" ])
                    in
                    Expect.equal
                        { digit = [ "select-pane -t '%3'" ]
                        , letter =
                            if letters then
                                [ "select-pane -t '%11'" ]

                            else
                                []
                        }
                        { digit = chose "3", letter = chose "b" }
          }
        , { name = "a pane that closes while a press in it holds the pointer lets go of it: a press in the other pane reaches its program (review TA7)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        -- two panes side by side, each program taking the mouse
                        two =
                            { made | panes = made.panes ++ Array.map (\p -> { p | id = 1 }) made.panes }

                        mouse pane run =
                            deliver (Bytes.fromString ("%output %" ++ String.fromInt pane ++ " \\033[?1000h\\033[?1006h\u{000D}\n")) run

                        -- pane 0 pressed, then it closes, then pane 1 pressed
                        pressed =
                            attached two
                                |> mouse 0
                                |> mouse 1
                                |> settle
                                |> clickAt 1 { col = 5, row = 5 } 2000

                        closed =
                            let
                                c =
                                    FakeTmux.closePane 0 pressed.world
                            in
                            settle (deliver (Bytes.fromString (String.join "" (Array.map (\n -> n ++ "\u{000D}\n") c.notices))) { pressed | world = c.world })

                        after =
                            clickAt 1 { col = 60, row = 5 } 3000 closed |> settle
                    in
                    Expect.equal True
                        (Array.any (\l -> String.startsWith "send-keys -t '%1'" l) (Array.dropFirst (Array.length closed.world.heard) after.world.heard))
          }
        , { name = "the size sent when the status line's rows change waits for its reply: no reply comes that no question waited for (review TA5, TB3)"
          , test =
                \_ ->
                    let
                        made =
                            start version

                        -- status off, read from its subscription as tmux's look
                        -- starts, which sends a new size
                        off =
                            { made
                                | options =
                                    Dict.set "status"
                                        (if version == "2.7" then
                                            "0"

                                         else
                                            "off"
                                        )
                                        made.options
                            }

                        run =
                            settle (deliver FakeTmux.startBytes { tmux = TmuxMode.setLook True (TmuxMode.idle {}), world = off, held = [], ms = 1000 })
                    in
                    Expect.equal [ "  replies no question waited for: 0" ]
                        (TmuxMode.diagnose run.tmux |> Array.keepIf (String.startsWith "  replies no question"))
          }
        , { name = "status off leaves tmux's panes the whole window, as this tmux writes off (TM79)"
          , test =
                \_ ->
                    let
                        -- 2.7 and 2.8 write the flag as 0 (measured)
                        made =
                            start version

                        off =
                            { made
                                | options =
                                    Dict.set "status"
                                        (if version == "2.7" then
                                            "0"

                                         else
                                            "off"
                                        )
                                        made.options
                            }

                        -- in tmux's look, which draws tmux's status lines
                        run =
                            settle (deliver FakeTmux.startBytes { tmux = TmuxMode.setLook True (TmuxMode.idle {}), world = off, held = [], ms = 1000 })

                        wanted =
                            TmuxMode.wantedSize run.tmux
                    in
                    -- tmux's window the whole of puritty's, no row kept back
                    Expect.equal { tmux = run.world.rows, canvas = run.tmux.canvas.rows } { tmux = wanted.rows, canvas = wanted.rows }
          }
        , { name = "the tree of windows shows the rows this tmux draws (TM77)"
          , test =
                \_ ->
                    let
                        drawn =
                            drawnMenu version "w"

                        begun =
                            attached (start version)

                        -- in tmux's own look (TM32), whose rows are tmux's
                        rows =
                            (look (prefixThen "w" { begun | tmux = TmuxMode.setLook True begun.tmux })).rows
                                |> Array.takeFirst (Array.length drawn)
                                |> Array.map String.trimRight
                    in
                    Expect.equal drawn rows
          }
        , { name = "the pane menu shows the items this tmux draws (TM27)"
          , test =
                \_ ->
                    let
                        opened =
                            look (prefixThen ">" (attached (start version)))

                        items =
                            opened.rows
                                |> Array.keepIf (\r -> String.startsWith "│" r)
                                |> Array.map (\r -> String.trim (String.slice 1 (String.count r - 1) r))
                    in
                    Expect.equal (drawnMenu version ">") items
          }
        , { name = "the pane's cursor is shown once attached, from tmux's flags before 3.8 (TM71)"
          , test = \_ -> Expect.equal True (TmuxMode.paint (attached (start version)).tmux).canvas.showCursor
          }
        , { name = "copy mode's cursor is drawn where tmux says, and not at all where it cannot say, before 3.1 (TK8)"
          , test =
                \_ ->
                    let
                        shown w =
                            (TmuxMode.paint (inCopyMode 0 (attached w)).tmux).canvas.showCursor

                        -- before 3.1, tmux has no copy_cursor_x or
                        -- selection_start_x: 3.0 and 2.7 as recorded, and
                        -- a later one made to lack them
                        older =
                            { (start version) | lacking = [ "copy_cursor_x", "copy_cursor_y", "selection_start_x", "selection_start_y", "selection_end_x", "selection_end_y" ] }

                        says =
                            not (Array.member version [ "3.0", "2.7" ])
                    in
                    Expect.equal { saying = says, silent = False } { saying = shown (start version), silent = shown older }
          }
        , { name = "a tree open when control mode ends is gone when tmux -CC is run again (TM102)"
          , test =
                \_ ->
                    let
                        fresh =
                            look (attached (start version))

                        top =
                            row 0 fresh

                        again =
                            prefixThen "s" fresh.run
                                |> deliver (Bytes.fromString "%exit\u{000D}\n\u{001B}\\")
                                |> deliver FakeTmux.startBytes
                                |> settle
                                |> look
                    in
                    Expect.equal top (row 0 again)
          }
        , { name = "a key that leaves copy mode shows the live screen again, without output first (TM101)"
          , test =
                \_ ->
                    let
                        live =
                            look (attached (start version))

                        top =
                            row 0 live

                        left =
                            look (settle (typeKey "q" (keys 30 (inCopyMode 0 live.run))))
                    in
                    Expect.equal top (row 0 left)
          }
        , { name = "a key in copy mode keeps the view until tmux answers, no live screen behind it (TM67)"
          , test =
                \_ ->
                    let
                        -- k typed, tmux's answer not let through yet
                        waiting =
                            attached (start version)
                                |> inCopyMode 0
                                |> keys 30
                                |> typeKey "k"
                                |> look

                        before =
                            split 0 waiting

                        answered =
                            look (settle waiting.run)
                    in
                    Expect.equal
                        { waiting = { text = "line 170", edge = timed version "[7/176]" }, answered = { text = "line 169", edge = timed version "[8/176]" } }
                        { waiting = before, answered = split 0 answered }
          }
        ]


{-| Copy mode's position as `version` shows it: from 3.6 after the top
line's time, the recordings' `12:00` (TM103). -}
timed : String -> String -> String
timed version position =
    if Array.member version [ "3.6a", "3.8" ] then
        "12:00 " ++ position

    else
        position


{-| The tests' server: one 80x24 pane that printed `line 1` to `line 200`. -}
start : String -> World
start version =
    FakeTmux.world { version = version, cols = 80, rows = 24, lines = numbered 200 }


{-| The fake in each state `record-tmux.py` recorded a real tmux in. -}
fakeIn : String -> String -> World
fakeIn version state =
    let
        server =
            start version

        up n w =
            if n <= 0 then
                w

            else
                up (n - 1) (FakeTmux.answer "send-keys -t %0 -X cursor-up" w).world
    in
    when state is
        "attached" ->
            server

        "copy mode" ->
            (FakeTmux.enterCopy 0 server).world

        "30 up" ->
            up 30 (FakeTmux.enterCopy 0 server).world

        "31 up" ->
            up 31 (FakeTmux.enterCopy 0 server).world

        _ ->
            server


{-| The lines inside the fake's reply blocks, empty ones too, as tmux sends
them; what it tells the client between blocks left out. -}
replyLines : String -> Array String
replyLines text =
    String.split "\n" text
        |> Array.map
            (\l ->
                if String.endsWith "\u{000D}" l then
                    String.dropLast 1 l

                else
                    l
            )
        |> Array.foldl
            (\l acc ->
                if String.startsWith "%begin" l then
                    { acc | inside = True }

                else if String.startsWith "%end" l || String.startsWith "%error" l then
                    { acc | inside = False }

                else if acc.inside then
                    { acc | lines = Array.pushLast l acc.lines }

                else
                    acc
            )
            { inside = False, lines = [] }
        |> .lines


{-| The conditions of these lines that test a bare name `version` does
not have, `#{?name,a,b}`, or a user option: 2.7 takes such a name as true
(`#{?@unset,T,F}` and `#{?pane_marked,T,F}` give `T`), where 2.8 and later
take it as empty; `#{?#{name},a,b}` is false on all (measured,
docs/tmux-versions.md TV10). A name it has, as tmux's own formats test,
is answered as tmux answers it. -}
bareConditions : String -> Array String -> Array String
bareConditions version lines =
    let
        lacks =
            RealTmux.lacking
                |> Array.findFirst (\l -> l.version == version)
                |> Maybe.map (\found -> found.value.names)
                |> Maybe.withDefault []
    in
    lines
        |> Array.mapAndFlatten (\line -> String.split "#{?" line |> Array.dropFirst 1)
        |> Array.keepIf (\after -> not (String.startsWith "#" after))
        |> Array.map (\after -> String.split "," after |> Array.first |> Maybe.withDefault after)
        |> Array.keepIf (\name -> String.startsWith "@" name || Array.member name lacks)
        |> Array.map (\name -> "#{?" ++ name)
        |> Array.foldl
            (\c acc ->
                if Array.member c acc then
                    acc

                else
                    Array.pushLast c acc
            )
            []


{-| The menu's items as the real tmux of this version draws them for the
prefix and `key` (`RealTmux.menus`, record-tmux.py). -}
drawnMenu : String -> String -> Array String
drawnMenu version key =
    RealTmux.menus
        |> Array.findFirst (\m -> m.version == version && m.key == key)
        |> Maybe.map (\found -> found.value.items)
        |> Maybe.withDefault [ "(not recorded)" ]


{-| Each recorded answer, and the fake's to the same question in the same
state, where they differ: none when the fake is honest (TM68). A question
of `tmux-questions.txt` is held only on the versions whose scenarios ask
it: another's menus (3.8's `#{!:…}`, which 3.5 and before expand their
own ways) are never put to an older tmux. -}
fakeDiffers : Array { version : String, state : String, command : String, real : Array String, fake : Array String }
fakeDiffers =
    let
        heard =
            RealTmux.versions
                |> Array.map (\version -> { version = version, asked = askedOn version })
    in
    RealTmux.answers
        |> Array.keepIf
            (\a ->
                not (Array.member a.command RealTmux.asked)
                    || Array.any (\h -> h.version == a.version && Array.member { state = a.state, command = a.command } h.asked) heard
            )
        |> Array.map
            (\a ->
                { version = a.version
                , state = a.state
                , command = a.command
                , real = a.lines
                , fake = replyLines (Bytes.toStringLossy (FakeTmux.answer a.command (fakeIn a.version a.state)).bytes)
                }
            )
        |> Array.keepIf (\d -> d.real /= d.fake)


{-| `k` typed `n` times, each answered before the next. -}
keys : Int -> (taken run : Run) -> Run
keys n run =
    if n <= 0 then
        run

    else
        keys (n - 1) (settle (typeKey "k" run))


{-| The scenarios: puritty driven against the fake from attaching. A
scenario whose questions are not all recorded fails `unrecorded`; one
added here is checked that way at once. -}
scenarios : Array String
scenarios =
    [ "attached", "copy mode", "tree of sessions", "tree closed", "tree of windows", "command prompt", "prompt run", "window menu", "rename from the menu", "pane menu" ]


{-| What a scenario leaves, on one version. -}
scenario : String -> String -> Run
scenario version name =
    let
        begun =
            attached (start version)
    in
    when name is
        "copy mode" ->
            keys 31 (inCopyMode 0 begun)

        "tree of sessions" ->
            prefixThen "s" begun

        "tree closed" ->
            settle (typeKey "q" (prefixThen "s" begun))

        "tree of windows" ->
            prefixThen "w" begun

        "prompt run" ->
            settle (named enterKey (typeText "kill-server -a" (prefixThen ":" begun)))

        "rename from the menu" ->
            settle (typeKey "n" (prefixThen "<" begun))

        "command prompt" ->
            prefixThen ":" begun

        "window menu" ->
            prefixThen "<" begun

        "pane menu" ->
            prefixThen ">" begun

        _ ->
            begun


{-| A command line that only asks (every command in it a query), which
can be put to a real tmux in a recorded state without changing it. -}
onlyAsks : String -> Bool
onlyAsks line =
    let
        names =
            Syntax.commands (Syntax.tokens line)
                |> Array.map (\c -> Array.first c |> Maybe.map .value |> Maybe.withDefault "")
    in
    not (Array.isEmpty names)
        && Array.all (\n -> Array.member n [ "display-message", "display", "list-windows", "list-panes", "list-sessions", "list-commands", "capture-pane" ]) names


{-| The questions the scenarios ask on one version, each with the state
it is recorded in: one asked in copy mode in "31 up"'s; any other in
"attached"'s. -}
askedOn : String -> Array { state : String, command : String }
askedOn version =
    scenarios
        |> Array.mapAndFlatten
            (\name ->
                let
                    state =
                        if name == "copy mode" then
                            "31 up"

                        else
                            "attached"
                in
                (scenario version name).world.heard
                    |> Array.keepIf onlyAsks
                    |> Array.map (\line -> { state = state, command = line })
            )


{-| The questions the scenarios ask that are not recorded for their
version, as lines for `tmux-questions.txt`: empty when every one is. -}
unrecorded : String
unrecorded =
    RealTmux.versions
        |> Array.mapAndFlatten
            (\version ->
                askedOn version
                    |> Array.keepIf (\q -> not (Array.any (\a -> a.version == version && a.state == q.state && a.command == q.command) RealTmux.answers))
                    |> Array.map (\q -> q.state ++ "\t" ++ q.command)
            )
        |> Array.foldl
            (\l acc ->
                if Array.member l acc then
                    acc

                else
                    Array.pushLast l acc
            )
            []
        |> String.join "\n"


{-| What puritty writes on the terminal and asks tmux when control mode
begins and ends with these bytes. -}
failedStart : String -> { said : String, asked : Array String }
failedStart bytes =
    let
        r =
            TmuxMode.read { cols = 80, rows = 25 } (Bytes.fromString bytes) (TmuxMode.idle {})
    in
    { said = Bytes.toStringLossy r.outside, asked = r.commands }
