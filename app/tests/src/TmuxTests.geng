module TmuxTests exposing (tmuxMode)

{-| `TmuxMode` driven by `FakeTmux` (`docs/tmux.md` TM68): tmux's bytes
delivered, keys typed, replies held back or let through, and the screen
puritty draws read as rows of text. -}

import Bytes exposing (Bytes)
import Expect exposing (Expectation)
import FakeTmux exposing (World)
import RealTmux
import Task
import Tmux.Syntax as Syntax
import Test.Runner.UnitNode as U
import TmuxMode
import Vt


{-| A session in progress: puritty's state, the fake server, the command
lines puritty has sent and tmux has not answered yet, and the clock. -}
type alias Run =
    { tmux : TmuxMode.State
    , world : World
    , held : Array String
    , ms : Int
    }


{-| puritty's window: the tmux window and one row for the tab bar. -}
size : World -> { cols : Int, rows : Int }
size w =
    { cols = w.cols, rows = w.rows + 1 }


{-| tmux's bytes read by puritty; what it sends back is held. -}
deliver : Bytes -> (taken run : Run) -> Run
deliver bytes run =
    let
        sized =
            size run.world

        held =
            run.held

        r =
            TmuxMode.read sized bytes run.tmux
    in
    { run | tmux = r.state, held = held ++ r.commands }


{-| Every held command answered, and what that makes puritty send, until
it sends nothing more (at most `n` rounds). -}
settle : (taken run : Run) -> Run
settle run =
    settleUpTo 200 run


settleUpTo : Int -> (taken run : Run) -> Run
settleUpTo n run =
    when Array.popFirst run.held is
        Just { first, rest } ->
            if n <= 0 then
                run

            else
                let
                    answered =
                        FakeTmux.answer first run.world
                in
                settleUpTo (n - 1) (deliver answered.bytes { run | world = answered.world, held = rest })

        Nothing ->
            run


{-| A session attached to `w` and settled. -}
attached : World -> Run
attached w =
    settle (deliver FakeTmux.startBytes { tmux = TmuxMode.idle {}, world = w, held = [], ms = 1000 })


{-| A key with a letter on it (`k`), typed. -}
typeKey : String -> (taken run : Run) -> Run
typeKey letter run =
    let
        sym =
            String.toArray letter |> Array.first |> Maybe.map Char.toCode |> Maybe.withDefault 0
    in
    press { mods = 0, sym = sym, unshifted = sym, text = Bytes.fromString letter } run


{-| A letter typed with Ctrl held (`C-b`, tmux's prefix): its control
character is the text, as the window gives it. -}
ctrl : String -> (taken run : Run) -> Run
ctrl letter run =
    let
        code =
            String.toArray letter |> Array.first |> Maybe.map Char.toCode |> Maybe.withDefault 0

        control =
            Char.fromCode (code - 0x60) |> Maybe.map String.fromChar |> Maybe.withDefault ""
    in
    press { mods = 2, sym = code, unshifted = code, text = Bytes.fromString control } run


{-| A key with a name and no text (Enter, Escape, the arrows), by its X
keysym, typed. -}
named : Int -> (taken run : Run) -> Run
named sym run =
    press { mods = 0, sym = sym, unshifted = sym, text = Bytes.fromString (if sym == enterKey then "\u{000D}" else if sym == escapeKey then "\u{001B}" else "") } run


enterKey : Int
enterKey =
    0xFF0D


escapeKey : Int
escapeKey =
    0xFF1B


downKey : Int
downKey =
    0xFF54


{-| Text typed a character at a time. -}
typeText : String -> Run -> Run
typeText text run =
    String.foldl (\c r -> typeKey (String.fromChar c) r) run text


{-| A key typed, and what it makes puritty send held. -}
press : { mods : Int, sym : Int, unshifted : Int, text : Bytes } -> (taken run : Run) -> Run
press k run =
    let
        ms =
            run.ms

        held =
            run.held

        r =
            TmuxMode.typed { action = 1, keycode = 0, mods = k.mods, consumed = 0, unshifted = k.unshifted, sym = k.sym, text = k.text } k.text ms run.tmux
    in
    { run | tmux = r.state, held = held ++ r.commands, ms = ms + 30 }


{-| Keys typed, each answered before the next: `C-b`, then `s`. -}
prefixThen : String -> (taken run : Run) -> Run
prefixThen letter run =
    settle (typeKey letter (settle (ctrl "b" run)))


{-| The pane put in copy mode by tmux (as `prefix [` does), and settled. -}
inCopyMode : Int -> (taken run : Run) -> Run
inCopyMode pane run =
    let
        e =
            FakeTmux.enterCopy pane run.world
    in
    settle (deliver (Bytes.fromString (String.join "" (Array.map (\n -> n ++ "\u{000D}\n") e.notices))) { run | world = e.world })


{-| The screen puritty draws, each row's text without its trailing blanks,
and the run, painted. -}
look : (taken run : Run) -> { run : Run, rows : Array String }
look run =
    let
        painted =
            TmuxMode.paint run.tmux

        top =
            Vt.rowsPushed painted.canvas

        rows =
            Array.range 0 (painted.canvas.rows - 1)
                |> Array.map (\r -> Vt.selectionText { row = top + r, col = 0 } { row = top + r, col = painted.canvas.cols - 1 } painted.canvas |> String.trimRight)
    in
    { run = { run | tmux = painted }, rows = rows }


row : Int -> { run : Run, rows : Array String } -> String
row i seen =
    Maybe.withDefault "" (Array.get i seen.rows)


{-| A row as its text and what sits at its right edge, the run of spaces
between dropped: `{ text = "line 170", edge = "[7/176]" }`. -}
split : Int -> { run : Run, rows : Array String } -> { text : String, edge : String }
split i seen =
    let
        line =
            row i seen
    in
    when String.firstIndexOf "    " line is
        Just at ->
            { text = String.takeFirst at line, edge = String.trim (String.dropFirst at line) }

        Nothing ->
            { text = line, edge = "" }


numbered : Int -> Array String
numbered n =
    Array.range 1 n |> Array.map (\i -> "line " ++ String.fromInt i)


tmuxMode : U.Suite
tmuxMode =
    U.suite
        { name = "TmuxMode"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            Array.map (\c -> U.test c.name (\_ -> Task.succeed (c.test {})))
                ([ { name = "the fake answers as the real tmuxes do, in every recorded state (TM68)"
                   , test = \_ -> Expect.equal [] fakeDiffers
                   }
                 , { name = "every question puritty asks in the scenarios is recorded from a real tmux (TM69)"
                   , test = \_ -> Expect.equal "" unrecorded
                   }
                 , { name = "a mistyped command ends control mode with tmux's message on the terminal, and nothing asked (TM70)"
                   , test =
                        \_ ->
                            -- as tmux 3.8 and 3.6a answer `tmux -CC attacth-t main`
                            Expect.equal
                                { said = "unknown command: attacth-t\u{000D}\n", asked = [] }
                                (failedStart "\u{001B}P1000punknown command: attacth-t\u{000D}\n%exit\u{000D}\n\u{001B}\\")
                   }
                 , { name = "an attach that fails ends control mode with tmux's error on the terminal, and nothing asked (TM70)"
                   , test =
                        \_ ->
                            -- as tmux answers `tmux -CC attach` with no server
                            Expect.equal
                                { said = "no sessions\u{000D}\n", asked = [] }
                                (failedStart "\u{001B}P1000p%begin 1794605254 322 0\u{000D}\nno sessions\u{000D}\n%error 1794605254 322 0\u{000D}\n%exit\u{000D}\n\u{001B}\\")
                   }
                 ]
                    ++ Array.flatten (Array.map onVersion RealTmux.versions)
                )
        }


{-| The tests that drive puritty, on one tmux version's fake. -}
onVersion : String -> Array { name : String, test : {} -> Expectation }
onVersion version =
    Array.map (\c -> { c | name = c.name ++ ", tmux " ++ version })
                [ { name = "attaching asks for nothing the fake does not know, and draws the pane"
                  , test =
                        \_ ->
                            let
                                seen =
                                    look (attached (start version))
                            in
                            Expect.equal
                                { unknown = [], first = "line 177", last = "line 200" }
                                { unknown = seen.run.world.unknown, first = row 0 seen, last = row 23 seen }
                  }
                , { name = "copy mode scrolled by k shows the lines tmux scrolled to (TM31)"
                  , test =
                        \_ ->
                            let
                                seen =
                                    attached (start version)
                                        |> inCopyMode 0
                                        |> keys 30
                                        |> look
                            in
                            -- copy mode's position at the top right, as tmux's
                            -- `[scroll/history]`
                            Expect.equal
                                { scroll = 7, top = { text = "line 170", edge = "[7/176]" } }
                                { scroll = (FakeTmux.copyState 0 seen.run.world).scroll, top = split 0 seen }
                  }
                , { name = "the tree of sessions shows the session, its windows and attachment, and q closes it (TM32)"
                  , test =
                        \_ ->
                            let
                                opened =
                                    look (prefixThen "s" (attached (start version)))

                                row1 =
                                    row 1 opened

                                title =
                                    String.contains "choose a session" (row 0 opened)

                                session =
                                    String.trim (String.slice 1 (String.count row1 - 1) row1)

                                closed =
                                    look (settle (typeKey "q" opened.run))
                            in
                            Expect.equal
                                { title = True, session = "0  ▸ main: 1 windows (attached)", after = "line 177" }
                                { title = title, session = session, after = row 0 closed }
                  }
                , { name = "the tree of windows opens the session and shows its window, flags and all (TM32)"
                  , test =
                        \_ ->
                            let
                                opened =
                                    look (prefixThen "w" (attached (start version)))

                                inner r =
                                    String.trim (String.slice 1 (String.count r - 1) r)
                            in
                            Expect.equal
                                [ "0  ▾ main: 1 windows (attached)", "1    ▸ 0: sh*" ]
                                [ inner (row 1 opened), inner (row 2 opened) ]
                  }
                , { name = "the command prompt runs what is typed as a tmux command (TM25)"
                  , test =
                        \_ ->
                            let
                                asked =
                                    prefixThen ":" (attached (start version))

                                box =
                                    TmuxMode.promptBox asked.tmux

                                typed =
                                    typeText "kill-server -a" asked

                                shown =
                                    TmuxMode.promptBox typed.tmux |> Maybe.map .typed

                                ran =
                                    settle (named enterKey typed)
                            in
                            Expect.equal
                                { opened = True, shown = Just "kill-server -a", closed = True, sent = True }
                                { opened = box /= Nothing
                                , shown = shown
                                , closed = TmuxMode.promptBox ran.tmux == Nothing
                                , sent = Array.member "kill-server -a" ran.world.unknown
                                }
                  }
                , { name = "the window menu shows tmux's items, and Rename asks with the window's name in the prompt (TM27)"
                  , test =
                        \_ ->
                            let
                                opened =
                                    look (prefixThen "<" (attached (start version)))

                                items =
                                    opened.rows
                                        |> Array.keepIf (\r -> String.startsWith "│" r)
                                        |> Array.map (\r -> String.trim (String.slice 1 (String.count r - 1) r))

                                renaming =
                                    settle (typeKey "n" opened.run)
                            in
                            Expect.equal
                                { items = [ "Swap Left", "Swap Right", "Swap Marked", "Kill       (X)", "Respawn    (R)", "Mark       (m)", "Rename     (n)", "New After  (w)", "New At End (W)" ]
                                , prompt = Just "sh"
                                }
                                { items = items, prompt = TmuxMode.promptBox renaming.tmux |> Maybe.map .typed }
                  }
                , { name = "the pane menu shows the items this tmux's binding has (TM27)"
                  , test =
                        \_ ->
                            let
                                opened =
                                    look (prefixThen ">" (attached (start version)))

                                items =
                                    opened.rows
                                        |> Array.keepIf (\r -> String.startsWith "│" r)
                                        |> Array.map (\r -> String.trim (String.slice 1 (String.count r - 1) r))
                            in
                            Expect.equal
                                (if version == "3.6a" then
                                    [ "Horizontal Split (h)", "Vertical Split   (v)", "Swap Up", "Swap Down", "Swap Marked", "Kill             (X)", "Respawn          (R)", "Mark             (m)", "Zoom" ]

                                 else
                                    [ "Float            (f)", "Horizontal Split (h)", "Vertical Split   (v)", "Swap Marked", "Kill             (X)", "Respawn          (R)", "Mark             (m)", "Zoom" ]
                                )
                                items
                  }
                , { name = "a key in copy mode keeps the view until tmux answers, no live screen behind it (TM67)"
                  , test =
                        \_ ->
                            let
                                -- k typed, tmux's answer not let through yet
                                waiting =
                                    attached (start version)
                                        |> inCopyMode 0
                                        |> keys 30
                                        |> typeKey "k"
                                        |> look

                                before =
                                    split 0 waiting

                                answered =
                                    look (settle waiting.run)
                            in
                            Expect.equal
                                { waiting = { text = "line 170", edge = "[7/176]" }, answered = { text = "line 169", edge = "[8/176]" } }
                                { waiting = before, answered = split 0 answered }
                  }
                ]


{-| The tests' server: one 80x24 pane that printed `line 1` to `line 200`. -}
start : String -> World
start version =
    FakeTmux.world { version = version, cols = 80, rows = 24, lines = numbered 200 }


{-| The fake in each state `record-tmux.py` recorded a real tmux in. -}
fakeIn : String -> String -> World
fakeIn version state =
    let
        server =
            start version

        up n w =
            if n <= 0 then w else up (n - 1) (FakeTmux.answer "send-keys -t %0 -X cursor-up" w).world
    in
    when state is
        "attached" ->
            server

        "copy mode" ->
            (FakeTmux.enterCopy 0 server).world

        "30 up" ->
            up 30 (FakeTmux.enterCopy 0 server).world

        "31 up" ->
            up 31 (FakeTmux.enterCopy 0 server).world

        _ ->
            server


{-| The lines inside the fake's reply blocks, empty ones too, as tmux sends
them; what it tells the client between blocks left out. -}
replyLines : String -> Array String
replyLines text =
    String.split "\n" text
        |> Array.map (\l -> if String.endsWith "\u{000D}" l then String.dropLast 1 l else l)
        |> Array.foldl
            (\l acc ->
                if String.startsWith "%begin" l then
                    { acc | inside = True }

                else if String.startsWith "%end" l || String.startsWith "%error" l then
                    { acc | inside = False }

                else if acc.inside then
                    { acc | lines = Array.pushLast l acc.lines }

                else
                    acc
            )
            { inside = False, lines = [] }
        |> .lines


{-| Each recorded answer, and the fake's to the same question in the same
state, where they differ: none when the fake is honest (TM68). -}
fakeDiffers : Array { version : String, state : String, command : String, real : Array String, fake : Array String }
fakeDiffers =
    RealTmux.answers
        |> Array.map
            (\a ->
                { version = a.version
                , state = a.state
                , command = a.command
                , real = a.lines
                , fake = replyLines (Bytes.toStringLossy (FakeTmux.answer a.command (fakeIn a.version a.state)).bytes)
                }
            )
        |> Array.keepIf (\d -> d.real /= d.fake)


{-| `k` typed `n` times, each answered before the next. -}
keys : Int -> (taken run : Run) -> Run
keys n run =
    if n <= 0 then
        run

    else
        keys (n - 1) (settle (typeKey "k" run))


{-| The scenarios: puritty driven against the fake from attaching. A
scenario whose questions are not all recorded fails `unrecorded`; one
added here is checked that way at once. -}
scenarios : Array String
scenarios =
    [ "attached", "copy mode", "tree of sessions", "tree closed", "tree of windows", "command prompt", "prompt run", "window menu", "rename from the menu", "pane menu" ]


{-| What a scenario leaves, on one version. -}
scenario : String -> String -> Run
scenario version name =
    let
        begun =
            attached (start version)
    in
    when name is
        "copy mode" ->
            keys 31 (inCopyMode 0 begun)

        "tree of sessions" ->
            prefixThen "s" begun

        "tree closed" ->
            settle (typeKey "q" (prefixThen "s" begun))

        "tree of windows" ->
            prefixThen "w" begun

        "prompt run" ->
            settle (named enterKey (typeText "kill-server -a" (prefixThen ":" begun)))

        "rename from the menu" ->
            settle (typeKey "n" (prefixThen "<" begun))

        "command prompt" ->
            prefixThen ":" begun

        "window menu" ->
            prefixThen "<" begun

        "pane menu" ->
            prefixThen ">" begun

        _ ->
            begun


{-| A command line that only asks (every command in it a query), which
can be put to a real tmux in a recorded state without changing it. -}
onlyAsks : String -> Bool
onlyAsks line =
    let
        names =
            Syntax.commands (Syntax.tokens line)
                |> Array.map (\c -> Array.first c |> Maybe.map .value |> Maybe.withDefault "")
    in
    not (Array.isEmpty names)
        && Array.all (\n -> Array.member n [ "display-message", "display", "list-windows", "list-panes", "list-sessions", "list-commands", "capture-pane" ]) names


{-| The questions the scenarios ask that are not recorded for their
version, as lines for `tmux-questions.txt`: empty when every one is. A
question asked in copy mode is recorded in "31 up"'s state; any other in
"attached"'s. -}
unrecorded : String
unrecorded =
    RealTmux.versions
        |> Array.mapAndFlatten
            (\version ->
                scenarios
                    |> Array.mapAndFlatten
                        (\name ->
                            let
                                state =
                                    if name == "copy mode" then "31 up" else "attached"
                            in
                            (scenario version name).world.heard
                                |> Array.keepIf onlyAsks
                                |> Array.keepIf (\line -> not (Array.any (\a -> a.version == version && a.state == state && a.command == line) RealTmux.answers))
                                |> Array.map (\line -> state ++ "\t" ++ line)
                        )
            )
        |> Array.foldl (\l acc -> if Array.member l acc then acc else Array.pushLast l acc) []
        |> String.join "\n"


{-| What puritty writes on the terminal and asks tmux when control mode
begins and ends with these bytes. -}
failedStart : String -> { said : String, asked : Array String }
failedStart bytes =
    let
        r =
            TmuxMode.read { cols = 80, rows = 25 } (Bytes.fromString bytes) (TmuxMode.idle {})
    in
    { said = Bytes.toStringLossy r.outside, asked = r.commands }

