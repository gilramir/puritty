    , "list-panes -s -F '#{window_id}	#{pane_id}	#{?#{pane_active},#{E:pane-active-border-style},#{E:pane-border-style}}'"
    , "list-windows -F '#{window_id}	#{?#{window_active},#I:#W#{?window_flags,#{window_flags}, },#I:#W#{?window_flags,#{window_flags}, }}'"
    , "list-windows -a -F 'W	#{session_id}	#{window_id}	#{window_index}	#{window_active}	#{window_panes}	#{window_activity}	#{window_name}	#{?#{window_marked_flag},#[reverse],}#{window_name}#{window_flags}#{?#{&&:#{==:#{window_panes},1},#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}}},: \"#{pane_title}\",}'"
    , "list-panes -a -F 'P	#{window_id}	#{pane_id}	#{pane_index}	#{pane_current_command}	#{?#{pane_marked},#[reverse],}#{pane_current_command}#{?#{pane_active},*,}#{?#{pane_marked},M,}#{?#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}},: \"#{pane_title}\",}'"
    , "list-windows -a -F 'W	#{session_id}	#{window_id}	#{window_index}	#{window_active}	#{window_panes}	#{window_activity}	#{window_name}	#{window_name}#{window_flags} (#{window_panes} panes)#{?#{==:#{window_panes},1}, \"#{pane_title}\",}'"
    , "list-panes -a -F 'P	#{window_id}	#{pane_id}	#{pane_index}	#{pane_current_command}	#{pane_current_command} \"#{pane_title}\"'"
    , "list-panes -s -F '#{window_id}	#{pane_id}	#{pane-border-status}'"
    ]


