    , { version = "2.7", state = "31 up", command = "list-windows -F '#{window_id}	#{?#{window_active},#I:#W#{?window_flags,#{window_flags}, },#I:#W#{?window_flags,#{window_flags}, }}'", lines = [ "@0	0:sh*" ] }
    , { version = "2.7", state = "31 up", command = "list-panes -s -F '#{window_id}	#{pane_id}	#{pane-border-status}'", lines = [ "@0	%0	off" ] }
    ]


{-| The questions recorded from `tmux-questions.txt`, what the tests'
scenarios ask: each version's answers to them are held to the fake's
only where that version's scenarios ask them. -}
asked : Array String
asked =
    [ "list-commands -F '#{command_list_name} #{command_list_alias}'"
    , "display-message -p '#{prefix} #{prefix2} #{repeat-time} #{version}'"
    , "list-panes -s -F 'M #{pane_id} #{pane_mode} #{mode-keys}'"
    , "display-message -p '#{display-panes-time}'"
    , "display-message -p '#{client_name}'"
    , "display-message -p -t '%0' 'P #{pane_id} #{pane_width} #{pane_height} #{cursor_x} #{cursor_y} #{alternate_on} #{scroll_region_upper} #{scroll_region_lower} #{pane_private_modes} #{mouse_standard_flag} #{mouse_button_flag} #{mouse_all_flag} #{mouse_sgr_flag} #{mouse_utf8_flag} #{keypad_cursor_flag} #{keypad_flag} #{cursor_flag} #{wrap_flag} #{origin_flag}' ; capture-pane -p -e -J -S - -E - -a -q -t '%0' ; capture-pane -p -e -J -S - -E - -t '%0'"
    , "display-message -p -t '%0' 'M #{pane_id} #{pane_mode} #{mode-keys}'"
    , "display-message -p -t '%0' 'C #{pane_id} #{scroll_position} #{history_size} #{copy_cursor_x} #{copy_cursor_y} #{selection_present} #{selection_start_x} #{selection_start_y} #{selection_end_x} #{selection_end_y} #{rectangle_toggle} #{search_present} #{search_count} #{search_count_partial} #{search_timed_out} #{pane_search_string}'"
    , "list-sessions -F 'S	#{session_id}	#{session_attached}	#{session_windows}	#{session_activity}	#{session_name}	#[fg=themelightgrey]#{session_windows} windows#{?session_grouped, (group #{session_group}: #{session_group_list}),}#{?session_attached, (attached),}'"
    , "list-windows -a -F 'W	#{session_id}	#{window_id}	#{window_index}	#{window_active}	#{window_panes}	#{window_activity}	#{window_name}	#{?window_marked_flag,#[fg=thememagenta],}#{window_name}#[fg=themelightgrey]#{window_flags}#{?#{&&:#{==:#{window_panes},1},#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}}},: \"#{pane_title}\",}'"
    , "list-panes -a -F 'P	#{window_id}	#{pane_id}	#{pane_index}	#{pane_current_command}	#{?pane_marked,#[fg=thememagenta],}#{?pane_floating_flag,#[underscore],}#{pane_current_command}#[fg=themelightgrey]#{pane_flags}#{?#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}},: \"#{pane_title}\",}'"
    , "list-windows -t '$0' -F 'Q #{window_id} 0 0 #{window_width} #{window_height} #{window_active} #{window_index}:#{window_name}	#{E:tree-mode-preview-style}'"
    , "capture-pane -p -t '@0'"
    , "list-panes -t '@0' -F 'Q #{pane_id} #{pane_left} #{pane_top} #{pane_width} #{pane_height} #{pane_active} #{pane_index}	#{E:tree-mode-preview-style}'"
    , "capture-pane -p -t '%0'"
    , "display-message -p -t '%0' -- '#[align=centre]#{window_index}:#{window_name}'"
    , "display-message -p -t '%0' -- '#{?#{>:#{session_windows},1},,-}Swap Left'"
    , "display-message -p -t '%0' -- '#{?#{>:#{session_windows},1},,-}Swap Right'"
    , "display-message -p -t '%0' -- '#{?pane_marked_set,,-}Swap Marked'"
    , "display-message -p -t '%0' -- '#{?pane_marked,Unmark,Mark}'"
    , "display-message -p -t '%0' -- 'command-prompt -F -I \"#W\" { rename-window -t \"#{window_id}\" \"%%%%\" }'"
    , "display-message -p -t '%0' -- '#[align=centre]#{pane_index} (#{pane_id})'"
    , "display-message -p -t '%0' -- '#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Top,}'"
    , "display-message -p -t '%0' -- '#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Bottom,}'"
    , "display-message -p -t '%0' -- '#{?#{==:#{pane_mode},copy-mode},#{?copy_line_numbers,Hide Line Numbers,Show Line Numbers},}'"
    , "display-message -p -t '%0' -- '#{?#{==:#{pane_mode},copy-mode},#{?refresh_active,Refresh Off,Refresh On},}'"
    , "display-message -p -t '%0' -- '#{?#{&&:#{buffer_size},#{!:#{pane_in_mode}}},Paste #[underscore]#{=/9/...:buffer_sample},}'"
    , "display-message -p -t '%0' -- '#{?@puritty_mouse_word,Search For #[underscore]#{=/9/...:@puritty_mouse_word},}'"
    , "display-message -p -t '%0' -- 'if-shell -F \"#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}\" \"copy-mode -t=\" ; send-keys -X -t %%0 search-backward -- \"#{q:@puritty_mouse_word}\"'"
    , "display-message -p -t '%0' -- '#{?@puritty_mouse_word,Type #[underscore]#{=/9/...:@puritty_mouse_word},}'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; send-keys -l \"#{q:@puritty_mouse_word}\"'"
    , "display-message -p -t '%0' -- '#{?@puritty_mouse_word,Copy #[underscore]#{=/9/...:@puritty_mouse_word},}'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; set-buffer \"#{q:@puritty_mouse_word}\"'"
    , "display-message -p -t '%0' -- '#{?@puritty_mouse_line,Copy Line,}'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; set-buffer \"#{q:@puritty_mouse_line}\"'"
    , "display-message -p -t '%0' -- '#{?mouse_hyperlink,Type #[underscore]#{=/9/...:mouse_hyperlink},}'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; send-keys -l \"#{q:mouse_hyperlink}\"'"
    , "display-message -p -t '%0' -- '#{?mouse_hyperlink,Copy #[underscore]#{=/9/...:mouse_hyperlink},}'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; set-buffer \"#{q:mouse_hyperlink}\"'"
    , "display-message -p -t '%0' -- '#{?#{#{pane_floating_flag}},Move,}'"
    , "display-message -p -t '%0' -- 'display-menu -T \"#[align=centre]Move\" -x L -y L Centre c { move-pane -P centre } '\\'''\\'' \"Top Left\" 1 { move-pane -P top-left } \"Top Right\" 2 { move-pane -P top-right } \"Bottom Left\" 3 { move-pane -P bottom-left } \"Bottom Right\" 4 { move-pane -P bottom-right } '\\'''\\'' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right }'"
    , "display-message -p -t '%0' -- '#{?#{#{pane_floating_flag}},Move & Resize,}'"
    , "display-message -p -t '%0' -- 'display-menu -T \"#[align=centre]Move & Resize\" -x L -y L Fill 0 { resize-pane -x \"100%%\" -y \"100%%\" ; move-pane -P top-left } '\\'''\\'' \"Top Left\" 1 { resize-pane -x \"50%%\" -y \"50%%\" ; move-pane -P top-left } \"Top Right\" 2 { resize-pane -x \"50%%\" -y \"50%%\" ; move-pane -P top-right } \"Bottom Left\" 3 { resize-pane -x \"50%%\" -y \"50%%\" ; move-pane -P bottom-left } \"Bottom Right\" 4 { resize-pane -x \"50%%\" -y \"50%%\" ; move-pane -P bottom-right } '\\'''\\'' Top t { resize-pane -x \"100%%\" -y \"50%%\" ; move-pane -P top-centre } Bottom b { resize-pane -x \"100%%\" -y \"50%%\" ; move-pane -P bottom-centre } Left l { resize-pane -x \"50%%\" -y \"100%%\" ; move-pane -P centre-left } Right r { resize-pane -x \"50%%\" -y \"100%%\" ; move-pane -P centre-right }'"
    , "display-message -p -t '%0' -- '#{?#{#{pane_floating_flag}},Tile,}'"
    , "display-message -p -t '%0' -- '#{?#{!:#{pane_floating_flag}},Float,}'"
    , "display-message -p -t '%0' -- '#{?#{!:#{pane_floating_flag}},Horizontal Split,}'"
    , "display-message -p -t '%0' -- '#{?#{!:#{pane_floating_flag}},Vertical Split,}'"
    , "display-message -p -t '%0' -- '#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Up,}'"
    , "display-message -p -t '%0' -- '#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Down,}'"
    , "display-message -p -t '%0' -- '#{?#{>:#{window_panes},1},,-}#{?window_zoomed_flag,Unzoom,Zoom}'"
    , "list-sessions -F 'S	#{session_id}	#{session_attached}	#{session_windows}	#{session_activity}	#{session_name}	#{session_windows} windows#{?session_grouped, (group #{session_group}: #{session_group_list}),}#{?session_attached, (attached),}'"
    , "list-windows -a -F 'W	#{session_id}	#{window_id}	#{window_index}	#{window_active}	#{window_panes}	#{window_activity}	#{window_name}	#{window_name}#{window_flags}#{?#{&&:#{==:#{window_panes},1},#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}}},: \"#{pane_title}\",}'"
    , "list-panes -a -F 'P	#{window_id}	#{pane_id}	#{pane_index}	#{pane_current_command}	#{pane_current_command}#{?pane_active,*,}#{?pane_marked,M,}#{?#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}},: \"#{pane_title}\",}'"
    , "display-message -p -t '%0' -- '#{?#{>:#{window_panes},1},,-}Swap Up'"
    , "display-message -p -t '%0' -- '#{?#{>:#{window_panes},1},,-}Swap Down'"
    , "list-commands"
    , "display-message -p -t '%0' -- 'if-shell -F \"#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}\" \"copy-mode -t=\" ; send-keys -X -t %%0 search-backward \"#{q:@puritty_mouse_word}\"'"
    , "display-message -p -t '%0' -- 'command-prompt -I \"#W\" \"rename-window -- '\\''%%%%'\\''\"'"
    , "display-message -p -t '%0' -- 'if -F \"#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}\" \"copy-mode -t=\" ; send -Xt= search-backward \"#{q:@puritty_mouse_word}\"'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; send-keys -l -- \"#{q:@puritty_mouse_word}\"'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; set-buffer -- \"#{q:@puritty_mouse_word}\"'"
    , "display-message -p -t '%0' -- 'copy-mode -q ; set-buffer -- \"#{q:@puritty_mouse_line}\"'"
