{-| The menus each version draws for the prefix and a key, with no
configuration, the items as their rows show them; none where the key
opens no menu. -}
menus : Array { version : String, key : String, items : Array String }
menus =
    [ { version = "3.8", key = "<", items = [ "Swap Left", "Swap Right", "Swap Marked", "Kill       (X)", "Respawn    (R)", "Mark       (m)", "Rename     (n)", "New After  (w)", "New At End (W)" ] }
    , { version = "3.8", key = ">", items = [ "Float            (f)", "Horizontal Split (h)", "Vertical Split   (v)", "Swap Marked", "Kill             (X)", "Respawn          (R)", "Mark             (m)", "Zoom" ] }
    , { version = "3.8", key = "w", items = [ "(0) - main: 1 windows (attached)", "(1) └─→ + 0: sh*" ] }
    , { version = "3.6a", key = "<", items = [ "Swap Left", "Swap Right", "Swap Marked", "Kill       (X)", "Respawn    (R)", "Mark       (m)", "Rename     (n)", "New After  (w)", "New At End (W)" ] }
    , { version = "3.6a", key = ">", items = [ "Horizontal Split (h)", "Vertical Split   (v)", "Swap Up", "Swap Down", "Swap Marked", "Kill             (X)", "Respawn          (R)", "Mark             (m)", "Zoom" ] }
    , { version = "3.6a", key = "w", items = [ "(0) - main: 1 windows (attached)", "(1) └─> + 0: sh*" ] }
    , { version = "3.4", key = "<", items = [ "Swap Left", "Swap Right", "Swap Marked", "Kill       (X)", "Respawn    (R)", "Mark       (m)", "Rename     (n)", "New After  (w)", "New At End (W)" ] }
    , { version = "3.4", key = ">", items = [ "Horizontal Split (h)", "Vertical Split   (v)", "Swap Up", "Swap Down", "Swap Marked", "Kill             (X)", "Respawn          (R)", "Mark             (m)", "Zoom" ] }
    , { version = "3.4", key = "w", items = [ "(0) - main: 1 windows (attached)", "(1) └─> 0: sh*" ] }
    , { version = "3.2a", key = "<", items = [ "Swap Left", "Swap Right", "Swap Marked", "Kill       (X)", "Respawn    (R)", "Mark       (m)", "Rename     (n)", "New After  (w)", "New At End (W)" ] }
    , { version = "3.2a", key = ">", items = [ "Horizontal Split (h)", "Vertical Split   (v)", "Swap Up", "Swap Down", "Swap Marked", "Kill             (X)", "Respawn          (R)", "Mark             (m)", "Zoom" ] }
    , { version = "3.2a", key = "w", items = [ "(0) - main: 1 windows (attached)", "(1) └─> 0: sh*" ] }
    , { version = "3.0", key = "<", items = [ "Swap Left  (l)", "Swap Right (r)", "Swap Marked", "Kill       (X)", "Respawn    (R)", "Mark       (m)", "Rename     (n)", "New After  (w)", "New At End (W)" ] }
    , { version = "3.0", key = ">", items = [ "Horizontal Split (h)", "Vertical Split   (v)", "Swap Up          (u)", "Swap Down        (d)", "Swap Marked", "Kill             (X)", "Respawn          (R)", "Mark             (m)", "Zoom             (z)" ] }
    , { version = "3.0", key = "w", items = [ "(0)  - main: 1 windows (attached)", "(1)  └─> 0: sh* (1 panes) \"host\"" ] }
