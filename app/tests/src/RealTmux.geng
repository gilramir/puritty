{-| Each version's options with no configuration, as a format gives
them (`#{status-style}`). -}
options : Array { version : String, values : Array { name : String, value : String } }
options =
    [ { version = "3.8"
      , values =
            [ { name = "backspace", value = "C-?" }
            , { name = "buffer-limit", value = "50" }
            , { name = "clear-on-attach", value = "1" }
            , { name = "command-alias[0]", value = "split-pane=split-window" }
            , { name = "command-alias[1]", value = "splitp=split-window" }
            , { name = "command-alias[2]", value = "server-info=show-messages -JT" }
            , { name = "command-alias[3]", value = "info=show-messages -JT" }
            , { name = "command-alias[4]", value = "choose-window=choose-tree -w" }
            , { name = "command-alias[5]", value = "choose-session=choose-tree -s" }
            , { name = "codepoint-widths", value = "" }
            , { name = "copy-command", value = "" }
            , { name = "default-client-command", value = "new-session" }
            , { name = "default-terminal", value = "tmux-256color" }
            , { name = "editor", value = "vim" }
            , { name = "escape-time", value = "10" }
            , { name = "exit-empty", value = "1" }
            , { name = "exit-unattached", value = "0" }
            , { name = "extended-keys", value = "off" }
            , { name = "extended-keys-format", value = "xterm" }
            , { name = "focus-events", value = "0" }
            , { name = "get-clipboard", value = "buffer" }
            , { name = "history-file", value = "" }
            , { name = "input-buffer-size", value = "1048576" }
            , { name = "message-limit", value = "1000" }
            , { name = "prefix-timeout", value = "0" }
            , { name = "prompt-history-limit", value = "100" }
            , { name = "set-clipboard", value = "external" }
            , { name = "terminal-overrides[0]", value = "linux*:AX@" }
            , { name = "terminal-features[0]", value = "xterm*:clipboard:ccolour:cstyle:focus:title" }
            , { name = "terminal-features[1]", value = "screen*:title" }
            , { name = "terminal-features[2]", value = "rxvt*:ignorefkeys" }
            , { name = "theme", value = "detect" }
            , { name = "dark-theme-black", value = "#{?#{e|>=:#{client_colours},256},gray5,black}" }
            , { name = "dark-theme-white", value = "#{?#{e|>=:#{client_colours},256},gray90,white}" }
            , { name = "dark-theme-light-grey", value = "#{?#{e|>=:#{client_colours},256},gray70,white}" }
            , { name = "dark-theme-dark-grey", value = "#{?#{e|>=:#{client_colours},256},gray15,black}" }
            , { name = "dark-theme-green", value = "#{?#{e|>=:#{client_colours},256},yellowgreen,green}" }
            , { name = "dark-theme-yellow", value = "#{?#{e|>=:#{client_colours},256},darkgoldenrod,yellow}" }
            , { name = "dark-theme-red", value = "#{?#{e|>=:#{client_colours},256},indianred,red}" }
            , { name = "dark-theme-blue", value = "#{?#{e|>=:#{client_colours},256},skyblue3,blue}" }
            , { name = "dark-theme-cyan", value = "#{?#{e|>=:#{client_colours},256},cadetblue,cyan}" }
            , { name = "dark-theme-magenta", value = "#{?#{e|>=:#{client_colours},256},mediumpurple,magenta}" }
            , { name = "light-theme-black", value = "#{?#{e|>=:#{client_colours},256},gray10,black}" }
            , { name = "light-theme-white", value = "#{?#{e|>=:#{client_colours},256},gray95,white}" }
            , { name = "light-theme-light-grey", value = "#{?#{e|>=:#{client_colours},256},gray80,white}" }
            , { name = "light-theme-dark-grey", value = "#{?#{e|>=:#{client_colours},256},gray45,black}" }
            , { name = "light-theme-green", value = "#{?#{e|>=:#{client_colours},256},seagreen,green}" }
            , { name = "light-theme-yellow", value = "#{?#{e|>=:#{client_colours},256},darkgoldenrod,yellow}" }
            , { name = "light-theme-red", value = "#{?#{e|>=:#{client_colours},256},indianred4,red}" }
            , { name = "light-theme-blue", value = "#{?#{e|>=:#{client_colours},256},steelblue,blue}" }
            , { name = "light-theme-cyan", value = "#{?#{e|>=:#{client_colours},256},darkcyan,cyan}" }
            , { name = "light-theme-magenta", value = "#{?#{e|>=:#{client_colours},256},purple4,magenta}" }
            , { name = "user-keys", value = "" }
            , { name = "variation-selector-always-wide", value = "1" }
            , { name = "activity-action", value = "other" }
            , { name = "assume-paste-time", value = "1" }
            , { name = "base-index", value = "0" }
            , { name = "bell-action", value = "any" }
            , { name = "default-command", value = "" }
            , { name = "default-shell", value = "/bin/zsh" }
            , { name = "default-size", value = "80x24" }
            , { name = "destroy-unattached", value = "off" }
            , { name = "detach-on-destroy", value = "on" }
            , { name = "display-time", value = "750" }
            , { name = "focus-follows-mouse", value = "0" }
            , { name = "history-limit", value = "2000" }
            , { name = "initial-repeat-time", value = "0" }
            , { name = "key-table", value = "root" }
            , { name = "lock-after-time", value = "0" }
            , { name = "lock-command", value = "lock -np" }
            , { name = "message-command-style", value = "bg=themeblack,fg=themeyellow,#{?#{m/r:(^|#,)IS(PANE|MODE)($|#,),#{prompt_flags}},,fill=themeblack}" }
            , { name = "message-format", value = "#[#{?#{command_prompt},#{E:message-command-style},#{E:message-style}}]#{message}" }
            , { name = "message-line", value = "0" }
            , { name = "message-style", value = "bg=themeyellow,fg=themeblack,#{?#{m/r:(^|#,)IS(PANE|MODE)($|#,),#{prompt_flags}},,fill=themeyellow}" }
            , { name = "mouse", value = "1" }
            , { name = "prefix", value = "C-b" }
            , { name = "prefix2", value = "None" }
            , { name = "renumber-windows", value = "0" }
            , { name = "repeat-time", value = "500" }
            , { name = "set-titles", value = "0" }
            , { name = "set-titles-string", value = "#S:#I:#W - \"#T\" #{session_alerts}" }
            , { name = "silence-action", value = "other" }
            , { name = "status", value = "on" }
            , { name = "status-bg", value = "default" }
            , { name = "status-fg", value = "default" }
            , { name = "status-format[0]", value = "#[align=left range=left #{E:status-left-style}]#[push-default]#{T;=/#{status-left-length}:status-left}#[pop-default]#[norange default]#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]#{W:#[range=window|#{window_index} #{E:window-status-style}#{?#{&&:#{window_last_flag},#{!=:#{E:window-status-last-style},default}}, #{E:window-status-last-style},}#{?#{&&:#{window_bell_flag},#{!=:#{E:window-status-bell-style},default}}, #{E:window-status-bell-style},#{?#{&&:#{||:#{window_activity_flag},#{window_silence_flag}},#{!=:#{E:window-status-activity-style},default}}, #{E:window-status-activity-style},}}]#[push-default]#{T:window-status-format}#[pop-default]#[norange default]#{?loop_last_flag,,#{E:window-status-separator}},#[range=window|#{window_index} list=focus #{?#{!=:#{E:window-status-current-style},default},#{E:window-status-current-style},#{E:window-status-style}}#{?#{&&:#{window_last_flag},#{!=:#{E:window-status-last-style},default}}, #{E:window-status-last-style},}#{?#{&&:#{window_bell_flag},#{!=:#{E:window-status-bell-style},default}}, #{E:window-status-bell-style},#{?#{&&:#{||:#{window_activity_flag},#{window_silence_flag}},#{!=:#{E:window-status-activity-style},default}}, #{E:window-status-activity-style},}}]#[push-default]#{T:window-status-current-format}#[pop-default]#[norange list=on default]#{?loop_last_flag,,#{E:window-status-separator}}}#[nolist align=right range=right #{E:status-right-style}]#[push-default]#{T;=/#{status-right-length}:status-right}#[pop-default]#[norange default]" }
            , { name = "status-format[1]", value = "#[align=left]#{R: ,#{e|-:#{w;T;=/#{status-left-length}:status-left},3}}P: #[norange default]#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]#{P:#[range=pane|#{pane_id} #{E:pane-status-style}]#[push-default]#{T:window-pane-status-format}#[pop-default]#[norange list=on default]#{?loop_last_flag,,#{E:window-status-separator}},#[range=pane|#{pane_id} list=focus #{?#{!=:#{E:pane-status-current-style},default},#{E:pane-status-current-style},#{E:pane-status-style}}]#[push-default]#{T:window-pane-current-status-format}#[pop-default]#[norange list=on default]#{?loop_last_flag,,#{E:window-status-separator}}}" }
            , { name = "status-format[2]", value = "#[align=left]#{R: ,#{e|-:#{w;T;=/#{status-left-length}:status-left},3}}S: #[norange default]#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]#{S:#[range=session|#{session_id} #{E:session-status-style}]#[push-default]#S#{q/h:session_alert}#[pop-default]#[norange list=on default]  ,#[range=session|#{session_id} list=focus #{?#{!=:#{E:session-status-current-style},default},#{E:session-status-current-style},#{E:session-status-style}}]#[push-default]#S*#{q/h:session_alert}#[pop-default]#[norange list=on default] }" }
            , { name = "status-interval", value = "15" }
            , { name = "status-justify", value = "left" }
            , { name = "status-keys", value = "vi" }
            , { name = "status-left", value = "[#{session_name}] " }
            , { name = "status-left-length", value = "10" }
            , { name = "status-left-style", value = "default" }
            , { name = "status-position", value = "bottom" }
            , { name = "status-right", value = "#{?window_bigger,[#{window_offset_x}#,#{window_offset_y}] ,}\"#{=21:pane_title}\" %H:%M %d-%b-%y" }
            , { name = "status-right-length", value = "40" }
            , { name = "status-right-style", value = "default" }
