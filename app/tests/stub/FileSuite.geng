module FileSuite exposing (settingsFile)

{-| On node, where there is no os package: the native suites' tests
(`native/src/FileSuite.geng`), each passed over, so that both count the
same. -}

import Expect
import Task
import Test.Runner.UnitNode as U


settingsFile : U.Suite
settingsFile =
    U.suite
        { name = "settings file"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            [ U.test "a setting written through config.toml as a symlink: the link kept, its file changed with its mode (review PS12)"
                (\_ -> Task.succeed Expect.pass)
            , U.test "a shell upload owns its own block of channels, not every channel after it (review ST9)"
                (\_ -> Task.succeed Expect.pass)
            , U.test "a dropped folder that can't be read is refused with why, not made empty on the host (review ST26)"
                (\_ -> Task.succeed Expect.pass)
            , U.test "a setting written to config.toml of mode 600: the mode kept, no temporary left (review PS12)"
                (\_ -> Task.succeed Expect.pass)
            , U.test "a setting written while another holds config.toml's lock: nothing written, and why; once let go, written, no temporary left (review PS12)"
                (\_ -> Task.succeed Expect.pass)
            ]
        }
