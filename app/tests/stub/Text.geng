module Text exposing (interfaceFont, ligatures, renderer, width)

{-| `packages/text`'s Geng side, for the app's tests on node: its widths
come from FreeType, which node cannot run. A character is taken as half
the font's size wide, which is near enough for a layout's tests (the
folder picker's, `docs/sftp.md` FT33). It must stay as
`packages/text/src/Text.geng` exposes it, so that a change there fails the
tests' build. -}

import Task exposing (Task)


renderer : String
renderer =
    "a stand-in: half an em a character"


interfaceFont : String -> Task x {}
interfaceFont _ =
    Task.succeed {}


ligatures : Bool -> Task x {}
ligatures _ =
    Task.succeed {}


width : Int -> String -> Int
width size text =
    String.count text * size // 2
