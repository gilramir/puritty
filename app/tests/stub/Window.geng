module Window exposing (Pointer(..), PointerEvent)

{-| The two types `TmuxMode` takes from the window, for its tests on node
(`docs/tmux.md` TM68): the X11 and Windows `Window` modules are C, which
node cannot run, and `TmuxMode` uses nothing else of theirs. They must stay
as `packages/x11/src/Window.geng` has them; a change there that `TmuxMode`
uses fails the tests' build, which is how a difference is noticed. -}


type Pointer
    = TextPointer
    | ArrowPointer
    | ResizeWidthPointer
    | ResizeHeightPointer
    | ResizeDownRightPointer
    | ResizeDownLeftPointer
    | MovePointer


type alias PointerEvent =
    { action : Int
    , button : Int
    , mods : Int
    , x : Int
    , y : Int
    , width : Int
    , height : Int
    , cellWidth : Int
    , cellHeight : Int
    }
