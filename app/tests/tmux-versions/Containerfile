# tmux's releases built from source and dumped (docs/tmux-versions.md):
# Debian 12, whose compiler still builds tmux 2.7, with what tmux needs and
# the Python dump-tmux.py runs on.
FROM docker.io/library/debian:12
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      build-essential pkg-config bison libevent-dev libncurses-dev python3 locales >/dev/null \
 && sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen >/dev/null
ENV LANG=en_US.UTF-8
