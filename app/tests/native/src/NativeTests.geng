module NativeTests exposing (main)

{-| The application's unit tests as a native program, run by
gren-unit-node's native runner: `AppSuites`, the suites `../run.sh` runs
on node, here compiled against the real X11 `Window` where node has
`stub/`'s. Run with `./run.sh`. -}

import AppSuites
import Os.Env
import Task exposing (Task)
import Test.Runner.UnitNode.Program as Program


main : Task Never {}
main =
    Os.Env.getEnvironment
        |> Task.andThen
            (\env ->
                Program.run env
                    { name = "puritty-app"
                    , version = "0.1.0"
                    , suites = AppSuites.suites
                    }
            )
