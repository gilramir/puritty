module SecretStore exposing (available, forget, read, write)

{-| Where a remembered password or passphrase would be kept: nowhere on
Linux for now (`docs/saved-secrets.md` PW7), so the box never offers to
remember one. `app/windows` keeps them in the Credential Manager.
-}

import Task exposing (Task)


available : Bool
available =
    False


read : String -> Task x (Result String String)
read _ =
    Task.succeed (Err "no store on Linux")


write : { target : String, user : String, secret : String } -> Task x (Result String {})
write _ =
    Task.succeed (Err "no store on Linux")


forget : String -> Task x Bool
forget _ =
    Task.succeed False
