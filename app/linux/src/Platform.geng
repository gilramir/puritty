module Platform exposing (Locale, copyToClipboard, defaultClient, font, interfaceFont, locale, logDirectory, pathSeparator, programs, settingsDirectory, sharedPrimary, sshConfig, start, stateDirectory)

{-| What puritty does differently on Linux and on Windows, other than its
window (`docs/windows.md` WS10, V55): this module is `app/linux`'s, and
`app/windows` has its own with the same functions.
-}

import Dict exposing (Dict)
import Reason
import Task exposing (Task)


{-| The directory of the settings file: `$XDG_CONFIG_HOME/puritty`, or
`~/.config/puritty`. -}
settingsDirectory : Dict String String -> Maybe String
settingsDirectory vars =
    let
        set name =
            Dict.get name vars
                |> Maybe.andThen
                    (\v ->
                        if v == "" then
                            Nothing

                        else
                            Just v
                    )
    in
    when set "XDG_CONFIG_HOME" is
        Just d ->
            Just (d ++ "/puritty")

        Nothing ->
            meant Reason.NotSet Maybe.map (\h -> h ++ "/.config/puritty") (set "HOME")


{-| Where each window's tabs are kept to restore them (docs/tabs.md TB10):
`$XDG_STATE_HOME/puritty/windows`, or `~/.local/state/puritty/windows`. -}
stateDirectory : Dict String String -> Maybe String
stateDirectory vars =
    let
        set name =
            Dict.get name vars
                |> Maybe.andThen
                    (\v ->
                        if v == "" then
                            Nothing

                        else
                            Just v
                    )
    in
    when set "XDG_STATE_HOME" is
        Just d ->
            Just (d ++ "/puritty/windows")

        Nothing ->
            meant Reason.NotSet Maybe.map (\h -> h ++ "/.local/state/puritty/windows") (set "HOME")


{-| Where the diagnostic logs are written (docs/diagnostics.md DG1):
`$XDG_STATE_HOME/puritty/logs`, or `~/.local/state/puritty/logs`. -}
logDirectory : Dict String String -> Maybe String
logDirectory vars =
    Maybe.map (\d -> String.dropLast (String.count "windows") d ++ "logs") (stateDirectory vars)


pathSeparator : String
pathSeparator =
    "/"


{-| The program run when the settings and the command line name none, as
the programs tried in order until one starts: `$SHELL`, else `/bin/sh`. -}
programs : Dict String String -> Array String
programs vars =
    when Dict.get "SHELL" vars is
        Just s ->
            if s == "" then
                [ "/bin/sh" ]

            else
                [ s ]

        Nothing ->
            meant Reason.NotSet [ "/bin/sh" ]


{-| The font drawn when the settings name none. -}
font : String
font =
    "DejaVu Sans Mono"


{-| What the locale says: the language fallback fonts are asked for (V25;
empty for none), and the character set of a local program's bytes. -}
type alias Locale =
    { language : String
    , charset : String
    }


{-| The locale, from `LC_ALL`, `LC_CTYPE` or `LANG`, the first one set. -}
locale : Dict String String -> Task x Locale
locale vars =
    Task.succeed { language = languageOf vars, charset = charsetOf vars }


{-| The remote character set a local program uses, from the locale's
codeset (`ko_KR.euckr`, `ko_KR.EUC-KR`, `ko_KR.CP949`, `ko_KR.UHC`):
`euc-kr`, `cp949`, else `utf-8` (`cjk-and-thai.md` §10.3 rule 1). -}
charsetOf : Dict String String -> String
charsetOf vars =
    let
        posix =
            [ "LC_ALL", "LC_CTYPE", "LANG" ]
                |> Array.mapAndKeepJust (\name -> Dict.get name vars)
                |> Array.findFirst (\v -> v /= "")
                |> Maybe.map .value
                |> Maybe.withDefault (meant Reason.NotSet "")

        codeset =
            String.split "." posix
                |> Array.get 1
                |> Maybe.withDefault (meant Reason.NotSet "")
                |> String.split "@"
                |> Array.first
                |> Maybe.withDefault ""
                |> String.toLower
                |> String.replace "-" ""
                |> String.replace "_" ""
    in
    if codeset == "euckr" then
        "euc-kr"

    else if codeset == "cp949" || codeset == "uhc" then
        "cp949"

    else
        "utf-8"


{-| The language fallback fonts are asked for when the file names none
(V25): the locale's, from `LC_ALL`, `LC_CTYPE` or `LANG` in that order,
as fontconfig names a language (`ja`, `ko`, `zh-tw`); none for `C` and
`POSIX`. -}
languageOf : Dict String String -> String
languageOf vars =
    let
        posix =
            [ "LC_ALL", "LC_CTYPE", "LANG" ]
                |> Array.mapAndKeepJust (\name -> Dict.get name vars)
                |> Array.findFirst (\v -> v /= "")
                |> Maybe.map .value
                |> Maybe.withDefault (meant Reason.NotSet "")

        base =
            posix
                |> String.split "."
                |> Array.first
                |> Maybe.withDefault ""
                |> String.split "@"
                |> Array.first
                |> Maybe.withDefault ""

        parts =
            String.split "_" base
    in
    when parts is
        [ lang, region ] ->
            if lang == "zh" then
                "zh-" ++ String.toLower region

            else
                String.toLower lang

        [ lang ] ->
            if lang == "C" || lang == "POSIX" then
                ""

            else
                String.toLower lang

        _ ->
            ""


{-| Where OpenSSH's own settings are: `~/.ssh/config`. -}
sshConfig : Dict String String -> Maybe String
sshConfig vars =
    Dict.get "HOME" vars
        |> Maybe.andThen
            (\h ->
                if h == "" then
                    Nothing

                else
                    Just (h ++ "/.ssh/config")
            )


{-| The client a host connects with when its `client` is unset
(`docs/ssh-client.md` SC12 question 5): OpenSSH's on Linux, where it
already passes EUC-KR through a pty. -}
defaultClient : String
defaultClient =
    "openssh"


{-| What `puritty` with nothing after it opens when `start` is unset
(`docs/settings-gui.md` SG8): a local shell, as a terminal opens. -}
start : String
start =
    "shell"


{-| The settings window's font (`docs/settings-gui.md` SG2): the system's
sans-serif, as fontconfig chooses it. The dash is escaped because
fontconfig's name syntax reads `-` as the start of a size: unescaped, the
name is the family `sans`, which only a system's own aliases make work. -}
interfaceFont : String
interfaceFont =
    "sans\\-serif"


{-| Whether a selection is also copied to the clipboard when the mouse
button is let go, unless the settings say (`docs/windows.md` WS27): off: PRIMARY is the selection there, and X programs keep it apart from the clipboard. -}
copyToClipboard : Bool
copyToClipboard =
    False


{-| Whether PRIMARY is shared with the desktop's other programs
(`docs/windows.md` WS27.2): X's PRIMARY is the desktop's, which every program reads and writes. -}
sharedPrimary : Bool
sharedPrimary =
    True
