diff --git a/src/terminal/PageList.zig b/src/terminal/PageList.zig
--- a/src/terminal/PageList.zig
+++ b/src/terminal/PageList.zig
@@ -2984,6 +2984,15 @@ fn resizeWithoutReflowGrowCols(
             if (cells[old_cols - 1].wide == .spacer_head) break :fast;
         }
 
+        // A wider row no longer reaches the edge, so it no longer wraps,
+        // as the slow path below leaves it (cloneRowFrom copies a partial
+        // row's flags from the new row); without this the flags were kept
+        // or dropped by the page's capacity (puritty harness/oracle/patches).
+        for (rows) |*row| {
+            row.wrap = false;
+            row.wrap_continuation = false;
+        }
+
         page.size.cols = cols;
         return;
     }
