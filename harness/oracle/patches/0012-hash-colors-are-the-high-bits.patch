+    /// Parse a channel of the `#` forms: XParseColor takes its 1 to 4 hex
+    /// digits as the channel's most significant bits, so `#f` is 0xf0 and
+    /// `#f00` and `#f000` are 0xf0 too, unlike `rgb:`, which scales
+    /// (puritty harness/oracle/patches).
+    fn fromHexHigh(value: []const u8) error{InvalidFormat}!u8 {
+        if (value.len == 0 or value.len > 4) {
+            @branchHint(.cold);
+            return error.InvalidFormat;
+        }
+
+        const color = lib.parseInt(u16, value, 16) catch {
+            @branchHint(.cold);
+            return error.InvalidFormat;
+        };
+
+        return switch (value.len) {
+            1 => @intCast(color << 4),
+            2 => @intCast(color),
+            3 => @intCast(color >> 4),
+            4 => @intCast(color >> 8),
+            else => unreachable,
+        };
+    }
+
