+/// The column print stops at: the right margin when the cursor is at or
+/// left of it, the screen's edge when it is past it.
+fn rightLimit(self: *const Terminal) usize {
+    return if (self.screens.active.cursor.x > self.scrolling_region.right)
+        self.cols
+    else
+        self.scrolling_region.right + 1;
+}
