module Main exposing (main)

{-| core-dump: the core's side of the replay corpus and the oracle.

Feeds FILE to a `Vt.Term` of COLS by ROWS, CHUNK bytes a read (the whole
file when CHUNK is 0 or left out), and prints `Vt.dump`. RESIZES is
`AT:COLSxROWS` items joined by commas: before byte AT the terminal is
resized, as its host resizes it (`docs/vt-core.md` §VC14), and a read never
crosses one.

usage: core-dump COLS ROWS FILE [CHUNK [RESIZES]]

-}

import Bytes exposing (Bytes)
import Console
import Os.Env
import Os.File
import Os.Path
import Task exposing (Task)
import Vt


feedAll : Bytes -> Int -> Array { at : Int, cols : Int, rows : Int } -> Int -> (moved t : Vt.Term) -> Vt.Term
feedAll bytes chunk resizes at t =
    when Array.first resizes is
        Just r ->
            if r.at <= at then
                feedAll bytes chunk (Array.dropFirst 1 resizes) at (Vt.resize r.cols r.rows t)

            else
                feedAll bytes chunk resizes (min r.at (at + chunk)) (Vt.feed (Bytes.slice at (min r.at (at + chunk)) bytes) t)

        Nothing ->
            if at >= Bytes.length bytes then
                t

            else
                feedAll bytes chunk resizes (at + chunk) (Vt.feed (Bytes.slice at (at + chunk) bytes) t)


{-| `AT:COLSxROWS,...`; an item that does not read is left out. -}
resizesOf : String -> Array { at : Int, cols : Int, rows : Int }
resizesOf text =
    Array.mapAndKeepJust
        (\item ->
            when String.split ":" item is
                [ at, size ] ->
                    when String.split "x" size is
                        [ c, r ] ->
                            Maybe.map3 (\a cc rr -> { at = a, cols = cc, rows = rr }) (String.toInt at) (String.toInt c) (String.toInt r)

                        _ ->
                            Nothing

                _ ->
                    Nothing
        )
        (String.split "," text)


number : Int -> Array String -> Int
number i args =
    Maybe.withDefault 0 (Maybe.andThen String.toInt (Array.get i args))


main : Task Never {}
main =
    Task.map2 (\e perm -> { args = e.args, raw = e.argsAsBytes, perm = perm }) Os.Env.getEnvironment Os.File.initialize
        |> Task.andThen
            (\s ->
                if Array.length s.args < 3 then
                    Console.write "usage: core-dump COLS ROWS FILE [CHUNK]\n"

                else
                    Os.File.readFile s.perm (Os.Path.fromBytes (Maybe.withDefault Bytes.empty (Array.get 2 s.raw)))
                        |> Task.andThen
                            (\bytes ->
                                let
                                    chunk =
                                        number 3 s.args

                                    term =
                                        Vt.new { cols = number 0 s.args, rows = number 1 s.args, scrollbackBytes = Vt.scrollbackBytesFor { cols = number 0 s.args, rows = 25000 }, checksums = True, cellWidth = 10, cellHeight = 20 }
                                in
                                Console.write
                                    (Vt.dump
                                        (feedAll bytes
                                            (if chunk <= 0 then
                                                max 1 (Bytes.length bytes)

                                             else
                                                chunk
                                            )
                                            (resizesOf (Maybe.withDefault "" (Array.get 4 s.args)))
                                            0
                                            term
                                        )
                                    )
                            )
                        |> Task.onError (\_ -> Console.write "core-dump: cannot read the file\n")
            )
