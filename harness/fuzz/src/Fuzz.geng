module Fuzz exposing (dump)

{-| The core as a library for the fuzzer (docs/vt-core.md §VC11). -}

import Bytes exposing (Bytes)
import UInt8
import Vt


{-| The dump of a terminal of `cols` by `rows`, keeping `scrollback` lines,
fed `input`, `chunk` bytes a read, the whole of it in one read when `chunk`
is 0 or less. `vt-fuzz` keeps 600, three pages, so that a resize meets
pages cut at another width (V10); `vt-diff` keeps 10,000, as it has
Ghostty keep at least (`diff.h`).

A 0xFE byte of the input is not fed: with the two bytes after it, it
resizes the terminal, to the columns the first indexes in `colsTable` and
the rows the second indexes in `rowsTable`, as an input's first two bytes
choose its size (`fuzz.c`, §VC14). A read never crosses one, so the two
runs resize between the same bytes. UTF-8 has no 0xFE, and 0xFF still
tries the decoder with a byte it has no use for. -}
dump : Int -> Int -> Int -> Int -> Bytes -> String
dump cols rows chunk scrollback input =
    let
        n =
            Bytes.length input

        step =
            if chunk <= 0 then
                max 1 n

            else
                chunk
    in
    let
        done =
            run scrollback input step (marks input 0 []) 0 False (Vt.new { cols = cols, rows = rows, scrollback = scrollback, checksums = True, cellWidth = 10, cellHeight = 20 })
    in
    if done.full || Vt.historyBound done.term >= scrollback then
        Vt.dump done.term ++ "pruned\n"

    else
        Vt.dump done.term


colsTable : Array Int
colsTable =
    [ 1, 2, 3, 4, 5, 8, 10, 13, 20, 40, 80, 132 ]


rowsTable : Array Int
rowsTable =
    [ 1, 2, 3, 4, 5, 8, 10, 24, 25, 50 ]


byteAt : Bytes -> Int -> Int
byteAt bytes i =
    when Bytes.get i bytes is
        Just b ->
            UInt8.toInt b

        Nothing ->
            0


pick : Array Int -> Int -> Int
pick table b =
    Maybe.withDefault 1 (Array.get (modBy (Array.length table) b) table)


{-| Where the resizes are, in order. -}
marks : Bytes -> Int -> Array Int -> Array Int
marks bytes i found =
    if i >= Bytes.length bytes then
        found

    else if byteAt bytes i == 0xFE then
        marks bytes (i + 3) (Array.pushLast i found)

    else
        marks bytes (i + 1) found


{-| The input fed, and whether the scrollback may have reached `limit`
before a resize (`full`), which a widening could bring back under it with
rows the core and Ghostty pruned differently: then the dump says `pruned`
and `diff.h` leaves the scrollback out (§VC17). -}
run : Int -> Bytes -> Int -> Array Int -> Int -> Bool -> (moved t : Vt.Term) -> { term : Vt.Term, full : Bool }
run limit bytes chunk resizes at full t =
    let
        next =
            Maybe.withDefault (Bytes.length bytes) (Array.first resizes)
    in
    if at >= Bytes.length bytes then
        { term = t, full = full }

    else if at == next then
        let
            reached =
                full || Vt.historyBound t >= limit
        in
        run limit bytes chunk (Array.dropFirst 1 resizes) (at + 3) reached (Vt.resize (pick colsTable (byteAt bytes (at + 1))) (pick rowsTable (byteAt bytes (at + 2))) t)

    else
        let
            stop =
                min next (at + chunk)
        in
        run limit bytes chunk resizes stop full (Vt.feed (Bytes.slice at stop bytes) t)
