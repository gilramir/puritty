module Fuzz exposing (dump)

{-| The core as a library for the fuzzer (docs/vt-core.md §VC11). -}

import Bytes exposing (Bytes)
import UInt8
import Vt


{-| The dump of a terminal of `cols` by `rows`, keeping the bytes of
`scrollback` rows of the widest width the fuzzer resizes to (132 columns,
`Vt.scrollbackBytesFor`, V21), fed `input`, `chunk` bytes a read, the whole
of it in one read when `chunk` is 0 or less. `vt-fuzz` asks for 600, so that
a resize cuts pages again on their bytes (V20), and while the scrollback is
under 1,200 rows the pages are held to the reflow of their rows at five
widths (`Vt.recutHolds`, §VC31); `vt-diff` asks for 10,000, which it has
Ghostty keep (`diff.h`), and the dump says `pruned` once either may have
pruned (`Vt.historyReached`).

A 0xFE byte of the input is not fed: with the two bytes after it, it
resizes the terminal, to the columns the first indexes in `colsTable` and
the rows the second indexes in `rowsTable`, as an input's first two bytes
choose its size (`fuzz.c`, §VC14). A read never crosses one, so the two
runs resize between the same bytes. UTF-8 has no 0xFE, and 0xFF still
tries the decoder with a byte it has no use for. -}
dump : Int -> Int -> Int -> Int -> Bytes -> String
dump cols rows chunk scrollback input =
    let
        n =
            Bytes.length input

        step =
            if chunk <= 0 then
                max 1 n

            else
                chunk
    in
    let
        done =
            run input step (marks input 0 []) 0 (Vt.new { cols = cols, rows = rows, scrollbackBytes = Vt.scrollbackBytesFor { cols = 132, rows = scrollback }, pageRows = 256, checksums = True, cellWidth = 10, cellHeight = 20 })

        -- with a small scrollback, as vt-fuzz keeps, the pages cut again on
        -- their bytes at other widths are held to the rows the reflow of
        -- the ring's rows makes of them (V20, §VC31)
        recut =
            if scrollback <= 600 && Vt.historyBound done <= 1200 && not (Vt.recutHolds 1 done && Vt.recutHolds 3 done && Vt.recutHolds 7 done && Vt.recutHolds 13 done && Vt.recutHolds 80 done) then
                "recut differs\n"

            else
                ""
    in
    if Vt.historyReached scrollback done then
        recut ++ Vt.dump done ++ "pruned\n"

    else
        recut ++ Vt.dump done


colsTable : Array Int
colsTable =
    [ 1, 2, 3, 4, 5, 8, 10, 13, 20, 40, 80, 132 ]


rowsTable : Array Int
rowsTable =
    [ 1, 2, 3, 4, 5, 8, 10, 24, 25, 50 ]


byteAt : Bytes -> Int -> Int
byteAt bytes i =
    when Bytes.get i bytes is
        Just b ->
            UInt8.toInt b

        Nothing ->
            0


pick : Array Int -> Int -> Int
pick table b =
    Maybe.withDefault 1 (Array.get (modBy (Array.length table) b) table)


{-| Where the resizes are, in order. -}
marks : Bytes -> Int -> Array Int -> Array Int
marks bytes i found =
    if i >= Bytes.length bytes then
        found

    else if byteAt bytes i == 0xFE then
        marks bytes (i + 3) (Array.pushLast i found)

    else
        marks bytes (i + 1) found


{-| The input fed. Whether the scrollback may have reached its limit is the
core's to say (`Vt.historyReached`), since a resize by DECCOLM inside a read
can bring a pruned scrollback back under it before the read ends (§VC25). -}
run : Bytes -> Int -> Array Int -> Int -> (moved t : Vt.Term) -> Vt.Term
run bytes chunk resizes at t =
    let
        next =
            Maybe.withDefault (Bytes.length bytes) (Array.first resizes)
    in
    if at >= Bytes.length bytes then
        t

    else if at == next then
        run bytes chunk (Array.dropFirst 1 resizes) (at + 3) (Vt.resize (pick colsTable (byteAt bytes (at + 1))) (pick rowsTable (byteAt bytes (at + 2))) t)

    else
        let
            stop =
                min next (at + chunk)
        in
        run bytes chunk resizes stop (Vt.feed (Bytes.slice at stop bytes) t)
