module Main exposing (main)

{-| core-pixels: the pixel gate's program (`docs/renderer.md` §R13).

Feeds FILE to a `Vt.Term` of COLS by ROWS and draws it in a window of
`packages/x11`, as puritty does, under FONT at POINTS with LANG for the
fallback fonts; then writes the window to OUT as a PPM. BREAKS is byte
offsets joined by commas (or empty): the bytes before each are fed and a
frame drawn, so that a later frame draws only what changed, as the app's
do; a last frame follows the last byte, and the frames the view then asks
for at once (`View.wantsFrame`). FOCUS `unfocused` draws as a
window without the focus does. `harness/pixels.py` holds the pictures to
their pins.

FOCUS `ui` takes FILE as a display list of the settings window's records
instead (6 a rounded box, 7 text, 8 a clip, 9 text in a named font;
`docs/settings-gui.md` SG2, SG7), drawn as one frame of the window's size
with UIFONT as the interface font.

Exits 1, saying why, when the window will not open or the picture cannot
be written.

usage: core-pixels COLS ROWS FILE OUT FONT POINTS LANG BREAKS [FOCUS [UIFONT]]

-}

import Bytes exposing (Bytes)
import Console
import Os.Env
import Os.File
import Os.Path
import Task exposing (Task)
import Text
import UInt8
import Vt
import Vt.View as View
import Window


type alias Run =
    { term : Vt.Term
    , shadow : View.Shadow
    }


{-| Feeds the bytes up to each break and draws a frame, then the rest and
a last frame. -}
feedAll : View.Focus -> Bytes -> Array Int -> Int -> (taken r : Run) -> Task x Run
feedAll focus bytes breaks at r =
    let
        stop =
            when Array.first breaks is
                Just b ->
                    max at (min b (Bytes.length bytes))

                Nothing ->
                    Bytes.length bytes

        term =
            Vt.feed (Bytes.slice at stop bytes) r.term

        f =
            View.frame View.defaultLook focus term r.shadow
    in
    Window.draw f.list
        |> Task.andThen
            (\answer ->
                let
                    next =
                        { term = term, shadow = View.inked (Maybe.withDefault Bytes.empty answer) f.shadow }
                in
                if Array.isEmpty breaks then
                    settle focus 4 next

                else
                    feedAll focus bytes (Array.dropFirst 1 breaks) stop next
            )


{-| Frames drawn with nothing new fed while the view wants one (V40), as
the app draws them at once; at most `n`. -}
settle : View.Focus -> Int -> (taken r : Run) -> Task x Run
settle focus n r =
    if n <= 0 || not (View.wantsFrame r.shadow) then
        Task.succeed r

    else
        let
            f =
                View.frame View.defaultLook focus r.term r.shadow
        in
        Window.draw f.list
            |> Task.andThen (\answer -> settle focus (n - 1) { term = r.term, shadow = View.inked (Maybe.withDefault Bytes.empty answer) f.shadow })


number : Int -> Array String -> Int
number i args =
    Maybe.withDefault 0 (Maybe.andThen String.toInt (Array.get i args))


arg : Int -> Array String -> String
arg i args =
    Maybe.withDefault "" (Array.get i args)


failWith : String -> Task x {}
failWith why =
    Console.write ("core-pixels: " ++ why ++ "\n")
        |> Task.andThen (\_ -> Os.Env.exitWithCode 1)


main : Task Never {}
main =
    Task.map2 (\e perm -> { args = e.args, raw = e.argsAsBytes, perm = perm }) Os.Env.getEnvironment Os.File.initialize
        |> Task.andThen
            (\s ->
                if Array.length s.args < 8 then
                    failWith "usage: core-pixels COLS ROWS FILE OUT FONT POINTS LANG BREAKS [FOCUS [UIFONT]]"

                else
                    Os.File.readFile s.perm (Os.Path.fromBytes (Maybe.withDefault Bytes.empty (Array.get 2 s.raw)))
                        |> Task.map Ok
                        |> Task.onError (\_ -> Task.succeed (Err {}))
                        |> Task.andThen
                            (\read ->
                                when read is
                                    Err {} ->
                                        failWith "cannot read the file"

                                    Ok bytes ->
                                        draw s.args bytes
                            )
            )


draw : Array String -> Bytes -> Task x {}
draw args bytes =
    let
        cols =
            number 0 args

        rows =
            number 1 args
    in
    Window.open
        { cols = cols
        , rows = rows
        , font = arg 4 args
        , points = number 5 args
        , lang = arg 6 args
        , glyphCap = 8 * 1024 * 1024
        , title = "core-pixels"
        }
        |> Task.andThen
            (\opened ->
                when opened is
                    Err why ->
                        failWith ("cannot open the window: " ++ why)

                    Ok cell ->
                      if Array.get 8 args == Just "ui" then
                        drawList cols rows bytes (arg 9 args)
                            |> Task.andThen (\_ -> shot args)

                      else
                        feedAll
                            { focused = Array.get 8 args /= Just "unfocused", blinkOn = True }
                            bytes
                            (Array.mapAndKeepJust String.toInt (String.split "," (arg 7 args)))
                            0
                            { term =
                                Vt.new
                                    { cols = cols
                                    , rows = rows
                                    , scrollbackBytes = Vt.scrollbackBytesFor { cols = cols, rows = 1000 }
                                    , pageRows = 256
                                    , checksums = False
                                    , cellWidth = cell.width
                                    , cellHeight = cell.height
                                    }
                            , shadow = View.shadow cols rows
                            }
                            |> Task.andThen (\_ -> shot args)
            )


shot : Array String -> Task x {}
shot args =
    Window.shot (arg 3 args)
        |> Task.andThen
            (\ok ->
                if ok then
                    Task.succeed {}

                else
                    failWith "cannot write the picture"
            )


{-| A display list of the settings window's records, after the record of
the window's size, drawn in one frame with `font` as the interface font. -}
drawList : Int -> Int -> Bytes -> String -> Task x {}
drawList cols rows list font =
    let
        u16 n =
            [ n // 256, modBy 256 n ]

        size =
            Bytes.fromUInt8s (Array.map UInt8.fromIntWrap ([ 4 ] ++ u16 cols ++ u16 rows))
    in
    Text.interfaceFont font
        |> Task.andThen (\_ -> Window.draw (Bytes.flatten [ size, list ]))
        |> Task.map (\_ -> {})
