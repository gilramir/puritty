module Store exposing (main)

{-| The settings file's writes (`docs/settings.md` ST6, ST18), on the
system: `SettingsFile.change` over a file in a directory the command line
names, each step's file, its backup and any `.new` left written to
standard output, for `harness/store.py` to hold to its pin on Linux and
on Windows. `Platform` is `app/linux`'s on both: nothing here asks it.

usage: store DIR
-}

import Bytes exposing (Bytes)
import Console
import Os.Env
import Os.File as File
import Os.Path as Path exposing (Path)
import Schema
import SettingsFile exposing (Store)
import Task exposing (Task)


line : String -> Task x {}
line s =
    Console.write (s ++ "\n")


set : Array String -> Schema.Value -> Store -> Task String Store
set key value s =
    when Schema.find key is
        Just setting ->
            SettingsFile.change (Schema.write setting value) s

        Nothing ->
            Task.fail ("no setting " ++ String.join "." key)


main : Task Never {}
main =
    Task.map2 (\e fs -> { args = e.args, fs = fs }) Os.Env.getEnvironment File.initialize
        |> Task.andThen
            (\ctx ->
                when Array.get 0 ctx.args is
                    Nothing ->
                        line "usage: store DIR"

                    Just dir ->
                        steps ctx.fs (Path.fromString dir)
                            |> Task.onError (\why -> line ("stopped: " ++ why))
            )


steps : File.Permission -> Path -> Task String {}
steps fs dir =
    let
        sub =
            Path.append (Path.fromString "made") dir

        path =
            Path.append (Path.fromString "config.toml") sub

        at name =
            Path.append (Path.fromString name) sub

        read p =
            File.readFile fs p
                |> Task.map (\b -> Maybe.withDefault "(not UTF-8)" (Bytes.toString b))
                |> Task.onError (\_ -> Task.succeed "(none)")

        show label =
            Task.map3 (\file bak new -> { file = file, bak = bak, new = new }) (read path) (read (at "config.toml.bak")) (read (at "config.toml.new"))
                |> Task.andThen
                    (\r ->
                        line ("== " ++ label)
                            |> Task.andThen (\_ -> line ("file: " ++ r.file))
                            |> Task.andThen (\_ -> line ("bak: " ++ r.bak))
                            |> Task.andThen (\_ -> line ("new: " ++ r.new))
                    )

        hand text =
            File.writeFile fs (Bytes.fromString text) path |> Task.mapError (\_ -> "could not write by hand")

        tried label task =
            task
                |> Task.map (\_ -> "written")
                |> Task.onError (\why -> Task.succeed ("refused: " ++ String.replace (Path.toString path) "FILE" why))
                |> Task.andThen (\r -> line ("== " ++ label ++ ": " ++ r))
                |> Task.andThen (\_ -> show (label ++ ", after"))
    in
    set [ "font", "size" ] (Schema.Whole 14) (SettingsFile.store fs path)
        |> Task.andThen (\s -> show "a setting into a file and a directory not there" |> Task.map (\_ -> s))
        |> Task.andThen (set [ "font", "size" ] (Schema.Whole 14))
        |> Task.andThen (\s -> show "the same value again writes nothing" |> Task.map (\_ -> s))
        |> Task.andThen (\s -> hand "# kept by hand\n[font]\nsize = 14 # mine\n" |> Task.map (\_ -> s))
        |> Task.andThen (set [ "colours", "background" ] (Schema.Colour 0x102030))
        |> Task.andThen (\s -> show "a hand edit since is kept; the session's backup is not made twice" |> Task.map (\_ -> s))
        |> Task.andThen (\_ -> set [ "font", "size" ] (Schema.Whole 12) (SettingsFile.store fs path))
        |> Task.andThen (\s -> show "a new session backs the file up as it was" |> Task.map (\_ -> s))
        |> Task.andThen (set [ "font", "size" ] (Schema.Whole 11))
        |> Task.andThen (set [ "colours", "background" ] (Schema.Colour 0x1D1F21))
        |> Task.andThen (\s -> show "both reset: the keys go, and a table left empty unless a comment is over it" |> Task.map (\_ -> s))
        |> Task.andThen (\s -> hand "[font\nsize = 3\n" |> Task.map (\_ -> s))
        |> Task.andThen (\s -> tried "a file that is not TOML" (set [ "font", "size" ] (Schema.Whole 13) s))
        |> Task.andThen (\_ -> File.writeFile fs (Bytes.fromUInt8s []) path |> Task.mapError (\_ -> "could not empty the file"))
        |> Task.andThen (\_ -> line "== done")
