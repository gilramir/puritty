module Main exposing (main)

{-| core-view: the display-list gate's program (`docs/renderer.md` §R8).

Feeds FILE to a `Vt.Term` of COLS by ROWS, CHUNK bytes a read, and after
each read draws a frame with `Vt.View` and the default look, printing its
display list as a line, `frame` and the list in hex (nothing after `frame`
when the frame changes nothing). RESIZES is `AT:COLSxROWS` items joined by
commas, as `core-dump` reads them: before byte AT the terminal is resized,
and a read never crosses one. FOCUS `unfocused` draws as a window without
the focus does. `harness/view.py` decodes the lists and holds them to their
pins.

usage: core-view COLS ROWS FILE CHUNK [RESIZES [FOCUS]]

-}

import Array.Builder as Builder exposing (Builder)
import Bytes exposing (Bytes)
import Console
import Os.Env
import Os.File
import Os.Path
import Task exposing (Task)
import Vt
import Vt.View as View


type alias Run =
    { term : Vt.Term
    , shadow : View.Shadow
    , focus : View.Focus
    , out : Builder String
    }


feedAll : Bytes -> Int -> Array { at : Int, cols : Int, rows : Int } -> Int -> (moved r : Run) -> Run
feedAll bytes chunk resizes at r =
    let
        stop =
            when Array.first resizes is
                Just z ->
                    min z.at (at + chunk)

                Nothing ->
                    at + chunk
    in
    when Array.first resizes is
        Just z ->
            if z.at <= at then
                feedAll bytes chunk (Array.dropFirst 1 resizes) at { r | term = Vt.resize z.cols z.rows r.term }

            else
                feedAll bytes chunk resizes stop (framed { r | term = Vt.feed (Bytes.slice at stop bytes) r.term })

        Nothing ->
            if at >= Bytes.length bytes then
                r

            else
                feedAll bytes chunk resizes stop (framed { r | term = Vt.feed (Bytes.slice at stop bytes) r.term })


{-| A frame of the term as it stands, its list added to the output. -}
framed : (moved r : Run) -> Run
framed r =
    let
        f =
            View.frame View.defaultLook r.focus r.term r.shadow
    in
    { r | shadow = f.shadow, out = Builder.pushLast ("frame " ++ Bytes.toHexString { padding = True } f.list ++ "\n") r.out }


{-| `AT:COLSxROWS,...`; an item that does not read is left out. -}
resizesOf : String -> Array { at : Int, cols : Int, rows : Int }
resizesOf text =
    Array.mapAndKeepJust
        (\item ->
            when String.split ":" item is
                [ at, size ] ->
                    when String.split "x" size is
                        [ c, r ] ->
                            Maybe.map3 (\a cc rr -> { at = a, cols = cc, rows = rr }) (String.toInt at) (String.toInt c) (String.toInt r)

                        _ ->
                            Nothing

                _ ->
                    Nothing
        )
        (String.split "," text)


number : Int -> Array String -> Int
number i args =
    Maybe.withDefault 0 (Maybe.andThen String.toInt (Array.get i args))


main : Task Never {}
main =
    Task.map2 (\e perm -> { args = e.args, raw = e.argsAsBytes, perm = perm }) Os.Env.getEnvironment Os.File.initialize
        |> Task.andThen
            (\s ->
                if Array.length s.args < 4 then
                    Console.write "usage: core-view COLS ROWS FILE CHUNK [RESIZES]\n"

                else
                    Os.File.readFile s.perm (Os.Path.fromBytes (Maybe.withDefault Bytes.empty (Array.get 2 s.raw)))
                        |> Task.andThen
                            (\bytes ->
                                let
                                    cols =
                                        number 0 s.args

                                    rows =
                                        number 1 s.args

                                    term =
                                        Vt.new { cols = cols, rows = rows, scrollbackBytes = Vt.scrollbackBytesFor { cols = cols, rows = 25000 }, pageRows = 256, checksums = True, cellWidth = 10, cellHeight = 20 }

                                    r =
                                        feedAll bytes
                                            (max 1 (number 3 s.args))
                                            (resizesOf (Maybe.withDefault "" (Array.get 4 s.args)))
                                            0
                                            { term = term
                                            , shadow = View.shadow cols rows
                                            , focus = { focused = Array.get 5 s.args /= Just "unfocused", blinkOn = True }
                                            , out = Builder.empty 16
                                            }
                                in
                                Console.write (String.join "" (Builder.toArray r.out))
                            )
                        |> Task.onError (\_ -> Console.write "core-view: cannot read the file\n")
            )
