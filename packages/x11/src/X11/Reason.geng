module X11.Reason exposing (Reason(..))

{-| Why a fallback in this package runs: each `meant` names one of these
(geng-lang `docs/user/checks.md`), and `geng checks` holds every one to
running and every reason to being used. -}


{-| The reasons a `meant` here names. -}
type Reason
    = {-| what the X server or the input method helper sent was cut short -}
      FromOutside
