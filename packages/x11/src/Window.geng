module Window exposing
    ( Cell
    , Event(..)
    , Pointer(..)
    , PointerEvent
    , Selection(..)
    , Settings
    , draw
    , events
    , fonts
    , menu
    , motion
    , open
    , paste
    , pasted
    , raise
    , resize
    , select
    , setFont
    , setPointer
    , setTitle
    , shot
    , sound
    , spot
    , systemMenu
    , take
    , zoom
    )

{-| puritty's window on X11 (`docs/renderer.md`, V34–V37).

One window a process (`geng-plan.md` Q6): [`open`](#open) makes it, and
every other call is about it. A frame is drawn by handing
[`draw`](#draw) the display list `Vt.View.frame` makes; the C executes it
with XRender, shaping and rasterizing as it draws (V34), and resolves
nothing, since the list carries its styles' colors (V35).

The loop waits on [`events`](#events) in its race, and after the race
[`take`](#take)s what came (`docs/phase2-window.md` §12): keys, a new size
in cells, the focus, a request to close (V36).

@docs Settings, Cell, open, setFont, fonts, raise, menu, systemMenu, draw, shot, setTitle, setPointer, Pointer, spot, zoom, resize, motion, select, Selection, paste, pasted, sound, events, take, Event, PointerEvent

-}

import Bitwise
import Bytes exposing (Bytes)
import Task exposing (Task)
import UInt8
import X11.Reason as Reason


{-| What the window is opened with: its size in cells, the primary font as
fontconfig names it and its size in points, the language fallback fonts
are asked for (V25; empty for none), the bytes of glyphs the X server may
hold before the glyph set is begun again (V37), and the title. -}
type alias Settings =
    { cols : Int
    , rows : Int
    , font : String
    , points : Int
    , lang : String
    , glyphCap : Int
    , title : String
    }


{-| A cell's size in pixels. -}
type alias Cell =
    { width : Int
    , height : Int
    }


{-| Opens the window, and answers its cell, or why it could not: no such
font, no X server, or no RENDER formats it needs. -}
open : Settings -> Task x (Result String Cell)
open s =
    openExtern s.cols s.rows s.points (Bytes.fromString s.font) (Bytes.fromString s.lang) s.glyphCap (Bytes.fromString s.title)
        |> Task.map
            (\code ->
                if code == -1 then
                    Err ("no font for " ++ s.font)

                else if code == -2 then
                    Err "no X server"

                else if code < 0 then
                    Err "the X server has no RENDER formats for it"

                else
                    Ok { width = code // 65536, height = modBy 65536 code }
            )


@extern(c, "puritty_x11_open")
openExtern : Int -> Int -> Int -> Bytes -> Bytes -> Int -> Bytes -> Task x Int


{-| Executes one frame's display list, and answers the ink of the cells it
drew, for `Vt.View.inked` (V40): which edges of its cell each glyph's
pixels crossed. Answers `Nothing` once the connection to the X server has
failed. -}
draw : Bytes -> Task x (Maybe Bytes)
draw list =
    drawExtern list
        |> Task.map
            (\answer ->
                if Bytes.get 0 answer == Just (UInt8.fromInt 0) then
                    Just (Bytes.slice 1 (Bytes.length answer) answer)

                else
                    Nothing
            )


@extern(c, "puritty_x11_draw")
drawExtern : Bytes -> Task x Bytes


{-| Plays a sound (`docs/sounds.md` SN6), without waiting for it: -1
the system's own bell, 0 and 1 the key sounds (a key, Enter), 2 to 6 the
bells (Apple II, IBM PC, Atari ST, BBC Micro, X11). A sound that cannot
play, or a bell while a bell plays, is dropped. Answers whether the
platform took it. -}
sound : Int -> Task x Bool
sound id =
    soundExtern id |> Task.map (\taken -> taken /= 0)


@extern(c, "puritty_x11_sound")
soundExtern : Int -> Task x Int


{-| Writes the window as it is on the screen, as a PPM, to a file: the
pixel gate's picture (V38). Answers `False` if it could not. -}
shot : String -> Task x Bool
shot path =
    shotExtern (Bytes.fromString path) |> Task.map (\code -> code == 0)


@extern(c, "puritty_x11_shot")
shotExtern : Bytes -> Task x Int


{-| Tells the IME where its candidate window belongs: a cell, whose
baseline XIM's spot location is (V46). Nothing is sent while it does not
move, or when there is no IME. -}
spot : { x : Int, y : Int } -> Task x {}
spot at =
    spotExtern at.x at.y |> Task.map (\_ -> {})


@extern(c, "puritty_x11_spot")
spotExtern : Int -> Int -> Task x Int


{-| Whether X sends every motion of the pointer over the window, or only
those while a button is held (`docs/phase3-select.md` §4): every one while
the program asks for any motion (mode 1003). -}
motion : Bool -> Task x {}
motion all =
    motionExtern
        (if all then
            1

         else
            0
        )
        |> Task.map (\_ -> {})


@extern(c, "puritty_x11_motion")
motionExtern : Int -> Task x Int


{-| X's two selections (`docs/phase3-select.md` §5, `docs/user/copy-and-paste.md`). -}
type Selection
    = Primary
    | Clipboard


{-| The pointer's shapes over the window: the I-beam over text, the arrow
over what is clicked, and over what is dragged (puritty `docs/tmux.md`
TM38) a width resized, a height, both (the bottom right corner or the top
left, and the bottom left or the top right), and a move. -}
type Pointer
    = TextPointer
    | ArrowPointer
    | ResizeWidthPointer
    | ResizeHeightPointer
    | ResizeDownRightPointer
    | ResizeDownLeftPointer
    | MovePointer


{-| The window owns a selection with this text, and the C answers every
program that asks for it from its own copy, without the loop: as UTF-8,
as Latin-1 for `STRING`, in INCR pieces when it is large. -}
select : Selection -> Bytes -> Task x {}
select which text =
    selectExtern
        (when which is
            Primary ->
                0

            Clipboard ->
                1
        )
        text
        |> Task.map (\_ -> {})


@extern(c, "puritty_x11_select")
selectExtern : Int -> Bytes -> Task x Int


{-| A paste of a selection asked of its owner (`docs/phase3-select.md` §15):
`Pasted` events follow as its text comes, which `pasted` takes; the C never
waits for it. False when another paste is under way and this one is not
made. -}
paste : Selection -> Task x Bool
paste which =
    pasteExtern
        (when which is
            Primary ->
                0

            Clipboard ->
                1
        )
        |> Task.map (\r -> r == 1)


@extern(c, "puritty_x11_paste")
pasteExtern : Int -> Task x Int


{-| The paste's text since it was last taken, UTF-8. -}
pasted : Task x Bytes
pasted =
    pastedExtern


@extern(c, "puritty_x11_pasted")
pastedExtern : Task x Bytes


{-| The window sized to hold `cols` by `rows` cells at the font it has,
where it is (`docs/settings-gui.md` SG11): what the host list's window,
the settings window's size, becomes when a host is chosen and it turns
into the session. A maximized window is left as it is. A `Resized`
follows, as from the user's own resize. -}
resize : { cols : Int, rows : Int } -> Task x {}
resize size =
    resizeExtern (max 1 size.cols) (max 1 size.rows) |> Task.map (\_ -> {})


@extern(c, "puritty_x11_resize")
resizeExtern : Int -> Int -> Task x Int


{-| The font at a new size in points (V50): every face sized again, the
window kept at its size in pixels, so a `Resized` follows with the cells
that now fit it; answers the new cell. The size is the screen's
resolution's, as `open`'s: `Xft.dpi`, else the primary monitor's from
RandR, else 96 (`PURITTY_DPI` sets it outright). -}
zoom : Int -> Task x Cell
zoom points =
    zoomExtern points |> Task.map (\code -> { width = code // 65536, height = modBy 65536 code })


@extern(c, "puritty_x11_zoom")
zoomExtern : Int -> Task x Int


{-| Another primary font, fallback language, size in points or glyph cache
in place of the open one (`docs/settings.md` ST4): every face opened
again, the window kept at its size in pixels, so a `Resized` follows with
the cells that now fit it; answers the new cell, or why not, with the font
kept: no such font. -}
setFont : { font : String, lang : String, points : Int, glyphCap : Int } -> Task x (Result String Cell)
setFont s =
    setFontExtern s.points (Bytes.fromString s.font) (Bytes.fromString s.lang) s.glyphCap
        |> Task.map
            (\code ->
                if code < 0 then
                    Err ("no font for " ++ s.font)

                else
                    Ok { width = code // 65536, height = modBy 65536 code }
            )


@extern(c, "puritty_x11_setfont")
setFontExtern : Int -> Bytes -> Bytes -> Int -> Task x Int


{-| The families of the monospace fonts the system has, sorted, each once,
for the settings window to offer (`docs/settings.md` ST8). -}
fonts : Task x (Array String)
fonts =
    fontsExtern
        |> Task.map (\b -> Bytes.toStringLossy b |> String.split "\n" |> Array.keepIf (\name -> name /= ""))


@extern(c, "puritty_x11_fonts")
fontsExtern : Task x Bytes


{-| Another of puritty's windows, found by its title, brought forward: so
that a second `puritty settings` raises the first and ends
(`docs/settings.md` ST8). Answers whether one was found. It may be asked
before `open`. -}
raise : String -> Task x Bool
raise title =
    raiseExtern (Bytes.fromString title) |> Task.map (\found -> found /= 0)


@extern(c, "puritty_x11_raise")
raiseExtern : Bytes -> Task x Int


{-| A pop-up menu the platform shows itself (`docs/settings.md` ST26):
X11 has none to show, so this answers False, and the program draws its
own over the screen. -}
menu : { x : Int, y : Int, items : Array String } -> Task x Bool
menu _ =
    Task.succeed False


{-| Items for the window manager's menu of the window: X11 gives a program
none, so this does nothing (`settings-ui.md` §1). -}
systemMenu : Array String -> Task x {}
systemMenu _ =
    Task.succeed {}


{-| The pointer over the window: the cursor theme's I-beam, over text, or
its arrow, while the program takes the mouse (docs/phase3-select.md §21),
and the shapes for what can be dragged (`docs/tmux.md` TM38). -}
setPointer : Pointer -> Task x {}
setPointer p =
    pointerExtern
        (when p is
            TextPointer ->
                0

            ArrowPointer ->
                1

            ResizeWidthPointer ->
                2

            ResizeHeightPointer ->
                3

            ResizeDownRightPointer ->
                4

            ResizeDownLeftPointer ->
                5

            MovePointer ->
                6
        )
        |> Task.map (\_ -> {})


@extern(c, "puritty_x11_pointer")
pointerExtern : Int -> Task x Int


{-| Sets the window's title. -}
setTitle : String -> Task x {}
setTitle title =
    titleExtern (Bytes.fromString title) |> Task.map (\_ -> {})


@extern(c, "puritty_x11_title")
titleExtern : Bytes -> Task x Int


{-| Waits for events: answers `True` once there are some, or `False` once
the connection has failed. It takes none, so a race that cancels it after
it answered loses nothing; [`take`](#take) takes them. -}
events : Task x Bool
events =
    eventsExtern |> Task.map (\code -> code > 0)


@extern(c, "puritty_x11_events")
eventsExtern : Task x Int


{-| What happened to the window. An IME's commit, preedit and its end come
in the order the IME sent them (V46): a commit is text for the program, a
preedit replaces `length` characters from `first` of what is being
composed with `text`, its feedback a value each, and the caret is a
character count. `ImeReady` says keys go through an IME from now on.

A key is what Ghostty's key encoder takes
(V47): its action (release 0, press 1, repeat 2), its X keycode, its
modifiers as Ghostty's bits (shift 1, ctrl 2, alt 4, super 8, caps lock 16,
num lock 32, and 64 to 512 for a right-hand shift, ctrl, alt or super),
the modifiers its text consumed, its unshifted code point, its keysym and
its text, which xkbcommon has made from the modifiers of the key's own
event (V30, V46); what it sends the program is Geng's to decide.

`Rescaled` is Windows' (a window moved to a monitor of another scale), and
never comes on X11, where one resolution serves the screen (`Xft.dpi`). -}
type Event
    = Key { action : Int, keycode : Int, mods : Int, consumed : Int, unshifted : Int, sym : Int, text : Bytes }
    | Resized { cols : Int, rows : Int }
    | Focus Bool
    | Close
    | Commit Bytes
    | Preedit { caret : Int, first : Int, length : Int, text : Bytes, feedback : Array Int }
    | PreeditDone
    | ImeReady
    | Pointer PointerEvent
    | SelectionLost Selection
    | Pasted Bool
    | MenuChosen { menu : Int, index : Int }
    | Rescaled Cell
    | Note String


{-| A press, release or motion of the pointer (`docs/phase3-select.md` §4):
`action` 0 press, 1 release, 2 motion; `button` as Ghostty numbers them
(0 none, 1 left, 2 right, 3 middle, 4-7 the wheel's steps, 8-11 the
rest), and a wheel step is a press with no release; `mods` as a key's; the
position in pixels from the window's top left, negative or past its edge
while a held button drags outside it; and the window's size and the cell's
in pixels, as they were when it came. -}
type alias PointerEvent =
    { action : Int
    , button : Int
    , mods : Int
    , x : Int
    , y : Int
    , width : Int
    , height : Int
    , cellWidth : Int
    , cellHeight : Int
    }


{-| The events since the last take. -}
take : Task x (Array Event)
take =
    takeExtern |> Task.map (\b -> decode b 0 [])


@extern(c, "puritty_x11_take")
takeExtern : Task x Bytes


decode : Bytes -> (at : Int where 0 <= at) -> Array Event -> Array Event
decode b at acc =
    let
        -- the bytes left from `at`; every read and every step is held to
        -- them, so a short or broken buffer ends the events, and no offset
        -- can wrap (docs/tmux.md TM33)
        rest =
            Bytes.length b - at

        byte i =
            if i >= 0 && i < rest then
                Maybe.withDefault 0 (Maybe.map UInt8.toInt (Bytes.get (at + i) b))

            else
                0

        u16 i =
            if i >= 0 && i < rest - 1 then
                Bitwise.or (Bitwise.shiftLeftBy 8 (byte i)) (Maybe.withDefault 0 (Maybe.map UInt8.toInt (Bytes.get (at + i + 1) b)))

            else
                0

        -- `len` bytes from `k` on, or none when they are not all there
        piece k len =
            if k >= 0 && len >= 0 && k <= rest && len <= rest - k then
                Bytes.slice (at + k) (at + k + len) b

            else
                Bytes.empty
    in
    if rest <= 0 then
        acc

    else
        when byte 0 is
            1 ->
                let
                    n =
                        clamp 0 255 (byte 15)

                    u32 i =
                        Bitwise.or (Bitwise.shiftLeftBy 16 (u16 i)) (u16 (i + 2))
                in
                decode b
                    (advance b at (16 + n))
                    (Array.pushLast
                        (Key
                            { action = byte 1
                            , keycode = byte 2
                            , mods = u16 3
                            , consumed = u16 5
                            , unshifted = u32 7
                            , sym = u32 11
                            , text = piece 16 n
                            }
                        )
                        acc
                    )

            2 ->
                decode b (advance b at 5) (Array.pushLast (Resized { cols = u16 1, rows = u16 3 }) acc)

            3 ->
                decode b (advance b at 2) (Array.pushLast (Focus (byte 1 == 1)) acc)

            4 ->
                decode b (advance b at 1) (Array.pushLast Close acc)

            5 ->
                let
                    n =
                        clamp 0 65535 (u16 1)
                in
                decode b (advance b at (3 + n)) (Array.pushLast (Commit (piece 3 n)) acc)

            6 ->
                let
                    n =
                        clamp 0 65535 (u16 7)

                    f =
                        9 + n

                    nf =
                        clamp 0 65535 (u16 f)

                    start =
                        advance b at (f + 2)
                in
                decode b
                    (advance b at (f + 2 + nf))
                    (Array.pushLast
                        (Preedit
                            { caret = u16 1
                            , first = u16 3
                            , length = u16 5
                            , text = piece 9 n
                            , feedback = Array.initialize nf start (\i -> Maybe.withDefault (meant Reason.FromOutside 0) (Maybe.map UInt8.toInt (Bytes.get i b)))
                            }
                        )
                        acc
                    )

            7 ->
                decode b (advance b at 1) (Array.pushLast PreeditDone acc)

            8 ->
                decode b (advance b at 1) (Array.pushLast ImeReady acc)

            13 ->
                -- what the X server did with the window, for the log
                let
                    n =
                        clamp 0 65535 (u16 1)
                in
                decode b (advance b at (3 + n)) (Array.pushLast (Note (Bytes.toStringLossy (piece 3 n))) acc)

            11 ->
                decode b (advance b at 2) (Array.pushLast (Pasted (byte 1 == 1)) acc)

            12 ->
                decode b (advance b at 4) (Array.pushLast (MenuChosen { menu = byte 1, index = u16 2 }) acc)

            10 ->
                decode b
                    (advance b at 2)
                    (Array.pushLast
                        (SelectionLost
                            (if byte 1 == 1 then
                                Clipboard

                             else
                                Primary
                            )
                        )
                        acc
                    )

            9 ->
                let
                    signed i =
                        let
                            v =
                                u16 i
                        in
                        if v >= 0x8000 then
                            v - 0x10000

                        else
                            v
                in
                decode b
                    (advance b at 17)
                    (Array.pushLast
                        (Pointer
                            { action = byte 1
                            , button = byte 2
                            , mods = u16 3
                            , x = signed 5
                            , y = signed 7
                            , width = u16 9
                            , height = u16 11
                            , cellWidth = u16 13
                            , cellHeight = u16 15
                            }
                        )
                        acc
                    )

            _ ->
                acc


{-| `at` moved on `k` bytes in `b`, or to its end: never back, and never
past the end, so that the sum cannot wrap (`docs/tmux.md` TM33). -}
advance : Bytes -> (at : Int where 0 <= at) -> (k : Int where 0 <= k) -> (r : Int where 0 <= r)
advance b at k =
    if k < Bytes.length b - at then
        at + k

    else if Bytes.length b < at then
        at

    else
        Bytes.length b
