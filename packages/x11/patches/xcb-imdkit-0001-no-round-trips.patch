 void _xcb_xim_close(xcb_xim_t *im);
 
-bool _xcb_xim_send_message(xcb_xim_t *im, uint8_t *data, size_t length) {
+/* puritty: every name the rotation uses is interned at the first message,
+ * the requests sent together and their replies read after, one round trip
+ * in all; a message after it makes none (docs/phase3-input.md §3.3). */
+static bool _xcb_xim_intern_client_atoms(xcb_xim_t *im) {
+    xcb_intern_atom_cookie_t cookies[XCB_XIM_ATOM_ROTATION_SIZE];
     char atomName[64];
-    int len = sprintf(atomName, "_client%u", im->sequence++);
+    for (uint32_t i = 0; i < XCB_XIM_ATOM_ROTATION_SIZE; i++) {
+        int len = sprintf(atomName, "_client%u", i);
+        cookies[i] = xcb_intern_atom(im->conn, false, len, atomName);
+    }
+    bool ok = true;
+    for (uint32_t i = 0; i < XCB_XIM_ATOM_ROTATION_SIZE; i++) {
+        xcb_intern_atom_reply_t *reply =
+            xcb_intern_atom_reply(im->conn, cookies[i], NULL);
+        if (!reply) {
+            ok = false;
+            continue;
+        }
+        im->client_atoms[i] = reply->atom;
+        free(reply);
+    }
+    im->client_atoms_ready = ok;
+    return ok;
+}
+
+bool _xcb_xim_send_message(xcb_xim_t *im, uint8_t *data, size_t length) {
+    uint32_t seq = im->sequence++;
     im->sequence = (im->sequence + 1) % XCB_XIM_ATOM_ROTATION_SIZE;
-    return _xcb_send_xim_message(im->conn, im->atoms[XIM_ATOM_XIM_PROTOCOL],
-                                 im->accept_win, data, length, atomName, len);
+    if (!im->client_atoms_ready && !_xcb_xim_intern_client_atoms(im)) {
+        return false;
+    }
+    return _xcb_send_xim_message_atom(
+        im->conn, im->atoms[XIM_ATOM_XIM_PROTOCOL], im->accept_win, data,
+        length, im->client_atoms[seq % XCB_XIM_ATOM_ROTATION_SIZE]);
 }
 
