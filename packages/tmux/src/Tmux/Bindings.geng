module Tmux.Bindings exposing
    ( Binding
    , Follow
    , bindingOf
    , follow
    , held
    , prefixesOf
    , route
    , tableAt
    )

{-| tmux's key tables, followed from outside (puritty `docs/tmux.md`
TM24): `list-keys` read into bindings, and where each key typed goes, so
that a key whose binding would open tmux's prompt is held back, since
under control mode it would leave the client answering nothing.
-}

import Dict exposing (Dict)
import Tmux.Customize as Customize
import Tmux.Reason as Reason
import Tmux.Syntax as Syntax


{-| A key's binding as `list-keys` gives it: its command, and whether it
repeats (`bind -r`). -}
type alias Binding =
    { command : String, repeat : Bool }


{-| What following the tables needs: the bindings by `"table key"`, the
prefix keys, `repeat-time`, the table the client is in, until when a
repeatable binding keeps it there (-1 when none does), and whether the
server has `send-keys -K` (3.4 on) to send keys through the tables at
all. -}
type alias Follow =
    { bindings : Dict String Binding
    , prefixes : Array String
    , repeatMs : Int
    , table : String
    , repeatUntil : Int
    , byTable : Bool
    }


{-| Before `list-keys` is read: no bindings, `root`. -}
follow : Follow
follow =
    { bindings = Dict.empty, prefixes = [], repeatMs = 500, table = "root", repeatUntil = -1, byTable = False }


{-| `display-message -p '#{prefix} #{prefix2} #{repeat-time} #{version}'`'s
line: the prefix keys (`None` is none) and the repeat time in ms. Whether
the server has `send-keys -K` is `Caps`' answer, not the version's
(the code review's TP19). -}
prefixesOf : String -> { prefixes : Array String, repeatMs : Int }
prefixesOf line =
    let
        words =
            String.split " " line
    in
    { prefixes = Array.keepIf (\w -> w /= "" && w /= "None") (Array.slice 0 2 words)
    , repeatMs = Maybe.withDefault (meant Reason.FromOutside 500) (Maybe.andThen String.toInt (Array.get 2 words))
    }


{-| Where a key goes by tmux's key tables, as tmux will look it up
(`server-client.c`, TM24, TM25): in the active pane's mode table
(`modeTable`, `copy-mode-vi` in copy mode, `""` in none) while the client
is in `root`; the prefix moves to `prefix` from any other table; a key
bound nowhere in its table is looked for in `root`; a binding moves back to
`root`, or stays for `repeat-time` if it repeats, or to the table a
`switch-client -T` names. A binding `held` gives a reason for is not sent:
its command is answered (`held`), for puritty to run itself or say why
not, and tmux put back in `root` when the prefix had taken it out. A
binding sent is answered too (`ran`), for what it will change. -}
route : Maybe String -> Int -> String -> Follow -> { send : Bool, reset : Bool, table : String, repeatUntil : Int, said : String, held : String, ran : String }
route name ms modeTable s =
    let
        repeating =
            s.repeatUntil >= 0 && since ms s.repeatUntil >= 0

        clientTable =
            tableAt ms s

        current =
            if clientTable == "root" && modeTable /= "" then
                modeTable

            else
                clientTable

        plain =
            { send = True, reset = False, table = "root", repeatUntil = -1, said = "", held = "", ran = "" }
    in
    when name is
        Nothing ->
            meant Reason.NotKnown plain

        Just key ->
            if current /= "prefix" && Array.member key s.prefixes then
                { plain | table = "prefix" }

            else
                let
                    inTable =
                        Dict.get (current ++ " " ++ key) s.bindings
                            |> Maybe.andThen
                                (\b ->
                                    if repeating && not b.repeat then
                                        Nothing

                                    else
                                        Just b
                                )

                    found =
                        when inTable is
                            Just b ->
                                Just { binding = b, table = current }

                            Nothing ->
                                meant Reason.NotKnown
                                    if current /= "root" then
                                        Dict.get ("root " ++ key) s.bindings |> Maybe.map (\b -> { binding = b, table = "root" })

                                    else
                                        Nothing
                in
                when found is
                    Just f ->
                        when held f.binding.command is
                            Just why ->
                                { send = False
                                , reset = current /= "root"
                                , table = "root"
                                , repeatUntil = -1
                                , said = "puritty: " ++ key ++ " is " ++ why
                                , held = f.binding.command
                                , ran = ""
                                }

                            Nothing ->
                                meant Reason.NotKnown
                                    when switchedTo f.binding.command is
                                        Just table ->
                                            { plain | table = table, ran = f.binding.command }

                                        Nothing ->
                                            meant Reason.NotKnown
                                                if f.binding.repeat then
                                                    { plain | table = f.table, repeatUntil = modBy clockPeriod (ms + s.repeatMs), ran = f.binding.command }

                                                else
                                                    { plain | ran = f.binding.command }

                    Nothing ->
                        meant Reason.NotKnown plain


{-| The table the client is in at `ms`: the one it was put in, or `root`
once a repeat's time has passed. -}
tableAt : Int -> Follow -> String
tableAt ms s =
    if s.repeatUntil >= 0 && since ms s.repeatUntil < 0 then
        "root"

    else
        s.table


{-| Why a binding's command is held back, if it is (TM24):
`command-prompt` and `confirm-before` wait for keys that, under control
mode, wait behind them, so the client answers nothing again; after
`suspend-client` tmux takes no key from a control client again, and
nothing resumes it; `display-menu` shows nothing to a control client, so
puritty shows it (TM27); nor does `display-panes` (TM28), nor `choose-tree` (TM32),
nor `choose-buffer` and `choose-client` (TM55), nor `customize-mode`
(TM62). -}
held : String -> Maybe String
held command =
    let
        names =
            commandNames 4 command

        has name =
            Array.member name names
    in
    if has "command-prompt" then
        Just "command-prompt; tmux -CC shows no prompt yet"

    else if has "confirm-before" then
        Just "confirm-before; tmux -CC shows no prompt yet"

    else if has "choose-tree" || has "choose-session" || has "choose-window" then
        Just "choose-tree; tmux -CC shows no tree"

    else if has "display-popup" || has "popup" then
        Just "display-popup; tmux -CC shows no popup"

    else if has "choose-buffer" || has "choose-client" then
        Just "choose-buffer/choose-client; tmux -CC shows no list"

    else if has "customize-mode" then
        Just "customize-mode; tmux -CC shows no options"

    else if has "display-panes" || has "displayp" then
        Just "display-panes; tmux -CC shows no numbers"

    else if has "display-menu" || has "menu" then
        Just "display-menu; tmux -CC shows no menu"

    else if has "suspend-client" then
        Just "suspend-client, after which tmux -CC would take no keys"

    else
        Nothing


{-| The names of the commands a command line runs: the first word of each
of its commands, and of the commands inside a `{ … }` block, inside
`if-shell`'s (`if`) commands and inside `run-shell -C`'s, `depth` deep.
Words in other places are arguments, not commands: before, any word
counted, so `send-keys menu Enter` was held as a menu, and a prompt inside
a quoted `if-shell` command was not held (the code review's TP5). -}
commandNames : Int -> String -> Array String
commandNames depth line =
    Syntax.commands (Syntax.tokens line)
        |> Array.mapAndFlatten
            (\words ->
                when Array.popFirst words is
                    Just { first, rest } ->
                        let
                            name =
                                first.value

                            -- the words that are commands of their own
                            inner =
                                if depth <= 0 then
                                    []

                                else if name == "if-shell" || name == "if" then
                                    -- the condition is the first word not a flag
                                    -- (or a flag's value); the rest are commands
                                    rest
                                        |> Array.keepIf (\w -> w.block || not (String.startsWith "-" w.value))
                                        |> Array.dropFirst 1
                                        |> Array.mapAndFlatten (\w -> commandNames (depth - 1) w.value)

                                else if (name == "run-shell" || name == "run") && Array.any (\w -> not w.block && String.startsWith "-" w.value && String.contains "C" w.value) rest then
                                    rest
                                        |> Array.keepIf (\w -> w.block || not (String.startsWith "-" w.value))
                                        |> Array.mapAndFlatten (\w -> commandNames (depth - 1) w.value)

                                else
                                    rest
                                        |> Array.keepIf .block
                                        |> Array.mapAndFlatten (\w -> commandNames (depth - 1) w.value)
                        in
                        Array.pushFirst name inner

                    Nothing ->
                        meant Reason.NoMore []
            )


{-| The table a binding's `switch-client -T table` puts the client in. -}
switchedTo : String -> Maybe String
switchedTo command =
    when String.split " " command |> Array.keepIf (\w -> w /= "") is
        [ "switch-client", "-T", table ] ->
            Just table

        _ ->
            Nothing


{-| A `list-keys` line, `bind-key [-r] -T table key command…`, put in the
bindings by table and key, the key unquoted and the command as printed,
by `Customize.listedBinding`: one reader for both (the code review's
TP6). -}
bindingOf : String -> Dict String Binding -> Dict String Binding
bindingOf line d =
    when Customize.listedBinding line is
        Just b ->
            Dict.set (b.table ++ " " ++ b.key) { command = b.command, repeat = b.repeat } d

        Nothing ->
            meant Reason.FromOutside d


{-| The loop's clock starts over every 2^30 ms and is never negative
(puritty's `Clock`, `docs/rhel8-etx.md` RE11), so a time is compared by its
difference: how long from `from` to `to`, negative when `to` comes
first. -}
since : Int -> Int -> Int
since from to =
    let
        d =
            modBy clockPeriod (to - from)
    in
    if d > clockPeriod // 2 then
        d - clockPeriod

    else
        d


clockPeriod : Int
clockPeriod =
    1073741824
