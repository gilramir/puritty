module Tmux.Command exposing
    ( sendBytes
    , sendKey
    , sendKeyTo
    , typeText
    , size
    , clientFlags
    , continuePane
    , quote
    , listPanes
    )

{-| The commands puritty sends tmux in control mode (puritty
`docs/tmux.md` TM5), each a line without its `\n`. Ids go in quotes, as
an unquoted `%0:…` is a parse error in tmux 3.8 (TM3).
-}

import Bytes exposing (Bytes)


{-| `send-keys -H`: the bytes as the pane's program reads them, hex, at
most 256 to a command so that a paste makes lines of a sensible length. -}
sendBytes : Int -> Bytes -> Array String
sendBytes pane bytes =
    let
        hex =
            Bytes.toHexString { padding = False } bytes

        count =
            Bytes.length bytes
    in
    Array.range 0 ((count - 1) // 256)
        |> Array.keepIf (\_ -> count > 0)
        |> Array.map
            (\i ->
                let
                    part =
                        String.slice (i * 512) (min (2 * count) ((i + 1) * 512)) hex
                in
                "send-keys -t " ++ quote ("%" ++ String.fromInt pane) ++ " -H " ++ pairs part
            )


{-| `send-keys -K`: a key by its tmux name (`C-a`, `M-x`, `S-Up`), to the
client, so that it is looked up in the client's key table as a key typed
at a terminal is: the prefix and the bindings work, and a key bound to
nothing goes to the active pane, encoded by tmux for that pane's modes.
Bytes given with `-t pane -H` reach the pane without any lookup (TM23). -}
sendKey : String -> String
sendKey name =
    "send-keys -K " ++ quote name


{-| `send-keys -t %N`: a key by its tmux name straight to a pane, encoded
by tmux for the pane's modes. For a key no binding takes: `send-keys -K`
leaves its internal "sent" flag on the key, and tmux then drops every key
that is an escape sequence (Down, F5; 3.7c, 3.8; 3.6a sends a wrong
byte) and, when the pane has extended keys, Enter too (puritty
`docs/tmux.md` TM50). -}
sendKeyTo : Int -> String -> String
sendKeyTo pane name =
    "send-keys -t " ++ quote ("%" ++ String.fromInt pane) ++ " " ++ quote name


{-| `send-keys -K -H`: typed text, its UTF-8 bytes in hex, through the
client's key table as `sendKey`'s keys are: a character after the prefix
is the binding's key (TM23). -}
typeText : Bytes -> Array String
typeText bytes =
    if Bytes.isEmpty bytes then
        []

    else
        [ "send-keys -K -H " ++ pairs (Bytes.toHexString { padding = False } bytes) ]


{-| `abcd` as `ab cd`. -}
pairs : String -> String
pairs hex =
    Array.range 0 (String.count hex // 2 - 1)
        |> Array.map (\i -> String.slice (2 * i) (2 * i + 2) hex)
        |> String.join " "


{-| The client's size, `refresh-client -C`, in cells. -}
size : { cols : Int, rows : Int } -> String
size s =
    "refresh-client -C " ++ String.fromInt (max 1 s.cols) ++ "x" ++ String.fromInt (max 1 s.rows)


{-| The flags puritty sets on attach: 3.8's layouts with floating panes
(an older tmux ignores a name it does not know, TM5.5), and `pause-after`:
a pane whose output puritty has not read for five seconds is paused and
its backlog dropped, rather than the client being ended as "too far
behind" after five minutes (TM5.7, TM19). -}
clientFlags : String
clientFlags =
    "refresh-client -f new-layouts,pause-after=5"


{-| A paused pane continued: its output again from now (TM5.7). -}
continuePane : Int -> String
continuePane pane =
    "refresh-client -A " ++ quote ("%" ++ String.fromInt pane ++ ":continue")


{-| Each pane of the session's current window and its state, one line a
pane, each starting with `P` so that no line can read as a guard (TM5.2). -}
listPanes : String
listPanes =
    "list-panes -F " ++ quote "P #{pane_id} #{window_id} #{pane_active} #{cursor_x} #{cursor_y} #{alternate_on} #{window_layout}"


{-| A word for tmux's command line, single-quoted: tmux takes nothing in
single quotes as special, and `'` itself is ended, escaped and begun. -}
quote : String -> String
quote s =
    "'" ++ String.replace "'" "'\\''" s ++ "'"
