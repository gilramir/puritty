{-| The commands puritty sends tmux in control mode (puritty
`docs/tmux.md` TM5), each a line without its `\n`. Ids go in quotes, as
an unquoted `%0:…` is a parse error in tmux 3.8 (TM3).
-}

import Bytes exposing (Bytes)
import Tmux.Caps as Caps exposing (Caps)
import Tmux.Reason as Reason
import UInt8


-- SHAPES (puritty `docs/tmux-checks.md` TK2)


{-| A part of a command: a flag alone (`-p`), a flag and its value (`-t
%0`), or the arguments after the flags; and a flag, or a flag and value,
that a command may leave out (`OptFlag`, `OptValue`), given as a value
that is empty when it is left out. The check holds every flag a shape may
have, so whichever it leaves out the rest are taken. -}
type Part
    = Flag String
    | Value String
    | Rest
    | OptFlag String
    | OptValue String
    -- `--`: the flags end, so that a word after that begins with `-` is
    -- not read as flags (2.x keys, docs/tmux-checks.md TK9)
    | EndOfFlags


{-| A command's shape: its name and parts, and when it may be sent (`allowed`), as a
test on what the tmux takes (`anyTmux` for most). Every command puritty
sends is made from a shape in `catalog`, by `render`, so that it holds
exactly the shape's flags; the check holds every shape to every dumped
tmux whose `list-commands` its test allows. -}
type alias Shape =
    { name : String
    , parts : Array Part
    , allowed : Caps -> Bool
    }


{-| A command from its shape and its values, one for each `Value` in
order, then the rest's. Values are given as they are to be written
(quoted where they need it). -}
render : Shape -> Array String -> String
render shape values =
    let
        step part acc =
            when part is
                Flag f ->
                    { acc | words = Array.pushLast ("-" ++ f) acc.words }

                Value f ->
                    { words = acc.words ++ [ "-" ++ f, Maybe.withDefault (meant Reason.FromOutside "''") (Array.get acc.next values) ], next = acc.next + 1 }

                Rest ->
                    { words = acc.words ++ Array.dropFirst acc.next values, next = Array.length values }

                EndOfFlags ->
                    { acc | words = Array.pushLast "--" acc.words }

                OptFlag f ->
                    { words =
                        if Maybe.withDefault (meant Reason.NotSet "") (Array.get acc.next values) == "" then
                            acc.words

                        else
                            Array.pushLast ("-" ++ f) acc.words
                    , next = acc.next + 1
                    }

                OptValue f ->
                    { words =
                        when Array.get acc.next values is
                            Just v ->
                                if v == "" then
                                    acc.words

                                else
                                    acc.words ++ [ "-" ++ f, v ]

                            Nothing ->
                                meant Reason.FromOutside acc.words
                    , next = acc.next + 1
                    }

        made =
            Array.foldl step { words = [ shape.name ], next = 0 } shape.parts
    in
    String.join " " made.words


{-| A shape's flags, as one string of letters. -}
flagsOf : Shape -> String
flagsOf shape =
    shape.parts
        |> Array.map
            (\part ->
                when part is
                    Flag f ->
                        f

                    Value f ->
                        f

                    Rest ->
                        ""

                    EndOfFlags ->
                        ""

                    OptFlag f ->
                        f

                    OptValue f ->
                        f
            )
        |> String.join ""


anyTmux : Caps -> Bool
anyTmux _ =
    True


sendHex : Shape
sendHex =
    { name = "send-keys", parts = [ Value "t", Flag "H", Rest ], allowed = Caps.has "send-keys" "H" }


sendLiteral : Shape
sendLiteral =
    { name = "send-keys", parts = [ Value "t", Flag "l", EndOfFlags, Rest ], allowed = anyTmux }


sendNamed : Shape
sendNamed =
    { name = "send-keys", parts = [ Value "t", Rest ], allowed = anyTmux }


sendClientKey : Shape
sendClientKey =
    { name = "send-keys", parts = [ Flag "K", Rest ], allowed = Caps.has "send-keys" "K" }


sendClientHex : Shape
sendClientHex =
    { name = "send-keys", parts = [ Flag "K", Flag "H", Rest ], allowed = \c -> Caps.has "send-keys" "K" c && Caps.has "send-keys" "H" c }


sizeByX : Shape
sizeByX =
    { name = "refresh-client", parts = [ Value "C" ], allowed = Caps.sizeByX }


sizeByComma : Shape
sizeByComma =
    { name = "refresh-client", parts = [ Value "C" ], allowed = \c -> not (Caps.sizeByX c) }


clientFlagsShape : Shape
clientFlagsShape =
    { name = "refresh-client", parts = [ Value "f" ], allowed = Caps.has "refresh-client" "f" }


continueShape : Shape
continueShape =
    { name = "refresh-client", parts = [ Value "A" ], allowed = Caps.has "refresh-client" "A" }


listPanesShape : Shape
listPanesShape =
    { name = "list-panes", parts = [ Value "F" ], allowed = anyTmux }


listCommandsShape : Shape
listCommandsShape =
    { name = "list-commands", parts = [], allowed = anyTmux }


setBufferFirst : Shape
setBufferFirst =
    { name = "set-buffer", parts = [ Value "b", Rest ], allowed = anyTmux }


setBufferAppend : Shape
setBufferAppend =
    { name = "set-buffer", parts = [ Flag "a", Value "b", Rest ], allowed = anyTmux }


pasteShape : Shape
pasteShape =
    { name = "paste-buffer", parts = [ Flag "p", Flag "r", Flag "d", Value "b", Value "t" ], allowed = anyTmux }


-- QUESTIONS (TK7)


custom : Caps -> Bool
custom =
    -- what customize-mode asks: puritty shows it only where tmux has it
    Caps.known "customize-mode"


displayShape : Shape
displayShape =
    { name = "display-message", parts = [ Flag "p", Rest ], allowed = anyTmux }


displayAtShape : Shape
displayAtShape =
    { name = "display-message", parts = [ Flag "p", Value "t", Rest ], allowed = anyTmux }


listPanesSessionShape : Shape
listPanesSessionShape =
    { name = "list-panes", parts = [ Flag "s", Value "F" ], allowed = anyTmux }


listPanesAllShape : Shape
listPanesAllShape =
    { name = "list-panes", parts = [ Flag "a", Value "F" ], allowed = anyTmux }


listPanesTargetShape : Shape
listPanesTargetShape =
    { name = "list-panes", parts = [ Value "t", Value "F" ], allowed = anyTmux }


listWindowsShape : Shape
listWindowsShape =
    { name = "list-windows", parts = [ Value "F" ], allowed = anyTmux }


listWindowsAllShape : Shape
listWindowsAllShape =
    { name = "list-windows", parts = [ Flag "a", Value "F" ], allowed = anyTmux }


listWindowsTargetShape : Shape
listWindowsTargetShape =
    { name = "list-windows", parts = [ Value "t", Value "F" ], allowed = anyTmux }


listSessionsShape : Shape
listSessionsShape =
    { name = "list-sessions", parts = [ Value "F" ], allowed = anyTmux }


listBuffersShape : Shape
listBuffersShape =
    { name = "list-buffers", parts = [ Value "F" ], allowed = anyTmux }


listClientsShape : Shape
listClientsShape =
    { name = "list-clients", parts = [ Value "F" ], allowed = anyTmux }


showBufferShape : Shape
showBufferShape =
    { name = "show-buffer", parts = [ Value "b" ], allowed = anyTmux }


showTopBufferShape : Shape
showTopBufferShape =
    { name = "show-buffer", parts = [], allowed = anyTmux }


{-| `show-prompt-history -T TYPE` (3.3): what tmux's prompts of a type
have had typed, oldest first (TM89). -}
promptHistoryShape : Shape
promptHistoryShape =
    { name = "show-prompt-history", parts = [ Value "T" ], allowed = Caps.has "show-prompt-history" "T" }


{-| `show-options -gv NAME`: a global option's value, an array's items a
line each (`command-alias`, TM96). -}
globalValueShape : Shape
globalValueShape =
    { name = "show-options", parts = [ Flag "g", Flag "v", Rest ], allowed = anyTmux }


captureShape : Shape
captureShape =
    { name = "capture-pane", parts = [ Flag "p", Value "t" ], allowed = anyTmux }


captureHistoryShape : Shape
captureHistoryShape =
    { name = "capture-pane", parts = [ Flag "p", Flag "e", Flag "J", Value "S", Value "E", Value "t" ], allowed = anyTmux }


captureSavedShape : Shape
captureSavedShape =
    { name = "capture-pane", parts = [ Flag "p", Flag "e", Flag "J", Value "S", Value "E", Flag "a", Flag "q", Value "t" ], allowed = anyTmux }


listKeysShape : Shape
listKeysShape =
    { name = "list-keys", parts = [], allowed = anyTmux }


listKeysFormatShape : Shape
listKeysFormatShape =
    { name = "list-keys", parts = [ Value "F" ], allowed = Caps.has "list-keys" "F" }


listKeysNotesShape : Shape
listKeysNotesShape =
    { name = "list-keys", parts = [ Flag "N", Flag "a", Value "P", Value "T" ], allowed = \c -> custom c && Caps.has "list-keys" "N" c }


subscribeShape : Shape
subscribeShape =
    { name = "refresh-client", parts = [ Value "B" ], allowed = Caps.has "refresh-client" "B" }


{-| `show-options -H` at each of customize-mode's levels, by its flags:
`s`, `g`, `t`, `gw`, `wt`, `pt`. -}
showOptionsShapes : Array { level : String, shape : Shape }
showOptionsShapes =
    [ { level = "s", shape = { name = "show-options", parts = [ Flag "H", Flag "s" ], allowed = custom } }
    , { level = "g", shape = { name = "show-options", parts = [ Flag "H", Flag "g" ], allowed = custom } }
    , { level = "t", shape = { name = "show-options", parts = [ Flag "H", Value "t" ], allowed = custom } }
    , { level = "gw", shape = { name = "show-options", parts = [ Flag "H", Flag "g", Flag "w" ], allowed = custom } }
    , { level = "wt", shape = { name = "show-options", parts = [ Flag "H", Flag "w", Value "t" ], allowed = custom } }
    , { level = "pt", shape = { name = "show-options", parts = [ Flag "H", Flag "p", Value "t" ], allowed = custom } }
    ]


{-| `show-environment` at customize-mode's levels: `g`, `gh`, `t`, `th`. -}
showEnvironmentShapes : Array { level : String, shape : Shape }
showEnvironmentShapes =
    [ { level = "g", shape = { name = "show-environment", parts = [ Flag "g" ], allowed = custom } }
    , { level = "gh", shape = { name = "show-environment", parts = [ Flag "g", Flag "h" ], allowed = custom } }
    , { level = "t", shape = { name = "show-environment", parts = [ Value "t" ], allowed = custom } }
    , { level = "th", shape = { name = "show-environment", parts = [ Value "t", Flag "h" ], allowed = custom } }
    ]


leveled : Array { level : String, shape : Shape } -> String -> String -> String
leveled shapes level target =
    when Array.findFirst (\s -> s.level == level) shapes is
        Just found ->
            render found.value.shape
                (if String.contains "t" level then
                    [ quote target ]

                 else
                    []
                )

        Nothing ->
            -- a level puritty does not ask: the first's
            meant Reason.NotKnown (Maybe.withDefault (meant Reason.NotKnown "") (Maybe.map (\s -> render s.shape []) (Array.first shapes)))


{-| `display-message -p FORMAT`: a format expanded for the session. -}
display : String -> String
display format =
    render displayShape [ quote format ]


{-| `display-message -p -t TARGET FORMAT`. -}
displayAt : String -> String -> String
displayAt target format =
    render displayAtShape [ quote target, quote format ]


{-| `display-message -p -t TARGET -- TEXT`: text that may begin with `-`. -}
displayLiteral : String -> String -> String
displayLiteral target text =
    render displayAtShape [ quote target, "--", quote text ]


listPanesOf : String -> String
listPanesOf format =
    render listPanesShape [ quote format ]


listPanesSession : String -> String
listPanesSession format =
    render listPanesSessionShape [ quote format ]


listPanesAll : String -> String
listPanesAll format =
    render listPanesAllShape [ quote format ]


listPanesTarget : String -> String -> String
listPanesTarget target format =
    render listPanesTargetShape [ quote target, quote format ]


listWindows : String -> String
listWindows format =
    render listWindowsShape [ quote format ]


listWindowsAll : String -> String
listWindowsAll format =
    render listWindowsAllShape [ quote format ]


listWindowsTarget : String -> String -> String
listWindowsTarget target format =
    render listWindowsTargetShape [ quote target, quote format ]


listSessions : String -> String
listSessions format =
    render listSessionsShape [ quote format ]


{-| `show-options -gv NAME`. -}
globalValue : String -> String
globalValue name =
    render globalValueShape [ name ]


{-| `show-prompt-history -T TYPE`. -}
promptHistory : String -> String
promptHistory kind =
    render promptHistoryShape [ quote kind ]


{-| Whether this tmux keeps a history per prompt type that a client can
read (`show-prompt-history`, 3.3). -}
promptHistoryKept : Caps -> Bool
promptHistoryKept caps =
    caps.known && promptHistoryShape.allowed caps


listBuffers : String -> String
listBuffers format =
    render listBuffersShape [ quote format ]


listClients : String -> String
listClients format =
    render listClientsShape [ quote format ]


showBuffer : String -> String
showBuffer name =
    render showBufferShape [ quote name ]


{-| `show-buffer`: the newest buffer's text, as the prompt's C-y puts it in
(puritty `docs/tmux.md` TM80); tmux refuses it when there is none. -}
showTopBuffer : String
showTopBuffer =
    render showTopBufferShape []


{-| `capture-pane -p -t TARGET`: the pane's screen as text. -}
captureTarget : String -> String
captureTarget target =
    render captureShape [ quote target ]


{-| A pane's screen and the last `history` lines of its history, colors
and wrapped lines joined (`-e -J -S -HISTORY -E -`); with `saved`, the
main screen kept while the alternate one is up (`-a -q`). Before, the
whole history (`-S -`), whatever the terminal fed it kept (the code
review's TA10, puritty `docs/tmux.md` TM119). -}
capture : Bool -> Int -> String -> String
capture saved history target =
    render
        (if saved then
            captureSavedShape

         else
            captureHistoryShape
        )
        [ "-" ++ String.fromInt (max 0 history), "-", quote target ]


listKeys : String
listKeys =
    render listKeysShape []


listKeysFormat : String -> String
listKeysFormat format =
    render listKeysFormatShape [ quote format ]


{-| `list-keys -N -a -P '' -T TABLE`: a table's notes, every key. -}
listKeysNotes : String -> String
listKeysNotes table =
    render listKeysNotesShape [ "''", quote table ]


{-| `refresh-client -B NAME:WHAT:FORMAT`: a subscription (3.2). -}
subscribe : String -> String
subscribe sub =
    render subscribeShape [ quote sub ]


{-| `show-options -H` at a level of `showOptionsShapes`. -}
showOptions : String -> String -> String
showOptions level target =
    leveled showOptionsShapes level target


{-| `show-environment` at a level of `showEnvironmentShapes`. -}
showEnvironment : String -> String -> String
showEnvironment level target =
    leveled showEnvironmentShapes level target


-- ACTIONS (TK7)


bare : String -> Shape
bare name =
    { name = name, parts = [], allowed = anyTmux }


targeted : String -> Shape
targeted name =
    { name = name, parts = [ Value "t" ], allowed = anyTmux }


markShape : Shape
markShape =
    { name = "select-pane", parts = [ Flag "m", Value "t" ], allowed = anyTmux }


unmarkShape : Shape
unmarkShape =
    { name = "select-pane", parts = [ Flag "M" ], allowed = anyTmux }


swapWindowShape : Shape
swapWindowShape =
    { name = "swap-window", parts = [ Flag "d", Value "s", Value "t" ], allowed = anyTmux }


detachKillShape : Shape
detachKillShape =
    { name = "detach-client", parts = [ Flag "P", Value "t" ], allowed = anyTmux }


deleteBufferShape : Shape
deleteBufferShape =
    { name = "delete-buffer", parts = [ Value "b" ], allowed = anyTmux }


rootShape : Shape
rootShape =
    { name = "switch-client", parts = [ Value "T" ], allowed = anyTmux }


resizeShape : Shape
resizeShape =
    { name = "resize-pane", parts = [ Value "t", OptValue "x", OptValue "y" ], allowed = anyTmux }


moveShape : Shape
moveShape =
    -- a floating pane moved: 3.8's panes
    { name = "move-pane", parts = [ Value "t", Value "X", Value "Y" ], allowed = Caps.has "move-pane" "X" }


setPaneShape : Shape
setPaneShape =
    -- a pane's own option (3.0): what tmux's menus are given, which 3.0 brings too
    { name = "set-option", parts = [ Flag "p", Value "t", Rest ], allowed = Caps.has "set-option" "p" }


setPaneFormatShape : Shape
setPaneFormatShape =
    -- the current pane's option, a format expanded: a popup's colors (3.8)
    { name = "set-option", parts = [ Flag "p", Flag "F", Rest ], allowed = Caps.has "new-pane" "O" }


ifShellShape : Shape
ifShellShape =
    { name = "if-shell", parts = [ Flag "F", Value "t", Rest ], allowed = anyTmux }


popupShape : Shape
popupShape =
    -- tmux 3.8's popup as a floating pane
    { name = "new-pane", parts = [ Flag "O", OptFlag "k", Value "t", Value "x", Value "y", Value "X", Value "Y", OptValue "c", Rest ], allowed = Caps.has "new-pane" "O" }


newWindow : String
newWindow =
    render (bare "new-window") []


nextWindow : String
nextWindow =
    render (bare "next-window") []


previousWindow : String
previousWindow =
    render (bare "previous-window") []


selectWindow : String -> String
selectWindow target =
    render (targeted "select-window") [ quote target ]


selectPane : String -> String
selectPane target =
    render (targeted "select-pane") [ quote target ]


{-| `select-pane -m -t`: the pane marked. -}
markPane : String -> String
markPane target =
    render markShape [ quote target ]


{-| `select-pane -M`: the marks cleared. -}
unmarkPanes : String
unmarkPanes =
    render unmarkShape []


swapWindow : String -> String -> String
swapWindow source target =
    render swapWindowShape [ quote source, quote target ]


killPane : String -> String
killPane target =
    render (targeted "kill-pane") [ quote target ]


killWindow : String -> String
killWindow target =
    render (targeted "kill-window") [ quote target ]


killSession : String -> String
killSession target =
    render (targeted "kill-session") [ quote target ]


{-| `detach-client -t CLIENT`, or with `kill` `-P`, its process sent
SIGHUP. -}
detachClient : Bool -> String -> String
detachClient kill client =
    if kill then
        render detachKillShape [ quote client ]

    else
        render (targeted "detach-client") [ quote client ]


suspendClient : String -> String
suspendClient client =
    render (targeted "suspend-client") [ quote client ]


deleteBuffer : String -> String
deleteBuffer name =
    render deleteBufferShape [ quote name ]


{-| `switch-client -T root`: the client's key table back at the root. -}
rootTable : String
rootTable =
    render rootShape [ "root" ]


{-| `resize-pane -t TARGET`, its width, its height or both. -}
resizePane : String -> Maybe Int -> Maybe Int -> String
resizePane target width height =
    render resizeShape [ quote target, Maybe.withDefault (meant Reason.NotSet "") (Maybe.map String.fromInt width), Maybe.withDefault (meant Reason.NotSet "") (Maybe.map String.fromInt height) ]


{-| `move-pane -t TARGET -X x -Y y`: a floating pane placed. -}
movePane : String -> Int -> Int -> String
movePane target x y =
    render moveShape [ quote target, String.fromInt x, String.fromInt y ]


{-| `set-option -p -t PANE NAME VALUE`: a pane's own option. -}
setPaneOption : String -> String -> String -> String
setPaneOption pane name value =
    render setPaneShape [ quote pane, name, quote value ]


{-| `set-option -p -F NAME FORMAT`: the current pane's option, the format
expanded. -}
setPaneFormat : String -> String -> String
setPaneFormat name format =
    render setPaneFormatShape [ name, quote format ]


{-| `if-shell -F -t PANE CONDITION { COMMANDS }`, the commands given as
they are (a binding's). -}
ifShellMouse : String -> String -> String -> String
ifShellMouse pane condition commands =
    render ifShellShape [ quote pane, quote condition, "{ " ++ commands ++ " }" ]


{-| tmux 3.8's popup as a floating pane (`new-pane -O`), kept open with
`k`, at a size and place, in a directory, running a command; an empty
directory or command left out. -}
popup : { keep : Bool, pane : String, width : String, height : String, x : String, y : String, dir : String, command : String } -> String
popup p =
    render popupShape
        [ if p.keep then
            "1"

          else
            ""
        , quote p.pane
        , quote p.width
        , quote p.height
        , quote p.x
        , quote p.y
        , if p.dir == "" then
            ""

          else
            quote p.dir
        , if p.command == "" then
            ""

          else
            quote p.command
        ]


-- CUSTOMIZE-MODE'S CHANGES (TK7)


{-| The level flags customize-mode's options are set at, by its scope:
1 the server (`-s`), 2 the session's global (`-g`), 3 the session
(`-t`), 4 windows' global (`-gw`), 5 the window (`-w -t`), 6 the pane
(`-p -t`). -}
levelParts : Array Part
levelParts =
    [ OptFlag "s", OptFlag "g", OptFlag "w", OptFlag "p", OptValue "t" ]


levelValues : Int -> String -> Array String
levelValues scope pane =
    let
        on b =
            if b then
                "1"

            else
                ""
    in
    [ on (scope == 1)
    , on (scope == 2 || scope == 4)
    , on (scope == 4 || scope == 5)
    , on (scope == 6)
    , if scope == 3 || scope == 5 || scope == 6 then
        quote pane

      else
        ""
    ]


setOptionShape : Shape
setOptionShape =
    { name = "set-option", parts = levelParts ++ [ Rest ], allowed = custom }


unsetOptionShape : Shape
unsetOptionShape =
    { name = "set-option", parts = Array.pushFirst (Flag "u") levelParts ++ [ Rest ], allowed = custom }


{-| Hooks have no server level: no tmux's `set-hook` or `show-hooks`
takes `-s` (the catalog's check found it, TK7). A hook said to be at the
server's is set globally. -}
hookLevelParts : Array Part
hookLevelParts =
    [ OptFlag "g", OptFlag "w", OptFlag "p", OptValue "t" ]


hookLevelValues : Int -> String -> Array String
hookLevelValues scope pane =
    levelValues
        (if scope == 1 then
            2

         else
            scope
        )
        pane
        |> Array.dropFirst 1


setHookShape : Shape
setHookShape =
    { name = "set-hook", parts = hookLevelParts ++ [ Rest ], allowed = custom }


showHooksShape : Shape
showHooksShape =
    -- how often a hook has run (3.8)
    { name = "show-hooks", parts = hookLevelParts ++ [ Value "F", Rest ], allowed = \c -> custom c && Caps.has "show-hooks" "F" c }


setEnvironmentShape : Shape
setEnvironmentShape =
    { name = "set-environment", parts = [ OptFlag "g", OptValue "t", OptFlag "h", OptFlag "r", OptFlag "u", Rest ], allowed = custom }


bindKeyShape : Shape
bindKeyShape =
    { name = "bind-key", parts = [ Value "T", OptFlag "r", OptValue "N", Rest ], allowed = custom }


unbindKeyShape : Shape
unbindKeyShape =
    { name = "unbind-key", parts = [ Value "T", Rest ], allowed = custom }


{-| `set-option` at a level (`levelValues`): `NAME VALUE`. -}
setOption : Int -> String -> String -> String -> String
setOption scope pane name value =
    render setOptionShape (levelValues scope pane ++ [ quote name, quote value ])


{-| `set-option -u` at a level: the option unset there. -}
unsetOption : Int -> String -> String -> String
unsetOption scope pane name =
    render unsetOptionShape (levelValues scope pane ++ [ quote name ])


setHook : Int -> String -> String -> String -> String
setHook scope pane name command =
    render setHookShape (hookLevelValues scope pane ++ [ quote name, quote command ])


{-| `show-hooks -F FORMAT NAME` at a level. -}
showHooks : Int -> String -> String -> String -> String
showHooks scope pane format name =
    render showHooksShape (hookLevelValues scope pane ++ [ quote format, quote name ])


{-| `set-environment`, globally (`global`) or for the session `pane` is
in, hidden (`-h`), removed (`-r`) or unset (`-u`), then its words. -}
setEnvironment : { global : Bool, pane : String, hidden : Bool, remove : Bool, unset : Bool } -> Array String -> String
setEnvironment e words =
    let
        on b =
            if b then
                "1"

            else
                ""
    in
    render setEnvironmentShape
        ([ on e.global
         , if e.global then
            ""

           else
            quote e.pane
         , on e.hidden
         , on e.remove
         , on e.unset
         ]
            ++ Array.map quote words
        )


{-| `bind-key -T TABLE [-r] [-N NOTE] KEY COMMAND`. -}
bindKey : { table : String, repeat : Bool, note : String, key : String, command : String } -> String
bindKey b =
    render bindKeyShape
        [ quote b.table
        , if b.repeat then
            "1"

          else
            ""
        , if b.note == "" then
            ""

          else
            quote b.note
        , quote b.key
        , quote b.command
        ]


unbindKey : String -> String -> String
unbindKey table key =
    render unbindKeyShape [ quote table, quote key ]


{-| tmux's own templates for its choose lists, when a binding gives none,
each on `'%%'`. -}
detachTemplate : String
detachTemplate =
    render (targeted "detach-client") [ "'%%'" ]


pasteTemplate : String
pasteTemplate =
    render templatePasteShape [ "'%%'" ]


selectTemplate : String
selectTemplate =
    render (targeted "select-pane") [ "'%%'" ]


switchTemplate : String
switchTemplate =
    render (targeted "switch-client") [ "'%%'" ]


templatePasteShape : Shape
templatePasteShape =
    { name = "paste-buffer", parts = [ Flag "p", Value "b" ], allowed = anyTmux }


{-| Every shape puritty sends. -}
catalog : Array Shape
catalog =
    [ sendHex
    , sendLiteral
    , sendNamed
    , sendClientKey
    , sendClientHex
    , sizeByX
    , sizeByComma
    , clientFlagsShape
    , continueShape
    , listPanesShape
    , listCommandsShape
    , setBufferFirst
    , setBufferAppend
    , pasteShape
    , displayShape
    , displayAtShape
    , listPanesSessionShape
    , listPanesAllShape
    , listPanesTargetShape
    , listWindowsShape
    , listWindowsAllShape
    , listWindowsTargetShape
    , listSessionsShape
    , listBuffersShape
    , listClientsShape
    , showBufferShape
    , showTopBufferShape
    , promptHistoryShape
    , globalValueShape
    , captureShape
    , captureHistoryShape
    , captureSavedShape
    , listKeysShape
    , listKeysFormatShape
    , listKeysNotesShape
    , subscribeShape
    ]
        ++ Array.map .shape showOptionsShapes
        ++ Array.map .shape showEnvironmentShapes
        ++ Array.map bare [ "new-window", "next-window", "previous-window" ]
        ++ Array.map targeted [ "select-window", "select-pane", "kill-pane", "kill-window", "kill-session", "detach-client", "suspend-client" ]
        ++ [ setOptionShape, unsetOptionShape, setHookShape, showHooksShape, setEnvironmentShape, bindKeyShape, unbindKeyShape, templatePasteShape, targeted "switch-client" ]
        ++ [ markShape, unmarkShape, swapWindowShape, detachKillShape, deleteBufferShape, rootShape, resizeShape, moveShape, setPaneShape, setPaneFormatShape, ifShellShape, popupShape ]


{-| `list-commands` with no format: each command's usage line, which
every tmux from 2.7 answers so (TM72). -}
listCommands : String
listCommands =
    render listCommandsShape []


{-| A paste given to tmux to make (puritty `docs/tmux.md` TM64): the text
into a buffer of puritty's (`set-buffer`, in pieces of 1024 bytes, `-a`
after the first), then on its last piece `paste-buffer -p -r -d` into the
pane, so that tmux brackets it where the program asked for bracketed
paste, which tmux knows and puritty may not (3.6), keeps its line ends as
they are (`-r`), as a tmux client passes a paste on, and drops the buffer.
The first piece starts the buffer again; an empty paste makes nothing. -}
pasteBytes : Int -> { first : Bool, last : Bool } -> Bytes -> Array String
pasteBytes pane piece bytes =
    let
        count =
            Bytes.length bytes

        chunks =
            Array.range 0 ((count - 1) // 1024)
                |> Array.keepIf (\_ -> count > 0)
                |> Array.map (\i -> Bytes.slice (i * 1024) (min count ((i + 1) * 1024)) bytes)

        sets =
            Array.indexedMap
                (\i chunk ->
                    render
                        (if piece.first && i == 0 then
                            setBufferFirst

                         else
                            setBufferAppend
                        )
                        [ "puritty-paste", quoteBytes chunk ]
                )
                chunks

        pasted =
            if piece.last && (not piece.first || count > 0) then
                [ render pasteShape [ "puritty-paste", quote ("%" ++ String.fromInt pane) ] ]

            else
                []
    in
    sets ++ pasted


{-| Bytes as one double-quoted word of tmux's syntax, which keeps them on
the command's one line, read back by tmux's parser byte for byte (TM94):
printable ASCII as it is; `"`, `\` and `$` behind a backslash; Escape,
CR, LF and Tab as `\e`, `\r`, `\n` and `\t`, the escapes every tmux's
parser takes (2.x's `cmd-string.c` has only those; 3.0's `cmd-parse.y`
octal besides); valid UTF-8 as its characters, which both take as they
are; any other byte as an octal escape (`\200`), which only 3.0 on reads. -}
quoteBytes : Bytes -> String
quoteBytes bytes =
    "\"" ++ quoteFrom bytes 0 (Bytes.length bytes) "" ++ "\""


quoteFrom : Bytes -> Int -> Int -> String -> String
quoteFrom bytes i n acc =
    if i >= n then
        acc

    else
        let
            -- a byte past the end reads as 0, which no test takes
            at k =
                UInt8.toInt (Bytes.getProven k bytes)

            b =
                at i

            ascii c =
                String.fromChar (Char.fromCodeProven c)

            octal c =
                "\\" ++ String.fromInt (c // 64) ++ String.fromInt (modBy 8 (c // 8)) ++ String.fromInt (modBy 8 c)

            -- a UTF-8 sequence's length from its lead byte, 0 for none
            length =
                if b >= 0xC2 && b <= 0xDF then
                    2

                else if b >= 0xE0 && b <= 0xEF then
                    3

                else if b >= 0xF0 && b <= 0xF4 then
                    4

                else
                    0

            sequence =
                Bytes.slice i (i + length) bytes

            -- whole, every byte after the lead a continuation, and the same
            -- bytes again when decoded and encoded (no overlong form)
            valid =
                length > 0
                    && i <= n - length
                    && Array.all (\k -> at k >= 0x80 && at k <= 0xBF) (Array.range (i + 1) (i + length - 1))
                    && Bytes.fromString (Bytes.toStringLossy sequence) == sequence
        in
        if valid then
            quoteFrom bytes (i + length) n (acc ++ Bytes.toStringLossy sequence)

        else
            quoteFrom bytes
                (i + 1)
                n
                (acc
                    ++ (if b == 0x22 || b == 0x5C || b == 0x24 || b == 0x7E then
                            -- `~` too: tmux 3.x expands one first in a double-
                            -- quoted word as a home folder (measured on 3.8:
                            -- "~/.bashrc" stored as /home/me/.bashrc), and
                            -- gives back `\~` as `~` (the code review's TP1)
                            "\\" ++ ascii b

                        else if b == 0x1B then
                            "\\e"

                        else if b == 0x0D then
                            "\\r"

                        else if b == 0x0A then
                            "\\n"

                        else if b == 0x09 then
                            "\\t"

                        else if b >= 0x20 && b < 0x7F then
                            ascii b

                        else
                            octal b
                       )
                )


{-| `send-keys -H`: the bytes as the pane's program reads them, hex, at
most 256 to a command so that a paste makes lines of a sensible length. -}
sendBytes : Int -> Bytes -> Array String
sendBytes pane bytes =
    let
        hex =
            Bytes.toHexString { padding = False } bytes

        count =
            Bytes.length bytes
    in
    Array.range 0 ((count - 1) // 256)
        |> Array.keepIf (\_ -> count > 0)
        |> Array.map
            (\i ->
                let
                    part =
                        String.slice (i * 512) (min (2 * count) ((i + 1) * 512)) hex
                in
                render sendHex [ quote ("%" ++ String.fromInt pane), pairs part ]
            )


{-| `send-keys -K`: a key by its tmux name (`C-a`, `M-x`, `S-Up`), to the
client, so that it is looked up in the client's key table as a key typed
at a terminal is: the prefix and the bindings work, and a key bound to
nothing goes to the active pane, encoded by tmux for that pane's modes.
Bytes given with `-t pane -H` reach the pane without any lookup (TM23). -}
sendKey : String -> String
sendKey name =
    render sendClientKey [ quote name ]


{-| `send-keys -t %N`: a key by its tmux name straight to a pane, encoded
by tmux for the pane's modes. For a key no binding takes: `send-keys -K`
leaves its internal "sent" flag on the key, and tmux then drops every key
that is an escape sequence (Down, F5; 3.7c, 3.8; 3.6a sends a wrong
byte) and, when the pane has extended keys, Enter too (puritty
`docs/tmux.md` TM50). -}
sendKeyTo : Int -> String -> String
sendKeyTo pane name =
    render sendNamed [ quote ("%" ++ String.fromInt pane), quote name ]


{-| `send-keys -t %N -X -N 5 scroll-up` (or `scroll-down`): the wheel in
copy mode, as every tmux from 2.7 binds `WheelUpPane` and `WheelDownPane`
in copy-mode and copy-mode-vi (puritty `docs/tmux.md` TM107). -}
copyScroll : Int -> Bool -> String
copyScroll pane up =
    render copyScrollShape
        [ quote ("%" ++ String.fromInt pane)
        , "5"
        , if up then
            "scroll-up"

          else
            "scroll-down"
        ]


copyScrollShape : Shape
copyScrollShape =
    { name = "send-keys", parts = [ Value "t", Flag "X", Value "N", Rest ], allowed = \c -> Caps.has "send-keys" "X" c && Caps.has "send-keys" "N" c }


{-| `send-keys -K -H`: typed text, its UTF-8 bytes in hex, through the
client's key table as `sendKey`'s keys are: a character after the prefix
is the binding's key (TM23). -}
typeText : Bytes -> Array String
typeText bytes =
    if Bytes.isEmpty bytes then
        []

    else
        [ render sendClientHex [ pairs (Bytes.toHexString { padding = False } bytes) ] ]


{-| `abcd` as `ab cd`. -}
pairs : String -> String
pairs hex =
    Array.range 0 (String.count hex // 2 - 1)
        |> Array.map (\i -> String.slice (2 * i) (2 * i + 2) hex)
        |> String.join " "


{-| The client's size, `refresh-client -C`, in cells. -}
size : { cols : Int, rows : Int } -> String
size s =
    render sizeByX [ String.fromInt (max 1 s.cols) ++ "x" ++ String.fromInt (max 1 s.rows) ]


{-| The client's size as tmux before 3.0 takes it, `-C 80,24`: it refuses
`80x24` (`bad size argument`; TM72). -}
sizeComma : { cols : Int, rows : Int } -> String
sizeComma s =
    render sizeByComma [ String.fromInt (max 1 s.cols) ++ "," ++ String.fromInt (max 1 s.rows) ]


{-| `send-keys` for a tmux before 3.0, which has no `-H` (TM72): the bytes
as runs, text by `-l` and each control byte by its key's name, which tmux
writes to the pane as that byte. Measured on 2.7 and 2.9a through a control
client: its parser reads no octal escape (`"\003"` gives `003`) and drops a
`;` that ends a word even in quotes, so text goes in single quotes, a `'` as
`"'"` and each `;` as a word of its own, `\;`. UTF-8 goes as it is. The
text follows `--`: tmux's getopt would read a first word that begins with
`-` as flags and refuse the command (`docs/tmux-checks.md` TK9). -}
sendBytesPlain : Int -> Bytes -> Array String
sendBytesPlain pane bytes =
    let
        target =
            quote ("%" ++ String.fromInt pane)

        runs =
            Array.range 0 (Bytes.length bytes - 1)
                |> Array.mapAndKeepJust (\i -> Bytes.get i bytes)
                |> Array.foldl
                    (\u acc ->
                        when controlName (UInt8.toInt u) is
                            Just name ->
                                { runs = Array.pushLast { control = True, bytes = Bytes.empty, name = name } (closed acc), text = [] }

                            Nothing ->
                                -- not a control byte: text
                                meant Reason.NotKnown { acc | text = Array.pushLast u acc.text }
                    )
                    { runs = [], text = [] }

        closed acc =
            if Array.isEmpty acc.text then
                acc.runs

            else
                Array.pushLast { control = False, bytes = Bytes.fromUInt8s acc.text, name = "" } acc.runs

        all =
            closed runs
    in
    Array.map
        (\r ->
            if r.control then
                render sendNamed [ target, r.name ]

            else
                render sendLiteral [ target, plainWords (Bytes.toStringLossy r.bytes) ]
        )
        all


{-| Text as the words of `send-keys -l` for tmux 2.x: single-quoted runs,
a `'` as `"'"`, a `;` as `\;`. -}
plainWords : String -> String
plainWords text =
    String.toArray text
        |> Array.foldl
            (\c acc ->
                if c == ';' then
                    { words = Array.pushLast "\\;" (flush acc), run = "" }

                else if c == '\'' then
                    { words = Array.pushLast "\"'\"" (flush acc), run = "" }

                else
                    { acc | run = acc.run ++ String.fromChar c }
            )
            { words = [], run = "" }
        |> flush
        |> String.join " "


flush : { words : Array String, run : String } -> Array String
flush acc =
    if acc.run == "" then
        acc.words

    else
        Array.pushLast ("'" ++ acc.run ++ "'") acc.words


{-| A control byte's key name, which tmux sends as that byte. -}
controlName : Int -> Maybe String
controlName b =
    if b == 0 then
        Just "C-@"

    else if b == 0x09 then
        Just "Tab"

    else if b == 0x0D then
        Just "Enter"

    else if b == 0x1B then
        Just "Escape"

    else if b < 0x1B then
        Just ("C-" ++ String.fromChar (Char.fromCode (b + 0x60) |> Maybe.withDefault (meant Reason.OutOfRange 'a')))

    else if b == 0x1C then
        Just "'C-\\'"

    else if b == 0x1D then
        Just "'C-]'"

    else if b == 0x1E then
        Just "'C-^'"

    else if b == 0x1F then
        Just "'C-_'"

    else if b == 0x7F then
        Just "BSpace"

    else
        Nothing


{-| The commands that run tmux commands of their own, each of which tmux
answers with a block, as this client's from 3.2 (puritty
docs/tmux-checks.md TK10): `source-file` and `if-shell` always (`flags`
anything), `run-shell` only with `-C` (`flags` holding `C`). -}
runsOthers : String -> String -> Bool
runsOthers name flags =
    Array.member name [ "source-file", "source", "if-shell", "if" ]
        || (Array.member name [ "run-shell", "run" ] && String.contains "C" flags)


{-| A binding's command as `list-keys` prints it, made a command line to
send: its commands joined by ` \; ` in the listing, by ` ; ` on a line
(TM72). -}
bindingLine : String -> String
bindingLine command =
    String.split " " command
        |> Array.map
            (\w ->
                if w == "\\;" then
                    ";"

                else
                    w
            )
        |> String.join " "


{-| The flags puritty sets on attach: 3.8's layouts with floating panes
(an older tmux ignores a name it does not know, TM5.5), and `pause-after`:
a pane whose output puritty has not read for five seconds is paused and
its backlog dropped, rather than the client being ended as "too far
behind" after five minutes (TM5.7, TM19). -}
clientFlags : String
clientFlags =
    render clientFlagsShape [ "new-layouts,pause-after=5" ]


{-| A line to find out whether tmux is still there (docs/tmux-checks.md
TK14): tmux answers it with `%begin` and `%error` ("unknown command: :",
2.7 to 3.8), and a shell it reaches after a killed client runs `:`, which
does nothing. -}
probe : String
probe =
    ": puritty"


{-| A paused pane continued: its output again from now (TM5.7). -}
continuePane : Int -> String
continuePane pane =
    render continueShape [ quote ("%" ++ String.fromInt pane ++ ":continue") ]


{-| Each pane of the session's current window and its state, one line a
pane, each starting with `P` so that no line can read as a guard (TM5.2). -}
listPanes : String
listPanes =
    render listPanesShape [ quote "P #{pane_id} #{window_id} #{pane_active} #{cursor_x} #{cursor_y} #{alternate_on} #{window_layout}" ]


{-| A word for tmux's command line, single-quoted: tmux takes nothing in
single quotes as special, and `'` itself is ended, escaped and begun. -}
quote : String -> String
quote s =
    "'" ++ String.replace "'" "'\\''" s ++ "'"
