module Tmux.Syntax exposing
    ( Ask(..)
    , Entry(..)
    , Menu
    , MenuItem
    , Token
    , askOf
    , commands
    , customizeOf
    , fill
    , ifFormatOf
    , lines
    , listOf
    , menuOf
    , panesOf
    , popupOf
    , retarget
    , serialize
    , tokens
    , treeOf
    )

{-| tmux's command language, as much of it as puritty needs to run a
binding's prompt itself (puritty `docs/tmux.md` TM25): words, quotes,
`{ … }` blocks and `;` between commands, as `list-keys` writes them;
`command-prompt` and `confirm-before` read from them; and a template
filled with what was typed, each filled word quoted so that nothing typed
is read as tmux syntax.
-}

import Tmux.Command as Command
import Tmux.Reason as Reason


{-| A word as written (`raw`), what it says with its quotes and escapes
taken off (`value`), and whether it is a `{ … }` block (its `value` then
what is inside the braces) or a `;` between commands. -}
type alias Token =
    { raw : String, value : String, block : Bool, sep : Bool }


{-| The words of a command line. -}
tokens : String -> Array Token
tokens text =
    scan (String.toArray text) 0 []


scan : Array Char -> Int -> Array Token -> Array Token
scan chars i acc =
    when Array.get i chars is
        Nothing ->
            meant Reason.NoMore acc

        Just c ->
            if c == ' ' || c == '\t' || c == '\n' then
                scan chars (i + 1) acc

            else if c == ';' then
                scan chars (i + 1) (Array.pushLast { raw = ";", value = ";", block = False, sep = True } acc)

            else if c == '{' then
                let
                    close =
                        closing chars (i + 1) 1
                in
                scan chars
                    (close + 1)
                    (Array.pushLast
                        { raw = String.fromArray (Array.slice i (close + 1) chars)
                        , value = String.trim (String.fromArray (Array.slice (i + 1) close chars))
                        , block = True
                        , sep = False
                        }
                        acc
                    )

            else
                let
                    w =
                        word chars i { value = "", quote = ' ' }

                    raw =
                        String.fromArray (Array.slice i w.end chars)

                    t =
                        { raw = raw, value = w.value, block = False, sep = raw == "\\;" }

                    withSep =
                        if w.sepAfter then
                            Array.pushLast { raw = ";", value = ";", block = False, sep = True } (Array.pushLast t acc)

                        else
                            Array.pushLast t acc
                in
                scan chars
                    (if w.sepAfter then
                        w.end + 1

                     else
                        w.end
                    )
                    withSep


{-| Where a block's `}` is: braces counted, quotes skipped; the end of
the text when there is none. -}
closing : Array Char -> Int -> Int -> Int
closing chars i depth =
    when Array.get i chars is
        Nothing ->
            meant Reason.FromOutside i

        Just c ->
            if c == '}' then
                if depth == 1 then
                    i

                else
                    closing chars (i + 1) (depth - 1)

            else if c == '{' then
                closing chars (i + 1) (depth + 1)

            else if c == '\'' then
                closing chars (skipTo chars (i + 1) '\'') depth

            else if c == '"' then
                closing chars (skipTo chars (i + 1) '"') depth

            else if c == '\\' then
                closing chars (i + 2) depth

            else
                closing chars (i + 1) depth


skipTo : Array Char -> Int -> Char -> Int
skipTo chars i q =
    when Array.get i chars is
        Nothing ->
            meant Reason.FromOutside i

        Just c ->
            if c == q then
                i + 1

            else if c == '\\' && q == '"' then
                skipTo chars (i + 2) q

            else
                skipTo chars (i + 1) q


{-| A word from `i`: its value, where it ends, and whether an unquoted `;`
ended it. -}
word : Array Char -> Int -> { value : String, quote : Char } -> { value : String, end : Int, sepAfter : Bool }
word chars i st =
    when Array.get i chars is
        Nothing ->
            meant Reason.NoMore { value = st.value, end = i, sepAfter = False }

        Just c ->
            if st.quote == '\'' then
                if c == '\'' then
                    word chars (i + 1) { st | quote = ' ' }

                else
                    word chars (i + 1) { st | value = st.value ++ String.fromChar c }

            else if st.quote == '"' then
                if c == '"' then
                    word chars (i + 1) { st | quote = ' ' }

                else if c == '\\' then
                    word chars (i + 2) { st | value = st.value ++ (Array.get (i + 1) chars |> Maybe.map String.fromChar |> Maybe.withDefault (meant Reason.FromOutside "")) }

                else
                    word chars (i + 1) { st | value = st.value ++ String.fromChar c }

            else if c == ' ' || c == '\t' || c == '\n' then
                { value = st.value, end = i, sepAfter = False }

            else if c == ';' then
                { value = st.value, end = i, sepAfter = True }

            else if c == '\'' || c == '"' then
                word chars (i + 1) { st | quote = c }

            else if c == '\\' then
                word chars (i + 2) { st | value = st.value ++ (Array.get (i + 1) chars |> Maybe.map String.fromChar |> Maybe.withDefault (meant Reason.FromOutside "")) }

            else
                word chars (i + 1) { st | value = st.value ++ String.fromChar c }


{-| The commands of a line, split at its `;`s. -}
commands : Array Token -> Array (Array Token)
commands ts =
    let
        split =
            Array.foldl
                (\t acc ->
                    if t.sep then
                        { done = Array.pushLast acc.current acc.done, current = [] }

                    else
                        { acc | current = Array.pushLast t acc.current }
                )
                { done = [], current = [] }
                ts
    in
    Array.pushLast split.current split.done
        |> Array.keepIf (\c -> not (Array.isEmpty c))


{-| What a `command-prompt` asks for each answer: text, one key's text
(`-1`), digits (`-N`), or a key's name (`-k`). -}
type Entry
    = Text
    | Single
    | Numeric
    | KeyName


{-| A prompt a binding opens, read from its command: a confirmation, with
its question, the command it runs, the key that says yes and whether
Enter does; or a command prompt, with a question and a first text for
each answer, how an answer is typed, its template (`Nothing`: what is
typed is the command), whether it is incremental (`-i`: the template
runs on every change to the line, with `=`, `-` or `+` before it), and
whether it is asked in the pane (`-P`, 3.8) rather than the status line. -}
type Ask
    = Confirm { prompt : String, run : String, key : String, enterYes : Bool }
    | Prompt { prompts : Array String, inputs : Array String, entry : Entry, template : Maybe (Array Token), incremental : Bool, inPane : Bool }


{-| The prompt a binding's command opens when it begins with
`command-prompt` or `confirm-before`, and the commands after it, which
tmux runs once the prompt closes, as one line. -}
askOf : String -> Maybe { ask : Ask, after : String }
askOf command =
    let
        cmds =
            commands (tokens command)

        after =
            Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; "
    in
    when Array.first cmds is
        Just first ->
            when Array.first first is
                Just name ->
                    let
                        args =
                            flags "IpTtc" (Array.dropFirst 1 first)
                    in
                    if name.value == "confirm-before" then
                        let
                            run =
                                runOf args.rest

                            key =
                                Maybe.withDefault (meant Reason.NotSet "y") (getFlag 'c' args.values)
                        in
                        Just
                            { ask =
                                Confirm
                                    { prompt =
                                        when getFlag 'p' args.values is
                                            Just p ->
                                                p ++ " "

                                            Nothing ->
                                                meant Reason.NotSet "Confirm '" ++ firstWord run ++ "'? (" ++ key ++ "/n) "
                                    , run = run
                                    , key = key
                                    , enterYes = String.contains "y" args.bools
                                    }
                            , after = after
                            }

                    else if name.value == "command-prompt" then
                        let
                            template =
                                when args.rest is
                                    [] ->
                                        Nothing

                                    [ one ] ->
                                        Just (tokens one.value)

                                    many ->
                                        Just (tokens (String.join " " (Array.map .raw many)))

                            literal =
                                String.contains "l" args.bools

                            prompts =
                                when getFlag 'p' args.values is
                                    Just p ->
                                        (if literal then
                                            [ p ]

                                         else
                                            String.split "," p
                                        )
                                            |> Array.map (\q -> q ++ " ")

                                    Nothing ->
                                        meant Reason.NotSet
                                            when template is
                                                Just t ->
                                                    [ "(" ++ firstWord (serialize t) ++ ") " ]

                                                Nothing ->
                                                    meant Reason.NotSet [ ":" ]

                            inputs =
                                when getFlag 'I' args.values is
                                    Just i ->
                                        if literal then
                                            [ i ]

                                        else
                                            String.split "," i

                                    Nothing ->
                                        meant Reason.NotSet []

                            entry =
                                if String.contains "1" args.bools then
                                    Single

                                else if String.contains "N" args.bools then
                                    Numeric

                                else if String.contains "k" args.bools then
                                    KeyName

                                else
                                    Text
                        in
                        Just
                            { ask = Prompt { prompts = prompts, inputs = inputs, entry = entry, template = template, incremental = String.contains "i" args.bools, inPane = String.contains "P" args.bools }
                            , after = after
                            }

                    else
                        Nothing

                Nothing ->
                    Nothing

        Nothing ->
            meant Reason.FromOutside Nothing


{-| A menu a binding shows (`display-menu`, puritty `docs/tmux.md` TM27):
its title, the pane its formats are read in (`-t`, `=` for the mouse's),
where it goes (`-x`, `-y`: a number, or `C`, `R`, `P`, `M`, `W`, `S` as
tmux(1) has them), and its items, as written: formats are tmux's to
expand. -}
type alias Menu =
    { title : String
    , target : String
    , x : String
    , y : String
    , items : Array MenuItem
    }


{-| An item: its name (empty for a line between items; a name that begins
with `-` once expanded is shown and cannot be chosen), the key that
chooses it, and its command as one line. -}
type alias MenuItem =
    { name : String, key : String, command : String }


{-| The menu a binding's command shows when it begins with
`display-menu`, and the commands after it, which tmux runs at once: a
menu does not wait. -}
menuOf : String -> Maybe { menu : Menu, after : String }
menuOf command =
    let
        cmds =
            commands (tokens command)
    in
    when Array.first cmds is
        Just first ->
            if Maybe.map .value (Array.first first) == Just "display-menu" || Maybe.map .value (Array.first first) == Just "menu" then
                let
                    args =
                        flags "bcCHsStTxy" (Array.dropFirst 1 first)

                    value c =
                        Maybe.withDefault (meant Reason.NotSet "") (getFlag c args.values)
                in
                Just
                    { menu =
                        { title = value 'T'
                        , target = value 't'
                        , x = value 'x'
                        , y = value 'y'
                        , items = itemsOf args.rest []
                        }
                    , after = Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; "
                    }

            else
                Nothing

        Nothing ->
            meant Reason.FromOutside Nothing


{-| A menu's items from its words: a name, a key and a command each, or an
empty name alone for a line. -}
itemsOf : Array Token -> Array MenuItem -> Array MenuItem
itemsOf ts acc =
    when Array.first ts is
        Nothing ->
            meant Reason.NoMore acc

        Just name ->
            if name.value == "" && not name.block then
                itemsOf (Array.dropFirst 1 ts) (Array.pushLast { name = "", key = "", command = "" } acc)

            else
                let
                    key =
                        Array.get 1 ts |> Maybe.map .value |> Maybe.withDefault (meant Reason.FromOutside "")

                    command =
                        when Array.get 2 ts is
                            Just c ->
                                if c.block then
                                    serialize (tokens c.value)

                                else
                                    c.value

                            Nothing ->
                                meant Reason.FromOutside ""
                in
                itemsOf (Array.dropFirst 3 ts) (Array.pushLast { name = name.value, key = key, command = command } acc)


{-| A binding's command that chooses by a format, `if-shell -F` (or `if
-F`): the pane it is read in, the format, the commands it runs when the
format gives something other than empty or `0`, those it runs otherwise,
and the commands after it, which wait for it. `Nothing` for an `if-shell`
that runs a shell command, which only tmux can run. -}
ifFormatOf : String -> Maybe { target : String, condition : String, yes : String, no : String, after : String }
ifFormatOf command =
    let
        cmds =
            commands (tokens command)

        branch t =
            if t.block then
                serialize (tokens t.value)

            else
                t.value
    in
    when Array.first cmds is
        Just first ->
            if Maybe.map .value (Array.first first) == Just "if-shell" || Maybe.map .value (Array.first first) == Just "if" then
                let
                    args =
                        flags "t" (Array.dropFirst 1 first)
                in
                if String.contains "F" args.bools then
                    when args.rest is
                        [ condition, yes ] ->
                            Just { target = Maybe.withDefault (meant Reason.NotSet "") (getFlag 't' args.values), condition = condition.value, yes = branch yes, no = "", after = Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; " }

                        [ condition, yes, no ] ->
                            Just { target = Maybe.withDefault (meant Reason.NotSet "") (getFlag 't' args.values), condition = condition.value, yes = branch yes, no = branch no, after = Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; " }

                        _ ->
                            Nothing

                else
                    Nothing

            else
                Nothing

        Nothing ->
            meant Reason.FromOutside Nothing


{-| The flags of a command's arguments: the ones without a value, run
together (`1NP`), those with one (`-p text`, `-ptext`), whose letters
`valued` holds, and the words after them. -}
flags : String -> Array Token -> { bools : String, values : Array { flag : Char, value : String }, rest : Array Token }
flags valued ts =
    let
        withValue c =
            String.contains (String.fromChar c) valued

        go i acc =
            when Array.get i ts is
                Just t ->
                    if t.block || not (String.startsWith "-" t.value) || String.count t.value < 2 then
                        { acc | rest = Array.dropFirst i ts }

                    else if t.value == "--" then
                        { acc | rest = Array.dropFirst (i + 1) ts }

                    else
                        let
                            letters =
                                String.toArray (String.dropFirst 1 t.value)

                            found =
                                Array.foldl
                                    (\c a ->
                                        if a.taking /= Nothing then
                                            { a | tail = a.tail ++ String.fromChar c }

                                        else if withValue c then
                                            { a | taking = Just c }

                                        else
                                            { a | bools = a.bools ++ String.fromChar c }
                                    )
                                    { bools = "", taking = Nothing, tail = "" }
                                    letters
                        in
                        when found.taking is
                            Just f ->
                                if found.tail /= "" then
                                    go (i + 1) { acc | bools = acc.bools ++ found.bools, values = Array.pushLast { flag = f, value = found.tail } acc.values }

                                else
                                    go (i + 2) { acc | bools = acc.bools ++ found.bools, values = Array.pushLast { flag = f, value = Array.get (i + 1) ts |> Maybe.map .value |> Maybe.withDefault (meant Reason.FromOutside "") } acc.values }

                            Nothing ->
                                meant Reason.NotSet go (i + 1) { acc | bools = acc.bools ++ found.bools }

                Nothing ->
                    meant Reason.NoMore { acc | rest = [] }
    in
    go 0 { bools = "", values = [], rest = [] }


getFlag : Char -> Array { flag : Char, value : String } -> Maybe String
getFlag c values =
    Array.findLast (\v -> v.flag == c) values |> Maybe.map (\f -> f.value.value)


{-| The command a confirmation runs, as a line: a block's commands, or the
words as written. -}
runOf : Array Token -> String
runOf rest =
    when rest is
        [ one ] ->
            if one.block then
                serialize (tokens one.value)

            else
                one.value

        _ ->
            serialize rest


firstWord : String -> String
firstWord line =
    String.split " " (String.trim line) |> Array.first |> Maybe.withDefault ""


{-| Words as a command line again: as written, a block's inside written
again, a `;` as one. -}
serialize : Array Token -> String
serialize ts =
    ts
        |> Array.map
            (\t ->
                if t.sep then
                    ";"

                else if t.block then
                    "{ " ++ serialize (tokens t.value) ++ " }"

                else
                    t.raw
            )
        |> String.join " "


{-| A template filled with the answers (tmux's `%%` and `%%%` the first
answer, once; `%1` to `%9`, and `%1%`…, each its answer, everywhere), in
the words they are written in and in blocks: a word changed is written
again in single quotes, so that what was typed is one word of text and
never tmux syntax. -}
fill : Array Token -> Array String -> String
fill template answers =
    template
        |> Array.map
            (\t ->
                if t.sep then
                    ";"

                else if t.block then
                    "{ " ++ fill (tokens t.value) answers ++ " }"

                else
                    let
                        filled =
                            substitute t.value answers
                    in
                    if filled == t.value then
                        t.raw

                    else
                        Command.quote filled
            )
        |> String.join " "


substitute : String -> Array String -> String
substitute value answers =
    let
        first =
            Maybe.withDefault (meant Reason.FromOutside "") (Array.get 0 answers)

        once =
            if String.contains "%%%" value then
                replaceFirst "%%%" first value

            else if String.contains "%%" value then
                replaceFirst "%%" first value

            else
                value
    in
    Array.foldl
        (\pair v ->
            let
                answer =
                    Maybe.withDefault (meant Reason.FromOutside "") (Array.get pair.index answers)

                mark =
                    "%" ++ pair.digit
            in
            v |> String.replace (mark ++ "%") answer |> String.replace mark answer
        )
        once
        ([ "1", "2", "3", "4", "5", "6", "7", "8", "9" ] |> Array.indexedMap (\i digit -> { index = i, digit = digit }))


replaceFirst : String -> String -> String -> String
replaceFirst pattern with text =
    when String.split pattern text |> Array.popFirst is
        Just { first, rest } ->
            if Array.isEmpty rest then
                text

            else
                first ++ with ++ String.join pattern rest

        Nothing ->
            text


{-| A command line with the mouse's pane (`-t =`, `-t=`, `-t {mouse}`,
flags run together as `-Xt=`) made `pane`: under control mode there is no
mouse event for tmux to find it by (puritty `docs/tmux.md` TM27). -}
retarget : String -> String -> String
retarget pane line =
    retargetTokens pane (tokens line)


retargetTokens : String -> Array Token -> String
retargetTokens pane ts =
    Array.foldl
        (\t acc ->
            let
                afterT =
                    String.startsWith "-" acc.prev && not (String.startsWith "--" acc.prev) && String.endsWith "t" acc.prev

                out =
                    if t.sep then
                        ";"

                    else if t.block && t.value == "mouse" && afterT then
                        pane

                    else if t.block then
                        "{ " ++ retargetTokens pane (tokens t.value) ++ " }"

                    else if t.value == "=" && afterT then
                        pane

                    else if String.startsWith "-" t.value && not (String.startsWith "--" t.value) && String.endsWith "t=" t.raw then
                        String.dropLast 1 t.raw ++ pane

                    else
                        t.raw
            in
            { prev =
                if t.block then
                    ""

                else
                    t.value
            , out = Array.pushLast out acc.out
            }
        )
        { prev = "", out = [] }
        ts
        |> .out
        |> String.join " "


{-| A command line's commands, each a line of its own: tmux answers each
command of a line in a block of its own and stops at the first that fails,
so a line sent as its commands one by one has one answer each, whatever
fails. -}
lines : String -> Array String
lines line =
    commands (tokens line) |> Array.map serialize


{-| What a binding's `display-panes` asks (puritty `docs/tmux.md` TM28):
how long the numbers stay (`-d`, milliseconds; `Nothing` for the
option's), whether a digit chooses a pane (not with `-N`), the command a
digit runs with `%%` its pane's index (`select-pane -t '%%'` when none is
given), and the commands after it. -}
panesOf : String -> Maybe { duration : Maybe Int, keys : Bool, template : String, after : String }
panesOf command =
    let
        cmds =
            commands (tokens command)
    in
    when Array.first cmds is
        Just first ->
            if Maybe.map .value (Array.first first) == Just "display-panes" || Maybe.map .value (Array.first first) == Just "displayp" then
                let
                    args =
                        flags "dt" (Array.dropFirst 1 first)
                in
                Just
                    { duration = getFlag 'd' args.values |> Maybe.andThen String.toInt
                    , keys = not (String.contains "N" args.bools)
                    , template =
                        when args.rest is
                            [] ->
                                "select-pane -t '%%'"

                            [ one ] ->
                                if one.block then
                                    serialize (tokens one.value)

                                else
                                    one.value

                            many ->
                                serialize many
                    , after = Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; "
                    }

            else
                Nothing

        Nothing ->
            meant Reason.FromOutside Nothing


{-| What a binding's `choose-tree` asks (puritty `docs/tmux.md` TM32), or
`choose-session` and `choose-window`, its old names, or `find-window`
(TM45): how it starts (`start`: 0 every session folded, `-s`; 1 the
sessions open on their windows, `-w`; 2 all open on the panes, neither,
as tmux's `WINDOW_TREE_PANE`), its filter (`-f`, or the one
`find-window` builds from its text), whether it zooms the pane (`-Z`),
the command a choice runs with `%%` the target chosen (`switch-client -t
'%%'` when none is given), and the commands after it. -}
treeOf : String -> Maybe { start : Int, filter : String, zoom : Bool, template : String, after : String }
treeOf command =
    let
        cmds =
            commands (tokens command)

        name =
            Array.first cmds |> Maybe.andThen Array.first |> Maybe.map .value |> Maybe.withDefault (meant Reason.FromOutside "")

        after =
            Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; "
    in
    when Array.first cmds is
        Just first ->
            if name == "choose-tree" || name == "choose-session" || name == "choose-window" then
                let
                    args =
                        flags "FfKOt" (Array.dropFirst 1 first)
                in
                Just
                    { start =
                        if name == "choose-session" || (name == "choose-tree" && String.contains "s" args.bools) then
                            0

                        else if name == "choose-window" || String.contains "w" args.bools then
                            1

                        else
                            2
                    , filter = Maybe.withDefault (meant Reason.NotSet "") (getFlag 'f' args.values)
                    , zoom = String.contains "Z" args.bools
                    , template =
                        when args.rest is
                            [] ->
                                "switch-client -t '%%'"

                            [ one ] ->
                                if one.block then
                                    serialize (tokens one.value)

                                else
                                    one.value

                            many ->
                                serialize many
                    , after = after
                    }

            else if name == "find-window" then
                let
                    args =
                        flags "t" (Array.dropFirst 1 first)
                in
                Just
                    { start = 2
                    , filter = findFilter args.bools (Array.map .value args.rest |> String.join " ")
                    , zoom = String.contains "Z" args.bools
                    , template = "switch-client -t '%%'"
                    , after = after
                    }

            else
                Nothing

        Nothing ->
            meant Reason.FromOutside Nothing


{-| The filter `find-window` gives tree mode for its text, as
`cmd-find-window.c` builds it: `-C` the panes' contents, `-N` the
windows' names, `-T` the panes' titles (all three when none is given),
`-i` ignoring case, `-r` a regular expression. -}
findFilter : String -> String -> String
findFilter bools text =
    let
        has c =
            String.contains c bools

        given =
            has "C" || has "N" || has "T"

        suffix =
            if has "r" && has "i" then
                "/ri"

            else if has "r" then
                "/r"

            else if has "i" then
                "/i"

            else
                ""

        star =
            if has "r" then
                ""

            else
                "*"

        content =
            "#{C" ++ suffix ++ ":" ++ text ++ "}"

        matching field =
            "#{m" ++ suffix ++ ":" ++ star ++ text ++ star ++ ",#{" ++ field ++ "}}"
    in
    when { c = not given || has "C", n = not given || has "N", t = not given || has "T" } is
        { c = True, n = True, t = True } ->
            "#{||:" ++ content ++ ",#{||:" ++ matching "window_name" ++ "," ++ matching "pane_title" ++ "}}"

        { c = True, n = True, t = False } ->
            "#{||:" ++ content ++ "," ++ matching "window_name" ++ "}"

        { c = True, n = False, t = True } ->
            "#{||:" ++ content ++ "," ++ matching "pane_title" ++ "}"

        { c = False, n = True, t = True } ->
            "#{||:" ++ matching "window_name" ++ "," ++ matching "pane_title" ++ "}"

        { c = True, n = False, t = False } ->
            content

        { c = False, n = True, t = False } ->
            matching "window_name"

        _ ->
            matching "pane_title"


{-| What a binding's `customize-mode` asks (puritty `docs/tmux.md` TM62):
its filter (`-f`), whether it zooms the pane (`-Z`), starts without the
description (`-N`), and answers its yes-or-no questions yes at once
(`-y`); the commands after it. -}
customizeOf : String -> Maybe { filter : String, zoom : Bool, noPreview : Bool, yes : Bool, after : String }
customizeOf command =
    let
        cmds =
            commands (tokens command)

        name =
            Array.first cmds |> Maybe.andThen Array.first |> Maybe.map .value |> Maybe.withDefault (meant Reason.FromOutside "")

        after =
            Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; "
    in
    when Array.first cmds is
        Just first ->
            if name == "customize-mode" then
                let
                    args =
                        flags "Fft" (Array.dropFirst 1 first)
                in
                Just
                    { filter = Maybe.withDefault (meant Reason.NotSet "") (getFlag 'f' args.values)
                    , zoom = String.contains "Z" args.bools
                    , noPreview = String.contains "N" args.bools
                    , yes = String.contains "y" args.bools
                    , after = after
                    }

            else
                Nothing

        Nothing ->
            meant Reason.FromOutside Nothing


{-| What a binding's `choose-buffer` or `choose-client` asks (puritty
`docs/tmux.md` TM55): which list, its filter (`-f`), whether it zooms the
pane (`-Z`), the command a choice runs with `%%` the buffer's or the
client's name (tmux's defaults when none is given: `paste-buffer -p -b
'%%'`, `detach-client -t '%%'`), and the commands after it. -}
listOf : String -> Maybe { kind : String, filter : String, zoom : Bool, template : String, after : String }
listOf command =
    let
        cmds =
            commands (tokens command)

        name =
            Array.first cmds |> Maybe.andThen Array.first |> Maybe.map .value |> Maybe.withDefault (meant Reason.FromOutside "")

        after =
            Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; "
    in
    when Array.first cmds is
        Just first ->
            if name == "choose-buffer" || name == "choose-client" then
                let
                    args =
                        flags "FfKOt" (Array.dropFirst 1 first)

                    kind =
                        if name == "choose-buffer" then
                            "buffer"

                        else
                            "client"
                in
                Just
                    { kind = kind
                    , filter = Maybe.withDefault (meant Reason.NotSet "") (getFlag 'f' args.values)
                    , zoom = String.contains "Z" args.bools
                    , template =
                        when args.rest is
                            [] ->
                                if kind == "buffer" then
                                    "paste-buffer -p -b '%%'"

                                else
                                    "detach-client -t '%%'"

                            [ one ] ->
                                if one.block then
                                    serialize (tokens one.value)

                                else
                                    one.value

                            many ->
                                serialize many
                    , after = after
                    }

            else
                Nothing

        Nothing ->
            meant Reason.FromOutside Nothing


{-| What a binding's `display-popup` (`popup`) asks (puritty `docs/tmux.md`
TM56): its width and height (`-w`, `-h`, a number or `N%`, half the
window when not given), its place (`-x`, `-y`: a number, `N%`, or `C`,
the middle, as when not given), its title (`-T`), start directory
(`-d`), whether it closes when its command ends (`-E`), its command, and
the commands after it. -}
popupOf : String -> Maybe { width : String, height : String, x : String, y : String, title : String, dir : String, close : Bool, command : String, after : String }
popupOf command =
    let
        cmds =
            commands (tokens command)

        name =
            Array.first cmds |> Maybe.andThen Array.first |> Maybe.map .value |> Maybe.withDefault (meant Reason.FromOutside "")

        after =
            Array.dropFirst 1 cmds |> Array.map serialize |> String.join " ; "
    in
    when Array.first cmds is
        Just first ->
            if name == "display-popup" || name == "popup" then
                let
                    args =
                        flags "bcdehsStTwxy" (Array.dropFirst 1 first)

                    value c fallback =
                        Maybe.withDefault (meant Reason.NotSet fallback) (getFlag c args.values)
                in
                Just
                    { width = value 'w' "50%"
                    , height = value 'h' "50%"
                    , x = value 'x' "C"
                    , y = value 'y' "C"
                    , title = value 'T' ""
                    , dir = value 'd' ""
                    , close = String.contains "E" args.bools
                    , command =
                        when args.rest is
                            [] ->
                                ""

                            [ one ] ->
                                if one.block then
                                    serialize (tokens one.value)

                                else
                                    one.value

                            many ->
                                serialize many
                    , after = after
                    }

            else
                Nothing

        Nothing ->
            meant Reason.FromOutside Nothing
