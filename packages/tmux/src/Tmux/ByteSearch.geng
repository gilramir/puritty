module Tmux.ByteSearch exposing (byteAt, indexOf)

{-| A byte looked for in Bytes, which `Tmux.Control` and `Tmux.Passthrough`
both scan, kept once (the code review's TP19). Not exposed by the
package. -}

import Bytes exposing (Bytes)
import Tmux.Reason as Reason
import UInt8


{-| The first index of byte `b` at or after `from`, or -1. -}
indexOf : Int -> Int -> Bytes -> Int
indexOf b from bytes =
    let
        n =
            Bytes.length bytes

        below =
            if b > 0 then
                Bytes.spanWithin 0 (b - 1) from n bytes

            else
                from

        past =
            if b < 255 then
                Bytes.spanWithin (b + 1) 255 below n bytes

            else
                below
    in
    if past >= n then
        -1

    else if past == from then
        if byteAt from bytes == b then
            from

        else
            indexOf b (from + 1) bytes

    else
        indexOf b past bytes


byteAt : Int -> Bytes -> Int
byteAt i bytes =
    when Bytes.get i bytes is
        Just v ->
            UInt8.toInt v

        Nothing ->
            meant Reason.OutOfRange -1
