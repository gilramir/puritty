    , bindingsOfFormat
    , bindingsOfText
    , Env
    , envOf
    , Data
    , emptyData
    , Entry
    , Target(..)
    , entries
    , changedOption
    , changedKey
    , View
    , startView
    , Line
    , lines
    , visibleTagged
    , Piece
    , Detail
    , preview
    , previewTitle
    , filterFormat
    , Prompt
    , Asks(..)
    , Act(..)
    , act
    , answered
    , confirmed
    , help
