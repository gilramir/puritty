module Tmux.Control exposing
    ( Event(..)
    , Notice(..)
    , Reader
    , answer
    , expect
    , feed
    , giveUp
    , isAsking
    , isGivingUp
    , isInside
    , reader
    , startsControl
    , strict
    , unescape
    )

{-| tmux's control mode (`tmux -CC`), read from the bytes the terminal
receives (puritty `docs/tmux.md` TM5).

Outside control mode the bytes are the terminal's, and `feed` hands them
back as `Outside`. `ESC P 1000 p` enters it; from there the bytes are
lines, each a reply line between `%begin` and `%end` or `%error`, or a
notification starting with `%`; `ESC \` at the start of a line leaves it.
Lines end in `\r\n` (tmux's client sets ONLCR), and the `\r` is dropped.

A read may end anywhere: what cannot be decided yet (a partial line, or
the first bytes of `ESC P 1000 p`) is kept for the next read.
-}

import Bytes exposing (Bytes)
import Tmux.ByteSearch exposing (byteAt, indexOf)
import Tmux.Reason as Reason
import UInt8


{-| Where reading has got to. -}
type alias Reader =
    { inside : Bool
    , held : Bytes
    , block : Maybe Block
    -- whether tmux has written a `%` line since control mode began: a
    -- line that is not one is in doubt only after (TK13)
    , spoken : Bool
    -- the lines in doubt (TK14): written outside a reply, not tmux's, by
    -- a shell after a killed client or by another program into the
    -- terminal (`wall`); `Foreign` when tmux speaks again, the terminal's
    -- when `giveUp` says it will not
    , stray : Maybe Bytes
    , givingUp : Bool
    -- whether `ESC P 1000 p` is expected: the terminal's user started
    -- `tmux -CC` (puritty `docs/tmux.md` TM108); set by `expect`, used up
    -- by one entry
    , expected : Bool
    -- the bytes from an entry that was not expected, held until `answer`
    -- says whether they are tmux's (TM108)
    , asking : Maybe Bytes
    -- whether a bare line outside a reply is in doubt from the start, not
    -- only once tmux has spoken (`strict`)
    , strictLines : Bool
    }


{-| A command's reply being read: `%begin`'s time, number and flags, which
its `%end` or `%error` repeats, its lines so far, and their bytes. -}
type alias Block =
    { time : String
    , number : Int
    , flags : Int
    , lines : Array Bytes
    , size : Int
    }


reader : Reader
reader =
    { inside = False, held = Bytes.empty, block = Nothing, spoken = False, stray = Nothing, givingUp = False, expected = False, asking = Nothing, strictLines = False }


{-| A reader for which any line outside a reply that is not a `%` line is
in doubt from the start, a start-up error too (TM70): for a nested client
whose output is dropped anyway, so that bytes that only looked like its
entry end it at their first line (puritty `docs/tmux.md` TM19). -}
strict : Reader -> Reader
strict r =
    { r | strictLines = True }


{-| Whether the next `ESC P 1000 p` is expected: `True` when the
terminal's user has just started `tmux -CC`, `False` when they have done
something else since. An entry that is not expected is not followed: it
is `Asked`, and the bytes wait for `answer`. -}
expect : Bool -> Reader -> Reader
expect yes r =
    { r | expected = yes }


{-| Whether an entry waits for `answer`. -}
isAsking : Reader -> Bool
isAsking r =
    r.asking /= Nothing


{-| The answer to `Asked`: `True` follows control mode from the entry, its
bytes read as tmux's; `False` hands the entry and the bytes after it back
as the terminal's (a later entry in them is asked again). -}
answer : Bool -> Reader -> { reader : Reader, events : Array Event }
answer yes r =
    when r.asking is
        Just waiting ->
            if yes then
                bounded (step waiting 0 { r | asking = Nothing, inside = True, spoken = False, stray = Nothing, held = Bytes.empty } [ Entered ])

            else
                step waiting 0 { r | asking = Nothing, held = Bytes.empty } [ Outside entry ]

        Nothing ->
            -- no entry waits for an answer
            meant Reason.NotOpen { reader = r, events = [] }


isInside : Reader -> Bool
isInside r =
    r.inside


{-| tmux did not speak after the lines in doubt (TK14): its client is gone,
and the next `feed`, an empty one will do, ends control mode with them,
and what was held, the terminal's. -}
giveUp : Reader -> Reader
giveUp r =
    if r.inside && r.stray /= Nothing then
        { r | givingUp = True }

    else
        r


isGivingUp : Reader -> Bool
isGivingUp r =
    r.givingUp


{-| What the bytes said. `Reply`'s `number` is `%begin`'s, which tmux
counts over the whole server, so a reply is matched to its command by
equality; `flags` is 1 for a command this client sent. -}
type Event
    = Outside Bytes
    | Entered
    | Notice Notice
    | Reply { number : Int, flags : Int, ok : Bool, lines : Array Bytes }
    | Exited
    -- a line outside a reply that is not tmux's (TK14): ask tmux
    -- something, and `giveUp` if it does not answer
    | Stray
    -- the lines in doubt, tmux having spoken since: another program's,
    -- written into the terminal (`wall`), control mode going on
    | Foreign Bytes
    -- `ESC P 1000 p` not expected (`expect`): the bytes from it are held
    -- until `answer` says whether to follow it
    | Asked


{-| tmux 3.8's notifications (`docs/tmux.md` TM5.3). Ids are the numbers
after `%`, `@` and `$`. `Output`'s bytes are unescaped, the pane's bytes
as its program wrote them; `%extended-output` is `Output` too, its age
dropped. A line that is none of these is `Unknown`, never an error. -}
type Notice
    = Output { pane : Int, bytes : Bytes }
    | Pause Int
    | Continue Int
    | LayoutChange { window : Int, layout : String, visible : String, flags : String }
    | WindowAdd Int
    | WindowClose Int
    | WindowRenamed { window : Int, name : String }
    | UnlinkedWindowAdd Int
    | UnlinkedWindowClose Int
    | UnlinkedWindowRenamed { window : Int, name : String }
    | WindowPaneChanged { window : Int, pane : Int }
    | SessionChanged { session : Int, name : String }
    | ClientSessionChanged { client : String, session : Int, name : String }
    | SessionRenamed { session : Int, name : String }
    | SessionsChanged
    | SessionWindowChanged { session : Int, window : Int }
    | PaneModeChanged Int
    | ClientDetached String
    | SubscriptionChanged { name : String, window : Int, pane : Int, value : String }
    | PasteBufferChanged String
    | PasteBufferDeleted String
    | Message String
    | ConfigError String
    | Exit String
    | Unknown String


{-| The events in a read's bytes, in order, and where reading got to. -}
feed : Bytes -> Reader -> { reader : Reader, events : Array Event }
feed bytes r =
    let
        data =
            if Bytes.isEmpty r.held then
                bytes

            else
                Bytes.flatten [ r.held, bytes ]
    in
    when r.asking is
        Just waiting ->
            -- held whole until answered; past what a reply may hold, not
            -- tmux's after all: the terminal's
            if Bytes.length waiting + Bytes.length bytes > heldMost then
                step (Bytes.flatten [ waiting, bytes ]) 0 { r | asking = Nothing } [ Outside entry ]

            else
                { reader = { r | asking = Just (Bytes.flatten [ waiting, bytes ]) }, events = [] }

        Nothing ->
            meant Reason.NotOpen (feedOn data r)


feedOn : Bytes -> Reader -> { reader : Reader, events : Array Event }
feedOn data r =
    if r.givingUp then
        -- the lines in doubt and everything since are the terminal's
        let
            doubted =
                when r.stray is
                    Just b ->
                        b

                    Nothing ->
                        meant Reason.NotOpen Bytes.empty
        in
        step (Bytes.flatten [ doubted, data ]) 0 reader [ Exited ]

    else
        bounded (step data 0 { r | held = Bytes.empty } [])


{-| The most bytes a line not yet ended, or the lines in doubt, may hold:
tmux's lines are short (an `%output` line is cut by tmux's own buffer, a
reply's line is a pane's row), so more is not tmux's, and control mode is
left as `ESC \` leaves it, the bytes the terminal's. Before, nothing
bounded them, and each read copied and scanned the whole held line again
(the code review's TP3). -}
heldMost : Int
heldMost =
    1048576


{-| The most bytes one reply may hold before its `%end`. The largest
replies puritty asks for are a paste buffer's (`show-buffer`) and a
pane's capture, which asks for at most 1000 rows of history (puritty
`docs/tmux.md` TM119). Past it control mode is left as for `heldMost`, the
reply's lines the terminal's (the code review's TP3, puritty
`docs/tmux.md` TM120). -}
replyMost : Int
replyMost =
    67108864


newline : Bytes
newline =
    Bytes.fromString "\n"


bounded : { reader : Reader, events : Array Event } -> { reader : Reader, events : Array Event }
bounded result =
    let
        r =
            result.reader

        stray =
            when r.stray is
                Just b ->
                    b

                Nothing ->
                    meant Reason.NotOpen Bytes.empty

        reply =
            when r.block is
                Just open ->
                    open

                Nothing ->
                    meant Reason.NotOpen { time = "", number = 0, flags = 0, lines = [], size = 0 }
    in
    if r.inside && (Bytes.length r.held > heldMost || Bytes.length stray > heldMost || reply.size > replyMost) then
        { reader = { r | inside = False, held = Bytes.empty, block = Nothing, stray = Nothing }
        , events = result.events ++ [ Exited, Outside (Bytes.flatten (Array.mapAndFlatten (\l -> [ l, newline ]) reply.lines ++ [ stray, r.held ])) ]
        }

    else
        result


step : Bytes -> Int -> Reader -> Array Event -> { reader : Reader, events : Array Event }
step data at r events =
    if r.inside then
        inside data at r events

    else
        outside data at at r events


entry : Bytes
entry =
    Bytes.fromString "\u{001B}P1000p"


{-| Outside control mode: the terminal's bytes from `from`, looking at
`at` for `ESC P 1000 p`. -}
outside : Bytes -> Int -> Int -> Reader -> Array Event -> { reader : Reader, events : Array Event }
outside data from at r events =
    let
        n =
            Bytes.length data

        esc =
            indexOf 0x1B at data
    in
    if esc < 0 then
        { reader = r, events = withOutside data from n events }

    else
        let
            seen =
                Bytes.slice esc (min n (esc + 7)) data
        in
        if seen == entry && r.expected then
            step data (esc + 7) { r | inside = True, spoken = False, stray = Nothing, expected = False } (Array.pushLast Entered (withOutside data from esc events))

        else if seen == entry then
            { reader = { r | asking = Just (Bytes.slice (esc + 7) n data) }, events = Array.pushLast Asked (withOutside data from esc events) }

        else if Bytes.length seen < 7 && seen == Bytes.slice 0 (Bytes.length seen) entry then
            -- the start of `ESC P 1000 p`, or not: the next read says
            { reader = { r | held = seen }, events = withOutside data from esc events }

        else
            outside data from (esc + 1) r events


withOutside : Bytes -> Int -> Int -> Array Event -> Array Event
withOutside data from to events =
    if to > from then
        Array.pushLast (Outside (Bytes.slice from to data)) events

    else
        events


{-| Inside control mode: lines from `at`, or `ESC \` leaving it. -}
inside : Bytes -> Int -> Reader -> Array Event -> { reader : Reader, events : Array Event }
inside data at r events =
    let
        n =
            Bytes.length data
    in
    if at >= n then
        { reader = r, events = events }

    else if byteAt at data == 0x1B && at + 1 >= n then
        -- ST, or a line that starts with an escape: the next read says
        { reader = { r | held = Bytes.slice at n data }, events = events }

    else if byteAt at data == 0x1B && byteAt (at + 1) data == 0x5C && r.block == Nothing then
        -- lines in doubt before it go to the terminal it leaves. Not inside
        -- a reply: tmux writes `ESC \` only after `%exit`, outside one, and
        -- a reply's line is a pane's text, a folder's name too, which a
        -- program can begin with it (the code review's TP2)
        let
            left =
                when r.stray is
                    Just b ->
                        [ Exited, Outside b ]

                    Nothing ->
                        meant Reason.NotOpen [ Exited ]
        in
        step data (at + 2) { r | inside = False, block = Nothing, stray = Nothing } (events ++ left)

    else if r.block == Nothing && (r.spoken || r.strictLines) && byteAt at data /= 0x25 then
        -- once tmux has begun, it writes outside a reply only `%` lines
        -- and the `ESC \` that ends control mode (above), from 2.7 to 3.8
        -- (`control.c`; 2.7's parse error is inside its guards). Before,
        -- a command it cannot read is said as a bare line, then `%exit`
        -- (TM70). Anything else after, an escape too (a colored prompt),
        -- is not tmux's. Its client may be gone with no `%exit`, killed,
        -- and the shell it ran in writing again (docs/tmux-checks.md
        -- TK13); or another program wrote into the terminal, `wall` as a
        -- UPS lost its link (TK14), and tmux goes on. The line is held in
        -- doubt, to the end of the read when it has no end yet (a prompt),
        -- and `Stray` asks the caller to find out
        let
            nl =
                indexOf 0x0A at data

            lineEnd =
                if nl < 0 then
                    n

                else
                    nl + 1

            doubtful =
                Bytes.slice at lineEnd data
        in
        when r.stray is
            Just b ->
                inside data lineEnd { r | stray = Just (Bytes.flatten [ b, doubtful ]) } events

            Nothing ->
                -- the first line in doubt: tmux asked
                meant Reason.NotOpen (inside data lineEnd { r | stray = Just doubtful } (Array.pushLast Stray events))

    else
        -- a line, which may start with an escape: a reply's line is the
        -- command's output as it is, and `capture-pane -e`'s starts with
        -- the SGR of its first cell
        let
            nl =
                indexOf 0x0A at data
        in
        if nl < 0 then
            { reader = { r | held = Bytes.slice at n data }, events = events }

        else
            let
                end =
                    if nl > at && byteAt (nl - 1) data == 0x0D then
                        nl - 1

                    else
                        nl

                -- tmux speaking after lines in doubt: they were another
                -- program's (TK14)
                resolved =
                    when r.stray is
                        Just b ->
                            if byteAt at data == 0x25 then
                                { stray = Nothing, events = Array.pushLast (Foreign b) events }

                            else
                                -- a reply's line, which may be anything
                                { stray = r.stray, events = events }

                        Nothing ->
                            meant Reason.NotOpen { stray = Nothing, events = events }

                read =
                    line (Bytes.slice at end data) r.block resolved.events
            in
            inside data (nl + 1) { r | block = read.block, spoken = r.spoken || byteAt at data == 0x25, stray = resolved.stray } read.events


{-| One line: a reply's, a guard, or a notification. -}
line : Bytes -> Maybe Block -> Array Event -> { block : Maybe Block, events : Array Event }
line bytes block events =
    when block is
        Just open ->
            when guard bytes is
                Just g ->
                    -- the guard that closes it repeats `%begin`'s time,
                    -- number and flags: a line a pane's program put in a
                    -- value (a folder's name with a newline) must match
                    -- all three, the time to the second (the code review's
                    -- TP2, puritty `docs/tmux.md` TM123)
                    if g.time == open.time && g.number == open.number && g.flags == open.flags && (g.kind == "%end" || g.kind == "%error") then
                        { block = Nothing
                        , events = Array.pushLast (Reply { number = open.number, flags = open.flags, ok = g.kind == "%end", lines = open.lines }) events
                        }

                    else
                        { block = Just { open | lines = Array.pushLast bytes open.lines, size = open.size + Bytes.length bytes }, events = events }

                Nothing ->
                    meant Reason.NotKnown { block = Just { open | lines = Array.pushLast bytes open.lines, size = open.size + Bytes.length bytes }, events = events }

        Nothing ->
            meant Reason.NotOpen
                when guard bytes is
                    Just g ->
                        if g.kind == "%begin" then
                            { block = Just { time = g.time, number = g.number, flags = g.flags, lines = [], size = 0 }, events = events }

                        else
                            -- an `%end` with no `%begin`: nothing to close
                            { block = Nothing, events = events }

                    Nothing ->
                        meant Reason.NotKnown { block = Nothing, events = Array.pushLast (Notice (notice bytes)) events }


{-| `%begin`, `%end` or `%error`, with their time, number and flags. -}
guard : Bytes -> Maybe { kind : String, time : String, number : Int, flags : Int }
guard bytes =
    if Bytes.length bytes > 64 || byteAt 0 bytes /= 0x25 then
        Nothing

    else
        let
            words =
                String.split " " (Bytes.toStringLossy bytes)
        in
        when words is
            [ kind, time, number, flags ] ->
                if kind == "%begin" || kind == "%end" || kind == "%error" then
                    when { n = String.toInt number, f = String.toInt flags } is
                        { n = Just nv, f = Just fv } ->
                            Just { kind = kind, time = time, number = nv, flags = fv }

                        _ ->
                            Nothing

                else
                    Nothing

            _ ->
                Nothing


{-| A notification line. -}
notice : Bytes -> Notice
notice bytes =
    if startsWith "%output " bytes then
        output 8 False bytes

    else if startsWith "%extended-output " bytes then
        output 17 True bytes

    else
        named (Bytes.toStringLossy bytes)


startsWith : String -> Bytes -> Bool
startsWith prefix bytes =
    let
        p =
            Bytes.fromString prefix
    in
    Bytes.slice 0 (Bytes.length p) bytes == p


{-| `%output %N data`, or `%extended-output %N age ... : data`, from `at`
just past the name. -}
output : Int -> Bool -> Bytes -> Notice
output at extended bytes =
    let
        space =
            indexOf 0x20 at bytes

        pane =
            id
                (Bytes.toStringLossy
                    (Bytes.slice at
                        (if space < 0 then
                            Bytes.length bytes

                         else
                            space
                        )
                        bytes
                    )
                )

        dataAt =
            if space < 0 then
                -1

            else if extended then
                let
                    colon =
                        indexOf 0x3A space bytes
                in
                if colon < 0 then
                    -1

                else
                    colon + 2

            else
                space + 1
    in
    when pane is
        Just p ->
            if dataAt < 0 then
                Output { pane = p, bytes = Bytes.empty }

            else
                Output { pane = p, bytes = unescape (Bytes.slice dataAt (Bytes.length bytes) bytes) }

        Nothing ->
            meant Reason.FromOutside Unknown (Bytes.toStringLossy bytes)


{-| A notification other than output, from its text. -}
named : String -> Notice
named text =
    let
        words =
            String.split " " text

        word i =
            Maybe.withDefault (meant Reason.FromOutside "") (Array.get i words)

        -- the text after the first `k` words, spaces kept
        rest k =
            String.join " " (Array.dropFirst k words)

        name =
            word 0
    in
    if name == "%layout-change" then
        when id (word 1) is
            Just w ->
                LayoutChange { window = w, layout = word 2, visible = word 3, flags = word 4 }

            Nothing ->
                meant Reason.FromOutside Unknown text

    else if name == "%window-pane-changed" then
        when { w = id (word 1), p = id (word 2) } is
            { w = Just w, p = Just p } ->
                WindowPaneChanged { window = w, pane = p }

            _ ->
                Unknown text

    else if name == "%session-window-changed" then
        when { s = id (word 1), w = id (word 2) } is
            { s = Just s, w = Just w } ->
                SessionWindowChanged { session = s, window = w }

            _ ->
                Unknown text

    else if name == "%session-changed" || name == "%session-renamed" then
        when id (word 1) is
            Just s ->
                if name == "%session-changed" then
                    SessionChanged { session = s, name = rest 2 }

                else
                    SessionRenamed { session = s, name = rest 2 }

            Nothing ->
                meant Reason.FromOutside Unknown text

    else if name == "%client-session-changed" then
        when id (word 2) is
            Just s ->
                ClientSessionChanged { client = word 1, session = s, name = rest 3 }

            Nothing ->
                meant Reason.FromOutside Unknown text

    else if name == "%window-renamed" || name == "%unlinked-window-renamed" then
        when id (word 1) is
            Just w ->
                if name == "%window-renamed" then
                    WindowRenamed { window = w, name = rest 2 }

                else
                    UnlinkedWindowRenamed { window = w, name = rest 2 }

            Nothing ->
                meant Reason.FromOutside Unknown text

    else if name == "%subscription-changed" then
        when String.firstIndexOf " : " text is
            Just i ->
                SubscriptionChanged { name = word 1, window = Maybe.withDefault (meant Reason.FromOutside -1) (id (word 3)), pane = Maybe.withDefault (meant Reason.FromOutside -1) (id (word 5)), value = String.dropFirst (i + 3) text }

            Nothing ->
                meant Reason.FromOutside Unknown text

    else if name == "%sessions-changed" then
        SessionsChanged

    else if name == "%client-detached" then
        ClientDetached (rest 1)

    else if name == "%paste-buffer-changed" then
        PasteBufferChanged (rest 1)

    else if name == "%paste-buffer-deleted" then
        PasteBufferDeleted (rest 1)

    else if name == "%message" then
        Message (rest 1)

    else if name == "%config-error" then
        ConfigError (rest 1)

    else if name == "%exit" then
        Exit (rest 1)

    else
        when id (word 1) is
            Just i ->
                if name == "%pause" then
                    Pause i

                else if name == "%continue" then
                    Continue i

                else if name == "%window-add" then
                    WindowAdd i

                else if name == "%window-close" then
                    WindowClose i

                else if name == "%unlinked-window-add" then
                    UnlinkedWindowAdd i

                else if name == "%unlinked-window-close" then
                    UnlinkedWindowClose i

                else if name == "%pane-mode-changed" then
                    PaneModeChanged i

                else
                    Unknown text

            Nothing ->
                meant Reason.FromOutside Unknown text


{-| `%3`, `@3` or `$3` as 3. -}
id : String -> Maybe Int
id s =
    if String.startsWith "%" s || String.startsWith "@" s || String.startsWith "$" s then
        String.toInt (String.dropFirst 1 s)

    else
        Nothing


{-| `%output`'s data as the pane's bytes: `\ooo` is the byte with that
octal value (tmux escapes bytes below 0x20 and `\` itself so); every
other byte is itself. -}
unescape : Bytes -> Bytes
unescape bytes =
    let
        first =
            indexOf 0x5C 0 bytes
    in
    if first < 0 then
        bytes

    else
        Bytes.flatten (unescapeFrom bytes 0 first [])


unescapeFrom : Bytes -> Int -> Int -> Array Bytes -> Array Bytes
unescapeFrom bytes from slash pieces =
    let
        n =
            Bytes.length bytes
    in
    if slash < 0 then
        Array.pushLast (Bytes.slice from n bytes) pieces

    else
        let
            -- `slash` clamped to 2,000,000,000, far past any line tmux
            -- sends, which says to the compiler that the sums after it
            -- cannot wrap
            at =
                clamp 0 2000000000 slash

            d0 =
                byteAt (at + 1) bytes - 0x30

            d1 =
                byteAt (at + 2) bytes - 0x30

            d2 =
                byteAt (at + 3) bytes - 0x30

            octal =
                d0 >= 0 && d0 <= 3 && d1 >= 0 && d1 <= 7 && d2 >= 0 && d2 <= 7

            before =
                Array.pushLast (Bytes.slice from slash bytes) pieces
        in
        if octal then
            unescapeFrom bytes
                (at + 4)
                (indexOf 0x5C (at + 4) bytes)
                (Array.pushLast (Bytes.fromUInt8s [ UInt8.fromInt (d0 * 64 + d1 * 8 + d2) ]) before)

        else
            -- a `\` not followed by three octal digits stays as it is, with
            -- the text before it: only the search moves on (the code
            -- review's TP8, where the text before it was lost)
            unescapeFrom bytes from (indexOf 0x5C (at + 1) bytes) pieces


{-| Whether bytes hold `ESC P 1000 p`, tmux control mode starting: as a
pane's output, a `tmux -CC` run inside a pane. -}
startsControl : Bytes -> Bool
startsControl bytes =
    startsFrom bytes 0


startsFrom : Bytes -> Int -> Bool
startsFrom bytes at =
    let
        esc =
            indexOf 0x1B at bytes
    in
    if esc < 0 then
        False

    else if Bytes.slice esc (esc + 7) bytes == entry then
        True

    else
        startsFrom bytes (esc + 1)
