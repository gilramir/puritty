    O\tafter-rename-session\tcommand\ts\tah\t\t\tRun after the rename-session command completes.
    O\tafter-rename-window\tcommand\ts\tah\t\t\tRun after the rename-window command completes.
    O\tafter-resize-pane\tcommand\ts\tah\t\t\tRun after the resize-pane command completes.
    O\tafter-resize-window\tcommand\ts\tah\t\t\tRun after the resize-window command completes.
    O\tafter-save-buffer\tcommand\ts\tah\t\t\tRun after the save-buffer command completes.
    O\tafter-select-layout\tcommand\ts\tah\t\t\tRun after the select-layout command completes.
    O\tafter-select-pane\tcommand\ts\tah\t\t\tRun after the select-pane command completes.
    O\tafter-select-window\tcommand\ts\tah\t\t\tRun after the select-window command completes.
    O\tafter-send-keys\tcommand\ts\tah\t\t\tRun after the send-keys command completes.
    O\tafter-set-buffer\tcommand\ts\tah\t\t\tRun after the set-buffer command completes.
    O\tafter-set-environment\tcommand\ts\tah\t\t\tRun after the set-environment command completes.
    O\tafter-set-hook\tcommand\ts\tah\t\t\tRun after the set-hook command completes.
    O\tafter-set-option\tcommand\ts\tah\t\t\tRun after the set-option command completes.
    O\tafter-show-environment\tcommand\ts\tah\t\t\tRun after the show-environment command completes.
    O\tafter-show-messages\tcommand\ts\tah\t\t\tRun after the show-messages command completes.
    O\tafter-show-options\tcommand\ts\tah\t\t\tRun after the show-options command completes.
    O\tafter-split-window\tcommand\ts\tah\t\t\tRun after the split-window command completes.
    O\tafter-swap-window\tcommand\ts\tah\t\t\tRun after the swap-window command completes.
    O\tafter-unbind-key\tcommand\ts\tah\t\t\tRun after the unbind-key command completes.
    O\talert-activity\tcommand\ts\tah\t\t\tRun when a window has activity.
    O\talert-bell\tcommand\ts\tah\t\t\tRun when a window has received a bell.
    O\talert-silence\tcommand\ts\tah\t\t\tRun when a window has been silent.
    O\tclient-active\tcommand\ts\tah\t\t\tRun when a client becomes the latest active client of its session.
    O\tclient-attached\tcommand\ts\tah\t\t\tRun when a client is attached.
    O\tclient-created\tcommand\ts\tah\t\t\tRun when a client is created.
    O\tclient-closed\tcommand\ts\tah\t\t\tRun when a client is closed.
    O\tclient-detached\tcommand\ts\tah\t\t\tRun when a client is detached.
    O\tclient-focus-in\tcommand\ts\tah\t\t\tRun when focus enters a client.
    O\tclient-focus-out\tcommand\ts\tah\t\t\tRun when focus exits a client.
    O\tclient-resized\tcommand\ts\tah\t\t\tRun when a client is resized.
    O\tclient-session-changed\tcommand\ts\tah\t\t\tRun when a client's attached session is changed.
    O\tclient-light-theme\tcommand\ts\tah\t\t\tRun when a client switches to a light theme.
    O\tclient-dark-theme\tcommand\ts\tah\t\t\tRun when a client switches to a dark theme.
    O\tcommand-error\tcommand\ts\tah\t\t\tRun when a command fails.
    O\tmarked-pane-changed\tcommand\ts\tah\t\t\tRun when the marked pane is set or cleared.
    O\tpane-activity\tcommand\twp\tah\t\t\tRun when there is new output in a pane.
    O\tpane-bell\tcommand\twp\tah\t\t\tRun when a pane receives a bell.
    O\tpane-command-finished\tcommand\twp\tah\t\t\tRun when an OSC 133 command finishes in a pane.
    O\tpane-command-started\tcommand\twp\tah\t\t\tRun when an OSC 133 command starts in a pane.
    O\tpane-created\tcommand\twp\tah\t\t\tRun when a pane is created or respawned.
    O\tpane-died\tcommand\twp\tah\t\t\tRun when the program running in a pane exits, but remain-on-exit is on so the pane has not closed.
    O\tpane-exited\tcommand\twp\tah\t\t\tRun when the program running in a pane exits.
    O\tpane-focus-in\tcommand\twp\tah\t\t\tRun when the focus enters a pane, if the focus-events option is on.
    O\tpane-focus-out\tcommand\twp\tah\t\t\tRun when the focus exits a pane, if the focus-events option is on.
    O\tpane-mode-changed\tcommand\twp\tah\t\t\tRun when a pane changes mode.
    O\tpane-mode-entered\tcommand\twp\tah\t\t\tRun when a pane enters a mode.
    O\tpane-mode-exited\tcommand\twp\tah\t\t\tRun when a pane exits a mode.
    O\tpane-moved\tcommand\twp\tah\t\t\tRun when a pane is moved to another window.
    O\tpane-prompt-closed\tcommand\twp\tah\t\t\tRun when a prompt in a pane is closed.
    O\tpane-prompt-opened\tcommand\twp\tah\t\t\tRun when a prompt is opened in a pane.
    O\tpane-resized\tcommand\twp\tah\t\t\tRun when a pane is resized.
    O\tpane-set-clipboard\tcommand\twp\tah\t\t\tRun when the terminal clipboard is set using the xterm escape sequence.
    O\tpane-shell-prompt\tcommand\twp\tah\t\t\tRun when an OSC 133 shell prompt starts in a pane.
    O\tpane-title-changed\tcommand\twp\tah\t\t\tRun when a pane title is changed.
    O\tsession-closed\tcommand\ts\tah\t\t\tRun when a session is closed.
    O\tsession-created\tcommand\ts\tah\t\t\tRun when a new session is created.
    O\tsession-added-to-group\tcommand\ts\tah\t\t\tRun when a session is added to a session group.
    O\tsession-renamed\tcommand\ts\tah\t\t\tRun when a session is renamed.
    O\tsession-removed-from-group\tcommand\ts\tah\t\t\tRun when a session is removed from a session group.
    O\tsession-window-changed\tcommand\ts\tah\t\t\tRun when a session changes its active window.
    O\twindow-created\tcommand\tw\tah\t\t\tRun when a window is created.
    O\twindow-closed\tcommand\tw\tah\t\t\tRun when a window is closed.
    O\twindow-layout-changed\tcommand\tw\tah\t\t\tRun when a window layout is changed.
    O\twindow-linked\tcommand\ts\tah\t\t\tRun when a window is linked into a session.
    O\twindow-pane-changed\tcommand\tw\tah\t\t\tRun when a window changes its active pane.
    O\twindow-renamed\tcommand\tw\tah\t\t\tRun when a window is renamed.
    O\twindow-resized\tcommand\tw\tah\t\t\tRun when a window is resized. This may be after the client-resized hook is run.
    O\twindow-unzoomed\tcommand\tw\tah\t\t\tRun when a window is unzoomed.
    O\twindow-zoomed\tcommand\tw\tah\t\t\tRun when a window is zoomed.
    O\twindow-unlinked\tcommand\ts\tah\t\t\tRun when a window is unlinked from a session.
    D\tbackspace C-?
    D\tbuffer-limit 50
    D\tclear-on-attach on
    D\tcommand-alias[0] split-pane=split-window
    D\tcommand-alias[1] splitp=split-window
    D\tcommand-alias[2] "server-info=show-messages -JT"
    D\tcommand-alias[3] "info=show-messages -JT"
    D\tcommand-alias[4] "choose-window=choose-tree -w"
    D\tcommand-alias[5] "choose-session=choose-tree -s"
    D\tcodepoint-widths
    D\tcopy-command ''
    D\tdefault-client-command new-session
    D\tdefault-terminal tmux-256color
