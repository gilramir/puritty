    K\tmove\t,\t0\tDisplay move menu\tif-shell -F "#{pane_floating_flag}" { display-menu -T "#[align=centre]Move" -x P -y P Centre c { move-pane -P centre } '' "Top Left" 1 { move-pane -P top-left } "Top Right" 2 { move-pane -P top-right } "Bottom Left" 3 { move-pane -P bottom-left } "Bottom Right" 4 { move-pane -P bottom-right } '' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right } }
    K\tmove\t.\t0\tDisplay move and resize menu\tif-shell -F "#{pane_floating_flag}" { display-menu -T "#[align=centre]Move & Resize" -x P -y P Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } }
    K\tmove\t0\t0\tMove pane to fill the window\tresize-pane -x "100%" -y "100%" \\; move-pane -P top-left
    K\tmove\t1\t0\tMove pane to top-left corner\tmove-pane -P top-left
    K\tmove\t2\t0\tMove pane to top-right corner\tmove-pane -P top-right
    K\tmove\t3\t0\tMove pane to bottom-left corner\tmove-pane -P bottom-left
    K\tmove\t4\t0\tMove pane to bottom-right corner\tmove-pane -P bottom-right
    K\tmove\tUp\t0\tMove pane to top\tmove-pane -P top-centre
    K\tmove\tDown\t0\tMove pane to bottom\tmove-pane -P bottom-centre
    K\tmove\tLeft\t0\tMove pane to left\tmove-pane -P centre-left
    K\tmove\tRight\t0\tMove pane to right\tmove-pane -P centre-right
    K\tmove\tM-1\t0\tMove pane to top-left corner and resize\tresize-pane -x "50%" -y "50%" \\; move-pane -P top-left
    K\tmove\tM-2\t0\tMove pane to top-right corner and resize\tresize-pane -x "50%" -y "50%" \\; move-pane -P top-right
    K\tmove\tM-3\t0\tMove pane to bottom-left corner and resize\tresize-pane -x "50%" -y "50%" \\; move-pane -P bottom-left
    K\tmove\tM-4\t0\tMove pane to bottom-right corner and resize\tresize-pane -x "50%" -y "50%" \\; move-pane -P bottom-right
    K\tmove\tM-Up\t0\tMove pane to top and resize\tresize-pane -x "100%" -y "50%" \\; move-pane -P top-centre
    K\tmove\tM-Down\t0\tMove pane to bottom and resize\tresize-pane -x "100%" -y "50%" \\; move-pane -P bottom-centre
    K\tmove\tM-Left\t0\tMove pane to left and resize\tresize-pane -x "50%" -y "100%" \\; move-pane -P centre-left
    K\tmove\tM-Right\t0\tMove pane to right and resize\tresize-pane -x "50%" -y "100%" \\; move-pane -P centre-right
    K\tprefix\tTab\t0\tSwitch to a window\tnew-pane -E -X 0 -Y 0 -x "75%" -y "30%" \\; move-pane -P bottom-centre \\; switch-mode -kw
    K\tprefix\tSpace\t0\tSelect next layout\tnext-layout
    K\tprefix\t!\t0\tBreak pane to a new window\tbreak-pane
    K\tprefix\t"\t0\tSplit window vertically\tsplit-window
    K\tprefix\t#\t0\tList all paste buffers\tlist-buffers
    K\tprefix\t$\t0\tRename current session\tcommand-prompt -I "#S" { rename-session "%%" }
    K\tprefix\t%\t0\tSplit window horizontally\tsplit-window -h
    K\tprefix\t&\t0\tKill current window\tconfirm-before -p "kill-window #W? (y/n)" kill-window
    K\tprefix\t'\t0\tPrompt for window index to select\tcommand-prompt -p index { select-window -t ":%%" }
    K\tprefix\t(\t0\tSwitch to previous client\tswitch-client -p
    K\tprefix\t)\t0\tSwitch to next client\tswitch-client -n
    K\tprefix\t*\t0\tNew floating pane\tnew-pane
    K\tprefix\t,\t0\tRename current window\tcommand-prompt -I "#W" { rename-window "%%" }
    K\tprefix\t-\t0\tDelete the most recent paste buffer\tdelete-buffer
    K\tprefix\t.\t0\tMove the current window\tcommand-prompt { move-window -t "%%" }
    K\tprefix\t/\t0\tDescribe key binding\tcommand-prompt -k -p key { list-keys -1N "%%" }
    K\tprefix\t0\t0\tSelect window 0\tselect-window -t :=0
    K\tprefix\t1\t0\tSelect window 1\tselect-window -t :=1
    K\tprefix\t2\t0\tSelect window 2\tselect-window -t :=2
    K\tprefix\t3\t0\tSelect window 3\tselect-window -t :=3
    K\tprefix\t4\t0\tSelect window 4\tselect-window -t :=4
    K\tprefix\t5\t0\tSelect window 5\tselect-window -t :=5
    K\tprefix\t6\t0\tSelect window 6\tselect-window -t :=6
    K\tprefix\t7\t0\tSelect window 7\tselect-window -t :=7
    K\tprefix\t8\t0\tSelect window 8\tselect-window -t :=8
    K\tprefix\t9\t0\tSelect window 9\tselect-window -t :=9
    K\tprefix\t:\t0\tPrompt for a command\tcommand-prompt
    K\tprefix\t;\t0\tMove to the previously active pane\tlast-pane
    K\tprefix\t<\t0\tDisplay window menu\tdisplay-menu -T "#[align=centre]#{window_index}:#{window_name}" -x W -y W "#{?#{>:#{session_windows},1},,-}Swap Left" l { swap-window -t :-1 } "#{?#{>:#{session_windows},1},,-}Swap Right" r { swap-window -t :+1 } "#{?pane_marked_set,,-}Swap Marked" s { swap-window } '' Kill X { kill-window } Respawn R { respawn-window -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } Rename n { command-prompt -F -I "#W" { rename-window -t "#{window_id}" "%%" } } '' "New After" w { new-window -a } "New At End" W { new-window }
    K\tprefix\t=\t0\tChoose a paste buffer from a list\tchoose-buffer -Z
    K\tprefix\t>\t0\tDisplay pane menu\tdisplay-menu -T "#[align=centre]#{pane_index} (#{pane_id})" -x P -y P "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Top,}" < { send-keys -X history-top } "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Bottom,}" > { send-keys -X history-bottom } '' "#{?#{==:#{pane_mode},copy-mode},#{?copy_line_numbers,Hide Line Numbers,Show Line Numbers},}" L { send-keys -X line-numbers-toggle } "#{?#{==:#{pane_mode},copy-mode},#{?refresh_active,Refresh Off,Refresh On},}" r { send-keys -X refresh-toggle } '' "#{?#{&&:#{buffer_size},#{!:#{pane_in_mode}}},Paste #[underscore]#{=/9/...:buffer_sample},}" p { paste-buffer } '' "#{?mouse_word,Search For #[underscore]#{=/9/...:mouse_word},}" C-r { if-shell -F "#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}" "copy-mode -t=" ; send-keys -X -t = search-backward -- "#{q:mouse_word}" } "#{?mouse_word,Type #[underscore]#{=/9/...:mouse_word},}" C-y { copy-mode -q ; send-keys -l "#{q:mouse_word}" } "#{?mouse_word,Copy #[underscore]#{=/9/...:mouse_word},}" c { copy-mode -q ; set-buffer "#{q:mouse_word}" } "#{?mouse_line,Copy Line,}" l { copy-mode -q ; set-buffer "#{q:mouse_line}" } '' "#{?mouse_hyperlink,Type #[underscore]#{=/9/...:mouse_hyperlink},}" C-h { copy-mode -q ; send-keys -l "#{q:mouse_hyperlink}" } "#{?mouse_hyperlink,Copy #[underscore]#{=/9/...:mouse_hyperlink},}" h { copy-mode -q ; set-buffer "#{q:mouse_hyperlink}" } '' "#{?#{#{pane_floating_flag}},Move,}" '' { display-menu -T "#[align=centre]Move" -x L -y L Centre c { move-pane -P centre } '' "Top Left" 1 { move-pane -P top-left } "Top Right" 2 { move-pane -P top-right } "Bottom Left" 3 { move-pane -P bottom-left } "Bottom Right" 4 { move-pane -P bottom-right } '' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Move & Resize,}" '' { display-menu -T "#[align=centre]Move & Resize" -x L -y L Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Tile,}" t { join-pane } "#{?#{!:#{pane_floating_flag}},Float,}" f { break-pane -W } "#{?#{!:#{pane_floating_flag}},Horizontal Split,}" h { split-window -h } "#{?#{!:#{pane_floating_flag}},Vertical Split,}" v { split-window -v } '' "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Up,}" u { swap-pane -U } "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Down,}" d { swap-pane -D } "#{?pane_marked_set,,-}Swap Marked" s { swap-pane } '' Kill X { kill-pane } Respawn R { respawn-pane -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } "#{?#{>:#{window_panes},1},,-}#{?window_zoomed_flag,Unzoom,Zoom}" z { resize-pane -Z }
    K\tprefix\t?\t0\tList key bindings\tlist-keys -N
    K\tprefix\t@\t0\tToggle pane between floating and tiled\tif-shell -F "#{pane_floating_flag}" { join-pane } { break-pane -W }
    K\tprefix\tC\t0\tCustomize options\tcustomize-mode -Z
    K\tprefix\tD\t0\tChoose and detach a client from a list\tchoose-client -Z
    K\tprefix\tE\t0\tSpread panes out evenly\tselect-layout -E
    K\tprefix\tL\t0\tSwitch to the last client\tswitch-client -l
    K\tprefix\tM\t0\tClear the marked pane\tselect-pane -M
    K\tprefix\tT\t0\tChange the pane title\tcommand-prompt -I "#T" { select-pane -T "%%" }
    K\tprefix\t[\t0\tEnter copy mode\tcopy-mode
    K\tprefix\t]\t0\tPaste the most recent paste buffer\tpaste-buffer -p
    K\tprefix\tc\t0\tCreate a new window\tnew-window
    K\tprefix\td\t0\tDetach the current client\tdetach-client
    K\tprefix\tf\t0\tSearch for a pane\tcommand-prompt { find-window -Z "%%" }
    K\tprefix\tg\t0\tMove a floating pane\tswitch-client -T move
    K\tprefix\ti\t0\tDisplay window information\tdisplay-message
    K\tprefix\tl\t0\tSelect the previously current window\tlast-window
    K\tprefix\tm\t0\tToggle the marked pane\tselect-pane -m
    K\tprefix\tn\t0\tSelect the next window\tnext-window
    K\tprefix\to\t0\tSelect the next pane\tselect-pane -t :.+
    K\tprefix\tp\t0\tSelect the previous window\tprevious-window
    K\tprefix\tq\t0\tDisplay pane numbers\tdisplay-panes
    K\tprefix\tr\t0\tRedraw the current client\trefresh-client
    K\tprefix\ts\t0\tChoose a session from a list\tchoose-tree -Zs
    K\tprefix\tt\t0\tShow a clock\tclock-mode
    K\tprefix\tw\t0\tChoose a window from a list\tchoose-tree -Zw
    K\tprefix\tx\t0\tKill the active pane\tconfirm-before -p "kill-pane #P? (y/n)" kill-pane
    K\tprefix\tz\t0\tZoom the active pane\tresize-pane -Z
    K\tprefix\t{\t0\tSwap the active pane with the pane above\tswap-pane -U
    K\tprefix\t}\t0\tSwap the active pane with the pane below\tswap-pane -D
    K\tprefix\t~\t0\tShow messages\tshow-messages
    K\tprefix\tDC\t1\tReset so the visible part of the window follows the cursor\trefresh-client -c
    K\tprefix\tPPage\t0\tEnter copy mode and scroll up\tcopy-mode -u
    K\tprefix\tBTab\t0\tSwitch to a session\tnew-pane -E -X 0 -Y 0 -x "75%" -y "30%" \\; move-pane -P bottom-centre \\; switch-mode -ks
    K\tprefix\tUp\t1\tSelect the pane above the active pane\tselect-pane -U
    K\tprefix\tDown\t1\tSelect the pane below the active pane\tselect-pane -D
    K\tprefix\tLeft\t1\tSelect the pane to the left of the active pane\tselect-pane -L
    K\tprefix\tRight\t1\tSelect the pane to the right of the active pane\tselect-pane -R
    K\tprefix\tM-1\t0\tSet the even-horizontal layout\tselect-layout even-horizontal
    K\tprefix\tM-2\t0\tSet the even-vertical layout\tselect-layout even-vertical
    K\tprefix\tM-3\t0\tSet the main-horizontal layout\tselect-layout main-horizontal
    K\tprefix\tM-4\t0\tSet the main-vertical layout\tselect-layout main-vertical
    K\tprefix\tM-5\t0\tSelect the tiled layout\tselect-layout tiled
    K\tprefix\tM-6\t0\tSet the main-horizontal-mirrored layout\tselect-layout main-horizontal-mirrored
    K\tprefix\tM-7\t0\tSet the main-vertical-mirrored layout\tselect-layout main-vertical-mirrored
    K\tprefix\tM-n\t0\tSelect the next window with an alert\tnext-window -a
    K\tprefix\tM-o\t0\tRotate through the panes in reverse\trotate-window -D
    K\tprefix\tM-p\t0\tSelect the previous window with an alert\tprevious-window -a
    K\tprefix\tM-Up\t1\tResize the pane up by 5\tif-shell -F "#{?floating_pane_flag}" { resize-pane -D -5 } { resize-pane -U 5 }
    K\tprefix\tM-Down\t1\tResize the pane down by 5\tresize-pane -D 5
    K\tprefix\tM-Left\t1\tResize the pane left by 5\tif-shell -F "#{?floating_pane_flag}" { resize-pane -R -5 } { resize-pane -L 5 }
    K\tprefix\tM-Right\t1\tResize the pane right by 5\tresize-pane -R 5
    K\tprefix\tC-b\t0\tSend the prefix key\tsend-prefix
    K\tprefix\tC-o\t0\tRotate through the panes\trotate-window
    K\tprefix\tC-z\t0\tSuspend the current client\tsuspend-client
    K\tprefix\tC-Up\t1\tResize the pane up\tif-shell -F "#{?floating_pane_flag}" { resize-pane -D -1 } { resize-pane -U -- }
    K\tprefix\tC-Down\t1\tResize the pane down\tresize-pane -D --
    K\tprefix\tC-Left\t1\tResize the pane left\tif-shell -F "#{?floating_pane_flag}" { resize-pane -R -1 } { resize-pane -L -- }
    K\tprefix\tC-Right\t1\tResize the pane right\tresize-pane -R --
    K\tprefix\tS-Up\t1\tMove the visible part of the window up\trefresh-client -U 10
    K\tprefix\tS-Down\t1\tMove the visible part of the window down\trefresh-client -D 10
    K\tprefix\tS-Left\t1\tMove the visible part of the window left\trefresh-client -L 10
    K\tprefix\tS-Right\t1\tMove the visible part of the window right\trefresh-client -R 10
    K\troot\tMouseDown1Pane\t0\t\tselect-pane -t = \\; send-keys -M
    K\troot\tMouseDown1Status\t0\t\tswitch-client -t =
    K\troot\tMouseDown1Border\t0\t\tselect-pane -t =
    K\troot\tMouseDown1ScrollbarUp\t0\t\tif-shell -F -t = "#{pane_in_mode}" { send-keys -X page-up } { copy-mode -u }
    K\troot\tMouseDown1ScrollbarDown\t0\t\tif-shell -F -t = "#{pane_in_mode}" { send-keys -X page-down } { copy-mode -d }
    K\troot\tMouseDown1Control7\t0\t\tif-shell -F -t = "#{pane_floating_flag}" { join-pane } { break-pane -W }
    K\troot\tMouseDown1Control8\t0\t\tresize-pane -Z
    K\troot\tMouseDown1Control9\t0\t\tdisplay-menu -O -T "Kill pane #{pane_index}?" -t = -x M -y M Yes y { kill-pane -t = } No n {  }
    K\troot\tMouseDown2Pane\t0\t\tselect-pane -t = \\; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { paste-buffer -p }
    K\troot\tMouseDown3Pane\t0\t\tif-shell -F -t = "#{||:#{mouse_any_flag},#{&&:#{pane_in_mode},#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}}}" { select-pane -t = ; send-keys -M } { display-menu -T "#[align=centre]#{pane_index} (#{pane_id})" -t = -x M -y M "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Top,}" < { send-keys -X history-top } "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Bottom,}" > { send-keys -X history-bottom } '' "#{?#{==:#{pane_mode},copy-mode},#{?copy_line_numbers,Hide Line Numbers,Show Line Numbers},}" L { send-keys -X line-numbers-toggle } "#{?#{==:#{pane_mode},copy-mode},#{?refresh_active,Refresh Off,Refresh On},}" r { send-keys -X refresh-toggle } '' "#{?#{&&:#{buffer_size},#{!:#{pane_in_mode}}},Paste #[underscore]#{=/9/...:buffer_sample},}" p { paste-buffer } '' "#{?mouse_word,Search For #[underscore]#{=/9/...:mouse_word},}" C-r { if-shell -F "#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}" "copy-mode -t=" ; send-keys -X -t = search-backward -- "#{q:mouse_word}" } "#{?mouse_word,Type #[underscore]#{=/9/...:mouse_word},}" C-y { copy-mode -q ; send-keys -l "#{q:mouse_word}" } "#{?mouse_word,Copy #[underscore]#{=/9/...:mouse_word},}" c { copy-mode -q ; set-buffer "#{q:mouse_word}" } "#{?mouse_line,Copy Line,}" l { copy-mode -q ; set-buffer "#{q:mouse_line}" } '' "#{?mouse_hyperlink,Type #[underscore]#{=/9/...:mouse_hyperlink},}" C-h { copy-mode -q ; send-keys -l "#{q:mouse_hyperlink}" } "#{?mouse_hyperlink,Copy #[underscore]#{=/9/...:mouse_hyperlink},}" h { copy-mode -q ; set-buffer "#{q:mouse_hyperlink}" } '' "#{?#{#{pane_floating_flag}},Move,}" '' { display-menu -T "#[align=centre]Move" -x L -y L Centre c { move-pane -P centre } '' "Top Left" 1 { move-pane -P top-left } "Top Right" 2 { move-pane -P top-right } "Bottom Left" 3 { move-pane -P bottom-left } "Bottom Right" 4 { move-pane -P bottom-right } '' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Move & Resize,}" '' { display-menu -T "#[align=centre]Move & Resize" -x L -y L Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Tile,}" t { join-pane } "#{?#{!:#{pane_floating_flag}},Float,}" f { break-pane -W } "#{?#{!:#{pane_floating_flag}},Horizontal Split,}" h { split-window -h } "#{?#{!:#{pane_floating_flag}},Vertical Split,}" v { split-window -v } '' "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Up,}" u { swap-pane -U } "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Down,}" d { swap-pane -D } "#{?pane_marked_set,,-}Swap Marked" s { swap-pane } '' Kill X { kill-pane } Respawn R { respawn-pane -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } "#{?#{>:#{window_panes},1},,-}#{?window_zoomed_flag,Unzoom,Zoom}" z { resize-pane -Z } }
    K\troot\tMouseDown3Status\t0\t\tdisplay-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x W -y W "#{?#{>:#{session_windows},1},,-}Swap Left" l { swap-window -t :-1 } "#{?#{>:#{session_windows},1},,-}Swap Right" r { swap-window -t :+1 } "#{?pane_marked_set,,-}Swap Marked" s { swap-window } '' Kill X { kill-window } Respawn R { respawn-window -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } Rename n { command-prompt -F -I "#W" { rename-window -t "#{window_id}" "%%" } } '' "New After" w { new-window -a } "New At End" W { new-window }
    K\troot\tMouseDown3StatusLeft\t0\t\trun-shell -C "display-menu -t= -xM -yW -T '#[align=centre]#{session_name}'  #{S/t:#{?#{&&:#{<:#{loop_index},6},#{!:#{session_active}}},'Switch To #[underscore]#{session_name}' '' {switch-client -t=#{session_id}#} ,}} '' 'Renumber' 'N' {move-window -r} 'Rename' 'r' {command-prompt -I '#S' {rename-session -- '%%'}} 'Detach' 'd' {detach-client} '' 'New Session' 's' {new-session} 'New Window' 'w' {new-window}"
    K\troot\tMouseDown3Empty\t0\t\tdisplay-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x M -y M "New Pane" p { new-pane ; join-pane } "New Window" w { new-window }
    K\troot\tMouseDrag1Pane\t0\t\tif-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -M }
    K\troot\tMouseDrag1Border\t0\t\tresize-pane -M
    K\troot\tMouseDrag1ScrollbarSlider\t0\t\tif-shell -F -t = "#{pane_in_mode}" { send-keys -X scroll-to-mouse } { copy-mode -S }
    K\troot\tWheelDownStatus\t0\t\tnext-window
    K\troot\tWheelUpPane\t0\t\tif-shell -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -e }
    K\troot\tWheelUpStatus\t0\t\tprevious-window
    K\troot\tDoubleClick1Pane\t0\t\tselect-pane -t = \\; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -H ; send-keys -X select-word ; run-shell -d 0.3 ; send-keys -X copy-pipe-and-cancel }
    K\troot\tTripleClick1Pane\t0\t\tselect-pane -t = \\; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -H ; send-keys -X select-line ; run-shell -d 0.3 ; send-keys -X copy-pipe-and-cancel }
    K\troot\tM-MouseDown3Pane\t0\t\tdisplay-menu -T "#[align=centre]#{pane_index} (#{pane_id})" -t = -x M -y M "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Top,}" < { send-keys -X history-top } "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Bottom,}" > { send-keys -X history-bottom } '' "#{?#{==:#{pane_mode},copy-mode},#{?copy_line_numbers,Hide Line Numbers,Show Line Numbers},}" L { send-keys -X line-numbers-toggle } "#{?#{==:#{pane_mode},copy-mode},#{?refresh_active,Refresh Off,Refresh On},}" r { send-keys -X refresh-toggle } '' "#{?#{&&:#{buffer_size},#{!:#{pane_in_mode}}},Paste #[underscore]#{=/9/...:buffer_sample},}" p { paste-buffer } '' "#{?mouse_word,Search For #[underscore]#{=/9/...:mouse_word},}" C-r { if-shell -F "#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}" "copy-mode -t=" ; send-keys -X -t = search-backward -- "#{q:mouse_word}" } "#{?mouse_word,Type #[underscore]#{=/9/...:mouse_word},}" C-y { copy-mode -q ; send-keys -l "#{q:mouse_word}" } "#{?mouse_word,Copy #[underscore]#{=/9/...:mouse_word},}" c { copy-mode -q ; set-buffer "#{q:mouse_word}" } "#{?mouse_line,Copy Line,}" l { copy-mode -q ; set-buffer "#{q:mouse_line}" } '' "#{?mouse_hyperlink,Type #[underscore]#{=/9/...:mouse_hyperlink},}" C-h { copy-mode -q ; send-keys -l "#{q:mouse_hyperlink}" } "#{?mouse_hyperlink,Copy #[underscore]#{=/9/...:mouse_hyperlink},}" h { copy-mode -q ; set-buffer "#{q:mouse_hyperlink}" } '' "#{?#{#{pane_floating_flag}},Move,}" '' { display-menu -T "#[align=centre]Move" -x L -y L Centre c { move-pane -P centre } '' "Top Left" 1 { move-pane -P top-left } "Top Right" 2 { move-pane -P top-right } "Bottom Left" 3 { move-pane -P bottom-left } "Bottom Right" 4 { move-pane -P bottom-right } '' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Move & Resize,}" '' { display-menu -T "#[align=centre]Move & Resize" -x L -y L Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Tile,}" t { join-pane } "#{?#{!:#{pane_floating_flag}},Float,}" f { break-pane -W } "#{?#{!:#{pane_floating_flag}},Horizontal Split,}" h { split-window -h } "#{?#{!:#{pane_floating_flag}},Vertical Split,}" v { split-window -v } '' "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Up,}" u { swap-pane -U } "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Down,}" d { swap-pane -D } "#{?pane_marked_set,,-}Swap Marked" s { swap-pane } '' Kill X { kill-pane } Respawn R { respawn-pane -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } "#{?#{>:#{window_panes},1},,-}#{?window_zoomed_flag,Unzoom,Zoom}" z { resize-pane -Z }
    K\troot\tM-MouseDown3Status\t0\t\tdisplay-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x W -y W "#{?#{>:#{session_windows},1},,-}Swap Left" l { swap-window -t :-1 } "#{?#{>:#{session_windows},1},,-}Swap Right" r { swap-window -t :+1 } "#{?pane_marked_set,,-}Swap Marked" s { swap-window } '' Kill X { kill-window } Respawn R { respawn-window -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } Rename n { command-prompt -F -I "#W" { rename-window -t "#{window_id}" "%%" } } '' "New After" w { new-window -a } "New At End" W { new-window }
    K\troot\tM-MouseDown3StatusLeft\t0\t\trun-shell -C "display-menu -t= -xM -yW -T '#[align=centre]#{session_name}'  #{S/t:#{?#{&&:#{<:#{loop_index},6},#{!:#{session_active}}},'Switch To #[underscore]#{session_name}' '' {switch-client -t=#{session_id}#} ,}} '' 'Renumber' 'N' {move-window -r} 'Rename' 'r' {command-prompt -I '#S' {rename-session -- '%%'}} 'Detach' 'd' {detach-client} '' 'New Session' 's' {new-session} 'New Window' 'w' {new-window}"
    K\troot\tM-MouseDown3Empty\t0\t\tdisplay-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x M -y M "New Pane" p { new-pane ; join-pane } "New Window" w { new-window }
