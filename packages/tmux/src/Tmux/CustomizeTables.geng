module Tmux.CustomizeTables exposing (newest, older)

{-| What tmux's customize mode knows that no command reports (TM62):
each option's type, scope, flags, unit, choices and description, the
defaults as `show-options` prints them, and the default keys, per tmux
version: the newest whole, each older one as the rows that differ from
it (an `X` row: one it does not have). Generated by
`packages/tmux/tools/customize_tables.py` from tmux's own source
(`options-table.c`, ISC licence, Nicholas Marriott and others) and a
fresh server; do not edit. -}


{-| The newest version's table, and its version (tenths). -}
newest : { version : Int, rows : String }
newest =
    { version = 38, rows = table38 }


{-| The older versions' differences from the newest, newest first. -}
older : Array { version : Int, rows : String }
older =
    [ { version = 36, rows = table36 }
    ]


table38 : String
table38 =
    """
    O\tbackspace\tkey\tS\t\t\t\tThe key to send for backspace.
    O\tbuffer-limit\tnumber\tS\t\t\t\tThe maximum number of automatic buffers. When this is reached, the oldest buffer is deleted.
    O\tclear-on-attach\tflag\tS\t\t\t\tWhether to use the alternate screen and clear it when a client is attached. When disabled, tmux does not enter the alternate screen on attach so terminal content before tmux remains in scrollback.
    O\tcommand-alias\tstring\tS\ta\t\t\tArray of command aliases. Each entry is an alias and a command separated by '='.
    O\tcodepoint-widths\tstring\tS\ta\t\t\tArray of override widths for Unicode codepoints.
    O\tcopy-command\tstring\tS\t\t\t\tShell command run when text is copied. If empty, no command is run.
    O\tcursor-colour\tstring\twp\tc\t\t\tColour of the cursor.
    O\tcursor-style\tchoice\twp\t\t\tdefault,blinking-block,block,blinking-underline,underline,blinking-bar,bar\tStyle of the cursor.
    O\tdefault-client-command\tcommand\tS\t\t\t\tDefault command to run when tmux is run without a command.
    O\tdefault-terminal\tstring\tS\t\t\t\tDefault for the 'TERM' environment variable.
    O\teditor\tstring\tS\t\t\t\tEditor run to edit files.
    O\tescape-time\tnumber\tS\t\tmilliseconds\t\tTime to wait before assuming a key is Escape.
    O\texit-empty\tflag\tS\t\t\t\tWhether the server should exit if there are no sessions.
    O\texit-unattached\tflag\tS\t\t\t\tWhether the server should exit if there are no attached clients.
    O\textended-keys\tchoice\tS\t\t\toff,on,always\tWhether to request extended key sequences from terminals that support it.
    O\textended-keys-format\tchoice\tS\t\t\tcsi-u,xterm\tThe format of emitted extended key sequences.
    O\tfocus-events\tflag\tS\t\t\t\tWhether to send focus events to applications.
    O\tget-clipboard\tchoice\tS\t\t\toff,buffer,request,both\tWhen an application requests the clipboard, whether to ignore the request ('off'); respond with the newest buffer ('buffer'); request the clipboard from the most recently used terminal ('request'); or to request the clipboard, create a buffer, and send it to the application ('both').
    O\thistory-file\tstring\tS\t\t\t\tLocation of the command prompt history file. Empty does not write a history file.
    O\tinput-buffer-size\tnumber\tS\t\t\t\tNumber of bytes accepted in a single input before dropping.
    O\tmenu-style\tstring\tw\ts\t\t\tDefault style of menu.
    O\tmenu-selected-style\tstring\tw\ts\t\t\tDefault style of selected menu item.
    O\tmenu-border-style\tstring\tw\ts\t\t\tDefault style of menu borders.
    O\tmenu-border-lines\tchoice\tw\t\t\tsingle,double,heavy,simple,rounded,padded,none\tType of characters used to draw menu border lines. Some of these are only supported on terminals with UTF-8 support.
    O\tmessage-limit\tnumber\tS\t\t\t\tMaximum number of server messages to keep.
    O\tprefix-timeout\tnumber\tS\t\tmilliseconds\t\tThe timeout for the prefix key if no subsequent key is pressed. Zero means disabled.
    O\tprompt-history-limit\tnumber\tS\t\t\t\tMaximum number of commands to keep in history.
    O\tset-clipboard\tchoice\tS\t\t\toff,external,on\tWhether to attempt to set the system clipboard ('on' or 'external') and whether to allow applications to create paste buffers with an escape sequence ('on' only).
