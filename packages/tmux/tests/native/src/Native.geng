module Native exposing (main)

{-| The tmux package's unit tests as a native program, run by
gren-unit-node's native runner: `TmuxSuites`, the suites `../run.sh` runs
on node. Run with `./run.sh`. -}

import Os.Env
import Task exposing (Task)
import Test.Runner.UnitNode.Program as Program
import TmuxSuites


main : Task Never {}
main =
    Os.Env.getEnvironment
        |> Task.andThen
            (\env ->
                Program.run env
                    { name = "puritty-tmux"
                    , version = "0.1.0"
                    , suites = TmuxSuites.suites
                    }
            )
