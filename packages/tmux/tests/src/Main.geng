module Main exposing (main)

{-| The tmux package's unit tests on node; `TmuxSuites` says what they are,
and `native/` runs the same suites as a native program. Run with
`./run.sh`. -}

import Node
import Task exposing (Task)
import Test.Runner.UnitNode.Program as Program
import TmuxSuites


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                Program.run env
                    { name = "puritty-tmux"
                    , version = "0.1.0"
                    , suites = TmuxSuites.suites
                    }
            )
