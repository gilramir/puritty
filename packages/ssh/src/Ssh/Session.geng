module Ssh.Session exposing
    ( AgentPath(..)
    , Answer(..)
    , Ask(..)
    , Input(..)
    , Notice(..)
    , Options
    , Permissions
    , fingerprint
    , optionsFor
    , run
    )

{-| One ssh session, end to end (puritty `docs/ssh-client.md` SC8, SC11
step 8): the connection, the transport, the host's key against
`known_hosts`, user authentication with key files and an agent, and the
session channel. Its caller, puritty's window, reads what happens from a
`Source` of [`Notice`](#Notice)s and gives it keys, sizes and answers
through a `Source` of [`Input`](#Input)s.

What only the user can answer it asks: whether to trust a host's key
the first time, a password, a key's passphrase, a server's prompts. It
never asks about a key that has changed: as OpenSSH does, it refuses the
connection and says which lines of which file hold the old key.

A session can go through jump hosts, as OpenSSH's `ProxyJump` does (SC21):
each hop is a session of its own, its key checked and its user logged in,
asking in the same window, and then a `direct-tcpip` channel to the next.
The connection to the next hop, and in the end to the host, runs inside
that channel, so the jump hosts see only encrypted bytes. Once its channel
is open a hop runs in a process of its own, carrying bytes both ways.
-}

import Bytes exposing (Bytes)
import Dict
import Os.Directory as Directory
import Os.Error
import Os.File as File
import Os.Net as Net
import Os.Path as Path exposing (Path)
import Os.Random
import Process
import Source exposing (Source)
import Ssh.Agent as Agent
import Ssh.Auth as Auth
import Ssh.Base64 as Base64
import Ssh.Config as Config
import Ssh.Connection as Connection
import Ssh.KnownHosts as KnownHosts
import Ssh.Transport as Transport
import SshCrypto
import Task exposing (Task)


type alias Permissions =
    { net : Net.Permission, fs : File.Permission }


{-| What the session is, mostly as `~/.ssh/config` resolved it
(`Ssh.Config`): where, who, the key files to offer (each path absolute),
the agents to try, the `known_hosts` files (the first is the one a new
key is written to), how strictly a key is held (`ask`, `yes`,
`accept-new`, `no`), the name keys are looked up by when it is not the
host's, the terminal and command, and the keepalives (`ServerAliveInterval`
in seconds, 0 for none, and `ServerAliveCountMax`).
-}
type alias Options =
    { host : String
    , port : Int
    , user : String
    , identityFiles : Array String
    , identitiesOnly : Bool
    , agents : Array AgentPath
    , knownHostsFiles : Array String
    , strictHostKeyChecking : String
    , hostKeyAlias : Maybe String
    , session : Connection.Session
    , keepaliveSeconds : Int
    , keepaliveCountMax : Int
    }


{-| Where an agent listens: a Unix-domain socket (`SSH_AUTH_SOCK` on
Linux), or a named pipe (Windows' OpenSSH agent's
`\\.\pipe\openssh-ssh-agent`, Pageant's). The first of the options'
that answers is used. -}
type AgentPath
    = LocalSocket String
    | Pipe String


{-| What the user is asked. -}
type Ask
    = TrustHostKey { host : String, algorithm : String, fingerprint : String, knownTypes : Array String }
    | Password { prompt : String }
    | Passphrase { file : String }
    | Responses { name : String, instruction : String, prompts : Array { text : String, echo : Bool } }


{-| The user's answer to the last [`Ask`](#Ask). `Trust`: connect, and
remember the key if `remember`. `Give` and `GiveAll`: what was typed.
`Decline`: no, and the method or the connection is given up. -}
type Answer
    = Trust { remember : Bool }
    | Give String
    | GiveAll (Array String)
    | Decline


{-| What the window gives the session. -}
type Input
    = Keys Bytes
    | Resize { columns : Int, rows : Int }
    | Answered Answer
    | Hangup
    | Reconnect


{-| What the window is told:

  - `Status`: a line for puritty's own screen, before the session starts.
  - `Asking`: a question; the session waits for an [`Answered`](#Input).
  - `Banner`: the server's banner, its own words.
  - `Started`: the session runs; what follows is the program's.
  - `Output`: the program's bytes.
  - `Exited`: its exit status (128 + the signal's number's stand-in, 255,
    for a signal, as OpenSSH's `ssh` gives).
  - `Failed`: why the session could not start or ended badly.
  - `Ended`: nothing more comes.

-}
type Notice
    = Status String
    | Asking Ask
    | Banner String
    | Started
    | Output Bytes
    | Exited Int
    | Failed String
    | Ended


{-| A key's fingerprint as OpenSSH prints it: `SHA256:` and the hash in
base64 without its padding. -}
fingerprint : Bytes -> String
fingerprint key =
    "SHA256:" ++ String.replace "=" "" (Base64.encode (SshCrypto.hash SshCrypto.Sha256 key))


type alias Identity =
    { identity : Auth.Identity, file : Maybe { path : String, text : Bytes } }


type Waiting
    = NotWaiting
    | ForHostKey { name : String, key : Bytes }
    | ForPassword
    | ForPassphrase { need : { id : Int, algorithm : String, data : Bytes }, text : Bytes, tries : Int }
    | ForResponses


{-| What a session's transport reads from and writes to: a socket, or a
jump host's channel. `read` answers empty bytes at the end. -}
type alias Link =
    { read : Task Os.Error.Error Bytes
    , write : Bytes -> Task Os.Error.Error {}
    , close : Task Os.Error.Error {}
    }


socketLink : Net.Socket -> Link
socketLink socket =
    { read = Net.read socket
    , write = \bytes -> Net.write bytes socket
    , close = Net.close socket |> Task.onError (\_ -> Task.succeed {})
    }


{-| What a session is for: the user's terminal on the host, or a hop to
the next host, whose bytes go to `toInner` as they come. -}
type Role
    = Terminal
    | Forward { host : String, port : Int, toInner : Source Bytes }


type alias State =
    { options : Options
    , permissions : Permissions
    , link : Link
    , role : Role
    , label : String
    , forwarding : Bool
    , agent : Maybe AgentLink
    , notices : Source Notice
    , transport : Transport.Transport
    , auth : Maybe Auth.Auth
    , connection : Maybe Connection.Connection
    , identities : Array Identity
    , known : Array KnownHosts.Entry
    , hostKeyTrusted : Bool
    , keysReady : Bool
    , waiting : Waiting
    , exitStatus : Maybe Int
    , unanswered : Int
    , done : Bool
    }


{-| A notice to the window; a jump host's status lines and its failure
carry its name first. -}
tell : Notice -> State -> Task x State
tell notice st =
    let
        labeled =
            when notice is
                Status line ->
                    Status (st.label ++ line)

                Failed why ->
                    Failed (st.label ++ why)

                other ->
                    other
    in
    Source.emit st.notices labeled |> Task.map (\_ -> st)


{-| The session, from connecting to the end, through `jumps` in order when
there are any, telling `notices` as it goes; it ends by telling `Ended`. -}
run : Permissions -> Array Options -> Options -> Source Notice -> Source Input -> Task x {}
run permissions jumps options notices inputs =
    through permissions jumps options notices inputs Nothing
        |> Task.onError (\e -> Source.emit notices (Failed (Os.Error.toString e)))
        |> Task.andThen (\_ -> Source.emit notices Ended)


{-| The next hop or the host, over `link` (a jump host's channel) or a
connection of its own. -}
through : Permissions -> Array Options -> Options -> Source Notice -> Source Input -> Maybe Link -> Task Os.Error.Error {}
through permissions jumps target notices inputs given =
    when Array.popFirst jumps is
        Nothing ->
            connectTo permissions target notices "" given
                |> Task.andThen
                    (\link ->
                        session permissions target Terminal "" link notices
                            |> Task.andThen (loop (Source.next inputs |> Task.map FromWindow))
                            |> Task.andThen (\st -> st.link.close)
                    )

        Just hop ->
            let
                next =
                    Array.first hop.rest |> Maybe.withDefault target

                label =
                    "jump host " ++ hop.first.host ++ ": "
            in
            Task.map2 (\toInner fromInner -> { toInner = toInner, fromInner = fromInner }) Source.new Source.new
                |> Task.andThen
                    (\pipes ->
                        connectTo permissions hop.first notices label given
                            |> Task.andThen
                                (\link ->
                                    session permissions hop.first (Forward { host = next.host, port = next.port, toInner = pipes.toInner }) label link notices
                                        |> Task.andThen (loop (Source.next inputs |> Task.map FromWindow))
                                )
                            |> Task.andThen
                                (\st ->
                                    if st.forwarding && not st.done then
                                        -- the hop's channel is open: it carries the next
                                        -- connection in a process of its own
                                        Process.spawn (carry pipes.fromInner st)
                                            |> Task.andThen
                                                (\_ ->
                                                    through permissions hop.rest target notices inputs
                                                        (Just
                                                            { read = Source.next pipes.toInner |> Task.map (Maybe.withDefault Bytes.empty)
                                                            , write = \bytes -> Source.emit pipes.fromInner bytes
                                                            , close = Source.close pipes.fromInner
                                                            }
                                                        )
                                                )

                                    else
                                        st.link.close
                                )
                    )


{-| A hop's channel kept running: what the next connection writes goes to
it, what comes from it goes to the next connection, until either ends;
then the hop's connection closes, and the next connection reads its end.
-}
carry : Source Bytes -> State -> Task x {}
carry fromInner st =
    loop (Source.next fromInner |> Task.map FromInner) { st | forwarding = False }
        |> Task.onError (\_ -> Task.succeed st)
        |> Task.andThen (\s -> s.link.close |> Task.onError (\_ -> Task.succeed {}))
        |> Task.andThen (\_ -> closeInner st)


closeInner : State -> Task x {}
closeInner st =
    when st.role is
        Forward f ->
            Source.close f.toInner

        Terminal ->
            Task.succeed {}


{-| A connection to the session's host: `given` (a jump host's channel), or
a socket of its own. -}
connectTo : Permissions -> Options -> Source Notice -> String -> Maybe Link -> Task Os.Error.Error Link
connectTo permissions options notices label given =
    Source.emit notices
        (Status
            (label
                ++ "connecting to "
                ++ options.host
                ++ (if options.port == 22 then
                        ""

                    else
                        ":" ++ String.fromInt options.port
                   )
            )
        )
        |> Task.andThen
            (\_ ->
                when given is
                    Just link ->
                        Task.succeed link

                    Nothing ->
                        Net.connect permissions.net { host = options.host, port = options.port } |> Task.map socketLink
            )


{-| A session begun over `link`: its known hosts, keys and agent read, and
its transport started. -}
session : Permissions -> Options -> Role -> String -> Link -> Source Notice -> Task Os.Error.Error State
session permissions options role label link notices =
    let
        lookupName =
            KnownHosts.lookupName { host = Maybe.withDefault options.host options.hostKeyAlias, port = options.port }
    in
    readKnownHosts permissions options
        |> Task.andThen
            (\known ->
                identitiesOf permissions options
                    |> Task.andThen
                        (\files ->
                            agentOf permissions options files
                                |> Task.andThen
                                    (\agent ->
                                        Os.Random.bytes 32
                                            |> Task.andThen
                                                (\seed ->
                                                    let
                                                        defaults =
                                                            Transport.defaultConfig

                                                        config =
                                                            { defaults | hostKeys = KnownHosts.orderHostKeys (KnownHosts.keyTypesFor lookupName known) defaults.hostKeys }

                                                        started =
                                                            Transport.start config seed
                                                    in
                                                    onTransport started
                                                        { options = options
                                                        , permissions = permissions
                                                        , link = link
                                                        , role = role
                                                        , label = label
                                                        , forwarding = False
                                                        , agent = agent.link
                                                        , notices = notices
                                                        , transport = started.transport
                                                        , auth = Nothing
                                                        , connection = Nothing
                                                        , identities = files ++ agent.identities
                                                        , known = known
                                                        , hostKeyTrusted = False
                                                        , keysReady = False
                                                        , waiting = NotWaiting
                                                        , exitStatus = Nothing
                                                        , unanswered = 0
                                                        , done = False
                                                        }
                                                )
                                    )
                        )
            )


{-| Every `known_hosts` file's entries, a missing file none. -}
readKnownHosts : Permissions -> Options -> Task x (Array KnownHosts.Entry)
readKnownHosts permissions options =
    options.knownHostsFiles
        |> Array.map
            (\f ->
                File.readFile permissions.fs (Path.fromString f)
                    |> Task.map (\text -> (KnownHosts.parse (Bytes.toStringLossy text)).entries)
                    |> Task.onError (\_ -> Task.succeed [])
            )
        |> Task.sequence
        |> Task.map Array.flatten


{-| The key files that are there and that this client reads, numbered in
order; a missing one is passed over, as OpenSSH does. -}
identitiesOf : Permissions -> Options -> Task x (Array Identity)
identitiesOf permissions options =
    options.identityFiles
        |> Array.indexedMap
            (\i path ->
                File.readFile permissions.fs (Path.fromString path)
                    |> Task.map
                        (\text ->
                            when SshCrypto.keyFileInfo text is
                                Just info ->
                                    [ { identity = { id = i, publicKey = info.publicKey, keyType = KnownHosts.keyTypeOf info.publicKey }, file = Just { path = path, text = text } } ]

                                Nothing ->
                                    []
                        )
                    |> Task.onError (\_ -> Task.succeed [])
            )
        |> Task.sequence
        |> Task.map Array.flatten


{-| A connection to an agent: a request sent, and its whole answer. -}
type alias AgentLink =
    { call : Bytes -> Task Os.Error.Error Bytes }


{-| The agent's keys, numbered from 1000, from the first of the agents
that answers, unless the files' keys are the only ones to offer
(`IdentitiesOnly`), when only those of its keys that a file names are. -}
agentOf : Permissions -> Options -> Array Identity -> Task x { link : Maybe AgentLink, identities : Array Identity }
agentOf permissions options files =
    when Array.popFirst options.agents is
        Nothing ->
            Task.succeed { link = Nothing, identities = [] }

        Just candidate ->
            linkTo permissions candidate.first
                |> Task.andThen
                    (\link ->
                        link.call Agent.requestIdentities
                            |> Task.andThen
                                (\message ->
                                    when Agent.identities message is
                                        Ok keys ->
                                            let
                                                fromFiles =
                                                    Array.map (\f -> f.identity.publicKey) files

                                                offered =
                                                    if options.identitiesOnly then
                                                        Array.keepIf (\k -> Array.member k.publicKey fromFiles) keys

                                                    else
                                                        Array.keepIf (\k -> not (Array.member k.publicKey fromFiles)) keys
                                            in
                                            Task.succeed
                                                { link = Just link
                                                , identities =
                                                    Array.indexedMap (\i k -> { identity = { id = 1000 + i, publicKey = k.publicKey, keyType = KnownHosts.keyTypeOf k.publicKey }, file = Nothing }) offered
                                                }

                                        Err why ->
                                            Task.fail { kind = Os.Error.Other, operation = "agent", path = Nothing, detail = why }
                                )
                    )
                |> Task.onError (\_ -> agentOf permissions { options | agents = candidate.rest } files)


linkTo : Permissions -> AgentPath -> Task Os.Error.Error AgentLink
linkTo permissions path =
    when path is
        LocalSocket socketPath ->
            Net.connectLocal permissions.net (Path.fromString socketPath)
                |> Task.map (\socket -> { call = \request -> Net.write request socket |> Task.andThen (\_ -> agentRead (Net.read socket) Bytes.empty) })

        Pipe pipePath ->
            File.open permissions.fs (File.ForReadAndWrite File.ExpectExisting) (Path.fromString pipePath)
                |> Task.map (\handle -> { call = \request -> File.write request handle |> Task.andThen (\_ -> agentRead (File.read handle) Bytes.empty) })


agentRead : Task Os.Error.Error Bytes -> Bytes -> Task Os.Error.Error Bytes
agentRead readMore got =
    when Agent.unframe got is
        Just whole ->
            Task.succeed whole.message

        Nothing ->
            readMore
                |> Task.andThen
                    (\more ->
                        if Bytes.isEmpty more then
                            Task.succeed Bytes.empty

                        else
                            agentRead readMore (Bytes.flatten [ got, more ])
                    )


-- THE LOOP


type Turn
    = FromServer Bytes
    | FromWindow (Maybe Input)
    | FromInner (Maybe Bytes)
    | Tick


{-| The server's bytes, the other side's (the window's inputs, or for a
hop that carries a connection, that connection's bytes) and the
keepalive's timer, raced, until the session is done, or a hop's channel
has opened and it is to run on its own. A read and a `Source.next` that
lose a race keep what they took (D1045, D377). -}
loop : Task Os.Error.Error Turn -> State -> Task Os.Error.Error State
loop other st =
    if st.done || st.forwarding then
        Task.succeed st

    else
        let
            timer =
                if st.options.keepaliveSeconds > 0 && isJust st.connection then
                    [ Process.sleep (toFloat (st.options.keepaliveSeconds * 1000)) |> Task.map (\_ -> Tick) ]

                else
                    []
        in
        Task.race (st.link.read |> Task.map FromServer) ([ other ] ++ timer)
            |> Task.andThen
                (\turn ->
                    when turn is
                        FromServer chunk ->
                            if Bytes.isEmpty chunk then
                                ending "the server closed the connection" st

                            else
                                onTransport (Transport.receive chunk st.transport) st

                        FromWindow (Just input) ->
                            onInput input st

                        FromWindow Nothing ->
                            onTransport (Transport.disconnect 11 "the window closed" st.transport) { st | done = True }

                        FromInner (Just bytes) ->
                            withConnection (Connection.write bytes) st

                        FromInner Nothing ->
                            -- the connection inside is over
                            onTransport (Transport.disconnect 11 "the session through it ended" st.transport) { st | done = True }

                        Tick ->
                            if st.unanswered >= st.options.keepaliveCountMax then
                                ending "the server stopped answering keepalives" st
                                    |> Task.andThen (\s -> onTransport (Transport.disconnect 11 "keepalives unanswered" s.transport) s)

                            else
                                withConnection Connection.keepalive st
                )
            |> Task.andThen (loop other)


{-| The session over: why, unless it already said how the program ended. -}
ending : String -> State -> Task x State
ending why st =
    (if st.exitStatus == Nothing then
        tell (Failed why) st

     else
        Task.succeed st
    )
        |> Task.map (\s -> { s | done = True })


onInput : Input -> State -> Task Os.Error.Error State
onInput input st =
    when { input = input, role = st.role } is
        { role = Forward _, input = Keys _ } ->
            -- a hop's channel carries the next connection, not keys
            Task.succeed st

        { role = Forward _, input = Resize _ } ->
            Task.succeed st

        { input = Keys bytes } ->
            withConnection (Connection.write bytes) st

        { input = Resize size } ->
            withConnection (Connection.resize size) st

        { input = Hangup } ->
            onTransport (Transport.disconnect 11 "the window closed" st.transport) { st | done = True }

        { input = Answered answer } ->
            onAnswer answer st

        { input = Reconnect } ->
            Task.succeed st


withConnection : (Connection.Connection -> Connection.Step) -> State -> Task Os.Error.Error State
withConnection f st =
    when st.connection is
        Just c ->
            onConnection (f c) st

        Nothing ->
            Task.succeed st


onTransport : Transport.Step -> State -> Task Os.Error.Error State
onTransport step st0 =
    (if Bytes.isEmpty step.out then
        Task.succeed {}

     else
        st0.link.write step.out
    )
        |> Task.andThen
            (\_ ->
                Array.foldl (\event acc -> acc |> Task.andThen (onEvent event))
                    (Task.succeed { st0 | transport = step.transport })
                    step.events
            )


send : Bytes -> State -> Task Os.Error.Error State
send payload st =
    onTransport (Transport.send payload st.transport) st


onEvent : Transport.Event -> State -> Task Os.Error.Error State
onEvent event st =
    when event is
        Transport.HostKey key ->
            hostKey key st

        Transport.KeysChanged _ ->
            if st.keysReady then
                Task.succeed st

            else
                beginAuth { st | keysReady = True }

        Transport.ExtInfo extensions ->
            let
                algorithms =
                    Array.findFirst (\x -> x.name == "server-sig-algs") extensions
                        |> Maybe.map (\x -> String.split "," (Bytes.toStringLossy x.value.value))
                        |> Maybe.withDefault []
            in
            Task.succeed { st | auth = Maybe.map (Auth.withServerSigAlgs algorithms) st.auth }

        Transport.Received payload ->
            when { auth = st.auth, connection = st.connection } is
                { connection = Just c } ->
                    if Connection.isConnectionMessage payload then
                        onConnection (Connection.received payload c) st

                    else
                        Task.succeed st

                { auth = Just a } ->
                    if Auth.isAuthMessage payload then
                        onAuth (Auth.received payload a) st

                    else
                        Task.succeed st

                _ ->
                    Task.succeed st

        Transport.Closed closed ->
            ending ("the server disconnected: " ++ closed.description) st

        Transport.Failed reason ->
            ending reason st

        _ ->
            Task.succeed st


-- THE HOST'S KEY


hostKey : { algorithm : String, key : Bytes } -> State -> Task Os.Error.Error State
hostKey shown st =
    let
        name =
            KnownHosts.lookupName { host = Maybe.withDefault st.options.host st.options.hostKeyAlias, port = st.options.port }

        printed =
            fingerprint shown.key
    in
    if st.hostKeyTrusted then
        -- a new exchange's: the transport refuses one that changed
        Task.succeed st

    else
        when KnownHosts.check name shown.key st.known is
            KnownHosts.Known ->
                tell (Status ("the host's " ++ shown.algorithm ++ " key is the one known")) { st | hostKeyTrusted = True }

            KnownHosts.KeyRevoked ->
                ending ("the host's " ++ shown.algorithm ++ " key " ++ printed ++ " is revoked") st
                    |> Task.andThen (\s -> onTransport (Transport.disconnect 11 "a revoked key" s.transport) s)

            KnownHosts.Changed changed ->
                ending
                    ("THE HOST'S KEY HAS CHANGED: its "
                        ++ shown.algorithm
                        ++ " key is now "
                        ++ printed
                        ++ ", but the known hosts hold another for it (line "
                        ++ String.join ", " (Array.map String.fromInt changed.lineNumbers)
                        ++ "). Someone may be listening in, or the host was rebuilt. The connection is refused; if the host was rebuilt, take its old key out of the known hosts."
                    )
                    st
                    |> Task.andThen (\s -> onTransport (Transport.disconnect 11 "the host key changed" s.transport) s)

            KnownHosts.Unknown unknown ->
                when st.options.strictHostKeyChecking is
                    "yes" ->
                        ending ("the host's " ++ shown.algorithm ++ " key " ++ printed ++ " is not known, and StrictHostKeyChecking is yes") st
                            |> Task.andThen (\s -> onTransport (Transport.disconnect 11 "an unknown key" s.transport) s)

                    "accept-new" ->
                        remember name shown.key st |> Task.map (\s -> { s | hostKeyTrusted = True })

                    "no" ->
                        remember name shown.key st |> Task.map (\s -> { s | hostKeyTrusted = True })

                    _ ->
                        tell
                            (Asking (TrustHostKey { host = name, algorithm = shown.algorithm, fingerprint = printed, knownTypes = unknown.otherTypes }))
                            { st | waiting = ForHostKey { name = name, key = shown.key } }


{-| A host's key written to the first `known_hosts` file, its directory
made if it is not there; a file that cannot be written is said and passed
over. -}
remember : String -> Bytes -> State -> Task Os.Error.Error State
remember name key st =
    when Array.first st.options.knownHostsFiles is
        Nothing ->
            Task.succeed st

        Just file ->
            let
                path =
                    Path.fromString file
            in
            Directory.createAll st.permissions.fs (Path.parent path |> Maybe.withDefault path)
                |> Task.onError (\_ -> Task.succeed {})
                |> Task.andThen (\_ -> File.appendFile st.permissions.fs (Bytes.fromString (KnownHosts.line { name = name, salt = Nothing } key)) path)
                |> Task.andThen (\_ -> tell (Status ("the host's key is written to " ++ file)) st)
                |> Task.onError (\e -> tell (Status ("the host's key could not be written: " ++ Os.Error.toString e)) st)


-- AUTHENTICATION


{-| Authentication, once the keys are in use and the host's key is
trusted, and not before: nothing goes to a server whose key is not
settled. -}
beginAuth : State -> Task Os.Error.Error State
beginAuth st =
    if not st.hostKeyTrusted || not st.keysReady || isJust st.auth then
        Task.succeed st

    else
        let
            config =
                { user = st.options.user
                , identities = Array.map .identity st.identities
                , methods = [ "publickey", "keyboard-interactive", "password" ]
                , serverSigAlgs = []
                , passwordTries = 3
                }
        in
        tell (Status ("logging in as " ++ st.options.user)) st
            |> Task.andThen (onAuth (Auth.begin config (Transport.sessionId st.transport |> Maybe.withDefault Bytes.empty)))


onAuth : Auth.Step -> State -> Task Os.Error.Error State
onAuth step st0 =
    Array.foldl (\payload acc -> acc |> Task.andThen (send payload)) (Task.succeed { st0 | auth = Just step.auth }) step.send
        |> (\sent -> Array.foldl (\e acc -> acc |> Task.andThen (onAuthEvent e)) sent step.events)
        |> (\told -> Array.foldl (\r acc -> acc |> Task.andThen (onRequest r)) told step.requests)


onAuthEvent : Auth.Event -> State -> Task Os.Error.Error State
onAuthEvent event st =
    when event is
        Auth.Banner text ->
            tell (Banner text) st

        Auth.Refused refused ->
            tell (Status ("the server refused " ++ refused.method)) st

        Auth.PartialSuccess partial ->
            tell (Status ("the server wants one more of: " ++ String.join ", " partial.allowed)) st

        Auth.PasswordChange prompt ->
            tell (Status ("the server wants a new password, which puritty does not set: " ++ prompt)) st

        Auth.Authenticated ->
            tell (Status "logged in") st
                |> Task.andThen
                    (\s ->
                        when s.role is
                            Terminal ->
                                onConnection (Connection.open s.options.session) s

                            Forward f ->
                                tell (Status ("connecting through it to " ++ f.host ++ ":" ++ String.fromInt f.port)) s
                                    |> Task.andThen (onConnection (Connection.openDirect { host = f.host, port = f.port }))
                    )

        Auth.Exhausted exhausted ->
            ending ("permission denied: nothing left to try (the server takes " ++ String.join ", " exhausted.allowed ++ ")") st
                |> Task.andThen (\s -> onTransport (Transport.disconnect 14 "no more methods" s.transport) s)


onRequest : Auth.Request -> State -> Task Os.Error.Error State
onRequest request st =
    when { request = request, auth = st.auth } is
        { auth = Nothing } ->
            Task.succeed st

        { request = Auth.NeedSignature need, auth = Just auth } ->
            when Array.findFirst (\i -> i.identity.id == need.id) st.identities |> Maybe.map .value is
                Nothing ->
                    onAuth (Auth.unsigned need.id auth) st

                Just { file = Nothing } ->
                    when st.agent is
                        Just link ->
                            link.call (Agent.signRequest { publicKey = (identityOf need.id st).publicKey, data = need.data, algorithm = need.algorithm })
                                |> Task.map
                                    (\message ->
                                        when Agent.signature message is
                                            Ok signature ->
                                                Auth.signed need.id signature auth

                                            Err _ ->
                                                Auth.unsigned need.id auth
                                    )
                                |> Task.onError (\_ -> Task.succeed (Auth.unsigned need.id auth))
                                |> Task.andThen (\step -> onAuth step st)

                        Nothing ->
                            onAuth (Auth.unsigned need.id auth) st

                Just { file = Just file } ->
                    when SshCrypto.keyFileInfo file.text is
                        Just { encrypted = True } ->
                            tell (Asking (Passphrase { file = file.path })) { st | waiting = ForPassphrase { need = need, text = file.text, tries = 0 } }

                        _ ->
                            signWith need file.text Bytes.empty st

        { request = Auth.NeedPassword need } ->
            tell (Asking (Password { prompt = need.prompt })) { st | waiting = ForPassword }

        { request = Auth.NeedResponses need } ->
            tell (Asking (Responses need)) { st | waiting = ForResponses }


identityOf : Int -> State -> Auth.Identity
identityOf id st =
    Array.findFirst (\i -> i.identity.id == id) st.identities
        |> Maybe.map (\found -> found.value.identity)
        |> Maybe.withDefault { id = id, publicKey = Bytes.empty, keyType = "" }


{-| A signature by a key file's key: loaded, used and forgotten, so the
key is in memory only while it signs. A wrong passphrase is asked for
again, twice. -}
signWith : { id : Int, algorithm : String, data : Bytes } -> Bytes -> Bytes -> State -> Task Os.Error.Error State
signWith need text passphrase st =
    when st.auth is
        Nothing ->
            Task.succeed st

        Just auth ->
            SshCrypto.loadKey text passphrase
                |> Task.andThen
                    (\key ->
                        SshCrypto.sign key need.algorithm need.data
                            |> Task.andThen (\signature -> SshCrypto.forget key |> Task.map (\_ -> signature))
                            |> Task.onError (\p -> SshCrypto.forget key |> Task.andThen (\_ -> Task.fail p))
                    )
                |> Task.map (\signature -> { step = Auth.signed need.id signature auth, problem = Nothing })
                |> Task.onError (\p -> Task.succeed { step = Auth.unsigned need.id auth, problem = Just p })
                |> Task.andThen
                    (\result ->
                        when { problem = result.problem, waiting = st.waiting } is
                            { problem = Just SshCrypto.WrongPassphrase, waiting = ForPassphrase w } ->
                                if w.tries < 2 then
                                    tell (Status "a wrong passphrase") st
                                        |> Task.andThen (tell (Asking (Passphrase { file = (fileOf need.id st) })))
                                        |> Task.map (\s -> { s | waiting = ForPassphrase { w | tries = w.tries + 1 } })

                                else
                                    onAuth result.step { st | waiting = NotWaiting }

                            _ ->
                                onAuth result.step { st | waiting = NotWaiting }
                    )


fileOf : Int -> State -> String
fileOf id st =
    Array.findFirst (\i -> i.identity.id == id) st.identities
        |> Maybe.andThen (\found -> found.value.file)
        |> Maybe.map .path
        |> Maybe.withDefault ""


onAnswer : Answer -> State -> Task Os.Error.Error State
onAnswer answer st =
    let
        cleared =
            { st | waiting = NotWaiting }
    in
    when { waiting = st.waiting, answer = answer, auth = st.auth } is
        { waiting = ForHostKey shown, answer = Trust trust } ->
            (if trust.remember then
                remember shown.name shown.key { cleared | hostKeyTrusted = True }

             else
                Task.succeed { cleared | hostKeyTrusted = True }
            )
                |> Task.andThen beginAuth

        { waiting = ForHostKey _ } ->
            ending "the host's key was not trusted" cleared
                |> Task.andThen (\s -> onTransport (Transport.disconnect 11 "the host key was not trusted" s.transport) s)

        { waiting = ForPassword, answer = Give password, auth = Just auth } ->
            onAuth (Auth.withPassword (Just password) auth) cleared

        { waiting = ForPassword, auth = Just auth } ->
            onAuth (Auth.withPassword Nothing auth) cleared

        { waiting = ForResponses, answer = GiveAll answers, auth = Just auth } ->
            onAuth (Auth.responses (Just answers) auth) cleared

        { waiting = ForResponses, auth = Just auth } ->
            onAuth (Auth.responses Nothing auth) cleared

        { waiting = ForPassphrase w, answer = Give passphrase } ->
            signWith w.need w.text (Bytes.fromString passphrase) st

        { waiting = ForPassphrase w, auth = Just auth } ->
            onAuth (Auth.unsigned w.need.id auth) cleared

        _ ->
            Task.succeed st


-- THE SESSION


onConnection : Connection.Step -> State -> Task Os.Error.Error State
onConnection step st0 =
    Array.foldl (\payload acc -> acc |> Task.andThen (send payload)) (Task.succeed { st0 | connection = Just step.connection }) step.send
        |> (\sent -> Array.foldl (\e acc -> acc |> Task.andThen (onConnectionEvent e)) sent step.events)


onConnectionEvent : Connection.Event -> State -> Task Os.Error.Error State
onConnectionEvent event st =
    when { event = event, role = st.role } is
        { event = Connection.Started, role = Forward _ } ->
            -- the hop's channel is open: it is to run on its own
            Task.succeed { st | forwarding = True }

        { event = Connection.Output bytes, role = Forward f } ->
            Source.emit f.toInner bytes |> Task.map (\_ -> st)

        { event = Connection.Ended, role = Forward f } ->
            Source.close f.toInner
                |> Task.andThen (\_ -> onTransport (Transport.disconnect 11 "the channel ended" st.transport) { st | done = True })

        { event = Connection.Started } ->
            tell Started st

        { event = Connection.Refused why } ->
            ending why st
                |> Task.andThen (\s -> onTransport (Transport.disconnect 11 "refused" s.transport) s)

        { event = Connection.Output bytes } ->
            tell (Output bytes) st

        { event = Connection.ErrorOutput bytes } ->
            tell (Output bytes) st

        { event = Connection.Exited status } ->
            tell (Exited status) { st | exitStatus = Just status }

        { event = Connection.Killed _ } ->
            -- what OpenSSH's ssh exits with for a signal
            tell (Exited 255) { st | exitStatus = Just 255 }

        { event = Connection.Ended } ->
            onTransport (Transport.disconnect 11 "the session ended" st.transport) { st | done = True }

        { event = Connection.KeepaliveUnanswered n } ->
            Task.succeed { st | unanswered = n }


isJust : Maybe a -> Bool
isJust m =
    when m is
        Just _ ->
            True

        Nothing ->
            False


-- OPTIONS FROM ~/.ssh/config


{-| A host's options as OpenSSH would resolve them (SC7, SC15): the
user's `~/.ssh/config` and what it includes, with the puritty host entry's
user, port and key before the file's lines, as `ssh -l -p -i` put theirs
(SC12 question 9). `home` and `localUser` stand for `~` and `%u`; `agents`
are the platform's, tried in turn unless `IdentityAgent` names one. The settings' problems
(a line that does not read, a `Match` this client cannot judge) come back
beside the options.

`jumps` are the hosts to go through first, in order (SC21): the entry's
`jump`, else the file's `ProxyJump`, each `[user@]host[:port]` and each
resolved through the file as a host of its own (its `HostName`, `User`,
`Port`, keys and known hosts). A jump host's own `ProxyJump` is not
followed.
-}
optionsFor :
    Permissions
    -> { host : String, user : Maybe String, port : Maybe Int, identity : Maybe String, jump : Maybe String, command : Maybe String, home : String, localUser : String, agents : Array AgentPath, terminal : Maybe { term : String, columns : Int, rows : Int, utf8 : Bool } }
    -> Task x { options : Options, jumps : Array Options, problems : Array String }
optionsFor permissions given =
    resolveOne permissions given
        |> Task.andThen
            (\target ->
                jumpSpecs target.proxyJump
                    |> Array.map
                        (\spec ->
                            resolveOne permissions
                                { given | host = spec.host, user = spec.user, port = spec.port, identity = Nothing, jump = Nothing, command = Nothing, terminal = Nothing }
                        )
                    |> Task.sequence
                    |> Task.map
                        (\hops ->
                            { options = target.options
                            , jumps = Array.map .options hops
                            , problems = target.problems ++ Array.mapAndFlatten .problems hops
                            }
                        )
            )


{-| `ProxyJump`'s hosts: a comma-separated list of `[user@]host[:port]`,
`ssh://` before one taken off; `none` is none. -}
jumpSpecs : String -> Array { host : String, user : Maybe String, port : Maybe Int }
jumpSpecs value =
    if String.toLower (String.trim value) == "none" || String.trim value == "" then
        []

    else
        String.split "," value
            |> Array.map String.trim
            |> Array.keepIf (\v -> v /= "")
            |> Array.map
                (\v0 ->
                    let
                        v =
                            if String.startsWith "ssh://" v0 then String.dropFirst 6 v0 else v0

                        userAndRest =
                            when String.lastIndexOf "@" v is
                                Just at ->
                                    { user = Just (String.takeFirst at v), rest = String.dropFirst (at + 1) v }

                                Nothing ->
                                    { user = Nothing, rest = v }

                        rest =
                            userAndRest.rest

                        hostAndPort =
                            if String.startsWith "[" rest then
                                -- [an IPv6 address]:port
                                when String.firstIndexOf "]" rest is
                                    Just close ->
                                        { host = String.slice 1 close rest, port = String.toInt (String.dropFirst (close + 2) rest) }

                                    Nothing ->
                                        { host = rest, port = Nothing }

                            else
                                when String.lastIndexOf ":" rest is
                                    Just colon ->
                                        { host = String.takeFirst colon rest, port = String.toInt (String.dropFirst (colon + 1) rest) }

                                    Nothing ->
                                        { host = rest, port = Nothing }
                    in
                    { host = hostAndPort.host, user = userAndRest.user, port = hostAndPort.port }
                )


{-| One host's options, and its `ProxyJump` as the file and the entry give
it (`none` when neither does). -}
resolveOne :
    Permissions
    -> { host : String, user : Maybe String, port : Maybe Int, identity : Maybe String, jump : Maybe String, command : Maybe String, home : String, localUser : String, agents : Array AgentPath, terminal : Maybe { term : String, columns : Int, rows : Int, utf8 : Bool } }
    -> Task x { options : Options, proxyJump : String, problems : Array String }
resolveOne permissions given =
    let
        userFile =
            given.home ++ "/.ssh/config"

        entry =
            [ Maybe.map (\u -> { file = "puritty", lineNumber = 0, keyword = "user", args = [ u ] }) given.user
            , Maybe.map (\p -> { file = "puritty", lineNumber = 0, keyword = "port", args = [ String.fromInt p ] }) given.port
            , Maybe.map (\i -> { file = "puritty", lineNumber = 0, keyword = "identityfile", args = [ i ] }) given.identity
            , Maybe.map (\j -> { file = "puritty", lineNumber = 0, keyword = "proxyjump", args = [ j ] }) given.jump
            ]
                |> Array.mapAndFlatten (\m -> Maybe.map (\d -> [ d ]) m |> Maybe.withDefault [])
    in
    readConfigFile permissions userFile
        |> Task.andThen
            (\parsed ->
                includedFiles permissions given.home parsed.directives Dict.empty 0
                    |> Task.map
                        (\files ->
                            let
                                source pattern =
                                    Dict.foldl
                                        (\path directives acc ->
                                            if matchesPath pattern path then
                                                Array.pushLast { path = path, directives = directives } acc

                                            else
                                                acc
                                        )
                                        []
                                        files

                                settings =
                                    Config.resolve { host = given.host, localUser = given.localUser, home = given.home } source (entry ++ parsed.directives) []

                                one key fallback =
                                    Dict.get key settings.values |> Maybe.andThen Array.first |> Maybe.withDefault fallback

                                all key =
                                    Dict.get key settings.values |> Maybe.withDefault []

                                expand path =
                                    if String.startsWith "~/" path then
                                        given.home ++ String.dropFirst 1 path

                                    else
                                        String.replace "%d" given.home (String.replace "%u" given.localUser path)

                                strict =
                                    when String.toLower (one "stricthostkeychecking" "ask") is
                                        "yes" ->
                                            "yes"

                                        "true" ->
                                            "yes"

                                        "no" ->
                                            "no"

                                        "off" ->
                                            "no"

                                        "false" ->
                                            "no"

                                        "accept-new" ->
                                            "accept-new"

                                        _ ->
                                            "ask"

                                agentPaths =
                                    when Dict.get "identityagent" settings.values |> Maybe.andThen Array.first is
                                        Just "none" ->
                                            []

                                        Just "SSH_AUTH_SOCK" ->
                                            given.agents

                                        Just path ->
                                            if String.startsWith "\\\\.\\pipe\\" path || String.startsWith "//./pipe/" path then
                                                [ Pipe path ]

                                            else
                                                [ LocalSocket (expand path) ]

                                        Nothing ->
                                            given.agents

                                remoteCommand =
                                    when given.command is
                                        Just c ->
                                            Just c

                                        Nothing ->
                                            Dict.get "remotecommand" settings.values |> Maybe.andThen Array.first
                            in
                            { options =
                                { host = one "hostname" given.host
                                , port = String.toInt (one "port" "22") |> Maybe.withDefault 22
                                , user = one "user" given.localUser
                                , identityFiles = Array.map expand (all "identityfile")
                                , identitiesOnly = String.toLower (one "identitiesonly" "no") == "yes"
                                , agents = agentPaths
                                , knownHostsFiles = all "userknownhostsfile"
                                , strictHostKeyChecking = strict
                                , hostKeyAlias = Dict.get "hostkeyalias" settings.values |> Maybe.andThen Array.first
                                , session =
                                    { terminal = given.terminal
                                    , env =
                                        all "setenv"
                                            |> Array.mapAndFlatten
                                                (\pair ->
                                                    when String.split "=" pair is
                                                        [ name, value ] ->
                                                            [ { name = name, value = value } ]

                                                        _ ->
                                                            []
                                                )
                                    , command = remoteCommand
                                    }
                                , keepaliveSeconds = String.toInt (one "serveraliveinterval" "0") |> Maybe.withDefault 0
                                , keepaliveCountMax = String.toInt (one "serveralivecountmax" "3") |> Maybe.withDefault 3
                                }
                            , proxyJump = one "proxyjump" "none"
                            , problems = parsed.problems ++ settings.problems
                            }
                        )
            )


readConfigFile : Permissions -> String -> Task x { directives : Array Config.Directive, problems : Array String }
readConfigFile permissions path =
    File.readFile permissions.fs (Path.fromString path)
        |> Task.map (\text -> Config.parse path (Bytes.toStringLossy text))
        |> Task.onError (\_ -> Task.succeed { directives = [], problems = [] })


{-| Every file an `Include` may name, read: each pattern's directory
listed and its last part matched, as deep as 16 files include others. -}
includedFiles : Permissions -> String -> Array Config.Directive -> Dict.Dict String (Array Config.Directive) -> Int -> Task x (Dict.Dict String (Array Config.Directive))
includedFiles permissions home directives found depth =
    let
        patterns =
            directives
                |> Array.keepIf (\d -> d.keyword == "include")
                |> Array.mapAndFlatten .args
                |> Array.map
                    (\p ->
                        if String.startsWith "~/" p then
                            home ++ String.dropFirst 1 p

                        else if String.startsWith "/" p then
                            p

                        else
                            home ++ "/.ssh/" ++ p
                    )
    in
    if depth >= 16 || Array.isEmpty patterns then
        Task.succeed found

    else
        patterns
            |> Array.map
                (\pattern ->
                    let
                        path =
                            Path.fromString pattern

                        directory =
                            Path.parent path |> Maybe.withDefault path
                    in
                    Directory.list permissions.fs directory
                        |> Task.map (\entries -> Array.keepIf (matchesPath pattern) (Array.map (\e -> Path.toString e.path) entries))
                        |> Task.onError (\_ -> Task.succeed [])
                )
            |> Task.sequence
            |> Task.map Array.flatten
            |> Task.andThen
                (\paths ->
                    paths
                        |> Array.keepIf (\p -> not (Dict.member p found))
                        |> Array.map (\p -> readConfigFile permissions p |> Task.map (\r -> { path = p, directives = r.directives }))
                        |> Task.sequence
                        |> Task.andThen
                            (\read ->
                                let
                                    more =
                                        Array.foldl (\r d -> Dict.set r.path r.directives d) found read
                                in
                                includedFiles permissions home (Array.mapAndFlatten .directives read) more (depth + 1)
                            )
                )


{-| A path against an `Include` pattern: `*` and `?` within its last part. -}
matchesPath : String -> String -> Bool
matchesPath pattern path =
    globPath (String.toArray pattern) (String.toArray path)


globPath : Array Char -> Array Char -> Bool
globPath pattern name =
    when Array.popFirst pattern is
        Nothing ->
            Array.isEmpty name

        Just p ->
            if p.first == '*' then
                globPath p.rest name
                    || (when Array.popFirst name is
                            Just n ->
                                n.first /= '/' && globPath pattern n.rest

                            Nothing ->
                                False
                       )

            else
                when Array.popFirst name is
                    Just n ->
                        (p.first == '?' || p.first == n.first) && globPath p.rest n.rest

                    Nothing ->
                        False
