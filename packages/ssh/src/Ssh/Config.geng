module Ssh.Config exposing
    ( Context
    , Directive
    , Settings
    , Source
    , parse
    , resolve
    , toLines
    )

{-| OpenSSH's client configuration, `~/.ssh/config` (ssh_config(5); puritty
`docs/ssh-client.md` SC7, SC11 step 5): the settings a host resolves to,
as `ssh -G` prints them, for the keywords this client acts on.

The rules, held to `ssh -G` (`tests/make-config.py`): a keyword's first
value wins over the whole file, in order, except those that add up
(`IdentityFile`, `CertificateFile`, `SendEnv`, `LocalForward`,
`RemoteForward`, `DynamicForward`; `SetEnv`'s first line wins whole);
`Host` lines match the host as typed, case and all, each word a pattern (a
comma is part of one), `Match` lines the criteria below, a comma between
patterns and case not regarded; `Include` reads other files where it
stands. Keywords are any case, `=` may stand between a keyword and its
value, and a value may be quoted.

Reading the files is the caller's: `resolve` is handed what `Include`
names, through [`Source`](#Source).
-}

import Dict exposing (Dict)


{-| One line that says something: where it is, its keyword in lower case,
and its arguments, quotes taken off. -}
type alias Directive =
    { file : String, lineNumber : Int, keyword : String, args : Array String }


{-| A file's directives, and the lines that do not read. -}
parse : String -> String -> { directives : Array Directive, problems : Array String }
parse file text =
    String.lines text
        |> Array.indexedMap (\i l -> { lineNumber = i + 1, text = String.trim l })
        |> Array.foldl
            (\l acc ->
                if String.isEmpty l.text || String.startsWith "#" l.text then
                    acc

                else
                    when tokens l.text is
                        Ok split ->
                            when Array.popFirst split is
                                Just w ->
                                    { acc | directives = Array.pushLast { file = file, lineNumber = l.lineNumber, keyword = String.toLower w.first, args = w.rest } acc.directives }

                                Nothing ->
                                    acc

                        Err why ->
                            { acc | problems = Array.pushLast (file ++ ":" ++ String.fromInt l.lineNumber ++ ": " ++ why) acc.problems }
            )
            { directives = [], problems = [] }


{-| A line's words: the keyword, an optional `=` after it, then arguments
split at spaces outside double quotes, a `#` after a space ending them. -}
tokens : String -> Result String (Array String)
tokens text =
    let
        chars =
            String.toArray text

        keywordEnd =
            Array.findFirst (\c -> c == ' ' || c == '\t' || c == '=') chars
                |> Maybe.map .index
                |> Maybe.withDefault (Array.length chars)

        keyword =
            String.fromArray (Array.takeFirst keywordEnd chars)

        afterKeyword =
            String.trimLeft (String.fromArray (Array.dropFirst keywordEnd chars))

        rest =
            if String.startsWith "=" afterKeyword then
                String.trimLeft (String.dropFirst 1 afterKeyword)

            else
                afterKeyword
    in
    splitArgs (String.toArray rest) "" False False []
        |> Result.map (\ws -> Array.pushFirst keyword ws)


splitArgs : Array Char -> String -> Bool -> Bool -> Array String -> Result String (Array String)
splitArgs chars current started quoted acc =
    when Array.popFirst chars is
        Nothing ->
            if quoted then
                Err "a quote that does not end"

            else if started then
                Ok (Array.pushLast current acc)

            else
                Ok acc

        Just c ->
            if c.first == '"' then
                splitArgs c.rest current True (not quoted) acc

            else if not quoted && (c.first == ' ' || c.first == '\t') then
                if started then
                    splitArgs c.rest "" False False (Array.pushLast current acc)

                else
                    splitArgs c.rest current False False acc

            else if not quoted && not started && c.first == '#' then
                Ok acc

            else
                splitArgs c.rest (current ++ String.fromChar c.first) True quoted acc


{-| Who is connecting where: the host as typed, and the local user and
home, which `%u`, `%d` and `~` stand for. -}
type alias Context =
    { host : String, localUser : String, home : String }


{-| What an `Include` reads: the files a pattern names (`*` and `?` in
its last part), each with its directives, in the order OpenSSH reads them
(sorted by name). -}
type alias Source =
    String -> Array { path : String, directives : Array Directive }


{-| What the host resolves to: each keyword in lower case with its values
(one for most, each in order for those that add up), the defaults filled
in, and the problems met: lines that do not read, `Match` criteria this
client cannot judge (`exec`, `localnetwork`). -}
type alias Settings =
    { values : Dict String (Array String), problems : Array String }


multi : Array String
multi =
    [ "identityfile", "certificatefile", "sendenv", "localforward", "remoteforward", "dynamicforward" ]


type alias Reading =
    { values : Dict String (Array String)
    , active : Bool
    , final : Bool
    , wantsFinal : Bool
    , problems : Array String
    , depth : Int
    }


{-| The settings for a host from the user's directives, then the system's,
reading `Include`s through the source, as OpenSSH does: once, and again
for `Match final` and `Match canonical` if any line asks for them. -}
resolve : Context -> Source -> Array Directive -> Array Directive -> Settings
resolve context source user system =
    let
        pass final values =
            Array.foldl (apply context source)
                { values = values, active = True, final = final, wantsFinal = False, problems = [], depth = 0 }
                (user ++ system)

        first =
            pass False Dict.empty

        whole =
            if first.wantsFinal then
                let
                    again =
                        pass True first.values
                in
                { again | problems = first.problems ++ again.problems }

            else
                first
    in
    { values = defaults context whole.values, problems = whole.problems }


apply : Context -> Source -> Directive -> Reading -> Reading
apply context source d r =
    when d.keyword is
        "host" ->
            -- as typed, case and all (OpenSSH's match_pattern)
            { r | active = hostMatches context.host d.args }

        "match" ->
            let
                judged =
                    matchLine context r d
            in
            { r | active = judged.active, problems = r.problems ++ judged.problems, wantsFinal = r.wantsFinal || judged.wantsFinal }

        "include" ->
            if not r.active then
                r

            else if r.depth >= 16 then
                { r | problems = Array.pushLast (where_ d ++ "Include nested more than 16 deep") r.problems }

            else
                let
                    files =
                        Array.mapAndFlatten (\a -> source (includePath context a)) d.args

                    inner =
                        Array.foldl
                            (\f acc -> Array.foldl (apply context source) { acc | active = True } f.directives)
                            { r | depth = r.depth + 1 }
                            files
                in
                -- what an included file's own Host lines did ends with it
                { inner | active = r.active, depth = r.depth }

        keyword ->
            if not r.active || Array.isEmpty d.args then
                r

            else if Array.member keyword multi then
                { r | values = Dict.update keyword (\old -> Just (Maybe.withDefault [] old ++ d.args)) r.values }

            else if Dict.member keyword r.values then
                r

            else
                { r | values = Dict.set keyword d.args r.values }


where_ : Directive -> String
where_ d =
    d.file ++ ":" ++ String.fromInt d.lineNumber ++ ": "


{-| An `Include`'s path: `~` is the home, and a relative one is under
`~/.ssh`. -}
includePath : Context -> String -> String
includePath context path =
    if String.startsWith "~/" path then
        context.home ++ String.dropFirst 1 path

    else if String.startsWith "/" path then
        path

    else
        context.home ++ "/.ssh/" ++ path


{-| Patterns against a name, case and all: one that matches, and no `!` one
that does. -}
hostMatches : String -> Array String -> Bool
hostMatches host patterns =
    Array.any (\p -> not (String.startsWith "!" p) && glob p host) patterns
        && not (Array.any (\p -> String.startsWith "!" p && glob (String.dropFirst 1 p) host) patterns)


{-| A `Match` line, its criteria all to hold: `all`, `canonical` and
`final` (on the second pass only), `host` (the HostName set so far, or the
host), `originalhost`, `user` (the User set so far, or the local user),
`localuser`, `tagged`; each may be negated with `!`. `exec` and
`localnetwork` this client cannot judge: they do not hold, and say so. -}
matchLine : Context -> Reading -> Directive -> { active : Bool, problems : Array String, wantsFinal : Bool }
matchLine context r d =
    let
        hostSoFar =
            Dict.get "hostname" r.values
                |> Maybe.andThen Array.first
                |> Maybe.map (\h -> expandHost context h)
                |> Maybe.withDefault (String.toLower context.host)

        userSoFar =
            Dict.get "user" r.values |> Maybe.andThen Array.first |> Maybe.withDefault context.localUser

        judge criteria acc =
            when Array.popFirst criteria is
                Nothing ->
                    acc

                Just c ->
                    let
                        negated =
                            String.startsWith "!" c.first

                        name =
                            String.toLower
                                (if negated then
                                    String.dropFirst 1 c.first

                                 else
                                    c.first
                                )

                        argument =
                            Array.first c.rest |> Maybe.withDefault ""

                        withArgument held =
                            judge (Array.dropFirst 1 c.rest)
                                { acc | holds = acc.holds && (held /= negated) }

                        -- unlike Host's, without regard to case (OpenSSH's
                        -- match_cfg_line lowers both)
                        patternsHold value =
                            hostMatches (String.toLower value) (String.split "," (String.toLower argument))
                    in
                    when name is
                        "all" ->
                            judge c.rest { acc | holds = acc.holds && not negated }

                        "canonical" ->
                            judge c.rest { acc | holds = acc.holds && (r.final /= negated), wantsFinal = True }

                        "final" ->
                            judge c.rest { acc | holds = acc.holds && (r.final /= negated), wantsFinal = True }

                        "host" ->
                            withArgument (patternsHold hostSoFar)

                        "originalhost" ->
                            withArgument (patternsHold context.host)

                        "user" ->
                            withArgument (patternsHold userSoFar)

                        "localuser" ->
                            withArgument (patternsHold context.localUser)

                        "tagged" ->
                            withArgument (patternsHold (Dict.get "tag" r.values |> Maybe.andThen Array.first |> Maybe.withDefault ""))

                        _ ->
                            judge (Array.dropFirst 1 c.rest)
                                { acc
                                    | holds = False
                                    , problems = Array.pushLast (where_ d ++ "Match " ++ name ++ " is not judged here; the block is left out") acc.problems
                                }

        judged =
            judge d.args { holds = True, problems = [], wantsFinal = False }
    in
    { active = judged.holds, problems = judged.problems, wantsFinal = judged.wantsFinal }


{-| `HostName`'s `%h` (the host as typed, in lower case) and `%%`. -}
expandHost : Context -> String -> String
expandHost context value =
    String.toLower (String.replace "%h" (String.toLower context.host) (String.replace "%%" "%" value))


glob : String -> String -> Bool
glob pattern name =
    globFrom (String.toArray pattern) (String.toArray name)


globFrom : Array Char -> Array Char -> Bool
globFrom pattern name =
    when Array.popFirst pattern is
        Nothing ->
            Array.isEmpty name

        Just p ->
            if p.first == '*' then
                globFrom p.rest name
                    || (when Array.popFirst name is
                            Just n ->
                                globFrom pattern n.rest

                            Nothing ->
                                False
                       )

            else
                when Array.popFirst name is
                    Just n ->
                        (p.first == '?' || p.first == n.first) && globFrom p.rest n.rest

                    Nothing ->
                        False


{-| What OpenSSH fills in for what no line set. -}
defaults : Context -> Dict String (Array String) -> Dict String (Array String)
defaults context values =
    let
        orDefault key value d =
            if Dict.member key d then
                d

            else
                Dict.set key value d

        withHost =
            Dict.set "hostname"
                [ Dict.get "hostname" values |> Maybe.andThen Array.first |> Maybe.map (expandHost context) |> Maybe.withDefault (String.toLower context.host) ]
                values

        filled =
            withHost
                |> orDefault "user" [ context.localUser ]
                |> orDefault "port" [ "22" ]
                |> orDefault "identityfile" (Array.map (\n -> "~/.ssh/" ++ n) [ "id_rsa", "id_ecdsa", "id_ecdsa_sk", "id_ed25519", "id_ed25519_sk", "id_xmss", "id_dsa" ])
                |> orDefault "userknownhostsfile" [ "~/.ssh/known_hosts", "~/.ssh/known_hosts2" ]
    in
    filled
        |> Dict.update "userknownhostsfile" (Maybe.map (Array.mapAndFlatten String.words >> Array.map (expandPath context filled)))
        |> Dict.update "remotecommand" (Maybe.map (\command -> [ expandTokens context filled (String.join " " command) ]))


{-| A path's `~` and its tokens. -}
expandPath : Context -> Dict String (Array String) -> String -> String
expandPath context values path =
    expandTokens context
        values
        (if String.startsWith "~/" path then
            context.home ++ String.dropFirst 1 path

         else
            path
        )


{-| The tokens a known-hosts file and a remote command take (ssh_config(5),
TOKENS): `%h` the host name, `%n` the host as typed, `%p` the port, `%r`
the remote user, `%u` the local user, `%d` the home, `%%`. Another is left
as it is. -}
expandTokens : Context -> Dict String (Array String) -> String -> String
expandTokens context values text =
    let
        one key =
            Dict.get key values |> Maybe.andThen Array.first |> Maybe.withDefault ""
    in
    tokensIn
        (Dict.empty
            |> Dict.set 'h' (one "hostname")
            |> Dict.set 'n' context.host
            |> Dict.set 'p' (one "port")
            |> Dict.set 'r' (one "user")
            |> Dict.set 'u' context.localUser
            |> Dict.set 'd' context.home
            |> Dict.set '%' "%"
        )
        (String.toArray text)
        ""


tokensIn : Dict Char String -> Array Char -> String -> String
tokensIn table chars acc =
    when Array.popFirst chars is
        Nothing ->
            acc

        Just c ->
            if c.first == '%' then
                when Array.popFirst c.rest is
                    Just t ->
                        tokensIn table t.rest (acc ++ (Dict.get t.first table |> Maybe.withDefault ("%" ++ String.fromChar t.first)))

                    Nothing ->
                        acc ++ "%"

            else
                tokensIn table c.rest (acc ++ String.fromChar c.first)


{-| The settings as `ssh -G` prints them, for the keywords this client
acts on: `keyword value`, one line a value for those that add up and for
`SetEnv`'s. -}
toLines : Settings -> Array String
toLines settings =
    let
        get key =
            Dict.get key settings.values

        one key normalize fallback =
            [ key ++ " " ++ (get key |> Maybe.andThen Array.first |> Maybe.map (normalize << String.toLower) |> Maybe.withDefault fallback) ]

        raw key =
            when get key is
                Just values ->
                    [ key ++ " " ++ String.join " " values ]

                Nothing ->
                    []

        each key =
            get key |> Maybe.withDefault [] |> Array.map (\v -> key ++ " " ++ v)

        yesNo v =
            if v == "yes" || v == "true" then
                "yes"

            else if v == "no" || v == "false" then
                "no"

            else
                v

        trueFalse v =
            if v == "yes" || v == "true" then
                "true"

            else if v == "no" || v == "false" then
                "false"

            else
                v

        strict v =
            if v == "yes" || v == "true" then
                "true"

            else if v == "no" || v == "off" || v == "false" then
                "false"

            else
                v
    in
    [ raw "user"
    , raw "hostname"
    , raw "port"
    , one "identitiesonly" yesNo "no"
    , one "requesttty" trueFalse "auto"
    , one "stricthostkeychecking" strict "ask"
    , one "serveralivecountmax" identity "3"
    , one "serveraliveinterval" identity "0"
    , raw "remotecommand"
    , raw "hostkeyalias"
    , each "identityfile"
    , [ "userknownhostsfile " ++ String.join " " (get "userknownhostsfile" |> Maybe.withDefault []) ]
    , each "sendenv"
    , each "setenv"
    , one "forwardagent" yesNo "no"
    , one "connecttimeout" identity "none"
    , raw "identityagent"
    , raw "proxyjump"
    ]
        |> Array.flatten
