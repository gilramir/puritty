module Main exposing (main)

{-| The transport's test client (puritty `docs/ssh-client.md` SC11 step 4).

    ssh-tests connect HOST PORT [--cipher NAME] [--hostkey NAME] [--rekey] [--seed HEX] [--record FILE]
    ssh-tests replay FILE
    ssh-tests fuzz FILE [FROM] COUNT
    ssh-tests known-hosts FILE
    ssh-tests config FILE
    ssh-tests connection
    ssh-tests login HOST PORT --user NAME [--identity FILE]... [--agent SOCKET] [--passphrase P] [--password P] [--responses A,B] [--rekey]
    ssh-tests session HOST PORT --user NAME [--identity FILE]... [--agent SOCKET] [--agent-pipe PIPE] [--known-hosts FILE] [--strict ask|yes|accept-new|no]
        [--trust | --trust-once] [--passphrase P] [--password P] [--responses A,B] [--exec CMD] [--pty COLS,ROWS] [--stdin TEXT]
        [--exec CMD | --shell] [--pty COLS,ROWS] [--not-utf8] [--env NAME=VALUE] [--stdin TEXT] [--resize COLS,ROWS] [--stdin2 TEXT] [--stdin-bytes N] [--eof] [--hex] [--keepalive]

`connect` makes the exchange with the server, asks for the `ssh-userauth`
service, and asks to authenticate with `none`, whose refusal says the keys
work both ways; then disconnects. With `--rekey` it makes a second
exchange before asking. Each thing that happens is a line. `--cipher` and
`--hostkey` offer only that one; `--seed` fixes the random bytes;
`--record` writes the seed, every read and every write to FILE.

`replay` runs a recorded session again with no connection: the same seed
and the same reads must give the same writes and the same lines.

`fuzz` replays a recorded session COUNT times, each time with the server's
bytes changed: one to four bytes set to others, a run cut out, or the reads
split at other places. It counts how each run ended: as the recording did,
with a failure the transport reported, or waiting for more. A crash ends
the program, which is the failure this looks for; so is a run that says
something after it has failed.
-}

import Bitwise
import Bytes exposing (Bytes)
import Console
import Dict
import Expect
import Int64
import Os.Env
import Os.Error
import Os.File as File
import Os.Net as Net
import Os.Path as Path
import Os.Process as OsProcess
import Os.Random
import Process
import SftpDrive
import ShellDrive
import Source exposing (Source)
import Ssh.Agent as Agent
import Ssh.Auth as Auth
import Ssh.Config as Config
import Ssh.Connection as Connection
import Ssh.KnownHosts as KnownHosts
import Ssh.Session as Session
import Ssh.Sftp as Sftp
import Ssh.ShellTransfer as ShellTransfer
import Ssh.Transfer as Transfer
import Ssh.Transport as Transport exposing (Event(..), Transport)
import Ssh.Wire as Wire
import SshCrypto
import Task exposing (Task)
import Test.Runner.UnitNode as U
import Test.Runner.UnitNode.Program as Program
import TransferDrive
import UInt8


main : Task Never {}
main =
    Task.map3 (\env fs net -> { args = env.args, fs = fs, net = net }) Os.Env.getEnvironment File.initialize Net.initialize
        |> Task.andThen
            (\r ->
                when Array.first r.args is
                    Just "known-hosts" ->
                        cases knownHostsSuite r

                    Just "config" ->
                        cases configSuite r

                    Just "connection" ->
                        suites (Array.dropFirst 1 r.args) r [ connectionSuite ]

                    Just "sftp" ->
                        suites (Array.dropFirst 1 r.args) r [ sftpSuite ]

                    Just "sftp-local" ->
                        -- ssh-tests sftp-local SFTP-SERVER DIR [SIZE PIECE MOST]
                        sftpLocal r

                    Just "transfer-local" ->
                        -- ssh-tests transfer-local SFTP-SERVER [OPTIONS] JOB...
                        -- (TransferDrive, docs/sftp.md FT17)
                        when Array.get 1 r.args is
                            Just server ->
                                Os.Env.getEnvironment
                                    |> Task.andThen (\env -> sftpChild server (\link -> TransferDrive.run r.fs link (TransferDrive.argsOf (Array.dropFirst 2 env.argsAsBytes))))

                            Nothing ->
                                say "usage: ssh-tests transfer-local SFTP-SERVER [OPTIONS] JOB..."

                    _ ->
                        when afterWord "connect" r.args is
                            [ host, port ] ->
                                connect r { host = host, port = String.toInt port |> Maybe.withDefault 22 }

                            _ ->
                                when afterWord "replay" r.args is
                                    [ file ] ->
                                        replay r.fs file

                                    _ ->
                                        configOrMore r
            )


{-| A file of cases (`known-hosts FILE`, `config FILE`) run as a suite by
gren-unit-node's native runner, a test for each case; the arguments after
the file are the runner's (a glob, `-v`, `--list`, `--junit-xml PATH`). -}
cases : (String -> U.Suite) -> { args : Array String, fs : File.Permission, net : Net.Permission } -> Task Never {}
cases suiteFor r =
    when Array.get 1 r.args is
        Just file ->
            let
                rest =
                    Array.dropFirst 2 r.args
            in
            File.readFile r.fs (Path.fromString file)
                |> Task.onError (\e -> Console.write ("failed: " ++ Os.Error.toString e ++ "\n") |> Task.andThen (\_ -> Os.Env.exitWithCode 1))
                |> Task.andThen
                    (\text -> suites rest r [ suiteFor (Bytes.toStringLossy text) ])

        Nothing ->
            fuzzOrUsage r


{-| Suites run by gren-unit-node's native runner, with the runner's
arguments. -}
suites : Array String -> { args : Array String, fs : File.Permission, net : Net.Permission } -> Array U.Suite -> Task Never {}
suites rest r these =
    Program.runWith { args = rest, argsAsBytes = Array.map Bytes.fromString rest }
        { name = "ssh-tests"
        , version = "0.1.0"
        , init = Task.succeed {}
        , fileSystem = \_ -> Just r.fs
        , globalSetUp = \_ -> Task.succeed {}
        , globalTearDown = \_ -> Task.succeed {}
        , suites = \_ -> these
        }


{-| The connection protocol fed a server's messages with no server
(`docs/ssh-client.md` SC27): a channel opened, confirmed, then a message
about it that does not read, which ends the session, as an unreadable
confirmation does, rather than being dropped. -}
connectionSuite : U.Suite
connectionSuite =
    let
        -- a direct channel, confirmed by the server: its channel 7, a
        -- window of 1 MiB and packets of 32 KiB
        opened =
            Connection.openDirect { host = "h", port = 22 }
                |> .connection
                |> Connection.received (Bytes.flatten [ Wire.writeByte 91, Wire.writeUint32 0, Wire.writeUint32 7, Wire.writeUint32 1048576, Wire.writeUint32 32768 ])

        after payload =
            Connection.received payload opened.connection

        refused events =
            Array.any
                (\e ->
                    when e is
                        Connection.Refused _ ->
                            True

                        _ ->
                            False
                )
                events

        ends name payload =
            caseTest name
                (\_ ->
                    let
                        step =
                            after payload
                    in
                    if refused step.events && Array.member Connection.Ended step.events then
                        Nothing

                    else
                        Just ("the session went on: " ++ String.fromInt (Array.length step.events) ++ " events")
                )

        -- a string that says 100 bytes and has 3
        short =
            Bytes.flatten [ Wire.writeUint32 100, Bytes.fromString "abc" ]
    in
    suiteOf "Connection"
        [ caseTest "confirmed"
            (\_ ->
                if Array.member Connection.Started opened.events then
                    Nothing

                else
                    Just "the confirmation did not start the channel"
            )
        , caseTest "data that reads is output"
            (\_ ->
                if Array.member (Connection.Output (Bytes.fromString "abc")) (after (Bytes.flatten [ Wire.writeByte 94, Wire.writeUint32 0, Wire.writeString (Bytes.fromString "abc") ])).events then
                    Nothing

                else
                    Just "no output"
            )
        , ends "data that does not read" (Bytes.flatten [ Wire.writeByte 94, Wire.writeUint32 0, short ])
        , ends "extended data that does not read" (Bytes.flatten [ Wire.writeByte 95, Wire.writeUint32 0, Wire.writeUint32 1, short ])
        , ends "a window adjustment that does not read" (Bytes.flatten [ Wire.writeByte 93, Wire.writeUint32 0, Wire.writeByte 1 ])
        , caseTest "a side channel's bad data closes only it"
            (\_ ->
                let
                    -- an exec channel beside it, number 1, the server's 9,
                    -- confirmed and its command started
                    side =
                        Connection.openExec (Bytes.fromString "true") opened.connection

                    confirmed =
                        Connection.received (Bytes.flatten [ Wire.writeByte 91, Wire.writeUint32 1, Wire.writeUint32 9, Wire.writeUint32 1048576, Wire.writeUint32 32768 ]) side.step.connection

                    started =
                        Connection.received (Bytes.flatten [ Wire.writeByte 99, Wire.writeUint32 1 ]) confirmed.connection

                    bad =
                        Connection.received (Bytes.flatten [ Wire.writeByte 94, Wire.writeUint32 1, short ]) started.connection

                    sideEvents =
                        Array.map .event bad.side

                    stillMain =
                        Connection.received (Bytes.flatten [ Wire.writeByte 94, Wire.writeUint32 0, Wire.writeString (Bytes.fromString "abc") ]) bad.connection
                in
                if side.channel /= 1 then
                    Just "the side channel is not number 1"

                else if not (Array.member Connection.Started (Array.map .event started.side)) then
                    Just "the side channel did not start"

                else if not (refused sideEvents && Array.member Connection.Ended sideEvents) then
                    Just "the side channel went on"

                else if not (Array.isEmpty bad.events) then
                    Just "the session was told of the side channel's data"

                else if not (Array.member (Connection.Output (Bytes.fromString "abc")) stillMain.events) then
                    Just "the session stopped"

                else
                    Nothing
            )
        , caseTest "a side channel's data waits for a pump"
            (\_ ->
                let
                    side =
                        Connection.openExec (Bytes.fromString "cat") opened.connection

                    confirmed =
                        Connection.received (Bytes.flatten [ Wire.writeByte 91, Wire.writeUint32 1, Wire.writeUint32 9, Wire.writeUint32 1048576, Wire.writeUint32 32768 ]) side.step.connection

                    started =
                        Connection.received (Bytes.flatten [ Wire.writeByte 99, Wire.writeUint32 1 ]) confirmed.connection

                    written =
                        Connection.writeSide 1 (Bytes.fromString (String.repeat 100000 "x")) started.connection

                    pumped =
                        Connection.pump 32768 written.connection
                in
                if not (Array.isEmpty written.send) then
                    Just "a side channel's write was sent before a pump"

                else if Array.length pumped.send /= 1 then
                    Just ("a pump of 32 KiB sent " ++ String.fromInt (Array.length pumped.send) ++ " packets")

                else if Connection.sideWaiting pumped.connection <= 0 then
                    Just "nothing waits after one pump of 100,000 bytes"

                else
                    Nothing
            )
        , caseTest "a side channel's writes go in order, each pump saying what waits"
            (\_ ->
                let
                    side =
                        Connection.openExec (Bytes.fromString "cat") opened.connection

                    confirmed =
                        Connection.received (Bytes.flatten [ Wire.writeByte 91, Wire.writeUint32 1, Wire.writeUint32 9, Wire.writeUint32 1048576, Wire.writeUint32 32768 ]) side.step.connection

                    started =
                        Connection.received (Bytes.flatten [ Wire.writeByte 99, Wire.writeUint32 1 ]) confirmed.connection

                    -- three writes, the first pump's packet across the
                    -- first two (FT17: what waits is kept in pieces)
                    pieces =
                        [ String.repeat 20000 "a", String.repeat 20000 "b", String.repeat 80000 "c" ]

                    written =
                        Array.foldl (\t conn -> (Connection.writeSide 1 (Bytes.fromString t) conn).connection) started.connection pieces

                    first =
                        Connection.pump 32768 written

                    rest =
                        Connection.pump 1000000 first.connection

                    -- a data packet's payload: its type, the server's
                    -- channel, then the bytes as a string
                    data packet =
                        Bytes.slice 9 (Bytes.length packet) packet

                    sentOf step =
                        Array.mapAndKeepJust
                            (\e ->
                                when e.event is
                                    Connection.Sent n ->
                                        Just n

                                    _ ->
                                        Nothing
                            )
                            step.side
                in
                if Bytes.flatten (Array.map data first.send) /= Bytes.fromString (String.repeat 20000 "a" ++ String.repeat 12768 "b") then
                    Just "the first pump did not send the first 32 KiB in order"

                else if sentOf first /= [ 87232 ] then
                    Just ("the first pump said " ++ String.join ", " (Array.map String.fromInt (sentOf first)) ++ " wait, not 87232")

                else if Bytes.flatten (Array.map data (first.send ++ rest.send)) /= Bytes.fromString (String.join "" pieces) then
                    Just "the bytes sent are not the bytes written, in order"

                else if sentOf rest /= [ 0 ] then
                    Just ("the last pump said " ++ String.join ", " (Array.map String.fromInt (sentOf rest)) ++ " wait, not 0")

                else
                    Nothing
            )
        ]


{-| `Ssh.Sftp`'s reading of what a server sends, with no server
(docs/sftp.md FT14): packets split and joined as a channel may deliver
them, and the streams it refuses. -}
sftpSuite : U.Suite
sftpSuite =
    let
        pkt kind body =
            Bytes.flatten [ Wire.writeUint32 (Bytes.length body + 1), Wire.writeByte kind, body ]

        version n extensions =
            pkt 2 (Bytes.flatten (Array.pushFirst (Wire.writeUint32 n) extensions))

        posix =
            [ Wire.writeText "posix-rename@openssh.com", Wire.writeText "1" ]

        ready =
            (Sftp.received (version 3 posix) Sftp.start.client).client

        -- an ATTRS answer to request 7: size 2^32 + 5, mode 0644, the
        -- EXTENDED bit with one pair
        attrs =
            pkt 105
                (Bytes.flatten
                    [ Wire.writeUint32 7
                    , Wire.writeUint32 -2147483643
                    , Wire.writeUint64 (Bitwise.shiftLeftBy 32 (Int64.fromInt 1) + Int64.fromInt 5)
                    , Wire.writeUint32 420
                    , Wire.writeUint32 1
                    , Wire.writeText "a@b"
                    , Wire.writeText "c"
                    ]
                )

        status id code =
            pkt 101 (Bytes.flatten [ Wire.writeUint32 id, Wire.writeUint32 code, Wire.writeText "words", Wire.writeText "" ])

        broken events =
            Array.any
                (\e ->
                    when e is
                        Sftp.Broken _ ->
                            True

                        _ ->
                            False
                )
                events

        answers events =
            Array.mapAndFlatten
                (\e ->
                    when e is
                        Sftp.Answer a ->
                            [ a.id ]

                        _ ->
                            []
                )
                events

        -- ShellTransfer (docs/sftp.md FT18): one upload of 1 MiB to a
        -- host where nothing is in the way, its look at the target over
        shell =
            let
                s0 =
                    ShellTransfer.start { piece = 32768, ahead = 131072, ref = 10 }
                        [ Transfer.Upload { local = Path.fromString "x", size = Int64.fromInt 1048576, mtime = Nothing, dir = Bytes.fromString "/d", name = Bytes.fromString "n" } ]

                tell ref event t =
                    ShellTransfer.told { ref = ref, event = event } t
            in
            s0.transfer
                |> tell 10 (Connection.Output (Bytes.fromString "0 -\n"))
                |> .transfer
                |> tell 10 (Connection.Exited 0)
                |> .transfer
                |> tell 10 Connection.Ended

        reads step =
            Array.length step.local

        readAll step =
            Array.foldl
                (\l acc ->
                    when l is
                        Transfer.ReadPiece r ->
                            let
                                next =
                                    ShellTransfer.localRead { job = r.job, offset = r.offset, bytes = Bytes.fromString (String.repeat r.length "x") } acc.transfer
                            in
                            { transfer = next.transfer, reads = acc.reads + reads next, writes = acc.writes + Array.length next.channel }

                        _ ->
                            acc
                )
                { transfer = step.transfer, reads = 0, writes = 0 }
                step.local
    in
    suiteOf "Sftp"
        [ caseTest "the shell's upload reads ahead only so far, and more as its queue empties"
            (\_ ->
                let
                    started =
                        ShellTransfer.told { ref = 11, event = Connection.Started } shell.transfer

                    written =
                        readAll started

                    drained =
                        ShellTransfer.told { ref = 11, event = Connection.Sent 0 } written.transfer
                in
                when { opened = shell.channel, counts = [ reads started, written.reads, written.writes, reads drained ] } is
                    { opened = [ ShellTransfer.Open { ref = 11 } ], counts = [ 4, 0, 4, 4 ] } ->
                        Nothing

                    r ->
                        Just ("reads and writes: " ++ String.join ", " (Array.map String.fromInt r.counts))
            )
        , caseTest "an EUC-KR name goes into the shell's command as its own bytes"
            (\_ ->
                let
                    -- 한'글.txt in EUC-KR: C7 D1, a quote, B1 DB
                    name =
                        Bytes.flatten [ Bytes.fromUInt8s (Array.map UInt8.fromInt [ 0xC7, 0xD1, 0x27, 0xB1, 0xDB ]), Bytes.fromString ".txt" ]

                    started =
                        ShellTransfer.start { piece = 32768, ahead = 131072, ref = 10 }
                            [ Transfer.Upload { local = Path.fromString "x", size = Int64.fromInt 1, mtime = Nothing, dir = Bytes.fromString "/d", name = name } ]

                    has needle hay =
                        Array.any (\at -> Bytes.slice at (at + Bytes.length needle) hay == needle) (Array.range 0 (Bytes.length hay - Bytes.length needle))

                    -- the quote, escaped by the script's quotes and again
                    -- by sh -c's
                    escaped =
                        Bytes.flatten [ Bytes.fromUInt8s (Array.map UInt8.fromInt [ 0xC7, 0xD1 ]), Bytes.fromString "'\\''\\'\\'''\\''", Bytes.fromUInt8s (Array.map UInt8.fromInt [ 0xB1, 0xDB ]) ]
                in
                when started.channel is
                    [ ShellTransfer.Open o ] ->
                        if Bytes.toString o.command /= Nothing then
                            Just "the command was made UTF-8"

                        else if has escaped o.command then
                            Nothing

                        else
                            Just ("the name's bytes and quote are not in the command as the shell needs: " ++ Bytes.toStringLossy o.command)

                    _ ->
                        Just "the look at the target was not opened"
            )
        , caseTest "the shell's upload cancelled while its command opens is closed once it starts"
            (\_ ->
                let
                    cancelled =
                        ShellTransfer.cancel shell.transfer

                    started =
                        ShellTransfer.told { ref = 11, event = Connection.Started } cancelled.transfer

                    ended =
                        ShellTransfer.told { ref = 11, event = Connection.Ended } started.transfer
                in
                when { early = cancelled.channel, closed = started.channel, events = ended.events } is
                    { early = [], closed = [ ShellTransfer.Close 11 ], events = [ Transfer.Finished { done = 0, skipped = 1, failed = 0, cancelled = True } ] } ->
                        Nothing

                    _ ->
                        Just "the command was not closed once, after it started, with the batch then cancelled"
            )
        , caseTest "the version, and posix-rename used for a rename"
            (\_ ->
                let
                    r =
                        Sftp.request (Sftp.Rename { from = Bytes.fromString "a", to = Bytes.fromString "b" }) ready
                in
                -- type 200, EXTENDED, after the length
                if Bytes.get 4 r.send == Just (UInt8.fromInt 200) then
                    Nothing

                else
                    Just "a rename was not posix-rename@openssh.com"
            )
        , caseTest "a packet split in two reads"
            (\_ ->
                let
                    whole =
                        status 3 0

                    first =
                        Sftp.received (Bytes.slice 0 6 whole) ready

                    second =
                        Sftp.received (Bytes.slice 6 (Bytes.length whole) whole) first.client
                in
                if Array.isEmpty first.events && answers second.events == [ 3 ] then
                    Nothing

                else
                    Just "the split packet was not read once whole"
            )
        , caseTest "two packets in one read"
            (\_ ->
                if answers (Sftp.received (Bytes.flatten [ status 1 0, status 2 1 ]) ready).events == [ 1, 2 ] then
                    Nothing

                else
                    Just "both answers were not read"
            )
        , caseTest "64-bit sizes and the EXTENDED bit"
            (\_ ->
                when (Sftp.received attrs ready).events is
                    [ Sftp.Answer { id = 7, response = Sftp.Attributes a } ] ->
                        if a.size == Just (Bitwise.shiftLeftBy 32 (Int64.fromInt 1) + Int64.fromInt 5) && a.permissions == Just 420 then
                            Nothing

                        else
                            Just "the attributes read wrong"

                    _ ->
                        Just "no attributes"
            )
        , caseTest "an answer before the version"
            (\_ ->
                if broken (Sftp.received (status 1 0) Sftp.start.client).events then
                    Nothing

                else
                    Just "an answer was taken before the version"
            )
        , caseTest "version 4 refused"
            (\_ ->
                if broken (Sftp.received (version 4 []) Sftp.start.client).events then
                    Nothing

                else
                    Just "version 4 was taken"
            )
        , caseTest "a length past 16 MiB"
            (\_ ->
                if broken (Sftp.received (Wire.writeUint32 20000000) ready).events then
                    Nothing

                else
                    Just "a huge length was waited for"
            )
        ]


{-| `Ssh.Sftp` against an `sftp-server` run as a child, over pipes, no
ssh between (docs/sftp.md FT14): every request kind against DIR, or with
SIZE, PIECE and MOST a timed upload and download of SIZE bytes. -}
sftpLocal : { args : Array String, fs : File.Permission, net : Net.Permission } -> Task Never {}
sftpLocal r =
    when Array.dropFirst 1 r.args is
        [ server, dir ] ->
            sftpChild server (\link -> SftpDrive.script link dir)

        [ server, dir, size, piece, most ] ->
            sftpChild server
                (\link ->
                    SftpDrive.transfer link
                        (Bytes.fromString (dir ++ "/transfer"))
                        (String.toInt size |> Maybe.withDefault 0)
                        (String.toInt piece |> Maybe.withDefault 32768)
                        (String.toInt most |> Maybe.withDefault 64)
                )

        _ ->
            say "usage: ssh-tests sftp-local SFTP-SERVER DIR [SIZE PIECE MOST]"


sftpChild : String -> (SftpDrive.Link -> Task String {}) -> Task Never {}
sftpChild server run =
    OsProcess.initialize
        |> Task.andThen (\cp -> OsProcess.spawn cp server [] (OsProcess.defaultSpawnOptions OsProcess.External) |> Task.mapError Os.Error.toString)
        |> Task.andThen
            (\child ->
                when OsProcess.pipes child is
                    Just io ->
                        run
                            { send = \bytes -> File.write bytes io.input |> Task.mapError Os.Error.toString, receive = File.read io.output |> Task.mapError Os.Error.toString }
                            |> Task.andThen (\_ -> File.close io.input |> Task.mapError Os.Error.toString)
                            |> Task.andThen (\_ -> OsProcess.waitForExit child)
                            |> Task.andThen (\status -> say ("sftp-server exited, status " ++ String.fromInt status))

                    Nothing ->
                        Task.fail "no pipes"
            )
        |> Task.onError (\why -> say ("failed: " ++ why))


{-| A case's test: it passes, or fails saying how. -}
caseTest : String -> ({} -> Maybe String) -> U.Test {}
caseTest name check =
    U.test name
        (\_ ->
            Task.succeed
                (when check {} is
                    Nothing ->
                        Expect.pass

                    Just why ->
                        Expect.fail why
                )
        )


suiteOf : String -> Array (U.Test {}) -> U.Suite
suiteOf name tests =
    U.suite
        { name = name
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests = tests
        }


configOrMore : { args : Array String, fs : File.Permission, net : Net.Permission } -> Task Never {}
configOrMore r =
    when afterWord "login" r.args is
        [ host, port ] ->
            login r { host = host, port = String.toInt port |> Maybe.withDefault 22 }

        _ ->
            when afterWord "session" r.args is
                [ host, port ] ->
                    sessionMode r { host = host, port = String.toInt port |> Maybe.withDefault 22 }

                _ ->
                    fuzzOrUsage r


fuzzOrUsage : { args : Array String, fs : File.Permission, net : Net.Permission } -> Task Never {}
fuzzOrUsage r =
    when afterWord "fuzz" r.args is
        [ file, count ] ->
            fuzz r.fs file 1 (String.toInt count |> Maybe.withDefault 1000)

        [ file, from, count ] ->
            fuzz r.fs file (String.toInt from |> Maybe.withDefault 1) (String.toInt count |> Maybe.withDefault 1000)

        _ ->
            Console.write "usage: ssh-tests connect HOST PORT [...] | replay FILE | fuzz FILE [FROM] COUNT | known-hosts FILE | config FILE\n"
                |> Task.andThen (\_ -> Os.Env.exitWithCode 2)


{-| The words after `word` up to the first option. -}
afterWord : String -> Array String -> Array String
afterWord word args =
    when Array.findFirst (\a -> a == word) args is
        Just found ->
            Array.dropFirst (found.index + 1) args
                |> takeWhile (\a -> not (String.startsWith "--" a))

        Nothing ->
            []


takeWhile : (a -> Bool) -> Array a -> Array a
takeWhile keep items =
    when Array.findFirst (\a -> not (keep a)) items is
        Just found ->
            Array.takeFirst found.index items

        Nothing ->
            items


option : String -> Array String -> Maybe String
option name args =
    Array.findFirst (\a -> a == name) args
        |> Maybe.andThen (\found -> Array.get (found.index + 1) args)


-- THE DRIVER, the same for a connection and a replay


type Stage
    = FirstKeys
    | ServiceAccept
    | SecondKeys
    | AuthFailure
    | Done


type alias Driver =
    { stage : Stage
    , transport : Transport
    , lines : Array String
    , out : Array Bytes
    , rekey : Bool
    }


applyStep : Transport.Step -> Driver -> Driver
applyStep step driver =
    Array.foldl react { driver | transport = step.transport, out = Array.pushLast step.out driver.out } step.events


react : Event -> Driver -> Driver
react event driver =
    let
        line s d =
            { d | lines = Array.pushLast s d.lines }
    in
    when event is
        Banner text ->
            line ("banner: " ++ text) driver

        ServerVersion _ ->
            line "server version received" driver

        HostKey key ->
            line ("host key: " ++ key.algorithm ++ ", signature good") driver

        KeysChanged algorithms ->
            let
                said =
                    line ("keys: " ++ algorithms.kex ++ " " ++ algorithms.hostKey ++ " " ++ algorithms.toServer ++ " " ++ algorithms.toClient) driver
            in
            when driver.stage is
                FirstKeys ->
                    applyStep (Transport.send (Bytes.flatten [ Wire.writeByte 5, Wire.writeText "ssh-userauth" ]) said.transport) { said | stage = ServiceAccept }

                SecondKeys ->
                    applyStep (authNone said.transport) { said | stage = AuthFailure }

                _ ->
                    said

        ExtInfo extensions ->
            line ("ext-info: " ++ String.join "," (Array.map .name extensions)) driver

        Received payload ->
            let
                n =
                    Bytes.get 0 payload |> Maybe.map UInt8.toInt |> Maybe.withDefault -1
            in
            if n == 6 && driver.stage == ServiceAccept then
                if driver.rekey then
                    applyStep (Transport.rekey driver.transport) (line "service accepted; a second exchange" { driver | stage = SecondKeys })

                else
                    applyStep (authNone driver.transport) (line "service accepted" { driver | stage = AuthFailure })

            else if n == 51 && driver.stage == AuthFailure then
                let
                    methods =
                        Wire.reader payload
                            |> Wire.take 1
                            |> Result.andThen (\r -> Wire.nameList r.next)
                            |> Result.map (\m -> String.join "," m.value)
                            |> Result.withDefault "?"
                in
                applyStep (Transport.disconnect 11 "done" driver.transport) (line ("authentication refused; methods: " ++ methods) { driver | stage = Done })

            else
                line ("received message " ++ String.fromInt n) driver

        Closed closed ->
            line ("closed by the server: " ++ String.fromInt closed.code ++ " " ++ closed.description) { driver | stage = Done }

        Failed reason ->
            line ("failed: " ++ reason) { driver | stage = Done }


authNone : Transport -> Transport.Step
authNone transport =
    Transport.send (Bytes.flatten [ Wire.writeByte 50, Wire.writeText "nobody", Wire.writeText "ssh-connection", Wire.writeText "none" ]) transport


{-| A driver whose transport has just started. -}
begin : Bool -> Transport.Config -> Bytes -> Driver
begin rekey config seed =
    let
        started =
            Transport.start config seed
    in
    applyStep started { stage = FirstKeys, transport = started.transport, lines = [], out = [], rekey = rekey }


{-| The lines said so far written, and the bytes to send, taken. -}
drain : Driver -> { driver : Driver, out : Bytes, lines : String }
drain driver =
    { driver = { driver | lines = [], out = [] }
    , out = Bytes.flatten driver.out
    , lines = String.join "" (Array.map (\l -> l ++ "\n") driver.lines)
    }


-- A CONNECTION


connect : { args : Array String, fs : File.Permission, net : Net.Permission } -> { host : String, port : Int } -> Task Never {}
connect r target =
    let
        only name all =
            when option name r.args is
                Just one ->
                    [ one ]

                Nothing ->
                    all

        defaults =
            Transport.defaultConfig

        config =
            { defaults | ciphers = only "--cipher" defaults.ciphers, hostKeys = only "--hostkey" defaults.hostKeys }

        seedTask =
            when option "--seed" r.args is
                Just hex ->
                    Task.succeed (fromHex hex)

                Nothing ->
                    Os.Random.bytes 32
    in
    seedTask
        |> Task.andThen
            (\seed ->
                Net.connect r.net target
                    |> Task.andThen
                        (\socket ->
                            converse socket (begin (Array.member "--rekey" r.args) config seed) { rekey = Array.member "--rekey" r.args, seed = seed, reads = [], writes = [] }
                        )
                    |> Task.andThen
                        (\record ->
                            when option "--record" r.args is
                                Just file ->
                                    File.writeFile r.fs (Bytes.fromString (recording record)) (Path.fromString file)

                                Nothing ->
                                    Task.succeed {}
                        )
            )
        |> Task.onError (\e -> Console.write ("failed: " ++ Os.Error.toString e ++ "\n") |> Task.andThen (\_ -> Os.Env.exitWithCode 1))


type alias Record =
    { rekey : Bool, seed : Bytes, reads : Array Bytes, writes : Array Bytes }


converse : Net.Socket -> Driver -> Record -> Task Os.Error.Error Record
converse socket driver record =
    let
        drained =
            drain driver

        written =
            { record | writes = Array.pushLast drained.out record.writes }
    in
    Console.write drained.lines
        |> Task.andThen
            (\_ ->
                if Bytes.isEmpty drained.out then
                    Task.succeed {}

                else
                    Net.write drained.out socket
            )
        |> Task.andThen
            (\_ ->
                if drained.driver.stage == Done then
                    Net.close socket |> Task.map (\_ -> written)

                else
                    Net.read socket
                        |> Task.andThen
                            (\chunk ->
                                if Bytes.isEmpty chunk then
                                    Console.write "the connection closed\n" |> Task.andThen (\_ -> Net.close socket) |> Task.map (\_ -> written)

                                else
                                    converse socket (applyStep (Transport.receive chunk drained.driver.transport) drained.driver) { written | reads = Array.pushLast chunk written.reads }
                            )
            )


recording : Record -> String
recording record =
    String.join ""
        [ (if record.rekey then
            "rekey\n"

           else
            ""
          )
        , "seed " ++ toHex record.seed ++ "\n"
        , String.join "" (Array.map (\b -> "in " ++ toHex b ++ "\n") record.reads)
        , "out " ++ toHex (Bytes.flatten record.writes) ++ "\n"
        ]


-- A REPLAY


replay : File.Permission -> String -> Task Never {}
replay fs file =
    File.readFile fs (Path.fromString file)
        |> Task.andThen
            (\text ->
                let
                    lines =
                        String.lines (Bytes.toStringLossy text)

                    field word =
                        Array.keepIf (\l -> String.startsWith (word ++ " ") l) lines
                            |> Array.map (\l -> fromHex (String.dropFirst (String.count word + 1) l))

                    seed =
                        field "seed" |> Array.first |> Maybe.withDefault Bytes.empty

                    wanted =
                        field "out" |> Array.first |> Maybe.withDefault Bytes.empty

                    config =
                        configOf seed

                    started =
                        begin (Array.member "rekey" lines) config seed

                    ended =
                        Array.foldl (\chunk d -> applyStep (Transport.receive chunk d.transport) d) started (field "in")

                    got =
                        Bytes.flatten ended.out
                in
                Console.write (String.join "" (Array.map (\l -> l ++ "\n") ended.lines))
                    |> Task.andThen
                        (\_ ->
                            if got == wanted then
                                Console.write ("replay: the same " ++ String.fromInt (Bytes.length got) ++ " bytes written\n")

                            else
                                Console.write ("replay: DIFFERENT, " ++ String.fromInt (Bytes.length got) ++ " bytes written against " ++ String.fromInt (Bytes.length wanted) ++ "\n")
                                    |> Task.andThen (\_ -> Os.Env.exitWithCode 1)
                        )
            )
        |> Task.onError (\e -> Console.write ("failed: " ++ Os.Error.toString e ++ "\n") |> Task.andThen (\_ -> Os.Env.exitWithCode 1))


{-| A replay's config: the default, as a recording is made with no
`--cipher` or `--hostkey`. -}
configOf : Bytes -> Transport.Config
configOf _ =
    Transport.defaultConfig


-- HEX


toHex : Bytes -> String
toHex b =
    Bytes.toHexString { padding = False } b


fromHex : String -> Bytes
fromHex s =
    let
        digit c =
            let
                n =
                    Char.toCode c
            in
            if n >= 48 && n <= 57 then
                n - 48

            else if n >= 97 && n <= 102 then
                n - 87

            else if n >= 65 && n <= 70 then
                n - 55

            else
                0

        chars =
            String.toArray s
    in
    Array.range 0 (Array.length chars // 2 - 1)
        |> Array.map
            (\i ->
                UInt8.fromIntWrap
                    (16 * (Array.get (2 * i) chars |> Maybe.map digit |> Maybe.withDefault 0)
                        + (Array.get (2 * i + 1) chars |> Maybe.map digit |> Maybe.withDefault 0)
                    )
            )
        |> Bytes.fromUInt8s


-- FUZZ


type alias Fuzzed =
    { same : Int, failed : Int, waiting : Int, wrong : Int }


fuzz : File.Permission -> String -> Int -> Int -> Task Never {}
fuzz fs file from count =
    File.readFile fs (Path.fromString file)
        |> Task.andThen
            (\text ->
                let
                    lines =
                        String.lines (Bytes.toStringLossy text)

                    field word =
                        Array.keepIf (\l -> String.startsWith (word ++ " ") l) lines
                            |> Array.map (\l -> fromHex (String.dropFirst (String.count word + 1) l))

                    seed =
                        field "seed" |> Array.first |> Maybe.withDefault Bytes.empty

                    reads =
                        Bytes.flatten (field "in")

                    rekey =
                        Array.member "rekey" lines

                    tally =
                        Array.foldl (\i t -> fuzzOne rekey seed reads i t) { same = 0, failed = 0, waiting = 0, wrong = 0 } (Array.range from count)
                in
                Console.write
                    ("fuzz: "
                        ++ String.fromInt count
                        ++ " runs: "
                        ++ String.fromInt tally.same
                        ++ " as recorded, "
                        ++ String.fromInt tally.failed
                        ++ " failed, "
                        ++ String.fromInt tally.waiting
                        ++ " waiting, "
                        ++ String.fromInt tally.wrong
                        ++ " said something after failing\n"
                    )
                    |> Task.andThen
                        (\_ ->
                            if tally.wrong > 0 then
                                Os.Env.exitWithCode 1

                            else
                                Task.succeed {}
                        )
            )
        |> Task.onError (\e -> Console.write ("failed: " ++ Os.Error.toString e ++ "\n") |> Task.andThen (\_ -> Os.Env.exitWithCode 1))


{-| A run with the reads changed by run `i`'s own pseudo-random choices. -}
fuzzOne : Bool -> Bytes -> Bytes -> Int -> Fuzzed -> Fuzzed
fuzzOne rekey seed reads i tally =
    let
        n =
            Bytes.length reads

        -- a small generator of its own, so each run is the same every time
        pick k bound =
            modBy (max 1 bound) (Bitwise.and 2147483647 ((i * 1103515245 + k * 12345 + i * k * 1597334677) // 7))

        changed =
            when modBy 3 i is
                0 ->
                    -- one to four bytes set to others
                    Array.foldl
                        (\k b ->
                            let
                                at =
                                    pick k n
                            in
                            Bytes.flatten [ Bytes.slice 0 at b, Wire.bytesOf [ pick (k + 7) 256 ], Bytes.slice (at + 1) n b ]
                        )
                        reads
                        (Array.range 1 (1 + pick 99 4))

                1 ->
                    -- a run of bytes cut out
                    let
                        at =
                            pick 1 n
                    in
                    Bytes.flatten [ Bytes.slice 0 at reads, Bytes.slice (at + 1 + pick 2 64) n reads ]

                _ ->
                    reads

        -- the reads in pieces of 1 to 300 bytes
        pieces =
            split (\k -> 1 + pick (k + 31) 300) changed 0 []

        started =
            begin rekey Transport.defaultConfig seed

        ended =
            Array.foldl (\chunk d -> applyStep (Transport.receive chunk d.transport) d) started pieces

        failedAt =
            Array.findFirst (\l -> String.startsWith "failed: " l) ended.lines
    in
    when failedAt is
        Just found ->
            if found.index == Array.length ended.lines - 1 then
                { tally | failed = tally.failed + 1 }

            else
                { tally | wrong = tally.wrong + 1 }

        Nothing ->
            if ended.stage == Done then
                { tally | same = tally.same + 1 }

            else
                { tally | waiting = tally.waiting + 1 }


split : (Int -> Int) -> Bytes -> Int -> Array Bytes -> Array Bytes
split size b k acc =
    if Bytes.isEmpty b then
        acc

    else
        let
            n =
                size k
        in
        split size (Bytes.slice n (Bytes.length b) b) (k + 1) (Array.pushLast (Bytes.slice 0 n b) acc)


-- KNOWN HOSTS


{-| `make-known-hosts.py`'s cases: the lines found for a name, as
`ssh-keygen -F` found them; a key's verdict; the host key algorithms'
order. A test for each, named by its number and its line. -}
knownHostsSuite : String -> U.Suite
knownHostsSuite text =
    let
        caseLines =
            String.lines text

        fieldsOf l =
            String.words l
                |> Array.dropFirst 1
                |> Array.foldl
                    (\w d ->
                        when String.split "=" w is
                            [ k, v ] ->
                                Dict.set k v d

                            _ ->
                                d
                    )
                    Dict.empty

        get f k =
            Dict.get k f |> Maybe.withDefault ""

        parsed =
            Array.findFirst (\l -> String.startsWith "file " l) caseLines
                |> Maybe.map (\found -> KnownHosts.parse (Bytes.toStringLossy (fromHex (String.dropFirst 5 found.value))))
                |> Maybe.withDefault { entries = [], problems = [] }

        entries =
            parsed.entries

        listed s =
            if s == "-" then
                ""

            else
                s

        verdictText v =
            when v is
                KnownHosts.Known ->
                    "Known"

                KnownHosts.Unknown u ->
                    "Unknown:"
                        ++ (if Array.isEmpty u.otherTypes then
                                "-"

                            else
                                String.join "," u.otherTypes
                           )

                KnownHosts.Changed c ->
                    "Changed:" ++ String.join "," (Array.map String.fromInt c.lineNumbers)

                KnownHosts.KeyRevoked ->
                    "KeyRevoked"

        run l =
            let
                f =
                    fieldsOf l

                name =
                    String.toLower (get f "name")
            in
            if String.startsWith "query " l then
                let
                    got =
                        KnownHosts.matching name entries |> Array.map (\e -> String.fromInt e.lineNumber) |> String.join ","
                in
                if got == listed (get f "lines") then
                    Nothing

                else
                    Just (l ++ " -> " ++ got)

            else if String.startsWith "check " l then
                let
                    got =
                        verdictText (KnownHosts.check name (fromHex (get f "key")) entries)
                in
                if got == get f "verdict" then
                    Nothing

                else
                    Just (String.takeFirst 60 l ++ "... " ++ get f "verdict" ++ " -> " ++ got)

            else if String.startsWith "replace " l then
                let
                    file =
                        Array.findFirst (\c -> String.startsWith "file " c) caseLines
                            |> Maybe.map (\found -> Bytes.toStringLossy (fromHex (String.dropFirst 5 found.value)))
                            |> Maybe.withDefault ""

                    r =
                        KnownHosts.replaced name (fromHex (get f "key")) file

                    numbers ns =
                        if Array.isEmpty ns then
                            "-"

                        else
                            String.join "," (Array.map String.fromInt ns)

                    textRight =
                        r.text == Bytes.toStringLossy (fromHex (get f "text"))
                in
                if numbers r.removed == get f "removed" && numbers r.kept == get f "kept" && textRight then
                    Nothing

                else
                    Just
                        (String.takeFirst 40 l
                            ++ "... removed "
                            ++ numbers r.removed
                            ++ " kept "
                            ++ numbers r.kept
                            ++ (if textRight then
                                    ""

                                else
                                    ", the text differs"
                               )
                        )

            else if String.startsWith "order " l then
                let
                    got =
                        String.join "," (KnownHosts.orderHostKeys (KnownHosts.keyTypesFor name entries) Transport.defaultConfig.hostKeys)
                in
                if got == get f "algorithms" then
                    Nothing

                else
                    Just (l ++ " -> " ++ got)

            else
                Nothing

        ran =
            Array.keepIf (\l -> String.startsWith "query " l || String.startsWith "check " l || String.startsWith "order " l || String.startsWith "replace " l) caseLines
    in
    suiteOf "KnownHosts"
        (Array.indexedMap (\n l -> caseTest (String.fromInt (n + 1) ++ " " ++ String.takeFirst 48 l) (\_ -> run l)) ran)


-- SSH_CONFIG


{-| `make-config.py`'s cases: each config resolved for its host, and the
lines held to what `ssh -G` printed, keyword by keyword in order. A test for
each, named by the case. -}
configSuite : String -> U.Suite
configSuite text =
    let
        lines =
            String.lines text

        header word =
            Array.findFirst (\l -> String.startsWith (word ++ " ") l) lines
                |> Maybe.map (\found -> String.dropFirst (String.count word + 1) found.value)
                |> Maybe.withDefault ""

        context host =
            { host = host, localUser = header "localuser", home = header "home" }

        -- the cases, each its case line, files and want line
        configCases =
            Array.foldl
                (\l acc ->
                    if String.startsWith "case " l then
                        Array.pushLast { head = l, files = [], want = "", bad = "" } acc

                    else
                        let
                            n =
                                Array.length acc - 1
                        in
                        when Array.get n acc is
                            Just current ->
                                if String.startsWith "file " l then
                                    Array.set n { current | files = Array.pushLast l current.files } acc

                                else if String.startsWith "bad " l then
                                    Array.set n { current | bad = String.dropFirst 4 l } acc

                                else if String.startsWith "want " l then
                                    Array.set n { current | want = Bytes.toStringLossy (fromHex (String.dropFirst 5 l)) } acc

                                else
                                    acc

                            Nothing ->
                                acc
                )
                []
                lines

        run c =
            let
                words =
                    String.words c.head

                name =
                    Array.get 1 words |> Maybe.withDefault "?"

                host =
                    Array.get 2 words |> Maybe.map (String.dropFirst 5) |> Maybe.withDefault ""

                files =
                    Array.map
                        (\f ->
                            let
                                parts =
                                    String.words f

                                path =
                                    Array.get 1 parts |> Maybe.withDefault ""

                                body =
                                    Array.get 2 parts
                                        |> Maybe.map
                                            (\h ->
                                                if h == "-" then
                                                    ""

                                                else
                                                    Bytes.toStringLossy (fromHex h)
                                            )
                                        |> Maybe.withDefault ""
                            in
                            { path = path, parsed = Config.parse path body }
                        )
                        c.files

                source pattern =
                    Array.keepIf (\f -> pathGlob pattern f.path) files
                        |> Array.map (\f -> { path = f.path, directives = f.parsed.directives })

                main_ =
                    Array.first files |> Maybe.map (\f -> f.parsed.directives) |> Maybe.withDefault []

                resolved =
                    Config.resolve (context host) source main_ []

                got =
                    Config.toLines resolved

                -- the lines the problems name: each bad line's, and no other
                problems =
                    Array.mapAndFlatten (\f -> f.parsed.problems) files ++ resolved.problems

                named =
                    Array.map
                        (\p ->
                            String.split ":" p
                                |> Array.get 1
                                |> Maybe.withDefault ""
                        )
                        problems

                wrongProblems =
                    if (c.bad == "" && Array.isEmpty problems) || (c.bad /= "" && Array.length problems == 1 && named == [ c.bad ]) then
                        []

                    else
                        [ "problems ["
                            ++ String.join " | " problems
                            ++ "] where line "
                            ++ (if c.bad == "" then
                                    "none"

                                else
                                    c.bad
                               )
                            ++ " was wanted"
                        ]

                grouped ls =
                    Array.foldl
                        (\l d ->
                            let
                                key =
                                    String.words l |> Array.first |> Maybe.withDefault ""
                            in
                            Dict.update key (\old -> Just (Array.pushLast l (Maybe.withDefault [] old))) d
                        )
                        Dict.empty
                        ls

                want =
                    grouped (String.lines c.want)

                mine =
                    grouped got

                keys =
                    Dict.keys want ++ Array.keepIf (\k -> not (Dict.member k want)) (Dict.keys mine)

                differ =
                    Array.keepIf (\k -> Dict.get k want /= Dict.get k mine) keys
            in
            if Array.isEmpty differ && Array.isEmpty wrongProblems then
                Nothing

            else
                Just
                    (name
                        ++ ": "
                        ++ String.join "; "
                            (wrongProblems
                                ++ Array.map
                                    (\k ->
                                        k
                                            ++ " wants ["
                                            ++ String.join " | " (Dict.get k want |> Maybe.withDefault [])
                                            ++ "] got ["
                                            ++ String.join " | " (Dict.get k mine |> Maybe.withDefault [])
                                            ++ "]"
                                    )
                                    differ
                            )
                    )

        caseName c =
            String.words c.head |> Array.get 1 |> Maybe.withDefault "?"
    in
    suiteOf "Config" (Array.map (\c -> caseTest (caseName c) (\_ -> run c)) configCases)


{-| A path against an `Include` pattern: `*` and `?` in its last part. -}
pathGlob : String -> String -> Bool
pathGlob pattern path =
    globChars (String.toArray pattern) (String.toArray path)


globChars : Array Char -> Array Char -> Bool
globChars pattern name =
    when Array.popFirst pattern is
        Nothing ->
            Array.isEmpty name

        Just p ->
            if p.first == '*' then
                globChars p.rest name
                    || (when Array.popFirst name is
                            Just n ->
                                n.first /= '/' && globChars pattern n.rest

                            Nothing ->
                                False
                       )

            else
                when Array.popFirst name is
                    Just n ->
                        (p.first == '?' || p.first == n.first) && globChars p.rest n.rest

                    Nothing ->
                        False


-- LOGIN


{-| A connection that logs in (step 6): every transport and authentication
event a line, every request answered from the options. -}
type alias Session =
    { socket : Net.Socket
    , options : Array String
    , fs : File.Permission
    , transport : Transport
    , auth : Maybe Auth.Auth
    , identities : Array { identity : Auth.Identity, file : Maybe Bytes }
    , agent : Maybe Net.Socket
    , connection : Maybe Connection.Connection
    , output : Array Bytes
    , exchanges : Int
    , done : Bool
    }


login : { args : Array String, fs : File.Permission, net : Net.Permission } -> { host : String, port : Int } -> Task Never {}
login r target =
    let
        files =
            Array.indexedMap (\i a -> { index = i, arg = a }) r.args
                |> Array.keepIf (\a -> a.arg == "--identity")
                |> Array.mapAndFlatten (\a -> Array.get (a.index + 1) r.args |> Maybe.map (\f -> [ f ]) |> Maybe.withDefault [])
    in
    files
        |> Array.map (\f -> File.readFile r.fs (Path.fromString f))
        |> Task.sequence
        |> Task.andThen
            (\texts ->
                let
                    identities =
                        Array.indexedMap (\i text -> { i = i, text = text }) texts
                            |> Array.mapAndFlatten
                                (\t ->
                                    when SshCrypto.keyFileInfo t.text is
                                        Just info ->
                                            [ { identity = { id = t.i, publicKey = info.publicKey, keyType = KnownHosts.keyTypeOf info.publicKey }, file = Just t.text } ]

                                        Nothing ->
                                            []
                                )
                in
                agentKeys r
                    |> Task.andThen
                        (\fromAgent ->
                            Os.Random.bytes 32 |> Task.map (\seed -> { seed = seed, agent = fromAgent })
                        )
                    |> Task.andThen
                        (\ready ->
                            let
                                seed =
                                    ready.seed
                            in
                            Net.connect r.net target
                                |> Task.andThen
                                    (\socket ->
                                        let
                                            started =
                                                Transport.start Transport.defaultConfig seed
                                        in
                                        onTransport started
                                            { socket = socket
                                            , options = r.args
                                            , fs = r.fs
                                            , transport = started.transport
                                            , auth = Nothing
                                            , identities = identities ++ ready.agent.identities
                                            , agent = ready.agent.socket
                                            , connection = Nothing
                                            , output = []
                                            , exchanges = 0
                                            , done = False
                                            }
                                            |> Task.andThen readOn
                                    )
                        )
            )
        |> Task.onError (\e -> say ("failed: " ++ Os.Error.toString e) |> Task.andThen (\_ -> Os.Env.exitWithCode 1))


say : String -> Task x {}
say line =
    Console.write (line ++ "\n")


readOn : Session -> Task Os.Error.Error {}
readOn session =
    if session.done then
        Net.close session.socket

    else
        Net.read session.socket
            |> Task.andThen
                (\chunk ->
                    if Bytes.isEmpty chunk then
                        say "the connection closed" |> Task.andThen (\_ -> Net.close session.socket)

                    else
                        onTransport (Transport.receive chunk session.transport) session |> Task.andThen readOn
                )


onTransport : Transport.Step -> Session -> Task Os.Error.Error Session
onTransport step session0 =
    (if Bytes.isEmpty step.out then
        Task.succeed {}

     else
        Net.write step.out session0.socket
    )
        |> Task.andThen
            (\_ ->
                Array.foldl
                    (\event acc -> acc |> Task.andThen (\session -> onEvent event session))
                    (Task.succeed { session0 | transport = step.transport })
                    step.events
            )


onEvent : Event -> Session -> Task Os.Error.Error Session
onEvent event session =
    when event is
        HostKey key ->
            say ("host key: " ++ key.algorithm) |> Task.map (\_ -> session)

        KeysChanged algorithms ->
            let
                counted =
                    { session | exchanges = session.exchanges + 1 }
            in
            if counted.exchanges == 1 then
                say ("keys: " ++ algorithms.toServer)
                    |> Task.andThen
                        (\_ ->
                            let
                                config =
                                    { user = option "--user" session.options |> Maybe.withDefault "nobody"
                                    , identities = Array.map .identity session.identities
                                    , methods = [ "publickey", "keyboard-interactive", "password" ]
                                    , serverSigAlgs = []
                                    , passwordTries = 2
                                    }
                            in
                            onAuth (Auth.begin config (Transport.sessionId counted.transport |> Maybe.withDefault Bytes.empty)) counted
                        )

            else
                say "a new exchange after authentication: done"
                    |> Task.andThen (\_ -> onTransport (Transport.disconnect 11 "done" counted.transport) { counted | done = True })

        ExtInfo extensions ->
            let
                algorithms =
                    Array.findFirst (\x -> x.name == "server-sig-algs") extensions
                        |> Maybe.map (\x -> String.split "," (Bytes.toStringLossy x.value.value))
                        |> Maybe.withDefault []
            in
            Task.succeed { session | auth = Maybe.map (Auth.withServerSigAlgs algorithms) session.auth }

        Received payload ->
            when { auth = session.auth, connection = session.connection } is
                { connection = Just connection } ->
                    if Connection.isConnectionMessage payload then
                        onConnection (Connection.received payload connection) session

                    else
                        say "received another message" |> Task.map (\_ -> session)

                { auth = Just auth } ->
                    if Auth.isAuthMessage payload then
                        onAuth (Auth.received payload auth) session

                    else
                        say "received another message" |> Task.map (\_ -> session)

                _ ->
                    Task.succeed session

        Closed closed ->
            say ("closed by the server: " ++ closed.description) |> Task.map (\_ -> { session | done = True })

        Failed reason ->
            say ("failed: " ++ reason) |> Task.map (\_ -> { session | done = True })

        _ ->
            Task.succeed session


onAuth : Auth.Step -> Session -> Task Os.Error.Error Session
onAuth step session0 =
    let
        withAuth =
            { session0 | auth = Just step.auth }

        sent =
            Array.foldl
                (\payload acc -> acc |> Task.andThen (\session -> onTransport (Transport.send payload session.transport) session))
                (Task.succeed withAuth)
                step.send

        told =
            Array.foldl (\e acc -> acc |> Task.andThen (\session -> onAuthEvent e session)) sent step.events
    in
    Array.foldl (\request acc -> acc |> Task.andThen (\session -> onRequest request session)) told step.requests


onAuthEvent : Auth.Event -> Session -> Task Os.Error.Error Session
onAuthEvent event session =
    when event is
        Auth.Banner text ->
            say ("banner: " ++ String.trim text) |> Task.map (\_ -> session)

        Auth.Refused refused ->
            say ("refused: " ++ refused.method ++ "; the server allows " ++ String.join "," refused.allowed) |> Task.map (\_ -> session)

        Auth.PartialSuccess partial ->
            say ("partial success; the server wants " ++ String.join "," partial.allowed) |> Task.map (\_ -> session)

        Auth.PasswordChange prompt ->
            say ("the server wants a new password: " ++ prompt) |> Task.map (\_ -> session)

        Auth.Authenticated ->
            say "authenticated"
                |> Task.andThen
                    (\_ ->
                        if option "--exec" session.options /= Nothing || Array.member "--shell" session.options then
                            onConnection (Connection.open (sessionOf session.options)) session

                        else if Array.member "--rekey" session.options then
                            onTransport (Transport.rekey session.transport) session

                        else
                            onTransport (Transport.disconnect 11 "done" session.transport) { session | done = True }
                    )

        Auth.Exhausted exhausted ->
            say ("nothing left to try; the server allows " ++ String.join "," exhausted.allowed)
                |> Task.andThen (\_ -> onTransport (Transport.disconnect 14 "no more methods" session.transport) { session | done = True })


onRequest : Auth.Request -> Session -> Task Os.Error.Error Session
onRequest request session =
    let
        continue step =
            onAuth step session
    in
    when { request = request, auth = session.auth } is
        { auth = Nothing } ->
            Task.succeed session

        { request = Auth.NeedSignature need, auth = Just auth } ->
            when Array.findFirst (\i -> i.identity.id == need.id) session.identities is
                Nothing ->
                    continue (Auth.unsigned need.id auth)

                Just found ->
                    say ("the server would take key " ++ String.fromInt need.id ++ "; signing with " ++ need.algorithm)
                        |> Task.andThen
                            (\_ ->
                                when { file = found.value.file, agent = session.agent } is
                                    { file = Nothing, agent = Just socket } ->
                                        agentCall socket (Agent.signRequest { publicKey = found.value.identity.publicKey, data = need.data, algorithm = need.algorithm })
                                            |> Task.map
                                                (\message ->
                                                    when Agent.signature message is
                                                        Ok signature ->
                                                            Auth.signed need.id signature auth

                                                        Err _ ->
                                                            Auth.unsigned need.id auth
                                                )
                                            |> Task.andThen continue

                                    _ ->
                                        signWithFile need auth (Maybe.withDefault Bytes.empty found.value.file) session
                                            |> Task.andThen continue
                            )

        { request = Auth.NeedPassword _, auth = Just auth } ->
            continue (Auth.withPassword (option "--password" session.options) auth)

        { request = Auth.NeedResponses need, auth = Just auth } ->
            say ("prompts: " ++ String.join " | " (Array.map .text need.prompts))
                |> Task.andThen (\_ -> continue (Auth.responses (option "--responses" session.options |> Maybe.map (String.split ",")) auth))


signWithFile : { id : Int, algorithm : String, data : Bytes } -> Auth.Auth -> Bytes -> Session -> Task Os.Error.Error Auth.Step
signWithFile need auth file session =
    SshCrypto.loadKey file (Bytes.fromString (option "--passphrase" session.options |> Maybe.withDefault ""))
        |> Task.andThen
            (\key ->
                SshCrypto.sign key need.algorithm need.data
                    |> Task.andThen (\signature -> SshCrypto.forget key |> Task.map (\_ -> signature))
                    |> Task.onError (\p -> SshCrypto.forget key |> Task.andThen (\_ -> Task.fail p))
            )
        |> Task.map (\signature -> Auth.signed need.id signature auth)
        |> Task.onError (\_ -> say "the key would not load" |> Task.map (\_ -> Auth.unsigned need.id auth))


{-| With `--agent PATH`, the agent's keys, numbered from 100, and its
connection, kept open for its signatures. -}
agentKeys : { args : Array String, fs : File.Permission, net : Net.Permission } -> Task Os.Error.Error { identities : Array { identity : Auth.Identity, file : Maybe Bytes }, socket : Maybe Net.Socket }
agentKeys r =
    when option "--agent" r.args is
        Nothing ->
            Task.succeed { identities = [], socket = Nothing }

        Just path ->
            Net.connectLocal r.net (Path.fromString path)
                |> Task.andThen
                    (\socket ->
                        agentCall socket Agent.requestIdentities
                            |> Task.andThen
                                (\message ->
                                    when Agent.identities message is
                                        Ok keys ->
                                            say ("the agent holds " ++ String.fromInt (Array.length keys) ++ " keys")
                                                |> Task.map
                                                    (\_ ->
                                                        { identities =
                                                            Array.indexedMap
                                                                (\i k -> { identity = { id = 100 + i, publicKey = k.publicKey, keyType = KnownHosts.keyTypeOf k.publicKey }, file = Nothing })
                                                                keys
                                                        , socket = Just socket
                                                        }
                                                    )

                                        Err why ->
                                            say ("the agent: " ++ why) |> Task.map (\_ -> { identities = [], socket = Just socket })
                                )
                    )


{-| A request to the agent, and its whole answer. -}
agentCall : Net.Socket -> Bytes -> Task Os.Error.Error Bytes
agentCall socket request =
    Net.write request socket |> Task.andThen (\_ -> agentRead socket Bytes.empty)


agentRead : Net.Socket -> Bytes -> Task Os.Error.Error Bytes
agentRead socket got =
    when Agent.unframe got is
        Just whole ->
            Task.succeed whole.message

        Nothing ->
            Net.read socket
                |> Task.andThen
                    (\more ->
                        if Bytes.isEmpty more then
                            Task.succeed Bytes.empty

                        else
                            agentRead socket (Bytes.flatten [ got, more ])
                    )


-- THE SESSION


sessionOf : Array String -> Connection.Session
sessionOf options =
    let
        size =
            option "--pty" options
                |> Maybe.map (String.split ",")
                |> Maybe.andThen
                    (\parts ->
                        sizeOf parts
                    )
    in
    { terminal = Maybe.map (\s -> { term = "xterm-256color", columns = s.columns, rows = s.rows, widthInPixels = s.widthInPixels, heightInPixels = s.heightInPixels, utf8 = not (Array.member "--not-utf8" options) }) size
    , env =
        option "--env" options
            |> Maybe.map
                (\e ->
                    when String.split "=" e is
                        [ name, value ] ->
                            [ { name = name, value = value } ]

                        _ ->
                            []
                )
            |> Maybe.withDefault []
    , command = option "--exec" options |> Maybe.map Bytes.fromString
    }


unescape : String -> String
unescape text =
    String.replace "\\n" "\n" text


onConnection : Connection.Step -> Session -> Task Os.Error.Error Session
onConnection step session0 =
    let
        withConnection =
            { session0 | connection = Just step.connection }

        sent =
            Array.foldl
                (\payload acc -> acc |> Task.andThen (\session -> onTransport (Transport.send payload session.transport) session))
                (Task.succeed withConnection)
                step.send
    in
    Array.foldl (\e acc -> acc |> Task.andThen (\session -> onConnectionEvent e session)) sent step.events


{-| Run a connection step on the session's connection, if it has one. -}
withConnectionDo : (Connection.Connection -> Connection.Step) -> Session -> Task Os.Error.Error Session
withConnectionDo f session =
    when session.connection is
        Just connection ->
            onConnection (f connection) session

        Nothing ->
            Task.succeed session


onConnectionEvent : Connection.Event -> Session -> Task Os.Error.Error Session
onConnectionEvent event session =
    when event is
        Connection.Started ->
            let
                options =
                    session.options

                text name =
                    option name options |> Maybe.map (\t -> Bytes.fromString (unescape t))

                bulk =
                    option "--stdin-bytes" options |> Maybe.andThen String.toInt |> Maybe.map (\n -> Bytes.fromString (String.repeat n "x"))

                steps =
                    [ Maybe.map Connection.write (text "--stdin")
                    , Maybe.map Connection.write bulk
                    , option "--resize" options
                        |> Maybe.map (String.split ",")
                        |> Maybe.andThen
                            (\parts -> sizeOf parts |> Maybe.map Connection.resize)
                    , Maybe.map Connection.write (text "--stdin2")
                    , if Array.member "--eof" options then
                        Just Connection.sendEof

                      else
                        Nothing
                    , if Array.member "--keepalive" options then
                        Just Connection.keepalive

                      else
                        Nothing
                    ]
                        |> Array.mapAndFlatten (\m -> Maybe.map (\x -> [ x ]) m |> Maybe.withDefault [])
            in
            say "started"
                |> Task.andThen (\_ -> Array.foldl (\f acc -> acc |> Task.andThen (withConnectionDo f)) (Task.succeed session) steps)

        Connection.Refused why ->
            say ("refused: " ++ why) |> Task.andThen (\_ -> onTransport (Transport.disconnect 11 "done" session.transport) { session | done = True })

        Connection.Output bytes ->
            Task.succeed { session | output = Array.pushLast bytes session.output }

        Connection.ErrorOutput bytes ->
            say ("stderr: " ++ String.trim (Bytes.toStringLossy bytes)) |> Task.map (\_ -> session)

        Connection.Exited status ->
            say ("exit status " ++ String.fromInt status) |> Task.map (\_ -> session)

        Connection.Killed signal ->
            say ("killed by " ++ signal.signal) |> Task.map (\_ -> session)

        Connection.KeepaliveUnanswered n ->
            say ("keepalive sent; " ++ String.fromInt n ++ " unanswered before it") |> Task.map (\_ -> session)

        Connection.Sent _ ->
            Task.succeed session

        Connection.Ended ->
            let
                all =
                    Bytes.flatten session.output

                shown =
                    if Array.member "--hex" session.options then
                        "output (hex): " ++ toHex all

                    else if Bytes.length all > 4096 then
                        "output: " ++ String.fromInt (Bytes.length all) ++ " bytes"

                    else
                        "output: " ++ String.replace "\r" "" (String.trim (Bytes.toStringLossy all))
            in
            say shown
                |> Task.andThen (\_ -> say "the channel closed")
                |> Task.andThen (\_ -> onTransport (Transport.disconnect 11 "done" session.transport) { session | done = True })


-- SSH.SESSION, as the window drives it


sessionMode : { args : Array String, fs : File.Permission, net : Net.Permission } -> { host : String, port : Int } -> Task Never {}
sessionMode r target =
    let
        many name =
            Array.indexedMap (\i a -> { index = i, arg = a }) r.args
                |> Array.keepIf (\a -> a.arg == name)
                |> Array.mapAndFlatten (\a -> Array.get (a.index + 1) r.args |> Maybe.map (\f -> [ f ]) |> Maybe.withDefault [])

        options =
            { host = target.host
            , port = target.port
            , user = option "--user" r.args |> Maybe.withDefault "nobody"
            , identityFiles = many "--identity"
            , identitiesOnly = False
            , agents =
                (option "--agent" r.args |> Maybe.map (\a -> [ Session.LocalSocket a ]) |> Maybe.withDefault [])
                    ++ (option "--agent-pipe" r.args |> Maybe.map (\a -> [ Session.Pipe a ]) |> Maybe.withDefault [])
            , knownHostsFiles = many "--known-hosts"
            , strictHostKeyChecking = option "--strict" r.args |> Maybe.withDefault "ask"
            , hostKeyAlias = Nothing
            , session = sessionOf r.args
            , keepaliveSeconds = 0
            , keepaliveCountMax = 3
            , pacing =
                -- `--pacing UNSENT,PUMP,QUIET_MS,QUIET_UNSENT,QUIET_PUMP`, to
                -- measure another (docs/sftp.md FT17)
                when option "--pacing" r.args |> Maybe.map (String.split "," >> Array.map String.toInt) is
                    Just [ Just unsent, Just pump, Just quietMs, Just quietUnsent, Just quietPump ] ->
                        { unsent = unsent, pump = pump, quietMs = quietMs, quietUnsent = quietUnsent, quietPump = quietPump }

                    _ ->
                        Session.pacing
            }

        -- `--jump HOST:PORT`, again for each hop: the same user, keys and
        -- known hosts as the host's (docs/ssh-client.md SC21)
        jumps =
            many "--jump"
                |> Array.map
                    (\j ->
                        when String.lastIndexOf ":" j is
                            Just colon ->
                                { options | host = String.takeFirst colon j, port = String.toInt (String.dropFirst (colon + 1) j) |> Maybe.withDefault 22, session = { terminal = Nothing, env = [], command = Nothing } }

                            Nothing ->
                                { options | host = j, port = 22, session = { terminal = Nothing, env = [], command = Nothing } }
                    )
    in
    Task.map2 (\notices inputs -> { notices = notices, inputs = inputs }) Source.new Source.new
        |> Task.andThen
            (\sources ->
                Process.spawn (Session.run { net = r.net, fs = r.fs } jumps options sources.notices sources.inputs)
                    |> Task.andThen
                        (\_ ->
                            when option "--sftp" r.args is
                                Just dir ->
                                    sftpOverSession r.args dir sources

                                Nothing ->
                                    when Array.findFirst (\a -> a == "--upload") r.args is
                                        Just found ->
                                            -- `--upload [OPTIONS] JOB...`, the rest of the
                                            -- arguments (ShellDrive, docs/sftp.md FT18)
                                            Os.Env.getEnvironment
                                                |> Task.andThen (\env -> uploadOverSession r.fs (Array.dropFirst (found.index + 1) env.argsAsBytes) sources)

                                        Nothing ->
                                            watch r.args sources { output = [], sides = Dict.empty, open = 0, opened = 0 }
                        )
            )


{-| `--upload …`: once the session has started, `ShellDrive`'s batch,
and the session hung up. -}
uploadOverSession : File.Permission -> Array Bytes -> { notices : Source Session.Notice, inputs : Source Session.Input } -> Task Never {}
uploadOverSession fs args sources =
    untilSessionStarted sources
        |> Task.andThen
            (\started ->
                if started then
                    ShellDrive.run fs sources args
                        |> Task.onError (\why -> say ("failed: " ++ why))
                        |> Task.andThen (\_ -> Source.emit sources.inputs Session.Hangup)

                else
                    Task.succeed {}
            )


untilSessionStarted : { notices : Source Session.Notice, inputs : Source Session.Input } -> Task Never Bool
untilSessionStarted sources =
    Source.next sources.notices
        |> Task.andThen
            (\n ->
                when n is
                    Just Session.Started ->
                        Task.succeed True

                    Just (Session.Failed why) ->
                        say ("failed: " ++ why) |> Task.map (\_ -> False)

                    Just Session.Ended ->
                        Task.succeed False

                    Nothing ->
                        Task.succeed False

                    Just _ ->
                        untilSessionStarted sources
            )


{-| `--sftp DIR`: once the session has started, an `sftp` subsystem on a
channel beside it (docs/sftp.md FT14), and `SftpDrive`'s script over it,
or with `--transfer SIZE,PIECE,MOST` its timed transfer. Questions are
not answered here: the host's key must be known and the key need no
passphrase. -}
sftpOverSession : Array String -> String -> { notices : Source Session.Notice, inputs : Source Session.Input } -> Task Never {}
sftpOverSession args dir sources =
    let
        untilStarted _ =
            Source.next sources.notices
                |> Task.andThen
                    (\n ->
                        when n is
                            Just Session.Started ->
                                Task.succeed True

                            Just (Session.Failed why) ->
                                say ("failed: " ++ why) |> Task.map (\_ -> False)

                            Just Session.Ended ->
                                Task.succeed False

                            Nothing ->
                                Task.succeed False

                            Just _ ->
                                untilStarted {}
                    )

        -- the side channel's output, its end as nothing
        receive _ =
            Source.next sources.notices
                |> Task.andThen
                    (\n ->
                        when n is
                            Just (Session.Side { ref = 1, event = Connection.Output bytes }) ->
                                Task.succeed bytes

                            Just (Session.Side { ref = 1, event = Connection.Ended }) ->
                                Task.succeed Bytes.empty

                            Just (Session.Side { ref = 1, event = Connection.Refused why }) ->
                                say ("the sftp channel was refused: " ++ why) |> Task.map (\_ -> Bytes.empty)

                            Just Session.Ended ->
                                Task.succeed Bytes.empty

                            Nothing ->
                                Task.succeed Bytes.empty

                            Just _ ->
                                receive {}
                    )

        link =
            { send = \bytes -> Source.emit sources.inputs (Session.SideWrite { ref = 1, bytes = bytes }), receive = receive {} }

        run =
            when option "--transfer" args |> Maybe.map (String.split ",") |> Maybe.map (Array.map (\x -> String.toInt x |> Maybe.withDefault 0)) is
                Just [ size, piece, most ] ->
                    SftpDrive.transfer link (Bytes.fromString (dir ++ "/transfer")) size piece most

                _ ->
                    SftpDrive.script link dir
    in
    untilStarted {}
        |> Task.andThen
            (\started ->
                if started then
                    Source.emit sources.inputs (Session.OpenSubsystem { ref = 1, name = "sftp" })
                        |> Task.andThen (\_ -> run |> Task.onError (\why -> say ("failed: " ++ why)))
                        |> Task.andThen (\_ -> Source.emit sources.inputs Session.Hangup)

                else
                    Task.succeed {}
            )


{-| The session's notices, each a line, each question answered from the
options; the output shown at the end. The side channels' lines
(`--side-exec`, `--side-subsystem`, docs/sftp.md FT12) are kept by channel
and said at the end, in order, so that how their events interleave with
the session's does not move the pins. -}
type alias Watch =
    { output : Array Bytes, sides : Dict.Dict Int { lines : Array String, output : Array Bytes }, open : Int, opened : Int }


watch : Array String -> { notices : Source Session.Notice, inputs : Source Session.Input } -> Watch -> Task Never {}
watch args sources w =
    Source.next sources.notices
        |> Task.andThen
            (\notice ->
                let
                    answer a =
                        Source.emit sources.inputs (Session.Answered a)

                    next =
                        watch args sources w
                in
                when notice is
                    Nothing ->
                        Task.succeed {}

                    Just (Session.Status text) ->
                        say text |> Task.andThen (\_ -> next)

                    Just (Session.Banner text) ->
                        say ("banner: " ++ String.trim text) |> Task.andThen (\_ -> next)

                    Just (Session.Asking ask) ->
                        (when ask is
                            Session.TrustHostKey k ->
                                say ("asked to trust " ++ k.host ++ "'s " ++ k.algorithm ++ " key")
                                    |> Task.andThen
                                        (\_ ->
                                            if Array.member "--trust" args then
                                                answer (Session.Trust { remember = True })

                                            else if Array.member "--trust-once" args then
                                                answer (Session.Trust { remember = False })

                                            else
                                                answer Session.Decline
                                        )

                            Session.HostKeyChanged k ->
                                say ("asked whether to trust " ++ k.host ++ "'s changed " ++ k.algorithm ++ " key, known at line " ++ String.join "," (Array.map String.fromInt k.lineNumbers))
                                    |> Task.andThen
                                        (\_ ->
                                            if Array.member "--replace-changed" args then
                                                answer (Session.Trust { remember = True })

                                            else if Array.member "--trust-changed-once" args then
                                                answer (Session.Trust { remember = False })

                                            else
                                                answer Session.Decline
                                        )

                            Session.Password _ ->
                                say "asked for a password" |> Task.andThen (\_ -> answer (option "--password" args |> Maybe.map Session.Give |> Maybe.withDefault Session.Decline))

                            Session.Passphrase _ ->
                                say "asked for a passphrase" |> Task.andThen (\_ -> answer (option "--passphrase" args |> Maybe.map Session.Give |> Maybe.withDefault Session.Decline))

                            Session.Responses _ ->
                                say "asked to answer prompts" |> Task.andThen (\_ -> answer (option "--responses" args |> Maybe.map (\a -> Session.GiveAll (String.split "," a)) |> Maybe.withDefault Session.Decline))
                        )
                            |> Task.andThen (\_ -> next)

                    Just Session.Started ->
                        say "started"
                            |> Task.andThen
                                (\_ ->
                                    when option "--stdin" args is
                                        Just text ->
                                            Source.emit sources.inputs (Session.Keys (Bytes.fromString (unescape text)))

                                        Nothing ->
                                            Task.succeed {}
                                )
                            |> Task.andThen (\_ -> openSides args sources)
                            |> Task.andThen (\opened -> watch args sources { w | open = opened, opened = opened })

                    Just (Session.Output bytes) ->
                        if Array.member "--echo" args then
                            -- what the command writes goes back as keys, at
                            -- once (a latency measurement, docs/sftp.md FT12)
                            Source.emit sources.inputs (Session.Keys bytes) |> Task.andThen (\_ -> next)

                        else
                            watch args sources { w | output = Array.pushLast bytes w.output }

                    Just (Session.Exited status) ->
                        say ("output: " ++ String.replace "\r" "" (String.trim (Bytes.toStringLossy (Bytes.flatten w.output))))
                            |> Task.andThen (\_ -> say ("exit status " ++ String.fromInt status))
                            |> Task.andThen (\_ -> watch args sources { w | output = [] })

                    Just (Session.Side side) ->
                        let
                            was =
                                Dict.get side.ref w.sides |> Maybe.withDefault { lines = [], output = [] }

                            line text =
                                { was | lines = Array.pushLast text was.lines }

                            shown =
                                if Array.member "--hex" args then
                                    String.fromInt (Bytes.length (Bytes.flatten was.output)) ++ " bytes"

                                else
                                    String.replace "\r" "" (String.trim (Bytes.toStringLossy (Bytes.flatten was.output)))

                            now =
                                when side.event is
                                    Connection.Output bytes ->
                                        { was | output = Array.pushLast bytes was.output }

                                    Connection.ErrorOutput bytes ->
                                        { was | output = Array.pushLast bytes was.output }

                                    Connection.Started ->
                                        line "started"

                                    Connection.Refused why ->
                                        line ("refused: " ++ why)

                                    Connection.Exited status ->
                                        line ("output: " ++ shown ++ "; exit status " ++ String.fromInt status)

                                    Connection.Killed k ->
                                        line ("killed by " ++ k.signal)

                                    Connection.Ended ->
                                        line "ended"

                                    Connection.KeepaliveUnanswered _ ->
                                        was

                                    Connection.Sent _ ->
                                        was

                            stillOpen =
                                if side.event == Connection.Ended then
                                    w.open - 1

                                else
                                    w.open

                            after =
                                { w | sides = Dict.set side.ref now w.sides, open = stillOpen }
                        in
                        if stillOpen == 0 && w.open > 0 then
                            -- every side channel is over: the session's
                            -- command reads a line to end (`read x`)
                            Source.emit sources.inputs (Session.Keys (Bytes.fromString "\n"))
                                |> Task.andThen (\_ -> watch args sources after)

                        else
                            watch args sources after

                    Just (Session.Failed why) ->
                        say ("failed: " ++ why) |> Task.andThen (\_ -> next)

                    Just Session.Ended ->
                        Dict.foldl
                            (\ref side acc -> Array.foldl (\l a -> a |> Task.andThen (\_ -> say ("side " ++ String.fromInt ref ++ ": " ++ l))) acc side.lines)
                            (Task.succeed {})
                            w.sides
                            |> Task.andThen (\_ -> say "ended")
            )


{-| The side channels the options ask for, opened once the session has
started, numbered from 1 in order: `--side-exec CMD` and `--side-subsystem
NAME`, each again for more. The first is given `--side-stdin TEXT` and
`--side-stdin-bytes N` (that many `x`s), then its end,
when `--side-eof`. How many were opened. -}
openSides : Array String -> { notices : Source Session.Notice, inputs : Source Session.Input } -> Task Never Int
openSides args sources =
    let
        indexed =
            Array.indexedMap (\i a -> { index = i, arg = a }) args

        asked =
            indexed
                |> Array.mapAndFlatten
                    (\a ->
                        when { arg = a.arg, value = Array.get (a.index + 1) args } is
                            { arg = "--side-exec", value = Just command } ->
                                [ \ref -> Session.OpenExec { ref = ref, command = Bytes.fromString command } ]

                            { arg = "--side-subsystem", value = Just name } ->
                                [ \ref -> Session.OpenSubsystem { ref = ref, name = name } ]

                            _ ->
                                []
                    )

        emit input =
            Source.emit sources.inputs input

        first =
            [ option "--side-stdin" args |> Maybe.map (\t -> Session.SideWrite { ref = 1, bytes = Bytes.fromString (unescape t) })
            , option "--side-stdin-bytes" args
                |> Maybe.andThen String.toInt
                |> Maybe.map (\n -> Session.SideWrite { ref = 1, bytes = Bytes.fromString (String.repeat n "x") })
            , if Array.member "--side-eof" args then
                Just (Session.SideEof 1)

              else
                Nothing
            ]
                |> Array.mapAndFlatten (\m -> Maybe.map (\x -> [ x ]) m |> Maybe.withDefault [])
    in
    Array.foldl (\x acc -> acc |> Task.andThen (\_ -> emit x))
        (Task.succeed {})
        (Array.indexedMap (\i make -> make (i + 1)) asked
            ++ (if Array.isEmpty asked then
                    []

                else
                    first
               )
        )
        |> Task.map (\_ -> Array.length asked)


{-| `COLUMNS,ROWS`, or `COLUMNS,ROWS,WIDTH,HEIGHT` with the size in pixels
(0 by 0 when not given). -}
sizeOf : Array String -> Maybe { columns : Int, rows : Int, widthInPixels : Int, heightInPixels : Int }
sizeOf parts =
    let
        sized c r w h =
            Maybe.map2 (\columns rows -> { columns = columns, rows = rows }) (String.toInt c) (String.toInt r)
                |> Maybe.andThen (\cells -> Maybe.map2 (\width height -> { columns = cells.columns, rows = cells.rows, widthInPixels = width, heightInPixels = height }) (String.toInt w) (String.toInt h))
    in
    when parts is
        [ c, r ] ->
            sized c r "0" "0"

        [ c, r, w, h ] ->
            sized c r w h

        _ ->
            Nothing
