module Text exposing (renderer)

{-| puritty's text renderer (`docs/windows.md` V52): the C both platforms'
windows draw with, `src/Ext/puritty_text.c`, whose header
`src/Ext/include/puritty_text.h` is theirs to include (geng-lang Dnene38).
A display list (`Vt.View`) is decoded, shaped by HarfBuzz and rasterised by
FreeType there, and drawn through the few calls a platform gives it: a fill,
a glyph kept, the glyphs drawn, a scroll. Nothing here is for Geng to call:
`packages/x11` and `packages/win32` draw with it from their own C.

@docs renderer

-}


{-| What this package is, for its documentation. -}
renderer : String
renderer =
    "FreeType and HarfBuzz, drawn through the platform's window"
