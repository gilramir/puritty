module Main exposing (main)

{-| ssh-crypto's tests (puritty `docs/ssh-client.md` SC11 step 3): every
vector in `vectors.txt` (`make-vectors.py`), checked through `SshCrypto`,
with a count for each kind and the first failures of each. It ends with
status 1 when any fails.

    ssh-crypto-tests [VECTORS]
    ssh-crypto-tests --bench
    ssh-crypto-tests --fuzz [COUNT]

`--fuzz` hands every function COUNT inputs of random lengths and bytes,
and blobs built of the right fields with wrong lengths, and ends; a crash
is what it looks for (PuTTY asserts on some inputs its callers check).

`--bench` seals 2,048 packets of 32,756 bytes with each packet cipher,
and says how fast.

-}

import Bitwise
import Bytes exposing (Bytes)
import Console
import Dict exposing (Dict)
import Int64
import Os.Env
import Os.Error
import Os.File as File
import Os.Path as Path
import SshCrypto exposing (Cipher(..))
import Task exposing (Task)
import Time
import UInt8


main : Task Never {}
main =
    Task.map2 (\env perm -> { env = env, perm = perm }) Os.Env.getEnvironment File.initialize
        |> Task.andThen
            (\r ->
                let
                    path =
                        Array.findLast (\a -> String.endsWith ".txt" a) r.env.args
                            |> Maybe.map .value
                            |> Maybe.withDefault "vectors.txt"
                in
                if Array.member "--bench" r.env.args then
                    bench

                else if Array.member "--fuzz" r.env.args then
                    fuzz (Array.findLast (\a -> String.toInt a /= Nothing) r.env.args |> Maybe.andThen (\a -> String.toInt a.value) |> Maybe.withDefault 10000)

                else
                    File.readFile r.perm (Path.fromString path)
                        |> Task.andThen
                            (\bytes ->
                                let
                                    text =
                                        Bytes.toStringLossy bytes
                                in
                                keyTests text |> Task.andThen (\keys -> report (Dict.set "keyload" keys (run text)))
                            )
                        |> Task.onError (\e -> Console.write ("cannot read " ++ path ++ ": " ++ Os.Error.toString e ++ "\n") |> Task.andThen (\_ -> Os.Env.exitWithCode 2))
            )


type alias Tally =
    { pass : Int, fail : Int, failures : Array String }


run : String -> Dict String Tally
run text =
    String.lines text
        |> Array.foldl
            (\line tallies ->
                if String.isEmpty line || String.startsWith "#" line || String.startsWith "keyload " line then
                    tallies

                else
                    let
                        kind =
                            String.words line |> Array.first |> Maybe.withDefault ""

                        tally =
                            Dict.get kind tallies |> Maybe.withDefault { pass = 0, fail = 0, failures = [] }
                    in
                    Dict.set kind
                        (if check kind (fields line) then
                            { tally | pass = tally.pass + 1 }

                         else
                            { tally
                                | fail = tally.fail + 1
                                , failures =
                                    if Array.length tally.failures < 20 then
                                        Array.pushLast (String.takeFirst 300 line) tally.failures

                                    else
                                        tally.failures
                            }
                        )
                        tallies
            )
            Dict.empty


report : Dict String Tally -> Task x {}
report tallies =
    let
        failed =
            Dict.foldl (\_ t n -> n + t.fail) 0 tallies

        text =
            Dict.foldl
                (\kind t acc ->
                    acc
                        ++ kind
                        ++ ": "
                        ++ String.fromInt t.pass
                        ++ " pass, "
                        ++ String.fromInt t.fail
                        ++ " fail\n"
                        ++ String.join "" (Array.map (\f -> "  FAIL " ++ f ++ "\n") t.failures)
                )
                ""
                tallies
    in
    Console.write text
        |> Task.andThen
            (\_ ->
                if failed > 0 then
                    Os.Env.exitWithCode 1

                else
                    Task.succeed {}
            )


type alias Fields =
    Dict String String


fields : String -> Fields
fields line =
    String.words line
        |> Array.dropFirst 1
        |> Array.foldl
            (\w d ->
                when String.split "=" w is
                    [ k, v ] ->
                        Dict.set k v d

                    _ ->
                        d
            )
            Dict.empty


hex : Fields -> String -> Bytes
hex f name =
    fromHex (Dict.get name f |> Maybe.withDefault "-")


int : Fields -> String -> Int
int f name =
    Dict.get name f |> Maybe.andThen String.toInt |> Maybe.withDefault -999


fromHex : String -> Bytes
fromHex s =
    if s == "-" then
        Bytes.empty

    else
        let
            digit c =
                let
                    n =
                        Char.toCode c
                in
                if n >= 48 && n <= 57 then
                    n - 48

                else if n >= 97 && n <= 102 then
                    n - 87

                else
                    0

            chars =
                String.toArray s
        in
        Array.range 0 (Array.length chars // 2 - 1)
            |> Array.map
                (\i ->
                    UInt8.fromIntWrap
                        (16 * (Array.get (2 * i) chars |> Maybe.map digit |> Maybe.withDefault 0)
                            + (Array.get (2 * i + 1) chars |> Maybe.map digit |> Maybe.withDefault 0)
                        )
                )
            |> Bytes.fromUInt8s


hashOf : Int -> SshCrypto.Hash
hashOf n =
    when n is
        0 ->
            SshCrypto.Sha1

        1 ->
            SshCrypto.Sha256

        2 ->
            SshCrypto.Sha384

        _ ->
            SshCrypto.Sha512


cipherOf : Int -> Cipher
cipherOf n =
    when n is
        0 ->
            ChaCha20Poly1305

        1 ->
            Aes128Gcm

        _ ->
            Aes256Gcm


check : String -> Fields -> Bool
check kind f =
    when kind is
        "hash" ->
            SshCrypto.hash (hashOf (int f "which")) (hex f "data") == hex f "out"

        "hashrepeat" ->
            SshCrypto.hash (hashOf (int f "which")) (Bytes.flatten (Array.repeat (int f "count") (hex f "byte"))) == hex f "out"

        "hmac" ->
            let
                mac =
                    when int f "which" is
                        0 ->
                            SshCrypto.HmacSha1

                        1 ->
                            SshCrypto.HmacSha256

                        _ ->
                            SshCrypto.HmacSha512
            in
            SshCrypto.hmac mac (hex f "key") (hex f "data") == hex f "out"

        "x25519pub" ->
            SshCrypto.x25519Public (hex f "secret") == Just (hex f "pub")

        "x25519" ->
            let
                got =
                    SshCrypto.x25519Shared (hex f "secret") (hex f "theirs")
            in
            if int f "result" == 1 then
                got == Just (hex f "k")

            else
                got == Nothing

        "verify" ->
            SshCrypto.verify
                { algorithm = Bytes.toStringLossy (hex f "alg")
                , publicKey = hex f "pub"
                , signature = hex f "sig"
                , data = hex f "data"
                }
                == (int f "result" == 1)

        "packet" ->
            checkPacket f

        "aesctr" ->
            SshCrypto.aesCtr { key = hex f "key", iv = hex f "iv" } (hex f "data") == Just (hex f "out")

        "keyfile" ->
            checkKeyFile f

        _ ->
            False


{-| Sealed as the vector says; opened back; its length read; and a packet
with one byte changed anywhere, or opened under the next nonce (the next
sequence number for ChaCha20-Poly1305, the next count for AES-GCM),
refused. -}
checkPacket : Fields -> Bool
checkPacket f =
    let
        keyed =
            { cipher = cipherOf (int f "cipher"), key = hex f "key", iv = hex f "iv", sequence = int f "seq", count = int f "count" }

        plain =
            hex f "plain"

        sealed =
            hex f "sealed"

        flipped at =
            Bytes.flatten
                [ Bytes.slice 0 at sealed
                , Bytes.fromUInt8s [ UInt8.fromIntWrap (1 + (Bytes.get at sealed |> Maybe.map UInt8.toInt |> Maybe.withDefault 0)) ]
                , Bytes.slice (at + 1) (Bytes.length sealed) sealed
                ]

        n =
            Bytes.length sealed
    in
    (SshCrypto.seal keyed plain == Just sealed)
        && (SshCrypto.open keyed sealed == Just plain)
        && (SshCrypto.openLength { cipher = keyed.cipher, key = keyed.key, sequence = keyed.sequence } (Bytes.slice 0 4 sealed) == Just (Bytes.length plain - 4))
        && Array.all (\at -> SshCrypto.open keyed (flipped at) == Nothing) [ 0, 3, 4, n // 2, n - 17, n - 16, n - 1 ]
        -- ChaCha20-Poly1305's nonce is the sequence number, AES-GCM's the count
        && (SshCrypto.open { keyed | sequence = keyed.sequence + 1 } sealed
                == (if keyed.cipher == ChaCha20Poly1305 then
                        Nothing

                    else
                        Just plain
                   )
           )
        && (SshCrypto.open { keyed | count = keyed.count + 1 } sealed
                == (if keyed.cipher == ChaCha20Poly1305 then
                        Just plain

                    else
                        Nothing
                   )
           )


{-| An OpenSSH key file's private part, decrypted with the key and IV
`bcrypt_pbkdf` gives from the passphrase: its two check words are equal,
and it holds the end of the public key. The wrong passphrase gives check words that
differ. -}
checkKeyFile : Fields -> Bool
checkKeyFile f =
    let
        decrypt passphrase =
            SshCrypto.bcryptPbkdf { passphrase = passphrase, salt = hex f "salt", rounds = int f "rounds", length = 48 }
                |> Maybe.andThen (\k -> SshCrypto.aesCtr { key = Bytes.slice 0 32 k, iv = Bytes.slice 32 48 k } (hex f "encrypted"))

        checksHold d =
            Bytes.slice 0 4 d == Bytes.slice 4 8 d

        pub =
            hex f "pub"

        -- the public key's last 32 bytes: an RSA key's private part holds
        -- its numbers in another order than its public blob, n last in both
        tail =
            Bytes.slice (Bytes.length pub - 32) (Bytes.length pub) pub

        holds d =
            Array.any (\i -> Bytes.slice i (i + 32) d == tail) (Array.range 8 (Bytes.length d - 32))
    in
    when { right = decrypt (hex f "passphrase"), wrong = decrypt (Bytes.fromString "hunter3") } is
        { right = Just d, wrong = Just w } ->
            checksHold d && holds d && not (checksHold w)

        _ ->
            False


-- BENCH


bench : Task x {}
bench =
    [ ChaCha20Poly1305, Aes128Gcm, Aes256Gcm ]
        |> Array.map benchOne
        |> Task.sequence
        |> Task.map (\_ -> {})


{-| 2,048 packets of 32,756 bytes, each sealed under its own count and sequence
number, so no two calls are the same. -}
benchOne : Cipher -> Task x {}
benchOne cipher =
    let
        keyLength =
            when cipher is
                ChaCha20Poly1305 ->
                    64

                Aes128Gcm ->
                    16

                Aes256Gcm ->
                    32

        key =
            Bytes.fromUInt8s (Array.map UInt8.fromIntWrap (Array.range 1 keyLength))

        iv =
            Bytes.fromUInt8s (Array.map UInt8.fromIntWrap (Array.range 1 12))

        -- the length field, then 32,752 bytes: a multiple of both blocks
        packet =
            Bytes.flatten [ Bytes.fromUInt8s (Array.map UInt8.fromIntWrap [ 0, 0, 127, 240 ]), Bytes.fromString (String.repeat 32752 "p") ]

        count =
            2048

        -- the sequence numbers start at the clock's, so no pass can seal
        -- before the clock is read
        sealAll from i total =
            if i >= count then
                total

            else
                sealAll from
                    (i + 1)
                    (total
                        + (SshCrypto.seal { cipher = cipher, key = key, iv = iv, sequence = from + i, count = i } packet
                            |> Maybe.map Bytes.length
                            |> Maybe.withDefault 0
                          )
                    )
    in
    Time.now
        |> Task.andThen
            (\t0 ->
                let
                    total =
                        sealAll (millis t0) 0 0
                in
                Time.now
                    |> Task.andThen
                        (\t1 ->
                            let
                                ms =
                                    max 1 (millis t1 - millis t0)
                            in
                            Console.write
                                (cipherName cipher
                                    ++ ": "
                                    ++ String.fromInt (total // 1048576)
                                    ++ " MiB sealed in "
                                    ++ String.fromInt ms
                                    ++ " ms, "
                                    ++ String.fromInt (total // 1000 // ms)
                                    ++ " MB/s\n"
                                )
                        )
            )


cipherName : Cipher -> String
cipherName cipher =
    when cipher is
        ChaCha20Poly1305 ->
            "chacha20-poly1305"

        Aes128Gcm ->
            "aes128-gcm"

        Aes256Gcm ->
            "aes256-gcm"


{-| The clock's milliseconds in an `Int`, wrapped: a difference of two
taken less than 24 days apart is right. -}
millis : Time.Posix -> Int
millis t =
    Int64.toIntWrap (Time.posixToMillis t)


-- FUZZ


fuzz : Int -> Task x {}
fuzz count =
    let
        totals =
            Array.foldl
                (\i t ->
                    let
                        one =
                            fuzzOne i
                    in
                    { accepted = t.accepted + one.accepted, touched = Bitwise.and 1073741823 (t.touched + one.touched) }
                )
                { accepted = 0, touched = 0 }
                (Array.range 1 count)
    in
    Console.write
        ("fuzz: "
            ++ String.fromInt count
            ++ " rounds, "
            ++ String.fromInt totals.accepted
            ++ " random signatures or packets taken as good (answers' checksum "
            ++ String.fromInt totals.touched
            ++ ")\n"
        )


{-| Round `i`'s inputs, from a generator of its own: how many signatures
verified and packets opened, which for random bytes should be none. Every
function is called; a crash is the failure. -}
fuzzOne : Int -> { accepted : Int, touched : Int }
fuzzOne i =
    let
        pick k bound =
            modBy (max 1 bound) (Bitwise.and 2147483647 ((i * 1103515245 + k * 12345 + i * k * 1597334677) // 7))

        random k n =
            Bytes.fromUInt8s (Array.map (\j -> UInt8.fromIntWrap (pick (k * 1000 + j) 256)) (Array.range 1 n))

        -- a length near one that matters
        near k center =
            max 0 (center - 3 + pick k 7)

        str b =
            Bytes.flatten [ u32 (Bytes.length b), b ]

        u32 n =
            Bytes.fromUInt8s (Array.map UInt8.fromIntWrap [ 0, 0, Bitwise.and 255 (n // 256), Bitwise.and 255 n ])

        algorithm =
            Array.get (pick 1 4) SshCrypto.signatureAlgorithms |> Maybe.withDefault "ssh-ed25519"

        name =
            if pick 2 4 == 0 then
                random 3 (pick 4 20)

            else
                Bytes.fromString
                    (if String.startsWith "rsa" algorithm then
                        "ssh-rsa"

                     else
                        algorithm
                    )

        publicKey =
            when pick 5 4 is
                0 ->
                    random 6 (pick 7 300)

                1 ->
                    Bytes.flatten [ str name, str (random 8 (near 9 32)) ]

                2 ->
                    Bytes.flatten [ str name, str (Bytes.fromString "nistp256"), str (random 10 (near 11 65)) ]

                _ ->
                    Bytes.flatten [ str name, str (random 12 (pick 13 9)), str (random 14 (near 15 257)) ]

        signature =
            when pick 16 3 is
                0 ->
                    random 17 (pick 18 300)

                1 ->
                    Bytes.flatten [ str (Bytes.fromString algorithm), str (random 19 (near 20 64)) ]

                _ ->
                    Bytes.flatten [ str (Bytes.fromString algorithm), str (Bytes.flatten [ str (random 21 (near 22 32)), str (random 23 (near 24 32)) ]) ]

        verified =
            SshCrypto.verify { algorithm = algorithm, publicKey = publicKey, signature = signature, data = random 25 (pick 26 100) }

        shared =
            SshCrypto.x25519Shared (random 27 (near 28 32)) (random 29 (near 30 32))

        cipher =
            cipherOf (pick 31 3)

        opened =
            SshCrypto.open { cipher = cipher, key = random 32 (near 33 32), iv = random 34 (near 35 12), sequence = pick 36 1000, count = pick 37 1000 } (random 38 (pick 39 200))

        sealed =
            SshCrypto.seal { cipher = cipher, key = random 40 (near 41 32), iv = random 42 (near 43 12), sequence = pick 44 1000, count = pick 45 1000 } (random 46 (pick 47 200))

        length =
            SshCrypto.openLength { cipher = cipher, key = random 48 (near 49 64), sequence = pick 50 1000 } (random 51 (near 52 4))

        counter =
            SshCrypto.aesCtr { key = random 53 (near 54 32), iv = random 55 (near 56 16) } (random 57 (pick 58 70))

        kdf =
            SshCrypto.bcryptPbkdf { passphrase = random 59 (pick 60 20), salt = random 61 (pick 62 20), rounds = pick 63 3 - 1, length = pick 64 80 - 2 }

        taken b =
            if b then
                1

            else
                0
    in
    -- what must never take random bytes, and every answer's length, so
    -- that no call is one the optimizer may leave out
    { accepted = taken verified + taken (opened /= Nothing)
    , touched =
        taken (shared /= Nothing)
            + (Maybe.map Bytes.length sealed |> Maybe.withDefault 0)
            + (Maybe.withDefault 0 length)
            + (Maybe.map Bytes.length counter |> Maybe.withDefault 0)
            + (Maybe.map Bytes.length kdf |> Maybe.withDefault 0)
    }


-- PRIVATE KEYS


{-| Each `keyload` vector: the file's public key and whether it is
encrypted read without the passphrase; the key loaded, its public key the
same; a signature by it that `verify` takes, where `verify` knows the
algorithm, and that names the algorithm, where it does not; the wrong
passphrase refused; and the key forgotten, after which it signs nothing. -}
keyTests : String -> Task x Tally
keyTests text =
    String.lines text
        |> Array.keepIf (\l -> String.startsWith "keyload " l)
        |> Array.foldl
            (\line acc ->
                acc
                    |> Task.andThen
                        (\tally ->
                            keyTest (fields line)
                                |> Task.map
                                    (\problem ->
                                        when problem is
                                            Nothing ->
                                                { tally | pass = tally.pass + 1 }

                                            Just why ->
                                                { tally | fail = tally.fail + 1, failures = Array.pushLast (why ++ ": " ++ String.takeFirst 120 line) tally.failures }
                                    )
                        )
            )
            (Task.succeed { pass = 0, fail = 0, failures = [] })


keyTest : Fields -> Task x (Maybe String)
keyTest f =
    let
        file =
            hex f "file"

        passphrase =
            hex f "passphrase"

        pub =
            hex f "pub"

        algorithm =
            Bytes.toStringLossy (hex f "alg")

        data =
            Bytes.fromString "the data a userauth request signs"

        infoHolds =
            SshCrypto.keyFileInfo file == Just { encrypted = int f "encrypted" == 1, publicKey = pub }

        wrong =
            if int f "encrypted" == 1 then
                SshCrypto.loadKey file (Bytes.fromString "not the passphrase")
                    |> Task.map (\_ -> Just "a wrong passphrase was taken")
                    |> Task.onError
                        (\p ->
                            Task.succeed
                                (if p == SshCrypto.WrongPassphrase then
                                    Nothing

                                 else
                                    Just "a wrong passphrase gave another problem"
                                )
                        )

            else
                Task.succeed Nothing
    in
    if not infoHolds then
        Task.succeed (Just "keyFileInfo")

    else
        SshCrypto.loadKey file passphrase
            |> Task.andThen
                (\key ->
                    SshCrypto.publicKeyOf key
                        |> Task.andThen
                            (\blob ->
                                SshCrypto.sign key algorithm data
                                    |> Task.andThen
                                        (\signature ->
                                            SshCrypto.forget key
                                                |> Task.andThen (\_ -> SshCrypto.sign key algorithm data |> Task.map (\_ -> False) |> Task.onError (\p -> Task.succeed (p == SshCrypto.Forgotten)))
                                                |> Task.map
                                                    (\forgotten ->
                                                        let
                                                            named =
                                                                Bytes.slice 4 (4 + String.count algorithm) signature == Bytes.fromString algorithm

                                                            verified =
                                                                if Array.member algorithm SshCrypto.signatureAlgorithms then
                                                                    SshCrypto.verify { algorithm = algorithm, publicKey = pub, signature = signature, data = data }

                                                                else
                                                                    True
                                                        in
                                                        if blob /= pub then
                                                            Just "the loaded key's public key differs"

                                                        else if not named || not verified then
                                                            Just "the signature does not verify"

                                                        else if not forgotten then
                                                            Just "a forgotten key signed"

                                                        else
                                                            Nothing
                                                    )
                                        )
                            )
                )
            |> Task.onError (\_ -> Task.succeed (Just "the key did not load, sign or forget"))
            |> Task.andThen
                (\problem ->
                    when problem is
                        Just _ ->
                            Task.succeed problem

                        Nothing ->
                            wrong
                )
