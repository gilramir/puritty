module Locale exposing (language)

{-| The user's language as Windows keeps it (`docs/windows.md` WS21):
Windows sets no `LANG` or `LC_*`, so a program asks it.

@docs language

-}

import Bytes exposing (Bytes)
import Task exposing (Task)


{-| The user's first language, as Windows names one: a language, perhaps
a script and a region, joined by `-` (`ko`, `en-US`, `zh-Hant-TW`). It is
the head of the list in Settings' Language & region, which packaged
programs such as Notepad follow, and not the display language, which may
be set apart from it; else the regional format's. Empty when Windows gives
neither. -}
language : Task x String
language =
    languageExtern
        |> Task.map Bytes.toStringLossy


@extern(c, "puritty_win32_language")
languageExtern : Task x Bytes
