module Registry exposing (puttySessions)

{-| What other programs keep in the registry that puritty reads.

@docs puttySessions

-}

import Bytes exposing (Bytes)
import Task exposing (Task)


{-| PuTTY's saved sessions (`docs/settings-gui.md` SG21), as text: each a
`[name]` line, its name as PuTTY shows it, then its values as `Key=Value`
lines, a number in decimal. Empty when PuTTY has saved none. -}
puttySessions : Task x String
puttySessions =
    puttySessionsExtern
        |> Task.map Bytes.toStringLossy


@extern(c, "puritty_win32_puttySessions")
puttySessionsExtern : Task x Bytes
