module Credentials exposing (forget, read, write)

{-| Windows' Credential Manager (`docs/saved-secrets.md` PW7, PW8): a
generic credential by its target name, kept on this machine, where Control
Panel's Credential Manager shows it under "Generic credentials". None of
it works from an ssh logon, which has no credential store (PW3).

@docs read, write, forget

-}

import Bytes exposing (Bytes)
import Task exposing (Task)
import UInt8


{-| The secret kept as `target`, or why there is none: `1168` when there
is no such credential, as Windows numbers its errors. -}
read : String -> Task x (Result String String)
read target =
    credRead (Bytes.fromString target)
        |> Task.map
            (\b ->
                let
                    rest =
                        Bytes.toStringLossy (Bytes.slice 1 (Bytes.length b) b)
                in
                if Maybe.map UInt8.toInt (Bytes.get 0 b) == Just 1 then
                    Ok rest

                else
                    Err rest
            )


{-| A secret kept as `target`, with the user it is for beside it, in
place of one there; or why it was not (Windows' error number). -}
write : { target : String, user : String, secret : String } -> Task x (Result String {})
write c =
    credWrite (Bytes.fromString c.target) (Bytes.fromString c.user) (Bytes.fromString c.secret)
        |> Task.map
            (\b ->
                if Bytes.isEmpty b then
                    Ok {}

                else
                    Err (Bytes.toStringLossy b)
            )


{-| The secret kept as `target` removed; whether there was one. -}
forget : String -> Task x Bool
forget target =
    credDelete (Bytes.fromString target) |> Task.map (\n -> n == 1)


@extern(c, "puritty_win32_credRead")
credRead : Bytes -> Task x Bytes


@extern(c, "puritty_win32_credWrite")
credWrite : Bytes -> Bytes -> Bytes -> Task x Bytes


@extern(c, "puritty_win32_credDelete")
credDelete : Bytes -> Task x Int
